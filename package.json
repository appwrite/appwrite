{
  "name": "vibes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsr generate && vite dev --port 3000",
    "start": "bun run server.ts",
    "fetch:stars": "node scripts/fetch-github-stars.js",
    "build": "tsr generate && node scripts/fetch-github-stars.js && bun run scripts/generate-reference-versions.ts && vite build && bun run scripts/prepare-appwrite-sites-output.ts && bun run scripts/copy-appwrite-specs.ts && bun run generate:sitemap && bun run generate:docs-exports",
    "build:node": "tsr generate && node scripts/fetch-github-stars.js && bun run scripts/generate-reference-versions.ts && rm -rf dist .output && FOR_SITES=true vite build && node --experimental-strip-types scripts/verify-appwrite-sites-output.ts && node --experimental-strip-types scripts/prepare-appwrite-sites-output.ts && node --experimental-strip-types scripts/copy-appwrite-specs.ts && bun run generate:sitemap && bun run generate:docs-exports && node --experimental-strip-types scripts/emit-appwrite-ssr-detection.ts",
    "generate:reference-versions": "bun run scripts/generate-reference-versions.ts",
    "copy:appwrite-specs": "bun run scripts/copy-appwrite-specs.ts",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "generate:routes": "tsr generate",
    "import:docs": "bun run scripts/import-docs.ts && bun run scripts/generate-docs-manifest.ts && bun run scripts/generate-docs-section-nav.ts && bun run scripts/generate-docs-static-exports.ts && bun run generate:sitemap",
    "import:blog": "bun run scripts/import-blog.ts",
    "generate:blog-local-images": "bun run scripts/generate-blog-local-images.ts",
    "import:integrations": "bun run scripts/import-integrations.ts && bun run generate:sitemap",
    "convert:content-images": "bun run scripts/convert-content-images-to-avif.ts",
    "generate:docs": "bun run scripts/generate-docs-manifest.ts && bun run scripts/generate-docs-section-nav.ts && bun run scripts/generate-docs-static-exports.ts && bun run generate:sitemap",
    "generate:docs-exports": "bun run scripts/generate-docs-static-exports.ts",
    "generate:sitemap": "bun run scripts/generate-sitemap.ts",
    "generate:docs-nav": "bun run scripts/generate-docs-section-nav.ts",
    "generate:icons": "node scripts/generate-apple-icons.js",
    "generate:public-icon-manifest": "bun run scripts/generate-public-icon-manifest.ts",
    "clean": "rm -rf .output dist node_modules/.vite .nitro .tanstack",
    "test:unit": "vitest run",
    "test:e2e:ui": "playwright test --ui",
    "e2e": "playwright test",
    "install-browsers": "playwright install --with-deps chromium",
    "check": "tsc --noEmit"
  },
