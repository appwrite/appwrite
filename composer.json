{
    "name": "appwrite/server-ce",
    "description": "End to end backend server for frontend and mobile apps.",
    "type": "project",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Eldad Fux",
            "email": "eldad@appwrite.io"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test --config pint.json",
        "format": "vendor/bin/pint --config pint.json",
        "analyze": "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "bench": "vendor/bin/phpbench run --report=benchmark",
        "check": "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "dead-code": "./vendor/bin/phpstan analyse -c phpstan-deadcode.neon --memory-limit=2G",
        "refactor": "vendor/bin/rector process --config tests/tools/rector.php",
        "refactor:check": "vendor/bin/rector process --dry-run --config tests/tools/rector.php",
        "installer:clean": "php src/Appwrite/Platform/Installer/Server.php --clean",
        "installer:dev": "docker compose build && composer installer:clean && php src/Appwrite/Platform/Installer/Server.php --docker"
    },
    "autoload": {
        "psr-4": {
            "Appwrite\\": "src/Appwrite",
            "Executor\\": "src/Executor",
            "Utopia\\Agents\\": "packages/agents/src",
            "Utopia\\Bus\\": "packages/bus/src",
            "Utopia\\Lock\\": "packages/lock/src",
            "Utopia\\Psr7\\": "packages/psr7/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\E2E\\": "tests/e2e",
            "Tests\\Unit\\": "tests/unit",
            "Appwrite\\Tests\\": "tests/extensions",
            "Utopia\\Agents\\Tests\\": "packages/agents/tests",
            "Utopia\\Bus\\Tests\\": "packages/bus/tests",
            "Utopia\\Lock\\Tests\\": "packages/lock/tests",
            "Utopia\\Psr7\\Tests\\": "packages/psr7/tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/utopia-php/auth"
        },
        {
            "type": "vcs",
            "url": "https://github.com/utopia-php/cdn"
        },
        {
            "type": "vcs",
            "url": "https://github.com/utopia-php/vcs"
        },
        {
            "type": "vcs",
            "url": "https://github.com/utopia-php/mqtt"
        }
    ],
    "require": {
        "php": ">=8.5.0",
        "ext-curl": "*",
        "ext-imagick": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-yaml": "*",
        "ext-dom": "*",
        "ext-redis": "*",
        "ext-igbinary": "*",
        "ext-swoole": "6.*",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "ext-sockets": "*",
        "appwrite/php-runtimes": "0.20.*",
        "appwrite/php-clamav": "2.0.*",
        "utopia-php/abuse": "2.0.*",
        "utopia-php/audit": "^4.0",
        "utopia-php/auth": "^0.12",
        "utopia-php/balancer": "0.4.*",
        "utopia-php/cache": "^5.1.0",
        "utopia-php/cdn": "^0.0.12",
        "utopia-php/cli": "^0.24",
        "utopia-php/compression": "0.1.*",
        "utopia-php/config": "1.*",
        "utopia-php/console": "^0.2",
        "utopia-php/database": "^7.3.11",
        "utopia-php/detector": "0.2.*",
        "utopia-php/domains": "^4.2.1",
        "utopia-php/emails": "0.8.*",
        "utopia-php/dns": "^3.0.7",
        "utopia-php/dsn": "0.2.1",
        "utopia-php/http": "^2.0@RC",
        "utopia-php/fetch": "^1.1",
        "utopia-php/validators": "^1.0",
        "utopia-php/image": "0.8.*",
        "utopia-php/locale": "0.8.*",
        "utopia-php/messaging": "^2.1",
        "utopia-php/migration": "^2.0.0",
        "utopia-php/mqtt": "0.0.*",
        "utopia-php/platform": "1.0.0-rc21",
        "utopia-php/pools": "2.*",
        "utopia-php/span": "^4.2",
        "utopia-php/queue": "^3.0.0",
        "utopia-php/servers": "0.4.*",
        "utopia-php/registry": "0.5.*",
        "utopia-php/storage": "^4.0",
        "utopia-php/system": "^0.10 || ^0.11",
        "utopia-php/telemetry": "^0.4",
        "utopia-php/user-agent": "0.1.*",
        "mustangostang/spyc": "0.6.*",
        "utopia-php/vcs": "5.5.*",
        "utopia-php/websocket": "2.0.2",
        "dragonmantank/cron-expression": "3.4.*",
        "chillerlan/php-qrcode": "4.3.*",
        "adhocore/jwt": "1.1.*",
        "spomky-labs/otphp": "11.*",
        "webonyx/graphql-php": "15.32.*",
        "league/csv": "9.14.*",
        "enshrined/svg-sanitize": "0.22.*",
        "utopia-php/client": "^0.4.4",
        "open-runtimes/sdk-for-php": "^2.0",
        "utopia-php/schedule": "^0.3.0",
        "utopia-php/usage": "^0.16.4",
        "utopia-php/query": "0.6.*",
        "utopia-php/openapi": "^0.2.4",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "ext-fileinfo": "*",
        "appwrite/sdk-generator": "^5.0",
        "brianium/paratest": "7.*",
        "phpunit/phpunit": "12.*",
        "swoole/ide-helper": "6.*",
        "phpstan/phpstan": "^2.0",
        "textalk/websocket": "1.5.*",
        "czproject/git-php": "4.*",
        "laravel/pint": "1.*",
        "rector/rector": "^2.4",
        "shipmonk/dead-code-detector": "^0.13"
    },
    "provide": {
        "ext-phpiredis": "*"
    },
    "config": {
        "platform": {},
        "audit": {
            "abandoned": "report"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "replace": {
        "utopia-php/agents": "*",
        "utopia-php/bus": "*",
        "utopia-php/lock": "*",
        "utopia-php/psr7": "*"
    }
}
