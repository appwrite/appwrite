{
    "name": "appwrite/server-ce",
    "description": "End to end backend server for frontend and mobile apps.",
    "type": "project",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Eldad Fux",
            "email": "eldad@appwrite.io"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test --config pint.json",
        "format": "vendor/bin/pint --config pint.json",
        "analyze": "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "bench": "vendor/bin/phpbench run --report=benchmark",
        "check": "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "dead-code": "./vendor/bin/phpstan analyse -c phpstan-deadcode.neon --memory-limit=2G",
        "refactor": "vendor/bin/rector process --config tests/tools/rector.php",
        "refactor:check": "vendor/bin/rector process --dry-run --config tests/tools/rector.php",
        "installer:clean": "php src/Appwrite/Platform/Installer/Server.php --clean",
        "installer:dev": "docker compose build && composer installer:clean && php src/Appwrite/Platform/Installer/Server.php --docker"
    },
    "autoload": {
        "psr-4": {
            "Appwrite\\": "src/Appwrite",
            "Executor\\": "src/Executor",
            "Utopia\\Agents\\": "packages/agents/src",
            "Utopia\\Auth\\": "packages/auth/src",
            "Utopia\\Balancer\\": "packages/balancer/src",
            "Utopia\\Bus\\": "packages/bus/src",
            "Utopia\\Cache\\": "packages/cache/src",
            "Utopia\\CircuitBreaker\\": "packages/circuit-breaker/src",
            "Utopia\\Client\\": "packages/client/src",
            "Utopia\\Compression\\": "packages/compression/src",
            "Utopia\\Detector\\": "packages/detector/src",
            "Utopia\\DI\\": "packages/di/src",
            "Utopia\\Image\\": "packages/image/src",
            "Utopia\\Locale\\": "packages/locale/src",
            "Utopia\\Lock\\": "packages/lock/src",
            "Utopia\\Messaging\\": "packages/messaging/src",
            "Utopia\\OpenAPI\\": "packages/openapi/src",
            "Utopia\\Pools\\": "packages/pools/src",
            "Utopia\\Psr7\\": "packages/psr7/src",
            "Utopia\\Schedule\\": "packages/schedule/src",
            "Utopia\\SMTP\\": "packages/smtp/src",
            "Utopia\\Span\\": "packages/span/src",
            "Utopia\\System\\": "packages/system/src",
            "Utopia\\Telemetry\\": "packages/telemetry/src",
            "Utopia\\UserAgent\\": "packages/user-agent/src",
            "Utopia\\WebSocket\\": "packages/websocket/src",
            "Utopia\\": [
                "packages/validators/src"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\E2E\\": "tests/e2e",
            "Tests\\Unit\\": "tests/unit",
            "Appwrite\\Tests\\": "tests/extensions",
            "Utopia\\Agents\\Tests\\": "packages/agents/tests",
            "Utopia\\Auth\\Tests\\": "packages/auth/tests",
            "Utopia\\Balancer\\Tests\\": "packages/balancer/tests",
            "Utopia\\Bus\\Tests\\": "packages/bus/tests",
            "Utopia\\Cache\\Tests\\": "packages/cache/tests",
            "Utopia\\CircuitBreaker\\Tests\\": "packages/circuit-breaker/tests",
            "Utopia\\Client\\Tests\\": "packages/client/tests",
            "Utopia\\Compression\\Tests\\": "packages/compression/tests",
            "Utopia\\Detector\\Tests\\": "packages/detector/tests",
            "Utopia\\DI\\Tests\\": "packages/di/tests",
            "Utopia\\Image\\Tests\\": "packages/image/tests",
            "Utopia\\Locale\\Tests\\": "packages/locale/tests",
            "Utopia\\Lock\\Tests\\": "packages/lock/tests",
            "Utopia\\Messaging\\Tests\\": "packages/messaging/tests",
            "Utopia\\OpenAPI\\Tests\\": "packages/openapi/tests",
            "Utopia\\Pools\\Tests\\": "packages/pools/tests",
            "Utopia\\Psr7\\Tests\\": "packages/psr7/tests",
            "Utopia\\Schedule\\Tests\\": "packages/schedule/tests",
            "Utopia\\SMTP\\Tests\\": "packages/smtp/tests",
            "Utopia\\Span\\Tests\\": "packages/span/tests",
            "Utopia\\System\\Tests\\": "packages/system/tests",
            "Utopia\\Telemetry\\Tests\\": "packages/telemetry/tests",
            "Utopia\\UserAgent\\Tests\\": "packages/user-agent/tests",
            "Utopia\\Validator\\Tests\\": "packages/validators/tests",
            "Utopia\\WebSocket\\Tests\\": "packages/websocket/tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/utopia-php/cdn"
        },
        {
            "type": "vcs",
            "url": "https://github.com/utopia-php/vcs"
        },
        {
            "type": "vcs",
            "url": "https://github.com/utopia-php/mqtt"
        }
    ],
    "require": {
        "php": ">=8.5.0",
        "ext-curl": "*",
        "ext-imagick": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-yaml": "*",
        "ext-dom": "*",
        "ext-redis": "*",
        "ext-igbinary": "*",
        "ext-swoole": "6.*",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "ext-sockets": "*",
        "appwrite/php-runtimes": "0.20.*",
        "appwrite/php-clamav": "2.0.*",
        "utopia-php/abuse": "2.0.*",
        "utopia-php/audit": "^4.0",
        "utopia-php/cdn": "^0.0.13",
        "utopia-php/cli": "^0.24",
        "utopia-php/config": "1.*",
        "utopia-php/console": "^0.2",
        "utopia-php/database": "^7.3.11",
        "utopia-php/domains": "^4.3",
        "utopia-php/emails": "0.8.*",
        "utopia-php/dns": "^3.0.7",
        "utopia-php/dsn": "0.2.1",
        "utopia-php/http": "^2.0@RC",
        "utopia-php/fetch": "^1.1",
        "utopia-php/migration": "^2.0.0",
        "utopia-php/mqtt": "0.0.*",
        "utopia-php/platform": "1.0.0-rc25",
        "utopia-php/queue": "^6.0.0",
        "utopia-php/servers": "0.4.*",
        "utopia-php/registry": "0.5.*",
        "utopia-php/storage": "^4.3",
        "mustangostang/spyc": "0.6.*",
        "utopia-php/vcs": "5.5.*",
        "dragonmantank/cron-expression": "3.4.*",
        "chillerlan/php-qrcode": "4.3.*",
        "adhocore/jwt": "1.1.*",
        "spomky-labs/otphp": "11.*",
        "webonyx/graphql-php": "15.32.*",
        "league/csv": "9.14.*",
        "enshrined/svg-sanitize": "0.22.*",
        "nyholm/psr7": "1.*",
        "open-telemetry/exporter-otlp": "1.*",
        "open-telemetry/sdk": "1.*",
        "symfony/http-client": "7.*",
        "open-runtimes/sdk-for-php": "^2.1",
        "utopia-php/usage": "^0.16.6",
        "utopia-php/query": "0.6.*",
        "psr/http-factory": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "ext-fileinfo": "*",
        "appwrite/sdk-generator": "^5.0",
        "brianium/paratest": "7.*",
        "phpunit/phpunit": "12.*",
        "swoole/ide-helper": "6.*",
        "phpstan/phpstan": "^2.0",
        "textalk/websocket": "1.5.*",
        "czproject/git-php": "4.*",
        "laravel/pint": "1.*",
        "rector/rector": "^2.4",
        "shipmonk/dead-code-detector": "^0.13"
    },
    "provide": {
        "ext-phpiredis": "*"
    },
    "config": {
        "platform": {},
        "audit": {
            "abandoned": "report"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "replace": {
        "utopia-php/agents": "*",
        "utopia-php/auth": "*",
        "utopia-php/balancer": "*",
        "utopia-php/bus": "*",
        "utopia-php/cache": "*",
        "utopia-php/circuit-breaker": "*",
        "utopia-php/client": "*",
        "utopia-php/compression": "*",
        "utopia-php/detector": "*",
        "utopia-php/di": "*",
        "utopia-php/image": "*",
        "utopia-php/locale": "*",
        "utopia-php/lock": "*",
        "utopia-php/messaging": "*",
        "utopia-php/openapi": "*",
        "utopia-php/pools": "*",
        "utopia-php/psr7": "*",
        "utopia-php/schedule": "*",
        "utopia-php/smtp": "*",
        "utopia-php/span": "*",
        "utopia-php/system": "*",
        "utopia-php/telemetry": "*",
        "utopia-php/user-agent": "*",
        "utopia-php/validators": "*",
        "utopia-php/websocket": "*"
    }
}
