# Forward unknown queries to Docker's embedded DNS for service name resolution,
# with Cloudflare as fallback for external names.
# Bind to our static IP to avoid conflict with Docker's DNS proxy on 127.0.0.11.
. {
    bind 172.16.238.100
    forward . 127.0.0.11 1.1.1.1
}

# Zones configuration
webapp.com {
    bind 172.16.238.100
    template IN A {
        match "^webapp\.com\.$"
        answer "{{ .Name }} 60 IN A 203.0.0.1"
        fallthrough
    }

    template IN CNAME {
        match "^([a-z0-9-]+\.)?stage-site\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN CNAME sites.localhost."
        fallthrough
    }

    template IN CNAME {
        match "^([a-z0-9-]+\.)?stage-function\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN CNAME cname.localhost."
        fallthrough
    }

    template IN CNAME {
        match "^([a-z0-9-]+\.)?stage\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN CNAME cname.localhost."
        fallthrough
    }

    template IN CNAME {
        match "^([a-z0-9-]+\.)?stage-wrong-cname\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN CNAME cname-wrong.tests.appwrite.io."
        fallthrough
    }

    template IN A {
        match "^([a-z0-9-]+\.)?correct-a\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN A 203.0.0.1"
        fallthrough
    }

    template IN A {
        match "^([a-z0-9-]+\.)?stage-wrong-caa\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN A 203.0.0.1"
        fallthrough
    }

    template IN CAA {
        match "^([a-z0-9-]+\.)?stage-wrong-caa\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN CAA 0 issue \"unknown-issuer.org\""
        fallthrough
    }

    template IN A {
        match "^([a-z0-9-]+\.)?stage-correct-caa\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN A 203.0.0.1"
        fallthrough
    }

    template IN CAA {
        match "^([a-z0-9-]+\.)?stage-correct-caa\.webapp\.com\.$"
        answer "{{ .Name }} 60 IN CAA 0 issue \"digicert.com\""
        fallthrough
    }

    # Keep this test zone authoritative. Forwarding missing fixture records to a
    # public resolver makes verification depend on external DNS availability.
    # Authoritative empty answers must carry the zone SOA in the authority
    # section (RFC 2308 NODATA), otherwise the DNS client rejects the response.
    template IN A {
        match "^([a-z0-9-]+\.)*webapp\.com\.$"
        authority "webapp.com. 60 IN SOA ns.webapp.com. hostmaster.webapp.com. 1 3600 600 86400 60"
        rcode NOERROR
    }

    template IN AAAA {
        match "^([a-z0-9-]+\.)*webapp\.com\.$"
        authority "webapp.com. 60 IN SOA ns.webapp.com. hostmaster.webapp.com. 1 3600 600 86400 60"
        rcode NOERROR
    }

    template IN CNAME {
        match "^([a-z0-9-]+\.)*webapp\.com\.$"
        authority "webapp.com. 60 IN SOA ns.webapp.com. hostmaster.webapp.com. 1 3600 600 86400 60"
        rcode NOERROR
    }

    template IN CAA {
        match "^([a-z0-9-]+\.)*webapp\.com\.$"
        authority "webapp.com. 60 IN SOA ns.webapp.com. hostmaster.webapp.com. 1 3600 600 86400 60"
        rcode NOERROR
    }
}

# Zones configuration
wrong-a-webapp.com {
    bind 172.16.238.100
    template IN A {
        match "^([a-z0-9-]+\.)?wrong-a-webapp\.com\.$"
        answer "{{ .Name }} 60 IN A 203.0.0.5"
        fallthrough
    }
}
