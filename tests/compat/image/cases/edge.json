    {
      "name": "save: the extension decides the format",
      "steps": [
        {
          "op": "image.new",
          "args": {
            "blob": {
              "$bytes": "iVBORw0KGgoAAAANSUhEUgAAAAYAAAACAgMAAAAGM0XNAAAAIGNIUk0AAHomAACAhAAA+gAAAIDoAAB1MAAA6mAAADqYAAAXcJy6UTwAAAAJUExURf8AAACAAAAA/1bIupQAAAAOSURBVAjXY2BdwMC6AAADSQFL+J/ImAAAAABJRU5ErkJggg=="
            }
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "image.save",
          "args": {
            "image": {
              "$ref": "i"
            },
            "path": "/tmp/compat-fs/${ns}/x.png",
            "type": "jpg",
            "quality": 90
          },
          "expect": null
        },
        {
          "op": "file.probe",
          "args": {
            "path": "/tmp/compat-fs/${ns}/x.png"
          },
          "expect": {
            "format": "PNG",
            "width": 6,
            "height": 2,
            "frames": 1,
            "delay": 0
          }
        },
        {
          "op": "image.save",
          "args": {
            "image": {
              "$ref": "i"
            },
            "path": "/tmp/compat-fs/${ns}/y.jpg",
            "type": "png",
            "quality": 90
          },
          "expect": null
        },
        {
          "op": "file.probe",
          "args": {
            "path": "/tmp/compat-fs/${ns}/y.jpg"
          },
          "expect": {
            "format": "JPEG",
            "width": 6,
            "height": 2,
            "frames": 1,
            "delay": 0
          }
        },
        {
          "op": "image.save",
          "args": {
            "image": {
              "$ref": "i"
            },
            "path": "/tmp/compat-fs/${ns}/z.unknownext",
            "type": "gif",
            "quality": 90
          },
          "expect": null
        },
        {
          "op": "file.probe",
          "args": {
            "path": "/tmp/compat-fs/${ns}/z.unknownext"
          },
          "expect": {
            "format": "GIF",
            "width": 6,
            "height": 2,
            "frames": 1,
            "delay": 0
          }
        }
      ]
    },
