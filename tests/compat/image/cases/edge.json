{
  "cases": [
    {
      "name": "gravity types",
      "steps": [
        {
          "op": "image.gravity_types",
          "args": {},
          "expect": [
            "center",
            "top-left",
            "top",
            "top-right",
            "left",
            "right",
            "bottom-left",
            "bottom",
            "bottom-right"
          ]
        }
      ]
    },
    {
      "name": "resource limit",
      "steps": [
        {
          "op": "image.set_resource_limit",
          "args": {
            "type": "area",
            "value": 512000000
          },
          "expect": null
        }
      ]
    },
    {
      "name": "size by fixed height and width",
      "steps": [
        {
          "op": "image.new",
          "args": {
            "path": "packages/image/tests/resources/disk-a/kitten-1.jpg"
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "image.size_by_fixed_height",
          "args": {
            "image": {
              "$ref": "i"
            },
            "height": 100
          },
          "expect": 95
        },
        {
          "op": "image.size_by_fixed_width",
          "args": {
            "image": {
              "$ref": "i"
            },
            "width": 100
          },
          "expect": 104
        }
      ]
    },
    {
      "name": "empty blob",
      "steps": [
        {
          "op": "image.new",
          "args": {
            "blob": ""
          },
          "expect": {
            "$error": {
              "class": "ImagickException",
              "message": "Zero size image string passed"
            }
          }
        }
      ]
    },
    {
      "name": "unknown format",
      "steps": [
        {
          "op": "image.new",
          "args": {
            "blob": "garbage"
          },
          "expect": {
            "$error": {
              "class": "ImagickException",
              "message": "no decode delegate for this image format `' @ error/blob.c/BlobToImage/479"
            }
          }
        }
      ]
    },
