{
  "source": "packages/http/tests/RouteTest.php",
  "cases": [
    {
      "name": "method",
      "op": "route.inspect",
      "args": {
        "methods": "GET",
        "path": "/",
        "steps": [
          {
            "get": "method"
          },
          {
            "get": "methods"
          },
          {
            "get": "order"
          }
        ]
      },
      "expect": [
        "GET",
        [
          "GET"
        ],
        true
      ]
    },
    {
      "name": "path",
      "op": "route.inspect",
      "args": {
        "path": "/",
        "steps": [
          {
            "get": "path"
          },
          {
            "path": "/path"
          },
          {
            "get": "path"
          }
        ]
      },
      "expect": [
        "/",
        "/path"
      ]
    },
    {
      "name": "description",
      "op": "route.inspect",
      "args": {
        "steps": [
          {
            "get": "desc"
          },
          {
            "desc": "new route"
          },
          {
            "get": "desc"
          }
        ]
      },
      "expect": [
        "",
        "new route"
      ]
    },
    {
      "name": "groups",
      "op": "route.inspect",
      "args": {
        "steps": [
          {
            "get": "groups"
          },
          {
            "groups": [
              "api",
              "homepage"
            ]
          },
          {
            "get": "groups"
          }
        ]
      },
      "expect": [
        [],
        [
          "api",
          "homepage"
        ]
      ]
    },
    {
      "name": "params",
      "op": "route.inspect",
      "args": {
        "steps": [
          {
            "get": "params"
          },
          {
            "param": [
              "x",
              ""
            ]
          },
          {
            "param": [
              "y",
              ""
            ]
          },
          {
            "get": "params"
          }
        ]
      },
      "expect": [
        [],
        [
          "x",
          "y"
        ]
      ]
    },
    {
      "name": "injections",
      "op": "route.inspect",
      "args": {
        "steps": [
          {
            "get": "injections"
          },
          {
            "inject": "user"
          },
          {
            "inject": "time"
          },
          {
            "get": "injections"
          }
        ]
      },
      "expect": [
        [],
        [
          "user",
          "time"
        ]
      ]
    },
    {
      "name": "labels",
      "op": "route.inspect",
      "args": {
        "steps": [
          {
            "get": [
              "label",
              "key",
              "default"
            ]
          },
          {
            "label": [
              "key",
              "value"
            ]
          },
          {
            "get": [
              "label",
              "key",
              "default"
            ]
          }
        ]
      },
      "expect": [
        "default",
        "value"
      ]
    },
    {
      "name": "hooks",
      "op": "route.inspect",
      "args": {
        "steps": [
          {
            "get": "hook"
          },
          {
            "hook": true
          },
          {
            "get": "hook"
          },
          {
            "hook": false
          },
          {
            "get": "hook"
          }
        ]
      },
      "expect": [
        true,
