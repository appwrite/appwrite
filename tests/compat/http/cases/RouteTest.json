    {
      "name": "methods deduplicated",
      "op": "route.inspect",
      "args": {
        "methods": [
          "GET",
          "POST",
          "GET"
        ],
        "steps": [
          {
            "get": "methods"
          },
          {
            "get": "method"
          }
        ]
      },
      "expect": [
        [
          "GET",
          "POST"
        ],
        "GET"
      ]
