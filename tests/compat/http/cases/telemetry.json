              ]
            }
          ]
        },
        "requests": [
          {
            "method": "GET",
            "uri": "/x/1",
            "headers": [
              [
                "Host",
                "h"
              ],
              [
                "X-A",
                "b"
              ]
            ]
          },
          {
            "method": "POST",
            "uri": "/missing",
            "headers": [
              [
                "Host",
                "h"
              ]
            ]
          }
        ]
      }
    },
    {
      "name": "no metrics before a request",
      "op": "http.run",
      "args": {
