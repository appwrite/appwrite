            ]
          ]
        },
        "steps": [
          {
            "get": [
              "cookie",
              "a"
            ]
          }
        ]
      },
      "expect": {
        "$error": {
          "class": "TypeError",
          "message": "Utopia\\Http\\Request::getCookie(): Return value must be of type string, array returned"
        }
      }
    },
    {
      "name": "query: PHP variable rules",
      "op": "request.inspect",
      "args": {
        "request": {
          "method": "GET",
          "uri": "/?a[b=1&c[d][e=2&f]=3&g[%20h]=4&i.j[k.l]=5&m[]=6&m[]=7&m[5]=8&m[]=9&%41=%42"
        },
        "steps": [
          {
            "get": "params"
          }
        ]
      },
      "expect": [
        {
          "a_b": "1",
          "c": {
            "d": "2"
          },
          "f]": "3",
          "g": {
            " h": "4"
          },
          "i_j": {
            "k.l": "5"
          },
          "m": {
            "0": "6",
            "1": "7",
            "5": "8",
            "6": "9"
          },
          "A": "B"
        }
      ]
    },
    {
      "name": "headers: duplicates and empty values",
      "op": "request.inspect",
      "args": {
        "request": {
          "method": "GET",
          "uri": "/",
          "headers": [
            [
              "X-A",
              "one"
            ],
            [
              "x-a",
              "two"
            ],
            [
              "X-Empty",
              ""
            ],
            [
              "X-B",
              "b"
            ]
          ]
        },
        "steps": [
          {
            "get": "headers"
          },
          {
            "get": [
              "header_line",
              "x-a"
            ]
          },
          {
            "get": [
              "header_line",
              "x-empty",
              "default"
            ]
          }
        ]
      },
      "expect": [
        {
          "x-a": [
            "one",
            "two"
          ],
          "x-empty": [
            ""
          ],
          "x-b": [
            "b"
          ]
        },
        "one, two",
        ""
      ]
    },
    {
      "name": "multipart fields and files",
      "op": "request.inspect",
      "args": {
        "request": {
          "method": "POST",
          "uri": "/up",
          "headers": [
            [
              "Content-Type",
              "multipart/form-data; boundary=\"XB\""
            ]
          ],
          "body": "--XB\r\nContent-Disposition: form-data; name=\"a[x]\"\r\n\r\nv1\r\n--XB\r\nContent-Disposition: form-data; name=\"a[y][]\"\r\n\r\nv2\r\n--XB\r\nContent-Disposition: form-data; name=\"f\"; filename=\"hello.txt\"\r\nContent-Type: text/plain\r\n\r\nhello world\r\n--XB\r\nContent-Disposition: form-data; name=\"g[]\"; filename=\"b.json\"\r\nContent-Type: application/json\r\n\r\n{}\r\n--XB\r\nContent-Disposition: form-data; name=\"none\"; filename=\"\"\r\n\r\nzz\r\n--XB\r\nContent-Disposition: form-data; name=\"Up\"; filename=\"u.txt\"\r\n\r\nup\r\n--XB\r\ncontent-disposition: form-data; name=lower\r\n\r\nplain\r\n--XB--\r\n"
        },
        "steps": [
          {
            "get": "params"
          },
          {
            "get": [
              "files",
              "f"
            ]
          },
          {
            "get": [
              "files",
              "g"
            ]
          },
          {
            "get": [
              "files",
              "none"
            ]
          },
          {
            "get": [
              "files",
              "Up"
            ]
          },
          {
            "get": [
              "files",
              "up"
            ]
          },
          {
            "get": [
              "files",
              "missing"
            ]
          }
        ]
      },
      "expect": [
        {
          "a": {
            "x": "v1",
            "y": [
              "v2"
            ]
          },
          "lower": "plain"
        },
        {
          "type": "text/plain",
          "tmp_name": "hello world",
          "size": 11,
          "name": "hello.txt",
          "error": 0
        },
        {
          "name": [
            "b.json"
          ],
          "type": [
            "application/json"
          ],
          "tmp_name": [
            "{}"
          ],
          "error": [
            0
          ],
          "size": [
            2
          ]
        },
        {
          "type": "",
          "tmp_name": "",
          "size": 0,
          "name": "",
          "error": 4
        },
        [],
        [],
        []
      ]
    },
