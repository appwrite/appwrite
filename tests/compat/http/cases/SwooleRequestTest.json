{
  "source": "packages/http/tests/SwooleRequestTest.php",
  "cases": [
    {
      "name": "json body round trips: bare empty object",
      "op": "request.inspect",
      "args": {
        "request": {
          "method": "POST",
          "uri": "/v1/documents",
          "headers": [
            [
              "Content-Type",
              "application/json"
            ]
          ],
          "body": "{\"data\":{}}"
        },
        "steps": [
          {
            "get": "params"
          }
        ]
      },
      "expect": [
        {
          "data": {}
        }
      ]
    },
