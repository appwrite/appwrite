    {
      "name": "cookies: Swoole rules",
      "op": "request.inspect",
      "args": {
        "request": {
          "method": "GET",
          "uri": "/",
          "headers": [
            [
              "Cookie",
              "a.b=1; a[x]=2; a[x]=3; =v; k=v=w; s=%2B+; t= sp ; u"
            ],
            [
              "Cookie",
              "dup=1; dup=2; c=\"q\""
            ]
          ]
        },
        "steps": [
          {
            "get": "cookies"
          },
          {
            "get": [
              "header",
              "cookie"
            ]
          },
          {
            "get": [
              "cookie",
              "dup"
            ]
          }
        ]
      },
      "expect": [
        {
          "a_b": "1",
          "a": {
            "x": "3"
          },
          "k": "v=w",
          "s": "++",
          "t": " sp ",
          "u": "",
          "dup": "1",
          "c": "\"q\""
        },
        [],
        "1"
      ]
    },
    {
      "name": "cookie that is an array",
      "op": "request.inspect",
      "args": {
        "request": {
          "method": "GET",
