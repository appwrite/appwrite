            "via": "routes"
          },
          {
            "methods": [
              "GET",
              "POST"
            ],
            "path": "/userinfo",
            "via": "routes"
          }
        ],
        "match": [
          [
            "GET",
            "/userinfo"
          ],
          [
            "POST",
            "/userinfo"
          ]
        ]
      }
    },
    {
      "name": "unknown method added directly",
