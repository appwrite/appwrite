            "path": "/c/:id"
          }
        ],
        "match": [
          [
            "GET",
            "/a/b"
          ],
          [
            "GET",
            "/a/0/b"
          ],
          [
            "GET",
            "/c//d"
          ],
          [
            "GET",
            "//c/d"
          ]
        ]
