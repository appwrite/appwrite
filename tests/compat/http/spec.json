{
  "lib": "http",
  "description": "utopia-php/http: routing, hooks, params with validators and injection, request parsing (Swoole adapter semantics), responses, static files, views.",
  "complete": false,
  "php": {
    "src": [
      "packages/http/src"
    ],
    "tests": [
      "packages/http/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/http"
  },
  "services": [],
  "state": [],
  "ops": {
    "http.run": {
      "doc": "Builds an application from `app` (mode, allow_override, compression, resources, files, init/shutdown/options/error/start/request hooks, routes with methods, aliases, groups, params, injections and action statements, wildcard) and dispatches each of `requests` (parsed by Swoole on PHP) through run() or execute(). Returns route registration results and, per request, what the server adapter was asked to send (status, headers, cookies as Set-Cookie lines, body), the values actions emitted and the error run() raised. With `telemetry`, the server metrics run() recorded through a test telemetry adapter (counts for the time-dependent ones).",
      "covers": [
        "Utopia\\Http\\Http::__construct",
        "Utopia\\Http\\Http::get",
        "Utopia\\Http\\Http::post",
        "Utopia\\Http\\Http::put",
        "Utopia\\Http\\Http::patch",
        "Utopia\\Http\\Http::delete",
        "Utopia\\Http\\Http::routes",
        "Utopia\\Http\\Http::addRoute",
        "Utopia\\Http\\Http::wildcard",
        "Utopia\\Http\\Http::init",
        "Utopia\\Http\\Http::shutdown",
        "Utopia\\Http\\Http::options",
        "Utopia\\Http\\Http::error",
        "Utopia\\Http\\Http::onRequest",
        "Utopia\\Http\\Http::setAllowOverride",
        "Utopia\\Http\\Http::resources",
        "Utopia\\Http\\Http::context",
        "Utopia\\Http\\Http::loadFiles",
        "Utopia\\Http\\Http::match",
        "Utopia\\Http\\Http::execute",
        "Utopia\\Http\\Http::run",
        "Utopia\\Http\\Http::reset",
        "Utopia\\Http\\Http::setCompression",
        "Utopia\\Http\\Http::setCompressionMinSize",
        "Utopia\\Http\\Http::setCompressionSupported",
        "Utopia\\Http\\Route::alias",
        "Utopia\\Http\\Route::hook",
        "Utopia\\Http\\Adapter\\Swoole\\Request::__construct",
        "Utopia\\Http\\Http::setTelemetry",
        "Utopia\\Http\\Adapter::setTelemetry"
      ],
      "mask": {
        "paths": [
          "/responses/*/wire/headers/x-debug-speed",
          "/responses/*/wire/headers/expires"
        ],
        "reason": "X-Debug-Speed is the elapsed time; a static file's Expires header is the current time plus two years"
      }
    },
    "http.start": {
      "doc": "Builds an application and runs start(): start hooks in order, the error hooks when one fails.",
      "covers": [
        "Utopia\\Http\\Http::start",
        "Utopia\\Http\\Http::onStart"
      ]
    },
    "http.mode": {
      "doc": "Http::setMode(set), then getMode/isProduction/isDevelopment/isStage.",
      "covers": [
        "Utopia\\Http\\Http::getMode",
        "Utopia\\Http\\Http::setMode",
        "Utopia\\Http\\Http::isProduction",
        "Utopia\\Http\\Http::isDevelopment",
        "Utopia\\Http\\Http::isStage"
      ]
    },
    "http.env": {
      "doc": "Http::getEnv(key, default) for a key the process does not define.",
      "covers": [
        "Utopia\\Http\\Http::getEnv"
      ]
    },
    "request.inspect": {
      "doc": "A request parsed by Swoole from its parts (method, uri, protocol, headers, body or body_json, remote_addr, trusted), mutated and read by `steps` (get, set_header, add_header, remove_header, set_query, set_payload, set_cookies, set_server, set_method, set_uri). Uploaded files report their content in place of tmp_name.",
      "covers": [
        "Utopia\\Http\\Request::getParam",
        "Utopia\\Http\\Request::getParams",
        "Utopia\\Http\\Request::getQuery",
        "Utopia\\Http\\Request::getPayload",
        "Utopia\\Http\\Request::getURI",
        "Utopia\\Http\\Request::getCookie",
        "Utopia\\Http\\Request::getCookieParams",
        "Utopia\\Http\\Request::setCookieParams",
        "Utopia\\Http\\Request::hasHeader",
        "Utopia\\Http\\Request::getHeader",
        "Utopia\\Http\\Request::getHeaderLine",
        "Utopia\\Http\\Request::getHeaders",
        "Utopia\\Http\\Request::setHeader",
        "Utopia\\Http\\Request::addHeader",
        "Utopia\\Http\\Request::removeHeader",
        "Utopia\\Http\\Request::getSize",
        "Utopia\\Http\\Request::getContentRangeStart",
        "Utopia\\Http\\Request::getContentRangeEnd",
        "Utopia\\Http\\Request::getContentRangeSize",
        "Utopia\\Http\\Request::getContentRangeUnit",
        "Utopia\\Http\\Request::getRangeStart",
        "Utopia\\Http\\Request::getRangeEnd",
        "Utopia\\Http\\Request::getRangeUnit",
        "Utopia\\Http\\Request::setQueryString",
        "Utopia\\Http\\Request::setPayload",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getRawPayload",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getServer",
        "Utopia\\Http\\Adapter\\Swoole\\Request::setServer",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getIP",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getProtocol",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getPort",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getHostname",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getMethod",
        "Utopia\\Http\\Adapter\\Swoole\\Request::setMethod",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getURI",
        "Utopia\\Http\\Adapter\\Swoole\\Request::setURI",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getReferer",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getOrigin",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getUserAgent",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getAccept",
        "Utopia\\Http\\Adapter\\Swoole\\Request::getFiles"
      ],
      "fuzz": [
        {
          "name": "query strings",
          "args": {
            "gen": "object",
            "fields": {
              "request": {
                "gen": "object",
                "fields": {
                  "method": {
                    "gen": "pick",
                    "from": [
                      "GET",
                      "POST"
                    ]
                  },
                  "uri": {
                    "gen": "concat",
                    "parts": [
                      {
                        "gen": "const",
                        "value": "/p?"
                      },
                      {
                        "gen": "ref",
                        "name": "query_uri"
                      }
                    ]
                  },
                  "headers": {
                    "gen": "const",
                    "value": [
                      [
                        "Content-Type",
                        "application/x-www-form-urlencoded"
                      ]
                    ]
                  },
                  "body": {
                    "gen": "ref",
                    "name": "query"
                  }
                }
              },
              "steps": {
                "gen": "const",
                "value": [
                  {
                    "get": "params"
                  },
                  {
                    "get": [
                      "query",
                      "a"
                    ]
                  },
                  {
                    "get": [
                      "payload",
                      "a",
                      "none"
                    ]
                  }
                ]
              }
            }
          },
          "iterations": 2000
        },
        {
          "name": "cookies and headers",
          "args": {
            "gen": "object",
            "fields": {
              "request": {
                "gen": "object",
                "fields": {
                  "uri": {
                    "gen": "const",
                    "value": "/"
                  },
                  "headers": {
                    "gen": "array",
                    "items": {
                      "gen": "ref",
                      "name": "header"
                    },
                    "min": 0,
                    "max": 6
                  },
                  "remote_addr": {
                    "gen": "pick",
                    "from": [
                      "10.0.0.1",
                      "::1"
                    ]
                  },
                  "trusted": {
                    "gen": "const",
                    "value": {
                      "ip": [
                        "x-forwarded-for",
                        "X-Real-IP"
                      ],
                      "proto": [
                        "x-forwarded-proto",
                        "x-cdn"
                      ]
                    }
                  }
                }
              },
              "steps": {
                "gen": "const",
                "value": [
                  {
                    "get": "cookies"
                  },
                  {
                    "get": "headers"
                  },
                  {
                    "get": [
                      "cookie",
                      "a",
                      "none"
                    ]
                  },
                  {
                    "get": [
                      "header_line",
                      "x-a",
                      "none"
                    ]
                  },
                  {
                    "get": "ip"
                  },
                  {
                    "get": "protocol"
                  },
                  {
                    "get": "hostname"
                  },
                  {
                    "get": "port"
                  },
                  {
                    "get": "size"
                  },
                  {
                    "get": "range_unit"
                  },
                  {
                    "get": "range_start"
                  },
                  {
                    "get": "range_end"
                  },
                  {
                    "get": "content_range_unit"
                  },
                  {
                    "get": "content_range_start"
                  },
                  {
                    "get": "content_range_end"
                  },
                  {
                    "get": "content_range_size"
                  },
                  {
                    "get": [
                      "referer",
                      "none"
                    ]
                  }
                ]
              }
            }
          },
          "iterations": 2000
        },
        {
          "name": "json bodies",
          "args": {
            "gen": "object",
            "fields": {
              "request": {
                "gen": "object",
                "fields": {
                  "method": {
                    "gen": "pick",
                    "from": [
                      "POST",
                      "PATCH",
                      "DELETE"
                    ]
                  },
                  "uri": {
                    "gen": "const",
                    "value": "/"
                  },
                  "headers": {
                    "gen": "pick",
                    "from": [
                      [
                        [
                          "Content-Type",
                          "application/json"
                        ]
                      ],
                      [
                        [
                          "Content-Type",
                          "application/json; charset=utf-8"
                        ]
                      ]
                    ]
                  },
                  "body": {
                    "gen": "one_of",
                    "of": [
                      {
                        "gen": "string",
                        "alphabet": "{}[]\":, \n\t0a1",
                        "min": 0,
                        "max": 24
                      },
                      {
                        "gen": "ref",
                        "name": "json_text"
                      }
                    ]
                  }
                }
              },
              "steps": {
                "gen": "const",
                "value": [
                  {
                    "get": "params"
                  },
                  {
                    "get": "raw_payload"
                  }
                ]
              }
            }
          },
          "iterations": 2000
        },
        {
          "name": "multipart bodies",
          "args": {
            "gen": "object",
            "fields": {
              "request": {
                "gen": "object",
                "fields": {
                  "method": {
                    "gen": "const",
                    "value": "POST"
                  },
                  "uri": {
                    "gen": "const",
                    "value": "/up"
                  },
                  "headers": {
                    "gen": "const",
                    "value": [
                      [
                        "Content-Type",
                        "multipart/form-data; boundary=XB"
                      ]
                    ]
                  },
                  "body": {
                    "gen": "concat",
                    "parts": [
                      {
                        "gen": "repeat",
                        "part": {
                          "gen": "ref",
                          "name": "multipart_part"
                        },
                        "sep": "",
                        "min": 0,
                        "max": 4
                      },
                      {
                        "gen": "const",
                        "value": "--XB--\r\n"
                      }
                    ]
                  }
                }
              },
              "steps": {
                "gen": "const",
                "value": [
                  {
                    "get": "params"
                  },
                  {
                    "get": [
                      "files",
                      "f"
                    ]
                  },
                  {
                    "get": [
                      "files",
                      "g"
                    ]
                  }
                ]
              }
            }
          },
          "iterations": 1000
        }
      ]
    },
    "response.run": {
      "doc": "A response driven by statements (status, content_type, headers, cookies, payload switches, compression settings, send/text/html/json/jsonp/iframe/redirect/no_content/chunk) and read by `get` steps; returns what was sent.",
      "covers": [
        "Utopia\\Http\\Response::__construct",
        "Utopia\\Http\\Response::setAcceptEncoding",
        "Utopia\\Http\\Response::setCompressionMinSize",
        "Utopia\\Http\\Response::setCompressionSupported",
        "Utopia\\Http\\Response::setContentType",
        "Utopia\\Http\\Response::getContentType",
        "Utopia\\Http\\Response::isSent",
        "Utopia\\Http\\Response::setStatusCode",
        "Utopia\\Http\\Response::getStatusCode",
        "Utopia\\Http\\Response::getSize",
        "Utopia\\Http\\Response::disablePayload",
        "Utopia\\Http\\Response::enablePayload",
        "Utopia\\Http\\Response::setHeader",
        "Utopia\\Http\\Response::addHeader",
        "Utopia\\Http\\Response::removeHeader",
        "Utopia\\Http\\Response::hasHeader",
        "Utopia\\Http\\Response::getHeader",
        "Utopia\\Http\\Response::getHeaderLine",
        "Utopia\\Http\\Response::getHeaders",
        "Utopia\\Http\\Response::addCookie",
        "Utopia\\Http\\Response::removeCookie",
        "Utopia\\Http\\Response::getCookies",
        "Utopia\\Http\\Response::send",
        "Utopia\\Http\\Response::chunk",
        "Utopia\\Http\\Response::redirect",
        "Utopia\\Http\\Response::html",
        "Utopia\\Http\\Response::text",
        "Utopia\\Http\\Response::json",
        "Utopia\\Http\\Response::jsonp",
        "Utopia\\Http\\Response::iframe",
        "Utopia\\Http\\Response::noContent"
      ],
      "mask": {
        "paths": [
          "/wire/headers/x-debug-speed",
          "/out/*/x-debug-speed"
        ],
        "reason": "X-Debug-Speed is the elapsed time"
      }
    },
    "compression.negotiate": {
      "doc": "Compression::fromAcceptEncoding(accept, supported): the content encoding Response::send() picks, or null.",
      "fuzz": [
        {
          "args": {
            "gen": "object",
            "fields": {
              "accept": {
                "gen": "repeat",
                "part": {
                  "gen": "concat",
                  "parts": [
                    {
                      "gen": "pick",
                      "from": [
                        "gzip",
                        "br",
                        "BR",
                        "zstd",
                        "deflate",
                        "identity",
                        "none",
                        "*",
                        "x",
                        " gzip "
                      ]
                    },
                    {
                      "gen": "pick",
                      "from": [
                        "",
                        ";q=0",
                        ";q=0.5",
                        "; q=0.9",
                        ";q=1",
                        ";q=x",
                        ";level=1"
                      ]
                    }
                  ]
                },
                "sep": ",",
                "min": 0,
                "max": 4
              },
              "supported": {
                "gen": "pick",
                "from": [
                  [],
                  [
                    "gzip",
                    "brotli"
                  ],
                  [
                    "deflate"
                  ]
                ]
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "router.run": {
      "doc": "Router::reset(), setAllowOverride, routes added (new Route + Router::addRoute, or Http::routes) with aliases, an optional wildcard; then Router::match for each [method, path], preparePath for each path, and the registered templates by method.",
      "covers": [
        "Utopia\\Http\\Router::getRoutes",
        "Utopia\\Http\\Router::getAllowOverride",
        "Utopia\\Http\\Router::setAllowOverride",
        "Utopia\\Http\\Router::addRoute",
        "Utopia\\Http\\Router::addRouteAlias",
        "Utopia\\Http\\Router::setWildcard",
        "Utopia\\Http\\Router::match",
        "Utopia\\Http\\Router::preparePath",
        "Utopia\\Http\\Router::reset",
        "Utopia\\Http\\Http::getRoutes",
        "Utopia\\Http\\Http::getAllowOverride",
        "Utopia\\Http\\Route::__construct",
        "Utopia\\Http\\Route::setPathParam",
        "Utopia\\Http\\Route::resolveParams",
        "Utopia\\Http\\RouteMatch::__construct"
      ],
      "fuzz": [
        {
          "name": "paths",
          "args": {
            "gen": "object",
            "fields": {
              "routes": {
                "gen": "const",
                "value": [
                  {
                    "path": "/v1/users/:userId"
                  },
                  {
                    "path": "/v1/users/identities"
                  },
                  {
                    "path": "/v1/users/:userId/sessions/:sessionId"
                  },
                  {
                    "path": "/v1/:a/b"
                  },
                  {
                    "path": "/files/*"
                  },
                  {
                    "path": "/0/x"
                  },
                  {
                    "methods": [
                      "GET",
                      "POST"
                    ],
                    "path": "/x/:y",
                    "aliases": [
                      "/z/:w/q"
                    ]
                  }
                ]
              },
              "wildcard": {
                "gen": "bool"
              },
              "paths": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "path"
                },
                "min": 1,
                "max": 4
              },
              "methods": {
                "gen": "const",
                "value": [
                  "GET",
                  "POST",
                  "PUT"
                ]
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "route.inspect": {
      "doc": "new Route(methods, path) configured and read by steps (desc, groups, label, path, hook, param, inject; get: path, method, methods, groups, desc, hook, label, params, injections, order).",
      "covers": [
        "Utopia\\Http\\Route::getOrder",
        "Utopia\\Http\\Route::path",
        "Utopia\\Http\\Route::getMethod",
        "Utopia\\Http\\Route::getPath",
        "Utopia\\Http\\Route::getHook",
        "Utopia\\Http\\Route::getMethods"
      ]
    },
    "view.run": {
      "doc": "Views created by name and driven by steps (new, set_param, get_param, set_path, set_rendered, is_rendered, print, render, exec, set_parent, parent). Templates are files without PHP code.",
      "covers": [
        "Utopia\\Http\\View::__construct",
        "Utopia\\Http\\View::setParam",
        "Utopia\\Http\\View::setParent",
        "Utopia\\Http\\View::getParent",
        "Utopia\\Http\\View::getParam",
        "Utopia\\Http\\View::setPath",
        "Utopia\\Http\\View::setRendered",
        "Utopia\\Http\\View::isRendered",
        "Utopia\\Http\\View::addFilter",
        "Utopia\\Http\\View::print",
        "Utopia\\Http\\View::render",
        "Utopia\\Http\\View::exec"
      ]
    },
    "files.run": {
      "doc": "A Files store driven by steps (load, count, is_loaded, contents, mime, add_mime_type, remove_mime_type, mime_types, reset).",
      "covers": [
        "Utopia\\Http\\Files::addMimeType",
        "Utopia\\Http\\Files::removeMimeType",
        "Utopia\\Http\\Files::getMimeTypes",
        "Utopia\\Http\\Files::getCount",
        "Utopia\\Http\\Files::load",
        "Utopia\\Http\\Files::isFileLoaded",
        "Utopia\\Http\\Files::getFileContents",
        "Utopia\\Http\\Files::getFileMimeType",
        "Utopia\\Http\\Files::reset"
      ]
    },
    "trusted.new": {
      "doc": "new TrustedHeaders(ip, proto): the normalized lists.",
      "covers": [
        "Utopia\\Http\\TrustedHeaders::__construct"
      ],
      "fuzz": [
        {
          "args": {
            "gen": "object",
            "fields": {
              "ip": {
                "gen": "array",
                "items": {
                  "gen": "string",
                  "alphabet": "Xa- \t0",
                  "min": 0,
                  "max": 5
                },
                "min": 0,
                "max": 3
              },
              "proto": {
                "gen": "array",
                "items": {
                  "gen": "string",
                  "alphabet": "Xa- \t0",
                  "min": 0,
                  "max": 5
                },
                "min": 0,
                "max": 3
              }
            }
          },
          "iterations": 500
        }
      ]
    },
    "mode.settings": {
      "doc": "Mode::HYPERLOOP_A/B->settings(): the settings with a meaning outside Swoole, and the relations ModeTest checks between worker and reactor counts.",
      "covers": [
        "Utopia\\Http\\Adapter\\Swoole\\Mode::settings",
        "Utopia\\Http\\Adapter\\Swoole\\Mode::defaults"
      ]
    }
  },
  "generators": {
    "query": {
      "gen": "repeat",
      "part": {
        "gen": "one_of",
        "of": [
          {
            "gen": "concat",
            "parts": [
              {
                "gen": "ref",
                "name": "qname"
              },
              {
                "gen": "const",
                "value": "="
              },
              {
                "gen": "repeat",
                "part": {
                  "gen": "pick",
                  "from": [
                    "a",
                    "%2B",
                    "+",
                    "=",
                    "%5B",
                    ".",
                    "é",
                    "%20",
                    "%00",
                    "%41",
                    "&"
                  ]
                },
                "sep": "",
                "min": 0,
                "max": 5
              }
            ]
          },
          {
            "gen": "ref",
            "name": "qname"
          }
        ]
      },
      "sep": "&",
      "min": 0,
      "max": 6
    },
    "qname": {
      "gen": "one_of",
      "of": [
        {
          "gen": "repeat",
          "part": {
            "gen": "pick",
            "from": [
              "a",
              "b",
              "[",
              "]",
              ".",
              "+",
              "_",
              "%5B",
              "%5D",
              "0",
              "%20",
              "%00",
              "%2E",
              "é"
            ]
          },
          "sep": "",
          "min": 0,
          "max": 6
        },
        {
          "gen": "pick",
          "from": [
            "a",
            "a[]",
            "a[b]",
            "a[b][]",
            "a[0]",
            "a[ b]",
            "a.b",
            " a",
            "a[",
            "a[b",
            "a]",
            "%61",
            "a%5Bb%5D",
            "a[1]",
            "a[-1]",
            "a[01]"
          ]
        }
      ]
    },
    "header": {
      "gen": "ref",
      "name": "header_pair"
    },
    "header_pair": {
      "gen": "object",
      "fields": {
        "n": {
          "gen": "pick",
          "from": [
            "Cookie",
            "cookie",
            "X-A",
            "x-a",
            "Host",
            "X-Forwarded-For",
            "X-Real-IP",
            "X-Forwarded-Proto",
            "X-CDN",
            "X-Forwarded-Host",
            "X-Forwarded-Port",
            "Range",
            "Content-Range",
            "Referer"
          ]
        },
        "v": {
          "gen": "one_of",
          "of": [
            {
              "gen": "repeat",
              "part": {
                "gen": "pick",
                "from": [
                  "a",
                  "=",
                  ";",
                  "[",
                  "]",
                  ".",
                  "%2B",
                  "%20",
                  "+",
                  ",",
                  "\"",
                  "0",
                  "b",
                  " b",
                  "%41",
                  "%E2%82%AC"
                ]
              },
              "sep": "",
              "min": 0,
              "max": 8
            },
            {
              "gen": "pick",
              "from": [
                "203.0.113.7, 10.0.0.1",
                "::1",
                "2001:db8::1",
                "999.1.1.1",
                "https",
                "HTTPS, http",
                "gopher",
                "example.com:8080",
                "[::1]:9000",
                "bytes=0-499",
                "bytes=5-4",
