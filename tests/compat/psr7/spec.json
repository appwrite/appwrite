  "quirks": [
    {
      "symbol": "Utopia\\Psr7\\Message::withHeader",
      "description": "The header name check is preg_match('/^[...]+$/'), whose $ also matches before a final newline: a name ending in one \"\\n\" is accepted and stored with it.",
      "case": "request.json#header order and values"
    }
  ],
  "deviations": [
    {
      "symbol": "Utopia\\Psr7\\Message::withHeader",
      "php": "A header value is any scalar or Stringable, or an array of them; anything else (null, a nested array, an object) throws InvalidArgumentException('Invalid header value.').",
      "reason": "utopia_psr7::HeaderValues is implemented for strings, numbers and booleans and lists of them, so other values cannot be passed; PHP's only behaviour for them is the error."
    },
    {
      "symbol": "Utopia\\Psr7\\Uri::__construct",
      "php": "`$port` is any int; one outside 1..65535 is kept and printed (`:70000`).",
      "reason": "utopia_psr7::uri::Parts::port is an Option<u16>; parse_url() never yields such a port and withPort() refuses it, so only the constructor could build one."
    },
    {
      "symbol": "Utopia\\Psr7\\Uri::withPort",
      "php": "A port outside 1..65535 (negative, or above 65535) throws InvalidArgumentException('Invalid URI port.').",
      "reason": "Uri::with_port takes an Option<u16>: only 0 is representable among invalid ports, and it fails the same way."
    },
    {
      "symbol": "Utopia\\Psr7\\Uri::parse",
      "php": "URI strings are bytes: a host or user info that is not UTF-8 is kept as it is.",
      "reason": "Rust URIs are str; the fuzz generates UTF-8 URIs (paths, queries and fragments are percent-encoded on both sides)."
    },
    {
      "symbol": "Utopia\\Psr7\\Response::__construct",
      "php": "`$statusCode` is any int; outside 100..599 throws InvalidArgumentException('Invalid response status code.').",
      "reason": "Response::new takes a u16 status: values outside u16 cannot be passed; inside it, 0..99 and 600..65535 fail the same way."
    },
    {
      "symbol": "Utopia\\Psr7\\Response::withStatus",
      "php": "As the constructor: any int, refused outside 100..599.",
      "reason": "Response::with_status takes a u16, as Response::new."
    },
    {
      "symbol": "Utopia\\Psr7\\Response::xml",
      "php": "Returns a SimpleXMLElement, and takes libxml `$options` (LIBXML_NOCDATA, LIBXML_NOBLANKS, ...) that change how libxml builds the tree; namespaced elements and attributes are reached through children($ns) and attributes($ns).",
      "reason": "Rust reads a well-formed document into utopia_psr7::xml::Element (name, attributes, own text, children: what getName(), attributes(), (string) and children() expose without a namespace), without libxml or its option flags."
    },
    {
      "symbol": "Utopia\\Psr7\\ServerRequest::withUploadedFiles",
      "php": "Any array is accepted and checked: a leaf that is not an UploadedFileInterface throws InvalidArgumentException('Uploaded files must be a tree of UploadedFileInterface instances.') (ServerRequestTest::testUploadedFilesMustBePsrUploadedFileTree, its second half).",
      "reason": "utopia_psr7::UploadedFiles is a tree whose leaves are UploadedFile values, so another leaf cannot be built; PHP's only behaviour for one is the error. The same holds for the constructor's $uploadedFiles."
    },
    {
      "symbol": "Utopia\\Psr7\\ServerRequest::withParsedBody",
      "php": "`$data` is any PHP value: an object other than stdClass is kept as an object.",
      "reason": "Parsed bodies are serde_json values: JSON arrays and objects (scalars are refused as in PHP)."
    },
    {
      "symbol": "Utopia\\Psr7\\Request\\Factory::json",
      "php": "`$data` is any PHP value; a string that is not UTF-8 throws JsonException('Malformed UTF-8 characters, possibly incorrectly encoded') (FactoryTest::testItThrowsWhenJsonCannotBeEncoded).",
      "reason": "The data is a serde_json::Value, whose strings are UTF-8, so the failing input cannot be built; it is encoded as json_encode() encodes the PHP value it decodes to."
    },
    {
      "symbol": "Utopia\\Psr7\\Response\\Multipart\\Part::header",
      "php": "A header named like an integer (`12`) is an integer key of the headers array, and strcasecmp() under strict_types throws TypeError when header(), headerLine(), name(), filename() or contentType() reaches it before a match.",
      "reason": "Header names are bytes in Rust and compare case-insensitively; PHP's only behaviour on such a name is the TypeError."
    },
    {
      "symbol": "Utopia\\Psr7\\UploadedFile::moveTo",
      "php": "Outside the CLI SAPI the file is moved with move_uploaded_file(), which only moves files PHP received in an upload.",
      "reason": "Rust has no SAPI: moving is a rename, as on PHP's CLI (where the compat driver runs)."
    }
  ]
