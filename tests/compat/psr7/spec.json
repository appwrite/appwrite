{
  "lib": "psr7",
  "description": "utopia-php/psr7: PSR-7 messages (requests, responses, server requests) with case-insensitive headers, URIs, streams over memory or files, uploaded files, multipart request bodies and responses, and the PSR-17 factories, including the typed request builders (JSON, form, text, XML, raw, query string, multipart).",
  "complete": true,
  "php": {
    "src": [
      "packages/psr7/src"
    ],
    "tests": [
      "packages/psr7/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/psr7"
  },
  "services": [],
  "state": [
    "files"
  ],
  "ops": {
    "constants": {
      "doc": "the constants of Method, Header and ContentType, by name"
    },
    "fixture.write": {
      "doc": "writes a file (creating its directory) for the cases to read: test setup, no library call"
    },
    "uri.inspect": {
      "doc": "Uri::parse(uri) and every getter, in one call (for fuzzing)",
      "covers": [
        "Utopia\\Psr7\\Uri::parse",
        "Utopia\\Psr7\\Uri::__toString"
      ],
      "fuzz": [
        {
          "name": "urls",
          "args": {
            "gen": "object",
            "fields": {
              "uri": {
                "gen": "ref",
                "name": "uri"
              }
            }
          },
          "iterations": 4000
        },
        {
          "name": "free text",
          "args": {
            "gen": "object",
            "fields": {
              "uri": {
                "gen": "string",
                "alphabet": "url",
                "max": 40,
                "tricky": 0.3
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "uri.change": {
      "doc": "Uri::parse(uri)->{method}(...args) and every getter, in one call (for fuzzing)",
      "covers": [
        "Utopia\\Psr7\\Uri::withPath",
        "Utopia\\Psr7\\Uri::withQuery",
        "Utopia\\Psr7\\Uri::withFragment",
        "Utopia\\Psr7\\Uri::withHost",
        "Utopia\\Psr7\\Uri::withScheme",
        "Utopia\\Psr7\\Uri::withUserInfo",
        "Utopia\\Psr7\\Uri::withPort"
      ],
      "fuzz": [
        {
          "name": "encoders",
          "args": {
            "gen": "object",
            "fields": {
              "uri": {
                "gen": "pick",
                "from": [
                  "http://example.com/a?b#c",
                  "https://u:p@h:443/",
                  "/rel",
                  ""
                ]
              },
              "method": {
                "gen": "pick",
                "from": [
                  "withPath",
                  "withQuery",
                  "withFragment",
                  "withHost",
                  "withScheme",
                  "withUserInfo"
                ]
              },
              "args": {
                "gen": "array",
                "items": {
                  "gen": "string",
                  "alphabet": "url",
                  "max": 24,
                  "tricky": 0.3
                },
                "min": 1,
                "max": 2
              }
            }
          },
          "iterations": 4000
        },
        {
          "name": "ports",
          "args": {
            "gen": "object",
            "fields": {
              "uri": {
                "gen": "pick",
                "from": [
                  "http://example.com/",
                  "https://example.com/",
                  "ftp://h/",
                  "//h/"
                ]
              },
              "method": {
                "gen": "const",
                "value": "withPort"
              },
              "args": {
                "gen": "array",
                "items": {
                  "gen": "one_of",
                  "of": [
                    {
                      "gen": "int",
                      "min": 0,
                      "max": 65535
                    },
                    {
                      "gen": "null"
                    }
                  ]
                },
                "min": 1,
                "max": 1
              }
            }
          },
          "iterations": 1000
        }
      ]
    },
    "header.set": {
      "doc": "(new Response())->withHeader(name, value)->getHeaders() (for fuzzing)",
      "covers": [
        "Utopia\\Psr7\\Message::withHeader",
        "Utopia\\Psr7\\Message::getHeaders"
      ],
      "fuzz": [
        {
          "name": "names and values",
          "args": {
            "gen": "object",
            "fields": {
              "name": {
                "gen": "string",
                "alphabet": "abcXYZ019-_.!#$%&'*+^`|~ :\n\r\t()@\"/",
                "max": 8,
                "tricky": 0.2
              },
              "value": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "string",
                    "alphabet": "ascii",
                    "max": 12,
                    "tricky": 0.2
                  },
                  {
                    "gen": "int",
                    "min": -1000,
                    "max": 1000
                  },
                  {
                    "gen": "float",
                    "min": -100,
                    "max": 100
                  },
                  {
                    "gen": "bool"
                  },
                  {
                    "gen": "array",
                    "items": {
                      "gen": "one_of",
                      "of": [
                        {
                          "gen": "string",
                          "alphabet": "ascii",
                          "max": 6
                        },
                        {
                          "gen": "int",
                          "min": -9,
                          "max": 99
                        }
                      ]
                    },
                    "max": 3
                  }
                ]
              }
            }
          },
          "iterations": 4000
        }
      ]
    },
    "response.read": {
      "doc": "a Response with Content-Type and a body, and one of its readers (contentType, json, text, xml, form, multipart) (for fuzzing)",
      "covers": [
        "Utopia\\Psr7\\Response::contentType",
        "Utopia\\Psr7\\Response::json",
        "Utopia\\Psr7\\Response::text",
        "Utopia\\Psr7\\Response::xml",
        "Utopia\\Psr7\\Response::form",
        "Utopia\\Psr7\\Response::multipart"
      ],
      "fuzz": [
        {
          "name": "multipart",
          "args": {
            "gen": "object",
            "fields": {
              "method": {
                "gen": "const",
                "value": "multipart"
              },
              "contentType": {
                "gen": "ref",
                "name": "multipart_type"
              },
              "body": {
                "gen": "ref",
                "name": "multipart_body"
              },
              "lookup": {
                "gen": "const",
                "value": [
                  "content-type",
                  "x"
                ]
              }
            }
          },
          "iterations": 5000
        },
        {
          "name": "content type",
          "args": {
            "gen": "object",
            "fields": {
              "method": {
                "gen": "const",
                "value": "contentType"
              },
              "contentType": {
                "gen": "string",
                "alphabet": "abcABC/;=+- \t\"",
                "max": 20,
                "tricky": 0.2
              }
            }
          },
          "iterations": 2000
        },
        {
          "name": "json",
          "args": {
            "gen": "object",
            "fields": {
              "method": {
                "gen": "const",
                "value": "json"
              },
              "body": {
                "gen": "string",
                "alphabet": "{}[]\":,0123456789.eE+-truefalsnul abc\\u",
                "max": 24,
                "tricky": 0.2
              },
              "args": {
                "gen": "array",
                "items": {
                  "gen": "bool"
                },
                "max": 1
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "form",
          "args": {
            "gen": "object",
            "fields": {
              "method": {
                "gen": "const",
                "value": "form"
              },
              "body": {
                "gen": "string",
                "alphabet": "xy01=&[]%+.z ",
                "max": 24,
                "tricky": 0.2
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "xml",
          "args": {
            "gen": "object",
            "fields": {
              "method": {
                "gen": "const",
                "value": "xml"
              },
              "body": {
                "gen": "ref",
                "name": "xml"
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
