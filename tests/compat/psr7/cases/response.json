{
  "source": [],
  "cases": [
    {
      "name": "json objects as stdClass",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "{\"a\":{\"b\":[1,2.5,\"x\",null,true]},\"c\":{}}",
            "args": [
              false
            ]
          },
          "expect": {
            "a": {
              "b": [
                1,
                2.5,
                "x",
                null,
                true
              ]
            },
            "c": {}
          }
        }
      ]
    },
    {
      "name": "json arrays",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "{\"a\":{\"b\":[1,2.5,\"x\",null,true]},\"c\":{},\"0\":1}",
            "args": [
              true
            ]
          },
          "expect": {
            "a": {
              "b": [
                1,
                2.5,
                "x",
                null,
                true
              ]
            },
            "c": [],
            "0": 1
          }
        }
      ]
    },
    {
      "name": "json syntax error",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "{\"a\":",
            "args": []
          },
          "expect": {
            "$error": {
              "class": "JsonException",
              "message": "Syntax error"
            }
          }
        }
      ]
    },
    {
      "name": "json empty body",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "",
            "args": []
          },
          "expect": {
            "$error": {
              "class": "JsonException",
              "message": "Syntax error"
            }
          }
        }
      ]
    },
    {
      "name": "json depth zero",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "[]",
            "args": [
              true,
              0
            ]
          },
          "expect": {
            "$error": {
              "class": "ValueError",
              "message": "JSON decode depth must be greater than zero."
            }
          }
        }
      ]
    },
    {
      "name": "json depth exceeded",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "[[1]]",
            "args": [
              true,
              1
            ]
          },
          "expect": {
            "$error": {
              "class": "JsonException",
              "message": "Maximum stack depth exceeded"
            }
          }
        }
      ]
    },
    {
      "name": "json depth too large",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "[]",
            "args": [
              true,
              2147483648
            ]
          },
          "expect": {
            "$error": {
              "class": "ValueError",
              "message": "json_decode(): Argument #3 ($depth) must be less than 2147483647"
            }
          }
        }
      ]
    },
    {
      "name": "json big int",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "[12345678901234567890]",
            "args": []
          },
          "expect": [
            1.2345678901234567e+19
          ]
        }
      ]
    },
    {
      "name": "json big int as string",
      "steps": [
        {
          "op": "response.read",
          "args": {
