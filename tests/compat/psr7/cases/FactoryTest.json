          "expect": {
            "protocol": "1.1",
            "headers": {
              "Host": [
                "example.com"
              ],
              "Accept": [
                "application/vnd.api+json"
              ],
              "Content-Type": [
                "application/merge-patch+json"
              ]
            },
            "method": "POST",
            "target": "/users",
            "uri": "https://example.com/users"
          }
        },
        {
          "op": "message.body",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "bind": "r_body",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "r_body"
            },
            "method": "toString"
          },
          "expect": "{\"name\":\"Ada\"}"
        }
      ]
    },
