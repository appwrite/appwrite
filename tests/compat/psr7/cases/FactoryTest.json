      "name": "escapes multipart disposition quoted strings",
      "steps": [
        {
          "op": "part.body",
          "args": {
            "name": "profile\"name",
            "body": "contents",
            "filename": "ada\"notes\\.txt"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "request.factory",
          "args": {
            "method": "multipart",
            "args": [
              "POST",
              "https://example.com/upload",
              {
                "$parts": [
                  {
                    "$ref": "p"
                  }
                ]
              }
            ]
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "multipart.render",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "expect": {
            "contentType": "multipart/form-data; boundary={boundary}",
            "body": "--{boundary}\r\nContent-Disposition: form-data; name=\"profile\\\"name\"; filename=\"ada\\\"notes\\\\.txt\"\r\n\r\ncontents\r\n--{boundary}--\r\n",
            "prefix": "utopia-",
            "length": 39,
            "hex": true
          }
        }
      ]
