    {
      "name": "creates multipart requests",
      "steps": [
        {
          "op": "part.body",
          "args": {
            "name": "avatar",
            "body": "image-bytes",
            "filename": "ada.png",
            "contentType": "image/png"
          },
          "bind": "avatar",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "request.factory",
          "args": {
            "method": "multipart",
            "args": [
              "POST",
              "https://example.com/upload",
              {
                "$parts": {
                  "name": "Ada",
                  "avatar": {
                    "$ref": "avatar"
                  }
                }
              }
            ]
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "multipart.render",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "expect": {
            "contentType": "multipart/form-data; boundary={boundary}",
            "body": "--{boundary}\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nAda\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"avatar\"; filename=\"ada.png\"\r\nContent-Type: image/png\r\n\r\nimage-bytes\r\n--{boundary}--\r\n",
            "prefix": "utopia-",
            "length": 39,
            "hex": true
          }
        },
        {
          "op": "message.body",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "bind": "body",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "multipart.dump",
          "args": {
            "body": {
              "$ref": "body"
            }
          },
          "mask": {
            "paths": [
              "/boundary"
            ],
            "reason": "the boundary is random"
          },
          "expect": {
            "boundary": "<masked>",
            "parts": [
              {
                "name": "name",
                "content": "Ada",
                "path": null,
                "size": 3,
                "filename": null,
                "contentType": null,
                "headers": []
              },
              {
                "name": "avatar",
                "content": "image-bytes",
                "path": null,
                "size": 11,
                "filename": "ada.png",
                "contentType": "image/png",
                "headers": []
              }
            ]
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getMethod"
          },
          "expect": "POST"
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getHeaderLine",
            "args": [
              "Host"
            ]
          },
          "expect": "example.com"
        }
      ]
    },
