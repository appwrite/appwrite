{
  "source": "packages/psr7/tests/Request/FactoryTest.php",
  "cases": [
    {
      "name": "creates JSON requests",
      "steps": [
        {
          "op": "request.factory",
          "args": {
            "method": "json",
            "args": [
              "POST",
              "https://example.com/users",
              {
                "name": "Ada"
              }
            ]
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": {
              "Host": [
                "example.com"
              ],
              "Content-Type": [
                "application/json"
              ],
              "Accept": [
                "application/json"
              ]
            },
            "method": "POST",
            "target": "/users",
            "uri": "https://example.com/users"
          }
        },
        {
          "op": "message.body",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "bind": "r_body",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "r_body"
            },
            "method": "toString"
          },
          "expect": "{\"name\":\"Ada\"}"
        }
      ]
    },
    {
      "name": "allows JSON header overrides",
