        },
        {
          "op": "request.factory",
          "args": {
            "method": "multipart",
            "args": [
              "POST",
              "https://example.com/upload",
              {
                "$parts": [
                  {
                    "$ref": "a"
                  },
                  {
                    "$ref": "b"
                  }
                ]
              }
            ]
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
