{
  "source": "packages/psr7/tests/Response/ResponseTest.php",
  "cases": [
    {
      "name": "decodes JSON responses",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "json",
            "body": "{\"name\":\"Ada\"}"
          },
          "expect": {
            "name": "Ada"
          }
        }
      ]
    },
    {
      "name": "reads the content type without parameters",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "contentType",
            "body": "",
            "contentType": "Application/JSON; charset=utf-8"
          },
          "expect": "application/json"
        }
      ]
    },
    {
      "name": "reads an empty content type when absent",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "contentType",
            "body": ""
          },
          "expect": ""
        }
      ]
    },
    {
      "name": "reads text responses",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "text",
            "body": "Hello, Ada"
          },
          "expect": "Hello, Ada"
        }
      ]
    },
    {
      "name": "decodes XML responses",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "xml",
            "body": "<user><name>Ada</name></user>"
          },
          "expect": {
            "name": "user",
            "attributes": [],
            "text": "",
            "children": [
              {
                "name": "name",
                "attributes": [],
                "text": "Ada",
                "children": []
              }
            ]
          }
        }
      ]
    },
    {
      "name": "rejects invalid XML responses",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "xml",
            "body": "<user><name>Ada</name>"
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Invalid XML response."
            }
          }
        }
      ]
    },
    {
      "name": "decodes form responses",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "form",
            "body": "email=ada%40example.com&name=Ada%20Lovelace"
          },
          "expect": {
            "email": "ada@example.com",
            "name": "Ada Lovelace"
          }
        }
      ]
    },
    {
      "name": "decodes multipart responses",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "multipart",
            "body": "--abc123\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nAda\r\n--abc123\r\nContent-Disposition: form-data; name=\"avatar\"; filename=\"ada.png\"\r\nContent-Type: image/png\r\n\r\nimage-bytes\r\n--abc123--\r\n",
            "contentType": "multipart/form-data; boundary=abc123"
          },
          "expect": [
            {
              "headers": {
                "Content-Disposition": [
                  "form-data; name=\"name\""
                ]
              },
              "body": "Ada",
              "name": "name",
              "filename": null,
              "contentType": null,
              "lookup": []
            },
            {
              "headers": {
                "Content-Disposition": [
                  "form-data; name=\"avatar\"; filename=\"ada.png\""
                ],
                "Content-Type": [
                  "image/png"
                ]
              },
              "body": "image-bytes",
              "name": "avatar",
              "filename": "ada.png",
              "contentType": "image/png",
              "lookup": []
            }
          ]
        }
      ]
    },
    {
      "name": "decodes multipart responses with quoted boundaries and body CRLF",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "multipart",
            "body": "--abc123\r\nContent-Disposition: form-data; name=\"log\"\r\n\r\nline 1\r\nline 2\r\n--abc123--\r\n",
            "contentType": "multipart/mixed; boundary=\"abc123\""
          },
          "expect": [
            {
              "headers": {
                "Content-Disposition": [
                  "form-data; name=\"log\""
                ]
              },
              "body": "line 1\r\nline 2",
              "name": "log",
              "filename": null,
              "contentType": null,
              "lookup": []
            }
          ]
        }
      ]
    },
    {
      "name": "decodes multipart responses with preamble and epilogue",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "multipart",
            "body": "ignored preamble\r\n--abc123\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nAda\r\n--abc123--\r\nignored epilogue",
            "contentType": "multipart/form-data; boundary=abc123"
          },
          "expect": [
            {
              "headers": {
                "Content-Disposition": [
                  "form-data; name=\"name\""
                ]
              },
              "body": "Ada",
              "name": "name",
              "filename": null,
              "contentType": null,
              "lookup": []
            }
          ]
        }
      ]
    },
    {
      "name": "does not split multipart bodies on boundary text inside content",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "multipart",
            "body": "--abc123\r\nContent-Disposition: form-data; name=\"log\"\r\n\r\nline one has --abc123 inside it\r\nline two\r\n--abc123--\r\n",
            "contentType": "multipart/form-data; boundary=abc123"
          },
          "expect": [
            {
              "headers": {
                "Content-Disposition": [
                  "form-data; name=\"log\""
                ]
              },
              "body": "line one has --abc123 inside it\r\nline two",
              "name": "log",
              "filename": null,
              "contentType": null,
              "lookup": []
            }
          ]
        }
      ]
    },
    {
      "name": "decodes multipart responses with repeated field names",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "multipart",
            "body": "--abc123\r\nContent-Disposition: form-data; name=\"tag\"\r\n\r\nmath\r\n--abc123\r\nContent-Disposition: form-data; name=\"tag\"\r\n\r\nhistory\r\n--abc123--\r\n",
            "contentType": "multipart/form-data; boundary=abc123"
          },
          "expect": [
            {
              "headers": {
                "Content-Disposition": [
                  "form-data; name=\"tag\""
                ]
              },
              "body": "math",
              "name": "tag",
              "filename": null,
              "contentType": null,
              "lookup": []
            },
            {
              "headers": {
                "Content-Disposition": [
                  "form-data; name=\"tag\""
                ]
              },
              "body": "history",
              "name": "tag",
              "filename": null,
              "contentType": null,
              "lookup": []
            }
          ]
        }
      ]
    },
    {
      "name": "decodes multipart responses with unquoted disposition parameters and duplicate headers",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "multipart",
            "body": "--abc123\r\nContent-Disposition: form-data; name=file; filename=ada.txt\r\nX-Trace: one\r\nX-Trace: two\r\n\r\ncontents\r\n--abc123--\r\n",
            "contentType": "multipart/form-data; boundary=abc123",
            "lookup": [
              "x-trace",
              "X-Trace"
            ]
          },
          "expect": [
            {
              "headers": {
                "Content-Disposition": [
                  "form-data; name=file; filename=ada.txt"
                ],
                "X-Trace": [
                  "one",
                  "two"
                ]
              },
              "body": "contents",
              "name": "file",
              "filename": "ada.txt",
              "contentType": null,
              "lookup": [
                [
                  [
                    "one",
                    "two"
                  ],
                  "one, two"
                ],
                [
                  [
                    "one",
                    "two"
                  ],
                  "one, two"
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "rejects multipart responses without boundaries",
      "steps": [
        {
          "op": "response.read",
          "args": {
            "method": "multipart",
            "body": "",
            "contentType": "multipart/mixed"
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Multipart response is missing a boundary."
            }
          }
        }
      ]
    }
  ]
}
