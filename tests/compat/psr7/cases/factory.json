    {
      "name": "multipart with file parts and numeric keys",
      "steps": [
        {
          "op": "fixture.write",
          "args": {
            "path": "/tmp/compat-fs/${ns}/upload/doc.txt",
            "content": "file-bytes"
          },
          "expect": null
        },
        {
          "op": "part.file",
          "args": {
            "name": "doc",
            "path": "/tmp/compat-fs/${ns}/upload/doc.txt"
          },
          "bind": "doc",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "request.factory",
          "args": {
            "method": "multipart",
            "args": [
              "POST",
              "https://example.com/upload",
              {
                "$parts": [
                  "zero",
                  "one",
                  {
                    "$ref": "doc"
                  },
                  3,
                  1.5,
                  true
                ]
              }
            ]
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "multipart.render",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "expect": {
            "contentType": "multipart/form-data; boundary={boundary}",
            "body": "--{boundary}\r\nContent-Disposition: form-data; name=\"0\"\r\n\r\nzero\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"1\"\r\n\r\none\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"doc\"; filename=\"doc.txt\"\r\n\r\nfile-bytes\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"3\"\r\n\r\n3\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"4\"\r\n\r\n1.5\r\n--{boundary}\r\nContent-Disposition: form-data; name=\"5\"\r\n\r\n1\r\n--{boundary}--\r\n",
            "prefix": "utopia-",
            "length": 39,
            "hex": true
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "mask": {
            "paths": [
              "/headers/Content-Type"
            ],
            "reason": "the boundary is random"
          },
          "expect": {
            "protocol": "1.1",
            "headers": {
              "Host": [
                "example.com"
              ],
              "Content-Type": "<masked>"
            },
            "method": "POST",
            "target": "/upload",
            "uri": "https://example.com/upload"
          }
        }
      ]
    }
  ]
