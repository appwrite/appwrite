    {
      "name": "serialises file parts lazily and matches a streamed read",
      "steps": [
        {
          "op": "fixture.write",
          "args": {
            "path": "/tmp/compat-fs/${ns}/part.txt",
            "content": "file-bytes"
          },
          "expect": null
        },
        {
          "op": "part.field",
          "args": {
            "name": "name",
            "value": "Ada"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "part.file",
          "args": {
            "name": "doc",
            "path": "/tmp/compat-fs/${ns}/part.txt",
            "filename": "doc.txt",
            "contentType": "text/plain"
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "multipart.body",
          "args": {
            "boundary": "abc123",
            "parts": [
              {
                "$ref": "a"
              },
              {
                "$ref": "b"
              }
            ]
          },
          "bind": "body",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "getSize"
          },
          "expect": 188
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "toString"
          },
          "expect": "--abc123\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nAda\r\n--abc123\r\nContent-Disposition: form-data; name=\"doc\"; filename=\"doc.txt\"\r\nContent-Type: text/plain\r\n\r\nfile-bytes\r\n--abc123--\r\n"
        },
        {
          "op": "stream.call",
