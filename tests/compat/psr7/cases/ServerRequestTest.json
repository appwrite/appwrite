{
  "source": "packages/psr7/tests/ServerRequestTest.php",
  "cases": [
    {
      "name": "server request factory",
      "steps": [
        {
          "op": "server_request.factory",
          "args": {
            "method": "post",
            "uri": "https://example.com/users?active=1",
            "serverParams": {
              "REMOTE_ADDR": "127.0.0.1"
            }
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": {
              "Host": [
                "example.com"
              ]
            },
            "method": "POST",
            "target": "/users?active=1",
            "uri": "https://example.com/users?active=1",
            "serverParams": {
              "REMOTE_ADDR": "127.0.0.1"
            },
            "cookieParams": [],
            "queryParams": [],
            "uploadedFiles": [],
            "parsedBody": null,
            "attributes": []
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getServerParams"
          },
          "expect": {
            "REMOTE_ADDR": "127.0.0.1"
          }
        }
      ]
    },
    {
      "name": "server request mutators are immutable",
      "steps": [
        {
          "op": "uri.parse",
          "args": {
            "uri": "/users"
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.new",
          "args": {
            "content": "body"
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server_request.new",
          "args": {
            "method": "GET",
            "uri": {
              "$ref": "u"
            },
            "body": {
              "$ref": "s"
            }
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withMethod",
            "args": [
              "PATCH"
            ]
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "a"
            },
            "method": "withQueryParams",
            "args": [
              {
                "active": "1"
              }
            ]
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "b"
            },
            "method": "withCookieParams",
            "args": [
              {
                "session": "abc"
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "c"
            },
            "method": "withParsedBody",
            "args": [
              {
                "name": "Ada"
              }
            ]
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "d"
            },
            "method": "withAttribute",
            "args": [
              "route",
              "/users/:id"
            ]
          },
          "bind": "e",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "e"
            },
            "method": "withHeader",
            "args": [
              "Accept",
              "application/json"
            ]
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": [],
            "method": "GET",
            "target": "/users",
            "uri": "/users",
            "serverParams": [],
            "cookieParams": [],
            "queryParams": [],
            "uploadedFiles": [],
            "parsedBody": null,
            "attributes": []
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "g"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": {
              "Accept": [
                "application/json"
              ]
            },
            "method": "PATCH",
            "target": "/users",
            "uri": "/users",
            "serverParams": [],
            "cookieParams": {
              "session": "abc"
            },
            "queryParams": {
              "active": "1"
            },
            "uploadedFiles": [],
            "parsedBody": {
              "name": "Ada"
            },
            "attributes": {
              "route": "/users/:id"
            }
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "g"
            },
            "method": "getAttribute",
            "args": [
              "route"
            ]
          },
          "expect": "/users/:id"
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "g"
            },
            "method": "getHeaderLine",
            "args": [
              "Accept"
            ]
          },
          "expect": "application/json"
        },
        {
          "op": "message.body",
          "args": {
            "message": {
              "$ref": "g"
            }
          },
          "bind": "body",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "toString"
          },
          "expect": "body"
        }
      ]
    },
    {
      "name": "uploaded files are a tree of uploaded files",
      "steps": [
        {
          "op": "uri.parse",
          "args": {
            "uri": "/upload"
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server_request.new",
          "args": {
            "method": "POST",
            "uri": {
              "$ref": "u"
            }
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "uploaded.new",
          "args": {
            "file": "/tmp/missing",
            "size": 0,
            "error": 4,
            "clientFilename": "avatar.png",
            "clientMediaType": "image/png"
          },
          "bind": "f",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withUploadedFiles",
            "args": [
              {
                "$files": {
                  "avatar": {
                    "$ref": "f"
                  }
                }
              }
            ]
          },
          "bind": "changed",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "changed"
            },
            "method": "getUploadedFiles"
          },
          "expect": {
            "avatar": {
              "size": 0,
              "error": 4,
              "clientFilename": "avatar.png",
              "clientMediaType": "image/png"
            }
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getUploadedFiles"
          },
          "expect": []
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withUploadedFiles",
            "args": [
              {
                "$files": {
                  "docs": [
                    {
                      "$ref": "f"
                    },
                    {
                      "inner": {
                        "$ref": "f"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "bind": "nested",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "nested"
            },
            "method": "getUploadedFiles"
          },
          "expect": {
            "docs": [
              {
                "size": 0,
                "error": 4,
                "clientFilename": "avatar.png",
                "clientMediaType": "image/png"
              },
              {
                "inner": {
                  "size": 0,
                  "error": 4,
                  "clientFilename": "avatar.png",
                  "clientMediaType": "image/png"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "constructor arguments",
