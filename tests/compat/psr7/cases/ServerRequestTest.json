              ],
              "Accept": [
                "a",
                "b"
              ],
              "N": [
                "5"
              ]
            },
            "method": "put",
            "target": "*",
            "uri": "https://example.com/a?b=c",
            "serverParams": {
              "REQUEST_METHOD": "PUT",
              "argc": 2,
              "nested": {
                "a": [
                  1,
                  2
                ]
              }
            },
            "cookieParams": {
              "session": "abc",
              "n": "12"
            },
            "queryParams": {
              "b": "c",
              "list": [
                "x",
                "y"
              ]
            },
            "uploadedFiles": {
              "file": {
                "size": 12,
                "error": 0,
                "clientFilename": "a.txt",
                "clientMediaType": null
              }
            },
            "parsedBody": {
              "k": "v"
            },
            "attributes": {
              "route": "/a",
              "null": null,
              "zero": 0
            }
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getHeader",
            "args": [
              "X-ONE"
            ]
          },
          "expect": [
            "2",
            "3"
          ]
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getAttribute",
            "args": [
              "null",
              "fallback"
            ]
          },
          "expect": "fallback"
