{
  "source": [],
  "cases": [
    {
      "name": "request constructor and mutators",
      "steps": [
        {
          "op": "uri.parse",
          "args": {
            "uri": "http://example.com:8080/a?b"
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "request.new",
          "args": {
            "method": "post",
            "uri": {
              "$ref": "u"
            }
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": [],
            "method": "post",
            "target": "/a?b",
            "uri": "http://example.com:8080/a?b"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withMethod",
            "args": [
              "delete"
            ]
          },
          "bind": "m",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "m"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": [],
            "method": "DELETE",
            "target": "/a?b",
            "uri": "http://example.com:8080/a?b"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withRequestTarget",
            "args": [
              "/other path?x"
            ]
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "t"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": {
              "Host": [
                "example.com:8080"
              ]
            },
            "method": "post",
            "target": "/other%20path%3Fx?b",
            "uri": "http://example.com:8080/other%20path%3Fx?b"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withProtocolVersion",
            "args": [
              "2"
            ]
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "p"
            },
            "method": "getProtocolVersion"
          },
          "expect": "2"
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getProtocolVersion"
          },
          "expect": "1.1"
        },
        {
          "op": "uri.parse",
          "args": {
            "uri": "/x"
          },
          "bind": "nohost",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withUri",
            "args": [
              {
                "$ref": "nohost"
              }
            ]
          },
          "bind": "w",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "w"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": [],
            "method": "post",
            "target": "/x",
            "uri": "/x"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withHeader",
            "args": [
              "Host",
              ""
            ]
          },
          "bind": "h1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "h1"
            },
            "method": "withUri",
            "args": [
              {
                "$ref": "u"
              },
              true
            ]
          },
          "bind": "h2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "h2"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": {
              "Host": [
                "example.com:8080"
              ]
            },
            "method": "post",
            "target": "/a?b",
            "uri": "http://example.com:8080/a?b"
          }
        },
        {
          "op": "stream.new",
          "args": {
            "content": "payload"
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "request.new",
          "args": {
            "method": "GET",
            "uri": {
              "$ref": "u"
            },
            "body": {
              "$ref": "s"
            }
          },
          "bind": "rb",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.body",
          "args": {
            "message": {
              "$ref": "rb"
            }
          },
          "bind": "bb",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "bb"
            },
            "method": "read",
            "args": [
              3
            ]
          },
          "expect": "pay"
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "s"
            },
            "method": "read",
            "args": [
              3
            ]
          },
          "expect": "loa"
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "rb"
            },
            "method": "withHeader",
            "args": [
              "X",
              "y"
            ]
          },
          "bind": "rb2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.body",
          "args": {
            "message": {
              "$ref": "rb2"
            }
          },
          "bind": "bb2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "bb2"
            },
            "method": "getContents"
          },
          "expect": "d"
        }
      ]
    },
    {
      "name": "header order and values",
      "steps": [
        {
          "op": "response.new",
          "args": {},
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withHeader",
            "args": [
              "A",
              "1"
            ]
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "a"
            },
            "method": "withHeader",
            "args": [
              "B",
              "2"
            ]
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "b"
            },
            "method": "withHeader",
            "args": [
              "a",
              "3"
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "c"
            },
            "method": "getHeaders"
          },
          "expect": {
            "B": [
              "2"
            ],
            "a": [
              "3"
            ]
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "c"
            },
            "method": "withAddedHeader",
            "args": [
              "b",
              [
                "4",
                5
              ]
            ]
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "d"
            },
            "method": "getHeaders"
          },
          "expect": {
            "B": [
              "2",
              "4",
              "5"
            ],
            "a": [
              "3"
            ]
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "d"
            },
            "method": "withHeader",
            "args": [
              "123",
              "numeric"
            ]
          },
          "bind": "e",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "e"
            },
            "method": "withHeader",
            "args": [
              "0",
              "zero"
            ]
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "g"
            },
            "method": "getHeaders"
          },
          "expect": {
            "B": [
              "2",
              "4",
              "5"
            ],
            "a": [
              "3"
            ],
            "123": [
              "numeric"
            ],
            "0": [
              "zero"
            ]
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "g"
            },
            "method": "getHeader",
            "args": [
              "123"
            ]
          },
          "expect": [
            "numeric"
          ]
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withHeader",
            "args": [
              "0",
              "zero"
            ]
          },
          "bind": "z",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "z"
            },
            "method": "getHeaders"
          },
          "expect": [
            [
              "zero"
            ]
          ]
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withHeader",
            "args": [
              "X-Empty",
              []
            ]
          },
          "bind": "empty",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "empty"
            },
            "method": "getHeaders"
          },
          "expect": {
            "X-Empty": []
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "empty"
            },
            "method": "hasHeader",
            "args": [
              "x-empty"
            ]
          },
          "expect": true
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "empty"
            },
            "method": "getHeaderLine",
            "args": [
              "x-empty"
            ]
          },
          "expect": ""
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getHeader",
            "args": [
              "missing"
            ]
          },
          "expect": []
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "getHeaderLine",
            "args": [
              "missing"
            ]
          },
          "expect": ""
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withHeader",
            "args": [
              "X-Trailing\n",
              "v"
            ]
          },
          "bind": "nl",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "nl"
            },
            "method": "getHeaders"
          },
          "expect": {
            "X-Trailing\n": [
              "v"
            ]
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "nl"
            },
            "method": "hasHeader",
            "args": [
              "x-trailing\n"
            ]
          },
          "expect": true
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withHeader",
            "args": [
              "X",
              [
                1,
                2.5,
                true,
                false,
                "a",
                1e+20,
                0.1
              ]
            ]
          },
          "bind": "types",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "types"
            },
            "method": "getHeaders"
          },
          "expect": {
            "X": [
              "1",
              "2.5",
              "1",
              "",
              "a",
              "1.0E+20",
              "0.1"
            ]
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withoutHeader",
            "args": [
              "not set"
            ]
          },
          "bind": "o",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.get",
          "args": {
            "message": {
              "$ref": "o"
            },
            "method": "getHeaders"
          },
          "expect": []
        }
      ]
    },
    {
      "name": "response status",
      "steps": [
        {
          "op": "response.new",
          "args": {
            "status": 404,
            "reason": "Not Found"
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "r"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": [],
            "status": 404,
            "reason": "Not Found"
          }
        },
        {
          "op": "response.new",
          "args": {
            "status": 99
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Invalid response status code."
            }
          }
        },
        {
          "op": "response.new",
          "args": {
            "status": 600
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Invalid response status code."
            }
          }
        },
        {
          "op": "response.new",
          "args": {
            "status": 599
          },
          "bind": "edge",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withStatus",
            "args": [
              100
            ]
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "s"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": [],
            "status": 100,
            "reason": ""
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withStatus",
            "args": [
              1000
            ]
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Invalid response status code."
            }
          }
        },
        {
          "op": "message.with",
          "args": {
            "message": {
              "$ref": "r"
            },
            "method": "withStatus",
            "args": [
              204,
              "No Content"
            ]
          },
          "bind": "s2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "s2"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": [],
            "status": 204,
            "reason": "No Content"
          }
        },
        {
          "op": "response.factory",
          "args": {},
          "bind": "f",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "message.dump",
          "args": {
            "message": {
              "$ref": "f"
            }
          },
          "expect": {
            "protocol": "1.1",
            "headers": [],
            "status": 200,
            "reason": ""
          }
        },
        {
          "op": "response.factory",
          "args": {
            "args": [
              0
            ]
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Invalid response status code."
            }
          }
        }
      ]
    }
  ]
}
