{
  "source": [],
  "cases": [
    {
      "name": "body stream behaviour",
      "steps": [
        {
          "op": "part.field",
          "args": {
            "name": "n",
            "value": "v",
            "headers": {
              "Content-Disposition": "custom",
              "X-A": "1",
              "content-type": "lower"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "part.body",
          "args": {
            "name": "f",
            "body": "",
            "filename": "",
            "contentType": ""
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "part.dump",
          "args": {
            "part": {
              "$ref": "a"
            }
          },
          "expect": {
            "name": "n",
            "content": "v",
            "path": null,
            "size": 1,
            "filename": null,
            "contentType": null,
            "headers": {
              "Content-Disposition": "custom",
              "X-A": "1",
              "content-type": "lower"
            }
          }
        },
        {
          "op": "part.dump",
          "args": {
            "part": {
              "$ref": "b"
            }
          },
          "expect": {
            "name": "f",
            "content": "",
            "path": null,
            "size": 0,
            "filename": "",
            "contentType": "",
            "headers": []
          }
        },
        {
          "op": "multipart.body",
          "args": {
            "boundary": "x",
            "parts": [
              {
                "$ref": "a"
              },
              {
                "$ref": "b"
              }
            ]
          },
          "bind": "body",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "multipart.dump",
          "args": {
            "body": {
              "$ref": "body"
            }
          },
          "expect": {
            "boundary": "x",
            "parts": [
              {
                "name": "n",
                "content": "v",
                "path": null,
                "size": 1,
                "filename": null,
                "contentType": null,
                "headers": {
                  "Content-Disposition": "custom",
                  "X-A": "1",
                  "content-type": "lower"
                }
              },
              {
                "name": "f",
                "content": "",
                "path": null,
                "size": 0,
                "filename": "",
                "contentType": "",
                "headers": []
              }
            ]
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "toString"
          },
          "expect": "--x\r\nContent-Disposition: custom\r\nX-A: 1\r\ncontent-type: lower\r\n\r\nv\r\n--x\r\nContent-Disposition: form-data; name=\"f\"; filename=\"\"\r\nContent-Type: \r\n\r\n\r\n--x--\r\n"
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "getSize"
          },
          "expect": 155
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "tell"
          },
          "expect": 155
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "eof"
          },
          "expect": true
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "isReadable"
          },
          "expect": true
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "isWritable"
          },
          "expect": false
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "isSeekable"
          },
          "expect": true
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "getMetadata"
          },
          "expect": []
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "getMetadata",
            "args": [
              "mode"
            ]
          },
          "expect": null
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "write",
            "args": [
              "x"
            ]
          },
          "expect": {
            "$error": {
              "class": "RuntimeException",
              "message": "A multipart body is not writable."
            }
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "seek",
            "args": [
              1
            ]
          },
          "expect": {
            "$error": {
              "class": "RuntimeException",
              "message": "A multipart body can only be rewound."
            }
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "seek",
            "args": [
              0,
              1
            ]
          },
          "expect": {
            "$error": {
              "class": "RuntimeException",
              "message": "A multipart body can only be rewound."
            }
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "seek",
            "args": [
              0
            ]
          },
          "expect": null
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "read",
            "args": [
              0
            ]
          },
          "expect": {
            "$error": {
              "class": "RuntimeException",
              "message": "Read length must be greater than zero."
            }
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "read",
            "args": [
              1000
            ]
          },
          "expect": "--x\r\nContent-Disposition: custom\r\nX-A: 1\r\ncontent-type: lower\r\n\r\n"
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "getContents"
          },
          "expect": "v\r\n--x\r\nContent-Disposition: form-data; name=\"f\"; filename=\"\"\r\nContent-Type: \r\n\r\n\r\n--x--\r\n"
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "eof"
          },
          "expect": true
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "detach"
          },
          "expect": null
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "read",
            "args": [
              10
            ]
          },
          "expect": ""
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "eof"
          },
          "expect": true
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "toString"
          },
          "expect": ""
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "close"
          },
          "expect": null
        },
        {
          "op": "multipart.body",
          "args": {
            "boundary": "e",
            "parts": []
          },
          "bind": "empty",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "empty"
            },
            "method": "toString"
          },
          "expect": "--e--\r\n"
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "empty"
            },
            "method": "getSize"
          },
          "expect": 7
        }
      ]
    },
    {
      "name": "file part details",
      "steps": [
        {
          "op": "fixture.write",
          "args": {
            "path": "/tmp/compat-fs/${ns}/files/report.final.pdf",
            "content": "%PDF"
          },
          "expect": null
        },
        {
          "op": "part.file",
          "args": {
            "name": "report",
            "path": "/tmp/compat-fs/${ns}/files/report.final.pdf"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "part.dump",
          "args": {
            "part": {
              "$ref": "p"
            }
          },
          "expect": {
            "name": "report",
            "content": "",
            "path": "/tmp/compat-fs/${ns}/files/report.final.pdf",
            "size": 4,
            "filename": "report.final.pdf",
            "contentType": null,
            "headers": []
          }
        },
        {
          "op": "part.file",
          "args": {
            "name": "report",
            "path": "/tmp/compat-fs/${ns}/files/report.final.pdf",
            "filename": "other \"name\".pdf",
            "contentType": "application/pdf",
            "headers": {
              "X-Id": "7"
            }
          },
          "bind": "q",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "multipart.body",
          "args": {
            "boundary": "zz",
            "parts": [
              {
                "$ref": "p"
              },
              {
                "$ref": "q"
              }
            ]
          },
          "bind": "body",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "stream.call",
          "args": {
            "stream": {
              "$ref": "body"
            },
            "method": "toString"
          },
          "expect": "--zz\r\nContent-Disposition: form-data; name=\"report\"; filename=\"report.final.pdf\"\r\n\r\n%PDF\r\n--zz\r\nContent-Disposition: form-data; name=\"report\"; filename=\"other \\\"name\\\".pdf\"\r\nContent-Type: application/pdf\r\nX-Id: 7\r\n\r\n%PDF\r\n--zz--\r\n"
        },
        {
          "op": "part.file",
          "args": {
            "path": "/tmp/compat-fs/${ns}/files",
            "name": "dir"
          },
          "expect": {
            "$error": {
              "class": "RuntimeException",
              "message": "Unable to read multipart file."
            }
          }
        },
        {
          "op": "fixture.write",
          "args": {
            "path": "/tmp/compat-fs/${ns}/files/vanishing.txt",
            "content": "12345"
          },
          "expect": null
        },
        {
          "op": "part.file",
          "args": {
            "name": "v",
            "path": "/tmp/compat-fs/${ns}/files/vanishing.txt"
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "part.dump",
          "args": {
            "part": {
              "$ref": "v"
            }
          },
          "expect": {
            "name": "v",
            "content": "",
            "path": "/tmp/compat-fs/${ns}/files/vanishing.txt",
            "size": 5,
            "filename": "vanishing.txt",
            "contentType": null,
            "headers": []
          }
        }
      ]
    }
  ]
}
