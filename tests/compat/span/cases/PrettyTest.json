{
  "source": "packages/span/tests/Exporter/PrettyTest.php",
  "cases": [
    {
      "name": "testExportWritesOutput",
      "steps": [
        {
          "op": "exporter.export",
          "args": {
            "exporter": "pretty",
            "options": {},
            "span": {
              "base": {
                "trace_id": "0af7651916cd43dd8448eb211c80319c",
                "span_id": "b7ad6b7169203331",
                "started_at": 1700000000.25
              },
              "attributes": [
                {
                  "key": "action",
                  "value": "test.action"
                },
                {
                  "key": "span.finished_at",
                  "value": 1700000000.5
                },
                {
                  "key": "span.duration",
                  "value": 0.25
                },
                {
                  "key": "level",
                  "value": "info"
                }
              ],
              "action": "test.action"
            }
          },
          "expect": {
            "stdout": "\u001b[1m\u001b[32mtest.action\u001b[0m\u001b[2m · \u001b[0m\u001b[33m250ms\u001b[0m\u001b[2m · \u001b[0m\u001b[2m0af76519\u001b[0m\n\n  \u001b[36mlevel \u001b[0m \u001b[37minfo\u001b[0m\n  \u001b[36maction\u001b[0m \u001b[37mtest.action\u001b[0m\n\n\u001b[2m────────────────────────────────────────────────────────────\u001b[0m\n",
            "stderr": ""
          }
        }
      ]
    },
