    {
      "name": "testExportIncludesSpanMetadata",
      "steps": [
        {
          "op": "span.reset",
          "expect": null
        },
        {
          "op": "span.new",
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "span.finish",
          "args": {
            "span": {
              "$ref": "s"
            }
          },
          "expect": null
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.trace_id"
          },
          "expect": {
            "type": "string",
            "length": 32,
            "hex": true
          }
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.id"
          },
          "expect": {
            "type": "string",
            "length": 16,
            "hex": true
          }
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.started_at"
          },
          "expect": {
            "type": "float"
          }
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.finished_at"
          },
          "expect": {
            "type": "float"
          }
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.duration"
          },
          "expect": {
            "type": "float"
          }
        }
      ]
    },
    {
      "name": "error with a long trace",
      "steps": [
        {
          "op": "exporter.export",
          "args": {
            "exporter": "pretty",
            "options": {
              "max_trace_frames": 2
            },
            "span": {
              "base": {
                "trace_id": "0af7651916cd43dd8448eb211c80319c",
                "span_id": "b7ad6b7169203331",
                "started_at": 1700000000.25
              },
              "attributes": [
                {
                  "key": "level",
                  "value": "error"
                },
                {
                  "key": "user.id",
                  "value": "u1"
                }
              ],
              "action": "job",
              "error": {
                "class": "RuntimeException",
                "message": "boom",
                "file": "/app/src/Test.php",
                "line": 10,
                "trace": [
                  {
                    "file": "/app/src/Worker.php",
                    "line": 12,
                    "function": "run",
                    "class": "App\\Worker",
                    "type": "->"
