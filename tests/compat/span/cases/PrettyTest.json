                  },
                  {
                    "function": "{closure}"
                  },
                  {
                    "file": "/app/public/index.php",
                    "line": 3,
                    "function": "main"
                  }
                ]
              }
            }
          },
          "expect": {
            "stdout": "",
            "stderr": "\u001b[1m\u001b[31mjob\u001b[0m\u001b[2m · \u001b[0m\u001b[2m0af76519\u001b[0m\n\n  \u001b[36mlevel  \u001b[0m \u001b[37merror\u001b[0m\n  \u001b[36muser.id\u001b[0m \u001b[37mu1\u001b[0m\n\n\u001b[31m\u001b[1m  RuntimeException\u001b[0m\u001b[31m: boom\u001b[0m\n\u001b[2m    at /app/src/Test.php:10\u001b[0m\n\u001b[2m    at /app/src/Worker.php:12\u001b[0m\n\u001b[2m    at /app/vendor/lib/Kernel.php:40\u001b[0m\n\u001b[2m    ... 2 more\u001b[0m\n\n\u001b[2m────────────────────────────────────────────────────────────\u001b[0m\n"
