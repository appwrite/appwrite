    {
      "name": "testExportHandlesError",
      "steps": [
        {
          "op": "exporter.export",
          "args": {
            "exporter": "stdout",
            "options": {},
            "span": {
              "base": {
                "trace_id": "0af7651916cd43dd8448eb211c80319c",
                "span_id": "b7ad6b7169203331",
                "started_at": 1700000000.25
              },
              "attributes": [],
