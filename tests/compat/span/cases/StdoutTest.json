          "expect": {
            "stdout": "",
            "stderr": "{\"action\":\"test.error\",\"span.trace_id\":\"0af7651916cd43dd8448eb211c80319c\",\"span.id\":\"b7ad6b7169203331\",\"span.started_at\":1700000000.25,\"error.type\":\"RuntimeException\",\"error.message\":\"Test error\",\"error.code\":42,\"error.file\":\"/app/src/Test.php\",\"error.line\":10,\"error.trace\":[]}\n"
          }
        }
      ]
