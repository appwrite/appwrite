    {
      "name": "testExportIncludesSpanMetadata",
      "steps": [
        {
          "op": "span.reset",
          "expect": null
        },
        {
          "op": "span.new",
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "span.finish",
          "args": {
            "span": {
              "$ref": "s"
            }
          },
          "expect": null
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.trace_id"
          },
          "expect": {
            "type": "string",
            "length": 32,
            "hex": true
          }
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.id"
          },
          "expect": {
            "type": "string",
            "length": 16,
            "hex": true
          }
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.started_at"
          },
          "expect": {
            "type": "float"
          }
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.finished_at"
          },
          "expect": {
            "type": "float"
          }
        },
        {
          "op": "span.describe",
          "args": {
            "span": {
              "$ref": "s"
            },
            "key": "span.duration"
          },
          "expect": {
            "type": "float"
          }
        }
      ]
    },
    {
      "name": "error with a long trace",
      "steps": [
        {
          "op": "exporter.export",
          "args": {
            "exporter": "stdout",
            "options": {
              "max_trace_frames": 2
            },
            "span": {
              "base": {
                "trace_id": "0af7651916cd43dd8448eb211c80319c",
                "span_id": "b7ad6b7169203331",
                "started_at": 1700000000.25
              },
              "attributes": [
                {
                  "key": "level",
                  "value": "error"
                },
                {
                  "key": "user.id",
                  "value": "u1"
                }
              ],
              "action": "job",
              "error": {
                "class": "RuntimeException",
                "message": "boom",
                "file": "/app/src/Test.php",
                "line": 10,
                "trace": [
                  {
                    "file": "/app/src/Worker.php",
                    "line": 12,
                    "function": "run",
                    "class": "App\\Worker",
                    "type": "->"
                  },
                  {
                    "file": "/app/vendor/lib/Kernel.php",
                    "line": 40,
                    "function": "handle",
                    "class": "Kernel",
                    "type": "::"
                  },
                  {
                    "function": "{closure}"
                  },
                  {
                    "file": "/app/public/index.php",
                    "line": 3,
                    "function": "main"
                  }
                ]
              }
            }
          },
          "expect": {
            "stdout": "",
            "stderr": "{\"level\":\"error\",\"action\":\"job\",\"span.trace_id\":\"0af7651916cd43dd8448eb211c80319c\",\"span.id\":\"b7ad6b7169203331\",\"span.started_at\":1700000000.25,\"user.id\":\"u1\",\"error.type\":\"RuntimeException\",\"error.message\":\"boom\",\"error.code\":0,\"error.file\":\"/app/src/Test.php\",\"error.line\":10,\"error.trace\":[{\"file\":\"/app/src/Worker.php\",\"line\":12,\"function\":\"run\"},{\"file\":\"/app/vendor/lib/Kernel.php\",\"line\":40,\"function\":\"handle\"}],\"error.trace_truncated\":2}\n"
          }
        }
      ]
    },
