{
  "source": "packages/span/tests/Exporter/StdoutTest.php",
  "cases": [
    {
      "name": "testExportWritesJson",
      "steps": [
        {
          "op": "exporter.export",
          "args": {
            "exporter": "stdout",
            "options": {},
            "span": {
              "base": {
                "trace_id": "0af7651916cd43dd8448eb211c80319c",
                "span_id": "b7ad6b7169203331",
                "started_at": 1700000000.25
              },
              "attributes": [
                {
                  "key": "action",
                  "value": "test.action"
                },
                {
                  "key": "span.finished_at",
                  "value": 1700000000.5
                },
                {
                  "key": "span.duration",
                  "value": 0.25
                },
                {
                  "key": "level",
                  "value": "info"
                }
              ],
              "action": "test.action"
            }
          },
          "expect": {
            "stdout": "{\"level\":\"info\",\"action\":\"test.action\",\"span.trace_id\":\"0af7651916cd43dd8448eb211c80319c\",\"span.id\":\"b7ad6b7169203331\",\"span.started_at\":1700000000.25,\"span.finished_at\":1700000000.5,\"span.duration\":0.25}\n",
            "stderr": ""
          }
        }
      ]
    },
