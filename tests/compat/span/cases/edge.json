    {
      "name": "an error with causes",
      "steps": [
        {
          "op": "span.reset",
          "expect": null
        },
        {
          "op": "span.new",
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "span.set_error",
          "args": {
            "span": {
              "$ref": "s"
            },
            "error": {
              "class": "RuntimeException",
              "message": "outer",
              "file": "/app/src/Test.php",
              "line": 10,
              "previous": {
                "class": "LogicException",
                "message": "root",
                "file": "/app/src/Test.php",
                "line": 10,
                "code": 7
              }
            }
          },
          "expect": true
        },
        {
          "op": "span.error",
          "args": {
            "span": {
              "$ref": "s"
            }
          },
          "expect": {
            "class": "RuntimeException",
            "message": "outer",
            "code": 0,
            "previous": {
              "class": "LogicException",
              "message": "root",
              "code": 7,
              "previous": null
            }
          }
        }
      ]
    },
