    {
      "name": "script",
      "steps": [
        {
          "op": "span.script",
          "args": {
            "action": "s",
            "calls": [
              {
                "op": "set",
                "key": "a",
                "value": 1
              },
              {
                "op": "get",
                "key": "a"
              },
              {
                "op": "set",
                "key": "1",
                "value": "x"
              },
              {
                "op": "set",
                "key": "a",
                "value": null
              },
              {
                "op": "get",
                "key": "missing"
              },
              {
                "op": "set",
                "key": "span.id",
                "value": 2.5
              }
            ]
          },
          "expect": {
            "results": [
              true,
              1,
              true,
              true,
              null,
              true
            ],
            "attributes": [
              [
                "a",
                null
              ],
              [
                "1",
                "x"
              ]
            ]
          }
        }
      ]
