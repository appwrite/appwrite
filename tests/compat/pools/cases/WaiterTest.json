{
  "source": "packages/pools/tests/Adapter/WaiterTest.php",
  "cases": [
    {
      "name": "returning a borrower cannot untrack its waiting successor",
      "steps": [
        {
          "op": "waiter.handoff",
          "expect": {
            "snapshots": [
              [
                1,
                0,
                0
              ],
              [
                0,
                1,
                1
              ]
            ],
            "results": [
              "replacement",
              {
                "class": "RuntimeException",
                "message": "successor failed"
              }
            ],
            "created": 2,
            "identities": 3,
            "first_reused": true,
            "replacement_new": true
          }
        }
      ]
    },
    {
      "name": "discarding a failed borrower wakes an existing waiter",
      "steps": [
        {
          "op": "waiter.discard",
          "expect": {
            "results": [
              "replacement",
              {
                "class": "RuntimeException",
                "message": "request failed"
              }
            ],
            "created": 2,
            "full": true
          }
        }
      ]
    },
    {
      "name": "failed creation wakes an existing waiter without retrying the creator",
      "steps": [
        {
          "op": "waiter.creation",
          "expect": {
            "results": [
              "replacement",
              {
                "class": "RuntimeException",
                "message": "connection failed"
              }
            ],
            "created": 2,
            "full": true
          }
        }
      ]
    },
    {
      "name": "released waits do not extend the original deadline",
      "steps": [
        {
          "op": "waiter.deadline",
          "expect": {
            "failure": [
              {
                "class": "Exception",
                "message": "Pool 'deadline' could not provide a connection within 0.04s (size 1, active 1, idle 0)"
              }
            ],
            "quick": true,
            "full": true
          }
        }
      ]
    },
    {
      "name": "several waiters compete for freed capacity without oversubscribing",
      "steps": [
        {
          "op": "waiter.capacity",
          "expect": {
            "results": [
              {
                "class": "RuntimeException",
                "message": "discard"
              },
              {
                "class": "RuntimeException",
                "message": "discard"
              },
              {
                "class": "RuntimeException",
                "message": "discard"
              },
              {
                "class": "RuntimeException",
                "message": "discard"
              },
              {
                "class": "RuntimeException",
                "message": "discard"
              },
              {
                "class": "RuntimeException",
                "message": "discard"
              },
              {
                "class": "RuntimeException",
                "message": "discard"
              },
              {
                "class": "RuntimeException",
                "message": "discard"
              }
            ],
            "maximum": 2,
            "active": 0,
            "full": true
          }
        }
      ]
    }
  ]
}
