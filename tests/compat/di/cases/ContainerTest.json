    {
      "name": "testSetAndGetDependency",
      "steps": [
        {
          "op": "di.new",
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "di.set",
          "args": {
            "container": {
              "$ref": "c"
            },
            "id": "foo",
            "factory": {
              "kind": "value",
              "value": "bar"
            },
            "dependencies": []
          },
          "expect": true
        },
        {
          "op": "di.get",
          "args": {
            "container": {
              "$ref": "c"
            },
            "id": "foo"
          },
          "expect": "bar"
        }
      ]
    },
