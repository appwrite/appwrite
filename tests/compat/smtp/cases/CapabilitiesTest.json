{
  "source": "packages/smtp/tests/CapabilitiesTest.php",
  "cases": [
    {
      "name": "ignores the greeting line",
      "op": "capabilities.parse",
      "args": {
        "lines": [
          "mail.example.test",
          "PIPELINING"
        ],
        "keywords": [
          "mail.example.test",
          "PIPELINING"
        ]
      },
      "expect": {
        "keywords": [
          [
            "mail.example.test",
            false,
            []
          ],
          [
            "PIPELINING",
            true,
            []
          ]
        ],
        "max_size": null,
        "mechanisms": []
      }
    },
    {
      "name": "reads keywords and parameters",
      "op": "capabilities.parse",
      "args": {
        "lines": [
          "mail.example.test",
          "PIPELINING",
          "AUTH PLAIN LOGIN"
        ]
      },
      "expect": {
        "keywords": [
          [
            "PIPELINING",
            true,
            []
          ],
          [
            "SIZE",
            false,
            []
          ],
          [
            "8BITMIME",
            false,
            []
          ],
          [
            "SMTPUTF8",
            false,
            []
          ],
          [
            "STARTTLS",
            false,
            []
          ],
          [
            "AUTH",
            true,
            [
              "PLAIN",
              "LOGIN"
            ]
          ],
          [
            "ENHANCEDSTATUSCODES",
            false,
            []
          ],
          [
            "CHUNKING",
            false,
            []
          ]
        ],
        "max_size": null,
        "mechanisms": [
          "PLAIN",
          "LOGIN"
        ]
      }
    },
