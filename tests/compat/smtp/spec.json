  "quirks": [
    {
      "symbol": "Utopia\\SMTP\\Mime\\Part::body",
      "description": "A multipart part without children writes no delimiters at all, just an empty body: body() checks `$this->parts !== []` before treating the part as a multipart.",
      "case": "part.json#an empty multipart"
    },
    {
      "symbol": "Utopia\\SMTP\\Message::__construct",
      "description": "A non-ASCII address in To, Cc, Reply-To or From makes the whole header value (angle brackets and address included) one run of RFC 2047 encoded words, which no parser reads back as an address; RFC 6532 would send it as UTF-8.",
      "case": "MessageTest.json#an international To is encoded whole"
    },
    {
      "symbol": "Utopia\\SMTP\\Mime\\Header::line",
      "description": "Folding drops the space before a word that follows an empty word at a fold point (`$current === ''` reads the empty word as no line at all), so a run of spaces can lose one when a fold lands inside it.",
      "case": "HeaderTest.json#double spaces survive folding"
    },
    {
      "symbol": "Utopia\\SMTP\\Message::__construct",
      "description": "The subject is checked for CR and LF only, so a NUL byte reaches the Subject header, while custom headers and addresses refuse it.",
      "case": "MessageTest.json#a NUL in the subject is allowed"
    }
  ],
  "deviations": [
    {
      "symbol": "Utopia\\SMTP\\Address::__construct",
      "php": "An email address or display name may be any bytes; a non-ASCII display name that is not valid UTF-8 encodes to nothing (preg_split('//u') fails), leaving ` <email>`.",
      "reason": "Addresses, subjects, header names and values, envelope paths, attachment names and commands are Rust strings (UTF-8), so invalid UTF-8 cannot be passed. Bodies and attachment content stay bytes."
    },
    {
      "symbol": "Utopia\\SMTP\\Reply::__construct",
      "php": "The code is any int (a negative one is refused as not a reply class) and lines are bytes, kept as received.",
      "reason": "The code is a u16; reply text read off the wire is decoded as UTF-8 lossily (RFC 5321 replies are ASCII), so a byte that is not UTF-8 reads as U+FFFD."
    },
    {
      "symbol": "Utopia\\SMTP\\Message::__construct",
      "php": "A custom header named by a decimal integer becomes an int array key, and strtolower() under strict types throws a TypeError.",
      "reason": "Header names are strings; such a name is accepted like any other."
    },
    {
      "symbol": "Utopia\\SMTP\\Attachment::fromPath",
      "php": "Without a type, the media type is libmagic's (mime_content_type), from a database of thousands of formats.",
      "reason": "utopia_smtp::detect knows the formats a message usually carries (empty, one byte, PNG, GIF, JPEG, PDF, ZIP, gzip, UTF-8 text, other binary) and answers as libmagic does for them; other formats get application/octet-stream. Pass the type to be exact."
    },
    {
      "symbol": "Utopia\\SMTP\\Tls::__construct",
      "php": "`ciphers` is an OpenSSL cipher list handed to the handshake.",
      "reason": "rustls offers its own fixed set of modern suites and takes no OpenSSL list; the value is kept on Tls and not applied."
    },
    {
      "symbol": "Utopia\\SMTP\\Transport\\Native::connect",
      "php": "The exception code of a connection failure is errno, and a failed implicit TLS handshake reads as the stream layer's error.",
      "reason": "The message carries the OS error text the same way; Error::code is a reply code (0 here), and a failed TLS handshake reads as rustls describes it."
    }
  ],
