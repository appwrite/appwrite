  "waivers": {},
  "tests_waived": {},
  "quirks": [],
  "deviations": [
    {
      "symbol": "Utopia\\Servers\\Base::getContainer",
      "php": "Before setContainer(), reading the typed property throws Error ('must not be accessed before initialization').",
      "reason": "Base::container() returns None until a container is set; the adapters report that as the Error class."
    },
    {
      "symbol": "Utopia\\Servers\\Base::init",
      "php": "The hooks and the mode are static: every Base subclass of the process shares them until reset().",
      "reason": "Each Base value keeps its own hooks and mode (no global state); the operations reset PHP's before each run."
    },
    {
      "symbol": "Utopia\\Servers\\Hook::param",
      "php": "The validator may be any callable, and prepare() throws 'Validator object is not an instance of the Validator class' (500) when it returns something else; a request value that is a callable array (['Class', 'method']) is called like a default factory.",
      "reason": "Check::Factory returns an Arc<dyn Validator>, so a factory cannot return anything else; request values are data and never called."
    },
    {
      "symbol": "Utopia\\Servers\\Hook::action",
      "php": "The callback is any callable, called with the hook's params and injections, and may return a value (getAction() returns it).",
      "reason": "An Action is an async closure over Arguments returning Result<(), Error>: it has no return value. hook.run reports whether calling it succeeds."
    }
  ]
