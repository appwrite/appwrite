{
  "lib": "servers",
  "description": "utopia-php/servers: the base of Utopia-style servers. Hooks with params (defaults, validators, aliases, injections, metadata), injections, groups and labels; Base's mode, hook registries, container, and prepare(), which resolves and validates a hook's params.",
  "complete": true,
  "php": {
    "src": [
      "packages/servers/src"
    ],
    "tests": [
      "packages/servers/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/servers"
  },
  "services": [],
  "state": [],
  "ops": {
    "hook.run": {
      "doc": "new Hook() configured and read by `steps`, each {name: argument}: desc, groups, label {key, value}, param {key, default, default_fn, validator (see http.run's validators; {factory: spec} for a callable), description, optional, injections, skip_validation, deprecated, example, model, aliases, enum}, inject, action, set_param_value {key, value}; get desc|groups|params|injections|dependencies|params_values|action (calls it); label_of {key, default}; param_value key. Each step's result ({\"$error\": {class, message, code}} when it throws)",
      "covers": [
        "Utopia\\Servers\\Hook::__construct",
        "Utopia\\Servers\\Hook::desc",
        "Utopia\\Servers\\Hook::getDesc",
        "Utopia\\Servers\\Hook::groups",
        "Utopia\\Servers\\Hook::getGroups",
        "Utopia\\Servers\\Hook::label",
        "Utopia\\Servers\\Hook::getLabel",
        "Utopia\\Servers\\Hook::action",
        "Utopia\\Servers\\Hook::getAction",
        "Utopia\\Servers\\Hook::getInjections",
        "Utopia\\Servers\\Hook::getDependencies",
        "Utopia\\Servers\\Hook::inject",
        "Utopia\\Servers\\Hook::param",
        "Utopia\\Servers\\Hook::getParams",
        "Utopia\\Servers\\Hook::getParamsValues",
        "Utopia\\Servers\\Hook::setParamValue",
        "Utopia\\Servers\\Hook::getParamValue"
      ],
      "fuzz": [
        {
          "name": "steps",
          "args": {
            "gen": "object",
            "fields": {
              "steps": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "hook_step"
                },
                "min": 1,
                "max": 12
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "base.prepare": {
      "doc": "Base::prepare() of a hook with `params` (as hook.run's param step) in a context holding `resources`, from path `values` and `request` params. Returns each param's value in the returned container (`scope`), the hook's getParamsValues(), the values default and validator factories received, and the error prepare() raised",
      "covers": [
        "Utopia\\Servers\\Hook::param",
        "Utopia\\Servers\\Hook::setParamValue",
        "Utopia\\Servers\\Hook::getParamsValues"
      ],
      "fuzz": [
        {
          "name": "params",
          "args": {
            "gen": "object",
            "fields": {
              "resources": {
                "gen": "object",
                "fields": {
                  "r1": {
                    "gen": "const",
                    "value": "one"
                  },
                  "r2": {
                    "gen": "const",
                    "value": 2
                  }
                }
              },
              "params": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "param"
                },
                "min": 0,
                "max": 4
              },
              "values": {
                "gen": "ref",
                "name": "input"
              },
              "request": {
                "gen": "ref",
                "name": "input"
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "base.run": {
      "doc": "A Base driven by `steps`: set_mode, mode ([getMode, isProduction, isDevelopment, isStage]), hook init|shutdown|error|start|end (the new hook's groups), set_container (a container whose `name` is the argument), container (its `name`), reset",
      "covers": [
        "Utopia\\Servers\\Base::setMode",
        "Utopia\\Servers\\Base::getMode",
        "Utopia\\Servers\\Base::isProduction",
        "Utopia\\Servers\\Base::isDevelopment",
        "Utopia\\Servers\\Base::isStage",
        "Utopia\\Servers\\Base::init",
        "Utopia\\Servers\\Base::shutdown",
        "Utopia\\Servers\\Base::error",
        "Utopia\\Servers\\Base::onStart",
        "Utopia\\Servers\\Base::onEnd",
        "Utopia\\Servers\\Base::setContainer",
        "Utopia\\Servers\\Base::getContainer",
        "Utopia\\Servers\\Base::reset"
      ],
      "fuzz": [
        {
          "name": "steps",
          "args": {
            "gen": "object",
            "fields": {
              "steps": {
                "gen": "array",
                "items": {
                  "gen": "one_of",
                  "of": [
                    {
                      "gen": "object",
                      "fields": {
                        "set_mode": {
                          "gen": "one_of",
                          "of": [
                            {
                              "gen": "pick",
                              "from": [
                                "development",
                                "stage",
                                "production",
                                "",
                                "Production"
                              ]
                            },
                            {
                              "gen": "string",
                              "max": 8
                            }
                          ]
                        }
                      }
                    },
                    {
                      "gen": "object",
                      "fields": {
                        "mode": {
                          "gen": "const",
                          "value": true
                        }
                      }
                    },
                    {
                      "gen": "object",
                      "fields": {
                        "hook": {
                          "gen": "pick",
                          "from": [
                            "init",
                            "shutdown",
                            "error",
                            "start",
                            "end"
                          ]
                        }
                      }
                    },
                    {
                      "gen": "object",
                      "fields": {
                        "reset": {
                          "gen": "const",
                          "value": true
                        }
                      }
                    }
                  ]
                },
                "min": 1,
                "max": 8
              }
            }
          },
          "iterations": 1000
        }
      ]
    }
  },
