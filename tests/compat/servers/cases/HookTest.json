    {
      "name": "testParamEnumCanBeSet",
      "op": "hook.run",
      "args": {
        "steps": [
          {
            "param": {
              "key": "status",
              "default": "draft",
              "validator": {
                "text": [
                  32
                ]
              },
              "description": "Status.",
              "optional": true,
              "enum": {
                "name": "ArticleStatus",
                "map": {
                  "draft": "Draft",
                  "published": "Published"
                }
              }
            }
          },
          {
            "get": "params"
          }
        ]
      },
      "expect": [
        true,
        {
          "status": {
            "default": "draft",
            "validator": "Value must be a valid string and at least 1 chars and no longer than 32 chars",
            "description": "Status.",
            "optional": true,
            "injections": [],
            "skipValidation": false,
            "deprecated": false,
            "example": "",
            "model": null,
            "aliases": [],
            "enum": {
              "name": "ArticleStatus",
              "map": {
                "draft": "Draft",
                "published": "Published"
              }
            },
            "value": null,
            "order": 0
          }
        }
      ]
    },
    {
      "name": "testResourcesCanBeInjected",
      "op": "hook.run",
      "args": {
        "steps": [
          {
            "get": "injections"
          },
          {
            "inject": "user"
          },
          {
            "inject": "time"
          },
          {
            "action": null
          },
          {
            "get": "injections"
          }
        ]
      },
      "expect": [
        [],
        true,
        true,
        true,
        {
          "user": {
            "name": "user",
            "order": 0
          },
          "time": {
            "name": "time",
            "order": 1
          }
        }
      ]
    },
    {
      "name": "testDependenciesAreReturnedInInjectionOrder",
      "op": "hook.run",
      "args": {
        "steps": [
          {
            "get": "dependencies"
          },
          {
            "inject": "user"
          },
          {
            "param": {
              "key": "x",
              "default": "",
              "validator": {
                "text": [
                  10
                ]
              }
            }
          },
          {
            "inject": "time"
          },
          {
            "inject": "locale"
          },
          {
            "get": "dependencies"
          },
          {
            "get": "injections"
          }
        ]
      },
      "expect": [
        [],
        true,
        true,
        true,
        true,
        [
          "user",
          "time",
          "locale"
        ],
        {
          "user": {
            "name": "user",
            "order": 0
          },
          "time": {
            "name": "time",
            "order": 2
          },
          "locale": {
            "name": "locale",
            "order": 3
          }
        }
      ]
    },
    {
      "name": "testParamValuesCanBeSet",
      "op": "hook.run",
      "args": {
        "steps": [
          {
            "get": "params"
          },
          {
            "param": {
              "key": "x",
              "default": "",
              "validator": {
                "integer": false
              }
            }
          },
          {
            "param": {
              "key": "y",
              "default": "",
              "validator": {
                "integer": false
              }
            }
          },
          {
            "set_param_value": {
