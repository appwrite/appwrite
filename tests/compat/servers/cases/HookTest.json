      "expect": [
        [],
        true,
        true,
        true,
        true,
        {
          "x": {
            "default": "",
            "validator": "Value must be a valid signed 32-bit integer between -2,147,483,648 and 2,147,483,647",
            "description": "",
            "optional": false,
            "injections": [],
            "skipValidation": false,
            "deprecated": false,
            "example": "",
            "model": null,
            "aliases": [],
            "enum": null,
            "value": "hello",
            "order": 0
          },
          "y": {
            "default": "",
            "validator": "Value must be a valid signed 32-bit integer between -2,147,483,648 and 2,147,483,647",
            "description": "",
            "optional": false,
            "injections": [],
            "skipValidation": false,
            "deprecated": false,
            "example": "",
            "model": null,
            "aliases": [],
            "enum": null,
            "value": "world",
            "order": 1
          }
        },
        {
          "x": "hello",
          "y": "world"
        },
        "hello"
      ]
