    {
      "name": "testDescriptionCanBeSet",
      "op": "hook.run",
      "args": {
        "steps": [
          {
            "get": "desc"
          },
          {
            "desc": "new hook"
          },
          {
            "get": "desc"
          }
        ]
      },
      "expect": [
        "",
        true,
        "new hook"
      ]
    },
