{
  "source": "packages/validators/tests/NumericTest.php",
  "cases": [
    {
      "name": "testCanValidateNumerics",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Numeric",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "42"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": 1337
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": 1337
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": 1337
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": 1337.0
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": 9.1
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "not numeric"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": []
          },
          "expect": false
        },
        {
          "op": "validator.is_array",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": false
        },
        {
          "op": "validator.type",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": "mixed"
        }
      ]
    }
  ]
}
