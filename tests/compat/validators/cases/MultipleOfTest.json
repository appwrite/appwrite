{
  "source": "packages/validators/tests/MultipleOfTest.php",
  "cases": [
    {
      "name": "testIsValid",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Text",
            "args": {
              "length": 20
            }
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.new",
          "args": {
            "class": "URL",
            "args": {}
          },
          "bind": "v2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.new",
          "args": {
            "class": "AllOf",
            "args": {
              "validators": [
                {
                  "$ref": "v1"
                },
                {
                  "$ref": "v2"
                }
              ],
              "type": "string"
            }
          },
          "bind": "v3",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.type",
          "args": {
            "validator": {
              "$ref": "v3"
            }
          },
          "expect": "string"
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "v3"
            }
          },
          "expect": "Value must be a valid string and at least 1 chars and no longer than 20 chars"
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v3"
            },
            "value": "http://example.com/very-long-url"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v3"
            },
            "value": "hello world"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v3"
            },
            "value": "http://example.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v3"
            },
            "value": "https://google.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v3"
            },
            "value": "example.com/hello-world"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v3"
            },
            "value": ""
          },
          "expect": false
        }
      ]
    },
