{
  "source": "packages/validators/tests/JSON/ArrayValidatorTest.php",
  "cases": [
    {
      "name": "testAcceptsDecodedArrays",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ArrayValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": [
              "test"
            ]
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": [
              1,
              2
            ]
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": [
              {
                "test": "demo"
              }
            ]
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": [
              [
                1,
                2
              ],
              [
                3,
                4
              ]
            ]
          },
          "expect": true
        }
      ]
    },
    {
      "name": "testAcceptsEncodedArrays",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ArrayValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "[]"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "[1, 2]"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "[\"test\"]"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "[{\"test\": \"demo\"}]"
          },
          "expect": true
        }
      ]
    },
    {
      "name": "testAcceptsAmbiguousEmptyArray",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ArrayValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": []
          },
          "expect": true
        }
      ]
    },
    {
      "name": "testRejectsObjects",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ArrayValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "{}"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "{\"test\": \"demo\"}"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": {
              "test": "demo"
            }
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": {
              "$object": {
                "test": "demo"
              }
            }
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": {}
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testRejectsEncodedScalars",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ArrayValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
