{
  "source": "packages/validators/tests/IdentifierTest.php",
  "cases": [
    {
      "name": "testAcceptsValidIdentifiers",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Identifier",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "APPWRITE_APP_SECRET"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "_private"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "lowercase_ok"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "A1"
          },
          "expect": true
        },
        {
          "op": "validator.is_array",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": false
        },
        {
          "op": "validator.type",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": "string"
        }
      ]
    },
    {
      "name": "testRejectsNonIdentifiers",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Identifier",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "APPWRITE_APP_SECRET\t"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "APPWRITE_APP_SECRET\n"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "GRAVAÇÃO"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "9FOO"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "MY-VAR"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "MY VAR"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "FOO=BAR"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": ""
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": 123
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testEnforcesLength",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Identifier",
            "args": {
              "length": 4
            }
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "ABCD"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "ABCDE"
          },
          "expect": false
        }
      ]
    }
  ]
}
