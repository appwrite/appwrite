    {
      "name": "testCanValidateHostnamesWithAllowList",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Hostname",
            "args": {
              "allowList": [
                "myweb.vercel.app",
                "myweb.com",
                "*.myapp.com"
              ]
            }
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "myweb.vercel.app"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "myweb.vercel.com"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "myweb2.vercel.app"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "vercel.app"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "mycommit.myweb.vercel.app"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "myweb.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "myweb.eu"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "project.myweb.eu"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "commit.project.myweb.eu"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "project1.myapp.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "project2.myapp.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "project-with-dash.myapp.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "anything.myapp.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "commit.anything.myapp.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "anything.myapp.eu"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "myapp.com"
          },
          "expect": false
        },
        {
          "op": "validator.new",
          "args": {
            "class": "Hostname",
            "args": {
              "allowList": [
                "localhost"
              ]
            }
          },
          "bind": "v2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "localhost"
          },
          "expect": true
        }
      ]
    },
