    {
      "name": "testRestrictions",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Domain",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "domain.restriction",
          "args": {
            "hostname": "appwrite.network",
            "levels": 3,
            "prefixDenyList": [
              "preview-",
              "branch-"
            ]
          },
          "expect": {
            "hostname": "appwrite.network",
            "levels": 3,
            "prefixDenyList": [
              "preview-",
              "branch-"
            ]
          }
        },
        {
          "op": "domain.restriction",
          "args": {
            "hostname": "fra.appwrite.run",
            "levels": 4,
            "prefixDenyList": []
          },
          "expect": {
            "hostname": "fra.appwrite.run",
            "levels": 4,
            "prefixDenyList": []
          }
        },
        {
          "op": "validator.new",
          "args": {
            "class": "Domain",
            "args": {
              "restrictions": [
                {
                  "hostname": "appwrite.network",
                  "levels": 3,
                  "prefixDenyList": [
                    "preview-",
                    "branch-"
                  ]
                },
                {
                  "hostname": "fra.appwrite.run",
                  "levels": 4,
                  "prefixDenyList": []
                }
              ]
            }
          },
          "bind": "v2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "google.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "stage.google.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "shard4.stage.google.com"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "appwrite.network"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "preview-a.appwrite.network"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "branch-a.appwrite.network"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "google.appwrite.network"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "stage.google.appwrite.network"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "shard4.stage.google.appwrite.network"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "fra.appwrite.run"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "appwrite.run"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "google.fra.appwrite.run"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "shard4.google.fra.appwrite.run"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "branch-google.fra.appwrite.run"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "preview-google.fra.appwrite.run"
          },
          "expect": true
        }
      ]
    },
