{
  "source": "packages/validators/tests/WildcardTest.php",
  "cases": [
    {
      "name": "testCanValidateWildcard",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Wildcard",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": [
              "string",
              "string"
            ]
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": ""
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": []
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": 1
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": true
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": false
          },
          "expect": true
        },
        {
          "op": "validator.is_array",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": false
        },
        {
          "op": "validator.type",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": "string"
        }
      ]
    }
  ]
}
