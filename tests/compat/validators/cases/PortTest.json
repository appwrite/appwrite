{
  "source": "packages/validators/tests/PortTest.php",
  "cases": [
    {
      "name": "testType",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "Port",
            "args": {}
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.type",
          "args": {
            "validator": {
              "$ref": "v"
            }
          },
          "expect": "string"
        },
        {
          "op": "validator.is_array",
          "args": {
            "validator": {
              "$ref": "v"
            }
          },
          "expect": false
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "v"
            }
          },
          "expect": "Value must be a port between 1 and 65535, optionally prefixed by a host IP address (e.g. 127.0.0.1:80)"
        }
      ]
    },
