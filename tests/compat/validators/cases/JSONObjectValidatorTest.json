{
  "source": "packages/validators/tests/JSON/ObjectValidatorTest.php",
  "cases": [
    {
      "name": "testAcceptsDecodedObjects",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": {
              "test": "demo"
            }
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": {
              "nested": {
                "test": "demo"
              }
            }
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": {
              "list": [
                "one",
                "two"
              ]
            }
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": {
              "$object": {
                "test": "demo"
              }
            }
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": {}
          },
          "expect": true
        }
      ]
    },
    {
      "name": "testAcceptsEncodedObjects",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "{}"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "{\"test\": \"demo\"}"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "{\"nested\": {\"test\": \"demo\"}}"
          },
          "expect": true
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "{\"list\": [\"one\", \"two\"]}"
          },
          "expect": true
        }
      ]
    },
    {
      "name": "testAcceptsAmbiguousEmptyArray",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": []
          },
          "expect": true
        }
      ]
    },
    {
      "name": "testRejectsLists",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "[]"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "[1, 2]"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "[{\"test\": \"demo\"}]"
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": [
              "test"
            ]
          },
          "expect": false
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": [
              {
                "test": "demo"
              }
            ]
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testRejectsEncodedScalars",
      "steps": [
        {
          "op": "validator.new",
