    {
      "name": "testEnforcesLength",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {
              "length": 15
            }
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v1"
            },
            "value": "{\"test\":\"demo\"}"
          },
          "expect": true
        },
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {
              "length": 14
            }
          },
          "bind": "v2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v2"
            },
            "value": "{\"test\":\"demo\"}"
          },
          "expect": false
        },
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {
              "length": 15
            }
          },
          "bind": "v3",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v3"
            },
            "value": {
              "test": "demo"
            }
          },
          "expect": true
        },
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {
              "length": 14
            }
          },
          "bind": "v4",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v4"
            },
            "value": {
              "test": "demo"
            }
          },
          "expect": false
        },
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {
              "length": 15
            }
          },
          "bind": "v5",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v5"
            },
            "value": {
              "$object": {
                "test": "demo"
              }
            }
          },
          "expect": true
        },
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {
              "length": 14
            }
          },
          "bind": "v6",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v6"
            },
            "value": {
              "$object": {
                "test": "demo"
              }
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testContract",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {}
          },
          "bind": "v1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_array",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": false
        },
        {
          "op": "validator.type",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": "object"
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "v1"
            }
          },
          "expect": "Value must be a valid JSON object"
        },
        {
          "op": "validator.new",
          "args": {
            "class": "JSON\\ObjectValidator",
            "args": {
              "length": 16
            }
          },
          "bind": "v2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "v2"
            }
          },
          "expect": "Value must be a valid JSON object no longer than 16 characters when encoded"
        }
      ]
    }
  ]
}
