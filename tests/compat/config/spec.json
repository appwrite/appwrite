{
  "lib": "config",
  "description": "utopia-php/config: the Config::$params registry with dotted keys, and typed configs loaded from env, dotenv, JSON, YAML and PHP sources.",
  "complete": true,
  "php": {
    "src": [
      "packages/config/src"
    ],
    "tests": [
      "packages/config/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/config"
  },
  "services": [],
  "state": [],
  "ops": {
    "config.reset_params": {
      "doc": "Config::$params = []",
      "covers": []
    },
    "config.set_param": {
      "doc": "Config::setParam(key, value); value is Typed, or {\"$handle\"} of a loaded config",
      "covers": [
        "Utopia\\Config\\Config::setParam"
      ]
    },
    "config.get_param": {
      "doc": "Config::getParam(key, default?)",
      "covers": [
        "Utopia\\Config\\Config::getParam"
      ]
    },
    "config.params": {
      "doc": "on empty params: calls {op: set|get, key, value}; get is Config::getParam(key, 'default')",
      "covers": [
        "Utopia\\Config\\Config::setParam",
        "Utopia\\Config\\Config::getParam"
      ],
      "fuzz": [
        {
          "name": "dotted",
          "args": {
            "gen": "object",
            "fields": {
              "calls": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "param_call"
                },
                "min": 1,
                "max": 10
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "config.source": {
      "doc": "getContents() of a source {kind: variable, value} | {kind: file, path, contents?} | {kind: environment, set?}; `keys` keeps only those keys of an array",
      "covers": [
        "Utopia\\Config\\Source::getContents",
        "Utopia\\Config\\Source\\Variable::__construct",
        "Utopia\\Config\\Source\\File::__construct",
        "Utopia\\Config\\Source\\Environment::__construct"
      ]
    },
    "config.parse": {
      "doc": "(new <parser>)->parse(contents, schema ? new ReflectionClass(schema) : null) for parser dotenv|json|yaml|php|none",
      "covers": [
        "Utopia\\Config\\Parser\\Dotenv::parse",
        "Utopia\\Config\\Parser\\JSON::parse",
        "Utopia\\Config\\Parser\\YAML::parse",
        "Utopia\\Config\\Parser\\PHP::parse",
        "Utopia\\Config\\Parser\\None::parse"
      ],
      "fuzz": [
        {
          "name": "dotenv",
          "args": {
            "gen": "object",
            "fields": {
              "parser": {
                "gen": "const",
                "value": "dotenv"
              },
              "contents": {
                "gen": "ref",
                "name": "dotenv"
              },
              "schema": {
                "gen": "pick",
                "from": [
                  "FuzzConfig",
                  "TestValueConvertorConfig"
                ]
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "json",
          "args": {
            "gen": "object",
            "fields": {
              "parser": {
                "gen": "const",
                "value": "json"
              },
              "contents": {
                "gen": "ref",
                "name": "json_text"
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "yaml",
          "args": {
            "gen": "object",
            "fields": {
              "parser": {
                "gen": "const",
                "value": "yaml"
              },
              "contents": {
                "gen": "ref",
                "name": "yaml"
              }
            }
          },
          "iterations": 4000
        },
        {
          "name": "yaml text",
          "args": {
            "gen": "object",
            "fields": {
              "parser": {
                "gen": "const",
                "value": "yaml"
              },
              "contents": {
                "gen": "string",
                "alphabet": "ab: -?[]{},&*!|>'\"#%@`\n 01.~",
                "min": 0,
                "max": 24
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "php",
          "args": {
            "gen": "object",
            "fields": {
              "parser": {
                "gen": "const",
                "value": "php"
              },
              "contents": {
                "gen": "ref",
                "name": "php"
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "config.load": {
      "doc": "Config::load(source, parser, schema) dumped as {\"$config\", properties}, or a handle when `handle` is true",
      "covers": [
        "Utopia\\Config\\Config::load",
        "Utopia\\Config\\Source\\Variable::__construct",
        "Utopia\\Config\\Source\\File::__construct",
        "Utopia\\Config\\Source\\Environment::__construct",
        "Utopia\\Config\\Source::getContents",
        "Utopia\\Config\\Parser\\Dotenv::parse",
        "Utopia\\Config\\Parser\\JSON::parse",
        "Utopia\\Config\\Parser\\YAML::parse",
        "Utopia\\Config\\Parser\\PHP::parse",
        "Utopia\\Config\\Parser\\None::parse"
      ],
      "fuzz": [
        {
          "name": "values",
          "args": {
            "gen": "object",
            "fields": {
              "source": {
                "gen": "object",
                "fields": {
                  "kind": {
                    "gen": "const",
                    "value": "variable"
                  },
                  "value": {
                    "gen": "ref",
                    "name": "fuzz_values"
                  }
                }
              },
              "parser": {
                "gen": "const",
                "value": "none"
              },
              "schema": {
                "gen": "const",
                "value": "FuzzConfig"
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "dotenv",
          "args": {
            "gen": "object",
            "fields": {
              "source": {
                "gen": "object",
                "fields": {
                  "kind": {
                    "gen": "const",
                    "value": "variable"
                  },
                  "value": {
                    "gen": "ref",
                    "name": "dotenv"
                  }
                }
              },
              "parser": {
                "gen": "const",
                "value": "dotenv"
              },
              "schema": {
                "gen": "const",
                "value": "FuzzConfig"
              }
            }
          },
          "iterations": 2000
        }
      ]
    }
  },
  "generators": {
