      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "{\"name\": null}"
            },
            "parser": "json",
            "schema": "TestOptionalNullableConfig"
          },
          "expect": {
            "$config": "TestOptionalNullableConfig",
            "properties": [
              [
                "name",
                null
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "testValueTypeMismatchThrowsLoad",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "PORT=abc"
            },
            "parser": "dotenv",
            "schema": "TestTypeMismatchConfig"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Config\\Exception\\Load",
              "message": "Invalid value for PORT: does not match the type of property port."
            }
          }
        }
      ]
    }
  ]
}
