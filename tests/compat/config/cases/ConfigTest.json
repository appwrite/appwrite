{
  "source": "packages/config/tests/ConfigTest.php",
  "cases": [
    {
      "name": "testFileSource",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "file",
              "path": "/tmp/compat-fs/${ns}/config.json",
              "contents": "{\n  \"jsonKey\": \"customValue\"\n}\n"
            },
            "parser": "json",
            "schema": "TestConfig"
          },
          "expect": {
            "$config": "TestConfig",
            "properties": [
              [
                "phpKey",
                null
              ],
              [
                "jsonKey",
                "customValue"
              ],
              [
                "yamlKey",
                null
              ],
              [
                "ymlKey",
                null
              ],
              [
                "envKey",
                null
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "testFileSourceException",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "file",
              "path": "/tmp/compat-fs/${ns}/non-existing.json"
            },
            "parser": "json",
            "schema": "TestConfig"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Config\\Exception\\Load",
              "message": "Loader returned null contents."
            }
          }
        }
      ]
    },
    {
      "name": "testVariableSource",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": {
                "phpKey": "aValue",
                "ENV_KEY": "aValue"
              }
            },
            "parser": "none",
            "schema": "TestConfig"
          },
          "expect": {
            "$config": "TestConfig",
            "properties": [
              [
                "phpKey",
                "aValue"
              ],
              [
                "jsonKey",
                null
              ],
              [
                "yamlKey",
                null
              ],
              [
                "ymlKey",
                null
              ],
              [
                "envKey",
                "aValue"
              ]
            ]
          }
        },
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "ENV_KEY=aValue"
            },
            "parser": "dotenv",
            "schema": "TestConfig"
          },
          "expect": {
            "$config": "TestConfig",
            "properties": [
              [
                "phpKey",
                null
              ],
              [
                "jsonKey",
                null
              ],
              [
                "yamlKey",
                null
              ],
              [
                "ymlKey",
                null
              ],
              [
                "envKey",
                "aValue"
              ]
            ]
          }
        },
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "environment",
              "set": {
                "_UTOPIA_KEY1": "hello",
                "_UTOPIA_KEY2": "world"
              }
            },
            "parser": "none",
            "schema": "TestEnvConfig"
          },
          "expect": {
            "$config": "TestEnvConfig",
            "properties": [
              [
                "key1",
                "hello"
              ],
              [
                "key2",
                "world"
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "testAdapters php",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "file",
              "path": "/tmp/compat-fs/${ns}/config.php",
              "contents": "<?php\n\ndeclare(strict_types=1);\n\nreturn [\n    'phpKey' => 'customValue',\n];\n"
            },
            "parser": "php",
            "schema": "TestConfig"
          },
          "expect": {
            "$config": "TestConfig",
            "properties": [
              [
                "phpKey",
                "customValue"
              ],
              [
                "jsonKey",
                null
              ],
              [
                "yamlKey",
                null
              ],
              [
                "ymlKey",
                null
              ],
              [
                "envKey",
                null
              ]
            ]
          }
        }
      ]
    },
