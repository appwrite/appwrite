    {
      "name": "testSubConfigs",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "ENV_KEY=envValue"
            },
            "parser": "dotenv",
            "schema": "TestConfig",
            "handle": true
          },
          "bind": "c1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "yml_key: ymlValue"
            },
            "parser": "yaml",
            "schema": "TestConfig",
            "handle": true
          },
          "bind": "c2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": {
                "config1": {
                  "$ref": "c1"
                },
                "config2": {
                  "$ref": "c2"
                },
                "rootKey": "rootValue"
              }
            },
            "parser": "none",
            "schema": "TestGroupConfig"
          },
          "expect": {
            "$config": "TestGroupConfig",
            "properties": [
              [
                "config1",
                {
                  "$config": "TestConfig",
                  "properties": [
                    [
                      "phpKey",
                      null
                    ],
                    [
                      "jsonKey",
                      null
                    ],
                    [
                      "yamlKey",
                      null
                    ],
                    [
                      "ymlKey",
                      null
                    ],
                    [
                      "envKey",
                      "envValue"
                    ]
                  ]
                }
              ],
              [
                "config2",
                {
                  "$config": "TestConfig",
                  "properties": [
                    [
                      "phpKey",
                      null
                    ],
                    [
                      "jsonKey",
                      null
                    ],
                    [
                      "yamlKey",
                      null
                    ],
                    [
                      "ymlKey",
                      "ymlValue"
                    ],
                    [
                      "envKey",
                      null
                    ]
                  ]
                }
              ],
              [
                "rootKey",
                "rootValue"
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "testExceptionValidator",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "key=too_long_value_that_will_not_get_accepted"
            },
            "parser": "dotenv",
            "schema": "TestConfigRequired"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Config\\Exception\\Load",
              "message": "Invalid value for key: Value must be a valid string and no longer than 8 chars"
            }
          }
        }
      ]
    },
    {
      "name": "testExceptionRequired",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "SOME_OTHER_KEY=value"
            },
            "parser": "dotenv",
            "schema": "TestConfigRequired"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Config\\Exception\\Load",
              "message": "Missing required key: key"
            }
          }
        }
      ]
    },
    {
      "name": "testAbsentOptionalKeyLeavesAUsableObject",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": {
                "host": "db"
              }
            },
            "parser": "none",
            "schema": "TestOptionalConfig"
          },
          "expect": {
            "$config": "TestOptionalConfig",
            "properties": [
              [
                "host",
                "db"
              ],
              [
                "mode",
                "auto"
              ],
              [
                "port",
                null
              ],
              [
                "tls",
                null
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "testAbsentOptionalKeyWithoutDefaultThrowsLoad",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": []
            },
            "parser": "none",
            "schema": "TestOptionalWithoutDefaultConfig"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Config\\Exception\\Load",
              "message": "Missing optional key: name. Property name needs a default or a nullable type."
            }
          }
        }
      ]
    },
    {
      "name": "testNestedValues",
      "steps": [
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "{\"db.host\": \"docker.internal\", \"db.config.tls\": true}"
            },
            "parser": "json",
            "schema": "TestNestedValueConfig"
          },
          "expect": {
            "$config": "TestNestedValueConfig",
            "properties": [
              [
                "dbHost",
                "docker.internal"
              ],
              [
                "tls",
                true
              ]
            ]
          }
        },
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "{\"db\": {\"host\": \"docker.internal\", \"config\": {\"tls\": true}}}"
            },
            "parser": "json",
            "schema": "TestNestedValueConfig"
          },
          "expect": {
            "$config": "TestNestedValueConfig",
            "properties": [
              [
                "dbHost",
                "docker.internal"
              ],
              [
                "tls",
                true
              ]
            ]
          }
        },
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "{\"db\": {\"host\": \"docker.internal\", \"config.tls\": true}}"
            },
            "parser": "json",
            "schema": "TestNestedValueConfig"
          },
          "expect": {
            "$config": "TestNestedValueConfig",
            "properties": [
              [
                "dbHost",
                "docker.internal"
              ],
              [
                "tls",
                true
              ]
            ]
          }
        },
        {
          "op": "config.load",
          "args": {
            "source": {
              "kind": "variable",
              "value": "{\"db.host\": \"docker.internal\", \"db\": {\"config\": {\"tls\": true}}}"
            },
            "parser": "json",
            "schema": "TestNestedValueConfig"
          },
          "expect": {
            "$config": "TestNestedValueConfig",
            "properties": [
              [
                "dbHost",
                "docker.internal"
              ],
              [
                "tls",
                true
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "testRequiredNullablePresentNull",
      "steps": [
