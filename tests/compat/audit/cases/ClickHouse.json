  "cases": [
    {
      "name": "setup on a database that does not exist (quirk)",
      "state": [
        "clickhouse@audit-clickhouse"
      ],
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {},
          "bind": "adapter",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.set_database",
          "args": {
            "adapter": {
              "$ref": "adapter"
            },
            "value": "${ns}_missing"
          },
          "expect": true
        },
        {
          "op": "adapter.setup",
          "args": {
            "adapter": {
              "$ref": "adapter"
            }
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "ClickHouse query execution failed: ClickHouse query failed with HTTP 404: Code: 81. DB::Exception: Database ${ns}_missing does not exist. (UNKNOWN_DATABASE) (version 26.4.3.37 (official build))\n"
            }
          }
        },
        {
          "op": "adapter.ping",
          "args": {
            "adapter": {
              "$ref": "adapter"
            }
          },
          "expect": true
        }
      ]
    },
