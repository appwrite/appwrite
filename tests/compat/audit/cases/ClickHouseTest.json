{
  "source": "packages/audit/tests/Adapter/ClickHouseTest.php",
  "cases": [
    {
      "name": "testPingSendsAuthenticatedGet",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "host": "clickhouse",
            "username": "user",
            "password": "secret",
            "port": 8124,
            "fake": true
          },
          "bind": "adapter",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.get_name",
          "args": {
            "adapter": {
              "$ref": "adapter"
            }
          },
          "expect": "ClickHouse"
        },
        {
          "op": "fake.respond",
          "args": {
            "adapter": {
              "$ref": "adapter"
            },
            "status": 200,
            "body": "Ok.\n"
          },
          "expect": null
        },
        {
          "op": "adapter.ping",
          "args": {
            "adapter": {
              "$ref": "adapter"
            }
          },
          "expect": true
        },
        {
          "op": "fake.requests",
          "args": {
            "adapter": {
              "$ref": "adapter"
            }
          },
          "expect": [
            {
              "method": "GET",
              "uri": "http://clickhouse:8124/ping",
              "headers": {
                "Host": [
                  "clickhouse:8124"
                ],
                "X-ClickHouse-User": [
                  "user"
                ],
                "X-ClickHouse-Key": [
                  "secret"
                ]
              },
              "content_type": "",
              "body": ""
            }
          ]
        }
      ]
    },
    {
      "name": "testPingFailsOnErrorStatus",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "host": "clickhouse",
            "username": "user",
            "password": "secret",
            "port": 8124,
            "fake": true
          },
          "bind": "adapter",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.respond",
          "args": {
            "adapter": {
              "$ref": "adapter"
            },
            "status": 503
          },
          "expect": null
        },
        {
          "op": "adapter.ping",
          "args": {
            "adapter": {
              "$ref": "adapter"
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testPingFailsOnNetworkError",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "host": "clickhouse",
            "username": "user",
            "password": "secret",
            "port": 8124,
            "fake": true
          },
          "bind": "adapter",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.fail",
          "args": {
            "adapter": {
              "$ref": "adapter"
            },
            "message": "Connection refused"
          },
          "expect": null
        },
        {
          "op": "adapter.ping",
          "args": {
            "adapter": {
              "$ref": "adapter"
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testPingUsesHttpsWhenSecure",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "host": "clickhouse",
            "username": "user",
            "password": "secret",
            "port": 8124,
            "fake": true
