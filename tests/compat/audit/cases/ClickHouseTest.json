          "op": "fake.requests",
          "args": {
            "adapter": {
              "$ref": "adapter"
            }
          },
          "expect": [
            {
              "method": "GET",
              "uri": "https://clickhouse:8124/ping",
              "headers": {
                "Host": [
                  "clickhouse:8124"
                ],
                "X-ClickHouse-User": [
                  "user"
                ],
                "X-ClickHouse-Key": [
                  "secret"
                ]
              },
              "content_type": "",
              "body": ""
            }
          ]
        }
      ]
