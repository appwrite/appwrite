          }
        },
        {
          "op": "fake.respond",
          "args": {
            "adapter": {
              "$ref": "adapter"
            },
            "status": 200
          },
          "expect": null
        },
        {
          "op": "adapter.set_secure",
          "args": {
            "adapter": {
              "$ref": "adapter"
            },
            "value": true
          },
          "expect": true
        },
        {
          "op": "adapter.ping",
          "args": {
            "adapter": {
              "$ref": "adapter"
