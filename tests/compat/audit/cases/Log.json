    {
      "name": "attribute access",
      "steps": [
        {
          "op": "log.attribute",
          "args": {
            "attributes": {
              "a": 1,
              "n": null
            },
            "key": "a"
          },
          "expect": 1
        },
        {
          "op": "log.attribute",
          "args": {
            "attributes": {
              "a": 1,
              "n": null
            },
            "key": "n",
            "default": "d"
          },
          "expect": null
        },
        {
          "op": "log.attribute",
          "args": {
            "attributes": {
              "a": 1
            },
            "key": "b",
            "default": "d"
          },
          "expect": "d"
        },
        {
          "op": "log.set",
          "args": {
            "attributes": {
              "a": 1
            },
            "key": "b",
            "value": [
              1,
              2
            ]
          },
          "expect": {
            "a": 1,
            "b": [
              1,
              2
            ]
          }
        },
        {
          "op": "log.set",
          "args": {
            "attributes": {
              "a": 1,
              "b": 2
            },
            "key": "a",
            "value": null
          },
          "expect": {
            "a": null,
            "b": 2
          }
        },
        {
          "op": "log.set",
          "args": {
            "attributes": [],
            "key": "7",
            "value": "numeric key"
          },
          "expect": {
            "7": "numeric key"
          }
        },
        {
          "op": "log.remove",
          "args": {
            "attributes": {
              "a": 1,
              "b": 2
            },
            "key": "a"
          },
          "expect": {
            "b": 2
          }
        },
        {
          "op": "log.remove",
          "args": {
            "attributes": {
              "a": 1
            },
            "key": "z"
          },
          "expect": {
            "a": 1
          }
        },
        {
          "op": "log.is_set",
          "args": {
            "attributes": {
              "a": null
            },
            "key": "a"
          },
          "expect": true
        },
        {
          "op": "log.is_set",
          "args": {
            "attributes": {
              "a": null
            },
            "key": "b"
          },
          "expect": false
        }
