{
  "lib": "compression",
  "description": "utopia-php/compression: Brotli, Deflate, GZIP, LZ4, Snappy, XZ and Zstd behind one interface, and Accept-Encoding negotiation.",
  "complete": true,
  "php": {
    "src": [
      "packages/compression/src"
    ],
    "tests": [
      "packages/compression/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/compression"
  },
  "services": [],
  "state": [],
  "ops": {
    "compress": {
      "doc": "algorithm(args)->compress(data): {value, warning} (value as {length, sha256} with digest; warning: the first warning the extension emitted). algorithm is {class, level? (constructor), set_level? (setLevel), mode? (generic|text|font)}; data is `data` or `file` (a path from the checkout root)",
      "covers": [
        "Utopia\\Compression\\Algorithms\\Brotli::compress",
        "Utopia\\Compression\\Algorithms\\Brotli::setLevel",
        "Utopia\\Compression\\Algorithms\\Brotli::useGenericMode",
        "Utopia\\Compression\\Algorithms\\Brotli::useTextMode",
        "Utopia\\Compression\\Algorithms\\Brotli::useFontMode",
        "Utopia\\Compression\\Algorithms\\Deflate::compress",
        "Utopia\\Compression\\Algorithms\\GZIP::compress",
        "Utopia\\Compression\\Algorithms\\LZ4::__construct",
        "Utopia\\Compression\\Algorithms\\LZ4::compress",
        "Utopia\\Compression\\Algorithms\\LZ4::setLevel",
        "Utopia\\Compression\\Algorithms\\Snappy::compress",
        "Utopia\\Compression\\Algorithms\\XZ::compress",
        "Utopia\\Compression\\Algorithms\\Zstd::__construct",
        "Utopia\\Compression\\Algorithms\\Zstd::compress",
        "Utopia\\Compression\\Algorithms\\Zstd::setLevel"
      ],
      "fuzz": [
        {
          "name": "exact algorithms on random bytes",
          "args": {
            "gen": "object",
            "fields": {
              "algorithm": {
                "gen": "ref",
                "name": "exact"
              },
              "data": {
                "gen": "bytes",
                "min": 0,
                "max": 3000
              }
            }
          },
          "iterations": 400
        },
        {
          "name": "exact algorithms on repetitive text",
          "args": {
            "gen": "object",
            "fields": {
              "algorithm": {
                "gen": "ref",
                "name": "exact"
              },
              "data": {
                "gen": "ref",
                "name": "text"
              }
            }
          },
          "iterations": 400
        }
      ]
    },
    "decompress": {
      "doc": "algorithm(args)->decompress(data): {value, warning}",
      "covers": [
        "Utopia\\Compression\\Algorithms\\Brotli::decompress",
        "Utopia\\Compression\\Algorithms\\Deflate::decompress",
        "Utopia\\Compression\\Algorithms\\GZIP::decompress",
        "Utopia\\Compression\\Algorithms\\LZ4::decompress",
        "Utopia\\Compression\\Algorithms\\Snappy::decompress",
        "Utopia\\Compression\\Algorithms\\XZ::decompress",
        "Utopia\\Compression\\Algorithms\\Zstd::decompress"
      ],
      "fuzz": [
        {
          "name": "random bytes",
          "args": {
            "gen": "object",
            "fields": {
              "algorithm": {
                "gen": "pick",
                "from": [
                  {
                    "class": "Brotli"
                  },
                  {
                    "class": "Deflate"
                  },
                  {
                    "class": "GZIP"
                  },
                  {
                    "class": "Zstd"
                  },
                  {
                    "class": "XZ"
                  }
                ]
              },
              "data": {
                "gen": "bytes",
                "min": 0,
                "max": 64
              }
            }
          },
          "iterations": 600
        },
        {
