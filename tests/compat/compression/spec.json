                    "gen": "bytes",
                    "min": 1,
                    "max": 400
                  },
                  {
                    "gen": "ref",
                    "name": "text"
                  }
                ]
              },
              "from": {
                "gen": "const",
                "value": 4
              },
              "at": {
                "gen": "int",
                "min": 0,
                "max": 100000
              },
              "xor": {
                "gen": "int",
                "min": 1,
                "max": 255
              }
            }
          },
          "iterations": 400
        },
        {
          "name": "one flipped byte after the zstd frame header",
          "args": {
            "gen": "object",
            "fields": {
              "algorithm": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "const",
                    "value": {
