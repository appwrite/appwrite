    "roundtrip": {
      "doc": "decompress(compress(data)) on one instance: {value, warning, smaller} (smaller: the compressed string is shorter than data). For Brotli at qualities 2 to 11, whose bytes may differ (see deviations)",
      "fuzz": [
        {
          "name": "every algorithm and level",
          "args": {
            "gen": "object",
            "fields": {
              "algorithm": {
                "gen": "ref",
                "name": "any"
              },
              "data": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "bytes",
                    "min": 0,
                    "max": 2000
                  },
                  {
                    "gen": "ref",
                    "name": "text"
                  }
                ]
              }
            }
          },
          "iterations": 300
        }
      ]
    },
    "corrupt": {
      "doc": "compress(data), XOR the byte at `at` (modulo the length) with `xor`, then decompress: {value, warning}. Decoders on near-valid streams",
      "fuzz": [
        {
          "name": "one flipped byte",
          "args": {
            "gen": "object",
            "fields": {
              "algorithm": {
                "gen": "ref",
                "name": "stream"
              },
              "data": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "bytes",
                    "min": 0,
                    "max": 400
                  },
                  {
                    "gen": "ref",
                    "name": "text"
                  }
                ]
              },
              "at": {
                "gen": "int",
                "min": 0,
                "max": 100000
              },
              "xor": {
                "gen": "int",
                "min": 1,
                "max": 255
              }
            }
          },
          "iterations": 800
        },
