  "waivers": {},
  "tests_waived": {},
  "quirks": [
    {
      "symbol": "Utopia\\Compression\\Algorithms\\Brotli::useTextMode",
      "description": "useTextMode() and useFontMode() set BROTLI_GENERIC, so they compress exactly like generic mode. Kept in Rust (use_text_mode and use_font_mode keep Mode::Generic).",
      "case": "extra.json#brotli font and text modes compress as generic"
    },
    {
      "symbol": "Utopia\\Compression\\Algorithms\\Brotli::useFontMode",
      "description": "useFontMode() sets BROTLI_GENERIC (see useTextMode).",
      "case": "extra.json#brotli font and text modes compress as generic"
    },
    {
      "symbol": "Utopia\\Compression\\Algorithms\\LZ4::decompress",
      "description": "lz4_uncompress() fails with 'data error' when the block decodes to 0 bytes, so LZ4 cannot decompress its own output for an empty string.",
      "case": "extra.json#lz4 empty string does not round trip"
    },
    {
      "symbol": "Utopia\\Compression\\Algorithms\\LZ4::__construct",
      "description": "The constructor takes any level; one outside 0..12 makes compress() return an empty string with the warning 'lz4_compress: compression level (13) must be within 1..12'.",
      "case": "extra.json#lz4 constructor levels are unchecked"
    },
    {
      "symbol": "Utopia\\Compression\\Algorithms\\Zstd::__construct",
      "description": "The constructor takes any level: zstd's negative levels and 0 (the default) work, and one above 22 makes compress() return an empty string with a warning.",
      "case": "extra.json#zstd constructor levels are unchecked"
    },
    {
      "symbol": "Utopia\\Compression\\Algorithms\\Zstd::decompress",
      "description": "zstd_uncompress() decodes the first frame only, ignores what follows it, and returns what it decoded of a truncated frame without a warning.",
      "case": "extra.json#zstd reads the first frame"
    }
  ],
  "deviations": [
