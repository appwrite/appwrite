                "of": [
                  {
                    "gen": "bytes",
                    "min": 1,
                    "max": 400
                  },
                  {
                    "gen": "ref",
                    "name": "text"
                  }
                ]
              },
              "from": {
                "gen": "const",
                "value": 18
