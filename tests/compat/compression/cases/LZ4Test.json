        },
        "warning": null
      }
    },
    {
      "name": "round trip PNG image",
      "op": "roundtrip",
      "args": {
        "algorithm": {
          "class": "LZ4"
        },
        "file": "packages/compression/tests/resources/disk-b/kitten-1.png",
        "digest": true
      },
      "expect": {
        "value": {
          "length": 3038056,
          "sha256": "07b78c11dab6ab70719e9ed46f5ef7ad5c20b27259be3a3af2968964934edace"
        },
        "warning": null,
