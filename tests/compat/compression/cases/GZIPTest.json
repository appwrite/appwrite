{
  "source": "packages/compression/tests/Algorithms/GZIPTest.php",
  "cases": [
    {
      "name": "name",
      "op": "describe",
      "args": {
        "algorithm": {
          "class": "GZIP"
        }
      },
      "expect": {
        "class": "GZIP",
        "name": "gzip",
        "encoding": "gzip",
        "supported": true
      }
    },
    {
      "name": "compress text",
      "op": "compress",
      "args": {
        "algorithm": {
          "class": "GZIP"
        },
        "data": "This is a demo string"
      },
      "expect": {
        "value": {
          "$bytes": "H4sIAAAAAAAAAwvJyCxWAKJEhZTU3HyF4pKizLx0ADiDa4AVAAAA"
        },
        "warning": null
      }
    },
    {
      "name": "round trip text",
      "op": "roundtrip",
      "args": {
        "algorithm": {
          "class": "GZIP"
        },
        "data": "This is a demo string"
      },
      "expect": {
        "value": "This is a demo string",
        "warning": null,
        "smaller": false
      }
    },
    {
      "name": "compress large text",
      "op": "compress",
      "args": {
        "algorithm": {
          "class": "GZIP"
        },
        "file": "packages/compression/tests/resources/disk-a/lorem.txt",
        "digest": true
      },
      "expect": {
        "value": {
          "length": 44444,
          "sha256": "14efb8765596721e007ce03bfb14105396d1c33461acac23fbd1ed771c122a10"
        },
        "warning": null
      }
    },
    {
      "name": "round trip large text",
      "op": "roundtrip",
      "args": {
        "algorithm": {
          "class": "GZIP"
        },
        "file": "packages/compression/tests/resources/disk-a/lorem.txt",
        "digest": true
      },
      "expect": {
        "value": {
          "length": 386795,
          "sha256": "46afc5648fa06a19441aaadf963f67964b3f6e6f4d2e10af833783a0e9a68db5"
        },
        "warning": null,
        "smaller": true
      }
    },
    {
      "name": "compress JPG image",
      "op": "compress",
      "args": {
        "algorithm": {
          "class": "GZIP"
        },
        "file": "packages/compression/tests/resources/disk-a/kitten-1.jpg",
        "digest": true
      },
      "expect": {
        "value": {
          "length": 599107,
          "sha256": "055cd41a7a3286af506cee29ecdb1f2ec6bf3a012c321329db9593465e451601"
        },
        "warning": null
      }
    },
    {
      "name": "round trip JPG image",
      "op": "roundtrip",
      "args": {
        "algorithm": {
          "class": "GZIP"
        },
        "file": "packages/compression/tests/resources/disk-a/kitten-1.jpg",
        "digest": true
      },
      "expect": {
        "value": {
          "length": 599639,
          "sha256": "ac20844d0d8a7e2ffeb17322f279ef8651b300d9bd86b69512aa933678153d3e"
        },
        "warning": null,
        "smaller": true
      }
    },
    {
      "name": "compress PNG image",
      "op": "compress",
      "args": {
        "algorithm": {
          "class": "GZIP"
        },
        "file": "packages/compression/tests/resources/disk-b/kitten-1.png",
        "digest": true
      },
      "expect": {
        "value": {
          "length": 3029202,
          "sha256": "7843d918871a675ce6e87543f41d20151d45c01dd5d31fe609746a367d646b6d"
        },
        "warning": null
      }
    },
    {
      "name": "round trip PNG image",
      "op": "roundtrip",
      "args": {
        "algorithm": {
          "class": "GZIP"
        },
        "file": "packages/compression/tests/resources/disk-b/kitten-1.png",
        "digest": true
      },
      "expect": {
        "value": {
          "length": 3038056,
          "sha256": "07b78c11dab6ab70719e9ed46f5ef7ad5c20b27259be3a3af2968964934edace"
        },
        "warning": null,
        "smaller": true
      }
    }
  ]
}
