        {
          "op": "s3.new",
          "args": {
            "root": "",
            "host": "http://127.0.0.1:9000",
            "region": "us-east-1",
            "client": {
              "$ref": "c"
            },
            "retry_delay": 0.0
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "telemetry.new",
          "args": {
            "device": {
              "$ref": "s"
            }
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "device.stream",
          "args": {
            "device": {
              "$ref": "d"
            },
            "path": "/missing",
            "catch": true
          },
          "expect": {
            "received": "",
            "result": {
              "class": "Utopia\\Storage\\Exception\\NotFoundException",
              "message": "File not found",
              "code": 404,
              "error_code": null,
              "previous": false
            }
          }
        }
      ]
    },
    {
      "name": "an ignored range is refused before delivery",
      "steps": [
