          }
        },
        {
          "op": "s3.new",
          "args": {
            "root": "",
            "host": "http://127.0.0.1:9000",
            "region": "us-east-1",
            "client": {
              "$ref": "c"
            },
            "retry_delay": 0.0
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "telemetry.new",
          "args": {
            "device": {
              "$ref": "s"
            }
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "device.stream",
          "args": {
            "device": {
              "$ref": "d"
            },
            "path": "/ignores-range",
            "offset": 2,
            "length": 4,
            "catch": true
          },
          "expect": {
            "received": "",
            "result": {
              "class": "Utopia\\Storage\\Exception\\RemoteException",
              "message": "Backend did not honor the requested byte range.",
              "code": 0,
              "error_code": null,
              "previous": false
            }
          }
        }
      ]
    },
