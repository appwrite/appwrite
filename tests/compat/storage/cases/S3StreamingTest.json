{
  "source": "packages/storage/tests/Device/S3StreamingTest.php",
  "cases": [
    {
      "name": "bytes reach the sink through the telemetry decorator",
      "steps": [
        {
          "op": "scripted.new",
          "args": {
            "response_streaming": true,
            "responses": [
              {
                "status": 200,
                "headers": [
                  [
                    "Content-Type",
                    "application/octet-stream"
                  ],
                  [
                    "Content-Length",
                    "11"
                  ]
                ],
                "body": "Hello World"
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "s3.new",
          "args": {
            "root": "",
            "host": "http://127.0.0.1:9000",
            "region": "us-east-1",
            "client": {
              "$ref": "c"
            },
            "retry_delay": 0.0
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "telemetry.new",
          "args": {
            "device": {
              "$ref": "s"
            }
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "device.stream",
          "args": {
            "device": {
              "$ref": "d"
            },
            "path": "/object"
          },
          "expect": {
            "received": "Hello World",
            "result": null
          }
        },
        {
          "op": "telemetry.recorded",
          "args": {
            "device": {
              "$ref": "d"
            }
          },
          "expect": {
            "storage.operation": 1
          }
        },
        {
          "op": "scripted.requests",
          "args": {
            "client": {
              "$ref": "c"
            }
          },
          "expect": [
            {
              "method": "GET",
              "url": "http://127.0.0.1:9000/object",
              "headers": {
                "accept-encoding": "identity",
                "authorization": "<masked>",
                "content-length": "0",
                "content-md5": "1B2M2Y8AsgTpgAmY7PhCfg==",
                "date": "<masked>",
                "host": "127.0.0.1:9000",
                "user-agent": "utopia-php/storage",
                "x-amz-content-sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                "x-amz-date": "<masked>"
              },
              "body": ""
            }
          ]
        }
      ]
    },
    {
