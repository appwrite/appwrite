            "index": 1,
            "last": false,
            "digest": true
          },
          "expect": {
            "size": 65536,
            "md5": "f19c01fa0371e3c9070b45a85c696c48"
          }
        },
        {
          "op": "blob.slice",
          "args": {
            "blob": {
              "$ref": "e"
            },
            "from": 196692
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cipher.decrypt",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "data": {
              "$ref": "t"
            },
            "index": 3,
            "last": true
          },
          "expect": {
            "$bytes": "ByZFZIOiweD/Hg=="
          }
        },
        {
          "op": "cipher.decrypt",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "data": {
              "$ref": "m"
            },
            "index": 1,
            "last": true
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Storage\\Exception\\StorageException",
              "message": "Segment 1 failed authentication"
            }
          }
        }
      ]
    },
