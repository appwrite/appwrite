    {
      "name": "wrapped key restores cipher",
      "steps": [
        {
          "op": "cipher.new",
          "args": {
            "key": {
              "$bytes": "a2tra2tra2tra2tra2tra2tra2tra2tra2tra2tra2s="
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cipher.encrypt",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "data": "secret",
            "index": 0,
            "last": true
          },
          "bind": "e",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cipher.wrap",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "master": "master"
          },
          "bind": "w",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "blob.size",
          "args": {
            "blob": {
              "$ref": "w"
            }
          },
          "expect": 60
        },
        {
          "op": "cipher.unwrap",
          "args": {
            "wrapped": {
              "$ref": "w"
            },
            "master": "master"
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cipher.decrypt",
          "args": {
            "cipher": {
              "$ref": "u"
            },
            "data": {
              "$ref": "e"
            },
            "index": 0,
            "last": true
          },
          "expect": "secret"
        },
        {
          "op": "cipher.wrap",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "master": ""
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Master key must not be empty"
            }
          }
        },
        {
          "op": "cipher.unwrap",
          "args": {
            "wrapped": {
              "$ref": "w"
            },
            "master": ""
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Master key must not be empty"
            }
          }
        },
        {
          "op": "cipher.unwrap",
          "args": {
            "wrapped": "too short",
            "master": ""
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Storage\\Exception\\StorageException",
              "message": "Unable to unwrap the key"
            }
          }
        }
      ]
    },
