            "$handle": "*"
          }
        },
        {
          "op": "cipher.encrypt",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "pattern": 131072,
            "index": 0,
            "last": false
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cipher.encrypt",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "data": "the second part",
            "index": 2,
            "last": true
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "blob.concat",
          "args": {
            "blobs": [
              {
                "$ref": "a"
              },
              {
                "$ref": "b"
              }
            ]
          },
          "bind": "e",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cipher.decrypt",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "data": {
              "$ref": "e"
            },
            "index": 0,
            "last": true,
            "digest": true
          },
          "expect": {
            "size": 131087,
            "md5": "5423ba7d4c0ce8dc7aede2193482f4b8"
          }
        }
      ]
    },
    {
      "name": "range",
