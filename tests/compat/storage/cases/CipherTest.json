{
  "source": "packages/storage/tests/CipherTest.php",
  "cases": [
    {
      "name": "round trip: empty",
      "steps": [
        {
          "op": "cipher.new",
          "args": {
            "key": {
              "$bytes": "a2tra2tra2tra2tra2tra2tra2tra2tra2tra2tra2s="
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cipher.encrypt",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "pattern": 0,
            "index": 0,
            "last": true
          },
          "bind": "e",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "blob.size",
          "args": {
            "blob": {
              "$ref": "e"
            }
          },
          "expect": 28
        },
        {
          "op": "cipher.sizes",
          "args": {
            "size": 0,
            "index": 1
          },
          "expect": {
            "segments": 1,
            "size": 28,
            "offset": 65564,
            "name": "aes-256-gcm-segmented",
            "segment": 65536,
            "overhead": 28
          }
        },
        {
          "op": "cipher.decrypt",
          "args": {
            "cipher": {
              "$ref": "c"
            },
            "data": {
              "$ref": "e"
            },
            "index": 0,
            "last": true,
            "digest": true
          },
          "expect": {
            "size": 0,
            "md5": "d41d8cd98f00b204e9800998ecf8427e"
          }
        }
      ]
    },
