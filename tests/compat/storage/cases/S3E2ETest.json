    {
      "name": "deletes stay inside the root: virtual-hosted",
      "steps": [
        {
          "op": "s3.new",
          "args": {
            "minio": true,
            "root": "${ns}",
            "bucket": "compat"
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
