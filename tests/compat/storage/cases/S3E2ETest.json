        },
        {
          "op": "device.delete",
          "args": {
            "device": {
              "$ref": "d"
            },
            "path": "${ns}/dir",
            "recursive": true
          },
          "expect": true
        },
        {
          "op": "device.list_files",
          "args": {
            "device": {
              "$ref": "d"
            },
            "prefix": "${ns}/"
          },
          "mask": {
            "paths": [
              "/files/*/modified",
              "/files/*/etag"
            ],
            "reason": "modification times and upload IDs differ between runs"
          },
          "expect": {
            "files": [
              {
                "path": "${ns}/dir-archive/c.txt",
                "size": 1,
                "modified": "<masked>",
                "etag": "<masked>",
                "mime_type": null
              }
            ],
            "cursor": null
          }
        }
      ]
    },
