            "bucket": "compat"
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "device.write",
          "args": {
            "device": {
              "$ref": "d"
            },
            "path": "${ns}/dir/a.txt",
            "data": "x",
            "content_type": "text/plain"
          },
          "expect": "9dd4e461268c8034f5c8564e155c67a6"
        },
        {
          "op": "device.write",
          "args": {
            "device": {
              "$ref": "d"
            },
            "path": "${ns}/dir/sub/b.txt",
            "data": "x",
            "content_type": "text/plain"
          },
