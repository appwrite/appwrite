                  ]
                }
              },
              {
                "method": "GET",
                "path": "/v1/tablesdb/*/tables/*/rows",
                "status": 200,
                "body": {
                  "total": 2,
                  "rows": [
                    {
                      "$id": "r1",
                      "$sequence": "1",
                      "$tableId": "table",
                      "$databaseId": "database",
                      "$createdAt": "",
                      "$updatedAt": "",
                      "$permissions": [],
                      "title": "Hello",
                      "data": {
                        "nested": true
                      }
                    }
                  ]
                }
              },
              {
                "method": "GET",
                "path": "/v1/tablesdb/*/tables/*/rows/*",
                "status": 200,
                "body": {
                  "$id": "r1",
                  "$sequence": "1",
                  "$tableId": "table",
                  "$databaseId": "database",
                  "$createdAt": "",
                  "$updatedAt": "",
                  "$permissions": [],
                  "title": "Hello"
                }
              }
