{
  "source": "vendor/utopia-php/migration/tests/Migration/Unit/Sources/AppwriteReaderApiTest.php",
  "cases": [
    {
      "name": "testListColumnsNormalizesSdkListResponse, and the other reads",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "p-${ns}",
            "routes": [
              {
                "method": "GET",
                "path": "/v1/tablesdb/*/tables/*/columns",
                "status": 200,
                "body": {
                  "total": 1,
                  "columns": [
                    {
                      "key": "title",
                      "type": "string",
                      "status": "available",
                      "error": "",
                      "required": true,
                      "array": false,
                      "$createdAt": "2026-08-12T00:00:00.000+00:00",
                      "$updatedAt": "2026-08-12T00:00:00.000+00:00",
                      "size": 255,
                      "default": null,
                      "encrypt": false
                    }
                  ]
                }
              },
              {
                "method": "GET",
                "path": "/v1/tablesdb",
                "status": 200,
                "body": {
                  "total": 1,
                  "databases": [
                    {
                      "$id": "database",
                      "name": "Database",
                      "$createdAt": "",
                      "$updatedAt": "",
                      "enabled": false,
                      "type": "tablesdb"
                    }
                  ]
                }
              },
              {
                "method": "GET",
                "path": "/v1/tablesdb/*/tables",
                "status": 200,
                "body": {
                  "total": 1,
                  "tables": [
                    {
                      "$id": "table",
                      "$createdAt": "",
                      "$updatedAt": "",
                      "$permissions": [],
                      "databaseId": "database",
                      "name": "Table",
                      "enabled": false,
                      "rowSecurity": false,
                      "columns": [
                        {
                          "key": "title",
                          "type": "string",
                          "status": "available",
                          "error": "",
                          "required": true,
                          "array": false,
                          "$createdAt": "2026-08-12T00:00:00.000+00:00",
                          "$updatedAt": "2026-08-12T00:00:00.000+00:00",
                          "size": 255,
                          "default": null,
                          "encrypt": false
                        }
                      ],
                      "indexes": [
                        {
                          "key": "i"
                        }
                      ],
