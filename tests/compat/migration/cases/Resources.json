    {
      "name": "json-machine items of fixed documents",
      "steps": [
        {
          "op": "json_machine.items",
          "args": {
            "json": "[1, \"a\", {\"b\": [true, null]}]",
            "decoder": "ext"
          },
          "expect": {
            "items": [
              [
                0,
                1
              ],
              [
                1,
                "a"
              ],
              [
                2,
                {
                  "b": [
                    true,
                    null
                  ]
                }
              ]
            ],
            "error": null
          }
        },
        {
          "op": "json_machine.items",
          "args": {
            "json": "{\"x\": 1.5, \"y\": []}",
            "decoder": "passthru"
          },
          "expect": {
            "items": [
              [
                "\"x\"",
                "1.5"
              ],
              [
                "\"y\"",
                "[]"
              ]
            ],
            "error": null
          }
        },
        {
          "op": "json_machine.items",
          "args": {
            "json": "[1,",
            "decoder": "ext"
          },
          "expect": {
            "items": [
              [
                0,
                1
              ]
            ],
            "error": {
              "class": "JsonMachine\\Exception\\UnexpectedEndSyntaxErrorException",
              "message": "JSON string ended unexpectedly ',' At position 0."
            }
          }
        },
        {
          "op": "json_machine.items",
          "args": {
            "json": "",
            "decoder": "ext"
          },
          "expect": {
            "items": [],
            "error": {
              "class": "JsonMachine\\Exception\\SyntaxErrorException",
              "message": "Cannot iterate empty JSON '' At position 0."
            }
          }
        },
        {
          "op": "json_machine.items",
          "args": {
            "json": "[1] [2]",
            "decoder": "ext"
          },
          "expect": {
            "items": [
              [
                0,
                1
              ]
            ],
            "error": null
          }
        }
      ]
    },
