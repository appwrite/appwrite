    {
      "name": "the resolver pins the connection",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "req-${ns}",
            "routes": [
              {
                "method": "GET",
                "path": "/redirect",
                "status": 302,
                "headers": {
                  "Location": "/p/req-${ns}/echo"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/redirect-file",
                "status": 302,
                "headers": {
                  "Location": "file:///etc/hosts"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/echo",
                "status": 200,
                "body": {
                  "method": "GET",
                  "host": "{host}",
                  "uri": "{uri}"
                }
              }
            ]
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "request_target.new",
          "args": {
            "endpoint": "http://pinned.invalid:{port}/p/req-${ns}"
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resolver.new",
          "args": {
            "mode": "pin"
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "target.configure",
          "args": {
            "target": {
              "$ref": "t"
            },
            "resolver": {
              "$ref": "r"
            }
          },
          "expect": null
        },
        {
          "op": "target.request",
          "args": {
            "target": {
              "$ref": "t"
            },
            "method": "GET",
            "path": "/echo",
            "params": {
              "a": "b"
            }
          },
          "expect": {
            "response": {
              "method": "GET",
              "host": "pinned.invalid:{port}",
              "uri": "/echo?a=b"
            }
          }
        },
        {
          "op": "resolver.urls",
          "args": {
            "resolver": {
              "$ref": "r"
            }
          },
          "expect": [
            "http://pinned.invalid:{port}/p/req-${ns}/echo?a=b"
          ]
        }
      ]
    },
