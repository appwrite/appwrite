{
  "source": "packages/migration/tests/General/TargetRequestTest.php",
  "cases": [
    {
      "name": "a redirect is not followed by default",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "req-${ns}",
            "routes": [
              {
                "method": "GET",
                "path": "/redirect",
                "status": 302,
                "headers": {
                  "Location": "/p/req-${ns}/echo"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/redirect-file",
                "status": 302,
                "headers": {
                  "Location": "file:///etc/hosts"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/echo",
                "status": 200,
                "body": {
                  "method": "GET",
                  "host": "{host}",
                  "uri": "{uri}"
                }
              }
            ]
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "request_target.new",
          "args": {
            "endpoint": "{api}/p/req-${ns}"
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "target.request",
          "args": {
            "target": {
              "$ref": "t"
            },
            "method": "GET",
            "path": "/redirect",
            "params": {
              "to": "/echo"
            }
          },
          "expect": {
            "error": {
              "class": "Exception",
              "code": 302,
              "message": "302: Redirects are not followed"
            }
          }
        },
        {
          "op": "api.requests",
          "args": {
            "project": "req-${ns}"
          },
          "mask": {
            "paths": [
              "/*/headers/user-agent"
            ],
            "reason": "Target::call() requests carry cURL's user agent, `<os>-<release>:php-<version>` on PHP and `<os>-<release>:rust` on Rust"
          },
          "expect": [
            {
              "method": "GET",
              "path": "/redirect",
              "query": "to=%2Fecho",
              "headers": {
                "accept": "*/*",
                "user-agent": "<masked>"
              },
              "body": ""
            }
          ]
        }
      ]
    },
    {
      "name": "a redirect is followed when enabled",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "req-${ns}",
            "routes": [
              {
                "method": "GET",
                "path": "/redirect",
                "status": 302,
                "headers": {
                  "Location": "/p/req-${ns}/echo"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/redirect-file",
                "status": 302,
                "headers": {
                  "Location": "file:///etc/hosts"
                },
                "body": ""
