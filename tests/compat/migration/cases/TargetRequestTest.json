          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "target.configure",
          "args": {
            "target": {
              "$ref": "t"
            },
            "follow": true
          },
          "expect": null
        },
        {
          "op": "target.request",
          "args": {
            "target": {
              "$ref": "t"
            },
            "method": "GET",
            "path": "/redirect",
            "params": {
              "to": "/echo"
            }
          },
          "expect": {
            "response": {
              "method": "GET",
              "host": "{authority}",
              "uri": "/echo"
            }
          }
        },
        {
          "op": "api.requests",
          "args": {
            "project": "req-${ns}"
          },
          "mask": {
            "paths": [
              "/*/headers/user-agent"
            ],
            "reason": "Target::call() requests carry cURL's user agent, `<os>-<release>:php-<version>` on PHP and `<os>-<release>:rust` on Rust"
          },
          "expect": [
            {
              "method": "GET",
              "path": "/redirect",
              "query": "to=%2Fecho",
              "headers": {
                "accept": "*/*",
                "user-agent": "<masked>"
              },
              "body": ""
            },
            {
              "method": "GET",
              "path": "/echo",
              "query": "",
              "headers": {
                "accept": "*/*",
                "user-agent": "<masked>"
              },
              "body": ""
            }
          ]
        }
      ]
