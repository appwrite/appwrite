            "class": "Functions\\Func",
            "array": {
              "id": "function",
              "name": "Function",
              "runtime": "php-8.4",
              "runtimeSpecification": "s-1vcpu-512mb",
              "buildSpecification": "s-2vcpu-2gb"
            }
          },
          "bind": "f",
          "expect": {
            "$handle": "*"
          }
        },
        {
