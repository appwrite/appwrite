            "db": {
              "$ref": "db"
            },
            "id": "providers"
          },
          "expect": true
        },
        {
          "op": "db.document",
          "args": {
            "db": {
              "$ref": "db"
            },
            "collection": "users",
            "document": {
              "$id": "u1",
              "name": "U"
            }
          },
          "expect": "1"
