              {
                "method": "POST",
                "path": "/v1/storage/buckets",
                "status": 200,
                "body": {
                  "$id": "b-new",
                  "$createdAt": "",
                  "$updatedAt": "",
                  "$permissions": [],
                  "fileSecurity": false,
                  "name": "",
                  "enabled": false,
                  "maximumFileSize": 30000000,
                  "allowedFileExtensions": [],
                  "compression": "",
                  "encryption": false,
                  "antivirus": false,
                  "transformations": false,
                  "totalSize": 0
                }
              }
            ]
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "db.new",
          "args": {
            "schemaless": true
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.collection",
          "args": {
            "db": {
              "$ref": "db"
            },
            "id": "users"
          },
          "expect": true
        },
        {
          "op": "db.collection",
          "args": {
            "db": {
              "$ref": "db"
            },
            "id": "targets"
          },
          "expect": true
