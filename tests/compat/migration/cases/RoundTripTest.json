            "getDenyDisposableEmail": null,
            "getDenyFreeEmail": null,
            "getGroup": "auth",
            "getId": "project",
            "getMembershipsUserAccessedAt": null,
            "getMembershipsUserEmail": true,
            "getMembershipsUserId": true,
            "getMembershipsUserMfa": true,
            "getMembershipsUserName": true,
            "getMembershipsUserPhone": true,
            "getMessage": "",
            "getMfaFactors": null,
            "getName": "policies",
            "getOriginalId": "",
            "getPasskeyRpId": "example.com",
            "getPasswordDictionary": false,
            "getPasswordHistory": 0,
            "getPasswordPwned": {
              "enabled": true,
              "sessions": false,
              "users": true
            },
            "getPasswordRotation": {
              "enabled": true,
              "maxAge": 86400
            },
            "getPasswordStrength": null,
            "getPermissions": [],
            "getPersonalDataCheck": false,
            "getSequence": "",
            "getSessionAlerts": false,
            "getSessionDuration": 31536000,
            "getSessionInvalidation": false,
            "getSessionsLimit": 100,
            "getStatus": "pending",
            "getUpdatedAt": "",
