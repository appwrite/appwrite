          }
        }
      ]
    },
    {
      "name": "policies from an older source leave the new ones unreported",
      "steps": [
        {
          "op": "resource.from_array",
          "args": {
            "class": "Auth\\Policies",
            "array": {
              "id": "project"
            }
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.describe",
          "args": {
            "resource": {
              "$ref": "p"
            }
          },
          "expect": {
            "class": "Utopia\\Migration\\Resources\\Auth\\Policies",
            "getCreatedAt": "",
            "getDenyAliasedEmail": null,
            "getDenyCorporateEmail": null,
            "getDenyDisposableEmail": null,
            "getDenyFreeEmail": null,
            "getGroup": "auth",
            "getId": "project",
            "getMembershipsUserAccessedAt": null,
            "getMembershipsUserEmail": true,
            "getMembershipsUserId": true,
            "getMembershipsUserMfa": true,
            "getMembershipsUserName": true,
            "getMembershipsUserPhone": true,
            "getMessage": "",
            "getMfaFactors": null,
            "getName": "policies",
            "getOriginalId": "",
            "getPasskeyRpId": null,
            "getPasswordDictionary": false,
            "getPasswordHistory": 0,
            "getPasswordPwned": null,
            "getPasswordRotation": null,
            "getPasswordStrength": null,
            "getPermissions": [],
            "getPersonalDataCheck": false,
            "getSequence": "",
            "getSessionAlerts": false,
            "getSessionDuration": 31536000,
            "getSessionInvalidation": false,
            "getSessionsLimit": 100,
            "getStatus": "pending",
            "getUpdatedAt": "",
            "getUserLimit": 0
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Auth\\Policies",
            "array": {
              "id": "project",
              "passwordPwned": "yes"
            }
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Utopia\\Migration\\Resources\\Auth\\Policies::__construct(): Argument #24 ($passwordPwned) must be of type ?array, string given"
            }
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Auth\\Policies",
            "array": {
              "id": "project",
              "passkeyRpId": [
                "x"
              ]
            }
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Utopia\\Migration\\Resources\\Auth\\Policies::__construct(): Argument #26 ($passkeyRpId) must be of type ?string, array given"
            }
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Auth\\Policies",
            "array": {
              "id": "project",
              "createdAt": [],
              "passwordRotation": 1
            }
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Utopia\\Migration\\Resources\\Auth\\Policies::__construct(): Argument #22 ($createdAt) must be of type string, array given"
            }
          }
        }
      ]
    },
    {
      "name": "an environment carries its name",
      "steps": [
        {
          "op": "resource.new",
          "args": {
            "class": "Settings\\Environment",
            "args": {
              "id": "staging",
              "name": "Staging"
            }
          },
          "bind": "e",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.json",
          "args": {
            "resource": {
              "$ref": "e"
            }
          },
          "expect": {
            "id": "staging",
            "name": "Staging",
            "createdAt": "",
            "updatedAt": ""
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Settings\\Environment",
            "array": {
              "id": "staging",
              "name": "Staging",
              "createdAt": "",
              "updatedAt": ""
            }
          },
          "bind": "back",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.describe",
          "args": {
            "resource": {
              "$ref": "back"
            }
          },
          "expect": {
            "class": "Utopia\\Migration\\Resources\\Settings\\Environment",
            "getCreatedAt": "",
            "getEnvironmentName": "Staging",
            "getGroup": "projects",
            "getId": "staging",
            "getMessage": "",
            "getName": "project-environment",
            "getOriginalId": "",
            "getPermissions": [],
            "getSequence": "",
            "getStatus": "pending",
            "getUpdatedAt": ""
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Settings\\Environment",
            "array": {
              "id": "dev"
            }
          },
          "bind": "bare",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.describe",
          "args": {
            "resource": {
              "$ref": "bare"
            }
          },
          "expect": {
            "class": "Utopia\\Migration\\Resources\\Settings\\Environment",
            "getCreatedAt": "",
            "getEnvironmentName": "",
            "getGroup": "projects",
            "getId": "dev",
            "getMessage": "",
            "getName": "project-environment",
            "getOriginalId": "",
            "getPermissions": [],
            "getSequence": "",
            "getStatus": "pending",
            "getUpdatedAt": ""
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Settings\\Environment",
            "array": {
              "id": "dev",
              "name": [
                "x"
              ]
            }
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Utopia\\Migration\\Resources\\Settings\\Environment::__construct(): Argument #2 ($name) must be of type string, array given"
            }
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Settings\\Environment",
            "array": {
              "name": "x"
            }
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Utopia\\Migration\\Resources\\Settings\\Environment::__construct(): Argument #1 ($id) must be of type string, null given"
            }
          }
        },
        {
          "op": "resource.json_encode",
          "args": {
            "resource": {
              "$ref": "e"
            }
          },
          "expect": "{\"id\":\"staging\",\"name\":\"Staging\",\"createdAt\":\"\",\"updatedAt\":\"\"}"
        }
      ]
    }
  ]
}
