{
  "source": "packages/migration/tests/Resources/RoundTripTest.php",
  "cases": [
    {
      "name": "a topic carries its qos and expiry",
      "steps": [
        {
          "op": "resource.new",
          "args": {
            "class": "Messaging\\Topic",
            "args": {
              "id": "news",
              "name": "News",
              "subscribe": [
                "users"
              ],
              "qos": 1,
              "expiry": 3600
            }
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.json",
          "args": {
            "resource": {
              "$ref": "t"
            }
          },
          "expect": {
            "id": "news",
            "name": "News",
            "subscribe": [
              "users"
            ],
            "createdAt": "",
            "updatedAt": "",
            "qos": 1,
            "expiry": 3600
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Messaging\\Topic",
            "array": {
              "id": "news",
              "name": "News",
              "subscribe": [
                "users"
              ],
              "createdAt": "",
              "updatedAt": "",
              "qos": 1,
              "expiry": 3600
            }
          },
          "bind": "back",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.describe",
          "args": {
            "resource": {
              "$ref": "back"
            }
          },
          "expect": {
            "class": "Utopia\\Migration\\Resources\\Messaging\\Topic",
            "getCreatedAt": "",
            "getExpiry": 3600,
            "getGroup": "messaging",
            "getId": "news",
            "getMessage": "",
            "getName": "topic",
            "getOriginalId": "",
            "getPermissions": [],
            "getQos": 1,
            "getSequence": "",
            "getStatus": "pending",
            "getSubscribe": [
              "users"
            ],
            "getTopicName": "News",
            "getUpdatedAt": ""
          }
        }
      ]
    },
    {
      "name": "a topic without qos and expiry leaves them to the destination",
      "steps": [
        {
          "op": "resource.from_array",
          "args": {
            "class": "Messaging\\Topic",
            "array": {
              "id": "news",
              "name": "News"
            }
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.describe",
          "args": {
            "resource": {
              "$ref": "t"
            }
          },
          "expect": {
            "class": "Utopia\\Migration\\Resources\\Messaging\\Topic",
            "getCreatedAt": "",
            "getExpiry": null,
            "getGroup": "messaging",
            "getId": "news",
            "getMessage": "",
            "getName": "topic",
            "getOriginalId": "",
            "getPermissions": [],
            "getQos": null,
            "getSequence": "",
            "getStatus": "pending",
            "getSubscribe": [],
            "getTopicName": "News",
            "getUpdatedAt": ""
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Messaging\\Topic",
            "array": {
              "id": "news",
              "name": "News",
              "qos": "x"
            }
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Utopia\\Migration\\Resources\\Messaging\\Topic::__construct(): Argument #6 ($qos) must be of type ?int, string given"
            }
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Messaging\\Topic",
            "array": {
              "id": "news",
              "name": "News",
              "qos": "2",
              "expiry": 1.5
            }
          },
          "expect": {
            "$handle": "*"
          }
        }
      ]
    },
    {
      "name": "policies carry password-pwned, password-rotation and the passkey relying party",
      "steps": [
        {
          "op": "resource.new",
          "args": {
            "class": "Auth\\Policies",
            "args": {
              "id": "project",
              "passwordPwned": {
                "enabled": true,
                "sessions": false,
                "users": true
              },
              "passwordRotation": {
                "enabled": true,
                "maxAge": 86400
              },
              "passkeyRpId": "example.com"
            }
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.json",
          "args": {
            "resource": {
              "$ref": "p"
            }
          },
          "expect": {
            "id": "project",
            "passwordHistory": 0,
            "sessionDuration": 31536000,
            "sessionsLimit": 100,
            "userLimit": 0,
            "passwordDictionary": false,
            "personalDataCheck": false,
            "sessionAlerts": false,
            "sessionInvalidation": false,
            "membershipsUserId": true,
            "membershipsUserEmail": true,
            "membershipsUserName": true,
            "membershipsUserMfa": true,
            "membershipsUserPhone": true,
            "membershipsUserAccessedAt": null,
            "passwordStrength": null,
            "mfaFactors": null,
            "denyAliasedEmail": null,
            "denyDisposableEmail": null,
            "denyFreeEmail": null,
            "denyCorporateEmail": null,
            "passwordPwned": {
              "enabled": true,
              "sessions": false,
              "users": true
            },
            "passwordRotation": {
              "enabled": true,
              "maxAge": 86400
            },
            "passkeyRpId": "example.com",
            "createdAt": "",
            "updatedAt": ""
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Auth\\Policies",
            "array": {
              "id": "project",
              "passwordPwned": {
                "enabled": true,
                "sessions": false,
                "users": true
              },
              "passwordRotation": {
                "enabled": true,
                "maxAge": 86400
              },
              "passkeyRpId": "example.com"
