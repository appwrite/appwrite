    {
      "name": "documentsdb, legacy and untyped databases; documentSecurity; a missing security is a TypeError",
      "steps": [
        {
          "op": "resource.from_array",
          "args": {
            "class": "Database\\Collection",
            "array": {
              "database": {
                "id": "d",
                "name": "D",
                "type": "documentsdb"
              },
              "id": "c",
              "name": "C",
              "documentSecurity": 1
            }
          },
          "bind": "c1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resource.describe",
          "args": {
            "resource": {
              "$ref": "c1"
            }
          },
          "expect": {
            "class": "Utopia\\Migration\\Resources\\Database\\Collection",
            "getCreatedAt": "",
            "getDatabase": {
              "id": "d",
              "name": "D",
              "createdAt": "",
              "updatedAt": "",
              "enabled": true,
              "type": "documentsdb",
              "database": "",
              "status": null
            },
            "getDimension": null,
            "getEnabled": true,
            "getGroup": "databases",
            "getId": "c",
            "getMessage": "",
            "getName": "collection",
            "getOriginalId": "",
            "getPermissions": [],
            "getRowSecurity": true,
            "getSequence": "",
            "getStatus": "pending",
            "getTableName": "C",
            "getUpdatedAt": ""
          }
        },
        {
          "op": "resource.from_array",
          "args": {
            "class": "Database\\Collection",
            "array": {
              "database": {
                "id": "d",
                "name": "D"
              },
              "id": "c",
              "name": "C",
              "rowSecurity": false,
              "dimension": "12"
            }
          },
          "bind": "c2",
          "expect": {
            "$handle": "*"
