              "$ref": "c2"
            }
          },
          "expect": {
            "class": "Utopia\\Migration\\Resources\\Database\\Collection",
            "getCreatedAt": "",
            "getDatabase": {
              "id": "d",
              "name": "D",
              "createdAt": "",
              "updatedAt": "",
              "enabled": true,
              "type": "legacy",
              "database": null,
              "status": null
            },
            "getDimension": 12,
            "getEnabled": true,
            "getGroup": "databases",
            "getId": "c",
            "getMessage": "",
            "getName": "collection",
            "getOriginalId": "",
            "getPermissions": [],
