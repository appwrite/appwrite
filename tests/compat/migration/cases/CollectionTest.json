        {
          "op": "resource.from_array",
          "args": {
            "class": "Database\\Collection",
            "array": {
              "database": {
                "id": "d",
                "name": "D",
                "type": "documentsdb"
              },
              "id": "c",
              "name": "C"
            }
          },
          "mask": {
            "paths": [
              "/$error/message"
            ],
            "reason": "PHP appends \", called in <file> on line <n>\" of the library call site to an argument TypeError; Rust reports the same message without the PHP call site"
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "<masked>"
            }
          }
        },
