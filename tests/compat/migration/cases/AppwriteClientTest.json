    {
      "name": "the resolver pins the connection, once per client",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "cli-${ns}",
            "routes": [
              {
                "method": "GET",
                "path": "/redirect",
                "status": 302,
                "headers": {
                  "Location": "/p/cli-${ns}/echo"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/redirect-file",
                "status": 302,
                "headers": {
                  "Location": "file:///etc/hosts"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/echo",
                "status": 200,
                "body": {
                  "method": "GET",
                  "host": "{host}",
                  "uri": "{uri}"
                }
              }
            ]
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "appwrite_client.new",
          "args": {
            "endpoint": "http://pinned.invalid:{port}/p/cli-${ns}"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resolver.new",
          "args": {
            "mode": "pin"
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "appwrite_client.configure",
          "args": {
            "client": {
              "$ref": "c"
            },
            "resolver": {
              "$ref": "r"
            }
          },
          "expect": null
        },
        {
          "op": "appwrite_client.call",
          "args": {
            "client": {
              "$ref": "c"
            },
            "method": "GET",
            "path": "/echo",
            "params": {
              "a": "b"
            }
          },
          "expect": {
            "response": {
              "method": "GET",
              "host": "pinned.invalid:{port}",
              "uri": "/echo?a=b"
            }
          }
        },
        {
          "op": "appwrite_client.call",
          "args": {
            "client": {
              "$ref": "c"
            },
            "method": "GET",
            "path": "/echo"
          },
          "expect": {
            "response": {
              "method": "GET",
              "host": "pinned.invalid:{port}",
              "uri": "/echo"
            }
          }
        },
        {
          "op": "resolver.urls",
          "args": {
            "resolver": {
              "$ref": "r"
            }
          },
          "expect": [
            "http://pinned.invalid:{port}/p/cli-${ns}"
          ]
        }
      ]
    },
