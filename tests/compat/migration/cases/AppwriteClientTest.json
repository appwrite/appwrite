{
  "source": "packages/migration/tests/Sources/AppwriteClientTest.php",
  "cases": [
    {
      "name": "a redirect is not followed",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "cli-${ns}",
            "routes": [
              {
                "method": "GET",
                "path": "/redirect",
                "status": 302,
                "headers": {
                  "Location": "/p/cli-${ns}/echo"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/redirect-file",
                "status": 302,
                "headers": {
                  "Location": "file:///etc/hosts"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/echo",
                "status": 200,
                "body": {
                  "method": "GET",
                  "host": "{host}",
                  "uri": "{uri}"
                }
              }
            ]
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "appwrite_client.new",
          "args": {
            "endpoint": "{api}/p/cli-${ns}"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "appwrite_client.call",
          "args": {
            "client": {
              "$ref": "c"
            },
            "method": "GET",
            "path": "/redirect",
            "params": {
              "to": "/echo"
            }
          },
          "expect": {
            "error": {
              "class": "Appwrite\\AppwriteException",
              "code": 302,
              "message": "302: Redirects are not followed"
            }
          }
        },
        {
          "op": "api.requests",
          "args": {
            "project": "cli-${ns}"
          },
          "mask": {
            "paths": [
              "/*/headers/user-agent"
            ],
            "reason": "Target::call() requests carry cURL's user agent, `<os>-<release>:php-<version>` on PHP and `<os>-<release>:rust` on Rust"
          },
          "expect": [
            {
              "method": "GET",
              "path": "/redirect",
              "query": "to=%2Fecho",
              "headers": {
                "accept": "*/*",
                "user-agent": "<masked>",
                "x-appwrite-response-format": "2.0.0",
                "x-sdk-language": "php",
                "x-sdk-name": "PHP",
                "x-sdk-platform": "server",
                "x-sdk-version": "30.4.0"
              },
              "body": ""
            }
          ]
        }
      ]
    },
