    {
      "name": "the source passes its resolver to the client",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "cli-${ns}",
            "routes": []
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "appwrite_source.new",
          "args": {
            "project": "cli-${ns}",
            "endpoint": "http://pinned.invalid:{port}/v1"
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "resolver.new",
          "args": {
            "mode": "pin"
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "target.configure",
          "args": {
            "target": {
              "$ref": "s"
            },
            "resolver": {
              "$ref": "r"
            }
          },
          "expect": null
