{
  "source": "packages/migration/tests/General/TargetDestinationsTest.php",
  "cases": [
    {
      "name": "a target connects anywhere by default",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "dst-${ns}",
            "routes": [
              {
                "method": "GET",
                "path": "/redirect",
                "status": 302,
                "headers": {
                  "Location": "/p/dst-${ns}/echo"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/redirect-file",
                "status": 302,
                "headers": {
                  "Location": "file:///etc/hosts"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/echo",
                "status": 200,
                "body": {
                  "method": "GET",
                  "host": "{host}",
                  "uri": "{uri}"
                }
              }
            ]
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "request_target.new",
          "args": {
            "endpoint": "{api}/p/dst-${ns}"
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "target.request",
          "args": {
            "target": {
              "$ref": "t"
            },
            "method": "GET",
            "path": "/echo"
          },
          "expect": {
            "response": {
              "method": "GET",
              "host": "{authority}",
              "uri": "/echo"
            }
          }
        }
      ]
    },
    {
      "name": "a target refuses an address its destinations do not allow",
      "steps": [
        {
          "op": "api.routes",
          "args": {
            "project": "dst-${ns}",
            "routes": [
              {
                "method": "GET",
                "path": "/redirect",
                "status": 302,
                "headers": {
                  "Location": "/p/dst-${ns}/echo"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/redirect-file",
                "status": 302,
                "headers": {
                  "Location": "file:///etc/hosts"
                },
                "body": ""
              },
              {
                "method": "GET",
                "path": "/echo",
                "status": 200,
                "body": {
                  "method": "GET",
                  "host": "{host}",
                  "uri": "{uri}"
                }
              }
            ]
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "request_target.new",
          "args": {
            "endpoint": "{api}/p/dst-${ns}"
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "target.configure",
          "args": {
            "target": {
              "$ref": "t"
            },
            "destinations": "public"
          },
          "expect": null
        },
        {
          "op": "target.request",
          "args": {
            "target": {
              "$ref": "t"
            },
            "method": "GET",
            "path": "/echo"
          },
          "expect": {
            "error": {
              "class": "Exception",
              "code": null,
              "message": "not an allowed destination"
            }
          }
        },
        {
          "op": "api.requests",
          "args": {
            "project": "dst-${ns}"
          },
          "mask": {
            "paths": [
              "/*/headers/user-agent"
            ],
            "reason": "Target::call() requests carry cURL's user agent, `<os>-<release>:php-<version>` on PHP and `<os>-<release>:rust` on Rust"
          },
          "expect": []
        }
      ]
    },
