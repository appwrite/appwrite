{
  "source": "packages/query/tests/Builder/CursorTest.php",
  "cases": [
    {
      "name": "testCursorAfterBindsTheRowCursorColumn with data set \"array\"",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\MySQL",
            "args": []
          },
          {
            "call": "from",
            "on": {
              "$o": 1
            },
            "args": [
              "t"
            ]
          },
          {
            "call": "cursorAfter",
            "on": {
              "$o": 1
            },
            "args": [
              {
                "_cursor": 42,
                "name": "a"
              }
            ]
          },
          {
            "call": "build",
            "on": {
              "$o": 1
            },
            "args": []
          },
          {
            "get": "query",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 2
            }
          }
        ]
      },
      "expect": [
        {
          "$object": "Builder\\MySQL",
          "id": 1
        },
        {
          "$object": "Builder\\MySQL",
          "id": 1
        },
        {
          "$object": "Builder\\MySQL",
          "id": 1
        },
        {
          "$value": "Builder\\Statement",
          "id": 2,
          "props": {
            "query": "SELECT * FROM `t` WHERE `_cursor` > ?",
            "bindings": [
              42
            ],
            "readOnly": true,
            "namedBindings": null
          }
        },
        "SELECT * FROM `t` WHERE `_cursor` > ?",
        [
          42
        ]
      ]
    },
