{
  "source": "packages/query/tests/Builder/ConditionTest.php",
  "cases": [
    {
      "name": "testGetExpression",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\Condition",
            "args": [
              "status = ?",
              [
                "active"
              ]
            ]
          },
          {
            "get": "expression",
            "on": {
              "$o": 1
            }
          }
        ]
      },
      "expect": [
        {
          "$value": "Builder\\Condition",
          "id": 1,
          "props": {
            "expression": "status = ?",
            "bindings": [
              "active"
            ]
          }
        },
        "status = ?"
      ]
    },
    {
      "name": "testGetBindings",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\Condition",
            "args": [
              "status = ?",
              [
                "active"
              ]
            ]
          },
          {
            "get": "bindings",
            "on": {
              "$o": 1
            }
          }
        ]
      },
      "expect": [
        {
          "$value": "Builder\\Condition",
          "id": 1,
          "props": {
            "expression": "status = ?",
            "bindings": [
              "active"
            ]
          }
        },
        [
          "active"
        ]
      ]
    },
    {
      "name": "testEmptyBindings",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\Condition",
            "args": [
              "1 = 1"
            ]
          },
          {
            "get": "expression",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 1
            }
          }
        ]
      },
      "expect": [
        {
          "$value": "Builder\\Condition",
          "id": 1,
          "props": {
            "expression": "1 = 1",
            "bindings": []
          }
        },
        "1 = 1",
        []
      ]
    },
    {
      "name": "testMultipleBindings",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\Condition",
            "args": [
              "age BETWEEN ? AND ?",
              [
                18,
                65
              ]
            ]
          },
          {
            "get": "expression",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 1
            }
          }
        ]
      },
      "expect": [
        {
          "$value": "Builder\\Condition",
          "id": 1,
          "props": {
            "expression": "age BETWEEN ? AND ?",
            "bindings": [
              18,
              65
            ]
          }
        },
        "age BETWEEN ? AND ?",
        [
          18,
          65
        ]
      ]
    },
    {
