    {
      "name": "testBindingsPreserveTypes",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\Condition",
            "args": [
              "a = ? AND b = ? AND c = ?",
              [
                1,
                "two",
                3.0
              ]
            ]
          },
          {
            "get": "bindings",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 1
            }
          }
        ]
      },
      "expect": [
        {
          "$value": "Builder\\Condition",
          "id": 1,
          "props": {
            "expression": "a = ? AND b = ? AND c = ?",
            "bindings": [
              1,
              "two",
              3.0
            ]
          }
        },
        [
          1,
          "two",
          3.0
        ],
        [
          1,
          "two",
          3.0
        ],
        [
          1,
          "two",
          3.0
        ]
      ]
    }
  ]
}
