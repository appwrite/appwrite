  "cases": [
    {
      "name": "testBucketEmitsBucketStageWithGroupByAndBoundaries",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\MongoDB",
            "args": []
          },
          {
            "call": "from",
            "on": {
              "$o": 1
            },
            "args": [
              "sales"
            ]
          },
          {
            "call": "bucket",
            "on": {
              "$o": 1
            },
            "args": [
              "price",
              [
                0,
                100,
                200
              ],
              "Other",
              {
                "count": {
                  "$sum": 1
                }
              }
            ]
          },
          {
            "call": "build",
            "on": {
              "$o": 1
            },
            "args": []
          },
          {
            "get": "query",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "query",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "query",
            "on": {
              "$o": 2
            }
          }
        ]
      },
      "expect": [
        {
          "$object": "Builder\\MongoDB",
          "id": 1
        },
        {
          "$object": "Builder\\MongoDB",
          "id": 1
        },
        {
          "$object": "Builder\\MongoDB",
          "id": 1
        },
        {
          "$value": "Builder\\Statement",
          "id": 2,
          "props": {
            "query": "{\"collection\":\"sales\",\"operation\":\"aggregate\",\"pipeline\":[{\"$bucket\":{\"groupBy\":\"$price\",\"boundaries\":[0,100,200],\"default\":\"Other\",\"output\":{\"count\":{\"$sum\":1}}}}]}",
            "bindings": [],
            "readOnly": true,
            "namedBindings": null
          }
        },
        "{\"collection\":\"sales\",\"operation\":\"aggregate\",\"pipeline\":[{\"$bucket\":{\"groupBy\":\"$price\",\"boundaries\":[0,100,200],\"default\":\"Other\",\"output\":{\"count\":{\"$sum\":1}}}}]}",
        [],
        [],
        "{\"collection\":\"sales\",\"operation\":\"aggregate\",\"pipeline\":[{\"$bucket\":{\"groupBy\":\"$price\",\"boundaries\":[0,100,200],\"default\":\"Other\",\"output\":{\"count\":{\"$sum\":1}}}}]}",
        "{\"collection\":\"sales\",\"operation\":\"aggregate\",\"pipeline\":[{\"$bucket\":{\"groupBy\":\"$price\",\"boundaries\":[0,100,200],\"default\":\"Other\",\"output\":{\"count\":{\"$sum\":1}}}}]}"
      ]
    },
