    {
      "name": "testBulkInsertSingleRowJsonEachRow",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\ClickHouse",
            "args": []
          },
          {
            "call": "into",
            "on": {
              "$o": 1
            },
            "args": [
              "events"
