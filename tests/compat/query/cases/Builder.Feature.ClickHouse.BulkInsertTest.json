          },
          {
            "call": "bulkInsert",
            "on": {
              "$o": 1
            },
            "args": [
              {
                "$enum": "Builder\\ClickHouse\\Format::JSONEachRow"
              },
              [
                {
                  "id": 1,
                  "event": "login",
                  "time": "2024-01-01 00:00:00"
                }
              ]
            ]
          },
          {
            "is": "Builder\\ClickHouse\\FormattedInsertStatement",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "query",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "columns",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "format",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "body",
            "on": {
              "$o": 2
            }
          }
        ]
      },
      "expect": [
        {
          "$object": "Builder\\ClickHouse",
          "id": 1
        },
        {
          "$object": "Builder\\ClickHouse",
          "id": 1
        },
        {
          "$value": "Builder\\ClickHouse\\FormattedInsertStatement",
          "id": 2,
          "props": {
            "query": "INSERT INTO `events` (`id`, `event`, `time`) FORMAT JSONEachRow",
            "bindings": [],
            "readOnly": false,
            "namedBindings": null,
            "columns": [
              "id",
              "event",
              "time"
            ],
            "format": "JSONEachRow",
            "body": "{\"id\":1,\"event\":\"login\",\"time\":\"2024-01-01 00:00:00\"}"
          }
        },
        true,
        "INSERT INTO `events` (`id`, `event`, `time`) FORMAT JSONEachRow",
        [],
        [
          "id",
          "event",
          "time"
        ],
        "JSONEachRow",
        "{\"id\":1,\"event\":\"login\",\"time\":\"2024-01-01 00:00:00\"}"
      ]
    },
