    {
      "name": "testTenantSingleId",
      "op": "hook",
      "args": {
        "program": [
          {
            "new": "Hook\\Filter\\Tenant",
            "args": [
              [
                "t1"
              ]
            ]
          },
          {
            "call": "filter",
            "on": {
              "$o": 1
            },
            "args": [
              "users"
            ]
          },
          {
            "get": "expression",
            "on": {
              "$o": 2
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 2
            }
          }
        ]
      },
      "expect": [
        {
          "$object": "Hook\\Filter\\Tenant",
          "id": 1
        },
        {
          "$value": "Builder\\Condition",
          "id": 2,
          "props": {
            "expression": "tenant_id IN (?)",
            "bindings": [
              "t1"
            ]
          }
        },
        "tenant_id IN (?)",
        [
          "t1"
        ]
      ]
    },
