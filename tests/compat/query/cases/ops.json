{
  "cases": [
    {
      "name": "parse an equal query",
      "op": "query.parse",
      "args": {
        "query": "{\"method\":\"equal\",\"attribute\":\"status\",\"values\":[\"active\",1,1.5,null]}"
      },
      "expect": {
        "$value": "Query",
        "id": 1,
        "props": {
          "method": {
            "$enum": "Method::Equal"
          },
          "attribute": "status",
          "values": [
            "active",
            1,
            1.5,
            null
          ],
          "alias": "",
          "onArray": false,
          "attributeType": ""
        }
      }
    },
    {
      "name": "parse refuses raw",
      "op": "query.parse",
      "args": {
        "query": "{\"method\":\"raw\",\"attribute\":\"1 = 1\"}"
      },
      "expect": {
        "$error": {
          "class": "Utopia\\Query\\Exception\\ValidationException",
          "message": "Raw queries cannot be parsed from untrusted input; construct via Query::raw() in code"
        },
        "id": 1
      }
    },
    {
      "name": "parse allows raw when trusted",
      "op": "query.parse",
      "args": {
        "query": "{\"method\":\"raw\",\"attribute\":\"1 = ?\",\"values\":[1]}",
        "allowRaw": true
      },
      "expect": {
        "$value": "Query",
        "id": 1,
        "props": {
          "method": {
            "$enum": "Method::Raw"
          },
          "attribute": "1 = ?",
          "values": [
            1
          ],
          "alias": "",
          "onArray": false,
          "attributeType": ""
        }
      }
    },
    {
      "name": "parse invalid JSON",
      "op": "query.parse",
      "args": {
        "query": "{\"method\":"
      },
      "expect": {
        "$error": {
          "class": "Utopia\\Query\\Exception",
          "message": "Invalid query: Syntax error"
        },
        "id": 1
      }
    },
    {
      "name": "parse a scalar",
      "op": "query.parse",
      "args": {
        "query": "42"
      },
      "expect": {
        "$error": {
          "class": "Utopia\\Query\\Exception",
          "message": "Invalid query. Must be an array, got integer"
        },
        "id": 1
      }
    },
    {
      "name": "parse a nested or",
      "op": "query.parse",
      "args": {
        "query": "{\"method\":\"or\",\"values\":[{\"method\":\"equal\",\"attribute\":\"a\",\"values\":[1]},{\"method\":\"isNull\",\"attribute\":\"b\"}]}"
      },
      "expect": {
        "$value": "Query",
        "id": 1,
        "props": {
          "method": {
            "$enum": "Method::Or"
          },
          "attribute": "",
          "values": [
            {
              "$value": "Query",
              "id": 2,
              "props": {
                "method": {
                  "$enum": "Method::Equal"
                },
                "attribute": "a",
                "values": [
                  1
                ],
                "alias": "",
                "onArray": false,
                "attributeType": ""
              }
            },
            {
              "$value": "Query",
              "id": 3,
              "props": {
                "method": {
                  "$enum": "Method::IsNull"
                },
                "attribute": "b",
                "values": [],
                "alias": "",
                "onArray": false,
                "attributeType": ""
              }
            }
          ],
          "alias": "",
          "onArray": false,
          "attributeType": ""
        }
      }
    },
    {
      "name": "parse a legacy join",
      "op": "query.parse",
      "args": {
        "query": "{\"method\":\"join\",\"attribute\":\"orders\",\"values\":[\"users.id\",\"=\",\"orders.user_id\",\"o\"]}"
      },
      "expect": {
        "$value": "Query",
        "id": 1,
        "props": {
          "method": {
            "$enum": "Method::Join"
          },
          "attribute": "orders",
          "values": [
            {
              "$value": "Query",
              "id": 2,
              "props": {
                "method": {
                  "$enum": "Method::On"
                },
                "attribute": "",
                "values": [
                  "users.id",
                  "=",
                  "orders.user_id"
                ],
                "alias": "",
                "onArray": false,
                "attributeType": ""
              }
            }
          ],
          "alias": "o",
          "onArray": false,
          "attributeType": ""
        }
      }
    },
    {
      "name": "parseQuery with a non-string method",
      "op": "query.parse_query",
      "args": {
        "query": {
          "method": 5
        }
      },
      "expect": {
        "$error": {
          "class": "Utopia\\Query\\Exception",
          "message": "Invalid query method. Must be a string, got integer"
        },
        "id": 1
      }
    },
    {
      "name": "parseQuery aggregate with legacy alias",
      "op": "query.parse_query",
      "args": {
        "query": {
          "method": "count",
          "attribute": "*",
          "values": [
            "total"
          ]
        }
      },
      "expect": {
        "$value": "Query",
        "id": 1,
        "props": {
          "method": {
            "$enum": "Method::Count"
          },
          "attribute": "*",
          "values": [],
          "alias": "total",
          "onArray": false,
          "attributeType": ""
        }
      }
    },
