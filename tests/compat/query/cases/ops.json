    {
      "name": "classify SQL",
      "op": "classifier.classify",
      "args": {
        "dialect": "mysql",
        "sql": true,
        "data": "WITH x AS (SELECT 1) DELETE FROM t"
      },
      "expect": {
        "$enum": "Type::Write"
      }
    },
    {
      "name": "classify a PostgreSQL message",
      "op": "classifier.classify",
      "args": {
        "dialect": "postgresql",
        "data": "Q\u0000\u0000\u0000\rSELECT 1\u0000"
      },
      "expect": {
        "$enum": "Type::Read"
      }
    },
    {
      "name": "parse and serialize",
      "op": "ast.parse",
      "args": {
        "sql": "SELECT a, COUNT(*) AS n FROM t AS x LEFT JOIN u ON u.id = x.uid WHERE a IN (1, 2) AND b BETWEEN 1 AND 5 GROUP BY a HAVING n > 1 ORDER BY a DESC LIMIT 10"
      },
      "expect": "SELECT `a`, COUNT(*) AS `n` FROM `t` AS `x` LEFT JOIN `u` ON `u`.`id` = `x`.`uid` WHERE `a` IN (1, 2) AND `b` BETWEEN 1 AND 5 GROUP BY `a` HAVING `n` > 1 ORDER BY `a` DESC LIMIT 10"
    },
    {
      "name": "parse error",
      "op": "ast.parse",
      "args": {
        "sql": "SELECT FROM"
      },
      "expect": {
        "$error": {
          "class": "Utopia\\Query\\Exception",
          "message": "Unexpected token 'FROM' (Keyword) at position 7"
        }
      }
    },
    {
      "name": "build MySQL",
      "op": "builder.build",
      "args": {
        "dialect": "mysql",
        "queries": [
          "{\"method\":\"equal\",\"attribute\":\"a\",\"values\":[1,null]}",
          "{\"method\":\"orderDesc\",\"attribute\":\"b\"}",
          "{\"method\":\"limit\",\"values\":[5]}"
        ]
      },
      "expect": {
        "query": "SELECT * FROM `t` WHERE (`a` IN (?) OR `a` IS NULL) ORDER BY `b` DESC LIMIT ?",
        "bindings": [
          1,
          5
        ]
      }
    },
    {
      "name": "build PostgreSQL",
      "op": "builder.build",
      "args": {
        "dialect": "postgresql",
        "queries": [
          "{\"method\":\"contains\",\"attribute\":\"name\",\"values\":[\"a%b\"]}",
          "{\"method\":\"search\",\"attribute\":\"body\",\"values\":[\"hello world\"]}"
        ]
      },
      "expect": {
        "query": "SELECT * FROM \"t\" WHERE \"name\" ILIKE ? AND to_tsvector(regexp_replace(\"body\", '[^\\w]+', ' ', 'g')) @@ websearch_to_tsquery(?)",
        "bindings": [
          "%a\\%b%",
          "hello or world"
        ]
      }
    },
    {
      "name": "build MongoDB",
      "op": "builder.build",
      "args": {
        "dialect": "mongodb",
        "queries": [
          "{\"method\":\"greaterThan\",\"attribute\":\"age\",\"values\":[18]}",
          "{\"method\":\"select\",\"values\":[\"name\"]}"
        ]
      },
      "expect": {
        "query": "{\"collection\":\"t\",\"operation\":\"find\",\"filter\":{\"age\":{\"$gt\":\"?\"}},\"projection\":{\"name\":1,\"_id\":0}}",
        "bindings": [
          18
        ]
      }
    },
    {
      "name": "build ClickHouse",
      "op": "builder.build",
      "args": {
        "dialect": "clickhouse",
        "queries": [
          "{\"method\":\"regex\",\"attribute\":\"path\",\"values\":[\"^/v1\"]}",
          "{\"method\":\"offset\",\"values\":[10]}",
          "{\"method\":\"limit\",\"values\":[5]}"
        ]
      },
      "expect": {
        "query": "SELECT * FROM `t` WHERE match(`path`, ?) LIMIT ? OFFSET ?",
        "bindings": [
          "^/v1",
          5,
          10
        ]
      }
    },
    {
      "name": "build SQLite",
      "op": "builder.build",
      "args": {
        "dialect": "sqlite",
        "queries": [
          "{\"method\":\"startsWith\",\"attribute\":\"name\",\"values\":[\"a_\"]}"
        ]
      },
      "expect": {
        "query": "SELECT * FROM `t` WHERE `name` LIKE ?",
        "bindings": [
          "a\\_%"
        ]
      }
    },
    {
      "name": "build MariaDB",
      "op": "builder.build",
      "args": {
        "dialect": "mariadb",
        "queries": [
          "{\"method\":\"notEqual\",\"attribute\":\"a\",\"values\":[1,2]}"
        ]
      },
      "expect": {
        "query": "SELECT * FROM `t` WHERE `a` NOT IN (?, ?)",
        "bindings": [
          1,
          2
        ]
      }
    },
    {
      "name": "build from parsed arrays",
      "op": "builder.queries",
      "args": {
        "dialect": "mysql",
        "queries": [
          {
            "method": "equal",
            "attribute": "a",
            "values": [
              1,
              "x",
              null
            ]
          },
          {
            "method": "groupBy",
            "values": [
              "b",
              2
            ]
          }
        ]
      }
    }
  ]
}
