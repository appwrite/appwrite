  "source": "packages/query/tests/Classifier/SQLTest.php",
  "cases": [
    {
      "name": "testClassifyLeadingWhitespace",
      "op": "classifier",
      "args": {
        "program": [
          {
            "new": "Classifier\\PostgreSQL",
            "args": []
          },
          {
            "call": "classifySQL",
            "on": {
              "$o": 1
            },
            "args": [
              "   \t\n  SELECT * FROM users"
            ]
          }
        ]
      },
      "expect": [
        {
          "$object": "Classifier\\PostgreSQL",
          "id": 1
        },
        {
          "$enum": "Type::Read"
        }
      ]
    },
