        {
          "$value": "Builder\\Statement",
          "id": 3,
          "props": {
            "query": "{\"collection\":\"users\",\"operation\":\"updateMany\",\"filter\":{\"_id\":\"?\"},\"update\":{\"$push\":{\"tags\":{\"$each\":[\"?\",\"?\",\"?\"]}}}}",
            "bindings": [
              "x",
              "a",
              "b",
              "c"
            ],
            "readOnly": false,
            "namedBindings": null
