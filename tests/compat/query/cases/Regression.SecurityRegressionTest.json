  "source": "packages/query/tests/Regression/SecurityRegressionTest.php",
  "cases": [
    {
      "name": "testAlterColumnTypeRejectsSemicolonInUsingExpression",
      "op": "query",
      "args": {
        "program": [
          {
            "new": "Schema\\PostgreSQL",
            "args": []
          },
          {
            "call": "alterColumnType",
            "on": {
              "$o": 1
            },
            "args": [
              "users",
              "age",
              "INTEGER",
              "age::integer; DROP TABLE users"
            ]
          }
        ]
      },
      "expect": [
        {
          "$object": "Schema\\PostgreSQL",
          "id": 1
        },
        {
          "$error": {
            "class": "Utopia\\Query\\Exception\\ValidationException",
            "message": "Invalid USING expression: age::integer; DROP TABLE users"
          },
          "id": 2
        }
      ]
    },
