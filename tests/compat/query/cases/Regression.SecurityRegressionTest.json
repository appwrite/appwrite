    {
      "name": "testQueryParseRejectsRawByDefault",
      "op": "query",
      "args": {
        "program": [
          {
            "get": "value",
            "on": {
              "$enum": "Method::Raw"
            }
          },
          {
            "static": "parseQuery",
            "class": "Query",
            "args": [
              {
                "method": "raw",
                "values": [
                  "SELECT * FROM users; DROP TABLE users"
                ]
              }
            ]
          }
        ]
      },
      "expect": [
        "raw",
        {
          "$error": {
            "class": "Utopia\\Query\\Exception\\ValidationException",
            "message": "Raw queries cannot be parsed from untrusted input; construct via Query::raw() in code"
          },
          "id": 1
        }
      ]
    },
    {
      "name": "testQueryParseAcceptsRawWhenAllowRawTrue",
      "op": "query",
      "args": {
        "program": [
          {
