              },
              "allowRaw": true
            }
          },
          {
            "call": "getMethod",
            "on": {
              "$o": 1
            },
            "args": []
          }
        ]
      },
      "expect": [
        "raw",
        {
          "$value": "Query",
          "id": 1,
          "props": {
            "method": {
              "$enum": "Method::Raw"
            },
            "attribute": "",
            "values": [
              "trusted_raw"
            ],
            "alias": "",
            "onArray": false,
            "attributeType": ""
          }
        },
        {
          "$enum": "Method::Raw"
        }
      ]
    },
    {
      "name": "testQueryParseRejectsRawNestedInsideOr",
      "op": "query",
      "args": {
        "program": [
          {
            "get": "value",
            "on": {
              "$enum": "Method::Or"
            }
          },
          {
            "get": "value",
            "on": {
              "$enum": "Method::Equal"
            }
          },
          {
            "get": "value",
            "on": {
              "$enum": "Method::Raw"
            }
          },
          {
            "static": "parseQuery",
            "class": "Query",
            "args": [
              {
                "method": "or",
                "values": [
                  {
                    "method": "equal",
                    "attribute": "a",
                    "values": [
                      1
                    ]
                  },
                  {
                    "method": "raw",
                    "values": [
                      "DROP TABLE users"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expect": [
        "or",
        "equal",
        "raw",
        {
          "$error": {
            "class": "Utopia\\Query\\Exception\\ValidationException",
            "message": "Raw queries cannot be parsed from untrusted input; construct via Query::raw() in code"
          },
          "id": 1
        }
      ]
    },
