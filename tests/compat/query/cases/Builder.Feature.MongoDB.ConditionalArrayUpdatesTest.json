{
  "source": "packages/query/tests/Builder/Feature/MongoDB/ConditionalArrayUpdatesTest.php",
  "cases": [
    {
      "name": "testArrayFilterRegistersSingleFilterUnderArrayFiltersOption",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\MongoDB",
            "args": []
          },
          {
            "call": "from",
            "on": {
              "$o": 1
            },
            "args": [
              "students"
            ]
          },
          {
            "call": "set",
            "on": {
              "$o": 1
            },
            "args": [
              {
                "grades.$[elem].mean": 0
              }
            ]
          },
          {
            "call": "arrayFilter",
            "on": {
              "$o": 1
            },
            "args": [
              "elem",
              {
                "elem.grade": {
                  "$gte": 85
                }
              }
            ]
          },
          {
            "static": "equal",
            "class": "Query",
            "args": [
              "_id",
              [
                "abc"
              ]
            ]
          },
          {
            "call": "filter",
            "on": {
              "$o": 1
            },
            "args": [
              [
                {
                  "$o": 2
                }
              ]
            ]
          },
          {
            "call": "update",
            "on": {
              "$o": 1
            },
            "args": []
          },
          {
            "get": "query",
            "on": {
              "$o": 3
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 3
            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 3
            }
          },
          {
            "get": "query",
            "on": {
              "$o": 3
            }
          },
          {
            "get": "query",
            "on": {
              "$o": 3
            }
          }
        ]
      },
      "expect": [
        {
          "$object": "Builder\\MongoDB",
          "id": 1
        },
        {
          "$object": "Builder\\MongoDB",
          "id": 1
        },
        {
          "$object": "Builder\\MongoDB",
          "id": 1
        },
        {
          "$object": "Builder\\MongoDB",
          "id": 1
        },
        {
          "$value": "Query",
          "id": 2,
          "props": {
            "method": {
              "$enum": "Method::Equal"
            },
            "attribute": "_id",
            "values": [
              "abc"
            ],
            "alias": "",
            "onArray": false,
            "attributeType": ""
          }
        },
        {
          "$object": "Builder\\MongoDB",
          "id": 1
        },
        {
          "$value": "Builder\\Statement",
          "id": 3,
          "props": {
            "query": "{\"collection\":\"students\",\"operation\":\"updateMany\",\"filter\":{\"_id\":\"?\"},\"update\":{\"$set\":{\"grades.$[elem].mean\":\"?\"}},\"options\":{\"arrayFilters\":[{\"elem.grade\":{\"$gte\":85}}]}}",
            "bindings": [
              "abc",
              0
            ],
            "readOnly": false,
            "namedBindings": null
          }
        },
        "{\"collection\":\"students\",\"operation\":\"updateMany\",\"filter\":{\"_id\":\"?\"},\"update\":{\"$set\":{\"grades.$[elem].mean\":\"?\"}},\"options\":{\"arrayFilters\":[{\"elem.grade\":{\"$gte\":85}}]}}",
        [
          "abc",
          0
        ],
        [
          "abc",
          0
        ],
        "{\"collection\":\"students\",\"operation\":\"updateMany\",\"filter\":{\"_id\":\"?\"},\"update\":{\"$set\":{\"grades.$[elem].mean\":\"?\"}},\"options\":{\"arrayFilters\":[{\"elem.grade\":{\"$gte\":85}}]}}",
        "{\"collection\":\"students\",\"operation\":\"updateMany\",\"filter\":{\"_id\":\"?\"},\"update\":{\"$set\":{\"grades.$[elem].mean\":\"?\"}},\"options\":{\"arrayFilters\":[{\"elem.grade\":{\"$gte\":85}}]}}"
      ]
