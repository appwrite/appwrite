            }
          },
          {
            "get": "bindings",
            "on": {
              "$o": 3
            }
          },
          {
            "get": "namedBindings",
            "on": {
              "$o": 3
            }
          }
        ]
      },
      "expect": [
        {
          "$object": "Builder\\ClickHouse",
          "id": 1
        },
        {
          "$object": "Builder\\ClickHouse",
          "id": 1
        },
        {
          "$value": "Query",
          "id": 2,
          "props": {
            "method": {
              "$enum": "Method::Equal"
            },
            "attribute": "tenant",
            "values": [
              "acme"
            ],
            "alias": "",
            "onArray": false,
            "attributeType": ""
          }
        },
        {
          "$object": "Builder\\ClickHouse",
          "id": 1
        },
        {
          "$value": "Builder\\Statement",
          "id": 3,
          "props": {
            "query": "SELECT * FROM `events` WHERE `tenant` IN (?)",
            "bindings": [
