            "on": {
              "$o": 1
            },
            "args": [
              [
                {
                  "$o": 2
                }
              ]
            ]
          },
          {
            "call": "build",
            "on": {
              "$o": 1
            },
            "args": []
          },
          {
            "get": "query",
