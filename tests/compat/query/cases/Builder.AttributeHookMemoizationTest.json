                },
                {
                  "$o": 4
                },
                {
                  "$o": 5
                },
                {
                  "$o": 6
                }
              ]
            ]
          },
          {
            "call": "build",
            "on": {
              "$o": 1
            },
            "args": [],
            "cb": [
              {
                "impl": 1,
                "m": "resolve",
                "ret": "id"
              },
              {
                "impl": 1,
                "m": "resolve",
                "ret": "name"
              },
              {
                "impl": 1,
                "m": "resolve",
                "ret": "age"
