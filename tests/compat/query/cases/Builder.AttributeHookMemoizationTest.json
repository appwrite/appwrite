            "attribute": "age",
            "values": [],
            "alias": "",
            "onArray": false,
            "attributeType": ""
          }
        },
        {
          "$object": "Builder\\MySQL",
          "id": 1
        },
        {
          "$cb": "impl:1:resolve",
          "args": [
