{
  "source": "packages/query/tests/Builder/SpatialDistanceFilterTest.php",
  "cases": [
    {
      "name": "testConstructsFromStringGeometry",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\SpatialDistanceFilter",
            "args": [
              "POINT(1 2)",
              10.5,
              true
            ]
          },
          {
            "get": "geometry",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "distance",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "meters",
            "on": {
              "$o": 1
            }
          }
        ]
      },
      "expect": [
        {
          "$value": "Builder\\SpatialDistanceFilter",
          "id": 1,
          "props": {
            "geometry": "POINT(1 2)",
            "distance": 10.5,
            "meters": true
          }
        },
        "POINT(1 2)",
        10.5,
        true
      ]
    },
    {
      "name": "testConstructsFromArrayGeometry",
      "op": "builder",
      "args": {
        "program": [
          {
            "new": "Builder\\SpatialDistanceFilter",
            "args": [
              [
                1.0,
                2.0
              ],
              42.0,
              false
            ]
          },
          {
            "get": "geometry",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "distance",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "meters",
            "on": {
              "$o": 1
            }
          }
        ]
      },
      "expect": [
        {
          "$value": "Builder\\SpatialDistanceFilter",
          "id": 1,
          "props": {
            "geometry": [
              1.0,
              2.0
            ],
            "distance": 42.0,
            "meters": false
          }
        },
        [
          1.0,
          2.0
        ],
        42.0,
        false
      ]
    },
    {
      "name": "testFromTupleNormalizesArrayGeometry",
      "op": "builder",
