                100.0,
                true
              ]
            ]
          },
          {
            "get": "geometry",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "distance",
            "on": {
              "$o": 1
            }
          },
          {
            "get": "meters",
            "on": {
              "$o": 1
            }
          }
        ]
      },
      "expect": [
        {
          "$value": "Builder\\SpatialDistanceFilter",
          "id": 1,
          "props": {
            "geometry": [
              10,
              20
            ],
            "distance": 100.0,
            "meters": true
          }
        },
        [
          10,
          20
        ],
        100.0,
        true
      ]
    },
    {
      "name": "testFromTupleCastsIntegerDistanceToFloat",
      "op": "builder",
      "args": {
