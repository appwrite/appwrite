        },
        50.0,
        false
      ]
    },
    {
      "name": "testFromTupleRejectsMalformedTuples with data set \"empty\"",
      "op": "builder",
      "args": {
        "program": [
          {
            "static": "fromTuple",
            "class": "Builder\\SpatialDistanceFilter",
            "args": [
              []
            ]
          },
          {
            "call": "getMessage",
            "on": {
              "$o": 1
            },
            "args": []
          }
        ]
      },
      "expect": [
        {
          "$error": {
            "class": "Utopia\\Query\\Exception\\ValidationException",
            "message": "Invalid distance query: the geometry must be a WKT string or a coordinate array"
          },
          "id": 1
        },
        "Invalid distance query: the geometry must be a WKT string or a coordinate array"
      ]
    },
