{
  "source": "packages/auth/tests/Algorithms/ScryptTest.php",
  "cases": [
    {
      "name": "hash",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "scrypt"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123"
          },
          "bind": "out",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted hash: verified by both runtimes below"
          },
          "expect": "<masked>"
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": true
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "wrongpassword",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "default salt is generated",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "scrypt"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.get_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "salt"
          },
          "bind": "salt",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "random salt"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.matches",
          "args": {
            "pattern": "/^[0-9a-f]{32}$/",
            "value": {
              "$ref": "salt"
            }
          },
          "expect": 1
        },
        {
          "op": "hash.new",
          "args": {
            "algo": "scrypt"
          },
          "bind": "h2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.get_option",
          "args": {
            "hash": {
              "$ref": "h2"
            },
            "key": "salt"
          },
          "bind": "salt2",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "random salt"
          },
          "expect": "<masked>"
        },
        {
          "op": "$equal",
          "args": {
            "a": {
              "$ref": "salt"
            },
            "b": {
              "$ref": "salt2"
            }
          },
          "expect": false
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "h"
            }
          },
          "mask": {
            "paths": [
              "/salt"
            ],
            "reason": "random salt"
          },
          "expect": {
            "type": "scrypt",
            "costCpu": 8,
            "costMemory": 14,
            "costParallel": 1,
            "length": 64,
            "salt": "<masked>"
          }
        }
      ]
    },
