    {
      "name": "setter validation",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "scrypt"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setCpuCost",
            "value": 1
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "CPU cost must be > 1 and a power of 2"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setCpuCost",
            "value": 3
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "CPU cost must be > 1 and a power of 2"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setCpuCost",
            "value": 0
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "CPU cost must be > 1 and a power of 2"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setCpuCost",
            "value": -8
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "CPU cost must be > 1 and a power of 2"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setMemoryCost",
            "value": 0
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Memory cost must be >= 1"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setParallelCost",
            "value": 0
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Parallel cost must be >= 1"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setLength",
            "value": 15
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Length must be >= 16 bytes"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setSalt",
            "value": ""
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Salt cannot be empty"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setSalt",
            "value": "0"
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Salt cannot be empty"
            }
          }
        }
      ]
    },
