    {
      "name": "verifies phpass and blowfish fixtures and rejects the rest",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "phpass"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "appwrite",
            "hash_value": "$P$Br387rwferoKN7uwHZqNMu98q3U8RO."
          },
          "expect": true
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "appwrite",
            "hash_value": "$H$Br387rwferoKN7uwHZqNMu98q3U8RO."
          },
          "expect": true
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": "$2a$04$abcdefghijklmnopqrstuuPp7HPfoAs8I2dCQCQ/fW7zEJv8I8C8e"
          },
          "expect": true
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": ""
          },
          "expect": false
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": "$P$"
          },
          "expect": false
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": "$P$Bshort"
          },
          "expect": false
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": "*0"
          },
          "expect": false
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": "*1"
          },
          "expect": false
        }
      ]
