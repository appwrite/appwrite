    {
      "name": "an iteration count blowfish rejects falls back to portable hashes",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "phpass"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "iteration_count_log2",
            "value": 3
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "bind": "out",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.substr",
          "args": {
            "value": {
              "$ref": "out"
            },
            "start": 0,
            "length": 4
          },
          "expect": "$P$6"
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": true
        }
      ]
    },
    {
      "name": "iteration counts from options are juggled",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "phpass"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "iteration_count_log2",
            "value": "9"
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "bind": "out",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.substr",
          "args": {
            "value": {
              "$ref": "out"
            },
            "start": 0,
            "length": 7
          },
          "expect": "$2a$09$"
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "iteration_count_log2",
            "value": "abc"
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Unsupported operand types: string / int"
            }
          }
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "iteration_count_log2",
            "value": [
              1
            ]
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Unsupported operand types: array / int"
            }
          }
        }
      ]
