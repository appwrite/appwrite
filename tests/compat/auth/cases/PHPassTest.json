    {
      "name": "portable hashes",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "phpass"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setPortableHashes",
            "value": true
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123"
          },
          "bind": "out",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.substr",
          "args": {
            "value": {
              "$ref": "out"
            },
            "start": 0,
            "length": 4
          },
          "expect": "$P$B"
        },
        {
          "op": "fixture.strlen",
          "args": {
            "value": {
              "$ref": "out"
            }
          },
          "expect": 34
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123",
            "hash_value": {
              "$ref": "out"
