{
  "source": "packages/auth/tests/Algorithms/PHPassTest.php",
  "cases": [
    {
      "name": "hash",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "phpass"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123"
          },
          "bind": "out",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted hash: verified by both runtimes below"
          },
          "expect": "<masked>"
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": true
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "wrongpassword",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": false
        },
        {
          "op": "fixture.substr",
          "args": {
            "value": {
              "$ref": "out"
            },
            "start": 0,
            "length": 7
          },
          "expect": "$2a$08$"
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "h"
            }
          },
          "mask": {
            "paths": [
              "/random_state"
            ],
            "reason": "microtime() and the process id"
          },
          "expect": {
            "type": "phpass",
            "iteration_count_log2": 8,
            "portable_hashes": false,
            "random_state": "<masked>"
          }
        }
      ]
    },
    {
      "name": "iteration count too low",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "phpass"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setIterationCount",
            "value": 3
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Iteration count must be between 4 and 31"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setIterationCount",
            "value": 32
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Iteration count must be between 4 and 31"
            }
          }
        }
      ]
    },
