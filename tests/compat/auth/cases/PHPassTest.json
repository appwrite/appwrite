          },
          "expect": true
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "wrong",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": false
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setPortableHashes",
            "value": false
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123"
          },
          "bind": "out2",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.substr",
          "args": {
            "value": {
              "$ref": "out2"
            },
            "start": 0,
            "length": 7
          },
