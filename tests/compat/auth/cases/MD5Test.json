{
  "source": "packages/auth/tests/Algorithms/MD5Test.php",
  "cases": [
    {
      "name": "hash",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "md5"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123"
          },
          "bind": "out",
          "expect": "cc03e747a6afbbcbf8be7668acfebee5"
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": true
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "wrongpassword",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": false
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "h"
            }
          },
          "expect": {
            "type": "md5"
          }
        }
      ]
    },
    {
      "name": "multiple hashes",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "md5"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123"
          },
          "expect": "cc03e747a6afbbcbf8be7668acfebee5"
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "password123"
          },
          "expect": "482c811da5d5b4bc6d497ffa98491e38"
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "!@#$%^&*()"
          },
          "expect": "05b28d17a7b6e7024b6e5d8cc43a8bf7"
        }
      ]
    },
    {
      "name": "empty string",
