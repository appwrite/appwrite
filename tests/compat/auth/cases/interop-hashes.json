    {
      "name": "stored hash options round trip between runtimes",
      "steps": [
        {
          "op": "hash.new",
          "side": "a",
          "args": {
            "algo": "scrypt"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.options",
          "side": "a",
          "args": {
            "hash": {
              "$ref": "a"
            }
          },
          "bind": "opts",
          "mask": {
            "paths": [
              "/salt"
            ],
            "reason": "random salt"
          },
          "expect": {
            "type": "scrypt",
            "costCpu": 8,
            "costMemory": 14,
            "costParallel": 1,
            "length": 64,
            "salt": "<masked>"
          }
        },
        {
          "op": "hash.hash",
          "side": "a",
          "args": {
            "hash": {
              "$ref": "a"
            },
            "value": "pw"
          },
          "bind": "out",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "random salt"
          },
          "expect": "<masked>"
        },
        {
          "op": "password.create_hash",
          "side": "b",
          "args": {
            "type": "scrypt",
            "options": {
              "$ref": "opts"
            }
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.verify",
          "side": "b",
          "args": {
            "hash": {
              "$ref": "b"
            },
            "value": "pw",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": true
        }
      ],
      "interop": true
    },
