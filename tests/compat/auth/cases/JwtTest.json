    {
      "name": "generated secrets are 64 hex characters",
      "steps": [
        {
          "op": "issuer.generate_secret",
          "bind": "s",
          "expect": "<masked>"
        },
        {
          "op": "fixture.matches",
          "args": {
            "pattern": "/^[a-f0-9]{64}$/",
            "value": {
              "$ref": "s"
            }
          },
          "expect": 1
        },
        {
          "op": "issuer.generate_secret",
          "args": {
            "bytes": 8
          },
          "bind": "s8",
          "expect": "<masked>"
        },
        {
          "op": "fixture.matches",
          "args": {
            "pattern": "/^[a-f0-9]{16}$/",
            "value": {
              "$ref": "s8"
            }
          },
          "expect": 1
        },
        {
          "op": "issuer.generate_secret",
          "bind": "s2",
          "expect": "<masked>"
        },
        {
          "op": "$equal",
          "args": {
            "a": {
              "$ref": "s"
            },
            "b": {
              "$ref": "s2"
            }
          },
          "expect": false
        }
      ]
    },
