{
  "source": "packages/auth/tests/Issuers/Symmetric/JwtTest.php",
  "cases": [
    {
      "name": "round trip preserves custom claims and protects registered claims (one recipient)",
      "steps": [
        {
          "op": "issuer.new",
          "args": {
            "kind": "jwt",
            "secret": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0",
            "issuer": "https://example.com"
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "issuer.issue",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "audience": "preview",
            "duration": 600,
            "now": 1700000000,
            "claims": {
              "purpose": "state",
              "iss": "https://wrong.example.com",
              "aud": "wrong",
              "iat": 0,
              "exp": 0
            }
          },
          "bind": "t",
          "expect": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJwdXJwb3NlIjoic3RhdGUiLCJpc3MiOiJodHRwczpcL1wvZXhhbXBsZS5jb20iLCJhdWQiOiJwcmV2aWV3IiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjE3MDAwMDA2MDB9.9Qg1vFm7yPg6Zy8jvrCAjt20FDPWyJvI-eZwEDFCo14"
        },
        {
          "op": "verifier.new",
          "args": {
            "kind": "symmetric",
            "secret": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0",
            "issuer": "https://example.com",
            "audience": "preview",
            "type": "JWT"
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "verifier.verify",
          "args": {
            "verifier": {
              "$ref": "v"
            },
            "token": {
              "$ref": "t"
            },
            "now": 1700000010
          },
          "expect": {
            "purpose": "state",
            "iss": "https://example.com",
            "aud": "preview",
            "iat": 1700000000,
            "exp": 1700000600
          }
        },
        {
          "op": "fixture.jwt",
          "args": {
            "token": {
              "$ref": "t"
            }
          },
          "expect": {
            "header": {
              "typ": "JWT",
              "alg": "HS256"
            },
            "claims": {
              "purpose": "state",
              "iss": "https://example.com",
              "aud": "preview",
              "iat": 1700000000,
              "exp": 1700000600
            }
          }
        }
      ]
    },
