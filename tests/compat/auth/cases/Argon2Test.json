{
  "source": "packages/auth/tests/Algorithms/Argon2Test.php",
  "cases": [
    {
      "name": "hash and verify with the defaults",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "argon2"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123"
          },
          "bind": "out",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted hash: verified by both runtimes below"
          },
          "expect": "<masked>"
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "test123",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": true
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "wrongpassword",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": false
        },
        {
          "op": "fixture.substr",
          "args": {
            "value": {
              "$ref": "out"
            },
            "start": 0,
            "length": 31
          },
          "expect": "$argon2id$v=19$m=65536,t=4,p=3$"
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "h"
            }
          },
          "expect": {
            "type": "argon2",
            "memory_cost": 65536,
            "time_cost": 4,
            "threads": 3
          }
        }
      ]
    },
