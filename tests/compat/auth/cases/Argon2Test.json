    {
      "name": "option values are cast like password_hash does",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "argon2"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.set_options",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "options": {
              "memory_cost": "1024",
              "time_cost": "1x",
              "threads": true
            }
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "bind": "out",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.substr",
          "args": {
            "value": {
              "$ref": "out"
            },
            "start": 0,
            "length": 29
          },
          "expect": "$argon2id$v=19$m=1024,t=1,p=1"
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": {
              "$ref": "out"
            }
          },
          "expect": true
        }
      ]
