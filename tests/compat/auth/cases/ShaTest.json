    {
      "name": "invalid version",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "sha"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setVersion",
            "value": "invalid-version"
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Invalid SHA version. Valid versions are: sha1, sha224, sha256, sha384, sha512, sha3-224, sha3-256, sha3-384, sha3-512"
            }
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "method": "setVersion",
            "value": "SHA256"
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Invalid SHA version. Valid versions are: sha1, sha224, sha256, sha384, sha512, sha3-224, sha3-256, sha3-384, sha3-512"
            }
          }
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "h"
            }
          },
          "expect": {
            "version": "sha256"
          }
        }
      ]
    },
    {
      "name": "the version option goes to hash()",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "sha"
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "version",
            "value": "md5"
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "expect": "9dd4e461268c8034f5c8564e155c67a6"
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "version",
            "value": "SHA512/256"
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "expect": "6a1db6c1dd481f7aab2adb9c262b210edcca35624ec64c29ffca6857b1e30253"
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "version",
            "value": 5
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "expect": {
            "$error": {
              "class": "RuntimeException",
              "message": "SHA version must be a string"
            }
          }
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "version",
            "value": "zz"
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "expect": {
            "$error": {
              "class": "ValueError",
              "message": "hash(): Argument #1 ($algo) must be a valid hashing algorithm"
            }
          }
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x",
            "hash_value": "x"
          },
          "expect": {
            "$error": {
              "class": "ValueError",
              "message": "hash(): Argument #1 ($algo) must be a valid hashing algorithm"
            }
          }
        },
        {
          "op": "hash.set_option",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "key": "version",
            "value": null
          },
          "expect": null
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "h"
            },
            "value": "x"
          },
          "expect": {
            "$error": {
              "class": "RuntimeException",
              "message": "SHA version must be a string"
            }
          }
        }
      ]
