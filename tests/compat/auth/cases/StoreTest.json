{
  "source": "packages/auth/tests/StoreTest.php",
  "cases": [
    {
      "name": "get and set property",
      "steps": [
        {
          "op": "store.new",
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "name",
            "value": "John Doe"
          },
          "expect": null
        },
        {
          "op": "store.get_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "name"
          },
          "expect": "John Doe"
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "age",
            "value": 30
          },
          "expect": null
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "active",
            "value": true
          },
          "expect": null
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "scores",
            "value": [
              95,
              87,
              92
            ]
          },
          "expect": null
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "details",
            "value": {
              "city": "New York",
              "country": "USA"
            }
          },
          "expect": null
        },
        {
          "op": "store.get_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "age"
          },
          "expect": 30
        },
        {
          "op": "store.get_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "active"
          },
          "expect": true
        },
        {
          "op": "store.get_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "scores"
          },
          "expect": [
            95,
            87,
            92
          ]
        },
        {
          "op": "store.get_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "details"
          },
          "expect": {
            "city": "New York",
            "country": "USA"
          }
        },
        {
          "op": "store.get_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "nonexistent"
          },
          "expect": null
        },
        {
          "op": "store.get_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "nonexistent",
            "default": "default"
          },
          "expect": "default"
        }
      ]
    },
    {
      "name": "get and set key",
      "steps": [
        {
          "op": "store.new",
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.get_key",
          "args": {
            "store": {
              "$ref": "s"
            }
          },
          "expect": null
        },
        {
          "op": "store.set_key",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "test-key"
          },
          "expect": null
        },
        {
          "op": "store.get_key",
          "args": {
            "store": {
              "$ref": "s"
            }
          },
          "expect": "test-key"
        },
        {
          "op": "store.set_key",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": null
          },
          "expect": null
        },
        {
          "op": "store.get_key",
          "args": {
            "store": {
              "$ref": "s"
            }
          },
          "expect": null
        },
        {
          "op": "store.set_key",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "new-key"
          },
          "expect": null
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "test",
            "value": "value"
          },
          "expect": null
        },
        {
          "op": "store.get_key",
          "args": {
            "store": {
              "$ref": "s"
            }
          },
          "expect": "new-key"
        },
        {
          "op": "store.get_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "test"
          },
          "expect": "value"
        }
      ]
    },
    {
      "name": "encode and decode",
      "steps": [
        {
          "op": "store.new",
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "name",
            "value": "John Doe"
          },
          "expect": null
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "age",
            "value": 30
          },
          "expect": null
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "active",
            "value": true
          },
          "expect": null
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "scores",
            "value": [
              95,
              87,
              92
            ]
          },
          "expect": null
        },
        {
          "op": "store.set_property",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "details",
            "value": {
              "city": "New York",
              "country": "USA"
            }
          },
          "expect": null
        },
        {
          "op": "store.set_key",
          "args": {
            "store": {
              "$ref": "s"
            },
            "key": "test-key"
          },
          "expect": null
