{
  "source": "interop",
  "cases": [
    {
      "name": "an HS256 token issued by one runtime verifies in the other",
      "steps": [
        {
          "op": "issuer.new",
          "side": "a",
          "args": {
            "kind": "refresh",
            "secret": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0",
            "issuer": "https://example.com/v1/oauth2/test",
            "key_id": "k1"
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "issuer.issue",
          "side": "a",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "subject": "u",
            "audience": "aud",
            "client_id": "c",
            "duration": 60,
            "scopes": [
              "a",
              "b"
            ],
            "now": 1700000000,
            "claims": {
              "x": "ü/€",
              "n": [
                1,
                2.5
              ]
            }
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "random jti"
          },
          "expect": "<masked>"
        },
        {
          "op": "verifier.new",
          "side": "b",
          "args": {
            "kind": "symmetric",
            "secret": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0",
            "issuer": "https://example.com/v1/oauth2/test",
            "audience": "aud",
            "type": "JWT"
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "verifier.verify",
          "side": "b",
          "args": {
            "verifier": {
              "$ref": "v"
            },
            "token": {
              "$ref": "t"
            },
            "now": 1700000001
          },
          "mask": {
            "paths": [
              "/jti"
            ],
            "reason": "random jti"
          },
          "expect": {
            "x": "ü/€",
            "n": [
              1,
              2.5
            ],
            "iss": "https://example.com/v1/oauth2/test",
            "aud": "aud",
            "sub": "u",
            "client_id": "c",
            "exp": 1700000060,
            "iat": 1700000000,
            "jti": "<masked>",
            "scope": "a b"
          }
        }
      ],
      "interop": true
    },
