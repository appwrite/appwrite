    {
      "name": "a key pair generated by one runtime signs and verifies in the other",
      "steps": [
        {
          "op": "issuer.generate_key_pair",
          "side": "a",
          "bind": "k",
          "expect": {
            "private": "<masked>",
            "public": "<masked>"
          }
        },
        {
          "op": "issuer.new",
          "side": "b",
          "args": {
            "kind": "id",
            "private_key": {
              "$ref": "k",
              "path": "/private"
            },
            "public_key": {
              "$ref": "k",
              "path": "/public"
            },
            "issuer": "https://example.com/v1/oauth2/test"
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "issuer.issue",
          "side": "b",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "subject": "u",
            "audience": "client",
            "auth_time": 5,
            "duration": 60,
            "now": 1700000000,
            "nonce": "n"
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "fresh key"
          },
          "expect": "<masked>"
        },
        {
          "op": "issuer.key_id",
          "side": "b",
          "args": {
            "issuer": {
              "$ref": "i"
            }
          },
          "bind": "kid",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "fresh key"
          },
          "expect": "<masked>"
        },
        {
          "op": "verifier.new",
          "side": "a",
          "args": {
            "kind": "asymmetric",
            "public_key": {
              "$ref": "k",
              "path": "/public"
            },
            "type": "JWT"
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "verifier.verify",
          "side": "a",
          "args": {
            "verifier": {
              "$ref": "v"
            },
            "token": {
              "$ref": "t"
            },
            "now": 1700000000
          },
          "expect": {
            "iss": "https://example.com/v1/oauth2/test",
            "sub": "u",
            "aud": "client",
            "exp": 1700000060,
            "iat": 1700000000,
            "auth_time": 5,
            "nonce": "n"
          }
        },
        {
          "op": "verifier.key_id",
          "side": "a",
          "args": {
            "verifier": {
              "$ref": "v"
            }
          },
          "bind": "vkid",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "fresh key"
          },
          "expect": "<masked>"
        },
        {
          "op": "$equal",
          "side": "a",
          "args": {
            "a": {
              "$ref": "kid"
            },
            "b": {
              "$ref": "vkid"
            }
          },
          "expect": true
        }
      ],
      "interop": true
    }
  ]
