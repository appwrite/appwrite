          "expect": {
            "clientId": "https://client.example/metadata",
            "tokenEndpointAuthMethod": "private_key_jwt",
            "grantTypes": [
              "authorization_code"
            ],
            "responseTypes": [
              "code"
            ],
            "redirectUris": [],
            "metadata": {
              "client_id": "https://client.example/metadata",
              "token_endpoint_auth_method": "private_key_jwt",
              "jwks": {
                "keys": [
                  {
                    "kty": "RSA",
                    "n": "public-modulus",
                    "e": "AQAB"
                  }
                ]
              }
            }
          }
        }
      ]
