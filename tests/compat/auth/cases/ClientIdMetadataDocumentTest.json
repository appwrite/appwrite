    {
      "name": "rejects invalid JSON (malformed)",
      "steps": [
        {
          "op": "client_metadata.from_json",
          "args": {
            "client_id": "https://client.example/metadata",
            "json": "{"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Auth\\OAuth2\\InvalidClientMetadataException",
              "message": "Client ID Metadata Document is not valid JSON."
            }
          }
        }
      ]
    },
