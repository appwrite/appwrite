          "expect": null
        },
        {
          "op": "proof.generate",
          "args": {
            "proof": {
              "$ref": "p"
            }
          },
          "bind": "g",
          "expect": "<masked>"
        },
        {
          "op": "fixture.strlen",
          "args": {
            "value": {
              "$ref": "g"
            }
          },
          "expect": 20
        }
      ]
    },
