{
  "source": "packages/auth/tests/Proofs/PasswordTest.php",
  "cases": [
    {
      "name": "generate",
      "steps": [
        {
          "op": "proof.new",
          "args": {
            "kind": "password"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "proof.generate",
          "args": {
            "proof": {
              "$ref": "p"
            }
          },
          "bind": "g",
          "expect": "<masked>"
        },
        {
          "op": "fixture.matches",
          "args": {
            "pattern": "/^[a-zA-Z0-9!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?]{16}$/",
            "value": {
              "$ref": "g"
            }
          },
          "expect": 1
        }
      ]
    },
    {
      "name": "custom length",
      "steps": [
        {
          "op": "proof.new",
          "args": {
            "kind": "password"
          },
          "bind": "p",
