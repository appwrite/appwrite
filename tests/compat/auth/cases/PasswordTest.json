    {
      "name": "create hash",
      "steps": [
        {
          "op": "password.create_hash",
          "args": {
            "type": "argon2"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.name",
          "args": {
            "hash": {
              "$ref": "a"
            }
          },
          "expect": "argon2"
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "a"
            }
          },
          "expect": {
            "type": "argon2",
            "memory_cost": 65536,
            "time_cost": 4,
            "threads": 3
          }
        },
        {
          "op": "password.create_hash",
          "args": {
            "type": "bcrypt"
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.name",
          "args": {
            "hash": {
              "$ref": "b"
            }
          },
          "expect": "bcrypt"
        },
        {
          "op": "password.create_hash",
          "args": {
            "type": "bcrypt",
            "options": {
              "cost": 8
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "c"
            }
          },
          "expect": {
            "type": "bcrypt",
            "cost": 8
          }
        },
        {
          "op": "password.create_hash",
          "args": {
            "type": "scrypt",
            "options": {
              "cpu_cost": 8192,
              "memory_cost": 4,
              "parallel_cost": 1,
              "key_length": 32
            }
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "s"
            }
          },
          "mask": {
            "paths": [
              "/salt"
            ],
            "reason": "random default salt"
          },
          "expect": {
            "type": "scrypt",
            "costCpu": 8,
            "costMemory": 14,
            "costParallel": 1,
            "length": 64,
            "salt": "<masked>",
            "cpu_cost": 8192,
            "memory_cost": 4,
            "parallel_cost": 1,
            "key_length": 32
          }
        },
        {
          "op": "password.create_hash",
          "args": {
            "type": "invalid-hash"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Unsupported hash type: invalid-hash"
            }
          }
        }
      ]
    },
    {
      "name": "create hash keeps unknown options",
      "steps": [
        {
          "op": "password.create_hash",
          "args": {
            "type": "bcrypt",
            "options": {
              "invalid_option": "value"
            }
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "b"
            }
          },
          "expect": {
            "type": "bcrypt",
            "cost": 8,
            "invalid_option": "value"
          }
        }
      ]
    },
    {
      "name": "create hash from stored options",
      "steps": [
        {
          "op": "password.create_hash",
          "args": {
            "type": "scrypt",
            "options": {
              "type": "scrypt",
              "costCpu": 16384,
              "costMemory": 13,
              "costParallel": 2,
              "length": 64,
              "salt": "appwrite"
            }
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "s"
            },
            "value": "appwrite",
            "hash_value": "3fdef49701bc4cfaacd551fe017283513284b4731e6945c263246ef948d3cf63b5d269c31fd697246085111a428245e24a4ddc6b64c687bc60a8910dbafc1d5b"
          },
          "expect": true
        },
        {
          "op": "password.create_hash",
          "args": {
            "type": "sha",
            "options": {
              "version": "sha512"
            }
          },
          "bind": "sha",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.hash",
          "args": {
            "hash": {
              "$ref": "sha"
            },
            "value": "appwrite"
          },
          "expect": "4243da0a694e8a2f727c8060fe0507c8fa01ca68146c76d2c190805b638c20c6bf6ba04e21f11ae138785d0bff63c416e6f87badbffad37f6dee50094cc38c70"
        },
        {
          "op": "password.create_hash",
          "args": {
            "type": "md5",
            "options": {
              "0": "x"
            }
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "Utopia\\Auth\\Hash::setOption(): Argument #1 ($key) must be of type string, int given, called in /usr/src/code/packages/auth/src/Hash.php on line 35"
            }
          }
        },
        {
          "op": "password.create_hash",
          "args": {
            "type": "phpass",
            "options": {
              "type": "phpass",
              "iteration_count_log2": 8,
              "portable_hashes": false,
              "random_state": "x"
            }
          },
          "bind": "ph",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.verify",
          "args": {
            "hash": {
              "$ref": "ph"
            },
            "value": "appwrite",
            "hash_value": "$P$Br387rwferoKN7uwHZqNMu98q3U8RO."
          },
          "expect": true
        },
        {
          "op": "hash.options",
          "args": {
            "hash": {
              "$ref": "ph"
            }
          },
          "expect": {
            "type": "phpass",
            "iteration_count_log2": 8,
            "portable_hashes": false,
            "random_state": "x"
          }
        }
      ]
    },
    {
      "name": "the active hash comes from the registry",
      "steps": [
        {
          "op": "hash.new",
          "args": {
            "algo": "bcrypt"
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "proof.new",
          "args": {
            "kind": "password",
            "hashes": {
              "bcrypt": {
                "$ref": "b"
              }
            }
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "proof.hash_name",
          "args": {
            "proof": {
              "$ref": "p"
            }
          },
          "expect": "bcrypt"
        },
        {
          "op": "password.remove_hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "bcrypt"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Cannot remove current hash"
            }
          }
        },
        {
          "op": "password.hash_by_name",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "argon2"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Hash 'argon2' not found"
            }
          }
        }
      ]
    },
    {
      "name": "removing the default active hash is guarded",
      "steps": [
        {
          "op": "proof.new",
          "args": {
            "kind": "password"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "password.remove_hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "argon2"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Cannot remove current hash"
            }
          }
        }
      ]
    },
    {
      "name": "an unregistered hash in use",
      "steps": [
        {
          "op": "proof.new",
          "args": {
            "kind": "password"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.new",
          "args": {
            "algo": "md5"
          },
          "bind": "m",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "proof.set_hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "hash": {
              "$ref": "m"
            }
          },
          "expect": null
        },
        {
          "op": "proof.hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "value": "x"
          },
          "expect": "9dd4e461268c8034f5c8564e155c67a6"
        },
        {
          "op": "password.remove_hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "argon2"
          },
          "expect": null
        },
        {
          "op": "password.hash_by_name",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "argon2"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Hash 'argon2' not found"
            }
          }
        }
      ]
    }
  ]
}
