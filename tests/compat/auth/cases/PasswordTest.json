    {
      "name": "hash with argon2 by default",
      "steps": [
        {
          "op": "proof.new",
          "args": {
            "kind": "password"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "proof.hash_name",
          "args": {
            "proof": {
              "$ref": "p"
            }
          },
          "expect": "argon2"
        },
        {
          "op": "proof.hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "value": "pass"
          },
          "bind": "h",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.substr",
          "args": {
            "value": {
              "$ref": "h"
            },
            "start": 0,
            "length": 10
          },
          "expect": "$argon2id$"
        },
        {
          "op": "proof.verify",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "value": "pass",
            "hash_value": {
              "$ref": "h"
            }
          },
          "expect": true
        },
        {
          "op": "proof.verify",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "value": "wrongpassword",
            "hash_value": {
              "$ref": "h"
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "add hash",
      "steps": [
        {
          "op": "proof.new",
          "args": {
            "kind": "password"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.new",
          "args": {
            "algo": "bcrypt"
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "hash.setter",
          "args": {
            "hash": {
              "$ref": "b"
            },
            "method": "setCost",
            "value": 8
          },
          "expect": null
        },
        {
          "op": "password.add_hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "bcrypt-8",
            "hash": {
              "$ref": "b"
            }
          },
          "expect": null
        },
        {
          "op": "password.hash_by_name",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "bcrypt-8"
          },
          "expect": "bcrypt"
        },
        {
          "op": "password.use_hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "bcrypt-8"
          },
          "expect": null
        },
        {
          "op": "proof.hash_name",
          "args": {
            "proof": {
              "$ref": "p"
            }
          },
          "expect": "bcrypt"
        },
        {
          "op": "proof.hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "value": "pw"
          },
          "bind": "h",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "salted"
          },
          "expect": "<masked>"
        },
        {
          "op": "proof.verify",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "value": "pw",
            "hash_value": {
              "$ref": "h"
            }
          },
          "expect": true
        },
        {
          "op": "proof.verify",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "value": "wrongpassword",
            "hash_value": {
              "$ref": "h"
            }
          },
          "expect": false
        },
        {
          "op": "password.remove_hash",
          "args": {
            "proof": {
              "$ref": "p"
            },
            "name": "bcrypt-8"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Cannot remove current hash"
            }
          }
        }
      ]
    },
