{
  "source": "packages/auth/tests/Issuers/Symmetric/RefreshTokenTest.php",
  "cases": [
    {
      "name": "header uses HS256 and no kid by default",
      "steps": [
        {
          "op": "issuer.new",
          "args": {
            "kind": "refresh",
            "secret": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0",
            "issuer": "https://example.com/v1/oauth2/test"
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "issuer.issue",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "subject": "user-123",
            "audience": "https://example.com/token",
            "client_id": "client-abc",
            "duration": 1209600,
            "now": 1700000000
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "the jti is random"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.jwt",
          "args": {
            "token": {
              "$ref": "t"
            }
          },
          "mask": {
            "paths": [
              "/claims/jti"
            ],
            "reason": "random jti"
          },
          "expect": {
            "header": {
              "typ": "JWT",
              "alg": "HS256"
            },
            "claims": {
              "iss": "https://example.com/v1/oauth2/test",
              "aud": "https://example.com/token",
              "sub": "user-123",
              "client_id": "client-abc",
              "exp": 1701209600,
              "iat": 1700000000,
              "jti": "<masked>"
            }
          }
        }
      ]
    },
    {
      "name": "claims",
      "steps": [
        {
          "op": "issuer.new",
          "args": {
            "kind": "refresh",
            "secret": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0",
            "issuer": "https://example.com/v1/oauth2/test"
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "issuer.issue",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "subject": "user-123",
            "audience": "https://example.com/token",
            "client_id": "client-abc",
            "duration": 1209600,
            "now": 1700000000,
            "scopes": [
              "read",
              "offline_access"
            ]
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "the jti is random"
          },
          "expect": "<masked>"
        },
        {
          "op": "fixture.jwt",
          "args": {
            "token": {
              "$ref": "t"
            }
          },
          "bind": "d",
          "mask": {
            "paths": [
              "/claims/jti"
            ],
            "reason": "random jti"
          },
          "expect": {
            "header": {
              "typ": "JWT",
              "alg": "HS256"
            },
            "claims": {
              "iss": "https://example.com/v1/oauth2/test",
              "aud": "https://example.com/token",
              "sub": "user-123",
              "client_id": "client-abc",
              "exp": 1701209600,
              "iat": 1700000000,
              "jti": "<masked>",
              "scope": "read offline_access"
            }
          }
        },
        {
          "op": "fixture.matches",
          "args": {
            "pattern": "/^[a-f0-9]{32}$/",
            "value": {
              "$ref": "d",
              "path": "/claims/jti"
            }
          },
          "expect": 1
        }
      ]
    },
