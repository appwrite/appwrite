    {
      "name": "testSwooleTimesOutStalledSends",
      "op": "e2e.run",
      "args": {
        "send_timeout": 1.0,
        "steps": [
          {
            "slow": "s"
          },
          {
            "connect": "h"
          },
          {
            "batch": "s",
            "count": 300,
            "size": 65536
          },
          {
            "wait_batches": 1
          },
          {
            "probe": "s"
          },
          {
            "send": "h",
            "data": "ping"
          },
          {
            "receive": "h"
          },
          {
            "http": "/info"
          }
        ]
      },
      "expect": [
        true,
        null,
        null,
        true,
        "disconnected",
        null,
        "pong",
        {
          "status": 200,
          "body": "{\"connections\":1,\"batches_sent\":1}"
        }
      ]
    },
