    {
      "name": "listen answers pings and reports pongs; binary and other opcodes are ignored",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "url": "ws://localhost:8080"
          },
          "bind": "c",
          "expect": {
            "client": {
              "$handle": "*"
            },
            "host": "localhost",
            "port": 8080,
            "path": "/",
            "headers": [],
            "timeout": 30.0
          }
        },
        {
          "op": "client.hooks",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            }
          },
          "expect": [
            true,
            true,
            true,
            true,
            true,
            true
          ]
        },
        {
          "op": "client.attach",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            },
            "script": [
              {
                "opcode": 9,
                "data": "are you there"
              },
              {
                "opcode": 10,
                "data": "pong data"
              },
              {
                "opcode": 2,
                "data": "bin"
              },
              {
                "opcode": 0,
                "data": "cont"
              },
              {},
              {
                "code": 110,
                "message": "Connection timed out"
              },
              {
                "opcode": 1,
                "data": "after"
              },
              {
                "opcode": 8,
                "data": ""
              },
              {
                "opcode": 1,
                "data": "never read"
              }
            ]
          },
          "expect": null
        },
        {
          "op": "client.listen",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            }
          },
          "expect": null
        },
        {
          "op": "client.log",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            }
          },
          "expect": [
            [
              "ping",
              "are you there"
            ],
            [
              "push",
              "",
              10
            ],
            [
              "pong",
              "pong data"
            ],
            [
              "message",
              "after"
            ],
            [
              "close"
            ],
            [
              "transport.close"
            ]
          ]
        },
        {
          "op": "client.is_connected",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            }
          },
          "expect": false
        }
      ]
    },
