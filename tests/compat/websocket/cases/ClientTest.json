    {
      "name": "testListen",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "url": "ws://localhost:8080"
          },
          "bind": "c",
          "expect": {
            "client": {
              "$handle": "*"
            },
            "host": "localhost",
            "port": 8080,
            "path": "/",
            "headers": [],
            "timeout": 30.0
          }
        },
        {
          "op": "client.hooks",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            }
          },
          "expect": [
            true,
            true,
            true,
            true,
            true,
            true
          ]
        },
        {
          "op": "client.attach",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            },
            "script": [
              {
                "opcode": 1,
                "data": "Hello WebSocket!"
              },
              {
                "code": 5001,
                "message": ""
              }
            ]
          },
          "expect": null
        },
        {
          "op": "client.listen",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            }
          },
          "expect": null
        },
        {
          "op": "client.log",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            }
          },
          "expect": [
            [
              "message",
              "Hello WebSocket!"
            ],
            [
              "close"
            ],
            [
              "transport.close"
            ]
          ]
        },
        {
          "op": "client.is_connected",
          "args": {
            "client": {
              "$ref": "c",
              "path": "/client"
            }
          },
          "expect": false
        }
      ]
    },
