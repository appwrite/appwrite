{
  "source": "packages/websocket/tests/ClientTest.php",
  "cases": [
    {
      "name": "testConstructorWithValidUrl",
      "op": "client.new",
      "args": {
        "url": "ws://localhost:8080"
      },
      "expect": {
        "client": {
          "$handle": "*"
        },
        "host": "localhost",
        "port": 8080,
        "path": "/",
        "headers": [],
        "timeout": 30.0
      }
    },
    {
      "name": "testConstructorWithInvalidUrl",
      "op": "client.new",
      "args": {
        "url": "invalid-url"
      },
      "expect": {
        "$error": {
          "class": "InvalidArgumentException",
          "message": "WebSocket URL must contain a host"
        }
      }
    },
    {
      "name": "testConstructorWithCustomOptions",
      "op": "client.new",
      "args": {
        "url": "ws://localhost:8080",
        "options": {
          "headers": [
            [
              "Authorization",
              "Bearer token"
            ]
          ],
          "timeout": 60
        }
      },
      "expect": {
        "client": {
          "$handle": "*"
        },
        "host": "localhost",
        "port": 8080,
        "path": "/",
        "headers": [
          [
            "Authorization",
            "Bearer token"
          ]
        ],
        "timeout": 60.0
      }
    },
    {
