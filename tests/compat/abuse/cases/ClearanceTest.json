{
  "source": "packages/abuse/tests/Challenge/ClearanceTest.php",
  "cases": [
    {
      "name": "testIssueThenVerifyRoundTrips",
      "steps": [
        {
          "op": "clearance.new",
          "args": {
            "secret": "clearance-secret",
            "ttl": 1800,
            "label": "label"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "clearance.with_params",
          "args": {
            "clearance": {
              "$ref": "c"
            },
            "params": {
              "project": "p1",
              "resource": "r1",
              "ip": "203.0.113.0/24",
              "ua": "ua-hash"
            }
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "clearance.issue",
          "args": {
            "clearance": {
              "$ref": "b"
            },
            "difficulty": 18
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "a token carries its expiry (time()) and, for puzzles, a random nonce"
          }
        },
        {
          "op": "clearance.verify",
          "args": {
            "clearance": {
              "$ref": "b"
            },
            "token": {
              "$ref": "t"
            },
            "difficulty": 18
          },
          "expect": true
        }
      ],
      "state": []
    },
