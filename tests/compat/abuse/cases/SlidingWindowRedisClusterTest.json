            "reason": "the real clock: the window's end depends on when the case runs"
          },
          "expect": {
            "limited": false,
            "limit": 2,
            "remaining": 0,
            "reset": "<masked>"
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "mask": {
            "paths": [
              "/reset"
            ],
            "reason": "the real clock: the window's end depends on when the case runs"
          },
          "expect": {
            "limited": true,
            "limit": 2,
            "remaining": 0,
            "reset": "<masked>"
          }
        }
      ],
      "state": []
