  "cases": [
    {
      "name": "static key",
      "steps": [
        {
          "op": "limit.new",
          "args": {
            "algo": "sliding_window",
            "store": "cluster",
            "key": "${ns}-sw-static-key",
            "limit": 2,
            "window": 1,
            "ttl": 2
          },
          "bind": "l",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "clock.fresh_second",
          "args": {},
          "expect": null
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "mask": {
            "paths": [
              "/reset"
            ],
            "reason": "the real clock: the window's end depends on when the case runs"
          },
          "expect": {
            "limited": false,
            "limit": 2,
            "remaining": 1,
            "reset": "<masked>"
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "mask": {
            "paths": [
              "/reset"
