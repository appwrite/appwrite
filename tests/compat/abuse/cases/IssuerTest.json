    {
      "name": "integer and numeric names: spread renumbers them, the binding records them as integers",
      "steps": [
        {
          "op": "issuer.new",
          "args": {
            "secret": "token-secret",
            "label": "label",
            "purpose": "purpose",
            "ttl": 60
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "issuer.issue",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "claims": {
              "7": "seven",
              "x": "y"
            },
            "binding": {
              "5": "five"
            }
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "a token carries its expiry (time()) and, for puzzles, a random nonce"
          }
        },
        {
          "op": "issuer.verify",
          "args": {
