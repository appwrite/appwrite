    {
      "name": "testParamsMatchRequiresTheSameNamesAndValues",
      "steps": [
        {
          "op": "issuer.new",
          "args": {
            "secret": "token-secret",
            "label": "label",
            "purpose": "purpose",
            "ttl": 60
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "issuer.issue",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "binding": {
              "ip": "i",
              "ua": "u"
            }
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "a token carries its expiry (time()) and, for puzzles, a random nonce"
          }
        },
        {
          "op": "issuer.verify",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "token": {
              "$ref": "t"
            }
          },
          "bind": "c"
        },
        {
          "op": "issuer.params_match",
          "args": {
            "claims": {
              "$ref": "c"
            },
            "binding": {
              "ua": "u",
              "ip": "i"
            }
          },
          "expect": true
        },
        {
          "op": "issuer.params_match",
          "args": {
            "claims": {
              "$ref": "c"
            },
            "binding": {
              "ip": "i"
            }
          },
          "expect": false
        },
        {
          "op": "issuer.params_match",
          "args": {
            "claims": {
              "$ref": "c"
            },
            "binding": []
          },
          "expect": false
        },
        {
          "op": "issuer.params_match",
          "args": {
            "claims": {
              "$ref": "c"
            },
            "binding": {
              "ip": "i",
              "ua": "other"
            }
          },
          "expect": false
        },
        {
          "op": "issuer.params_match",
          "args": {
            "claims": {
              "$ref": "c"
            },
            "binding": {
              "ip": "i",
              "ua": "u",
              "extra": "x"
            }
          },
          "expect": false
        },
        {
          "op": "issuer.issue",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "claims": {
              "ip": "i"
            }
          },
          "bind": "t2",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "a token carries its expiry (time()) and, for puzzles, a random nonce"
          }
        },
        {
          "op": "issuer.verify",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "token": {
              "$ref": "t2"
            }
          },
          "bind": "c2"
        },
        {
          "op": "issuer.params_match",
          "args": {
            "claims": {
              "$ref": "c2"
            },
            "binding": {
              "ip": "i"
            }
          },
          "expect": false
        },
        {
          "op": "issuer.params_match",
          "args": {
            "claims": {
              "$ref": "c2"
            },
            "binding": []
          },
          "expect": true
        }
      ],
      "state": []
    },
