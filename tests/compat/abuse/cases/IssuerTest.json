{
  "source": "packages/abuse/tests/Challenge/IssuerTest.php",
  "cases": [
    {
      "name": "testIssueThenVerifyReturnsTheClaims",
      "steps": [
        {
          "op": "issuer.new",
          "args": {
            "secret": "token-secret",
            "label": "label",
            "purpose": "purpose",
            "ttl": 60
          },
          "bind": "i",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "issuer.issue",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "claims": {
              "user": "u1",
              "level": 3
            }
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "a token carries its expiry (time()) and, for puzzles, a random nonce"
          }
        },
        {
          "op": "issuer.verify",
          "args": {
            "issuer": {
              "$ref": "i"
            },
            "token": {
              "$ref": "t"
            }
          }
        }
      ],
      "state": []
    },
