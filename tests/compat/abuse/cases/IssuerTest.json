              "$ref": "i"
            },
            "token": {
              "$ref": "t"
            }
          },
          "bind": "c"
        },
        {
          "op": "issuer.params_match",
          "args": {
            "claims": {
              "$ref": "c"
            },
            "binding": {
              "5": "five"
            }
          }
        }
      ],
      "state": []
