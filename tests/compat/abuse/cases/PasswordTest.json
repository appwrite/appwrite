            }
          },
          "bind": "pb2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "password.issue",
          "args": {
            "password": {
              "$ref": "pb2"
            }
          },
          "bind": "pt2",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "a token carries its expiry (time()) and, for puzzles, a random nonce"
          }
