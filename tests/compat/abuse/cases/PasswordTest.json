{
  "source": "packages/abuse/tests/Challenge/PasswordTest.php",
  "cases": [
    {
      "name": "testAPasswordHashedByAuthMatches",
      "steps": [
        {
          "op": "password.hash",
          "args": {
            "password": "correct horse battery staple"
          },
          "bind": "h"
        },
        {
          "op": "password.new",
          "args": {
            "secret": "password-secret",
            "hash": {
              "$ref": "h"
            }
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "password.with_params",
          "args": {
            "password": {
              "$ref": "p"
            },
            "params": {
              "ip": "203.0.113.0/24",
              "ua": "ua-hash"
            }
          },
          "bind": "pb1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "password.issue",
          "args": {
            "password": {
              "$ref": "pb1"
            }
          },
          "bind": "pt1",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "a token carries its expiry (time()) and, for puzzles, a random nonce"
          }
        },
        {
          "op": "password.verify",
          "args": {
            "password": {
              "$ref": "pb1"
            },
            "token": {
              "$ref": "pt1"
            },
            "answer": "correct horse battery staple"
          }
        },
        {
          "op": "password.with_params",
          "args": {
            "password": {
              "$ref": "p"
            },
            "params": {
              "ip": "203.0.113.0/24",
