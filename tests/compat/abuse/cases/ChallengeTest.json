{
  "source": "packages/abuse/tests/Challenge/ChallengeTest.php",
  "cases": [
    {
      "name": "testANewKindNeedsOnlyIssueAndVerify",
      "steps": [
        {
          "op": "riddle.new",
          "args": {
            "secret": "secret",
            "answer": "echo"
          },
          "bind": "r0",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "riddle.with_params",
          "args": {
            "riddle": {
              "$ref": "r0"
            },
            "params": {
              "ip": "203.0.113.0/24",
              "ua": "ua-hash"
            }
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "riddle.issue",
          "args": {
            "riddle": {
              "$ref": "r"
            },
            "claims": {
              "project": "p1"
            }
          },
          "bind": "t",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "a token carries its expiry (time()) and, for puzzles, a random nonce"
          }
        },
        {
          "op": "riddle.verify",
          "args": {
            "riddle": {
              "$ref": "r"
            },
            "token": {
              "$ref": "t"
            },
            "answer": "echo"
          }
        },
        {
          "op": "riddle.verify",
          "args": {
            "riddle": {
              "$ref": "r"
            },
            "token": {
              "$ref": "t"
            },
            "answer": "wrong"
          }
        }
      ],
      "state": []
    },
