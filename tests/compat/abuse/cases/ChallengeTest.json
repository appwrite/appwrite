    {
      "name": "testTheKindsOwnClaimsCannotBeOverridden",
      "steps": [
        {
          "op": "riddle.new",
          "args": {
            "secret": "secret",
            "answer": "echo"
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "riddle.issue",
          "args": {
            "riddle": {
              "$ref": "r"
            },
            "claims": {
              "answer": "x"
            }
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "claim 'answer' is reserved"
            }
          }
        }
      ],
      "state": []
    },
    {
      "name": "testParamsCannotReuseTheKindsOwnClaims",
