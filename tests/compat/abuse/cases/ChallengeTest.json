    {
      "name": "Result and Token: a status and its validity",
      "steps": [
        {
          "op": "challenge.result",
          "args": {
            "status": "valid",
            "claims": {
              "a": "b"
            }
          },
          "expect": {
            "status": "valid",
            "claims": {
              "a": "b"
            },
            "isValid": true,
            "error": null
          }
        },
        {
          "op": "challenge.result",
          "args": {
            "status": "replay"
          },
          "expect": {
            "status": "replay",
            "claims": [],
            "isValid": false,
            "error": null
          }
        },
        {
          "op": "challenge.token",
          "args": {
            "value": "v"
          },
          "expect": "v"
        }
      ],
      "state": []
