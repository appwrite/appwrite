{
  "source": "packages/abuse/tests/NoneTest.php",
  "cases": [
    {
      "name": "time limit: never limits requests",
      "steps": [
        {
          "op": "limit.new",
          "args": {
            "algo": "time_limit",
            "store": "none",
            "key": "none-key",
            "limit": 1,
            "seconds": 60
          },
          "bind": "l",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "mask": {
            "paths": [
              "/reset"
            ],
            "reason": "the real clock: the window's end depends on when the case runs"
          },
          "expect": {
            "limited": false,
            "limit": 1,
            "remaining": 0,
            "reset": "<masked>"
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
