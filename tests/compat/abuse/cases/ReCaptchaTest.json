{
  "source": "packages/abuse/tests/ReCaptchaTest.php",
  "cases": [
    {
      "name": "sends form to siteverify",
      "steps": [
        {
          "op": "recaptcha.verify",
          "args": {
            "secret": "s3cret&key",
            "response": "token/with+chars",
            "ip": "203.0.113.7",
            "body": "{\"success\": true, \"score\": 0.9}"
          },
          "expect": {
            "verdict": true,
            "method": "POST",
            "url": "https://www.google.com/recaptcha/api/siteverify",
            "content_type": "application/x-www-form-urlencoded",
            "body": "secret=s3cret%26key&response=token%2Fwith%2Bchars&remoteip=203.0.113.7"
          }
        }
      ]
    },
    {
      "name": "the endpoint",
      "steps": [
        {
          "op": "recaptcha.url",
          "args": {},
          "expect": "https://www.google.com/recaptcha/api/siteverify"
        }
      ]
    },
    {
      "name": "verdict: above threshold",
      "steps": [
        {
          "op": "recaptcha.verify",
          "args": {
            "secret": "secret",
            "response": "token",
            "ip": "127.0.0.1",
            "body": "{\"success\": true, \"score\": 0.9}",
            "score": 0.5
          },
          "expect": {
            "verdict": true,
            "method": "POST",
            "url": "https://www.google.com/recaptcha/api/siteverify",
            "content_type": "application/x-www-form-urlencoded",
            "body": "secret=secret&response=token&remoteip=127.0.0.1"
          }
        }
      ]
    },
