{
  "source": "fixed clocks",
  "cases": [
    {
      "name": "time limit: windows, resets and counters",
      "steps": [
        {
          "op": "limit.new",
          "args": {
            "algo": "time_limit",
            "store": "pool",
            "key": "${ns}:tl:{ip}",
            "limit": 2,
            "seconds": 60
          },
          "bind": "l",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.with_params",
          "args": {
            "handle": {
              "$ref": "l"
            },
            "params": {
              "{ip}": "203.0.113.7"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "now": 1699999997
          },
          "expect": {
            "limited": false,
            "limit": 2,
            "remaining": 1,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "now": 1700000039
          },
          "expect": {
            "limited": false,
            "limit": 2,
            "remaining": 0,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "now": 1700000039
          },
          "expect": {
            "limited": true,
            "limit": 2,
            "remaining": 0,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.peek",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "now": 1700000010
          },
          "expect": {
            "limited": true,
            "limit": 2,
            "remaining": 0,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "now": 1700000040
          },
          "expect": {
            "limited": false,
            "limit": 2,
            "remaining": 1,
            "reset": 1700000100
          }
        },
        {
          "op": "limit.peek",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "now": 1700000041
          },
          "expect": {
            "limited": false,
            "limit": 2,
            "remaining": 0,
            "reset": 1700000100
          }
        },
        {
          "op": "limit.reset",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "now": 1700000041
          },
          "expect": null
        },
        {
          "op": "limit.peek",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "now": 1700000041
          },
          "expect": {
            "limited": false,
            "limit": 2,
            "remaining": 1,
            "reset": 1700000100
          }
        },
        {
          "op": "redis.ttl",
          "args": {
            "key": "abuse__${ns}:tl:203.0.113.7__1699999980",
            "max": 60
          },
          "expect": true
        },
        {
          "op": "redis.get",
          "args": {
            "key": "abuse__${ns}:tl:203.0.113.7__1700000040"
          },
          "expect": "0"
        }
      ]
    },
