    {
      "name": "time limit: a counter that is not a number fails the script",
      "steps": [
        {
          "op": "limit.new",
          "args": {
            "algo": "time_limit",
            "store": "pool",
            "key": "${ns}:junk",
            "limit": 5,
            "seconds": 60
          },
          "bind": "l",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "redis.set",
          "args": {
            "key": "abuse__${ns}:junk__1699999980",
            "value": "abc"
          },
          "expect": true
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            },
            "now": 1699999980
