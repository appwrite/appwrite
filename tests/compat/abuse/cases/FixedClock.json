        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            },
            "now": 9223372036854775807
          },
          "mask": {
            "paths": [
              "/$error/message"
            ],
            "reason": "PHP's TypeError message ends with the PHP file and line that called Result's constructor; the class is compared"
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "<masked>"
            }
          }
        },
        {
          "op": "limit.new",
          "args": {
            "algo": "time_limit",
            "store": "pool",
            "key": "${ns}:max",
            "limit": 1,
            "seconds": 10
          },
          "bind": "m",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.peek",
          "args": {
            "handle": {
              "$ref": "m"
            },
            "now": 9223372036854775807
          },
          "mask": {
            "paths": [
              "/$error/message"
            ],
            "reason": "PHP's TypeError message ends with the PHP file and line that called Result's constructor; the class is compared"
          },
          "expect": {
            "$error": {
              "class": "TypeError",
              "message": "<masked>"
            }
          }
        }
      ]
    },
