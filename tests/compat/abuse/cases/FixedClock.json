    {
      "name": "time limit: a reset past the integer range",
      "steps": [
        {
          "op": "limit.new",
          "args": {
            "algo": "time_limit",
            "store": "pool",
            "key": "${ns}:max",
            "limit": 0,
            "seconds": 10
          },
