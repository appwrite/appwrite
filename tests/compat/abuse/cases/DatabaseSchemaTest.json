              "$ref": "db"
            },
            "key": "login",
            "time": 0,
            "count": 1
          },
          "expect": null
        },
        {
          "op": "database.store",
          "args": {
            "database": {
              "$ref": "db"
            },
            "key": "signup",
            "time": 1000000000,
            "count": 1
          },
          "expect": null
        },
        {
          "op": "database.store",
          "args": {
            "database": {
              "$ref": "db"
            },
            "key": "login",
            "time": 1000000000,
            "count": 1
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\Unique",
              "message": "Unique index violation"
            }
          }
        }
      ]
