            "limit": 1,
            "seconds": 60
          },
          "bind": "base",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.with_params",
          "args": {
            "handle": {
              "$ref": "base"
            },
            "params": {
              "{ip}": "a"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.with_params",
          "args": {
            "handle": {
              "$ref": "a"
            },
            "params": {
              "{ip}": "b"
            }
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.key",
          "args": {
            "handle": {
              "$ref": "a"
            }
          },
          "expect": "ip:a"
        },
        {
          "op": "limit.key",
          "args": {
            "handle": {
              "$ref": "b"
            }
          },
          "expect": "ip:b"
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "a"
            }
          },
          "expect": {
            "limited": false,
            "limit": 1,
            "remaining": 0,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "b"
            }
          },
          "expect": {
            "limited": false,
            "limit": 1,
            "remaining": 0,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "a"
            }
          },
          "expect": {
            "limited": true,
            "limit": 1,
            "remaining": 0,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "b"
            }
          },
          "expect": {
            "limited": true,
            "limit": 1,
            "remaining": 0,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.key",
          "args": {
            "handle": {
              "$ref": "a"
            }
          },
          "expect": "ip:a"
        },
        {
          "op": "limit.key",
          "args": {
            "handle": {
              "$ref": "base"
            }
          },
          "expect": "ip:{ip}"
        },
        {
          "op": "memory.state",
          "args": {
            "memory": {
              "$ref": "st"
            }
          },
          "expect": {
            "counts": {
              "ip:a__1699999980": 1,
              "ip:b__1699999980": 1
            },
            "calls": 4
          }
