{
  "source": "packages/abuse/tests/TimeLimitTest.php",
  "cases": [
    {
      "name": "remaining counts down",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "now": 1700000017
          },
          "bind": "st",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.new",
          "args": {
            "algo": "time_limit",
            "store": "memory",
            "memory": {
              "$ref": "st"
            },
            "key": "ip:{ip}",
            "limit": 3,
            "seconds": 60
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.with_param",
          "args": {
            "handle": {
              "$ref": "b"
            },
            "name": "{ip}",
            "value": "127.0.0.1"
          },
          "bind": "l",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": false,
            "limit": 3,
            "remaining": 2,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": false,
            "limit": 3,
            "remaining": 1,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": false,
            "limit": 3,
            "remaining": 0,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": true,
            "limit": 3,
            "remaining": 0,
            "reset": 1700000040
          }
        }
      ]
    },
    {
      "name": "peek does not consume",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "now": 1700000017
          },
          "bind": "st",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.new",
          "args": {
            "algo": "time_limit",
            "store": "memory",
            "memory": {
              "$ref": "st"
            },
            "key": "ip:{ip}",
            "limit": 3,
            "seconds": 60
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.with_param",
          "args": {
            "handle": {
              "$ref": "b"
            },
            "name": "{ip}",
            "value": "127.0.0.1"
          },
          "bind": "l",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "limit.peek",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": false,
            "limit": 3,
            "remaining": 2,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.peek",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": false,
            "limit": 3,
            "remaining": 2,
            "reset": 1700000040
          }
        },
        {
          "op": "memory.state",
          "args": {
            "memory": {
              "$ref": "st"
            }
          },
          "expect": {
            "counts": {},
            "calls": 2
          }
        },
        {
          "op": "limit.check",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": false,
            "limit": 3,
            "remaining": 2,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.peek",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": false,
            "limit": 3,
            "remaining": 1,
            "reset": 1700000040
          }
        },
        {
          "op": "limit.peek",
          "args": {
            "handle": {
              "$ref": "l"
            }
          },
          "expect": {
            "limited": false,
            "limit": 3,
            "remaining": 1,
            "reset": 1700000040
          }
        },
        {
          "op": "memory.state",
          "args": {
            "memory": {
              "$ref": "st"
            }
          },
          "expect": {
            "counts": {
              "ip:127.0.0.1__1699999980": 1
            },
            "calls": 5
          }
        }
      ]
    },
