{
  "ops": {
    "identity.ip_prefix": {
      "doc": "new Identity(ipv4Bits ?? 24, ipv6Bits ?? 48)->ipPrefix(ip)",
      "covers": [
        "Utopia\\Abuse\\Challenge\\Identity::__construct",
        "Utopia\\Abuse\\Challenge\\Identity::ipPrefix"
      ],
      "fuzz": [
        {
          "name": "addresses",
          "args": {
            "gen": "object",
            "fields": {
              "ip": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "pick",
                    "from": [
                      "203.0.113.45",
                      "2001:db8:abcd:1234:5678:9abc:def0:1234",
                      "::1",
                      "::ffff:192.0.2.1",
                      " 10.0.0.1 ",
                      "not-an-ip",
                      "",
                      ":::"
                    ]
                  },
                  {
                    "gen": "string",
                    "tricky": 0.5
                  }
                ]
              },
              "ipv4Bits": {
                "gen": "int",
                "min": -1,
                "max": 33
              },
              "ipv6Bits": {
                "gen": "int",
                "min": -1,
                "max": 129
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
