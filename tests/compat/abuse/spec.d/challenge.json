  "deviations": [
    {
      "symbol": "Utopia\\Abuse\\Challenge\\Issuer::verify",
      "php": "A time claim (exp, iat, nbf) of a token signed with the secret that is a leading-numeric string (\"12abc\") is used up to its digits by the JWT library's arithmetic, with a warning.",
      "reason": "Rust treats it as not a number, so the token does not verify. Only a token forged with the signing secret can carry one."
    },
    {
      "symbol": "Utopia\\Abuse\\Challenge\\ProofOfWork::verify",
      "php": "elapsedMs is computed as an int (or a float past the 64-bit range, which ProofOfWork\\Result rejects with a TypeError naming the PHP call site).",
      "reason": "Rust raises Error::Type with the message up to that PHP source location. Only a token forged with the signing secret can carry such an iatMs."
    }
  ]
