{
  "source": "packages/circuit-breaker/tests/E2E/SwooleTableAdapterTest.php",
  "cases": [
    {
      "name": "the Swoole table adapter shares values across instances",
      "steps": [
        {
          "op": "store.table",
          "args": {
            "size": 32
          },
          "bind": "table",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.swoole_table",
          "args": {
            "table": {
              "$ref": "table"
            },
            "prefix": "test:"
          },
          "bind": "first",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.swoole_table",
          "args": {
            "table": {
              "$ref": "table"
            },
            "prefix": "test:"
          },
          "bind": "second",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.set",
          "args": {
            "store": {
              "$ref": "first"
            },
            "key": "state",
            "value": "half_open"
          },
          "expect": null
        },
        {
          "op": "store.set",
          "args": {
            "store": {
              "$ref": "first"
            },
            "key": "failures",
            "value": 2
          },
          "expect": null
        },
        {
          "op": "store.get",
          "args": {
            "store": {
              "$ref": "second"
            },
            "key": "state"
          },
          "expect": "half_open"
        },
        {
          "op": "store.get",
          "args": {
            "store": {
              "$ref": "second"
            },
            "key": "failures"
          },
          "expect": 2
        },
        {
          "op": "store.increment",
          "args": {
            "store": {
              "$ref": "second"
            },
            "key": "failures"
          },
          "expect": 3
        },
        {
          "op": "store.get",
          "args": {
            "store": {
              "$ref": "first"
            },
            "key": "failures"
          },
          "expect": 3
        },
        {
          "op": "store.increment",
          "args": {
            "store": {
              "$ref": "first"
            },
            "key": "missing-counter"
          },
          "expect": 1
        },
        {
          "op": "store.get",
          "args": {
            "store": {
              "$ref": "second"
            },
            "key": "missing-counter"
          },
          "expect": 1
        },
        {
          "op": "store.set",
          "args": {
            "store": {
              "$ref": "first"
            },
            "key": "empty-string",
            "value": ""
          },
          "expect": null
        },
        {
          "op": "store.get",
          "args": {
            "store": {
              "$ref": "second"
            },
            "key": "empty-string"
          },
          "expect": ""
        },
        {
          "op": "store.delete",
          "args": {
            "store": {
              "$ref": "first"
            },
            "key": "failures"
          },
          "expect": null
        },
        {
          "op": "store.get",
          "args": {
            "store": {
              "$ref": "second"
            },
            "key": "failures"
          },
          "expect": null
        }
      ]
    },
    {
      "name": "the Swoole table adapter rejects incrementing strings",
      "steps": [
        {
          "op": "store.table",
          "args": {
            "size": 32
          },
          "bind": "table",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.swoole_table",
          "args": {
            "table": {
              "$ref": "table"
            },
            "prefix": "test:"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.set",
          "args": {
            "store": {
              "$ref": "a"
            },
            "key": "state",
            "value": "open"
          },
          "expect": null
        },
        {
          "op": "store.increment",
          "args": {
            "store": {
              "$ref": "a"
            },
            "key": "state"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\CircuitBreaker\\Adapter\\AdapterException",
              "message": "Cannot increment non-numeric Swoole table key \"state\"."
            }
          }
        }
      ]
    },
    {
      "name": "the Swoole table adapter hashes long keys to fit table limits",
      "steps": [
        {
          "op": "store.table",
          "args": {
            "size": 32
          },
          "bind": "table",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.swoole_table",
          "args": {
            "table": {
              "$ref": "table"
            },
            "prefix": "test:"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.set",
          "args": {
            "store": {
              "$ref": "a"
            },
            "key": "service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-state",
            "value": "open"
          },
          "expect": null
        },
        {
          "op": "store.get",
          "args": {
            "store": {
              "$ref": "a"
            },
            "key": "service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-service-state"
          },
          "expect": "open"
        },
        {
          "op": "store.swoole_table",
          "args": {
            "table": {
              "$ref": "table"
            },
            "prefix": "a-prefix-longer-than-twenty-bytes:"
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.set",
          "args": {
            "store": {
              "$ref": "b"
            },
            "key": "service-service-service-service-service-service-service-service-service-service-",
            "value": 7
          },
          "expect": null
        },
        {
          "op": "store.get",
          "args": {
            "store": {
              "$ref": "b"
            },
            "key": "service-service-service-service-service-service-service-service-service-service-"
          },
          "expect": 7
        }
      ]
    },
    {
      "name": "circuit breaker shares state through a Swoole table",
      "steps": [
        {
          "op": "store.table",
          "args": {
            "size": 32
          },
          "bind": "table",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.swoole_table",
          "args": {
            "table": {
              "$ref": "table"
            },
            "prefix": "breaker-test:"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "breaker.new",
          "args": {
            "timeout": 0,
            "success_threshold": 2,
            "store": {
              "$ref": "c"
            },
            "key": "billing-api",
            "minimum_throughput": 1
          },
          "bind": "first",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "breaker.new",
          "args": {
            "timeout": 0,
            "success_threshold": 2,
            "store": {
              "$ref": "c"
            },
            "key": "billing-api",
            "minimum_throughput": 1
          },
          "bind": "second",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "breaker.call",
          "args": {
            "breaker": {
              "$ref": "first"
            },
            "close": {
              "throw": "failed"
            }
          },
          "expect": "fallback"
        },
        {
          "op": "breaker.is",
          "args": {
            "breaker": {
              "$ref": "second"
            }
          },
          "expect": {
            "open": false,
            "closed": false,
            "half_open": true
          }
        },
        {
          "op": "breaker.call",
          "args": {
            "breaker": {
              "$ref": "second"
            },
            "close": {
              "result": "closed"
            },
            "half_open": {
              "result": "probe-1"
            }
          },
          "expect": "probe-1"
        },
        {
          "op": "breaker.successes",
          "args": {
            "breaker": {
              "$ref": "first"
            }
          },
          "expect": 1
        },
        {
          "op": "breaker.call",
          "args": {
            "breaker": {
              "$ref": "first"
            },
            "close": {
              "result": "closed"
            },
            "half_open": {
              "result": "probe-2"
            }
          },
          "expect": "probe-2"
        },
        {
          "op": "breaker.is",
          "args": {
            "breaker": {
              "$ref": "second"
            }
          },
          "expect": {
            "open": false,
            "closed": true,
            "half_open": false
          }
        },
        {
          "op": "breaker.failures",
          "args": {
            "breaker": {
              "$ref": "second"
            }
          },
          "expect": 0
        },
        {
          "op": "breaker.successes",
          "args": {
            "breaker": {
              "$ref": "second"
            }
          },
          "expect": 0
        }
      ]
    }
  ]
}
