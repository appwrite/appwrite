{
  "source": "packages/usage/tests/TenantTest.php",
  "cases": [
    {
      "name": "empty tenant throws",
      "steps": [
        {
          "op": "recording.new",
          "args": {},
          "bind": "rec",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.new",
          "args": {
            "adapter": {
              "$ref": "rec"
            }
          },
          "bind": "usage",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "tenant.new",
          "args": {
            "usage": {
              "$ref": "usage"
            },
            "tenant": ""
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Tenant cannot be empty"
            }
          }
        },
        {
          "op": "tenant.new",
          "args": {
            "usage": {
              "$ref": "usage"
            },
            "tenant": "0"
          },
          "expect": {
            "$handle": "*"
          }
        }
      ]
    },
    {
      "name": "addBatch stamps the bound tenant onto every metric",
      "steps": [
        {
          "op": "recording.new",
          "args": {},
          "bind": "rec",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.new",
          "args": {
            "adapter": {
              "$ref": "rec"
            }
          },
          "bind": "usage",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "tenant.new",
          "args": {
            "usage": {
              "$ref": "usage"
            },
            "tenant": "p1"
          },
          "bind": "view",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "tenant.add_batch",
          "args": {
            "view": {
              "$ref": "view"
            },
            "metrics": [
              {
                "metric": "requests",
                "value": 10,
                "tags": []
              },
              {
                "metric": "bandwidth",
                "value": 20,
                "tags": [],
                "tenant": "other"
              }
            ],
            "type": "event"
          },
          "expect": true
        },
        {
          "op": "recording.calls",
          "args": {
            "adapter": {
              "$ref": "rec"
            }
          },
          "expect": [
            {
              "method": "addBatch",
              "type": "event",
              "batchSize": 1000,
              "metrics": [
                {
                  "tenant": "p1",
                  "metric": "requests",
                  "value": 10,
                  "tags": [],
                  "allowNegative": false
                },
                {
                  "tenant": "p1",
                  "metric": "bandwidth",
                  "value": 20,
                  "tags": [],
                  "allowNegative": false
                }
              ],
              "succeed": true
            }
          ]
        }
      ]
    },
