  "cases": [
    {
      "name": "a gauge defaults to the latest reading",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "database": "default"
          },
          "bind": "admin",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "admin"
            },
            "sql": "CREATE DATABASE IF NOT EXISTS `${ns}`"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.new",
          "args": {
            "database": "${ns}",
            "namespace": "utopia_usage_gauge_max"
          },
          "bind": "ch",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.new",
          "args": {
            "adapter": {
              "$ref": "ch"
            }
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.setup",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": null
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "INSERT INTO `${ns}`.`utopia_usage_gauge_max_usage_gauges` (id, metric, value, time) VALUES ('rt-default-0', 'rt-default', 2, '2026-06-01 00:00:00'), ('rt-default-1', 'rt-default', 9, '2026-06-01 00:05:00'), ('rt-default-2', 'rt-default', 4, '2026-06-01 00:10:00')"
          },
          "expect": ""
        },
        {
          "op": "usage.find",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "tenant": "1",
            "queries": [
              {
                "method": "equal",
                "attribute": "metric",
                "values": [
                  "rt-default"
                ]
              },
              {
                "method": "greaterThanEqual",
                "attribute": "time",
                "values": [
                  "2026-06-01 00:00:00"
                ]
              },
              {
                "method": "lessThanEqual",
                "attribute": "time",
                "values": [
                  "2026-06-01 01:00:00"
                ]
              },
              {
                "method": "groupByTimeBucket",
                "attribute": "time",
                "values": [
                  "1h"
                ]
              }
            ],
            "type": "gauge"
          },
          "expect": [
            {
              "metric": "rt-default",
              "value": 4,
              "time": "2026-06-01T00:00:00+00:00",
              "type": "gauge"
            }
          ]
        },
        {
          "op": "usage.purge",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "tenant": "1",
            "queries": []
          },
          "expect": true
        }
      ],
      "state": [
        "clickhouse@usage-clickhouse"
      ]
    },
