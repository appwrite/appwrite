{
  "source": "packages/usage/tests/E2E/Adapter/ClickHouseBackfillTest.php",
  "cases": [
    {
      "name": "backfill restores the rollup to raw totals",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "database": "default"
          },
          "bind": "admin",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "admin"
            },
            "sql": "CREATE DATABASE IF NOT EXISTS `${ns}`"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.new",
          "args": {
            "database": "${ns}",
            "namespace": "utopia_usage_backfill",
            "shared_tables": true
          },
          "bind": "ch",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.new",
          "args": {
            "adapter": {
              "$ref": "ch"
            }
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.setup",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": null
        },
        {
          "op": "usage.purge",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "tenant": "1",
            "queries": []
          },
          "expect": true
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "INSERT INTO `${ns}`.`utopia_usage_backfill_usage_events` (id, metric, value, time, tenant) SELECT lower(hex(randomString(16))), {metric:String}, {value:Int64}, {time:DateTime64(3)}, {tenant:String}",
            "params": {
              "metric": "backfill.metric",
              "value": 100,
              "time": {
                "$time": "-5 days",
                "format": "Y-m-d H:i:s.v"
              },
              "tenant": "1"
            }
          },
          "expect": ""
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "INSERT INTO `${ns}`.`utopia_usage_backfill_usage_events` (id, metric, value, time, tenant) SELECT lower(hex(randomString(16))), {metric:String}, {value:Int64}, {time:DateTime64(3)}, {tenant:String}",
            "params": {
              "metric": "backfill.metric",
              "value": 200,
              "time": {
                "$time": "-3 days",
                "format": "Y-m-d H:i:s.v"
              },
              "tenant": "1"
            }
          },
          "expect": ""
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "INSERT INTO `${ns}`.`utopia_usage_backfill_usage_events` (id, metric, value, time, tenant) SELECT lower(hex(randomString(16))), {metric:String}, {value:Int64}, {time:DateTime64(3)}, {tenant:String}",
            "params": {
              "metric": "backfill.other",
              "value": 40,
              "time": {
                "$time": "-4 days",
                "format": "Y-m-d H:i:s.v"
              },
              "tenant": "1"
            }
          },
          "expect": ""
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "TRUNCATE TABLE `${ns}`.`utopia_usage_backfill_usage_events_daily`"
          },
          "expect": ""
        },
        {
          "op": "usage.sum_daily_batch",
          "args": {
            "tenant": "1",
            "metrics": [
              "backfill.metric",
              "backfill.other"
            ],
            "queries": [
              {
                "method": "greaterThanEqual",
                "attribute": "time",
                "values": [
                  {
                    "$time": "-7 days",
                    "format": "Y-m-d 00:00:00"
                  }
                ]
              },
              {
                "method": "lessThan",
                "attribute": "time",
                "values": [
                  {
                    "$time": "today",
                    "format": "Y-m-d H:i:s"
                  }
                ]
              }
            ],
            "usage": {
              "$ref": "u"
            }
          },
          "expect": {
            "backfill.metric": 0,
            "backfill.other": 0
          }
        },
        {
          "op": "usage.backfill_daily",
          "args": {
            "from": {
              "$time": "-7 days",
              "format": "Y-m-d 00:00:00"
            },
            "to": {
              "$time": "today",
              "format": "Y-m-d H:i:s"
            },
            "usage": {
              "$ref": "u"
            }
          },
          "expect": null
        },
        {
          "op": "usage.sum_daily_batch",
          "args": {
            "tenant": "1",
            "metrics": [
              "backfill.metric",
              "backfill.other"
            ],
            "queries": [
              {
                "method": "greaterThanEqual",
                "attribute": "time",
                "values": [
                  {
                    "$time": "-7 days",
                    "format": "Y-m-d 00:00:00"
                  }
                ]
              },
              {
                "method": "lessThan",
                "attribute": "time",
                "values": [
                  {
                    "$time": "today",
                    "format": "Y-m-d H:i:s"
                  }
                ]
              }
            ],
            "usage": {
              "$ref": "u"
            }
          },
          "expect": {
            "backfill.metric": 300,
            "backfill.other": 40
          }
        },
        {
          "op": "usage.purge",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "tenant": "1",
            "queries": []
          },
          "expect": true
        }
      ],
      "state": [
        "clickhouse@usage-clickhouse"
      ]
    },
