{
  "source": "packages/usage/tests/E2E/Adapter/ClickHouseInspectTest.php",
  "cases": [
    {
      "name": "a migrated schema with data reports nothing",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "database": "default"
          },
          "bind": "admin",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "admin"
            },
            "sql": "CREATE DATABASE IF NOT EXISTS `${ns}`"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.new",
          "args": {
            "database": "${ns}",
            "namespace": "utopia_usage_inspect",
            "shared_tables": true
          },
          "bind": "ch",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.new",
          "args": {
            "adapter": {
              "$ref": "ch"
            }
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.migrate",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": null
        },
        {
          "op": "usage.add_batch",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "metrics": [
              {
                "tenant": "1",
                "metric": "requests",
                "value": 1,
                "tags": {
                  "path": "/v1/ping",
                  "resourceType": "site"
                }
              }
            ],
            "type": "event"
          },
          "expect": true
        },
        {
          "op": "usage.add_batch",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "metrics": [
              {
                "tenant": "1",
                "metric": "storage",
                "value": 1,
                "tags": {
                  "service": "storage",
                  "resourceType": "bucket",
                  "resourceId": "b1"
                }
              }
            ],
            "type": "gauge"
          },
          "expect": true
        },
        {
          "op": "usage.inspect",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": []
        }
      ]
    },
    {
      "name": "reports each difference migrate then removes",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "database": "default"
          },
          "bind": "admin",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "admin"
            },
            "sql": "CREATE DATABASE IF NOT EXISTS `${ns}`"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.new",
          "args": {
            "database": "${ns}",
            "namespace": "utopia_usage_inspect",
            "shared_tables": true
          },
          "bind": "ch",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.new",
          "args": {
            "adapter": {
              "$ref": "ch"
            }
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.migrate",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": null
        },
        {
          "op": "usage.add_batch",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "metrics": [
              {
                "tenant": "1",
                "metric": "requests",
                "value": 1,
                "tags": {
                  "path": "/v1/ping",
                  "resourceType": "site"
                }
              }
            ],
            "type": "event"
          },
          "expect": true
        },
        {
          "op": "usage.add_batch",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "metrics": [
              {
                "tenant": "1",
                "metric": "storage",
                "value": 1,
                "tags": {
                  "service": "storage",
                  "resourceType": "bucket",
                  "resourceId": "b1"
                }
              }
            ],
            "type": "gauge"
          },
          "expect": true
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "DROP TABLE `${ns}`.`utopia_usage_inspect_usage_events_daily_mv`"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "ALTER TABLE `${ns}`.`utopia_usage_inspect_usage_events` DROP INDEX `index-protocol` SETTINGS mutations_sync = 2"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "ALTER TABLE `${ns}`.`utopia_usage_inspect_usage_events` DROP COLUMN `sdkVersion` SETTINGS mutations_sync = 2"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "ALTER TABLE `${ns}`.`utopia_usage_inspect_usage_events` MODIFY COLUMN `protocol` Nullable(String) SETTINGS mutations_sync = 2"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "ALTER TABLE `${ns}`.`utopia_usage_inspect_usage_gauges` DROP INDEX `index-resourceType`, DROP INDEX `index-resourceId` SETTINGS mutations_sync = 2"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "ALTER TABLE `${ns}`.`utopia_usage_inspect_usage_gauges` ADD INDEX `index-resource` (`resourceType`) TYPE set(0) GRANULARITY 1, ADD INDEX `index-resourceId` (`resourceId`) TYPE set(0) GRANULARITY 1"
          },
          "expect": ""
        },
        {
          "op": "usage.inspect",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": [
            {
              "table": "utopia_usage_inspect_usage_events_daily_mv",
              "kind": "table.missing",
              "name": "utopia_usage_inspect_usage_events_daily_mv",
              "detail": "migrate() creates it"
            },
            {
              "table": "utopia_usage_inspect_usage_events",
              "kind": "column.drifted",
              "name": "protocol",
              "detail": "is Nullable(String), expected LowCardinality(Nullable(String))"
            },
            {
              "table": "utopia_usage_inspect_usage_events",
              "kind": "column.missing",
              "name": "sdkVersion",
              "detail": "expected LowCardinality(Nullable(String)) CODEC(ZSTD(3))"
            },
            {
              "table": "utopia_usage_inspect_usage_events",
              "kind": "index.missing",
              "name": "index-protocol",
              "detail": "expected (protocol) TYPE set(0)"
            },
            {
              "table": "utopia_usage_inspect_usage_gauges",
              "kind": "index.missing",
              "name": "index-resourceType",
              "detail": "expected (resourceType) TYPE set(0)"
            },
            {
              "table": "utopia_usage_inspect_usage_gauges",
              "kind": "index.drifted",
              "name": "index-resourceId",
              "detail": "is (resourceId) TYPE set(0), expected (resourceId) TYPE bloom_filter"
            },
            {
              "table": "utopia_usage_inspect_usage_gauges",
              "kind": "index.duplicate",
              "name": "index-resource",
              "detail": "duplicates index-resourceType"
            }
          ]
        },
        {
          "op": "usage.migrate",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": null
        },
        {
          "op": "clickhouse.wait_mutations",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "table": "utopia_usage_inspect_usage_events"
          },
          "expect": true
        },
        {
          "op": "clickhouse.wait_mutations",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "table": "utopia_usage_inspect_usage_gauges"
          },
          "expect": true
        },
        {
          "op": "usage.inspect",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": []
        }
      ]
    },
    {
