    {
      "name": "reports a mutation that has not finished and why it fails",
      "steps": [
        {
          "op": "clickhouse.new",
          "args": {
            "database": "default"
          },
          "bind": "admin",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "admin"
            },
            "sql": "CREATE DATABASE IF NOT EXISTS `${ns}`"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.new",
          "args": {
            "database": "${ns}",
            "namespace": "utopia_usage_inspect",
            "shared_tables": true
          },
          "bind": "ch",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.new",
          "args": {
            "adapter": {
              "$ref": "ch"
            }
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "usage.migrate",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": null
        },
        {
          "op": "usage.add_batch",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "metrics": [
              {
                "tenant": "1",
                "metric": "requests",
                "value": 1,
                "tags": {
                  "path": "/v1/ping",
                  "resourceType": "site"
                }
              }
            ],
            "type": "event"
          },
          "expect": true
        },
        {
          "op": "usage.add_batch",
          "args": {
            "usage": {
              "$ref": "u"
            },
            "metrics": [
              {
                "tenant": "1",
                "metric": "storage",
                "value": 1,
                "tags": {
                  "service": "storage",
                  "resourceType": "bucket",
                  "resourceId": "b1"
                }
              }
            ],
            "type": "gauge"
          },
          "expect": true
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "ALTER TABLE `${ns}`.`utopia_usage_inspect_usage_gauges` UPDATE value = throwIf(1, 'inspect-test') WHERE 1"
          },
          "expect": ""
        },
        {
          "op": "clickhouse.wait_mutations",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "table": "utopia_usage_inspect_usage_gauges",
            "failing": true
          },
          "expect": true
        },
        {
          "op": "usage.inspect",
          "args": {
            "usage": {
              "$ref": "u"
            }
          },
          "expect": [
            {
              "table": "utopia_usage_inspect_usage_gauges",
              "kind": "mutation.failing",
              "name": "<masked>",
              "detail": "<masked>"
            }
          ],
          "mask": {
            "paths": [
              "/*/name",
              "/*/detail"
            ],
            "reason": "the mutation's id counts the table's blocks, and its detail carries when it was created and the server's exception text"
          }
        },
        {
          "op": "clickhouse.query",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "sql": "KILL MUTATION WHERE database = {database:String} AND table = {table:String} FORMAT Null",
            "params": {
              "database": "${ns}",
              "table": "utopia_usage_inspect_usage_gauges"
            }
          },
          "expect": ""
        },
        {
          "op": "clickhouse.wait_mutations",
          "args": {
            "adapter": {
              "$ref": "ch"
            },
            "table": "utopia_usage_inspect_usage_gauges"
