    "metric.call": {
      "doc": "a Metric method (`method`, `args`) on new Metric(attributes): {result, attributes} (a returned Metric is \"$this\")",
      "covers": [
        "Utopia\\Usage\\Metric::getId",
        "Utopia\\Usage\\Metric::getMetric",
        "Utopia\\Usage\\Metric::getValue",
        "Utopia\\Usage\\Metric::getType",
        "Utopia\\Usage\\Metric::getTime",
        "Utopia\\Usage\\Metric::getPath",
        "Utopia\\Usage\\Metric::getMethod",
        "Utopia\\Usage\\Metric::getStatus",
        "Utopia\\Usage\\Metric::getResourceType",
        "Utopia\\Usage\\Metric::getResourceId",
        "Utopia\\Usage\\Metric::getCountry",
        "Utopia\\Usage\\Metric::getService",
        "Utopia\\Usage\\Metric::getResourceInternalId",
        "Utopia\\Usage\\Metric::getOrdinal",
        "Utopia\\Usage\\Metric::getTeamId",
        "Utopia\\Usage\\Metric::getTeamInternalId",
        "Utopia\\Usage\\Metric::getRegion",
        "Utopia\\Usage\\Metric::getHostname",
        "Utopia\\Usage\\Metric::getIp",
        "Utopia\\Usage\\Metric::getOsCode",
        "Utopia\\Usage\\Metric::getOsName",
        "Utopia\\Usage\\Metric::getOsVersion",
        "Utopia\\Usage\\Metric::getClientType",
        "Utopia\\Usage\\Metric::getClientCode",
        "Utopia\\Usage\\Metric::getClientName",
        "Utopia\\Usage\\Metric::getClientVersion",
        "Utopia\\Usage\\Metric::getClientEngine",
        "Utopia\\Usage\\Metric::getClientEngineVersion",
        "Utopia\\Usage\\Metric::getDeviceName",
        "Utopia\\Usage\\Metric::getDeviceBrand",
        "Utopia\\Usage\\Metric::getDeviceModel",
        "Utopia\\Usage\\Metric::getTenant",
        "Utopia\\Usage\\Metric::getAttributes",
        "Utopia\\Usage\\Metric::getAttribute",
        "Utopia\\Usage\\Metric::setAttribute",
        "Utopia\\Usage\\Metric::hasAttribute",
        "Utopia\\Usage\\Metric::removeAttribute",
        "Utopia\\Usage\\Metric::isEmpty",
        "Utopia\\Usage\\Metric::toArray"
      ],
      "fuzz": [
        {
          "name": "getters",
          "args": {
            "gen": "object",
            "fields": {
              "attributes": {
                "gen": "ref",
                "name": "attributes"
              },
              "method": {
                "gen": "pick",
                "from": [
                  "getId",
                  "getMetric",
                  "getType",
                  "getTime",
                  "getPath",
                  "getCountry",
                  "getOrdinal",
                  "getTenant",
                  "isEmpty",
                  "toArray",
                  "getAttributes"
                ]
              }
            }
          },
          "iterations": 2000
        },
        {
          "name": "value",
          "args": {
            "gen": "object",
            "fields": {
              "attributes": {
                "gen": "ref",
                "name": "attributes"
              },
              "method": {
                "gen": "const",
                "value": "getValue"
              },
              "args": {
                "gen": "array",
                "min": 0,
                "max": 1,
                "items": {
                  "gen": "one_of",
                  "of": [
                    {
                      "gen": "int",
                      "min": -1000,
                      "max": 1000
                    },
                    {
                      "gen": "float",
                      "min": -100,
                      "max": 100
                    },
                    {
                      "gen": "null"
                    }
                  ]
                }
              }
            }
          },
          "iterations": 1000
        }
      ]
    },
