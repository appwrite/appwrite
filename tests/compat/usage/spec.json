                  "path": {
                    "gen": "ref",
                    "name": "scalar"
                  },
                  "country": {
                    "gen": "string",
                    "min": 0,
                    "max": 4,
                    "alphabet": "alnum"
                  },
                  "ordinal": {
                    "gen": "ref",
                    "name": "scalar"
