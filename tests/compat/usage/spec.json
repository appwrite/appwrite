{
  "lib": "usage",
  "description": "utopia-php/usage: events and gauges written in batches and read as rows, totals, time series and dimensional breakdowns over ClickHouse (with a routed daily rollup and projections) or a utopia-php/database collection; the in-memory accumulator, the tenant view and canonical samples.",
  "complete": false,
  "php": {
    "src": [
      "packages/usage/src"
    ],
    "tests": [
      "packages/usage/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/usage"
  },
  "services": [
    "usage-clickhouse",
    "database-mariadb"
  ],
  "state": [],
  "scrub": [
    {
      "kind": "now",
      "seconds": 1209600,
      "reason": "rows written without a time carry the time they were written, and cases that route by today's date use windows of days around it; fixed-date cases use 2025 dates, far outside the window"
    }
  ],
  "ops": {
    "clickhouse.new": {
      "doc": "new ClickHouse(host, username, password, port, secure, namespace:, database:, sharedTables:, asyncInserts:, asyncInsertWait:, dualReadSampleRate:, retention:) on service `usage-clickhouse` (host, port, username, password override it), as a handle",
      "services": [
        "usage-clickhouse"
      ],
      "covers": [
        "Utopia\\Usage\\Adapter\\ClickHouse::__construct"
      ]
    },
    "database.new": {
      "doc": "new Database(utopia Database on MariaDB (service `database-mariadb`), database `database`, namespace `namespace` (utopia_usage), created unless `create` is false), as a handle",
      "services": [
        "database-mariadb"
      ],
      "covers": [
        "Utopia\\Usage\\Adapter\\Database::__construct"
      ]
    },
    "recording.new": {
      "doc": "a fixture adapter recording every call (addBatch() returns `succeed`), as a handle: the tests' RecordingAdapter and TenantRecordingAdapter, an adapter implemented outside the library"
    },
    "recording.succeed": {
      "doc": "sets what the recording adapter's addBatch() returns"
    },
    "recording.calls": {
      "doc": "the calls recorded since the last recording.calls: {method, tenant} or {method: addBatch, type, batchSize, metrics: [{tenant, metric, value, tags, allowNegative, time?}], succeed}"
    },
    "usage.new": {
      "doc": "new Usage(adapter), as a handle",
      "covers": [
        "Utopia\\Usage\\Usage::__construct"
      ]
    },
    "usage.adapter": {
      "doc": "$usage->getAdapter()->getName()",
      "covers": [
        "Utopia\\Usage\\Usage::getAdapter",
        "Utopia\\Usage\\Adapter\\ClickHouse::getName",
        "Utopia\\Usage\\Adapter\\Database::getName"
      ]
    },
    "usage.health_check": {
      "doc": "$usage->healthCheck()",
      "covers": [
        "Utopia\\Usage\\Usage::healthCheck",
        "Utopia\\Usage\\Adapter\\ClickHouse::healthCheck",
        "Utopia\\Usage\\Adapter\\Database::healthCheck"
      ],
      "mask": {
        "paths": [
          "/host",
          "/port",
          "/uptime",
          "/response_time"
        ],
        "reason": "each runtime reaches the shared ClickHouse at its own address; uptime and the response time are timing"
      }
    },
    "usage.setup": {
      "doc": "$usage->setup()",
      "covers": [
        "Utopia\\Usage\\Usage::setup",
        "Utopia\\Usage\\Adapter\\ClickHouse::setup",
        "Utopia\\Usage\\Adapter\\Database::setup"
      ]
    },
    "usage.add_batch": {
      "doc": "$usage->addBatch(metrics, type, batch_size)",
      "covers": [
        "Utopia\\Usage\\Usage::addBatch",
        "Utopia\\Usage\\Adapter\\ClickHouse::addBatch",
        "Utopia\\Usage\\Adapter\\Database::addBatch"
      ]
    },
    "usage.add_samples": {
      "doc": "$usage->addSamples(samples (as sample.new takes them), batch_size)",
      "covers": [
