{
  "lib": "client",
  "description": "utopia-php/client: an HTTP client on cURL (and Swoole): request defaults, the wire request it sends, response parsing and decoding, redirects, destinations, timeouts, TLS, connection reuse, streaming, retries with backoff and pooling, against a raw HTTP/1.1 fixture server.",
  "complete": true,
  "php": {
    "src": [
      "packages/client/src"
    ],
    "tests": [
      "packages/client/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/client"
  },
  "services": [
    "client-http",
    "client-https"
  ],
  "state": [],
  "ops": {
    "uri.parse": {
      "doc": "Utopia\\Psr7\\Uri::parse(uri) and its getters, as the client parses request, base and redirect URIs: {scheme, userInfo, host, port, path, query, fragment, authority, string}",
      "covers": [],
      "fuzz": [
        {
          "name": "uris",
          "args": {
            "gen": "object",
            "fields": {
              "uri": {
                "gen": "ref",
                "name": "uri"
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "redirect.resolve": {
      "doc": "(string) Redirect::resolve(Uri::parse(base), location)",
      "covers": [
        "Utopia\\Client\\Redirect::resolve"
      ],
      "fuzz": [
        {
          "name": "locations",
          "args": {
            "gen": "object",
            "fields": {
              "base": {
                "gen": "pick",
                "from": [
                  "http://example.test/a/b/c?q=1",
                  "https://example.test:8443/a/",
                  "http://example.test",
                  "http://example.test/a"
                ]
              },
              "location": {
                "gen": "ref",
                "name": "uri"
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "redirect.remove_dot_segments": {
      "doc": "Redirect::removeDotSegments(path)",
      "covers": [
        "Utopia\\Client\\Redirect::removeDotSegments"
      ],
      "fuzz": [
        {
          "name": "paths",
          "args": {
            "gen": "object",
            "fields": {
              "path": {
                "gen": "ref",
                "name": "path"
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "redirect.origin": {
      "doc": "{same: Redirect::isSameOrigin(from, to), strip: Redirect::shouldStripSensitiveHeaders(from, to)}",
      "covers": [
        "Utopia\\Client\\Redirect::isSameOrigin",
        "Utopia\\Client\\Redirect::shouldStripSensitiveHeaders"
      ],
      "fuzz": [
        {
          "name": "origins",
          "args": {
            "gen": "object",
            "fields": {
              "from": {
                "gen": "ref",
                "name": "uri"
              },
              "to": {
                "gen": "ref",
                "name": "uri"
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "redirect.without_sensitive_headers": {
      "doc": "Redirect::withoutSensitiveHeaders(request with headers [[name, value]])->getHeaders() as [[name, [values]]]",
      "covers": [
        "Utopia\\Client\\Redirect::withoutSensitiveHeaders"
      ],
      "fuzz": [
        {
          "name": "headers",
          "args": {
            "gen": "object",
            "fields": {
              "headers": {
                "gen": "ref",
                "name": "headers"
              }
            }
          },
          "iterations": 1000
        }
      ]
    },
    "redirect.is_redirect": {
      "doc": "Redirect::isRedirect(response {status, headers})",
      "covers": [
        "Utopia\\Client\\Redirect::isRedirect"
      ],
      "fuzz": [
        {
          "name": "responses",
          "args": {
            "gen": "object",
            "fields": {
              "status": {
                "gen": "int",
                "min": 100,
                "max": 599
              },
              "headers": {
                "gen": "array",
                "items": {
                  "gen": "array",
                  "items": {
                    "gen": "pick",
                    "from": [
                      "Location",
                      "location",
                      "X",
                      "",
                      "/x",
                      " "
                    ]
                  },
                  "min": 2,
                  "max": 2
                },
                "min": 0,
                "max": 2
              }
            }
          },
          "iterations": 1000
        }
      ]
    },
    "iprange.contains": {
      "doc": "new IPRange(range), then contains(address) for each of `addresses`",
      "covers": [
        "Utopia\\Client\\Destinations\\IPRange::__construct",
        "Utopia\\Client\\Destinations\\IPRange::contains"
      ],
      "fuzz": [
        {
          "name": "ranges",
          "args": {
            "gen": "object",
            "fields": {
              "range": {
                "gen": "ref",
                "name": "range"
              },
              "addresses": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "ip"
                },
                "min": 0,
                "max": 4
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "destinations.allows": {
      "doc": "{allows: [allows(address) for each of `addresses`], proxy: permitsProxy()} of `destinations`: {type: anywhere} | {type: public, also: [ranges]}",
      "covers": [
        "Utopia\\Client\\Destinations\\Anywhere::allows",
        "Utopia\\Client\\Destinations\\Anywhere::permitsProxy",
        "Utopia\\Client\\Destinations\\PublicInternet::__construct",
        "Utopia\\Client\\Destinations\\PublicInternet::allows",
        "Utopia\\Client\\Destinations\\PublicInternet::permitsProxy"
      ],
      "fuzz": [
        {
          "name": "addresses",
          "args": {
            "gen": "object",
            "fields": {
              "destinations": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "const",
                    "value": {
                      "type": "public"
                    }
                  },
                  {
                    "gen": "const",
                    "value": {
                      "type": "anywhere"
                    }
                  },
                  {
                    "gen": "object",
                    "fields": {
                      "type": {
                        "gen": "const",
                        "value": "public"
                      },
                      "also": {
                        "gen": "array",
                        "items": {
                          "gen": "pick",
                          "from": [
                            "10.0.0.0/8",
                            "::1",
                            "127.0.0.0/8",
                            "fc00::/7",
                            "0.0.0.0/0"
                          ]
                        },
                        "min": 1,
                        "max": 2
                      }
                    }
                  }
                ]
              },
              "addresses": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "ip"
                },
                "min": 1,
                "max": 5
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "backoff.delay": {
      "doc": "new Backoff(strategy {max_attempts, base_delay, max_delay, multiplier}, fn () => strategy.random)->delay(request with `method`, attempt, response {status, headers} or null, new <error>(request, 'failure') or null)",
      "covers": [
        "Utopia\\Client\\Decorator\\Retry\\Backoff::__construct",
        "Utopia\\Client\\Decorator\\Retry\\Backoff::delay"
      ],
      "fuzz": [
        {
          "name": "responses",
          "args": {
            "gen": "object",
            "fields": {
              "strategy": {
                "gen": "object",
                "fields": {
                  "random": {
                    "gen": "float",
                    "min": 0,
                    "max": 1
                  },
                  "max_attempts": {
                    "gen": "int",
                    "min": -1,
                    "max": 6
                  },
                  "base_delay": {
                    "gen": "float",
                    "min": 0,
                    "max": 2
                  },
                  "max_delay": {
                    "gen": "float",
                    "min": 0,
                    "max": 20
                  },
                  "multiplier": {
                    "gen": "float",
                    "min": 0,
                    "max": 4
                  }
                }
              },
              "method": {
                "gen": "pick",
                "from": [
                  "GET",
                  "HEAD",
                  "PUT",
                  "DELETE",
                  "OPTIONS",
                  "TRACE",
                  "POST",
                  "PATCH",
                  "get"
                ]
              },
              "attempt": {
                "gen": "int",
                "min": 0,
                "max": 8
              },
              "response": {
                "gen": "object",
                "fields": {
                  "status": {
                    "gen": "pick",
                    "from": [
                      200,
                      301,
                      404,
                      429,
                      500,
                      502,
                      503,
                      504
                    ]
                  },
                  "headers": {
                    "gen": "array",
                    "items": {
                      "gen": "array",
                      "items": {
                        "gen": "one_of",
                        "of": [
                          {
                            "gen": "pick",
                            "from": [
                              "Retry-After"
                            ]
                          },
                          {
                            "gen": "string",
                            "alphabet": "0123456789.e- +xa",
                            "min": 0,
                            "max": 6,
                            "tricky": 0.4
                          }
                        ]
                      },
                      "min": 2,
                      "max": 2
                    },
                    "min": 0,
                    "max": 2
                  }
                }
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "errors",
          "args": {
            "gen": "object",
            "fields": {
              "strategy": {
                "gen": "object",
                "fields": {
                  "random": {
                    "gen": "float",
                    "min": 0,
                    "max": 1
                  }
                }
              },
              "method": {
                "gen": "pick",
                "from": [
                  "GET",
                  "POST",
                  "DELETE",
                  "TRACE"
                ]
              },
              "attempt": {
                "gen": "int",
                "min": 0,
                "max": 4
              },
              "error": {
                "gen": "pick",
                "from": [
                  "RequestException",
                  "AdapterInitializationException",
                  "AdapterPreconditionException",
                  "InvalidResponseException",
                  "InvalidUriException",
                  "NetworkException",
                  "ConnectionException",
                  "DestinationException",
                  "DnsException",
                  "ProtocolException",
                  "ProxyException",
                  "TimeoutException",
                  "TlsException"
                ]
              }
            }
          },
          "iterations": 1000
        }
      ]
    },
    "exception.kind": {
      "doc": "{client, network, request}: whether new Utopia\\Client\\Exception\\<class>(request, 'failure') is a PSR-18 ClientExceptionInterface, NetworkExceptionInterface, RequestExceptionInterface",
      "covers": [
        "Utopia\\Client\\Exception\\NetworkException::__construct",
        "Utopia\\Client\\Exception\\RequestException::__construct"
      ]
    },
    "response.build": {
      "doc": "(new Builder(new Response\\Factory(), new Stream\\Factory()))->build(status, reason, headers grouped by name, body, protocol) as {protocol, status, reason, headers, body}",
      "covers": [
        "Utopia\\Client\\Response\\Builder::__construct",
        "Utopia\\Client\\Response\\Builder::build"
      ],
      "fuzz": [
        {
          "name": "responses",
          "args": {
            "gen": "object",
            "fields": {
              "status": {
                "gen": "int",
                "min": 100,
                "max": 599
              },
              "reason": {
                "gen": "string",
                "alphabet": "ascii",
                "min": 0,
                "max": 10,
                "tricky": 0.1
              },
              "headers": {
                "gen": "ref",
                "name": "headers"
              },
              "body": {
                "gen": "bytes",
                "min": 0,
                "max": 16
              },
              "protocol": {
                "gen": "pick",
                "from": [
                  "1.0",
                  "1.1",
                  "2"
                ]
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "client.new": {
      "doc": "new Client(new Curl() or new Retry(new Curl(), backoff(retry), recorded sleep), destinations?), then each [setting, value] of `with`: destinations, timeout, connect_timeout, ssl_verification, custom_ca, certificate [cert, key, pass], min_tls (Tls case name), connection_reuse, follow_redirects [enabled, hops], headers, base_uri, basic_auth [user, pass], bearer_auth, trace; a handle",
      "covers": [
        "Utopia\\Client\\Client::__construct",
        "Utopia\\Client\\Client::withDestinations",
        "Utopia\\Client\\Client::withTimeout",
        "Utopia\\Client\\Client::withConnectTimeout",
        "Utopia\\Client\\Client::withSslVerification",
        "Utopia\\Client\\Client::withCustomCA",
        "Utopia\\Client\\Client::withCertificate",
        "Utopia\\Client\\Client::withMinTlsVersion",
        "Utopia\\Client\\Client::withConnectionReuse",
        "Utopia\\Client\\Client::withFollowRedirects",
        "Utopia\\Client\\Client::withHeaders",
        "Utopia\\Client\\Client::withBaseUri",
        "Utopia\\Client\\Client::withBasicAuth",
        "Utopia\\Client\\Client::withBearerAuth",
        "Utopia\\Client\\Client::withTracePropagation",
        "Utopia\\Client\\Adapter\\Curl\\Client::__construct",
        "Utopia\\Client\\Adapter\\Curl\\Client::withDestinations",
        "Utopia\\Client\\Adapter\\Curl\\Client::withTimeout",
        "Utopia\\Client\\Adapter\\Curl\\Client::withConnectTimeout",
        "Utopia\\Client\\Adapter\\Curl\\Client::withSslVerification",
        "Utopia\\Client\\Adapter\\Curl\\Client::withCustomCA",
        "Utopia\\Client\\Adapter\\Curl\\Client::withCertificate",
        "Utopia\\Client\\Adapter\\Curl\\Client::withMinTlsVersion",
        "Utopia\\Client\\Adapter\\Curl\\Client::withConnectionReuse",
        "Utopia\\Client\\Adapter\\Curl\\Client::withFollowRedirects",
        "Utopia\\Client\\Decorator\\Retry::__construct",
        "Utopia\\Client\\Decorator::__construct",
        "Utopia\\Client\\Decorator::withTimeout",
        "Utopia\\Client\\Decorator::withConnectTimeout",
        "Utopia\\Client\\Decorator::withSslVerification",
        "Utopia\\Client\\Decorator::withCustomCA",
        "Utopia\\Client\\Decorator::withCertificate",
        "Utopia\\Client\\Decorator::withMinTlsVersion",
        "Utopia\\Client\\Decorator::withDestinations",
        "Utopia\\Client\\Decorator::withConnectionReuse",
        "Utopia\\Client\\Decorator::withFollowRedirects"
      ]
    },
    "client.send": {
      "doc": "$client->sendRequest(request {method, uri, headers [[name, value]], body | {repeat, times} | file}) as {protocol, status, reason, headers [[name, [values]]], body}, plus `sleeps` a Retry recorded",
      "covers": [
        "Utopia\\Client\\Client::sendRequest",
        "Utopia\\Client\\Adapter\\Curl\\Client::sendRequest",
        "Utopia\\Client\\Decorator\\Retry::sendRequest",
        "Utopia\\Client\\Decorator::sendRequest"
      ],
      "fuzz": [
        {
          "name": "requests",
          "args": {
            "gen": "object",
            "fields": {
              "request": {
                "gen": "object",
                "fields": {
                  "method": {
                    "gen": "pick",
                    "from": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "HEAD",
                      "OPTIONS",
                      "PURGE",
                      "post"
                    ]
                  },
                  "uri": {
                    "gen": "concat",
                    "parts": [
                      {
                        "gen": "const",
                        "value": "http://${http}/echo"
                      },
                      {
                        "gen": "pick",
                        "from": [
                          "",
                          "?a=1",
                          "/x/../y",
                          "?q=a b",
                          "#f"
                        ]
                      }
                    ]
                  },
                  "headers": {
                    "gen": "ref",
                    "name": "headers"
                  },
                  "body": {
                    "gen": "one_of",
                    "of": [
                      {
                        "gen": "bytes",
                        "min": 0,
                        "max": 24
                      },
                      {
                        "gen": "string",
                        "alphabet": "ascii",
                        "min": 0,
                        "max": 24,
                        "tricky": 0.3
                      }
                    ]
                  }
                }
              }
            }
          },
          "iterations": 300
        },
        {
          "name": "responses",
          "args": {
            "gen": "object",
            "fields": {
              "request": {
                "gen": "object",
                "fields": {
                  "method": {
                    "gen": "pick",
                    "from": [
                      "GET",
                      "HEAD"
                    ]
                  },
                  "raw": {
                    "gen": "ref",
                    "name": "raw"
                  }
                }
              }
            }
          },
          "iterations": 400
        }
      ]
    },
    "client.stream": {
      "doc": "$client->stream(request, sink): the response (its body empty) and `streamed`, what reached the sink",
      "covers": [
        "Utopia\\Client\\Client::stream",
        "Utopia\\Client\\Adapter\\Curl\\Client::stream",
        "Utopia\\Client\\Decorator\\Retry::stream",
        "Utopia\\Client\\Decorator::stream"
      ],
      "fuzz": [
        {
          "name": "responses",
          "args": {
            "gen": "object",
            "fields": {
              "request": {
                "gen": "object",
                "fields": {
                  "method": {
                    "gen": "pick",
                    "from": [
                      "GET",
                      "HEAD"
                    ]
                  },
                  "raw": {
                    "gen": "ref",
                    "name": "raw"
                  }
                }
              }
            }
          },
          "iterations": 300
        }
      ]
    },
    "pool.send": {
      "doc": "new Pool(new Connections(new Stack(), 'test', size, fn () => new Curl() (counted), 0.0)), then sendRequest (or stream, with `stream`) each of `requests`: {responses, created}",
      "covers": [
        "Utopia\\Client\\Pool::__construct",
        "Utopia\\Client\\Pool::sendRequest",
        "Utopia\\Client\\Pool::stream"
      ]
    }
  },
  "generators": {
    "uri": {
      "gen": "one_of",
      "of": [
        {
          "gen": "concat",
          "parts": [
            {
              "gen": "pick",
              "from": [
                "http://",
                "https://",
                "HTTP://",
                "//",
                "",
                "ftp://",
                "http:",
                "mailto:"
              ]
            },
            {
              "gen": "string",
              "alphabet": "hostname",
              "min": 0,
              "max": 12,
              "tricky": 0.1
            },
            {
              "gen": "pick",
              "from": [
                "",
                ":80",
                ":443",
                ":8080",
                ":0",
                ":65536",
                ":x",
                "@h"
              ]
            },
            {
