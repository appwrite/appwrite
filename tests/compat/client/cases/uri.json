{
  "cases": [
    {
      "name": "parse 'http://example.com'",
      "op": "uri.parse",
      "args": {
        "uri": "http://example.com"
      },
      "expect": {
        "scheme": "http",
        "userInfo": "",
        "host": "example.com",
        "port": null,
        "path": "",
        "query": "",
        "fragment": "",
        "authority": "example.com",
        "string": "http://example.com"
      }
    },
    {
      "name": "parse 'HTTPS://User:Pass@EXAMPLE.com:443/a b/%zz?q=a b&c=%20#frag ment'",
      "op": "uri.parse",
      "args": {
        "uri": "HTTPS://User:Pass@EXAMPLE.com:443/a b/%zz?q=a b&c=%20#frag ment"
      },
      "expect": {
        "scheme": "https",
        "userInfo": "User:Pass",
        "host": "example.com",
        "port": null,
        "path": "/a%20b/%25zz",
        "query": "q=a%20b&c=%20",
        "fragment": "frag%20ment",
        "authority": "User:Pass@example.com",
        "string": "https://User:Pass@example.com/a%20b/%25zz?q=a%20b&c=%20#frag%20ment"
      }
    },
    {
