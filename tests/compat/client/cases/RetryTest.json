    },
    {
      "name": "honours retry-after from the server",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/flaky?key=${ns}:e&fail=1&status=429&retry_after=2"
