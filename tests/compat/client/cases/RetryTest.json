    {
      "name": "forwards configuration to the inner adapter",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [
              [
                "timeout",
                5
              ],
              [
                "connect_timeout",
                1
              ],
              [
                "ssl_verification",
                false
              ],
              [
                "custom_ca",
                "/tmp/compat-fs/client-certs/ca.pem"
              ],
              [
                "certificate",
                [
                  "/tmp/compat-fs/client-certs/server.pem",
                  "/tmp/compat-fs/client-certs/server.key"
                ]
              ],
              [
                "min_tls",
                "V1_2"
              ]
            ],
