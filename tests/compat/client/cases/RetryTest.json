          },
          "expect": {
            "protocol": "1.1",
            "status": 200,
            "reason": "OK",
            "headers": [
              [
                "Content-Type",
                [
                  "text/plain;charset=UTF-8"
                ]
              ],
              [
                "Content-Length",
                [
                  "10"
                ]
              ]
            ],
            "body": "ok after 2",
            "sleeps": [
              2.0
            ]
          }
        }
      ]
    },
    {
      "name": "returns the last overloaded response",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/flaky?key=${ns}:f&fail=9&status=502"
            }
          },
          "expect": {
            "protocol": "1.1",
            "status": 502,
            "reason": "Bad Gateway",
            "headers": [
              [
                "Content-Type",
