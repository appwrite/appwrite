{
  "source": "packages/client/tests/Decorator/RetryTest.php",
  "cases": [
    {
      "name": "retries transient failures until success",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/flaky?key=${ns}:a&fail=2&mode=drop"
            }
          },
          "expect": {
            "protocol": "1.1",
            "status": 200,
            "reason": "OK",
            "headers": [
              [
                "Content-Type",
                [
                  "text/plain;charset=UTF-8"
                ]
              ],
              [
                "Content-Length",
                [
                  "10"
                ]
              ]
            ],
            "body": "ok after 3",
            "sleeps": [
              0.1,
              0.2
            ]
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/count?key=${ns}:a"
            }
          },
          "expect": {
            "protocol": "1.1",
            "status": 200,
            "reason": "OK",
            "headers": [
              [
                "Content-Type",
                [
                  "text/plain;charset=UTF-8"
                ]
              ],
              [
                "Content-Length",
                [
                  "1"
                ]
              ]
            ],
            "body": "3",
            "sleeps": [
              0.1,
              0.2
            ]
          }
        }
      ]
    },
    {
      "name": "stops and rethrows after exhausting attempts",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/flaky?key=${ns}:b&fail=5&mode=drop"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Client\\Exception\\ConnectionException",
              "message": "Empty reply from server"
            }
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/count?key=${ns}:b"
            }
          },
          "expect": {
            "protocol": "1.1",
            "status": 200,
            "reason": "OK",
            "headers": [
              [
                "Content-Type",
                [
                  "text/plain;charset=UTF-8"
                ]
              ],
              [
                "Content-Length",
                [
                  "1"
                ]
              ]
            ],
            "body": "3",
            "sleeps": [
              0.1,
              0.2
            ]
          }
        }
      ]
    },
    {
      "name": "does not retry request exceptions",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "ftp://${http}/x"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Client\\Exception\\InvalidUriException",
              "message": "Requests must use an absolute URI."
            }
          }
        }
      ]
    },
    {
      "name": "does not retry non-idempotent methods",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "POST",
              "uri": "http://${http}/flaky?key=${ns}:c&fail=1&mode=drop"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Client\\Exception\\ConnectionException",
              "message": "Empty reply from server"
            }
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/count?key=${ns}:c"
            }
          },
          "expect": {
            "protocol": "1.1",
            "status": 200,
            "reason": "OK",
            "headers": [
              [
                "Content-Type",
                [
                  "text/plain;charset=UTF-8"
                ]
              ],
              [
                "Content-Length",
                [
                  "1"
                ]
              ]
            ],
            "body": "1"
          }
        }
      ]
    },
    {
      "name": "retries overloaded status responses",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
