                  "text/plain;charset=UTF-8"
                ]
              ],
              [
                "Content-Length",
                [
                  "9"
                ]
              ]
            ],
            "body": "failure 3",
            "sleeps": [
              0.1,
              0.2
            ]
          }
        }
      ]
    },
    {
      "name": "retries streams only when no bytes were delivered",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.stream",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/flaky?key=${ns}:g&fail=1&mode=drop"
            }
          },
          "expect": {
            "protocol": "1.1",
            "status": 200,
            "reason": "OK",
            "headers": [
              [
                "Content-Type",
                [
                  "text/plain;charset=UTF-8"
                ]
              ],
              [
                "Content-Length",
                [
                  "10"
                ]
              ]
            ],
            "body": "",
            "streamed": "ok after 2",
            "sleeps": [
              0.1
            ]
          }
        }
      ]
    },
    {
      "name": "does not retry streams after bytes were delivered",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.stream",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/raw?r=SFRUUC8xLjEgMjAwIE9LDQpDb250ZW50LUxlbmd0aDogMjANCg0KcGFydGlhbA%3D%3D"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Client\\Exception\\ProtocolException",
              "message": "end of response with 13 bytes missing"
            }
          }
        }
      ]
    },
    {
      "name": "retries a stream on an overloaded response",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "retry": {
              "random": 1.0
            }
          },
          "bind": "c",
