{
  "source": "packages/client/tests/ClientTest.php",
  "cases": [
    {
      "name": "passes its destination to the adapter",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [],
            "destinations": {
              "type": "public"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/echo"
            }
          },
          "mask": {
            "paths": [
              "/$error/message"
            ],
            "reason": "the message quotes the connected address, each runtime's own route to the fixture server"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Client\\Exception\\DestinationException",
              "message": "<masked>"
            }
          }
        }
      ]
    },
    {
      "name": "changing the destination reaches the adapter",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [
              [
                "destinations",
                {
                  "type": "anywhere"
                }
              ],
              [
                "timeout",
                2
              ]
            ],
            "destinations": {
              "type": "public"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.send",
          "args": {
            "client": {
              "$ref": "c"
            },
            "request": {
              "method": "GET",
              "uri": "http://${http}/echo"
            }
          },
          "expect": {
            "protocol": "1.1",
            "status": 200,
            "reason": "OK",
            "headers": [
              [
                "Content-Type",
                [
                  "application/json"
                ]
              ],
              [
                "Transfer-Encoding",
                [
                  "chunked"
                ]
              ]
            ],
            "body": "{\"method\":\"GET\",\"target\":\"/echo\",\"protocol\":\"HTTP/1.1\",\"headers\":[[\"Host\",\"${http}\"],[\"Accept\",\"*/*\"],[\"Accept-Encoding\",\"deflate, gzip, br, zstd\"]],\"body\":\"\"}"
          }
        }
      ]
    },
    {
      "name": "decorates configurable adapters",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "with": [
              [
                "timeout",
