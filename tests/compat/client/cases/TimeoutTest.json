{
  "source": "packages/client/tests/Adapter/TimeoutTest.php",
  "cases": [
    {
      "name": "timeout rejects INF",
      "op": "client.new",
      "args": {
        "with": [
          [
            "timeout",
            {
              "$float": "INF"
            }
          ]
        ]
      },
      "expect": {
        "$error": {
          "class": "ValueError",
          "message": "Timeout must be a finite number greater than or equal to zero."
        }
      }
    },
