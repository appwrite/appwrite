{
  "source": "packages/client/tests/Decorator/Retry/BackoffTest.php",
  "cases": [
    {
      "name": "retries transient transport failures",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "error": "NetworkException"
      },
      "expect": 0.1
    },
    {
      "name": "does not retry request exceptions",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "error": "InvalidUriException"
      },
      "expect": null
    },
    {
      "name": "does not retry non-idempotent methods",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "POST",
        "attempt": 1,
        "error": "NetworkException"
      },
      "expect": null
    },
    {
      "name": "does not retry successful responses",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "response": {
          "status": 200
        }
      },
      "expect": null
    },
    {
      "name": "retries overloaded status responses",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "response": {
          "status": 503
        }
      },
      "expect": 0.1
    },
    {
      "name": "stops at max attempts",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 3,
        "error": "NetworkException"
      },
      "expect": null
    },
    {
      "name": "grows the delay exponentially: attempt 2",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 2,
        "error": "NetworkException"
      },
      "expect": 0.2
    },
    {
      "name": "honours numeric retry-after capped to max delay",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "response": {
          "status": 503,
          "headers": [
            [
              "Retry-After",
              "999"
            ]
          ]
        }
      },
      "expect": 10.0
    },
    {
      "name": "ignores non-numeric retry-after",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "response": {
          "status": 503,
          "headers": [
            [
              "Retry-After",
              "Wed, 21 Oct 2025 07:28:00 GMT"
            ]
          ]
        }
      },
      "expect": 0.1
    },
    {
      "name": "applies full jitter within the ceiling",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 0.25
        },
        "method": "GET",
        "attempt": 1,
        "error": "NetworkException"
      },
      "expect": 0.025
    },
    {
      "name": "a fractional retry-after",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "response": {
          "status": 429,
          "headers": [
            [
              "Retry-After",
              " 1.5 "
            ]
          ]
        }
      },
      "expect": 1.5
    },
    {
      "name": "a negative retry-after is zero",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "response": {
          "status": 429,
          "headers": [
            [
              "Retry-After",
              "-3"
            ]
          ]
        }
      },
      "expect": 0.0
    },
    {
      "name": "retry-after on a non-retryable status",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "GET",
        "attempt": 1,
        "response": {
          "status": 500,
          "headers": [
            [
              "Retry-After",
              "1"
            ]
          ]
        }
      },
      "expect": null
    },
    {
      "name": "lowercase method is not idempotent",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0
        },
        "method": "get",
        "attempt": 1,
        "error": "TimeoutException"
      },
      "expect": null
    },
    {
      "name": "the ceiling caps the exponential growth",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0,
          "max_attempts": 20,
          "max_delay": 3.0
        },
        "method": "DELETE",
        "attempt": 10,
        "error": "DnsException"
      },
      "expect": 3.0
    },
    {
      "name": "a custom multiplier",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 0.5,
          "max_attempts": 5,
          "base_delay": 0.3,
          "multiplier": 3.0
        },
        "method": "PUT",
        "attempt": 3,
        "response": {
          "status": 502
        }
      },
      "expect": 1.3499999999999999
    },
    {
      "name": "zero max attempts never retries",
      "op": "backoff.delay",
      "args": {
        "strategy": {
          "random": 1.0,
          "max_attempts": 0
        },
        "method": "GET",
        "attempt": 1,
        "error": "NetworkException"
      },
      "expect": null
    },
