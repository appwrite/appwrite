    },
    {
      "name": "client address behind a proxy",
      "steps": [
        {
          "op": "server.run",
          "args": {
            "servers": [
              {
                "adapter": "swoole",
                "transports": [
                  "udp",
                  "tcp",
                  "http"
                ],
                "telemetry": false,
                "trustProxy": true,
                "resolver": {
                  "kind": "throw"
                }
              }
            ],
            "steps": [
              {
                "kind": "doh",
                "method": "POST",
                "body": "\u0001\u0002\u0001\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0003dev\bappwrite\u0002io\u0000\u0000\u0001\u0000\u0001",
                "contentType": "application/dns-message",
                "headers": {
                  "X-Forwarded-For": "203.0.113.7, 10.0.0.1"
                }
              },
              {
                "kind": "errors"
              }
            ]
          },
          "expect": [
            {
              "status": 200,
              "contentType": "application/dns-message",
              "body": {
                "$bytes": "AQKBAgABAAAAAAAAA2RldghhcHB3cml0ZQJpbwAAAQAB"
              }
            },
            [
              {
                "class": "Exception",
                "message": "Resolver failed for https"
              }
            ]
          ]
        }
      ]
    }
  ]
}
