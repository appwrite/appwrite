{
  "source": "packages/dns/tests/E2E/HttpTest.php",
  "cases": [
    {
      "name": "POST query",
      "steps": [
        {
          "op": "server.run",
          "args": {
            "servers": [
              {
                "adapter": "swoole",
                "transports": [
                  "udp",
                  "tcp",
                  "http"
                ]
              }
            ],
            "steps": [
              {
                "kind": "doh",
                "method": "POST",
                "body": "\u0001\u0002\u0001\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0003dev\bappwrite\u0002io\u0000\u0000\u0001\u0000\u0001",
                "contentType": "application/dns-message"
              }
            ]
          },
          "expect": [
            {
              "status": 200,
              "contentType": "application/dns-message",
              "body": {
                "$bytes": "AQKFAAABAAEAAAAAA2RldghhcHB3cml0ZQJpbwAAAQABA2RldghhcHB3cml0ZQJpbwAAAQABAAAACgAEtAwDGA=="
              }
            }
          ]
        }
      ]
    },
    {
      "name": "GET query",
      "steps": [
        {
          "op": "server.run",
          "args": {
            "servers": [
              {
                "adapter": "swoole",
                "transports": [
                  "udp",
                  "tcp",
                  "http"
                ]
              }
            ],
            "steps": [
              {
                "kind": "doh",
                "method": "GET",
                "path": "/?dns=AQMBAAABAAAAAAAAA2RldghhcHB3cml0ZQJpbwAAEAAB"
              }
            ]
          },
          "expect": [
            {
              "status": 200,
              "contentType": "application/dns-message",
              "body": {
                "$bytes": "AQOFAAABAAEAAAAAA2RldghhcHB3cml0ZQJpbwAAEAABA2RldghhcHB3cml0ZQJpbwAAEAABAAAAHgATEmF3ZXNvbWUtc2VjcmV0LWtleQ=="
              }
            }
          ]
        }
      ]
    },
    {
      "name": "large response is not truncated",
      "steps": [
        {
          "op": "server.run",
          "args": {
            "servers": [
              {
                "adapter": "swoole",
                "transports": [
                  "udp",
                  "tcp",
                  "http"
                ]
              }
            ],
            "steps": [
              {
                "kind": "doh",
                "method": "POST",
                "body": "\u0001\u0004\u0001\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0005large\tlocalhost\u0000\u0000\u0010\u0000\u0001",
                "contentType": "application/dns-message"
              }
            ]
          },
          "expect": [
            {
              "status": 200,
              "contentType": "application/dns-message",
              "body": {
                "$bytes": ""
              }
            }
          ]
        }
      ]
    },
    {
      "name": "invalid requests",
      "steps": [
        {
          "op": "server.run",
          "args": {
            "servers": [
              {
                "adapter": "swoole",
                "transports": [
                  "udp",
                  "tcp",
                  "http"
                ]
              }
            ],
            "steps": [
              {
                "kind": "doh",
                "method": "GET",
                "path": "/?dns=!!!"
              },
              {
                "kind": "doh",
                "method": "GET",
                "path": "/"
              },
              {
                "kind": "doh",
                "method": "POST",
                "body": "raw",
                "contentType": "text/plain"
              },
              {
                "kind": "doh",
                "method": "DELETE",
                "path": "/"
              }
            ]
          },
          "expect": [
            {
              "status": 400,
              "contentType": "text/html",
              "body": ""
