              "soa": {
                "name": "example.com",
                "type": 6,
                "ttl": 3600,
                "rdata": "ns1.example.com hostmaster.example.com 1 7200 3600 1209600 300"
              }
            }
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Record name 'xexample.com' does not belong to zone 'example.com'"
            }
          }
        },
