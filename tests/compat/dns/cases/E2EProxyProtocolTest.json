                "$bytes": "AEACAYUAAAEAAQAAAAADZGV2CGFwcHdyaXRlAmlvAAABAAEDZGV2CGFwcHdyaXRlAmlvAAABAAEAAAAKAAS0DAMY"
              },
              "closed": false
            }
          ]
        }
      ]
    },
