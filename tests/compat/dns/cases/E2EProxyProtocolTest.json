                "transports": [
                  "udp",
                  "proxy"
                ]
              }
            ],
            "steps": [
              {
                "kind": "raw",
                "transport": "proxy",
                "data": "PROXY TCP4 203.0.113.9 10.0.0.1 42424 53\r\n\u0000!\u0002\u0001\u0001\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0003dev\bappwrite\u0002io\u0000\u0000\u0001\u0000\u0001",
                "frames": 1
