{
  "source": "packages/dns/tests/Message/HeaderTest.php",
  "cases": [
    {
      "name": "encode decode round trip",
      "steps": [
        {
          "op": "header.encode",
          "args": {
            "header": {
              "id": 4660,
              "isResponse": true,
              "opcode": 0,
              "authoritative": false,
              "truncated": true,
              "recursionDesired": true,
              "recursionAvailable": true,
              "responseCode": 0,
              "questionCount": 1,
              "answerCount": 2,
              "authorityCount": 3,
              "additionalCount": 4
            }
          },
          "bind": "bin",
          "expect": {
            "$bytes": "EjSDgAABAAIAAwAE"
          }
        },
        {
          "op": "header.decode",
          "args": {
            "data": {
              "$ref": "bin"
            }
          },
          "expect": {
            "id": 4660,
            "isResponse": true,
            "opcode": 0,
            "authoritative": false,
            "truncated": true,
            "recursionDesired": true,
            "recursionAvailable": true,
            "responseCode": 0,
            "questionCount": 1,
            "answerCount": 2,
            "authorityCount": 3,
            "additionalCount": 4
          }
        }
      ]
    },
    {
      "name": "decode throws on short data",
      "steps": [
        {
          "op": "header.decode",
          "args": {
            "data": "\u0000\u0001"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\DNS\\Exception\\Message\\DecodingException",
              "message": "DNS header too short"
            }
          }
        }
      ]
    },
    {
