{
  "source": "packages/dns/tests/Message/RecordTest.php",
  "cases": [
    {
      "name": "encode A record matches bytes",
      "steps": [
        {
          "op": "record.encode",
          "args": {
            "record": {
              "name": "example.com",
              "type": 1,
              "ttl": 300,
              "rdata": "93.184.216.34",
              "class": 1
            }
          },
          "expect": {
            "$bytes": "B2V4YW1wbGUDY29tAAABAAEAAAEsAARduNgi"
          }
        }
      ]
    },
    {
      "name": "decode A record parses fields",
      "steps": [
        {
          "op": "record.decode",
          "args": {
            "data": {
              "$bytes": "B2V4YW1wbGUDY29tAAABAAEAAAEsAARduNgi"
            }
          },
          "expect": {
            "record": {
              "name": "example.com",
              "type": 1,
              "class": 1,
              "ttl": 300,
              "rdata": "93.184.216.34",
              "priority": null,
              "weight": null,
              "port": null
            },
            "offset": 27
          }
        }
      ]
    },
