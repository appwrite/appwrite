{
  "source": "packages/dns/tests/Message/QuestionTest.php",
  "cases": [
    {
      "name": "constructor sets name",
      "steps": [
        {
          "op": "question.new",
          "args": {
            "question": {
              "name": "www.example.com",
              "type": 1,
              "class": 1
            }
          },
          "expect": {
            "name": "www.example.com",
            "type": 1,
            "class": 1
          }
        }
      ]
    },
    {
      "name": "constructor sets name case insensitive",
      "steps": [
        {
          "op": "question.new",
          "args": {
            "question": {
              "name": "WWW.EXAMPLE.COM",
              "type": 1,
              "class": 1
            }
          },
          "expect": {
            "name": "www.example.com",
            "type": 1,
            "class": 1
          }
        }
      ]
    },
    {
      "name": "encode produces exact bytes",
      "steps": [
        {
          "op": "question.encode",
          "args": {
            "question": {
              "name": "www.example.com",
              "type": 1,
              "class": 1
            }
          },
          "expect": "\u0003www\u0007example\u0003com\u0000\u0000\u0001\u0000\u0001"
        }
      ]
    },
    {
      "name": "decode parses expected fields",
      "steps": [
        {
          "op": "question.decode",
          "args": {
            "data": "\u0003api\u0007example\u0003com\u0000\u0000\u001c\u0000\u0001"
          },
          "expect": {
            "question": {
              "name": "api.example.com",
              "type": 28,
              "class": 1
            },
            "offset": 21
          }
        }
      ]
    },
    {
      "name": "decode handles compression pointer",
      "steps": [
        {
          "op": "question.decode",
          "args": {
            "data": {
              "$bytes": "BWZpcnN0B2V4YW1wbGUDY29tAAABAAHAAAAcAAE="
            },
            "offset": 0
          },
          "expect": {
            "question": {
              "name": "first.example.com",
              "type": 1,
              "class": 1
            },
            "offset": 23
          }
        },
        {
          "op": "question.decode",
          "args": {
            "data": {
              "$bytes": "BWZpcnN0B2V4YW1wbGUDY29tAAABAAHAAAAcAAE="
            },
            "offset": 23
          },
          "expect": {
            "question": {
              "name": "first.example.com",
              "type": 28,
              "class": 1
            },
            "offset": 29
          }
        }
      ]
    },
    {
      "name": "constructor trims whitespace from name",
      "steps": [
        {
          "op": "question.new",
          "args": {
            "question": {
              "name": "  www.example.com  ",
              "type": 1,
              "class": 1
            }
          },
          "expect": {
            "name": "www.example.com",
            "type": 1,
            "class": 1
          }
        }
      ]
    },
    {
      "name": "constructor trims tabs and newlines from name",
      "steps": [
        {
          "op": "question.new",
          "args": {
            "question": {
              "name": "\t\nwww.example.com\r\n",
              "type": 1,
              "class": 1
            }
          },
          "expect": {
            "name": "www.example.com",
            "type": 1,
            "class": 1
          }
        }
      ]
    },
    {
      "name": "edge cases",
      "steps": [
        {
          "op": "question.decode",
          "args": {
            "data": "\u0001a\u0000\u0000\u0001\u0000"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\DNS\\Exception\\Message\\DecodingException",
              "message": "Question section truncated"
            }
          }
        },
        {
          "op": "question.decode",
          "args": {
            "data": "\u0005ab"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\DNS\\Exception\\Message\\DecodingException",
              "message": "Label length exceeds remaining data while decoding domain name"
            }
          }
        },
        {
          "op": "question.new",
          "args": {
            "question": {
              "name": "\u0000Mixed.Case\u000b",
              "type": 28,
              "class": 3
            }
          },
          "expect": {
            "name": "mixed.case",
            "type": 28,
            "class": 3
          }
        },
        {
          "op": "question.encode",
          "args": {
            "question": {
              "name": "",
              "type": 1
            }
          },
          "expect": "\u0000\u0000\u0001\u0000\u0001"
        },
        {
          "op": "question.encode",
          "args": {
            "question": {
              "name": "a..b",
              "type": 1
            }
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Domain labels must not be empty"
            }
          }
        },
        {
          "op": "question.encode",
          "args": {
            "question": {
              "name": {
                "$bytes": "w6kuY29t"
              },
              "type": 65535,
              "class": 255
            }
          },
          "expect": {
            "$bytes": "AsOpA2NvbQD//wD/"
          }
        }
      ]
    }
  ]
}
