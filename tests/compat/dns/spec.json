    "peer.serve": {
      "doc": "interop: serves the fixture zones where the other runtime's client reaches them, and names the runtime (Rust: a Network server on `dns-rust-server`, kept until the session resets; PHP: tests/compat/dns/services.sh runs its server, `dns-php-server`)"
    },
    "peer.run": {
      "doc": "interop: server.run's steps against the server of the runtime `peer.serve` named, at `dns-<runtime>-server` (UDP and TCP on its port, HTTP on the next, PROXY-protocol TCP on the one after)"
    }
