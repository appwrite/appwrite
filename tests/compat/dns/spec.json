    "record": {
      "gen": "object",
      "fields": {
        "name": {
          "gen": "pick",
          "from": [
            "a.test",
            "A.Test",
            "",
            "x..y",
            " padded "
          ]
        },
        "type": {
          "gen": "pick",
          "from": [
            1,
            2,
            5,
            6,
            12,
            15,
            16,
            28,
            33,
            257,
            99,
            0
          ]
        },
        "ttl": {
          "gen": "int",
          "min": -5,
          "max": 5000000000
        },
        "rdata": {
          "gen": "ref",
          "name": "rdata"
        },
        "priority": {
          "gen": "one_of",
          "of": [
            {
              "gen": "null"
            },
            {
              "gen": "int",
              "min": -2,
              "max": 70000
            }
          ]
        },
        "weight": {
          "gen": "one_of",
          "of": [
            {
              "gen": "null"
            },
            {
              "gen": "int",
              "min": -2,
              "max": 70000
            }
          ]
        },
        "port": {
          "gen": "one_of",
          "of": [
            {
              "gen": "null"
            },
            {
              "gen": "int",
              "min": -2,
              "max": 70000
            }
          ]
        }
      }
    },
    "rdata": {
      "gen": "one_of",
      "of": [
        {
          "gen": "pick",
          "from": [
            "1.2.3.4",
            "256.1.1.1",
            "1.2.3",
            "::1",
            "2001:db8::1",
            "::ffff:1.2.3.4",
            "host.test",
            "",
            "0aff",
            "zz",
            "0 issue \"x\"",
            "128 issuewild \"a;b\"",
            "issue \"x\"",
            "0 issue \"a\\\"b\"",
            "5 \"x\"",
            "ns hm 1 2 3 4 5",
            "( ns hm 1 2 3 4 5 )",
            "ns a@b 1 2 3 4 5",
            "ns hm 1 2 3 4 4294967296",
            "ns hm 1 2 3",
            "a..b"
