{
  "lib": "dns",
  "description": "utopia-php/dns: the DNS message codec (headers, names with compression, questions, records), zones and zone files, the zone resolver, the Memory and Proxy resolvers, the PROXY protocol, the server over the Native and Swoole adapters (Rust: Network) on UDP, TCP and DNS over HTTPS, the client, the recursive lookup and the Name, CAA and DNS validators. Servers run on local ports; no public resolver is ever queried.",
  "complete": true,
  "php": {
    "src": [
      "packages/dns/src"
    ],
    "tests": [
      "packages/dns/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/dns"
  },
  "services": [],
  "state": [],
  "ops": {
    "header.new": {
      "doc": "new Header(...): its fields (opcode and response code checked)",
      "covers": [
        "Utopia\\DNS\\Message\\Header::__construct"
      ]
    },
    "header.encode": {
      "doc": "new Header(...)->encode()",
      "covers": [
        "Utopia\\DNS\\Message\\Header::encode"
      ]
    },
    "header.decode": {
      "doc": "Header::decode(data, offset)",
      "covers": [
        "Utopia\\DNS\\Message\\Header::decode"
      ],
      "fuzz": [
        {
          "name": "bytes",
          "args": {
            "gen": "object",
            "fields": {
              "data": {
                "gen": "bytes",
                "min": 0,
                "max": 16
              },
              "offset": {
                "gen": "int",
                "min": 0,
                "max": 4
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "domain.encode": {
      "doc": "Domain::encode(name)",
      "covers": [
        "Utopia\\DNS\\Message\\Domain::encode"
      ],
      "fuzz": [
        {
          "name": "names",
          "args": {
            "gen": "object",
            "fields": {
              "name": {
                "gen": "ref",
                "name": "name"
              }
            }
          },
          "iterations": 4000
        },
        {
          "name": "long names",
          "args": {
            "gen": "object",
            "fields": {
              "name": {
                "gen": "repeat",
                "part": {
                  "gen": "string",
                  "alphabet": "ab",
                  "min": 0,
                  "max": 70
                },
                "sep": ".",
                "min": 1,
                "max": 6
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "domain.decode": {
      "doc": "Domain::decode(data, offset): {name, offset}",
      "covers": [
        "Utopia\\DNS\\Message\\Domain::decode"
      ],
      "fuzz": [
        {
          "name": "bytes",
          "args": {
            "gen": "object",
            "fields": {
              "data": {
                "gen": "bytes",
                "min": 0,
                "max": 24
              },
              "offset": {
                "gen": "int",
                "min": 0,
                "max": 6
              }
            }
          },
          "iterations": 5000
        },
        {
          "name": "labels",
          "args": {
            "gen": "object",
            "fields": {
              "data": {
                "gen": "ref",
                "name": "labels"
              },
              "offset": {
