  "deviations": [
    {
      "symbol": "Utopia\\DNS\\Message\\Record::__construct",
      "php": "`$type` and `$class` are any int, encoded as their low 16 bits by pack('n').",
      "reason": "Record types and classes are u16 in Rust, as on the wire; an int outside 0..65535 cannot be passed."
    },
    {
      "symbol": "Utopia\\DNS\\Message\\Question::__construct",
      "php": "`$type` and `$class` are any int, encoded as their low 16 bits.",
      "reason": "Question types and classes are u16 in Rust, as on the wire."
    },
    {
      "symbol": "Utopia\\DNS\\Message\\Header::__construct",
      "php": "The id and counts are any int (encoded as their low 16 bits); a negative opcode or response code throws DecodingException.",
      "reason": "The id and counts are u16 and the opcode and response code u8 in Rust: values above 15 fail as in PHP, negative ones cannot be passed."
    },
    {
      "symbol": "Utopia\\DNS\\Message::response",
      "php": "`$responseCode` is any int; outside 0..15 the header constructor throws DecodingException('Response code must be 0-15').",
      "reason": "The response code is a u8: 16..255 fail as in PHP; negative codes cannot be passed."
    },
    {
      "symbol": "Utopia\\DNS\\Query::__construct",
      "php": "`$port` is any int.",
      "reason": "Query::port is a u16, as a socket reports it."
    },
    {
      "symbol": "Utopia\\DNS\\Client::__construct",
      "php": "`$port` and `$timeout` are any int (a negative timeout or port fails in the socket calls).",
      "reason": "Client::new takes a u16 port and a Duration timeout."
    },
    {
      "symbol": "Utopia\\DNS\\Validator\\DNS::isValid",
      "php": "PHP asks the server on port 53 (the port is not configurable); the validator keeps records, value, count and reason on the object.",
      "reason": "Dns::with_port sets the port (the cases run PHP's server on 127.0.0.1:53 and Rust's on a free port); Dns::check returns a DnsCheck, and DnsCheck::refuse is what a non-string does to the last one."
    },
    {
      "symbol": "Utopia\\DNS\\Adapter\\Swoole::__construct",
      "php": "Swoole starts `workers` worker processes (each calls the worker start callbacks with its id) and closes TCP connections idle for `idleTimeout` with its heartbeat; Swoole\\Tcp frames with package_max_length 65537 and dispatches a zero-length frame instead of closing the connection.",
      "reason": "The Network adapter runs every transport in one runtime, calls worker start callbacks once with id 0, and follows Native\\Tcp's limits (a zero-length frame closes the connection); the cases compare Swoole on what both PHP adapters agree on."
    },
    {
      "symbol": "Utopia\\DNS\\Adapter\\Native\\Udp::onReadable",
      "php": "Native reads datagrams into 4096 bytes: a larger query is cut.",
      "reason": "The Network UDP transport reads up to 65535 bytes, as Swoole does."
    },
    {
      "symbol": "Utopia\\DNS\\Client::query",
      "php": "Over UDP, socket_recvfrom() takes the first datagram that reaches the client's port, from any address, and only its 16-bit transaction id is checked: a spoofed packet that guesses the id is accepted as the answer.",
      "reason": "Rust drops datagrams that do not come from the queried server's address and keeps waiting until the same deadline, so a spoofed answer is never decoded. An exchange with the real server is unchanged (the socket stays unconnected, so errors and timeouts read as in PHP)."
    }
  ]
