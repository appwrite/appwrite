        "Utopia\\DNS\\Zone\\Resolver::lookup"
      ],
      "fuzz": [
        {
          "name": "questions",
          "args": {
            "gen": "object",
            "fields": {
              "zone": {
                "gen": "ref",
                "name": "zone"
              },
              "query": {
                "gen": "object",
                "fields": {
                  "header": {
                    "gen": "const",
                    "value": {
                      "id": 9,
                      "recursionDesired": true,
                      "questionCount": 1
                    }
                  },
                  "questions": {
                    "gen": "array",
                    "items": {
                      "gen": "object",
                      "fields": {
                        "name": {
                          "gen": "ref",
                          "name": "qname"
                        },
                        "type": {
                          "gen": "pick",
                          "from": [
                            1,
                            2,
                            5,
                            6,
                            15,
                            16,
                            28,
                            33,
                            99
                          ]
                        }
                      }
                    },
                    "min": 1,
                    "max": 1
                  }
                }
              },
              "seed": {
                "gen": "int",
                "min": 0,
                "max": 1000
              }
            }
          },
          "iterations": 5000
        }
      ]
    },
