  "generators": {
    "name": {
      "gen": "one_of",
      "of": [
        {
          "gen": "string",
          "alphabet": "abAB09-_.*@ ",
          "max": 20,
          "tricky": 0.2
        },
        {
          "gen": "concat",
          "parts": [
            {
              "gen": "pick",
              "from": [
                "",
                "*.",
                "_dmarc.",
                "@",
                "-",
                " "
              ]
            },
            {
              "gen": "repeat",
              "part": {
                "gen": "string",
                "alphabet": "ab-_9",
                "min": 0,
                "max": 6
              },
              "sep": ".",
              "min": 1,
              "max": 4
            },
            {
              "gen": "pick",
              "from": [
                "",
                ".",
                "..",
                "-",
                " "
              ]
            }
          ]
        }
      ]
    },
    "labels": {
      "gen": "repeat",
      "sep": "",
      "min": 0,
      "max": 5,
      "part": {
        "gen": "pick",
        "from": [
          {
            "$bytes": "A2FiYw=="
          },
          {
            "$bytes": "AWE="
          },
          {
            "$bytes": "AA=="
          },
          {
            "$bytes": "wAA="
          },
          {
            "$bytes": "wAI="
          },
          {
            "$bytes": "wA=="
          },
          {
            "$bytes": "QA=="
          },
          {
            "$bytes": "gA=="
          },
          {
            "$bytes": "BWFi"
          },
          {
            "$bytes": "AS4="
          }
        ]
      }
    },
    "qname": {
      "gen": "concat",
      "parts": [
        {
          "gen": "pick",
          "from": [
            "",
            "www.",
            "a.b.",
            "x.",
            "sub.",
            "*.",
            "deep.sub.",
            "cn."
          ]
        },
        {
          "gen": "pick",
          "from": [
            "example.com",
            "EXAMPLE.com",
            "other.org",
            "com",
            "",
            "a.example.com",
            "example.com."
          ]
        }
      ]
