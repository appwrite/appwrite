              "headCommitAuthorEmail": "author@example.com",
              "headCommitMessage": "Test commit message",
              "headCommitUrl": "http://gitea:3000/test-owner/test-repo/commit/def456",
              "external": false,
              "pullRequestNumber": "",
              "action": "",
              "affectedFiles": [
                "file1.txt",
                "file2.txt",
                "file3.txt"
              ]
            }
          ]
        },
        {
          "op": "fixture.requests",
          "args": {},
          "expect": []
        }
