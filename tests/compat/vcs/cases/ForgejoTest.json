              "branchDeleted": false,
              "branch": "main",
              "branchUrl": "http://gitea:3000/test-owner/test-repo/src/branch/main",
              "repositoryId": "123",
              "repositoryName": "test-repo",
              "repositoryUrl": "http://gitea:3000/test-owner/test-repo",
              "installationId": "",
              "commitHash": "def456",
              "owner": "test-owner",
              "authorUrl": "http://gitea:3000/pusher-user",
