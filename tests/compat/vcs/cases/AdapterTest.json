    {
      "name": "a provider on a self-signed certificate",
      "steps": [
        {
          "op": "fixture.script",
          "args": {
            "routes": [
              {
                "method": "GET",
                "path": "/api/v1/repos/acme/site",
                "body": {
                  "id": 7,
                  "name": "site",
                  "full_name": "acme/site",
                  "private": false
                }
              }
            ]
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "vcs.new",
          "args": {
            "adapter": "gitea",
            "cache": "none"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "vcs.initialize_variables",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "installationId": "",
            "privateKey": "",
            "accessToken": "test-token-gitea"
          },
          "expect": null
        },
        {
          "op": "vcs.set_endpoint",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "endpoint": "${vcs-tls}/~${ns}/gitea"
          },
          "expect": null
        },
        {
          "op": "vcs.get_repository",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "owner": "acme",
            "repositoryName": "site"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "SSL certificate OpenSSL verify result: self-signed certificate (18) with status code 0",
              "code": 0
            }
          }
        },
        {
          "op": "vcs.set_self_signed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "selfSigned": true
          },
          "expect": null
        },
        {
          "op": "vcs.get_repository",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "owner": "acme",
            "repositoryName": "site"
          },
          "expect": {
            "id": 7,
            "name": "site",
            "full_name": "acme/site",
            "private": false,
            "pushed_at": ""
          }
        },
        {
          "op": "vcs.set_self_signed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "selfSigned": false
          },
          "expect": null
        },
        {
          "op": "vcs.get_repository",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "owner": "acme",
            "repositoryName": "site"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "SSL certificate OpenSSL verify result: self-signed certificate (18) with status code 0",
              "code": 0
            }
          }
        },
        {
          "op": "fixture.requests",
          "args": {},
          "expect": [
            {
              "provider": "gitea",
              "method": "GET",
              "target": "/api/v1/repos/acme/site",
              "headers": [
                [
                  "Host",
                  "<host>"
                ],
                [
                  "User-Agent",
                  "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/70.0.3538.77 Safari/537.36"
                ],
                [
                  "Accept",
                  "*/*"
                ],
                [
                  "content-type",
                  "application/json"
                ],
                [
                  "Authorization",
                  "token test-token-gitea"
                ]
              ],
              "body": ""
            }
          ]
        }
      ]
    }
