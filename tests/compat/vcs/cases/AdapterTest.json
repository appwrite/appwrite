{
  "source": "packages/vcs/tests/AdapterTest.php",
  "cases": [
    {
      "name": "testVerifiesCertificatesByDefault bitbucket",
      "steps": [
        {
          "op": "vcs.new",
          "args": {
            "adapter": "bitbucket",
            "cache": "none"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "vcs.is_self_signed",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testAcceptsSelfSignedCertificatesWhenOptedIn bitbucket",
      "steps": [
        {
          "op": "vcs.new",
          "args": {
            "adapter": "bitbucket",
            "cache": "none"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "vcs.set_self_signed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "selfSigned": true
          },
          "expect": null
        },
        {
          "op": "vcs.is_self_signed",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "vcs.set_self_signed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "selfSigned": false
          },
          "expect": null
        },
        {
          "op": "vcs.is_self_signed",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        }
      ]
    },
