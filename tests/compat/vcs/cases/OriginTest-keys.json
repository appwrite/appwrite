  "source": "packages/vcs/tests/OriginTest.php",
  "cases": [
    {
      "name": "testVerifyReceipt",
      "steps": [
        {
          "op": "fixture.config",
          "args": {
            "config": {
              "origin": {
                "jwks": [
                  {
                    "kty": "OKP",
                    "crv": "Ed25519",
                    "kid": "k1",
                    "x": "iojj3XQJ8ZX9UtstPLpdcspnCb8dlBIb83SIAbQPb1w"
                  }
                ]
              }
            }
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "vcs.new",
          "args": {
            "adapter": "origin",
            "endpoint": "${vcs}/~${ns}/origin",
            "web": "${vcs}/~${ns}/origin/web",
            "git": "${vcs-tls}/~${ns}/origin/git"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "vcs.verify_receipt",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "receipt": "eyJhbGciOiJFZERTQSIsImtpZCI6ImsxIiwidHlwIjoib3JpZ2luLWluc3RhbGxhdGlvbi1yZWNlaXB0K2p3dCJ9.eyJpc3MiOiJodHRwczpcL1wvYXBpLmN1cnNvci5jb21cL3YxXC9vcmlnaW4iLCJhdWQiOiJhcHBfMDEyMzQ1Njc4OSIsInN1YiI6ImlfMDEyMzQ1Njc4OSIsImlhdCI6MTc2NzIyNTYwMCwiZXhwIjo0MTAyNDQ0ODAwLCJzdGF0ZSI6IntcInByb2plY3RJZFwiOlwicDFcIn0iLCJuYW1lc3BhY2VfaWQiOiJuc18wMTIzNDU2Nzg5In0.PgNIWYkwXPM2ZQ6w1ur-0gtDreXCJ8lv8oONGqc21Qc9uG6tobmQGFHPpTr2yVrnHPBcWSz9L5PEqCCt1OAzAw",
            "appId": "app_0123456789"
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Installation receipt issuer is invalid",
              "code": 0
            }
          }
        },
        {
          "op": "fixture.requests",
          "args": {},
          "expect": [
            {
              "provider": "origin",
              "method": "GET",
              "target": "/keys",
              "headers": [
                [
                  "Host",
                  "<host>"
                ],
                [
                  "User-Agent",
                  "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/70.0.3538.77 Safari/537.36"
