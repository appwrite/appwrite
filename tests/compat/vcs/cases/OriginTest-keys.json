    {
      "name": "testGetSigningKeys",
      "steps": [
        {
          "op": "fixture.config",
          "args": {
            "config": {
              "origin": {
                "jwks": [
                  {
                    "kty": "OKP",
                    "crv": "Ed25519",
                    "kid": "k1",
                    "x": "first-key"
                  },
                  {
                    "kty": "OKP",
                    "crv": "Ed25519",
                    "kid": "k2",
                    "x": "second-key"
                  },
                  {
                    "kty": "RSA",
                    "kid": "k3",
                    "n": "not-ed25519"
                  }
                ]
              }
            }
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "vcs.new",
          "args": {
            "adapter": "origin",
            "endpoint": "${vcs}/~${ns}/origin",
            "web": "${vcs}/~${ns}/origin/web",
            "git": "${vcs-tls}/~${ns}/origin/git"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "vcs.get_signing_keys",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            "first-key",
            "second-key"
          ]
        },
        {
          "op": "vcs.get_signing_keys",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "refresh": true
          },
          "expect": [
            "first-key",
            "second-key"
          ]
        },
        {
          "op": "fixture.requests",
          "args": {},
          "expect": [
            {
              "provider": "origin",
              "method": "GET",
              "target": "/keys",
              "headers": [
                [
