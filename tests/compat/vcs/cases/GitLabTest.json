    {
      "name": "testValidateWebhookEvent",
      "steps": [
        {
          "op": "vcs.new",
          "args": {
            "adapter": "gitlab"
          },
          "bind": "a1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "vcs.validate_webhook_event",
          "args": {
            "adapter": {
              "$ref": "a1"
            },
            "payload": "{\"object_kind\":\"push\",\"action\":\"push\"}",
            "signature": "my-webhook-secret",
            "signatureKey": "my-webhook-secret"
          },
          "expect": true
        },
        {
          "op": "vcs.validate_webhook_event",
          "args": {
            "adapter": {
              "$ref": "a1"
            },
            "payload": "{\"object_kind\":\"push\",\"action\":\"push\"}",
            "signature": "not-the-signature",
            "signatureKey": "my-webhook-secret"
          },
          "expect": false
        },
        {
          "op": "vcs.validate_webhook_event",
          "args": {
            "adapter": {
              "$ref": "a1"
            },
            "payload": "{\"object_kind\":\"push\",\"action\":\"push\"}",
            "signature": "another-secret",
            "signatureKey": "my-webhook-secret"
          },
          "expect": false
        },
        {
          "op": "fixture.requests",
          "args": {},
          "expect": []
        }
      ]
