          },
          "expect": null
        },
        {
          "op": "vcs.validate_webhook_event",
          "args": {
            "adapter": {
              "$ref": "a1"
            },
            "payload": "{\"object_kind\":\"push\",\"action\":\"push\"}",
            "signature": "sha256=718af7b3d959c91dd8ea8a59d671546e2ae178b3fd6e77e4c7a37369d9fc1658",
            "signatureKey": "my-webhook-secret"
          },
          "expect": true
        },
        {
          "op": "vcs.validate_webhook_event",
          "args": {
            "adapter": {
              "$ref": "a1"
            },
            "payload": "{\"object_kind\":\"push\",\"action\":\"push\"}",
            "signature": "not-the-signature",
            "signatureKey": "my-webhook-secret"
          },
          "expect": false
        },
        {
          "op": "vcs.validate_webhook_event",
          "args": {
            "adapter": {
              "$ref": "a1"
            },
            "payload": "{\"object_kind\":\"push\",\"action\":\"push\"}",
            "signature": "sha256=d00d7b7cbe8719f0b302f4d68162b046c2a6049730dbb3247d396eb49274c2d4",
            "signatureKey": "my-webhook-secret"
          },
          "expect": false
        },
        {
          "op": "fixture.requests",
          "args": {},
          "expect": []
        }
      ]
