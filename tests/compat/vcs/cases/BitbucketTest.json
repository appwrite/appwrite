    {
      "name": "testWebhookHeaderNames",
      "steps": [
        {
          "op": "vcs.new",
          "args": {
            "adapter": "bitbucket",
            "web": "${vcs}/~${ns}/bitbucket"
          },
          "bind": "a1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "vcs.set_endpoint",
          "args": {
            "adapter": {
              "$ref": "a1"
            },
            "endpoint": "${vcs}/~${ns}/bitbucket/2.0"
          },
          "expect": null
        },
        {
          "op": "vcs.get_event_header_name",
          "args": {
            "adapter": {
              "$ref": "a1"
            }
          },
          "expect": "x-event-key"
        },
        {
          "op": "vcs.get_signature_header_name",
          "args": {
            "adapter": {
              "$ref": "a1"
            }
          },
          "expect": "x-hub-signature"
        },
        {
          "op": "fixture.requests",
          "args": {},
          "expect": []
        }
      ]
    },
