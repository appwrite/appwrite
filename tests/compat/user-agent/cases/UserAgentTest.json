      },
      "expect": {
        "raw": "Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0",
        "array": {
          "os": {
            "code": "WIN",
            "name": "Windows",
            "version": "7"
          },
          "client": {
            "type": "browser",
            "code": "FF",
            "name": "Firefox",
            "version": "47.0",
            "engine": "Gecko",
            "engineVersion": "47.0"
          },
          "device": {
            "type": "desktop",
            "brand": null,
            "model": null
          },
          "bot": null
        },
        "isBot": false,
        "osKnown": true,
        "clientKnown": true,
        "clientBrowser": true,
        "deviceKnown": true,
        "memoized": true
      }
    },
