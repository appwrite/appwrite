  "cases": [
    {
      "name": "testGet",
      "steps": [
        {
          "op": "registry.new",
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "registry.set",
          "args": {
            "registry": {
              "$ref": "r"
            },
            "name": "array",
            "factory": {
              "kind": "list",
              "value": [
                "test"
              ]
            }
          },
          "expect": null
        },
        {
          "op": "registry.push",
          "args": {
            "registry": {
              "$ref": "r"
            },
            "name": "array",
            "value": "Hello World"
          },
          "expect": null
        },
        {
          "op": "registry.get",
          "args": {
            "registry": {
              "$ref": "r"
            },
            "name": "array"
          },
          "expect": [
            "test",
            "Hello World"
          ]
        }
      ]
    },
