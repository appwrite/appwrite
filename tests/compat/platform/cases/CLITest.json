                  "deprecated": false,
                  "example": "",
                  "model": null,
                  "aliases": [],
                  "enum": null
                },
                "list": {
                  "default": null,
                  "validator": "Value must a valid array and Value must be a valid string and at least 1 chars and no longer than 256 chars",
                  "description": "List of strings",
                  "optional": false,
                  "injections": [],
                  "skipValidation": false,
                  "deprecated": false,
                  "example": "",
                  "model": null,
                  "aliases": [],
                  "enum": null
                }
              },
              "dependencies": [],
              "labels": []
            },
            {
              "key": "build2",
              "name": "build2",
              "desc": "",
              "groups": [],
              "params": {
                "email": {
                  "default": null,
                  "validator": "Value must be a valid string and at least 1 chars",
                  "description": "",
                  "optional": false,
                  "injections": [],
                  "skipValidation": false,
                  "deprecated": false,
                  "example": "",
                  "model": null,
                  "aliases": [],
                  "enum": null
                },
                "list": {
                  "default": null,
                  "validator": "Value must a valid array and Value must be a valid string and at least 1 chars and no longer than 256 chars",
                  "description": "List of strings",
                  "optional": false,
                  "injections": [],
                  "skipValidation": false,
                  "deprecated": false,
                  "example": "",
                  "model": null,
                  "aliases": [],
                  "enum": null
                }
              },
              "dependencies": [],
              "labels": []
            }
          ],
          "args": {
