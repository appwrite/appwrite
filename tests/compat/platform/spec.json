  "quirks": [
    {
      "symbol": "Utopia\\Platform\\Action::inject",
      "description": "inject() checks the name against the positions of the injections list (array_key_exists on a list), so a name like '0' is refused once an injection exists, and the same name twice is accepted (listed twice, registered once).",
      "case": "edge.json#inject checks positions, not names"
    }
  ],
  "deviations": [
    {
      "symbol": "Utopia\\Platform\\Service::getActions",
      "php": "A Service subclass that does not set $type and $actions raises Error (typed property accessed before initialization) from getType() and getActions().",
      "reason": "utopia_platform::Service::new takes the type and starts with no actions: an uninitialized service cannot be built. The compat services set both, as every subclass does."
    },
    {
      "symbol": "Utopia\\Platform\\Platform::getCli",
      "php": "getCli() before setCli() or init(TYPE_TASK), and getWorker() before setWorker() or init(TYPE_WORKER), raise Error (typed property accessed before initialization).",
      "reason": "Platform::cli() and Platform::worker() return an Option; the compat adapters report null for both."
    },
    {
      "symbol": "Utopia\\Platform\\Platform::init",
      "php": "An action without a callback fails init() with TypeError from Hook::action(null), whose message ends with ', called in <file> on line <n>'.",
      "reason": "Rust reports the same class and message without the PHP file and line; cases mask that message."
    },
    {
      "symbol": "Utopia\\Platform\\Platform::init",
      "php": "One callback serves every server: the same closure is registered as a route, a task or a job.",
      "reason": "A Callback is written for the server it runs on (Callback::Http, Task or Worker, each receiving that server's scope); one for another server counts as no callback."
    }
  ]
