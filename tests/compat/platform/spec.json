{
  "lib": "platform",
  "description": "utopia-php/platform: describe an application once as modules of services of actions (HTTP routes, CLI tasks, queue jobs and the hooks around them), then register every service of one type on its server: utopia-php/http, utopia-php/cli or utopia-php/queue.",
  "complete": true,
  "php": {
    "src": [
      "packages/platform/src"
    ],
    "tests": [
      "packages/platform/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/platform"
  },
  "services": [],
  "state": [],
  "ops": {
    "action.run": {
      "doc": "new Action() driven by `steps`, each {name: argument}: set_type, desc, groups, label {key, value}, param {key, default, default_fn, validator (see http.run's validators; {factory: spec} for a callable), description, optional, injections, skip_validation, deprecated, example, aliases, enum {name, map, exclude}}, inject, set_http_path, set_http_method, set_http_methods, http_alias (each true when it returns the action), or get: the action described (type, desc, groups, whether a callback is set, params, injections, labels, options as [key, type], getHttpPath() or its TypeError, getHttpMethod(), getHttpMethods(), getHttpAliases()). Each step's result ({\"$error\": {class, message, code}} when it throws)",
      "covers": [
        "Utopia\\Platform\\Action::setType",
        "Utopia\\Platform\\Action::getType",
        "Utopia\\Platform\\Action::desc",
        "Utopia\\Platform\\Action::getDesc",
        "Utopia\\Platform\\Action::groups",
        "Utopia\\Platform\\Action::getGroups",
        "Utopia\\Platform\\Action::callback",
        "Utopia\\Platform\\Action::getCallback",
        "Utopia\\Platform\\Action::param",
        "Utopia\\Platform\\Action::getParams",
        "Utopia\\Platform\\Action::inject",
        "Utopia\\Platform\\Action::getInjections",
        "Utopia\\Platform\\Action::label",
        "Utopia\\Platform\\Action::getLabels",
        "Utopia\\Platform\\Action::getOptions",
        "Utopia\\Platform\\Action::setHttpPath",
        "Utopia\\Platform\\Action::getHttpPath",
        "Utopia\\Platform\\Action::setHttpMethod",
        "Utopia\\Platform\\Action::getHttpMethod",
        "Utopia\\Platform\\Action::setHttpMethods",
        "Utopia\\Platform\\Action::getHttpMethods",
        "Utopia\\Platform\\Action::httpAlias",
        "Utopia\\Platform\\Action::getHttpAliases",
        "Utopia\\Platform\\Scope\\HTTP::setHttpPath",
        "Utopia\\Platform\\Scope\\HTTP::getHttpPath",
        "Utopia\\Platform\\Scope\\HTTP::setHttpMethod",
        "Utopia\\Platform\\Scope\\HTTP::getHttpMethod",
        "Utopia\\Platform\\Scope\\HTTP::setHttpMethods",
        "Utopia\\Platform\\Scope\\HTTP::getHttpMethods",
        "Utopia\\Platform\\Scope\\HTTP::httpAlias",
        "Utopia\\Platform\\Scope\\HTTP::getHttpAliases",
        "Utopia\\Platform\\Enum::__construct"
      ],
      "fuzz": [
        {
          "name": "steps",
          "args": {
            "gen": "object",
            "fields": {
              "steps": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "action_step"
                },
                "min": 1,
                "max": 12
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "service.run": {
      "doc": "A service of `type` (its $type and $actions set, as subclasses do) driven by `steps`: set_type, type, add_action {key, action (as platform.run's ACTION)}, remove_action key, action key (described as action.run's get, or null), actions (keys)",
      "covers": [
        "Utopia\\Platform\\Service::setType",
        "Utopia\\Platform\\Service::getType",
        "Utopia\\Platform\\Service::addAction",
        "Utopia\\Platform\\Service::removeAction",
        "Utopia\\Platform\\Service::getAction",
        "Utopia\\Platform\\Service::getActions"
      ],
      "fuzz": [
        {
          "name": "steps",
          "args": {
            "gen": "object",
            "fields": {
              "type": {
                "gen": "pick",
                "from": [
                  "http",
                  "Task",
                  "Worker",
                  "GraphQL"
                ]
              },
              "steps": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "service_step"
                },
                "min": 1,
                "max": 10
              }
            }
          },
          "iterations": 1500
        }
      ]
    },
    "platform.run": {
      "doc": "A platform whose core module holds the services of `core` ({services: {key: SERVICE}}; SERVICE = {type, actions: {key: ACTION}}; ACTION = {type, desc, groups, http {method, methods, path, aliases}, params, inject, labels, callback {id, statements (Harness statements, for HTTP), fail {message, code}}}), driven by `steps`: add_module MODULE, add_service {key, service}, remove_service key, service key ({type, actions} or the error), services (keys), set_cli argv, set_worker (a queue Server on an adapter that never starts), init {type, params {workerName, workers, jobs, queueName, workersNum, namespace, consumer (a consumer factory)}}, cli label-keys (the CLI's tasks described, or null before one is set), run_cli (task callbacks record [id, named arguments]; null before a CLI is set), worker label-keys (jobs with queue, coroutines, prefetch, and the worker start and stop hooks described, or null), worker_hooks start|stop (calls each hook's action; worker callbacks record [id, []]; null before a worker server exists), routes label-keys (Http::getRoutes() described), request (dispatched through Http::run(), as http.run's requests). Each step's result ({\"$error\": {class, message, code}} when it throws)",
      "covers": [
        "Utopia\\Platform\\Module::addService",
        "Utopia\\Platform\\Module::removeService",
        "Utopia\\Platform\\Module::getService",
        "Utopia\\Platform\\Module::getServices",
        "Utopia\\Platform\\Module::getServicesByType",
        "Utopia\\Platform\\Platform::__construct",
        "Utopia\\Platform\\Platform::init",
        "Utopia\\Platform\\Platform::addModule",
        "Utopia\\Platform\\Platform::addService",
        "Utopia\\Platform\\Platform::removeService",
        "Utopia\\Platform\\Platform::getService",
        "Utopia\\Platform\\Platform::getServices",
        "Utopia\\Platform\\Platform::getCli",
        "Utopia\\Platform\\Platform::setCli",
        "Utopia\\Platform\\Platform::getWorker",
        "Utopia\\Platform\\Platform::setWorker"
      ],
      "mask": {
        "paths": [
          "/*/wire/headers/x-debug-speed"
        ],
        "reason": "X-Debug-Speed is the elapsed time"
      },
      "fuzz": [
        {
          "name": "apps",
          "args": {
            "gen": "object",
            "fields": {
              "core": {
                "gen": "ref",
                "name": "module"
              },
              "steps": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "platform_step"
                },
                "min": 1,
                "max": 8
              }
            }
          },
          "iterations": 2000
        }
      ]
    }
  },
