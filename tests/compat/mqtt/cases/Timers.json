{
  "cases": [
    {
      "name": "a wheel reaps after keep-alive times the multiplier, once",
      "steps": [
        {
          "op": "wheel.new",
          "args": {
            "interval": 20,
            "multiplier": 1.5
          },
          "bind": "w",
          "expect": {
            "wheel": {
              "$handle": "*"
            },
            "interval": 20,
            "multiplier": 1.5,
            "chained": [
              true,
              true
            ]
          }
        },
        {
          "op": "wheel.schedule",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            },
            "id": 7,
            "keep_alive": 10
          },
          "expect": null
        },
        {
          "op": "wheel.schedule",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            },
            "id": 8,
            "keep_alive": 100
          },
          "expect": null
        },
        {
          "op": "wheel.drain",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            },
            "offset": 5
          },
          "expect": null
        },
        {
          "op": "wheel.log",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            }
          },
          "expect": []
        },
        {
          "op": "wheel.drain",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            },
            "offset": 30
          },
          "expect": null
        },
        {
          "op": "wheel.log",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            }
          },
          "expect": [
            [
              "tick",
              7
            ]
          ]
        },
        {
          "op": "wheel.drain",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            },
            "offset": 40
          },
          "expect": null
        },
        {
          "op": "wheel.drain",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            },
            "offset": 300
          },
          "expect": null
        },
        {
          "op": "wheel.log",
          "args": {
            "wheel": {
              "$ref": "w",
              "path": "/wheel"
            }
          },
          "expect": [
            [
              "tick",
              7
            ],
            [
              "tick",
              8
            ]
          ]
        }
      ]
    },
