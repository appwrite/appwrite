    {
      "name": "a wheel whose drained time starts in the past",
      "steps": [
        {
          "op": "wheel.new",
          "args": {
            "interval": 5,
            "multiplier": 1.0,
            "now_offset": -100
          },
          "bind": "w",
          "expect": {
