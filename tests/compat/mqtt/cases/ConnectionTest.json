    {
      "name": "publish without an adapter does nothing; with one, QoS 1 draws packet ids and tracks sequences",
      "steps": [
        {
          "op": "connection.new",
          "args": {
            "fd": 1
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "connection.publish",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "topic": "t",
            "payload": "p",
            "qos": 1,
            "sequence": 1
          },
          "expect": null
        },
        {
          "op": "connection.acknowledge",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "packet_id": 1
          },
          "expect": null
        },
        {
          "op": "memory.new",
          "args": {
            "timer": "none"
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "connection.new",
          "args": {
            "fd": 4,
            "rig": {
              "$ref": "r"
            }
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
