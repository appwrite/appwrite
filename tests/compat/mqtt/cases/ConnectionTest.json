    {
      "name": "testDisconnectSendsAReasonCodeAndStringThenCloses",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "timer": "none"
          },
          "bind": "r",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "connection.new",
          "args": {
            "fd": 9,
            "rig": {
              "$ref": "r"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "connection.set",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "protocol": 5
          },
          "expect": null
        },
        {
          "op": "connection.disconnect",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "reason": 135,
            "reason_string": "Session expired"
          },
          "expect": null
        },
        {
          "op": "memory.state",
          "args": {
            "rig": {
              "$ref": "r"
            }
          },
          "bind": "s",
          "expect": {
            "started": false,
            "open": [],
            "sent": [
              [
                9,
                {
                  "$bytes": "4BSHEh8AD1Nlc3Npb24gZXhwaXJlZA=="
                }
              ]
            ],
            "closed": [
              9
            ],
            "timer": [],
            "log": []
          }
        },
        {
          "op": "packet.parse",
          "args": {
            "data": {
              "$ref": "s",
              "path": "/sent/0/1"
            }
          },
          "bind": "p",
          "expect": {
            "type": 14,
            "flags": 0,
            "body": {
              "$bytes": "hxIfAA9TZXNzaW9uIGV4cGlyZWQ="
            },
            "name": "disconnect",
            "qos": 0,
            "dup": false
          }
        },
        {
          "op": "properties.parse",
          "args": {
            "data": {
              "$ref": "p",
              "path": "/body"
            },
            "offset": 1
          },
          "expect": {
            "properties": [
              [
                31,
                "Session expired"
              ]
            ],
            "offset": 20,
            "user": []
          }
        }
      ]
    },
