        },
        {
          "op": "connection.acknowledge",
          "args": {
            "connection": {
              "$ref": "d"
            },
            "packet_id": 2
          },
          "expect": null
        },
        {
          "op": "connection.acknowledge",
          "args": {
            "connection": {
              "$ref": "d"
            },
            "packet_id": 3
          },
          "expect": {
            "topic": "a/b",
            "sequence": 12,
            "cursor": 10
          }
