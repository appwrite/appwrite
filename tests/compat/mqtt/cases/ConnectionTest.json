{
  "source": "packages/mqtt/tests/ConnectionTest.php",
  "cases": [
    {
      "name": "testUpdateExpiresAtSetsTheDeadlineToKeepAliveTimesMultiplier",
      "steps": [
        {
          "op": "connection.new",
          "args": {
            "fd": 1
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "connection.set",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "keep_alive": 20
          },
          "expect": null
        },
        {
          "op": "connection.update_expires_at",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "now": 1000.0,
            "multiplier": 1.5
          },
          "expect": null
        },
        {
          "op": "connection.state",
          "args": {
            "connection": {
              "$ref": "c"
            }
          },
          "expect": {
            "fd": 1,
            "protocol": 4,
            "prefix": "",
            "client_id": "",
            "clean_start": true,
            "identity": null,
            "active": false,
            "keep_alive": 20,
            "expires_at": 1030.0,
            "wheel_slot": 0,
            "opened": true
          }
        }
      ]
    },
