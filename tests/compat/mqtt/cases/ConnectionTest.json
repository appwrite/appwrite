        {
          "op": "connection.publish",
          "args": {
            "connection": {
              "$ref": "d"
            },
            "topic": "a/b",
            "payload": "z",
            "qos": 0,
            "dup": true,
            "sequence": 11
          },
          "expect": null
        },
        {
          "op": "connection.set",
          "args": {
            "connection": {
              "$ref": "d"
            },
            "protocol": 5
          },
          "expect": null
        },
        {
          "op": "connection.publish",
          "args": {
            "connection": {
              "$ref": "d"
            },
            "topic": "a/b",
            "payload": "w",
            "qos": 1,
            "sequence": 12
          },
          "expect": null
        },
        {
          "op": "connection.acknowledge",
          "args": {
            "connection": {
              "$ref": "d"
            },
            "packet_id": 1
          },
          "expect": {
            "topic": "a/b",
            "sequence": 10,
            "cursor": 10
