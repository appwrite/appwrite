{
  "source": "packages/mqtt/tests/ServerTest.php",
  "cases": [
    {
      "name": "testSubscribeThatClosedTheConnectionIsNotAnswered",
      "steps": [
        {
          "op": "v5.connect",
          "args": {
            "client_id": "client-9",
            "keep_alive": 60,
            "clean_start": true
          },
          "bind": "c",
          "expect": "\u0010\u0015\u0000\u0004MQTT\u0005\u0002\u0000<\u0000\u0000\bclient-9"
        },
        {
          "op": "v5.subscribe",
          "args": {
            "packet_id": 1,
            "filters": [
              "close"
            ],
            "qos": 1
          },
          "bind": "s",
          "expect": {
            "$bytes": "ggsAAQAABWNsb3NlAQ=="
          }
        },
        {
          "op": "server.session",
          "args": {
            "open": [
              9
            ],
            "packets": [
              [
                9,
                {
                  "$ref": "c"
                }
              ],
              [
                9,
                {
                  "$ref": "s"
                }
              ]
            ]
          },
          "expect": {
            "outcomes": [
              null,
              null
            ],
            "state": {
              "started": true,
              "open": [],
              "sent": [
                [
                  9,
                  " \u0003\u0000\u0000\u0000"
                ]
              ],
              "closed": [
                9
              ],
              "timer": [
                [
                  "schedule",
                  9,
                  30
                ],
                [
                  "schedule",
                  9,
                  60
                ],
                [
                  "clear",
                  9
                ]
              ],
              "log": [
                [
                  "connect",
                  9,
                  5,
                  "client-9",
                  true,
                  60,
                  null,
                  null,
                  null,
                  null,
                  null,
                  [],
                  "client-9"
                ],
                [
                  "subscribe",
                  9,
                  1,
                  [
                    [
                      "close",
                      1
                    ]
                  ]
                ],
                [
                  "disconnect",
                  9,
                  null
                ]
              ]
            },
            "metrics": [
              [
                "counter",
                "mqtt.packets.received",
                [
                  1,
                  1
                ]
              ],
              [
                "counter",
                "mqtt.connections.opened",
                [
                  1
                ]
              ],
              [
                "up_down_counter",
                "mqtt.connections.active",
                [
                  1,
                  -1
                ]
              ]
            ]
          }
        }
      ]
    },
