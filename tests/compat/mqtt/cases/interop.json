{
  "cases": [
    {
      "name": "a v5 session over TCP",
      "steps": [
        {
          "op": "v5.connect",
          "args": {
            "client_id": "interop-5",
            "keep_alive": 60,
            "clean_start": true,
            "properties": [
              {
                "id": 21,
                "value": "test"
              },
              {
                "id": 22,
                "value": "ok"
              },
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "projectId",
                      "p1"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "connect",
          "side": "b",
          "expect": "\u00102\u0000\u0004MQTT\u0005\u0002\u0000<\u001c\u0015\u0000\u0004test\u0016\u0000\u0002ok&\u0000\tprojectId\u0000\u0002p1\u0000\tinterop-5"
        },
        {
          "op": "v5.subscribe",
          "args": {
            "packet_id": 1,
            "filters": [
              "interop/+/t"
            ],
            "qos": 1
          },
          "bind": "subscribe",
          "side": "b",
          "expect": {
            "$bytes": "ghEAAQAAC2ludGVyb3AvKy90AQ=="
          }
        },
        {
          "op": "v5.publish",
          "args": {
            "topic": "interop/a/t",
            "payload": "21.5",
            "qos": 1,
            "packet_id": 4,
            "properties": [
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "unit",
                      "C"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "publish",
          "side": "b",
          "expect": "2\u001e\u0000\u000binterop/a/t\u0000\u0004\n&\u0000\u0004unit\u0000\u0001C21.5"
        },
        {
          "op": "v5.auth",
          "args": {
            "code": 25,
            "properties": [
              {
                "id": 21,
                "value": "test"
              },
              {
                "id": 22,
                "value": "fresh"
              },
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "projectId",
                      "p1"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "reauth",
          "side": "b",
          "expect": {
            "$bytes": "8CEZHxUABHRlc3QWAAVmcmVzaCYACXByb2plY3RJZAACcDE="
          }
        },
        {
          "op": "v5.unsubscribe",
          "args": {
            "packet_id": 2,
            "filters": [
              "interop/+/t"
            ]
          },
          "bind": "unsubscribe",
          "side": "b",
          "expect": {
            "$bytes": "ohAAAgAAC2ludGVyb3AvKy90"
          }
        },
        {
          "op": "v5.disconnect",
          "args": {
            "code": 0
          },
          "bind": "disconnect",
          "side": "b",
          "expect": {
            "$bytes": "4AIAAA=="
          }
        },
        {
          "op": "broker.start",
          "args": {},
          "bind": "broker",
          "side": "a",
          "mask": {
            "paths": [
              "/runtime",
              "/tcp",
              "/ws",
              "/tls",
              "/broker"
            ],
            "reason": "where each runtime's broker listens"
          },
          "expect": {
            "runtime": "<masked>",
            "tcp": "<masked>",
            "ws": "<masked>",
            "tls": "<masked>",
            "broker": "<masked>"
          }
        },
        {
          "op": "client.session",
          "args": {
            "broker": {
              "$ref": "broker"
            },
            "steps": [
              {
                "connect": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "connect"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "subscribe"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "publish"
                }
              },
              {
                "receive": "c"
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "reauth"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "unsubscribe"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "disconnect"
                }
              },
              {
                "receive": "c"
              },
              {
                "connected": "c"
              }
            ]
          },
          "side": "b",
          "expect": [
            null,
            null,
            " \u001a\u0000\u0000\u0017\u0015\u0000\u0004test&\u0000\tprojectId\u0000\u0002p1",
            null,
            {
              "$bytes": "kAQAAQAB"
            },
            null,
            "0\u001c\u0000\u000binterop/a/t\n&\u0000\u0004unit\u0000\u0001C21.5",
            "@\u0002\u0000\u0004",
            null,
            {
              "$bytes": "8AIAAA=="
            },
            null,
            {
              "$bytes": "sAQAAgAA"
            },
            null,
            null,
            false
          ]
        },
        {
          "op": "broker.stop",
          "args": {
            "broker": {
              "$ref": "broker"
            }
          },
          "side": "a",
          "expect": null
        }
      ],
      "interop": true
    },
