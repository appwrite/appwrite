            "steps": [
              {
                "ws_connect": "w",
                "protocol": "mqtt"
              },
              {
                "ws_send": "w",
                "data": {
                  "$ref": "connect"
                }
              },
              {
                "ws_receive": "w"
              },
              {
                "ws_send": "w",
                "data": {
                  "$ref": "subscribe"
                }
              },
              {
                "ws_receive": "w"
              },
              {
                "ws_send": "w",
                "data": {
                  "$ref": "publish"
                }
              },
              {
                "ws_receive": "w"
              },
              {
                "ws_send": "w",
                "data": {
                  "$ref": "ping",
                  "path": "/0"
                }
              },
              {
                "ws_receive": "w"
              },
              {
                "ws_close": "w"
              }
            ]
          },
          "side": "b",
          "expect": [
            {
              "upgraded": true,
              "protocol": "mqtt"
            },
            true,
            " \u001a\u0000\u0000\u0017\u0015\u0000\u0004test&\u0000\tprojectId\u0000\u0002p1",
            true,
            {
              "$bytes": "kAQAAQAB"
            },
            true,
            "0\u0015\u0000\u000binteropws/1\u0000over ws",
            true,
            {
              "$bytes": "0AA="
            },
            null
          ]
        },
        {
          "op": "broker.stop",
          "args": {
            "broker": {
              "$ref": "broker"
            }
          },
          "side": "a",
          "expect": null
        }
      ],
      "interop": true
