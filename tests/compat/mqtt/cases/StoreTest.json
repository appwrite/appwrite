    {
      "name": "handles: subscribe, lookups, the record, unsubscribe and close",
      "steps": [
        {
          "op": "store.new",
          "args": {},
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "store.subscribe",
          "args": {
            "store": {
              "$ref": "s"
            },
            "prefix": "proj",
            "user": "u",
            "topic": "a/+",
            "fd": 3
          },
          "expect": null
        },
        {
          "op": "store.subscribe",
          "args": {
            "store": {
              "$ref": "s"
            },
            "prefix": "proj",
            "user": "u",
            "topic": "a/b",
            "fd": 3,
            "qos": 0
          },
          "expect": null
        },
        {
          "op": "store.subscribe",
          "args": {
            "store": {
              "$ref": "s"
            },
            "prefix": "proj",
            "user": "v",
            "topic": "a/#",
            "fd": 4,
            "qos": 2
          },
          "expect": null
        },
        {
          "op": "store.subscribers",
          "args": {
            "store": {
              "$ref": "s"
            },
            "prefix": "proj",
            "topic": "a/b"
          },
          "expect": [
            [
              4,
              2
            ],
            [
              3,
              1
            ]
          ]
        },
        {
          "op": "store.connection",
          "args": {
            "store": {
              "$ref": "s"
            },
            "fd": 3
          },
          "expect": {
            "prefix": "proj",
            "user_id": "u",
            "subs": [
              [
                "a/+",
                1
              ],
              [
                "a/b",
                0
              ]
            ]
          }
        },
        {
          "op": "store.unsubscribe",
          "args": {
            "store": {
              "$ref": "s"
            },
            "topic": "a/+",
            "fd": 3
          },
          "expect": null
        },
        {
          "op": "store.subscribers",
          "args": {
            "store": {
              "$ref": "s"
            },
            "prefix": "proj",
            "topic": "a/b"
          },
          "expect": [
            [
              4,
              2
            ],
            [
              3,
              0
            ]
          ]
        },
        {
          "op": "store.close",
          "args": {
            "store": {
              "$ref": "s"
            },
            "fd": 4
          },
          "expect": null
        },
        {
          "op": "store.subscribers",
          "args": {
            "store": {
              "$ref": "s"
            },
            "prefix": "proj",
            "topic": "a/b"
          },
          "expect": [
            [
              3,
              0
            ]
          ]
        },
        {
          "op": "store.connection",
          "args": {
            "store": {
              "$ref": "s"
            },
            "fd": 4
          },
          "expect": null
        }
      ]
