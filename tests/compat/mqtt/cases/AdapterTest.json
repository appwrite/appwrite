    {
      "name": "testUnsubscribeStopsDelivery",
      "steps": [
        {
          "op": "v5.connect",
          "args": {
            "client_id": "v5-unsub",
            "keep_alive": 60,
            "clean_start": true,
            "properties": [
              {
                "id": 21,
                "value": "test"
              },
              {
                "id": 22,
                "value": "ok"
              },
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "projectId",
                      "p1"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "connect",
          "expect": "\u00101\u0000\u0004MQTT\u0005\u0002\u0000<\u001c\u0015\u0000\u0004test\u0016\u0000\u0002ok&\u0000\tprojectId\u0000\u0002p1\u0000\bv5-unsub"
        },
        {
          "op": "v5.subscribe",
          "args": {
            "packet_id": 1,
            "filters": [
              "room/1"
            ],
            "qos": 0
          },
          "bind": "subscribe",
          "expect": {
            "$bytes": "ggwAAQAABnJvb20vMQA="
          }
        },
        {
          "op": "v5.publish",
          "args": {
            "topic": "room/1",
            "payload": "first",
            "qos": 0,
            "packet_id": 0
          },
          "bind": "first",
          "expect": "0\u000e\u0000\u0006room/1\u0000first"
        },
        {
          "op": "v5.unsubscribe",
          "args": {
            "packet_id": 2,
            "filters": [
              "room/1"
            ]
          },
          "bind": "unsubscribe",
          "expect": {
            "$bytes": "ogsAAgAABnJvb20vMQ=="
          }
        },
        {
          "op": "v5.publish",
          "args": {
            "topic": "room/1",
            "payload": "second",
            "qos": 0,
            "packet_id": 0
          },
          "bind": "second",
          "expect": "0\u000f\u0000\u0006room/1\u0000second"
        },
        {
          "op": "e2e.run",
          "args": {
            "mode": "fixture",
            "steps": [
              {
                "connect": "c",
                "timeout": 1
              },
              {
                "send": "c",
                "data": {
                  "$ref": "connect"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "subscribe"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "first"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "unsubscribe"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "second"
                }
              },
              {
                "receive": "c"
              },
              {
                "connected": "c"
              }
            ]
          },
          "expect": [
            null,
            null,
            " \u001a\u0000\u0000\u0017\u0015\u0000\u0004test&\u0000\tprojectId\u0000\u0002p1",
            null,
            {
              "$bytes": "kAQAAQAB"
            },
            null,
            "0\u000e\u0000\u0006room/1\u0000first",
            null,
            {
              "$bytes": "sAQAAgAA"
            },
            null,
            null,
            true
          ]
        }
      ]
    },
    {
      "name": "the same session over TLS (mqtts://)",
      "steps": [
        {
          "op": "v3.connect",
          "args": {
            "client_id": "tls",
            "keep_alive": 60,
            "clean_session": true,
            "username": "user",
            "password": "ok"
          },
          "bind": "connect",
          "expect": {
            "$bytes": "EBkABE1RVFQEwgA8AAN0bHMABHVzZXIAAm9r"
          }
        },
        {
          "op": "packet.ping",
          "args": {},
          "bind": "ping",
          "expect": [
            {
              "$bytes": "wAA="
            },
            {
              "$bytes": "0AA="
            }
          ]
        },
        {
          "op": "e2e.run",
          "args": {
            "mode": "fixture",
            "steps": [
              {
                "connect": "c",
                "transport": "tls"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "connect"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "ping",
                  "path": "/0"
                }
              },
              {
                "receive": "c"
              },
              {
                "close": "c"
              },
              {
                "connected": "c"
              },
              {
                "log": "c"
              }
            ]
          },
          "expect": [
            null,
            null,
            " \u0002\u0000\u0000",
            null,
            {
              "$bytes": "0AA="
            },
            null,
            false,
            [
              [
                "open"
              ],
              [
                "receive",
                " \u0002\u0000\u0000"
              ],
              [
                "receive",
                {
                  "$bytes": "0AA="
                }
              ],
              [
                "close"
              ]
            ]
          ]
        }
      ]
    },
    {
      "name": "listen() receives until the broker closes, then sending fails",
      "steps": [
        {
          "op": "v3.connect",
          "args": {
            "client_id": "listener",
            "keep_alive": 60,
            "clean_session": true
          },
          "bind": "connect",
          "expect": "\u0010\u0014\u0000\u0004MQTT\u0004\u0002\u0000<\u0000\blistener"
        },
        {
          "op": "v3.disconnect",
          "args": {},
          "bind": "disconnect",
          "expect": {
            "$bytes": "4AA="
          }
        },
        {
          "op": "e2e.run",
          "args": {
            "mode": "fixture",
            "steps": [
              {
                "connect": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "connect"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "disconnect"
                }
              },
              {
                "listen": "c"
              },
              {
                "connected": "c"
              },
              {
                "log": "c"
              },
              {
                "send": "c",
                "data": "x"
              }
            ]
          },
          "expect": [
            null,
            null,
            " \u0002\u0000\u0000",
            null,
            null,
            false,
            [
              [
                "open"
              ],
              [
                "receive",
                " \u0002\u0000\u0000"
              ],
              [
                "close"
              ]
            ],
            {
              "error": "RuntimeException",
              "message": "Not connected to MQTT broker"
            }
          ]
        }
      ]
    }
  ]
}
