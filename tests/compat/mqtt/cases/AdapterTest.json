{
  "source": "packages/mqtt/tests/E2E/AdapterTest.php",
  "cases": [
    {
      "name": "testV5FullSession",
      "steps": [
        {
          "op": "v5.connect",
          "args": {
            "client_id": "v5-client",
            "keep_alive": 60,
            "clean_start": true,
            "properties": [
              {
                "id": 21,
                "value": "test"
              },
              {
                "id": 22,
                "value": "ok"
              },
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "projectId",
                      "p1"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "connect",
          "expect": "\u00102\u0000\u0004MQTT\u0005\u0002\u0000<\u001c\u0015\u0000\u0004test\u0016\u0000\u0002ok&\u0000\tprojectId\u0000\u0002p1\u0000\tv5-client"
        },
        {
          "op": "v5.subscribe",
          "args": {
            "packet_id": 1,
            "filters": [
              "sensors/+/temp"
            ],
            "qos": 1
          },
          "bind": "subscribe",
          "expect": {
            "$bytes": "ghQAAQAADnNlbnNvcnMvKy90ZW1wAQ=="
          }
        },
        {
          "op": "packet.ping",
          "args": {},
          "bind": "ping",
          "expect": [
            {
              "$bytes": "wAA="
            },
            {
              "$bytes": "0AA="
            }
          ]
        },
        {
          "op": "v5.auth",
          "args": {
            "code": 25,
            "properties": [
              {
                "id": 21,
                "value": "test"
              },
              {
                "id": 22,
                "value": "fresh"
              },
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "projectId",
                      "p1"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "reauth",
          "expect": {
            "$bytes": "8CEZHxUABHRlc3QWAAVmcmVzaCYACXByb2plY3RJZAACcDE="
          }
        },
        {
          "op": "v5.unsubscribe",
          "args": {
            "packet_id": 2,
            "filters": [
              "sensors/+/temp"
            ]
          },
          "bind": "unsubscribe",
          "expect": {
            "$bytes": "ohMAAgAADnNlbnNvcnMvKy90ZW1w"
          }
        },
        {
          "op": "v5.disconnect",
          "args": {
            "code": 0
          },
          "bind": "disconnect",
          "expect": {
            "$bytes": "4AIAAA=="
          }
        },
        {
          "op": "e2e.run",
          "args": {
            "mode": "fixture",
            "steps": [
              {
                "connect": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "connect"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "subscribe"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "ping",
                  "path": "/0"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "reauth"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "unsubscribe"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "disconnect"
                }
              },
              {
                "receive": "c"
              },
              {
                "connected": "c"
              },
              {
                "log": "c"
              }
            ]
          },
          "expect": [
            null,
            null,
            " \u001a\u0000\u0000\u0017\u0015\u0000\u0004test&\u0000\tprojectId\u0000\u0002p1",
            null,
            {
              "$bytes": "kAQAAQAB"
            },
            null,
            {
              "$bytes": "0AA="
            },
            null,
            {
              "$bytes": "8AIAAA=="
            },
            null,
            {
              "$bytes": "sAQAAgAA"
            },
            null,
            null,
            false,
            [
              [
                "open"
              ],
              [
                "receive",
                " \u001a\u0000\u0000\u0017\u0015\u0000\u0004test&\u0000\tprojectId\u0000\u0002p1"
              ],
              [
                "receive",
                {
                  "$bytes": "kAQAAQAB"
                }
              ],
              [
                "receive",
                {
                  "$bytes": "0AA="
                }
              ],
              [
                "receive",
                {
                  "$bytes": "8AIAAA=="
                }
              ],
              [
                "receive",
                {
                  "$bytes": "sAQAAgAA"
                }
              ],
              [
                "close"
              ]
            ]
          ]
        }
      ]
    },
    {
      "name": "testV5PublishFanOutWithWildcard",
      "steps": [
        {
          "op": "v5.connect",
          "args": {
            "client_id": "v5-sub",
            "keep_alive": 60,
            "clean_start": true,
            "properties": [
              {
                "id": 21,
                "value": "test"
              },
              {
                "id": 22,
                "value": "ok"
              },
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "projectId",
                      "p1"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "connect_sub",
          "expect": "\u0010/\u0000\u0004MQTT\u0005\u0002\u0000<\u001c\u0015\u0000\u0004test\u0016\u0000\u0002ok&\u0000\tprojectId\u0000\u0002p1\u0000\u0006v5-sub"
        },
        {
          "op": "v5.subscribe",
          "args": {
            "packet_id": 1,
            "filters": [
              "sensors/+/temp"
            ],
            "qos": 1
          },
          "bind": "subscribe",
          "expect": {
            "$bytes": "ghQAAQAADnNlbnNvcnMvKy90ZW1wAQ=="
          }
        },
        {
          "op": "v5.connect",
          "args": {
            "client_id": "v5-pub",
            "keep_alive": 60,
            "clean_start": true,
            "properties": [
              {
                "id": 21,
                "value": "test"
              },
              {
                "id": 22,
                "value": "ok"
              },
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "projectId",
                      "p1"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "connect_pub",
          "expect": "\u0010/\u0000\u0004MQTT\u0005\u0002\u0000<\u001c\u0015\u0000\u0004test\u0016\u0000\u0002ok&\u0000\tprojectId\u0000\u0002p1\u0000\u0006v5-pub"
        },
        {
          "op": "v5.publish",
          "args": {
            "topic": "sensors/room1/temp",
            "payload": "21.5",
            "qos": 1,
            "packet_id": 100,
            "properties": [
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "unit",
                      "C"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "publish",
          "expect": "2%\u0000\u0012sensors/room1/temp\u0000d\n&\u0000\u0004unit\u0000\u0001C21.5"
        },
        {
          "op": "e2e.run",
          "args": {
            "mode": "fixture",
            "steps": [
              {
                "connect": "sub"
              },
              {
                "send": "sub",
                "data": {
                  "$ref": "connect_sub"
                }
              },
              {
                "receive": "sub"
              },
              {
                "send": "sub",
                "data": {
                  "$ref": "subscribe"
                }
              },
              {
                "receive": "sub"
              },
              {
                "connect": "pub"
              },
              {
                "send": "pub",
                "data": {
                  "$ref": "connect_pub"
                }
              },
              {
                "receive": "pub"
              },
              {
                "send": "pub",
                "data": {
                  "$ref": "publish"
                }
              },
              {
                "receive": "pub"
              },
              {
                "receive": "sub"
              }
            ]
          },
          "expect": [
            null,
            null,
            " \u001a\u0000\u0000\u0017\u0015\u0000\u0004test&\u0000\tprojectId\u0000\u0002p1",
            null,
            {
              "$bytes": "kAQAAQAB"
            },
            null,
            null,
            " \u001a\u0000\u0000\u0017\u0015\u0000\u0004test&\u0000\tprojectId\u0000\u0002p1",
            null,
            "@\u0002\u0000d",
            "0#\u0000\u0012sensors/room1/temp\n&\u0000\u0004unit\u0000\u0001C21.5"
          ]
        }
      ]
    },
    {
      "name": "testV3FullSession",
      "steps": [
        {
          "op": "v3.connect",
          "args": {
            "client_id": "v3-client",
            "keep_alive": 60,
            "clean_session": true,
            "username": "user",
            "password": "ok"
          },
          "bind": "connect",
          "expect": {
            "$bytes": "EB8ABE1RVFQEwgA8AAl2My1jbGllbnQABHVzZXIAAm9r"
          }
        },
        {
          "op": "v3.subscribe",
          "args": {
            "packet_id": 1,
            "filters": [
              "news/tech"
            ],
            "qos": 1
          },
          "bind": "subscribe",
          "expect": {
            "$bytes": "gg4AAQAJbmV3cy90ZWNoAQ=="
          }
        },
        {
          "op": "v3.publish",
          "args": {
            "topic": "news/tech",
            "payload": "hello",
            "qos": 0,
            "packet_id": 0
          },
          "bind": "publish",
          "expect": "0\u0010\u0000\tnews/techhello"
        },
        {
          "op": "v3.disconnect",
          "args": {},
          "bind": "disconnect",
          "expect": {
            "$bytes": "4AA="
          }
        },
        {
          "op": "e2e.run",
          "args": {
            "mode": "fixture",
            "steps": [
              {
                "connect": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "connect"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "subscribe"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "publish"
                }
              },
              {
                "receive": "c"
              },
              {
                "send": "c",
                "data": {
                  "$ref": "disconnect"
                }
              },
              {
                "receive": "c"
              },
              {
                "connected": "c"
              }
            ]
          },
          "expect": [
            null,
            null,
            " \u0002\u0000\u0000",
            null,
            {
              "$bytes": "kAMAAQE="
            },
            null,
            "0\u0010\u0000\tnews/techhello",
            null,
            null,
            false
          ]
        }
      ]
    },
    {
