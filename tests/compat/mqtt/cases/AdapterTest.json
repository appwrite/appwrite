            "client_id": "v5-bad",
            "keep_alive": 60,
            "clean_start": true,
            "properties": [
              {
                "id": 21,
                "value": "test"
              },
              {
                "id": 22,
                "value": "deny"
              },
              {
                "id": 38,
                "value": {
                  "pair": [
                    [
                      "projectId",
                      "p1"
                    ]
                  ]
                }
              }
            ]
          },
          "bind": "connect5",
          "expect": "\u00101\u0000\u0004MQTT\u0005\u0002\u0000<\u001e\u0015\u0000\u0004test\u0016\u0000\u0004deny&\u0000\tprojectId\u0000\u0002p1\u0000\u0006v5-bad"
        },
        {
          "op": "v3.connect",
          "args": {
            "client_id": "v3-bad",
            "keep_alive": 60,
            "clean_session": true,
            "username": "user",
            "password": "deny"
          },
          "bind": "connect3",
          "expect": {
            "$bytes": "EB4ABE1RVFQEwgA8AAZ2My1iYWQABHVzZXIABGRlbnk="
          }
        },
        {
          "op": "e2e.run",
          "args": {
            "mode": "fixture",
            "steps": [
              {
                "connect": "v5"
              },
              {
                "send": "v5",
                "data": {
                  "$ref": "connect5"
                }
              },
              {
                "receive": "v5"
              },
              {
                "receive": "v5"
              },
              {
                "connected": "v5"
              },
              {
                "connect": "v3"
              },
              {
                "send": "v3",
                "data": {
                  "$ref": "connect3"
                }
              },
              {
                "receive": "v3"
              },
              {
                "receive": "v3"
              },
              {
                "connected": "v3"
              }
            ]
          },
          "expect": [
            null,
            null,
            {
              "$bytes": "IAMAhwA="
            },
            null,
            false,
            null,
            null,
            " \u0002\u0000\u0005",
            null,
            false
          ]
        }
      ]
