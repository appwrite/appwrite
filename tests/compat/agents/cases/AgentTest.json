    {
      "name": "set schema on an adapter without structured output throws",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "kind": "xai"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "agent.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "schema_object.new",
          "args": {
            "properties": {
              "ok": {
                "type": "boolean",
                "description": "ok"
              }
            }
          },
          "bind": "o",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "schema.new",
          "args": {
            "name": "Result",
            "description": "Result",
            "object": {
              "$ref": "o"
            },
            "required": [
              "ok"
            ]
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "agent.set_schema",
          "args": {
            "agent": {
              "$ref": "g"
            },
            "schema": {
              "$ref": "s"
            }
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Schema is not supported for this model"
            }
          }
        },
        {
          "op": "agent.inspect",
          "args": {
            "agent": {
              "$ref": "g"
            }
          },
          "expect": {
            "description": "",
            "instructions": [],
            "schema": null,
            "adapter": "xai"
          }
        }
      ]
    },
