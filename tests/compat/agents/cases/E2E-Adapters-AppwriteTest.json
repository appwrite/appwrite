    {
      "name": "embedding errors",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "kind": "appwrite"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.set",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "endpoint": "${fixture}/embed"
          },
          "expect": null
        },
        {
          "op": "fixture.queue",
          "args": {
            "responses": [
              {
                "status": 400,
                "body": "{\"error\":\"texts must not be empty\"}"
              },
              {
                "status": 500,
                "body": "{\"error\":42}"
              },
              {
                "status": 200,
                "body": "[]"
              },
              {
                "status": 200,
                "body": "\"text\""
              },
              {
                "status": 207,
                "body": "{\"embeddings\":[[0.1]]}"
              },
              {
                "status": 201,
                "body": "{\"embeddings\":{\"a\":[0.1],\"b\":[]}}"
              },
              {
                "status": 202,
                "body": "{\"embeddings\":[[0.1],\"x\"]}"
              },
              {
                "status": 200,
                "body": "{\"embeddings\":[[0.1],{\"k\":1}],\"tokens\":1.5}"
              }
            ]
          },
          "expect": null
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": [
              "a"
            ]
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "texts must not be empty"
            }
          }
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": [
              "a"
            ]
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Unknown error"
            }
          }
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": [
              "a"
            ]
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Embedding response missing or count mismatch"
            }
          }
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": [
              "a"
            ]
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Invalid response format received from the API"
            }
          }
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": [
              "a",
              "b"
            ]
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Embedding response missing or count mismatch"
            }
          }
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": [
              "a",
              "b"
            ]
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Embedding row b missing or empty"
            }
          }
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": [
              "a",
              "b"
            ]
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Embedding row 1 missing or empty"
            }
          }
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": [
              "a",
              "b"
            ]
          },
          "expect": {
            "embeddings": [
              [
                0.1
              ],
              {
                "k": 1
              }
            ],
            "tokensProcessed": null,
            "totalDuration": null
          }
        },
        {
          "op": "adapter.bulk_embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "texts": []
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "bulkEmbed requires at least one text"
            }
          }
        }
      ]
    }
  ]
