    {
      "name": "embed returns vector",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "kind": "appwrite"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.set",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "endpoint": "${fixture}/embed"
          },
          "expect": null
        },
        {
          "op": "fixture.queue",
          "args": {
            "responses": [
              {
                "status": 200,
                "body": "{\"model\":\"nomic-embed-text\",\"embeddings\":[[0.0123,-0.5,0,1,-0.0,1e-07,3.14159265358979,2.5e+20]],\"tokens\":6,\"total_duration\":4321}"
              }
            ]
          },
          "expect": null
        },
        {
          "op": "adapter.embed",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "text": "hello world"
          },
          "expect": {
            "embedding": [
              0.0123,
              -0.5,
              0,
              1,
              -0.0,
              1e-7,
              3.14159265358979,
              2.5e+20
            ],
            "tokensProcessed": 6,
            "totalDuration": 4321
          }
        },
        {
          "op": "fixture.requests",
          "expect": [
            {
              "method": "POST",
              "target": "/serve/${ns}/embed",
              "protocol": "HTTP/1.1",
              "headers": [
                [
                  "Host",
                  "${fixture}"
                ],
                [
                  "Accept-Encoding",
                  "deflate, gzip, br, zstd"
                ],
                [
                  "Content-Type",
                  "application/json"
                ],
                [
                  "Accept",
                  "application/json"
                ],
                [
                  "Content-Length",
                  "52"
                ]
              ],
              "body": "{\"model\":\"nomic-embed-text\",\"texts\":[\"hello world\"]}"
            }
          ]
        }
      ]
    },
