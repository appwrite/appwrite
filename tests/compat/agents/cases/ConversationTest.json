{
  "source": "packages/agents/tests/ConversationTest.php",
  "cases": [
    {
      "name": "message accepts attachments and assigns role",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "kind": "fake",
            "fake": {
              "attachments": "images",
              "maxAttachmentsPerMessage": 10,
              "maxAttachmentBytes": 5000000,
              "maxTotalAttachmentBytes": 20000000,
              "allowedAttachmentMimeTypes": [
                "image/png",
                "image/jpeg",
                "image/webp",
                "image/gif"
              ],
              "response": "ok"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "agent.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conversation.new",
          "args": {
            "agent": {
              "$ref": "g"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conversation.message",
          "args": {
            "conversation": {
              "$ref": "c"
            },
            "from": {
              "kind": "user",
              "id": "user-1"
            },
            "message": "What is in this image?",
            "attachments": [
              {
                "$bytes": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVQYV2NgYAAAAAMAAWgmWQ0AAAAASUVORK5CYII="
              }
            ]
          },
          "expect": null
        },
        {
          "op": "conversation.inspect",
          "args": {
            "conversation": {
              "$ref": "c"
            }
          },
          "expect": {
            "messages": [
              {
                "role": "user",
                "content": "What is in this image?",
                "mime": "text/plain",
                "hasAttachments": true,
                "attachments": [
                  {
                    "role": "user",
                    "content": {
                      "$bytes": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVQYV2NgYAAAAAMAAWgmWQ0AAAAASUVORK5CYII="
                    },
                    "mime": "image/png",
                    "hasAttachments": false,
                    "attachments": []
                  }
                ]
              }
            ],
            "tokens": {
              "input": 0,
              "output": 0,
              "cacheCreation": 0,
              "cacheRead": 0,
              "total": 0
            },
            "listened": null
          }
        }
      ]
    },
