    {
      "name": "token counters accumulate and total is consistent",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "kind": "ollama"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.count",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "input": 3,
            "output": 5,
            "cacheCreation": 7,
            "cacheRead": 11
          },
          "expect": {
            "input": 3,
            "output": 5,
            "cacheCreation": 7,
            "cacheRead": 11,
            "total": 26
          }
        }
      ]
