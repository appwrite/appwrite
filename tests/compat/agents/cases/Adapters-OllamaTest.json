      "name": "adapter identity and default model",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "kind": "ollama"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.inspect",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "name": "ollama",
            "model": "embeddinggemma",
            "schema": false,
            "embeddings": true,
            "timeout": 90000,
            "attachments": {
              "supported": false,
              "maxPerMessage": null,
              "maxBytes": null,
              "maxTotalBytes": null,
              "mimeTypes": null
