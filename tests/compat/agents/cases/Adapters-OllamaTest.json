    {
      "name": "invalid model throws",
      "op": "adapter.new",
      "args": {
        "kind": "ollama",
        "args": {
          "model": "invalid-model-name"
        }
      },
      "expect": {
        "$error": {
          "class": "InvalidArgumentException",
