    {
      "name": "placeholders, stats and options set on the agent",
      "steps": [
        {
          "op": "fs.write",
          "args": {
            "dir": "/tmp/compat-fs/${ns}/base",
            "files": {
              "docs/a.md": "A\n",
              "docs/deep/b.md": "B\n",
              "src/x.php": "<?php echo 1;\n",
              "keep.txt": "1\n\n\n2\n"
            }
          },
          "expect": null
        },
        {
          "op": "fs.write",
          "args": {
            "dir": "/tmp/compat-fs/${ns}/target",
            "files": {
              "docs/a.md": "A2\n",
              "docs/deep/b.md": "B2\n",
              "src/x.php": "<?php echo 2;\n",
              "keep.txt": "1\n2\n",
              "new.txt": "  spaced  out\n"
            }
          },
          "expect": null
        },
        {
          "op": "adapter.new",
          "args": {
            "kind": "fake",
            "fake": {
              "response": "  padded answer \n",
              "schema": true
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "agent.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "schema_object.new",
          "args": {
            "properties": {
              "summary": {
                "type": "string",
                "description": "One sentence"
              }
            }
          },
          "bind": "o",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "schema.new",
          "args": {
            "name": "diff_summary",
            "description": "Summary",
            "object": {
              "$ref": "o"
            },
            "required": [
              "summary"
            ]
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "diff.run",
          "args": {
            "runner": {
              "$ref": "g"
            },
            "base": "/tmp/compat-fs/${ns}/base",
            "target": "/tmp/compat-fs/${ns}/target",
            "prompt": "Base {{base}} target {{target}} ({{diff_stats}})\n{{diff}}",
            "options": [
              [
                "addExcludePath",
                " docs/** "
              ],
              [
                "addExcludePath",
                "   "
              ],
              [
                "setDescription",
                "You review diffs."
              ],
              [
                "setInstructions",
                [
                  [
                    "Format",
                    "JSON"
                  ]
                ]
              ],
              [
                "addInstruction",
                [
                  "Tone",
                  "Brief"
                ]
              ],
              [
                "setSchema",
                {
                  "$ref": "s"
                }
              ],
              [
                "setUserId",
                "  reviewer  "
              ],
              [
                "setIgnoreBlankLines",
                false
              ]
            ]
          },
          "expect": {
            "hasChanges": true,
            "response": "padded answer"
          }
        },
        {
          "op": "fake.inspect",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "sendCalls": 1,
            "last": {
              "role": "user",
              "content": "Base /tmp/compat-fs/${ns}/base target /tmp/compat-fs/${ns}/target (23 lines, 887 bytes)\ndiff --git a/tmp/utopia-diff-check-base-<random>/keep.txt b/tmp/utopia-diff-check-target-<random>/keep.txt\nindex b712419..1191247 100644\n--- a/tmp/utopia-diff-check-base-<random>/keep.txt\n+++ b/tmp/utopia-diff-check-target-<random>/keep.txt\n@@ -1,4 +1,2 @@\n 1\n-\n-\n 2\ndiff --git a/tmp/utopia-diff-check-target-<random>/new.txt b/tmp/utopia-diff-check-target-<random>/new.txt\nnew file mode 100644\nindex 0000000..2462c69\n--- /dev/null\n+++ b/tmp/utopia-diff-check-target-<random>/new.txt\n@@ -0,0 +1 @@\n+  spaced  out\ndiff --git a/tmp/utopia-diff-check-base-<random>/src/x.php b/tmp/utopia-diff-check-target-<random>/src/x.php\nindex c8ab8e0..0b01122 100644\n--- a/tmp/utopia-diff-check-base-<random>/src/x.php\n+++ b/tmp/utopia-diff-check-target-<random>/src/x.php\n@@ -1 +1 @@\n-<?php echo 1;\n+<?php echo 2;",
              "mime": "text/x-diff",
              "hasAttachments": false,
              "attachments": []
            }
          }
        },
        {
          "op": "agent.inspect",
          "args": {
            "agent": {
              "$ref": "g"
            }
          },
          "expect": {
            "description": "You review diffs.",
            "instructions": [
              [
                "Format",
                "JSON"
              ],
              [
                "Tone",
                "Brief"
              ]
            ],
            "schema": "diff_summary",
            "adapter": "fake"
          }
        }
      ]
    },
