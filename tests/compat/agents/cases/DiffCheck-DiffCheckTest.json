{
  "source": "packages/agents/tests/DiffCheck/DiffCheckTest.php",
  "cases": [
    {
      "name": "run skips ai when there is no diff",
      "steps": [
        {
          "op": "fs.write",
          "args": {
            "dir": "/tmp/compat-fs/${ns}/base",
            "files": {
              "README.md": "Hello\n"
            }
          },
          "expect": null
        },
        {
          "op": "fs.write",
          "args": {
            "dir": "/tmp/compat-fs/${ns}/target",
            "files": {
              "README.md": "Hello\n"
            }
          },
          "expect": null
        },
        {
          "op": "adapter.new",
          "args": {
            "kind": "fake",
            "fake": {
              "response": "should-not-be-called",
              "schema": true
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "diff.run",
          "args": {
            "runner": {
              "$ref": "a"
            },
            "base": "/tmp/compat-fs/${ns}/base",
            "target": "/tmp/compat-fs/${ns}/target",
            "prompt": "Analyze this diff: {{diff}}"
          },
          "expect": {
            "hasChanges": false,
            "response": ""
          }
        },
        {
          "op": "fake.inspect",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "sendCalls": 0,
            "last": null
          }
        }
      ]
    },
    {
      "name": "run returns response when diff exists",
      "steps": [
        {
          "op": "fs.write",
          "args": {
            "dir": "/tmp/compat-fs/${ns}/base",
            "files": {
              "README.md": "Hello\n"
            }
          },
          "expect": null
        },
        {
          "op": "fs.write",
          "args": {
            "dir": "/tmp/compat-fs/${ns}/target",
            "files": {
              "README.md": "Hello world\n"
            }
          },
          "expect": null
        },
        {
          "op": "adapter.new",
          "args": {
            "kind": "fake",
            "fake": {
              "response": "{\"version\":\"1.2.3\"}",
              "schema": true
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "diff.run",
          "args": {
            "runner": {
              "$ref": "a"
            },
            "base": "/tmp/compat-fs/${ns}/base",
            "target": "/tmp/compat-fs/${ns}/target",
            "prompt": "Please inspect:\\n{{diff}}"
          },
          "expect": {
            "hasChanges": true,
            "response": "{\"version\":\"1.2.3\"}"
          }
        },
        {
          "op": "fake.inspect",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "sendCalls": 1,
            "last": {
              "role": "user",
              "content": "Please inspect:\\ndiff --git a/tmp/utopia-diff-check-base-<random>/README.md b/tmp/utopia-diff-check-target-<random>/README.md\nindex e965047..802992c 100644\n--- a/tmp/utopia-diff-check-base-<random>/README.md\n+++ b/tmp/utopia-diff-check-target-<random>/README.md\n@@ -1 +1 @@\n-Hello\n+Hello world",
              "mime": "text/x-diff",
              "hasAttachments": false,
              "attachments": []
            }
          }
        }
      ]
    },
