    {
      "name": "remote repositories at refs and local repositories checked out",
      "steps": [
        {
          "op": "fs.git",
          "args": {
            "dir": "/tmp/compat-fs/${ns}/repo",
            "commits": [
              {
                "files": {
                  "VERSION": "1.0.0\n",
                  "src/app.txt": "first\n"
                },
                "message": "first",
                "tag": "v1"
              },
              {
                "files": {
                  "VERSION": "1.1.0\n",
                  "src/app.txt": "second\n"
                },
                "message": "second",
                "tag": "v2"
              }
            ]
          },
          "expect": null
        },
        {
          "op": "adapter.new",
          "args": {
            "kind": "fake",
            "fake": {
              "response": "compared",
              "schema": true
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "diff.run",
          "args": {
            "runner": {
              "$ref": "a"
            },
            "base": {
              "source": "file:///tmp/compat-fs/${ns}/repo",
              "remote": true,
              "ref": "v1"
            },
            "target": {
              "source": "file:///tmp/compat-fs/${ns}/repo",
              "remote": true
            },
            "prompt": "{{base}} -> {{target}}\n{{diff}}",
            "options": [
              [
                "setExcludePaths",
                [
                  ".git"
                ]
              ]
            ]
          },
          "expect": {
            "hasChanges": true,
            "response": "compared"
