    {
      "name": "schema request is posted as json with bearer token",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "kind": "openai",
            "args": {
              "apiKey": "secret",
              "model": "gpt-4.1"
            },
            "client": {
              "queue": [
                {
                  "status": 200,
                  "body": "{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"{\\\"ok\\\":true}\"}}]}"
                }
              ]
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "schema_object.new",
          "args": {
            "properties": {
              "ok": {
                "type": "boolean",
                "description": "ok"
              }
            }
          },
          "bind": "o",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "schema.new",
          "args": {
            "name": "Result",
            "description": "Result",
            "object": {
              "$ref": "o"
            },
            "required": [
              "ok"
            ]
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "agent.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "agent.set_schema",
          "args": {
            "agent": {
              "$ref": "g"
            },
            "schema": {
              "$ref": "s"
            }
          },
          "expect": null
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "messages": [
              "hi"
            ]
          },
          "expect": {
            "content": "{\"ok\":true}",
            "role": "user"
          }
        },
        {
          "op": "adapter.requests",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            {
              "method": "POST",
              "uri": "https://api.openai.com/v1/chat/completions",
              "headers": [
                [
                  "authorization",
                  "Bearer secret"
                ],
                [
                  "Content-Type",
                  "application/json"
                ],
                [
                  "Accept",
                  "application/json"
                ]
              ],
              "body": "{\"model\":\"gpt-4.1\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"temperature\":1,\"response_format\":{\"type\":\"json_schema\",\"json_schema\":{\"name\":\"Result\",\"strict\":true,\"schema\":{\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\",\"description\":\"ok\"}},\"required\":[\"ok\"],\"additionalProperties\":false}}},\"stream\":false,\"max_tokens\":1024}"
            }
          ]
        }
      ]
    },
    {
      "name": "streamed response is assembled across chunk boundaries",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "kind": "openai",
            "args": {
              "apiKey": "secret"
            },
            "client": {
              "queue": [
                {
                  "status": 200,
                  "chunks": [
                    "data: {\"ch",
                    "oices\":[{\"delta\":{\"content\":\"Hel\"}}]}\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\ndata: [DONE]"
                  ]
                }
              ]
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "agent.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "messages": [
              "hi"
            ],
            "listen": true
          },
          "expect": {
            "content": "Hello",
            "role": "user",
            "tokens": [
              "Hel",
              "lo"
            ]
          }
        },
        {
          "op": "adapter.requests",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            {
              "method": "POST",
              "uri": "https://api.openai.com/v1/chat/completions",
              "headers": [
                [
                  "authorization",
                  "Bearer secret"
                ],
                [
                  "Content-Type",
                  "application/json"
                ],
                [
                  "Accept",
                  "application/json"
                ]
              ],
              "body": "{\"model\":\"o3-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"temperature\":1,\"stream\":true,\"max_completion_tokens\":1024}"
            }
          ]
        }
      ]
    },
    {
      "name": "injected client carries every request across timeout changes",
      "steps": [
        {
          "op": "adapter.new",
