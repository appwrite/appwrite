          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "messages": [
              "one"
            ]
          },
          "expect": {
            "content": "a",
            "role": "user"
          }
        },
        {
          "op": "adapter.set",
          "args": {
            "adapter": {
              "$ref": "a"
            },
