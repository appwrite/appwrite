          },
          "expect": null
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "messages": [
              "two"
            ]
          },
          "expect": {
            "content": "b",
            "role": "user"
          }
        },
        {
          "op": "adapter.requests",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            {
              "method": "POST",
              "uri": "https://api.openai.com/v1/chat/completions",
              "headers": [
                [
                  "authorization",
                  "Bearer secret"
                ],
                [
                  "Content-Type",
                  "application/json"
                ],
                [
                  "Accept",
                  "application/json"
                ]
              ],
              "body": "{\"model\":\"o3-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"one\"}],\"temperature\":1,\"stream\":true,\"max_completion_tokens\":1024}"
            },
            {
              "method": "POST",
              "uri": "https://api.openai.com/v1/chat/completions",
              "headers": [
                [
                  "authorization",
                  "Bearer secret"
                ],
                [
                  "Content-Type",
                  "application/json"
                ],
                [
                  "Accept",
                  "application/json"
                ]
              ],
              "body": "{\"model\":\"o3-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"two\"}],\"temperature\":1,\"stream\":true,\"max_completion_tokens\":1024}"
            }
          ]
        }
      ]
    },
