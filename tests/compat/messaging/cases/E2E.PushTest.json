{
  "source": "packages/messaging/tests/E2E/Adapter/Push/PushTest.php",
  "cases": [
    {
      "name": "send push (the request catcher is the fixture server)",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "mock_push",
            "transport": "default"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "get_endpoint"
          },
          "expect": {
            "result": "http://request-catcher:5000/mock-push",
            "requests": []
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "set_endpoint",
            "args": {
              "url": "{fixture}/http/127.0.0.1:15000/mock-push"
            }
          },
          "expect": {
            "result": true,
            "requests": []
          }
        },
        {
          "op": "adapter.info",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "name": "Mock",
            "type": "push",
            "messageType": "Utopia\\Messaging\\Messages\\Push",
            "maxMessagesPerRequest": 1000
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "push",
              "to": [
                "device-a",
                "device-b"
              ],
              "title": "Firing: Budget 100%",
              "body": "$502 of the $500 budget.",
              "data": {
                "alertId": "alert1",
                "status": "firing"
              },
              "action": "OPEN_ALERT",
              "sound": "siren.caf",
              "image": "https://example.com/chart.png",
              "icon": "ic_alert",
              "color": "#fd366e",
              "tag": "alert:alert1",
              "badge": 0,
              "content_available": false,
              "critical": true,
              "priority": "HIGH",
              "channel_id": "alerts_critical",
              "mutable_content": false
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 2,
              "type": "push",
              "results": [
                {
                  "recipient": "device-a",
                  "status": "success",
                  "error": "",
                  "permanent": false,
                  "code": 0
                },
                {
                  "recipient": "device-b",
                  "status": "success",
                  "error": "",
                  "permanent": false,
                  "code": 0
                }
              ]
            },
            "requests": [
              {
                "method": "POST",
                "url": "http://127.0.0.1:15000/mock-push",
                "headers": [
                  [
                    "Accept-Encoding",
                    "deflate, gzip, br, zstd"
                  ],
                  [
                    "Content-Type",
                    "application/json"
                  ],
                  [
                    "User-Agent",
                    "Appwrite Mock Message Sender"
                  ],
                  [
                    "Accept",
                    "application/json"
                  ],
                  [
                    "Content-Length",
                    "404"
                  ]
                ],
                "body": "{\"to\":[\"device-a\",\"device-b\"],\"title\":\"Firing: Budget 100%\",\"body\":\"$502 of the $500 budget.\",\"data\":{\"alertId\":\"alert1\",\"status\":\"firing\"},\"action\":\"OPEN_ALERT\",\"sound\":\"siren.caf\",\"image\":\"https:\\/\\/example.com\\/chart.png\",\"icon\":\"ic_alert\",\"color\":\"#fd366e\",\"tag\":\"alert:alert1\",\"badge\":0,\"contentAvailable\":false,\"critical\":true,\"priority\":\"high\",\"channelId\":\"alerts_critical\",\"mutableContent\":false}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "expired token is reported",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "mock_push",
            "transport": "default"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "get_endpoint"
          },
          "expect": {
            "result": "http://request-catcher:5000/mock-push",
            "requests": []
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "set_endpoint",
            "args": {
              "url": "{fixture}/http/127.0.0.1:15000/mock-push"
            }
          },
          "expect": {
            "result": true,
            "requests": []
          }
        },
        {
          "op": "adapter.info",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "name": "Mock",
            "type": "push",
            "messageType": "Utopia\\Messaging\\Messages\\Push",
            "maxMessagesPerRequest": 1000
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "push",
              "to": [
                "device-a",
                "expired-device-b"
              ],
              "title": "Resolved: Egress"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "push",
              "results": [
                {
                  "recipient": "device-a",
                  "status": "success",
                  "error": "",
                  "permanent": false,
                  "code": 0
                },
                {
                  "recipient": "expired-device-b",
                  "status": "failure",
                  "error": "Expired device token",
                  "permanent": false,
                  "code": 0
                }
              ]
            },
            "requests": [
              {
                "method": "POST",
                "url": "http://127.0.0.1:15000/mock-push",
                "headers": [
                  [
                    "Accept-Encoding",
                    "deflate, gzip, br, zstd"
                  ],
                  [
                    "Content-Type",
                    "application/json"
                  ],
                  [
                    "User-Agent",
                    "Appwrite Mock Message Sender"
                  ],
                  [
                    "Accept",
                    "application/json"
                  ],
                  [
                    "Content-Length",
                    "65"
                  ]
                ],
                "body": "{\"to\":[\"device-a\",\"expired-device-b\"],\"title\":\"Resolved: Egress\"}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a failed post fails every token but the expired ones",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "mock_push"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "push",
              "to": [
                "device-a",
                "expired-device-b"
              ],
              "title": "x"
            },
            "replies": [
              {
                "statusCode": 500
              }
            ]
          },
          "expect": {
            "result": {
              "deliveredTo": 0,
              "type": "push",
              "results": [
                {
                  "recipient": "device-a",
                  "status": "failure",
                  "error": "Unknown Error.",
                  "permanent": false,
                  "code": 0
                },
                {
                  "recipient": "expired-device-b",
                  "status": "failure",
                  "error": "Expired device token",
                  "permanent": false,
                  "code": 0
                }
              ]
            },
            "requests": [
              {
                "method": "POST",
                "url": "http://request-catcher:5000/mock-push",
                "headers": [
                  "Content-Type: application/json"
                ],
                "body": {
                  "to": [
                    "device-a",
                    "expired-device-b"
                  ],
                  "title": "x"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
