          }
        },
        {
          "op": "email.new",
          "args": {
            "to": [
              "a@example.test"
            ],
            "headers": {
              "MIME-Version": "v"
            }
          },
          "expect": {
            "$invalid": {
              "type": "header_malformed",
              "value": "MIME-Version",
              "message": "The message already owns the \"MIME-Version\" header."
            }
          }
        },
        {
          "op": "email.new",
          "args": {
            "to": [
              "a@example.test"
            ],
            "headers": {
              "Content-Type": "v"
            }
          },
          "expect": {
            "$invalid": {
              "type": "header_malformed",
              "value": "Content-Type",
              "message": "The message already owns the \"Content-Type\" header."
            }
          }
        },
        {
          "op": "email.new",
          "args": {
            "to": [
              "a@example.test"
            ],
            "headers": {
              "Content-Transfer-Encoding": "v"
            }
          },
          "expect": {
            "$invalid": {
              "type": "header_malformed",
              "value": "Content-Transfer-Encoding",
              "message": "The message already owns the \"Content-Transfer-Encoding\" header."
            }
          }
        },
        {
          "op": "email.new",
          "args": {
            "to": [
              "a@example.test"
            ],
            "headers": {
              "X-Null": "a\u0000b"
            }
          },
          "expect": {
            "$invalid": {
              "type": "header_malformed",
              "value": "X-Null",
              "message": "Header \"X-Null\" must be a single-line string."
            }
          }
        }
      ]
    }
  ]
}
