{
  "source": "packages/messaging/tests/Adapter/Email/SMTPKeepAliveTest.php",
  "cases": [
    {
      "name": "a 421 on a kept session is sent again",
      "steps": [
        {
          "op": "smtp_server.new",
          "args": {
            "replies": [
              "220 smtp.example.test ESMTP",
              "250 smtp.example.test",
              "250 2.1.0 Ok",
              "250 2.1.5 Ok",
              "354 End data with <CR><LF>.<CR><LF>",
              "250 2.0.0 Ok: queued as 4ZbX1",
              "421 4.4.2 Idle timeout, closing connection"
            ],
            "more": [
              [
                "220 smtp.example.test ESMTP",
                "250 smtp.example.test",
                "250 2.1.0 Ok",
                "250 2.1.5 Ok",
                "354 End data with <CR><LF>.<CR><LF>",
                "250 2.0.0 Ok: queued as 4ZbX1"
              ]
            ]
          },
          "bind": "s0",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "smtp",
            "args": {
              "host": "127.0.0.1:{port0}",
              "timeout": 2,
              "keepAlive": true,
              "timelimit": 2,
              "pingThreshold": 60
            },
            "servers": [
              {
                "$ref": "s0"
              }
            ],
            "transport": "none"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "email",
              "to": [
                {
                  "email": "to@example.test",
                  "name": "To"
                }
              ],
              "subject": "Your code",
              "content": "123456",
              "from_name": "Sender",
              "from_email": "sender@example.test"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "email",
              "results": [
                {
                  "recipient": "to@example.test",
                  "status": "success",
                  "error": "",
                  "permanent": false,
                  "code": 0
                }
              ]
            }
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "email",
              "to": [
                {
                  "email": "to@example.test",
                  "name": "To"
                }
              ],
              "subject": "Your code",
              "content": "123456",
              "from_name": "Sender",
              "from_email": "sender@example.test"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "email",
              "results": [
                {
                  "recipient": "to@example.test",
                  "status": "success",
                  "error": "",
                  "permanent": false,
                  "code": 0
                }
              ]
            }
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "disconnect"
          },
          "expect": {
            "result": null
          }
        },
        {
          "op": "smtp_server.commands",
          "args": {
            "server": {
              "$ref": "s0"
            }
          },
          "expect": [
            "EHLO <host>",
            "MAIL FROM:<sender@example.test>",
            "RCPT TO:<to@example.test>",
            "DATA",
            "MAIL FROM:<sender@example.test>",
            "EHLO <host>",
            "MAIL FROM:<sender@example.test>",
            "RCPT TO:<to@example.test>",
            "DATA"
          ]
        }
      ]
    },
