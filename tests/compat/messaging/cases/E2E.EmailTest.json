    {
      "name": "send email with mixed To formats",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "mock_email",
            "args": {
              "host": "{mailpit}"
            },
            "transport": "none"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "email",
              "to": [
                "plain@localhost.test",
                {
                  "email": "named@localhost.test",
                  "name": "Named User"
                }
              ],
              "subject": "Mixed To Test ${ns}",
              "content": "Test Content",
              "from_name": "Test Sender",
              "from_email": "sender@localhost.test"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 2,
              "type": "email",
              "results": [
                {
                  "recipient": "plain@localhost.test",
                  "status": "success",
                  "error": "",
                  "permanent": false
                },
                {
                  "recipient": "named@localhost.test",
                  "status": "success",
                  "error": "",
                  "permanent": false
                }
              ]
            }
          }
        },
        {
          "op": "email.new",
          "args": {
            "to": [
              "plain@localhost.test",
              {
                "email": "named@localhost.test",
                "name": "Named User"
              }
            ],
            "subject": "Mixed To Test",
            "content": "Test Content",
            "from_name": "Test Sender",
            "from_email": "sender@localhost.test"
          },
          "expect": {
            "to": [
              {
                "email": "plain@localhost.test"
              },
              {
                "email": "named@localhost.test",
                "name": "Named User"
              }
            ],
            "subject": "Mixed To Test",
            "content": "Test Content",
            "fromName": "Test Sender",
            "fromEmail": "sender@localhost.test",
            "replyToName": "Test Sender",
            "replyToEmail": "sender@localhost.test",
            "cc": null,
            "bcc": null,
            "attachments": null,
            "html": false,
            "headers": [],
            "origin": null
          }
        }
      ]
    },
