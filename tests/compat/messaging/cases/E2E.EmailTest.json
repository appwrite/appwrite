          }
        ],
        "subject": "Test",
        "content": "Test",
        "from_name": "Test",
        "from_email": "sender@localhost.test"
      }
    },
    {
      "name": "rejects an empty email in CC",
      "op": "email.new",
      "args": {
        "to": [
          "valid@localhost.test"
        ],
        "subject": "Test",
        "content": "Test",
        "from_name": "Test",
        "from_email": "sender@localhost.test",
        "cc": [
          ""
