{
  "source": "packages/messaging/tests/E2E/Adapter/Email/EmailTest.php",
  "cases": [
    {
      "name": "send email",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "mock_email",
            "args": {
              "host": "{mailpit}"
            },
            "transport": "none"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.info",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "name": "Mock",
            "type": "email",
            "messageType": "Utopia\\Messaging\\Messages\\Email",
            "maxMessagesPerRequest": 1000
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "email",
              "to": [
                "tester@localhost.test"
              ],
              "subject": "Test Subject ${ns}",
              "content": "Test Content",
              "from_name": "Test Sender",
              "from_email": "sender@localhost.test",
              "cc": [
                {
                  "email": "tester2@localhost.test"
                }
              ],
              "bcc": [
                {
                  "name": "Tester3",
                  "email": "tester3@localhost.test"
                }
              ]
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 3,
              "type": "email",
              "results": [
                {
                  "recipient": "tester@localhost.test",
                  "status": "success",
                  "error": "",
                  "permanent": false
                },
                {
                  "recipient": "tester2@localhost.test",
                  "status": "success",
                  "error": "",
                  "permanent": false
                },
                {
                  "recipient": "tester3@localhost.test",
                  "status": "success",
                  "error": "",
                  "permanent": false
                }
              ]
            }
          }
        },
        {
          "op": "mailpit.message",
          "args": {
            "subject": "Test Subject ${ns}"
          },
          "expect": {
            "subject": "Test Subject ${ns}",
            "from": [
              [
                "Test Sender",
                "sender@localhost.test"
              ]
            ],
            "to": [
              [
                "",
                "tester@localhost.test"
              ]
            ],
            "cc": [
              [
                "",
                "tester2@localhost.test"
              ]
            ],
            "bcc": [
              [
                "",
                "tester3@localhost.test"
              ]
            ],
            "reply_to": [
              [
                "Test Sender",
                "sender@localhost.test"
              ]
            ],
            "text": "Test Content",
            "html": "",
            "attachments": [],
            "headers": {
              "X-Mailer": [
                "Utopia Mailer"
              ]
            }
          }
        }
      ]
    },
