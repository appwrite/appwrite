    {
      "name": "rejects an empty email string",
      "op": "email.new",
      "args": {
        "to": [
          ""
        ],
        "subject": "Test",
        "content": "Test",
        "from_name": "Test",
        "from_email": "sender@localhost.test"
      },
      "expect": {
        "$invalid": {
          "type": "recipient_empty",
          "value": "",
          "message": "Email address must not be empty."
        }
      }
    },
    {
      "name": "rejects an empty email in an array",
      "op": "email.new",
      "args": {
        "to": [
          {
            "email": "",
            "name": "Ghost"
          }
        ],
        "subject": "Test",
        "content": "Test",
        "from_name": "Test",
        "from_email": "sender@localhost.test"
      },
      "expect": {
        "$invalid": {
          "type": "recipient_empty",
          "value": null,
          "message": "Each recipient must have a non-empty \"email\" key."
        }
      }
    },
    {
      "name": "rejects a missing email key",
      "op": "email.new",
      "args": {
        "to": [
          {
            "name": "No Email"
          }
        ],
        "subject": "Test",
        "content": "Test",
        "from_name": "Test",
        "from_email": "sender@localhost.test"
      },
      "expect": {
        "$invalid": {
          "type": "recipient_empty",
          "value": null,
          "message": "Each recipient must have a non-empty \"email\" key."
        }
      }
    },
    {
      "name": "rejects an empty email in CC",
      "op": "email.new",
      "args": {
        "to": [
          "valid@localhost.test"
        ],
        "subject": "Test",
        "content": "Test",
        "from_name": "Test",
        "from_email": "sender@localhost.test",
        "cc": [
          ""
        ]
      },
      "expect": {
        "$invalid": {
          "type": "recipient_empty",
          "value": "",
          "message": "Email address must not be empty."
        }
      }
    }
