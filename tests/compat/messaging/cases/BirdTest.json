          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "sms",
              "results": [
                {
                  "recipient": "+31612345678",
                  "status": "success",
                  "error": "",
                  "permanent": false
                }
              ]
            },
            "requests": [
              {
                "method": "POST",
                "url": "https://eu1.platform.bird.com/v1/sms/messages",
                "headers": [
                  "Content-Type: application/json",
                  "Authorization: Bearer bk_eu1_Ab3xKq9mP2wR5tY8uI1oL4nJ"
                ],
                "body": {
                  "to": "+31612345678",
                  "from": "Appwrite",
                  "text": "Your code is 123456",
                  "category": "authentication",
                  "metadata": {
                    "messageId": "msg_1"
                  }
                }
              }
            ]
          }
        }
      ]
    },
