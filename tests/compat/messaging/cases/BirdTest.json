{
  "source": "packages/messaging/tests/Adapter/SMS/BirdTest.php",
  "cases": [
    {
      "name": "host follows the key region",
      "steps": [
        {
          "op": "bird.host_for",
          "args": {
            "api_key": "bk_eu1_Ab3xKq9mP2wR5tY8uI1oL4nJ"
          },
          "expect": "https://eu1.platform.bird.com"
        },
        {
          "op": "bird.host_for",
          "args": {
            "api_key": "bk_us1_Ab3xKq9mP2wR5tY8uI1oL4nJ"
          },
          "expect": "https://us1.platform.bird.com"
        },
        {
          "op": "bird.host_for",
          "args": {
            "api_key": "bk_ap1_Ab3xKq9mP2wR5tY8uI1oL4nJ"
          },
          "expect": "https://ap1.platform.bird.com"
        }
      ]
    },
    {
      "name": "key without region is rejected",
      "op": "adapter.new",
      "args": {
        "adapter": "bird",
        "args": {
          "apiKey": "live_Ab3xKq9mP2wR5tY8uI1oL4nJ"
        }
      },
      "expect": {
        "$error": {
          "class": "InvalidArgumentException",
          "message": "Bird API key must start with bk_{region}_, for example bk_eu1_ or bk_us1_."
        }
      }
    },
    {
      "name": "endpoint override skips region parsing",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "bird",
            "args": {
              "apiKey": "not-a-bird-key",
              "endpoint": "http://127.0.0.1:8080/"
            }
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "b"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+31612345678"
              ],
              "content": "Hi",
              "from": "Bird"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "sms",
              "results": [
                {
                  "recipient": "+31612345678",
                  "status": "success",
                  "error": "",
                  "permanent": false
                }
              ]
            },
            "requests": [
              {
                "method": "POST",
                "url": "http://127.0.0.1:8080/v1/sms/messages",
                "headers": [
                  "Content-Type: application/json",
                  "Authorization: Bearer not-a-bird-key"
                ],
                "body": {
                  "to": "+31612345678",
                  "from": "Bird",
                  "text": "Hi",
                  "category": "transactional"
                }
              }
            ]
          }
        }
      ]
    },
    {
