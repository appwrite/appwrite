        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "b"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+447700900000",
                "+447700900001"
              ],
              "content": "Hello",
              "from": "Bird"
            },
            "replies": [
              {
                "statusCode": 422,
                "response": {
                  "error": {
                    "type": "validation_error",
                    "code": "E12020",
                    "name": "SMSDestinationNotEnabled",
                    "message": "This destination country is not enabled for your workspace.",
                    "details": [
                      {
                        "param": "to",
                        "message": "country GB is not enabled"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "expect": {
            "result": {
              "deliveredTo": 0,
              "type": "sms",
              "results": [
                {
                  "recipient": "+447700900000",
                  "status": "failure",
                  "error": "E12020 This destination country is not enabled for your workspace. to: country GB is not enabled",
                  "permanent": false
                },
                {
                  "recipient": "+447700900001",
                  "status": "failure",
                  "error": "E12020 This destination country is not enabled for your workspace. to: country GB is not enabled",
                  "permanent": false
                }
              ]
            },
            "requests": [
              {
                "method": "POST",
                "url": "https://eu1.platform.bird.com/v1/sms/batches",
                "headers": [
                  "Content-Type: application/json",
                  "Authorization: Bearer bk_eu1_Ab3xKq9mP2wR5tY8uI1oL4nJ"
                ],
                "body": {
                  "messages": [
                    {
                      "to": "+447700900000",
                      "from": "Bird",
                      "text": "Hello",
                      "category": "transactional"
                    },
                    {
                      "to": "+447700900001",
                      "from": "Bird",
                      "text": "Hello",
                      "category": "transactional"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
