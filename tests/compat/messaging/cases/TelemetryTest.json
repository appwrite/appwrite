              "response": {
                "deliveredTo": 1,
                "type": "sms",
                "results": [
                  {
                    "recipient": "+1",
                    "status": "success",
                    "error": "",
                    "permanent": false
                  }
                ]
              }
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+1"
              ],
              "content": "Hello"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "sms",
              "results": [
                {
                  "recipient": "+1",
