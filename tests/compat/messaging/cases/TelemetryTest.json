{
  "source": "packages/messaging/tests/Adapter/TelemetryTest.php",
  "cases": [
    {
      "name": "records successes and failures",
      "steps": [
        {
          "op": "telemetry.new",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "name": "Test",
              "response": {
                "deliveredTo": 2,
                "type": "sms",
                "results": [
                  {
                    "recipient": "+1",
                    "status": "success",
                    "error": "",
                    "permanent": false
                  },
                  {
                    "recipient": "+2",
                    "status": "success",
                    "error": "",
                    "permanent": false
                  },
                  {
                    "recipient": "+3",
                    "status": "failure",
                    "error": "Nope",
                    "permanent": false
                  }
                ]
              }
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+1",
                "+2",
                "+3"
              ],
              "content": "Hello",
              "origin": "external"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 2,
              "type": "sms",
              "results": [
                {
                  "recipient": "+1",
                  "status": "success",
                  "error": "",
                  "permanent": false
                },
                {
                  "recipient": "+2",
                  "status": "success",
                  "error": "",
                  "permanent": false
                },
                {
                  "recipient": "+3",
                  "status": "failure",
                  "error": "Nope",
                  "permanent": false
                }
              ]
            }
          }
        },
        {
          "op": "telemetry.records",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": [
            {
              "amount": 2,
              "attributes": {
                "result": "success",
                "origin": "external",
                "type": "sms",
                "provider": "test"
              }
            },
            {
              "amount": 1,
              "attributes": {
                "result": "failure",
                "origin": "external",
                "type": "sms",
                "provider": "test"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "records thrown send as failure",
      "steps": [
        {
          "op": "telemetry.new",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "error": "Provider failed"
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+1",
                "+2"
              ],
              "content": "Hello"
            }
          },
          "expect": {
            "error": {
              "class": "Exception",
              "message": "Provider failed"
            }
          }
        },
        {
          "op": "telemetry.records",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": [
            {
              "amount": 2,
              "attributes": {
                "result": "failure",
                "type": "sms",
                "provider": "test"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "records counts from results, not deliveredTo (the PHP test's `pending` status is a failure here: a Rust Response holds success or failure)",
      "steps": [
        {
          "op": "telemetry.new",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "response": {
                "deliveredTo": 99,
                "type": "sms",
                "results": [
                  {
                    "recipient": "+1",
                    "status": "success",
                    "error": "",
                    "permanent": false
                  },
                  {
                    "recipient": "+2",
                    "status": "failure",
                    "error": "",
                    "permanent": false
                  }
                ]
              }
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+1",
                "+2"
              ],
              "content": "Hello"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 99,
              "type": "sms",
              "results": [
                {
                  "recipient": "+1",
                  "status": "success",
                  "error": "",
                  "permanent": false
                },
                {
                  "recipient": "+2",
                  "status": "failure",
                  "error": "",
                  "permanent": false
                }
              ]
            }
          }
        },
        {
          "op": "telemetry.records",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": [
            {
              "amount": 1,
              "attributes": {
                "result": "success",
                "type": "sms",
                "provider": "test"
              }
            },
            {
              "amount": 1,
              "attributes": {
                "result": "failure",
                "type": "sms",
                "provider": "test"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "GEOSMS propagates telemetry to local adapters",
      "steps": [
        {
          "op": "telemetry.new",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "response": {
                "deliveredTo": 0,
                "type": "sms",
                "results": []
              }
            }
          },
          "bind": "default",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "response": {
                "deliveredTo": 1,
                "type": "sms",
                "results": [
                  {
                    "recipient": "+911234567890",
                    "status": "success",
                    "error": "",
                    "permanent": false
                  }
                ]
              }
            }
          },
          "bind": "local",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "geosms",
            "args": {
              "defaultAdapter": {
                "$ref": "default"
              }
            }
          },
          "bind": "geo",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "method": "set_telemetry",
            "args": {
              "telemetry": {
                "$ref": "t"
              }
            }
          },
          "expect": {
            "result": null
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "method": "set_local",
            "args": {
              "code": "91",
              "adapter": {
                "$ref": "local"
              }
            }
          },
          "expect": {
            "result": true
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+911234567890"
              ],
              "content": "Hello",
              "origin": "internal"
            }
          },
          "expect": {
            "result": {
              "Test": {
                "deliveredTo": 1,
                "type": "sms",
                "results": [
                  {
                    "recipient": "+911234567890",
                    "status": "success",
                    "error": "",
                    "permanent": false
                  }
                ]
              }
            }
          }
        },
        {
          "op": "telemetry.records",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": [
            {
              "amount": 1,
              "attributes": {
                "result": "success",
                "origin": "internal",
                "type": "sms",
                "provider": "test"
              }
            }
          ]
        }
      ]
    },
    {
