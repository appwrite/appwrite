                  "error": "",
                  "permanent": false
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "a GEOSMS refusal is recorded for every recipient on its own telemetry, and the default adapter loses the telemetry it had",
      "steps": [
        {
          "op": "telemetry.new",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "telemetry.new",
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "name": "Default"
            },
            "telemetry": {
              "$ref": "u"
            }
          },
          "bind": "default",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "geosms",
            "args": {
              "defaultAdapter": {
                "$ref": "default"
              }
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "bind": "geo",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+911234567890",
                "+11234567890"
              ],
              "content": "Hello",
              "metadata": {
                "CRQID": 5
              }
            }
          },
          "expect": {
            "result": {
              "Default": {
                "deliveredTo": 0,
                "type": "sms",
                "results": []
              }
            }
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "default"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+1"
              ],
              "content": "Hello"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 0,
              "type": "sms",
              "results": []
            }
          }
        },
        {
          "op": "telemetry.records",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": []
        },
        {
          "op": "telemetry.records",
          "args": {
            "telemetry": {
              "$ref": "u"
            }
          },
          "expect": []
        }
      ]
    },
    {
      "name": "a message of the wrong type is refused before anything is recorded",
      "steps": [
        {
          "op": "telemetry.new",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "telemetry": {
              "$ref": "t"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "email",
              "to": [
                "a@example.test"
              ]
            }
          },
          "expect": {
            "$invalid": {
              "type": "message_type",
              "value": null,
              "message": "Test cannot send Utopia\\Messaging\\Messages\\Email messages."
            }
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "discord",
              "content": "hi"
            }
          },
          "expect": {
            "$invalid": {
              "type": "message_type",
              "value": null,
              "message": "Test cannot send Utopia\\Messaging\\Messages\\Discord messages."
            }
          }
        },
        {
          "op": "telemetry.records",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": []
        }
      ]
    },
    {
      "name": "too many recipients are refused before anything is recorded",
      "steps": [
        {
          "op": "telemetry.new",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "max": 1
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+1",
                "+2"
              ],
              "content": "Hello"
            }
          },
          "expect": {
            "$invalid": {
              "type": "too_many_recipients",
              "value": null,
              "message": "Test can only send 1 messages per request."
            }
          }
        },
        {
          "op": "telemetry.records",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": []
        }
      ]
    }
  ]
}
