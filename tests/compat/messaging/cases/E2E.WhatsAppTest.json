          },
          "expect": {
            "error": {
              "class": "InvalidArgumentException",
              "message": "WhatsApp template names must be 1 to 512 lowercase letters, digits and underscores."
            },
            "requests": []
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "delete_template",
            "args": {
              "businessAccountId": "9876543210",
              "name": "old_one"
            },
            "replies": [
              {
                "status": 200,
                "json": {
                  "success": true
                }
              }
            ]
          },
          "expect": {
