    {
      "name": "delivers a code, deletes a template, and upserts one with every option (through a client factory)",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "whatsapp",
            "args": {
              "accessToken": "compat-token",
              "phoneNumberId": "1234567890",
              "template": "utopia_messaging_test",
              "language": "pt_BR",
              "version": "v21.0"
            },
            "transport": "custom"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+44 7700 900000"
              ],
              "content": "A1b2C3"
            },
            "replies": [
              {
                "status": 200,
                "json": {
                  "messaging_product": "whatsapp",
                  "messages": [
                    {
                      "id": "wamid.1"
                    }
                  ]
                }
              }
            ]
          },
          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "sms",
              "results": [
                {
                  "recipient": "+44 7700 900000",
                  "status": "success",
                  "error": "",
                  "permanent": false
                }
              ]
            },
            "requests": [
              {
                "method": "POST",
                "url": "https://graph.facebook.com/v21.0/1234567890/messages",
                "headers": [
                  [
                    "Accept-Encoding",
                    "deflate, gzip, br, zstd"
                  ],
                  [
                    "Content-Type",
                    "application/json"
                  ],
                  [
                    "Authorization",
                    "Bearer compat-token"
                  ],
                  [
                    "User-Agent",
                    "Appwrite WhatsApp Message Sender"
                  ],
                  [
                    "Accept",
                    "application/json"
                  ],
                  [
                    "Content-Length",
                    "344"
                  ]
                ],
                "body": "{\"messaging_product\":\"whatsapp\",\"recipient_type\":\"individual\",\"to\":\"447700900000\",\"type\":\"template\",\"template\":{\"name\":\"utopia_messaging_test\",\"language\":{\"code\":\"pt_BR\"},\"components\":[{\"type\":\"body\",\"parameters\":[{\"type\":\"text\",\"text\":\"A1b2C3\"}]},{\"type\":\"button\",\"sub_type\":\"url\",\"index\":\"0\",\"parameters\":[{\"type\":\"text\",\"text\":\"A1b2C3\"}]}]}}"
              }
            ]
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "delete_template",
            "args": {
              "businessAccountId": "9876543210",
