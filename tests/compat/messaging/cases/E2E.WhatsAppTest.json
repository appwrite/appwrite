    {
      "name": "delivers a code, deletes a template, and upserts one with every option (through a client factory)",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "whatsapp",
            "args": {
              "accessToken": "compat-token",
              "phoneNumberId": "1234567890",
              "template": "utopia_messaging_test",
              "language": "pt_BR",
              "version": "v21.0"
            },
            "transport": "custom"
          },
          "bind": "a"
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+44 7700 900000"
              ],
              "content": "A1b2C3"
            },
            "replies": [
              {
                "status": 200,
                "json": {
                  "messaging_product": "whatsapp",
                  "messages": [
                    {
                      "id": "wamid.1"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "delete_template",
            "args": {
              "businessAccountId": "9876543210",
              "name": "old one"
            }
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "delete_template",
            "args": {
              "businessAccountId": "9876543210",
              "name": "old_one"
            },
            "replies": [
              {
                "status": 200,
                "json": {
                  "success": true
                }
              }
            ]
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "upsert_template",
            "args": {
              "businessAccountId": "9876543210",
              "expirationMinutes": 10,
              "securityRecommendation": false,
              "timeToLive": -1,
              "otpType": "zero_tap",
              "apps": [
                {
                  "package_name": "com.example.app",
                  "signature_hash": "K8a/AINcGX7"
                }
              ]
            },
            "replies": [
              {
                "status": 200,
                "json": {
                  "data": [
                    {
                      "id": "1",
                      "status": "APPROVED",
                      "language": "en_US"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "delete_template",
            "args": {
              "businessAccountId": "9876543210"
            },
            "replies": [
              {
                "status": 500,
                "body": "not json"
              }
            ]
          }
        }
      ]
    }
  ]
}
