{
  "source": "packages/messaging/tests/E2E/Adapter/SMS/WhatsAppTest.php",
  "cases": [
    {
      "name": "lists every language of a template with its status",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "whatsapp",
            "args": {
              "accessToken": "compat-token",
              "phoneNumberId": "1234567890",
              "template": "utopia_messaging_test"
            },
            "transport": "fixture"
          },
          "bind": "a"
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "get_template",
            "args": {
              "businessAccountId": "9876543210",
              "name": "hello_world"
            },
            "replies": [
              {
                "status": 200,
                "json": {
                  "data": [
                    {
                      "id": "1",
                      "name": "hello_world",
                      "language": "en_US",
                      "status": "APPROVED",
                      "category": "UTILITY"
                    },
                    {
                      "id": "2",
                      "name": "hello_world",
                      "language": "pt_BR",
                      "status": "APPROVED",
                      "category": "UTILITY"
                    }
                  ],
                  "paging": {
                    "cursors": {
                      "before": "a",
                      "after": "b"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
