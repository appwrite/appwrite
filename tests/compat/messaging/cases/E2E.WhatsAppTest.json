            "method": "upsert_template",
            "args": {
              "businessAccountId": "9876543210",
              "expirationMinutes": 10,
              "securityRecommendation": false,
              "timeToLive": -1,
              "otpType": "zero_tap",
              "apps": [
                {
                  "package_name": "com.example.app",
                  "signature_hash": "K8a/AINcGX7"
                }
              ]
            },
            "replies": [
              {
                "status": 200,
                "json": {
                  "data": [
                    {
                      "id": "1",
                      "status": "APPROVED",
                      "language": "en_US"
                    }
                  ]
                }
              }
            ]
          },
          "expect": {
            "result": {
              "data": [
                {
                  "id": "1",
                  "status": "APPROVED",
                  "language": "en_US"
                }
