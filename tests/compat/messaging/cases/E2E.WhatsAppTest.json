    {
      "name": "surfaces a rejected template creation as an exception",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "whatsapp",
            "args": {
              "accessToken": "compat-token",
              "phoneNumberId": "1234567890",
              "template": "utopia_messaging_test"
            },
            "transport": "fixture"
          },
          "bind": "a"
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "upsert_template",
            "args": {
              "businessAccountId": "9876543210",
              "languages": [
                "en_US"
              ]
            },
            "replies": [
              {
                "status": 400,
                "json": {
                  "error": {
                    "message": "(#200002) Template creation is not allowed for test accounts",
                    "type": "OAuthException",
                    "code": 200002,
                    "error_data": {
                      "messaging_product": "whatsapp",
                      "details": "Test accounts cannot create templates"
                    },
                    "fbtrace_id": "Ab1"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "reports a missing template",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "whatsapp",
            "args": {
              "accessToken": "compat-token",
              "phoneNumberId": "1234567890",
              "template": "utopia_messaging_test"
            },
            "transport": "fixture"
          },
          "bind": "a"
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+1 (555) 000-0001"
              ],
              "content": "123456"
            },
            "replies": [
              {
                "status": 404,
                "json": {
                  "error": {
                    "message": "(#132001) Template name does not exist in the translation",
                    "type": "OAuthException",
                    "code": 132001,
                    "error_data": {
                      "messaging_product": "whatsapp",
                      "details": "template name (utopia_messaging_test) does not exist in en_US"
                    },
                    "fbtrace_id": "Ab1"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "overrides the template per message",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "whatsapp",
            "args": {
              "accessToken": "compat-token",
              "phoneNumberId": "1234567890",
              "template": "hello_world"
            },
            "transport": "fixture"
          },
          "bind": "a"
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+15550000001"
              ],
              "content": "123456",
              "set_metadata": {
                "template": "utopia_messaging_test",
                "language": "en_US",
                "callbackData": "utopia-messaging-e2e"
              }
            },
            "replies": [
              {
                "status": 404,
                "json": {
                  "error": {
                    "message": "(#132001) Template name does not exist in the translation",
                    "type": "OAuthException",
                    "code": 132001,
                    "fbtrace_id": "Ab1"
                  }
                }
              }
            ]
          }
        }
      ]
    },
