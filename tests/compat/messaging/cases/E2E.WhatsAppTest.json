                "body": "{\"name\":\"utopia_messaging_test\",\"category\":\"authentication\",\"components\":[{\"type\":\"body\",\"add_security_recommendation\":true},{\"type\":\"buttons\",\"buttons\":[{\"type\":\"otp\",\"otp_type\":\"copy_code\"}]}],\"languages\":[\"en_US\"]}"
