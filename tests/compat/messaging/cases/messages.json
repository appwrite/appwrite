{
  "cases": [
    {
      "name": "SMS getters",
      "steps": [
        {
          "op": "sms.new",
          "args": {
            "to": [
              "+1",
              "+2"
            ],
            "content": "Hi",
            "from": "Me",
            "attachments": [
              "https://example.test/a.png"
            ],
            "metadata": {
              "a": 1,
              "b": [
                1,
                2
              ],
              "c": {
                "d": null
              }
            },
            "origin": "internal"
          },
          "expect": {
            "to": [
              "+1",
              "+2"
            ],
            "content": "Hi",
            "from": "Me",
            "attachments": [
              "https://example.test/a.png"
            ],
            "metadata": {
              "a": 1,
              "b": [
                1,
                2
              ],
              "c": {
                "d": null
              }
            },
            "origin": "internal"
          }
        },
        {
          "op": "sms.new",
          "args": {
            "to": [],
            "content": ""
          },
          "expect": {
            "to": [],
            "content": "",
            "from": null,
            "attachments": null,
            "metadata": null,
            "origin": null
          }
        },
        {
          "op": "sms.new",
          "args": {
            "to": [
              "+1"
            ],
            "content": "x",
            "metadata": {
              "a": 1
            },
            "set_metadata": null,
            "origin": null
          },
          "expect": {
            "to": [
              "+1"
            ],
            "content": "x",
            "from": null,
            "attachments": null,
            "metadata": null,
            "origin": null
          }
        },
        {
          "op": "sms.new",
          "args": {
            "to": [
              "+1"
            ],
            "content": "x",
            "set_metadata": {
              "0": "zero",
              "1": "one"
            }
          },
          "expect": {
            "to": [
              "+1"
            ],
            "content": "x",
            "from": null,
            "attachments": null,
            "metadata": [
              "zero",
              "one"
            ],
            "origin": null
          }
        }
      ]
    },
