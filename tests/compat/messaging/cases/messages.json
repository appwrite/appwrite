              },
              {
                "add_result": [
                  "d",
                  "",
                  true
                ]
              },
              {
                "add_result": [
                  "e",
                  "550 no",
                  true
                ]
              },
              {
                "add_result": [
                  "f",
                  "450 later",
                  false
                ]
              }
            ]
          },
          "expect": {
            "deliveredTo": 4,
            "type": "push",
            "details": [
              {
                "recipient": "a",
                "status": "success",
                "error": "",
                "permanent": false
              },
              {
                "recipient": "b",
                "status": "failure",
                "error": "boom",
                "permanent": false
              },
              {
                "recipient": "c",
                "status": "success",
                "error": "0",
                "permanent": false
              },
              {
                "recipient": "d",
                "status": "success",
                "error": "",
                "permanent": false
              },
              {
                "recipient": "e",
                "status": "failure",
                "error": "550 no",
                "permanent": true
              },
              {
                "recipient": "f",
                "status": "failure",
                "error": "450 later",
                "permanent": false
              }
            ],
            "array": {
              "deliveredTo": 4,
              "type": "push",
              "results": [
                {
                  "recipient": "a",
                  "status": "success",
                  "error": "",
                  "permanent": false
                },
                {
                  "recipient": "b",
                  "status": "failure",
                  "error": "boom",
                  "permanent": false
                },
                {
                  "recipient": "c",
                  "status": "success",
