    {
      "name": "exceptions",
      "steps": [
        {
          "op": "exception.new",
          "args": {
            "type": "recipient_malformed",
            "message": "Bad",
            "value": "x"
          },
          "expect": {
            "class": "Utopia\\Messaging\\Exception\\InvalidArgumentException",
            "type": "recipient_malformed",
            "value": "x",
            "message": "Bad",
            "code": 0
          }
        },
        {
          "op": "exception.new",
          "args": {
            "type": "message_type",
            "message": ""
          },
          "expect": {
            "class": "Utopia\\Messaging\\Exception\\InvalidArgumentException",
            "type": "message_type",
            "value": null,
            "message": "",
            "code": 0
          }
        },
        {
          "op": "no_host_answered.new",
          "args": {
            "message": "m",
            "permanent": false
          },
          "expect": {
            "class": "Utopia\\Messaging\\Adapter\\Email\\SMTP\\NoHostAnswered",
            "message": "m",
            "permanent": false,
            "connection": true
          }
        }
      ]
