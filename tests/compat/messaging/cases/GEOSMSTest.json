{
  "source": "packages/messaging/tests/Adapter/SMS/GEOSMSTest.php",
  "cases": [
    {
      "name": "send SMS using default adapter",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "name": "default",
              "response": {
                "deliveredTo": 1,
                "type": "sms",
                "results": [
                  {
                    "recipient": "+11234567890",
                    "status": "success",
                    "error": "",
                    "permanent": false
                  }
                ]
              }
            }
          },
          "bind": "default",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "geosms",
            "args": {
              "defaultAdapter": {
                "$ref": "default"
              }
            }
          },
          "bind": "geo",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+11234567890"
              ],
              "content": "Test Content",
              "from": "Sender"
            }
          },
          "expect": {
            "result": {
              "default": {
                "deliveredTo": 1,
                "type": "sms",
                "results": [
                  {
                    "recipient": "+11234567890",
                    "status": "success",
                    "error": "",
                    "permanent": false
                  }
                ]
              }
            }
          }
        },
        {
          "op": "scripted.messages",
          "args": {
            "adapter": {
              "$ref": "default"
            }
          },
          "expect": [
            {
              "to": [
                "+11234567890"
              ],
              "content": "Test Content",
              "from": "Sender",
              "attachments": null,
              "metadata": null,
              "origin": null
            }
          ]
        }
      ]
    },
