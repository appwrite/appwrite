    {
      "name": "long tracking IDs are cut to fit their batch suffix",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "name": "default"
            }
          },
          "bind": "default",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "name": "local"
            }
          },
          "bind": "local",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "geosms",
            "args": {
              "defaultAdapter": {
                "$ref": "default"
              }
            }
          },
          "bind": "geo",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "method": "set_local",
            "args": {
              "code": "44",
              "adapter": {
                "$ref": "local"
              }
            }
          },
          "expect": {
            "result": true
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+11234567890",
                "+447700900000",
                "+11234567891",
                "+447700900001"
              ],
              "content": "Hi",
              "metadata": {
                "UUID": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "other": 1
              }
            }
          },
          "expect": {
            "result": {
              "default": {
                "deliveredTo": 0,
                "type": "sms",
                "results": []
              },
              "local": {
                "deliveredTo": 0,
                "type": "sms",
                "results": []
              }
            }
          }
        },
        {
          "op": "scripted.messages",
          "args": {
            "adapter": {
              "$ref": "default"
            }
          },
          "expect": [
            {
              "to": [
                "+11234567890",
                "+11234567891"
              ],
              "content": "Hi",
              "from": null,
              "attachments": null,
              "metadata": {
                "UUID": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-1",
                "other": 1
              },
              "origin": null
            }
          ]
        },
        {
          "op": "scripted.messages",
          "args": {
            "adapter": {
              "$ref": "local"
            }
          },
          "expect": [
            {
              "to": [
                "+447700900000",
                "+447700900001"
              ],
              "content": "Hi",
              "from": null,
              "attachments": null,
              "metadata": {
                "UUID": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-2",
                "other": 1
              },
              "origin": null
            }
          ]
        }
      ]
    },
    {
      "name": "an adapter that throws becomes an error entry, and duplicates go once",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "name": "default",
              "error": "Provider down"
            }
          },
          "bind": "default",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "scripted",
            "args": {
              "name": "local",
              "max": 1
            }
          },
          "bind": "local",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.new",
          "args": {
            "adapter": "geosms",
            "args": {
              "defaultAdapter": {
                "$ref": "default"
              }
            }
          },
          "bind": "geo",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "method": "set_local",
            "args": {
              "code": "91",
              "adapter": {
                "$ref": "local"
              }
            }
          },
          "expect": {
            "result": true
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "geo"
            },
            "message": {
              "kind": "sms",
              "to": [
                "+911",
                "+1",
                "+911",
                "+912",
                "+1"
              ],
              "content": "Hi"
            }
          },
          "expect": {
            "result": {
              "local": {
                "type": "error",
                "message": "local can only send 1 messages per request."
              },
              "default": {
                "type": "error",
                "message": "Provider down"
              }
            }
          }
        },
        {
          "op": "scripted.messages",
          "args": {
            "adapter": {
              "$ref": "default"
            }
          },
          "expect": [
            {
              "to": [
                "+1",
                "+1"
              ],
              "content": "Hi",
              "from": null,
              "attachments": null,
              "metadata": null,
              "origin": null
            }
          ]
        }
      ]
    },
