          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.call",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "method": "upsert_template",
            "args": {
              "businessAccountId": "1",
              "expirationMinutes": 0
            }
          },
          "expect": {
            "error": {
              "class": "InvalidArgumentException",
              "message": "WhatsApp code expiration must be between 1 and 90 minutes."
