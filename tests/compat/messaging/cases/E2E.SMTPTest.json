{
  "source": "packages/messaging/tests/E2E/Adapter/Email/SMTPTest.php",
  "cases": [
    {
      "name": "send email",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "smtp",
            "args": {
              "host": "{mailpit}",
              "port": 25
            },
            "transport": "none"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "email",
              "to": [
                "tester@localhost.test"
              ],
              "content": "Test Content",
              "from_name": "Test Sender",
              "from_email": "sender@localhost.test",
              "subject": "Test Subject ${ns}"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "email",
              "results": [
                {
                  "recipient": "tester@localhost.test",
                  "status": "success",
                  "error": "",
                  "permanent": false
                }
              ]
            }
          }
        },
        {
          "op": "mailpit.message",
          "args": {
            "subject": "Test Subject ${ns}"
          },
          "expect": {
            "subject": "Test Subject ${ns}",
            "from": [
              [
                "Test Sender",
                "sender@localhost.test"
              ]
            ],
            "to": [
              [
                "",
                "tester@localhost.test"
              ]
            ],
            "cc": [],
            "bcc": [],
            "reply_to": [
              [
                "Test Sender",
                "sender@localhost.test"
              ]
            ],
            "text": "Test Content",
            "html": "",
            "attachments": [],
            "headers": []
          }
        }
      ]
    },
