    {
      "name": "reports why a server could not be reached",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "smtp",
            "args": {
              "host": "127.0.0.1",
              "port": 1,
              "timeout": 2,
              "timelimit": 2
            },
            "transport": "none"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "email",
              "to": [
                "tester@localhost.test"
              ],
              "content": "Test Content",
              "from_name": "Test Sender",
              "from_email": "sender@localhost.test",
              "subject": "Unreachable ${ns}"
            }
          },
          "expect": {
            "result": {
              "deliveredTo": 0,
              "type": "email",
              "results": [
                {
                  "recipient": "tester@localhost.test",
                  "status": "failure",
                  "error": "No SMTP host answered: 127.0.0.1:1 (Cannot reach 127.0.0.1:1: Connection refused)",
                  "permanent": false
                }
              ]
            }
          }
        }
      ]
    },
