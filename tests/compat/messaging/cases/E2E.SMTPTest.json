{
  "source": "packages/messaging/tests/E2E/Adapter/Email/SMTPTest.php",
  "cases": [
    {
      "name": "send email",
      "requires": [
        "services"
      ],
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "smtp",
            "args": {
              "host": "{mailpit}",
              "port": 25
            },
            "transport": "none"
          },
          "bind": "a"
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "email",
              "to": [
                "tester@localhost.test"
              ],
              "content": "Test Content",
              "from_name": "Test Sender",
              "from_email": "sender@localhost.test",
              "subject": "Test Subject ${ns}"
            }
          }
        },
        {
          "op": "mailpit.message",
          "args": {
            "subject": "Test Subject ${ns}"
          }
        }
      ]
    },
