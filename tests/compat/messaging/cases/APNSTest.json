{
  "source": "packages/messaging/tests/Adapter/Push/APNSTest.php",
  "cases": [
    {
      "name": "a silent wake has no alert: data at the payload root, a background push at priority 5",
      "steps": [
        {
          "op": "adapter.new",
          "args": {
            "adapter": "apns",
            "args": {
              "authKey": {
                "fixture": "es256"
              },
              "authKeyId": "keyId",
              "teamId": "teamId",
              "bundleId": "com.example.app"
            }
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.send",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "message": {
              "kind": "push",
              "to": [
                "token"
              ],
              "data": {
                "type": "wake",
                "messageId": "msg1"
              },
              "content_available": true,
              "priority": "HIGH"
            },
            "replies": [
              {
                "statusCode": 200
              }
            ]
          },
          "expect": {
            "result": {
              "deliveredTo": 1,
              "type": "push",
              "results": [
                {
                  "recipient": "token",
                  "status": "success",
                  "error": "",
                  "permanent": false
                }
              ]
            },
            "requests": [
              {
                "method": "POST",
                "urls": [
                  "https://api.push.apple.com/3/device/token"
                ],
                "headers": [
                  "Content-Type: application/json",
                  "Authorization: Bearer <jwt>",
                  "apns-topic: com.example.app",
                  "apns-push-type: background",
                  "apns-priority: 5"
                ],
                "bodies": [
                  {
                    "data": {
                      "type": "wake",
                      "messageId": "msg1"
                    },
                    "aps": {
                      "content-available": 1
                    }
                  }
                ],
                "jwt": [
                  {
                    "header": {
                      "typ": "JWT",
                      "alg": "ES256",
                      "kid": "keyId"
                    },
                    "payload": {
                      "iss": "teamId",
                      "iat": "<now>",
                      "exp": "<iat+3600>"
                    },
                    "verified": true
                  }
                ]
              }
            ]
          }
        }
      ]
    },
