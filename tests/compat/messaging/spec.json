              },
              "secure": {
                "gen": "pick",
                "from": [
                  "",
                  "ssl",
                  "tls"
                ]
              },
              "auto_tls": {
                "gen": "pick",
                "from": [
                  true,
                  false
                ]
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "telemetry.new": {
