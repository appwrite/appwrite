    "whatsapp.app": {
      "doc": "(new App(package_name, signature_hash))->toArray()",
      "covers": [
        "Utopia\\Messaging\\Adapter\\SMS\\WhatsApp\\App::*"
      ]
    },
    "mime.message": {
      "doc": "(string) Mime::message(email, to (default: the email's), cc, bcc, headers), with random boundaries renamed =_BOUNDARY<n> in order, `Date: <date>` and the random Message-ID part `<id>`",
      "covers": [
        "Utopia\\Messaging\\Adapter\\Email\\Mime::message"
      ],
      "fuzz": [
        {
          "name": "bodies",
          "args": {
            "gen": "object",
            "fields": {
              "email": {
                "gen": "object",
                "fields": {
                  "to": {
                    "gen": "array",
                    "items": {
                      "gen": "pick",
                      "from": [
                        "a@example.test",
                        {
                          "email": "b@example.test",
                          "name": "B, Jr."
                        }
                      ]
                    },
                    "min": 1,
                    "max": 2
                  },
                  "subject": {
                    "gen": "string",
                    "alphabet": "abc é😀=?",
                    "max": 90
                  },
                  "content": {
                    "gen": "ref",
                    "name": "markup"
                  },
                  "html": {
                    "gen": "bool"
                  },
                  "from_name": {
                    "gen": "ref",
                    "name": "display_name"
                  }
                }
              }
            }
          },
          "iterations": 1500
        }
      ]
    },
    "mime.addresses": {
      "doc": "Mime::addresses(recipients): {email, name, string} of each",
      "covers": [
        "Utopia\\Messaging\\Adapter\\Email\\Mime::addresses"
      ]
    },
    "mime.attachments": {
      "doc": "Mime::attachments(email): {name, type, content, path} of each",
      "covers": [
        "Utopia\\Messaging\\Adapter\\Email\\Mime::attachments"
      ]
    },
    "mime.size": {
      "doc": "Mime::size(email)",
      "covers": [
        "Utopia\\Messaging\\Adapter\\Email\\Mime::size"
      ]
    },
    "ses.sign": {
      "doc": "the protected SES::sign(method, path, payload, signed_headers, amz_date) of new SES(access_key, secret_key, region) with $service set to `service` (SESSigningTest's stub)",
      "fuzz": [
        {
          "name": "requests",
          "args": {
            "gen": "object",
            "fields": {
              "access_key": {
                "gen": "string",
                "alphabet": "ABCDEFKX0123",
                "min": 1,
                "max": 20
              },
              "secret_key": {
                "gen": "string",
                "max": 40
              },
              "region": {
                "gen": "pick",
                "from": [
                  "us-east-1",
                  "eu-west-1",
                  ""
                ]
              },
              "service": {
                "gen": "pick",
                "from": [
                  "ses",
                  "service"
                ]
              },
              "method": {
                "gen": "pick",
                "from": [
                  "GET",
                  "POST"
                ]
              },
              "path": {
                "gen": "pick",
                "from": [
                  "/",
                  "/v2/email/outbound-bulk-emails",
                  "/a b"
                ]
              },
              "payload": {
                "gen": "string",
                "max": 60
              },
              "signed_headers": {
                "gen": "pick",
                "from": [
                  {
                    "host": "example.amazonaws.com",
                    "x-amz-date": "20150830T123600Z"
                  },
                  {
                    "x-amz-date": "20260101T000000Z",
                    "content-type": " application/json ",
                    "host": "email.us-east-1.amazonaws.com"
                  }
                ]
              },
              "amz_date": {
                "gen": "pick",
                "from": [
                  "20150830T123600Z",
                  "20260101T000000Z",
                  "2026"
                ]
              }
            }
          },
          "iterations": 1500
        }
      ]
    },
    "smtp.hosts": {
      "doc": "the private SMTP::hosts() of new SMTP(host, port?, smtpSecure: secure?, smtpAutoTLS: auto_tls?), as SMTPHostsTest reads it: [host, port, Encryption case name] each",
      "fuzz": [
