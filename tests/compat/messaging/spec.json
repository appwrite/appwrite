{
  "lib": "messaging",
  "description": "utopia-php/messaging: email, SMS, push and Discord messages and their validation, the provider adapters (SMTP and its Mock, SES with SigV4, Mailgun, Sendgrid, Resend; Twilio, Vonage, Telnyx, Plivo, Sinch, Seven, Clickatell, Infobip, Inforu, TextMagic, Telesign, Msg91, Fast2SMS, Bird, WhatsApp, the SMS Mock and GEOSMS routing by calling code; APNs and FCM with their JWTs; Discord webhooks), per-recipient responses and send telemetry. No provider is ever called: requests are answered by stubs (as the library's own tests do) or sent to the messaging-http fixture server, which records them and verifies their signatures; SMTP goes to scripted SMTP servers and a throwaway Mailpit.",
  "complete": true,
  "php": {
    "src": [
      "packages/messaging/src"
    ],
    "tests": [
      "packages/messaging/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/messaging"
  },
  "services": [
    "messaging-http",
    "messaging-smtp",
    "messaging-mailpit"
  ],
  "state": [],
  "ops": {
    "email.new": {
      "doc": "new Email(to, subject, content, fromName, fromEmail, replyToName?, replyToEmail?, cc?, bcc?, attachments?, html?, headers?) then setOrigin(origin) when given: every getter, or {$invalid: {type, value, message}} when the library refuses it",
      "covers": [
        "Utopia\\Messaging\\Messages\\Email::*",
        "Utopia\\Messaging\\Exception\\InvalidArgumentException::getType",
        "Utopia\\Messaging\\Exception\\InvalidArgumentException::getValue"
      ],
      "fuzz": [
        {
          "name": "addresses",
          "args": {
            "gen": "object",
            "fields": {
              "to": {
                "gen": "array",
                "items": {
                  "gen": "ref",
                  "name": "recipient"
                },
                "min": 0,
                "max": 3
              },
              "from_email": {
                "gen": "ref",
                "name": "address"
              },
              "from_name": {
                "gen": "ref",
                "name": "display_name"
              },
              "reply_to_email": {
                "gen": "ref",
                "name": "address"
              },
              "headers": {
                "gen": "ref",
                "name": "headers"
              }
            },
            "optional": [
              "reply_to_email",
              "headers"
            ]
          },
          "iterations": 3000
        }
      ]
    },
    "sms.new": {
      "doc": "new SMS(to, content, from?, attachments?, metadata?), then setMetadata(set_metadata) and setOrigin(origin) when given: every getter",
      "covers": [
        "Utopia\\Messaging\\Messages\\SMS::*"
      ]
    },
    "push.new": {
      "doc": "new Push(to, title?, body?, data?, action?, sound?, image?, icon?, color?, tag?, badge?, contentAvailable?, critical?, priority? (a Priority case name), channelId?, mutableContent?), then setOrigin(origin) when given: every getter",
      "covers": [
        "Utopia\\Messaging\\Messages\\Push::*"
      ]
    },
    "discord.new": {
      "doc": "new Discord(content, username?, avatarUrl?, tts?, embeds?, allowedMentions?, components?, attachments?, flags?, threadName?, wait?, threadId?), then setOrigin(origin) when given: every getter",
      "covers": [
        "Utopia\\Messaging\\Messages\\Discord::*"
      ]
    },
    "attachment.new": {
      "doc": "new Attachment(name, path, type, content?): every getter; content {repeat, times} is that string repeated",
      "covers": [
        "Utopia\\Messaging\\Messages\\Email\\Attachment::*"
      ]
    },
    "response.run": {
      "doc": "new Response(type), then steps ({set_delivered_to: n}, {increment: true}, {set_type: t}, {add_result: [recipient, error?, permanent?]}): {deliveredTo, type, details, array: toArray()}",
      "covers": [
        "Utopia\\Messaging\\Response::*"
      ]
    },
    "exception.new": {
      "doc": "new InvalidArgumentException(type, message, value?): {class, type, value, message, code}",
      "covers": [
        "Utopia\\Messaging\\Exception\\InvalidArgumentException::__construct"
      ]
    },
    "no_host_answered.new": {
      "doc": "new NoHostAnswered(message, permanent): {class, message, permanent, connection: instanceof ConnectionException}",
      "covers": [
        "Utopia\\Messaging\\Adapter\\Email\\SMTP\\NoHostAnswered::__construct"
      ]
    },
    "enums": {
      "doc": "every case of Priority, Bird\\Category, WhatsApp\\OtpType (with requiresApps()), Msg91 and WhatsApp MetadataParameter, the InvalidArgumentException types and the WhatsApp and App constants",
      "covers": [
        "Utopia\\Messaging\\Adapter\\SMS\\WhatsApp\\OtpType::requiresApps"
      ]
    },
    "calling_code.from_phone_number": {
      "doc": "CallingCode::fromPhoneNumber(number)",
      "covers": [
        "Utopia\\Messaging\\Adapter\\SMS\\GEOSMS\\CallingCode::fromPhoneNumber"
      ],
      "fuzz": [
        {
          "name": "numbers",
          "args": {
            "gen": "object",
            "fields": {
              "number": {
                "gen": "ref",
                "name": "phone"
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "calling_code.constants": {
      "doc": "every public constant of CallingCode, by name"
    },
    "jwt.encode": {
      "doc": "JWT::encode(payload, key, algorithm, key_id?) with key a string or {fixture: <name>} (tests/compat/messaging/fixtures/keys/<name>.pem): {header, payload, signature (ES* signatures are random: their length), verified: whether the fixture public key of `verify` (default: the algorithm) verifies it}",
      "covers": [
        "Utopia\\Messaging\\Helpers\\JWT::encode"
      ],
      "fuzz": [
        {
          "name": "hmac",
          "args": {
            "gen": "object",
            "fields": {
              "payload": {
                "gen": "ref",
                "name": "claims"
              },
              "key": {
                "gen": "string",
                "max": 40
              },
              "algorithm": {
                "gen": "pick",
                "from": [
                  "HS256",
                  "HS384",
                  "HS512",
                  "XX256",
                  "hs256"
                ]
              },
              "key_id": {
                "gen": "string",
                "max": 12
              }
            },
            "optional": [
              "key_id"
            ]
          },
          "iterations": 1500
        },
        {
          "name": "rsa",
          "args": {
            "gen": "object",
            "fields": {
              "payload": {
                "gen": "ref",
                "name": "claims"
              },
              "key": {
                "gen": "pick",
                "from": [
                  {
                    "fixture": "rs256"
                  }
                ]
              },
              "algorithm": {
                "gen": "pick",
                "from": [
                  "RS256",
                  "RS384",
                  "RS512"
                ]
              }
            }
          },
          "iterations": 300
        }
      ]
    },
    "bird.host_for": {
      "doc": "Bird::hostFor(api_key)",
      "covers": [
        "Utopia\\Messaging\\Adapter\\SMS\\Bird::hostFor"
      ],
      "fuzz": [
        {
          "name": "keys",
          "args": {
            "gen": "object",
            "fields": {
              "api_key": {
                "gen": "ref",
                "name": "bird_key"
              }
            }
          },
          "iterations": 2000
        }
      ]
