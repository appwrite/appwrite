    {
      "name": "ProfilerAdvancedTest::testBacktraceCaptureWhenEnabled",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Profiler",
            "args": {},
            "as": "o149"
          },
          "bind": "s337",
          "expect": {
            "$profiler": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o149"
            },
            "method": "enable",
            "args": {}
          },
          "expect": {
            "$profiler": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o149"
            },
            "method": "enableBacktrace",
            "args": {
              "enabled": true
            }
          },
          "expect": {
            "$profiler": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o149"
            },
            "method": "log",
            "args": {
              "query": "SELECT 1",
              "bindings": [],
              "durationMs": 1.0
            }
          },
          "expect": null
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o149"
            },
            "method": "getLogs",
            "args": {}
          },
          "expect": [
            {
              "$value": "Profiler\\Log",
              "fields": {
                "query": "SELECT 1",
                "bindings": [],
                "durationMs": "<masked>",
                "collection": "",
                "operation": "",
                "backtrace": "<masked>"
              }
            }
          ],
          "mask": {
            "paths": [
              "/*/fields/durationMs",
              "/*/fields/backtrace",
              "/calls/*/*/steps/*/*/fields/durationMs",
              "/calls/*/*/steps/*/*/fields/backtrace"
            ],
            "reason": "a profiled statement's duration and the PHP stack it ran from are the runtime's own"
          }
        }
      ]
    },
