    {
      "name": "testTimeoutChangedInsideATransactionReachesThePinnedConnection",
      "steps": [
        {
          "op": "db.open",
          "args": {
            "pool": {
              "size": 1
            }
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "setTimeout",
            "args": {
              "milliseconds": 5000
            }
          },
          "expect": null
        },
        {
          "op": "database.with_transaction",
          "args": {
            "callback": {
              "steps": [
                {
                  "op": "db.pool",
                  "args": {
                    "method": "pinned_timeout"
                  }
                },
                {
                  "op": "db.adapter",
                  "args": {
                    "method": "setTimeout",
                    "args": {
                      "milliseconds": 300000
                    }
                  }
                },
                {
                  "op": "db.pool",
                  "args": {
                    "method": "pinned_timeout"
                  }
                },
                {
                  "op": "db.adapter",
                  "args": {
                    "method": "clearTimeout",
                    "args": {
                      "event": "*"
                    }
                  }
                },
                {
                  "op": "db.pool",
                  "args": {
                    "method": "pinned_timeout"
                  }
                },
                {
                  "op": "$return",
                  "args": {
                    "value": "row-written"
                  }
                }
              ]
            }
          },
          "expect": {
            "result": "row-written",
            "calls": {
              "callback": [
                {
                  "args": [],
                  "steps": [
                    5000,
                    null,
                    300000,
                    null,
                    0,
                    null
                  ]
                }
              ]
            }
          }
        },
        {
          "op": "db.pool",
          "args": {
            "method": "pinned_timeout"
          },
          "expect": null
        }
      ]
    },
