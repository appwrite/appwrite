    {
      "name": "testHandleWithNoTimeoutResetsTheConnectionItIsGiven",
      "steps": [
        {
          "op": "db.open",
          "args": {
            "pool": {
              "size": 1
            }
          },
          "bind": "bounded",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "setTimeout",
            "args": {
              "milliseconds": 5000
            }
          },
          "expect": null
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "getSupportForTimeouts",
            "args": {}
          },
          "expect": true
        },
        {
          "op": "db.pool",
          "args": {
            "method": "timeout"
          },
          "expect": 5000
        },
        {
          "op": "db.open",
          "args": {
            "pool": {
              "of": {
                "$ref": "bounded"
              }
            },
            "create": false
          },
          "bind": "unbounded",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "getSupportForTimeouts",
            "args": {},
            "db": {
              "$ref": "unbounded"
            }
          },
          "expect": true
        },
        {
          "op": "db.pool",
          "args": {
            "method": "timeout"
          },
          "expect": 0
        }
      ]
    },
