{
  "source": "vendor/utopia-php/database/tests/unit/PoolTimeoutTest.php",
  "cases": [
    {
      "name": "testSetTimeoutDoesNotOpenAConnection",
      "steps": [
        {
          "op": "db.open",
          "args": {
            "pool": {
              "size": 1,
              "unreachable": true
            },
            "create": false
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "setTimeout",
            "args": {
              "milliseconds": 300000
            }
          },
          "expect": null
        },
        {
          "op": "db.pool",
          "args": {
            "method": "opened"
          },
          "expect": 0
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "getTimeout",
            "args": {}
          },
          "expect": 300000
        }
      ]
    },
    {
      "name": "testTimeoutIsAppliedToEveryCheckout",
      "steps": [
        {
          "op": "db.open",
          "args": {
            "pool": {
              "size": 1
            }
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "setTimeout",
            "args": {
              "milliseconds": 300000
            }
          },
          "expect": null
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "getSupportForTimeouts",
            "args": {}
          },
          "expect": true
        },
        {
          "op": "db.pool",
          "args": {
            "method": "timeout"
          },
          "expect": 300000
        },
        {
          "op": "db.pool",
          "args": {
            "method": "clear"
          },
          "expect": null
        },
        {
          "op": "db.pool",
          "args": {
            "method": "timeout"
          },
          "expect": 0
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "getSupportForTimeouts",
            "args": {}
          },
          "expect": true
        },
        {
          "op": "db.pool",
          "args": {
            "method": "timeout"
          },
          "expect": 300000
        }
      ]
    },
