    {
      "name": "ChainTest::testJoinsAreKeyedTheWayTheBuilderHandsThemToJoinFilters",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "equal",
            "args": {
              "attribute": "name",
              "values": [
                "a"
              ]
            },
            "as": "o1209"
          },
          "bind": "s2462",
          "expect": {
            "$query": {
              "method": "equal",
              "attribute": "name",
              "values": [
                "a"
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "on",
            "args": {
              "left": "$id",
              "right": "authorId"
            },
            "as": "o1210"
          },
          "bind": "s2463",
          "expect": {
            "$query": {
              "method": "on",
              "attribute": "",
              "values": [
                "$id",
                "=",
                "authorId"
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "join",
            "args": {
              "collection": "books",
              "alias": "book",
              "on": [
                {
                  "$obj": "o1210"
                }
              ]
            },
            "as": "o1211"
          },
          "bind": "s2464",
          "expect": {
            "$query": {
              "method": "join",
              "attribute": "books",
              "values": [
                {
                  "$query": {
                    "method": "on",
                    "attribute": "",
                    "values": [
                      "$id",
                      "=",
                      "authorId"
                    ]
                  }
                }
              ],
              "alias": "book"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "crossJoin",
            "args": {
              "collection": "extras",
              "alias": "extra"
