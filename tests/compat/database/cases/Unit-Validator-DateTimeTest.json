  ],
  "cases": [
    {
      "name": "DateTimeTest::test_create_datetime",
      "state": [],
      "steps": [
        {
          "op": "db.add_format",
          "args": {
            "name": "testformat"
          },
          "expect": true
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Datetime",
            "args": {
              "min": {
                "$datetime": "0000-01-01T00:00:00.000000+00:00"
              },
              "max": {
                "$datetime": "9999-12-31T23:59:59.000000+00:00"
              }
            },
            "as": "o456"
          },
          "bind": "s787",
          "expect": {
            "$value": "Validator\\Datetime",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "addSeconds",
            "args": {
              "date": {
                "$datetime": "now"
              },
              "seconds": -3
            }
          },
          "expect": "<now>"
        },
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "now",
            "args": {}
          },
          "expect": "<now>"
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "2022-12-04"
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "2022-1-4 11:31"
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "2022-12-04 11:31:52"
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "2022-1-4 11:31:52.123456789"
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "now",
            "args": {}
          },
          "expect": "<now>"
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "getDescription",
            "args": {}
          },
          "expect": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
        },
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "format",
            "args": {
              "date": {
                "$datetime": "2022-07-02T18:31:52.680000+00:00"
              }
            }
          },
          "expect": "2022-07-02 18:31:52.680"
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "2022-12-04 11:31:52.680+02:00"
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "setTimezone",
            "args": {
              "datetime": "2022-12-04 11:31:52.680+02:00"
            }
          },
          "expect": "2022-12-04 09:31:52.680"
        },
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "formatTz",
            "args": {
              "dbFormat": "2022-12-04 09:31:52.681"
            }
          },
          "expect": "2022-12-04T09:31:52.681+00:00"
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "2022-13-04 11:31:52.680"
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "-0001-13-04 00:00:00"
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "0000-00-00 00:00:00"
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o456"
            },
            "method": "isValid",
            "args": {
              "value": "10000-01-01 00:00:00"
            }
          },
          "expect": false
        }
      ]
    },
