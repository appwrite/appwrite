        {
          "op": "object.call",
          "args": {
            "class": "Validator\\BigInt",
            "method": "add",
            "args": {
              "a": "18446744073709551614",
              "b": 1
            }
          },
          "expect": "18446744073709551615"
        },
        {
          "op": "object.call",
          "args": {
            "class": "Validator\\BigInt",
            "method": "add",
            "args": {
              "a": "18446744073709551615",
              "b": 1
            }
          },
          "expect": "18446744073709551616"
        },
        {
          "op": "object.call",
          "args": {
            "class": "Validator\\BigInt",
            "method": "subtract",
            "args": {
              "a": "18446744073709551615",
              "b": 1
            }
          },
          "expect": "18446744073709551614"
        },
        {
          "op": "object.call",
          "args": {
            "class": "Validator\\BigInt",
            "method": "multiply",
