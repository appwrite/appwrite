{
  "source": "vendor/utopia-php/database/tests/unit/SpatialFilterTest.php",
  "cases": [
    {
      "name": "testSpatialDecodeUsesTheCallingDatabaseAdapter",
      "steps": [
        {
          "op": "db.open",
          "args": {
            "create": false
          },
          "bind": "first",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.open",
          "args": {
            "create": false
          },
          "bind": "second",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "database.decode",
          "args": {
            "db": {
              "$ref": "first"
            },
            "collection": {
              "$document": {
                "$id": "places",
                "attributes": [
                  {
                    "$document": {
                      "$id": "location",
                      "type": "point",
                      "array": false,
                      "filters": [
                        "point"
                      ]
                    }
                  }
                ]
              }
            },
            "document": {
              "$document": {
                "$id": "a",
                "location": "POINT(1 2)"
              }
            }
          },
          "expect": {
            "$document": {
              "$id": "a",
              "location": [
                1.0,
                2.0
              ],
              "$sequence": null,
              "$collection": null,
              "$createdAt": null,
              "$updatedAt": null
            }
          }
        },
        {
          "op": "database.decode",
          "args": {
            "db": {
              "$ref": "second"
            },
            "collection": {
              "$document": {
                "$id": "places",
                "attributes": [
                  {
                    "$document": {
                      "$id": "location",
                      "type": "point",
                      "array": false,
                      "filters": [
                        "point"
                      ]
                    }
                  }
                ]
              }
            },
            "document": {
              "$document": {
                "$id": "b",
                "location": "POINT(9 9)"
              }
            }
          },
          "expect": {
            "$document": {
              "$id": "b",
              "location": [
                9.0,
                9.0
              ],
              "$sequence": null,
              "$collection": null,
              "$createdAt": null,
              "$updatedAt": null
            }
          }
        },
        {
          "op": "database.decode",
          "args": {
            "db": {
              "$ref": "first"
            },
            "collection": {
              "$document": {
                "$id": "places",
                "attributes": [
                  {
                    "$document": {
                      "$id": "location",
                      "type": "point",
                      "array": false,
                      "filters": [
                        "point"
                      ]
                    }
                  }
                ]
              }
            },
            "document": {
              "$document": {
                "$id": "c",
                "location": "POINT(1 2)"
              }
            }
          },
          "expect": {
            "$document": {
              "$id": "c",
              "location": [
                1.0,
                2.0
              ],
              "$sequence": null,
              "$collection": null,
              "$createdAt": null,
              "$updatedAt": null
            }
          }
        }
      ]
    }
  ]
}
