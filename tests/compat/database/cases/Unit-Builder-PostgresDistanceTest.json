            "args": {},
            "as": "o1868"
          },
          "bind": "s5003",
          "expect": {
            "$builder": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "distanceLessThan",
            "args": {
              "attribute": "location",
              "values": [
                10,
                20
              ],
              "distance": 1000,
              "meters": true
            },
            "as": "o1869"
          },
          "bind": "s5004",
          "expect": {
            "$query": {
              "method": "distanceLessThan",
              "attribute": "location",
              "values": [
                [
                  [
                    10,
                    20
                  ],
                  1000,
                  true
                ]
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1869"
            },
            "method": "setAttributeType",
            "args": {
              "type": "point"
            }
          },
          "expect": null
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1868"
            },
            "method": "compileFilters",
            "args": {
              "filters": [
                {
                  "$obj": "o1869"
                }
              ]
            },
            "as": "o1870"
          },
          "expect": {
            "$value": "Query\\Builder\\Condition",
            "fields": {
              "expression": "(\"location\" && ST_Expand(ST_GeomFromText(?, 4326), ?, ?) AND ST_Distance((\"location\"::geography), ST_SetSRID(ST_GeomFromText(?), 4326)::geography) < ?)",
              "bindings": [
                "POINT(10 20)",
                0.009560263084334466,
                0.009043717329571146,
                "POINT(10 20)",
                1000.0
              ]
            }
          }
        }
      ]
