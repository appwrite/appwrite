{
  "source": [
    "vendor/utopia-php/database/tests/unit/Builder/PostgresDistanceTest.php"
  ],
  "cases": [
    {
      "name": "PostgresDistanceTest::testDistanceLessThanInDegreesLeadsWithDWithin",
      "state": [],
      "steps": [
        {
          "op": "db.add_format",
          "args": {
            "name": "updateAttributeIntegerOnly"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "updateAttributeIntegerOnly"
          },
          "expect": true
        },
        {
          "op": "object.new",
          "args": {
            "class": "Builder\\Postgres",
            "args": {},
            "as": "o1865"
          },
          "bind": "s4999",
          "expect": {
            "$builder": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "distanceLessThan",
            "args": {
              "attribute": "location",
              "values": [
                10,
                20
              ],
              "distance": 5
            },
            "as": "o1866"
          },
          "bind": "s5000",
          "expect": {
            "$query": {
              "method": "distanceLessThan",
              "attribute": "location",
              "values": [
                [
                  [
                    10,
                    20
                  ],
                  5,
                  false
                ]
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1866"
            },
            "method": "setAttributeType",
            "args": {
              "type": "point"
            }
          },
          "expect": null
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1865"
            },
            "method": "compileFilters",
            "args": {
              "filters": [
                {
                  "$obj": "o1866"
                }
              ]
            },
            "as": "o1867"
          },
          "expect": {
            "$value": "Query\\Builder\\Condition",
            "fields": {
              "expression": "(ST_DWithin(\"location\", ST_GeomFromText(?, 4326), ?) AND ST_Distance(\"location\", ST_GeomFromText(?, 4326)) < ?)",
              "bindings": [
                "POINT(10 20)",
                5.0,
                "POINT(10 20)",
                5.0
              ]
            }
          }
        }
      ]
    },
    {
      "name": "PostgresDistanceTest::testDistanceLessThanInMetersFromAPointLeadsWithADegreeBox",
      "state": [],
      "steps": [
        {
