{
  "source": [
    "vendor/utopia-php/database/tests/unit/MongoPermissionStringsTest.php"
  ],
  "cases": [
    {
      "name": "MongoPermissionStringsTest::testPeriodInRoleIsLiteralNotRegexWildcard",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Authorization",
            "args": {},
            "as": "o280"
          },
          "bind": "s673",
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o280"
            },
            "method": "enable",
            "args": {}
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o280"
            },
            "method": "cleanRoles",
            "args": {}
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o280"
            },
            "method": "addRole",
            "args": {
              "role": "user:alice."
            }
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Hook\\Mongo\\Permission",
            "args": {
              "authorization": {
                "$obj": "o280"
              }
            },
            "as": "o281"
          },
          "bind": "s677",
          "expect": {
            "$hook": "Permission"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o281"
            },
            "method": "applyFilters",
            "args": {
              "filters": [],
              "collection": "documents",
              "forPermission": {
                "$enum": "PermissionType::Read"
              }
            }
          },
          "expect": {
            "_permissions": {
              "$in": [
                "read(\"user:alice.\")"
              ]
            }
          }
        }
      ]
    },
