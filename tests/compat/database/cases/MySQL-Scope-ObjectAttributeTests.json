  ],
  "cases": [
    {
      "name": "ObjectAttributeTests::testObjectAttribute",
      "state": [
        "mysql@database-mysql"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "driver": "mysql"
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.authorization.clean_roles",
          "args": {},
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "any"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "users"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "user:x"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRangeNew"
          },
          "expect": true
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "subQueryProbe"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "joinedSeal"
          },
          "expect": null
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "supports",
            "args": {
              "capability": {
                "$enum": "Capability::Objects"
              }
            }
          },
          "expect": false
        }
      ]
    },
