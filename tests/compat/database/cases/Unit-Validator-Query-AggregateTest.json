{
  "source": [
    "vendor/utopia-php/database/tests/unit/Validator/Query/AggregateTest.php"
  ],
  "cases": [
    {
      "name": "AggregateTest::testValueSuccess",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "price",
                "key": "price",
                "type": "double",
                "array": false
              }
            },
            "as": "o1127"
          },
          "bind": "s1861",
          "expect": {
            "$document": {
              "$id": "price",
              "key": "price",
              "type": "double",
              "array": false
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Query\\Aggregate",
            "args": {
              "attributes": [
                {
                  "$obj": "o1127"
                }
              ]
            },
            "as": "o1128"
          },
          "bind": "s1862",
          "expect": {
            "$value": "Validator\\Query\\Aggregate",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "sum",
            "args": {
              "attribute": "price"
            },
            "as": "o1129"
          },
          "bind": "s1863",
          "expect": {
            "$query": {
              "method": "sum",
              "attribute": "price",
              "values": []
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1128"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1129"
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "avg",
            "args": {
              "attribute": "price",
              "alias": "avg_price"
            },
            "as": "o1130"
          },
          "bind": "s1865",
          "expect": {
            "$query": {
              "method": "avg",
              "attribute": "price",
              "values": [],
              "alias": "avg_price"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1128"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1130"
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "count",
            "args": {
              "attribute": "*",
              "alias": "cnt"
            },
            "as": "o1131"
          },
          "bind": "s1867",
          "expect": {
            "$query": {
              "method": "count",
              "attribute": "*",
              "values": [],
              "alias": "cnt"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1128"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1131"
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "count",
            "args": {},
            "as": "o1132"
          },
          "bind": "s1869",
          "expect": {
            "$query": {
              "method": "count",
              "attribute": "*",
              "values": []
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1128"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1132"
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "countDistinct",
            "args": {
              "attribute": "$id"
            },
            "as": "o1133"
          },
          "bind": "s1871",
          "expect": {
            "$query": {
              "method": "countDistinct",
              "attribute": "$id",
              "values": []
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1128"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1133"
              }
            }
          },
          "expect": true
        }
      ]
    },
    {
