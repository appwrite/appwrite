    "cases": [
        {
            "name": "JoinRelationshipTests::testJoinRelationshipOnTheParentSideOfAOneToManyMatchesTheTwoWayKey",
            "state": [
                "redis-json@database-redis-adapter"
            ],
            "steps": [
                {
                    "op": "db.open",
                    "args": {
                        "redis": true,
                        "cache": "none",
                        "namespace": "",
                        "shared_tables": true,
                        "tenant": 999
                    },
                    "bind": "db"
                },
                {
                    "op": "db.authorization.clean_roles",
                    "args": {}
                },
                {
                    "op": "db.authorization.add_role",
                    "args": {
                        "role": "any"
                    }
                },
                {
                    "op": "db.authorization.add_role",
                    "args": {
                        "role": "users"
                    }
                },
                {
                    "op": "db.authorization.add_role",
                    "args": {
                        "role": "user:x"
                    }
                },
                {
                    "op": "db.add_format",
                    "args": {
                        "name": "priceRange"
                    }
                },
                {
                    "op": "database.add_filter",
                    "args": {
                        "name": "encrypt"
                    }
                },
                {
                    "op": "database.add_filter",
                    "args": {
                        "name": "subQueryProbe"
                    }
                },
                {
                    "op": "db.adapter",
                    "args": {
                        "method": "supports",
                        "args": {
                            "capability": {
                                "$enum": "Capability::Joins"
                            }
                        }
                    }
                }
            ]
        },
