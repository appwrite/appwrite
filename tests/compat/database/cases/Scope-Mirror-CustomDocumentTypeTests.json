  "cases": [
    {
      "name": "CustomDocumentTypeTests::testSetDocumentType",
      "state": [
        "postgres@database-postgres",
        "postgres@database-postgres-mirror"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "mirror": {
              "destination": true
            },
            "cache": "redis"
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.mirror",
          "args": {
            "part": "source"
          },
          "bind": "src",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.mirror",
          "args": {
            "part": "destination"
          },
          "bind": "dst",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRangeNew"
          },
          "expect": true
        },
        {
          "op": "database.get_source",
          "args": {},
          "expect": {
            "$database": true
          }
        },
        {
          "op": "database.get_destination",
          "args": {},
          "expect": {
            "$database": true
          }
        },
        {
          "op": "database.set_document_type",
          "args": {
            "collection": "users",
            "className": "Tests\\E2E\\Adapter\\Support\\User"
          },
          "expect": {
            "$database": true
          }
        },
        {
          "op": "database.get_document_type",
          "args": {
            "collection": "users"
          },
          "expect": "Tests\\E2E\\Adapter\\Support\\User"
        },
        {
          "op": "database.clear_document_type",
          "args": {
            "collection": "users"
          },
          "expect": null
        },
        {
          "op": "database.set_document_type",
          "args": {
            "collection": "users",
            "className": "Tests\\E2E\\Adapter\\Support\\User"
          },
          "expect": {
            "$database": true
          }
        },
        {
          "op": "database.set_document_type",
          "args": {
            "collection": "posts",
            "className": "Tests\\E2E\\Adapter\\Support\\Post"
          },
          "expect": {
            "$database": true
          }
        },
        {
          "op": "database.get_document_type",
          "args": {
            "collection": "users"
          },
          "expect": "Tests\\E2E\\Adapter\\Support\\User"
        },
        {
          "op": "database.get_document_type",
          "args": {
            "collection": "posts"
          },
          "expect": "Tests\\E2E\\Adapter\\Support\\Post"
        },
        {
          "op": "database.clear_document_types",
          "args": {},
          "expect": null
        },
        {
          "op": "database.get_document_type",
          "args": {
            "collection": "users"
          },
          "expect": null
        },
        {
          "op": "database.get_document_type",
          "args": {
            "collection": "posts"
          },
          "expect": null
