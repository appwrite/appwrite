{
  "source": [
    "vendor/utopia-php/database/tests/e2e/Adapter/Scopes/DatabaseTests.php",
    "vendor/utopia-php/database/tests/e2e/Adapter/Schemaless/MongoDBTest.php"
  ],
  "cases": [
    {
      "name": "DatabaseTests::testUpdateMovesEveryCollectionUnderTheNewName",
      "state": [
        "mongo@database-mongo"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "engine": "mongo",
            "schemaless": true
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRangeNew"
          },
          "expect": true
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "subQueryProbe"
          },
          "expect": null
        },
        {
          "op": "database.has_shared_tables",
          "args": {},
          "expect": false
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "supports",
            "args": {
              "capability": {
                "$enum": "Capability::Schemas"
              }
            }
          },
          "expect": false
        }
      ]
    },
