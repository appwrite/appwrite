    {
      "name": "SQLRawStatementTest::testRawStatementsReadAndWriteAnExistingTable",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Adapter\\SQLite",
            "args": {
              "pdo": {
                "$pdo": {
                  "dsn": "sqlite::memory:"
                }
              }
            },
            "as": "o5"
          },
          "bind": "s8",
          "expect": {
            "$adapter": "SQLite"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o5"
            },
            "method": "rawMutation",
            "args": {
              "query": "INSERT INTO present (value) VALUES (?), (?)",
              "bindings": [
                1,
                2
              ]
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\NotFound",
              "message": "Collection not found"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o5"
            },
            "method": "rawQuery",
            "args": {
              "query": "SELECT value FROM present WHERE value > ? ORDER BY value",
              "bindings": [
                1
              ]
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\NotFound",
              "message": "Collection not found"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$document": {
                "value": 2
              }
            },
            "method": "getAttribute",
            "args": {
              "name": "value"
            }
          },
          "expect": 2
        }
      ]
    },
