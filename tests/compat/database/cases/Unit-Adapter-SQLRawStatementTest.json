    {
      "name": "SQLRawStatementTest::testTheHostnameIsEmptyWhenTheConnectionNamesNoHost",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Adapter\\SQLite",
            "args": {
              "pdo": {
                "$pdo": {
                  "dsn": "sqlite::memory:",
                  "wrapper": true
                }
              }
            },
            "as": "o1"
          },
          "bind": "s0",
          "expect": {
            "$adapter": "SQLite"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1"
            },
            "method": "hostname",
            "args": {}
          },
          "expect": ""
        }
      ]
    },
    {
      "name": "SQLRawStatementTest::testARawReadOnAMissingTableIsNotFound",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Adapter\\SQLite",
            "args": {
              "pdo": {
                "$pdo": {
                  "dsn": "sqlite::memory:"
                }
              }
            },
            "as": "o3"
          },
          "bind": "s4",
          "expect": {
            "$adapter": "SQLite"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o3"
            },
            "method": "rawQuery",
            "args": {
              "query": "SELECT * FROM missing_table"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\NotFound",
              "message": "Collection not found"
            }
          }
        }
      ]
    },
    {
      "name": "SQLRawStatementTest::testARawWriteOnAMissingTableIsNotFound",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
