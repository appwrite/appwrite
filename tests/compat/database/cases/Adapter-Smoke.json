{
  "source": "vendor/utopia-php/database/src/Database/Adapter/Postgres.php",
  "cases": [
    {
      "name": "create a schema, a collection, documents, and find them",
      "steps": [
        {
          "op": "adapter.open",
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.before",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "event": "*",
            "name": "capture"
          },
          "expect": null
        },
        {
          "op": "adapter.create",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.exists",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.create_collection",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "name": "movies",
            "attributes": [
              {
                "$document": {
                  "$id": "title",
                  "type": "string",
                  "size": 128,
                  "required": true,
                  "signed": true,
                  "array": false
                }
              },
              {
                "$document": {
                  "$id": "year",
                  "type": "integer",
                  "size": 0,
                  "signed": true,
                  "array": false
                }
              },
              {
                "$document": {
                  "$id": "tags",
                  "type": "string",
                  "size": 32,
                  "array": true
                }
              }
            ],
            "indexes": [
              {
                "$document": {
                  "$id": "byTitle",
                  "type": "key",
                  "attributes": [
                    "title"
                  ],
                  "orders": [
                    "ASC"
                  ]
                }
              }
            ]
          },
          "expect": true
        },
        {
          "op": "adapter.exists",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "movies"
          },
          "expect": true
        },
        {
          "op": "adapter.create_document",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "movies",
            "document": {
              "$document": {
                "$id": "alien",
                "title": "Alien's \\ \"x\"",
                "year": 1979,
                "tags": [
                  "scifi",
                  "horror"
                ],
                "$permissions": [
                  "read(\"any\")",
                  "update(\"user:1\")"
                ],
                "$createdAt": "2020-01-01 00:00:00.000",
                "$updatedAt": "2020-01-01 00:00:00.000"
              }
            }
          },
          "expect": {
            "$document": {
              "$id": "alien",
              "title": "Alien's \\ \"x\"",
              "year": 1979,
              "tags": [
                "scifi",
                "horror"
              ],
              "$permissions": [
                "read(\"any\")",
                "update(\"user:1\")"
              ],
              "$createdAt": "2020-01-01 00:00:00.000",
              "$updatedAt": "2020-01-01 00:00:00.000",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "adapter.get_document",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "movies",
            "id": "alien"
          },
          "expect": {
            "$document": {
              "title": "Alien's \\ \"x\"",
              "year": "1979",
              "tags": "[\"scifi\", \"horror\"]",
              "$sequence": "1",
              "$id": "alien",
              "$createdAt": "2020-01-01 00:00:00",
              "$updatedAt": "2020-01-01 00:00:00",
              "$permissions": [
                "read(\"any\")",
                "update(\"user:1\")"
              ]
            }
          }
        },
        {
          "op": "adapter.find",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "movies",
            "queries": [
              {
                "$query": {
                  "method": "equal",
                  "attribute": "year",
                  "values": [
                    1979
                  ]
                }
              }
            ]
          },
          "expect": [
            {
              "$document": {
                "title": "Alien's \\ \"x\"",
                "year": "1979",
                "tags": "[\"scifi\", \"horror\"]",
                "$id": "alien",
                "$sequence": "1",
                "$createdAt": "2020-01-01 00:00:00",
                "$updatedAt": "2020-01-01 00:00:00",
                "$permissions": [
                  "read(\"any\")",
                  "update(\"user:1\")"
                ]
              }
            }
          ]
        },
        {
          "op": "adapter.set_authorization",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "status": false
          },
          "expect": null
        },
        {
          "op": "adapter.find",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "movies",
            "queries": [
              {
                "$query": {
                  "method": "equal",
                  "attribute": "year",
                  "values": [
                    1979
                  ]
                }
              }
            ]
          },
          "expect": [
            {
              "$document": {
                "title": "Alien's \\ \"x\"",
                "year": "1979",
                "tags": "[\"scifi\", \"horror\"]",
                "$id": "alien",
                "$sequence": "1",
                "$createdAt": "2020-01-01 00:00:00",
                "$updatedAt": "2020-01-01 00:00:00",
                "$permissions": [
                  "read(\"any\")",
                  "update(\"user:1\")"
                ]
              }
            }
          ]
        },
        {
          "op": "adapter.count",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "movies"
          },
          "expect": 1
        },
        {
          "op": "adapter.sum",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "movies",
            "attribute": "year"
          },
          "expect": 1979
        },
        {
          "op": "adapter.create_document",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "movies",
            "document": {
              "$document": {
                "$id": "alien",
                "title": "dup"
              }
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\Duplicate",
              "message": "Document already exists"
            }
          }
        },
        {
          "op": "adapter.captured",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            [
              "*",
              "CREATE SCHEMA \"${ns}\""
            ],
            [
              "*",
              "\n            CREATE TABLE \"${ns}\".\"ns_movies\" (\n                _id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n                _uid VARCHAR(255) NOT NULL,\n                \n                \"_createdAt\" TIMESTAMP(3) DEFAULT NULL,\n                \"_updatedAt\" TIMESTAMP(3) DEFAULT NULL,\n                \"title\" VARCHAR(128),  \"year\" INTEGER,  \"tags\" JSONB, \n                _permissions JSONB DEFAULT NULL\n            );\n        \n\t\t\t\tCREATE UNIQUE INDEX \"ns_movies_uid\" ON \"${ns}\".\"ns_movies\" (\"_uid\" COLLATE utf8_ci_ai);\n            \tCREATE INDEX \"ns_movies_created\" ON \"${ns}\".\"ns_movies\" (\"_createdAt\");\n            \tCREATE INDEX \"ns_movies_updated\" ON \"${ns}\".\"ns_movies\" (\"_updatedAt\");\n            \tCREATE INDEX \"ns_movies_permissions\" ON \"${ns}\".\"ns_movies\" USING gin (_permissions);\n\t\t\t"
            ],
            [
              "*",
              "\n            CREATE TABLE \"${ns}\".\"ns_movies_perms\" (\n                _id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n                _tenant INTEGER DEFAULT NULL,\n                _type VARCHAR(12) NOT NULL,\n                _permission VARCHAR(255) NOT NULL,\n                _document VARCHAR(255) NOT NULL\n            );\n        \n                CREATE UNIQUE INDEX \"ns_movies_ukey\" \n                    ON \"${ns}\".\"ns_movies_perms\" USING btree (_document COLLATE utf8_ci_ai,_type,_permission);\n                CREATE INDEX \"ns_movies_permission\" \n                    ON \"${ns}\".\"ns_movies_perms\" USING btree (_permission,_type); \n            "
            ],
            [
              "*",
              "CREATE INDEX \"ns__movies_byTitle\" ON \"${ns}\".\"ns_movies\" (\"title\" ASC)"
            ],
            [
              "*",
              "\n\t\t\tINSERT INTO \"${ns}\".\"ns_movies\" (\"title\", \"year\", \"tags\", \"_createdAt\", \"_updatedAt\", \"_permissions\",  \"_uid\")\n\t\t\tVALUES (:key_0, :key_1, :key_2, :key_3, :key_4, :key_5,  :_uid)\n\t\t"
            ],
            [
              "*",
              "\n\t\t\t\tINSERT INTO \"${ns}\".\"ns_movies_perms\" (_type, _permission, _document )\n\t\t\t\tVALUES ('read', 'any', :_uid ), ('update', 'user:1', :_uid )\n\t\t\t"
            ],
            [
              "*",
              "\n\t\t    SELECT \"main\".*\n            FROM \"${ns}\".\"ns_movies\" AS \"main\"\n            WHERE \"main\".\"_uid\" = :_uid \n            \n\t\t "
            ],
            [
              "*",
              "\n            SELECT \"main\".*\n            FROM \"${ns}\".\"ns_movies\" AS \"main\"\n            WHERE ((\"main\".\"year\" = :<id>_0)) AND (\"main\".\"_permissions\" @> '[\"read(\\\"any\\\")\"]'::jsonb)\n            \n            LIMIT :limit;\n        "
            ],
            [
              "*",
              "\n            SELECT \"main\".*\n            FROM \"${ns}\".\"ns_movies\" AS \"main\"\n            WHERE ((\"main\".\"year\" = :<id>_0))\n            \n            LIMIT :limit;\n        "
            ],
            [
              "*",
              "\n            SELECT COUNT(1) as sum\n\t\t\tFROM \"${ns}\".\"ns_movies\" AS \"main\"\n\t\t\t\n        "
            ],
            [
              "*",
              "\n\t\t\tSELECT SUM(\"year\") as sum\n\t\t\tFROM \"${ns}\".\"ns_movies\" AS \"main\"\n\t\t\t\n        "
            ],
            [
              "*",
              "\n\t\t\tINSERT INTO \"${ns}\".\"ns_movies\" (\"title\", \"_createdAt\", \"_updatedAt\", \"_permissions\",  \"_uid\")\n\t\t\tVALUES (:key_0, :key_1, :key_2, :key_3,  :_uid)\n\t\t"
            ]
          ]
        },
        {
          "op": "adapter.delete",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        }
      ]
    }
  ]
}
