    {
      "name": "LegacyDroppedAttributeIndexTest::testAnIndexDefinedByACallerStillRefusesAnAttributeThatIsNotAString",
      "state": [],
      "steps": [
        {
          "op": "db.add_format",
          "args": {
            "name": "raceIntegerRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "raceDoubleRange"
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "Index",
            "method": "fromArray",
            "args": {
              "data": {
                "$id": "bad",
                "type": "key",
                "attributes": [
