    {
      "name": "LegacyDroppedAttributeIndexTest::testAFulltextIndexWhoseOnlyAttributeWasDeletedIsReadWithNoAttributes",
      "state": [],
      "steps": [
        {
          "op": "db.add_format",
          "args": {
            "name": "raceIntegerRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "raceDoubleRange"
          },
          "expect": true
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "category",
                "key": "category",
                "type": "fulltext",
                "attributes": [
                  null
                ],
                "orders": [
                  "ASC"
                ],
                "lengths": [
                  200
                ]
              }
            },
            "as": "o3325"
          },
          "bind": "s6121",
          "expect": {
            "$document": {
              "$id": "category",
              "key": "category",
              "type": "fulltext",
              "attributes": [
                null
              ],
              "orders": [
                "ASC"
              ],
              "lengths": [
                200
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Index",
            "method": "fromDocument",
            "args": {
              "document": {
                "$obj": "o3325"
              }
            },
            "as": "o3326"
          },
          "expect": {
            "$value": "Index",
            "fields": {
              "key": "category",
              "type": {
                "$enum": "Query\\Schema\\IndexType::Fulltext"
              },
              "attributes": [],
              "lengths": [],
              "orders": [],
              "ttl": null
            }
          }
        }
      ]
    },
