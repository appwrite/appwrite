              "key": "value"
            },
            "as": "o876"
          },
          "bind": "s1755",
          "expect": {
            "$value": "Attribute",
            "fields": {
              "key": "value",
              "type": {
                "$enum": "Query\\Schema\\ColumnType::Double"
