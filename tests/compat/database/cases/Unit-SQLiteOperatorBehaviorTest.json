              "collection": "operators",
              "attributes": [
                {
                  "$obj": "o876"
                }
              ]
            }
          },
          "expect": true
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "increment",
                "$permissions": [],
                "value": 5.0
              }
            },
            "as": "o877"
          },
          "bind": "s1757",
          "expect": {
            "$document": {
              "$id": "increment",
              "$permissions": [],
              "value": 5.0
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o872"
            },
            "method": "createDocument",
            "args": {
              "collection": {
                "$obj": "o875"
              },
              "document": {
                "$obj": "o877"
              }
            }
          },
          "expect": {
            "$document": {
              "$id": "increment",
              "$permissions": [],
              "value": 5.0,
              "$sequence": "1"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Operator",
            "method": "increment",
            "args": {
              "value": 5,
              "max": 10
            },
            "as": "o878"
          },
          "bind": "s1759",
          "expect": {
            "$operator": {
              "method": "increment",
              "attribute": "",
              "values": [
                5,
                10
              ]
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "increment",
                "value": {
                  "$obj": "o878"
                }
              }
            },
            "as": "o879"
          },
          "bind": "s1760",
          "expect": {
            "$document": {
              "$id": "increment",
              "value": {
                "$operator": {
                  "method": "increment",
                  "attribute": "",
                  "values": [
                    5,
                    10
                  ]
                }
              }
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o872"
            },
            "method": "updateDocument",
            "args": {
              "collection": {
                "$obj": "o875"
              },
              "id": "increment",
              "document": {
                "$obj": "o879"
              },
              "skipPermissions": true
            }
          },
          "expect": {
            "$document": {
              "$id": "increment",
              "value": {
                "$operator": {
                  "method": "increment",
                  "attribute": "",
                  "values": [
                    5,
                    10
                  ]
                }
              }
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o872"
            },
            "method": "getDocument",
            "args": {
              "collection": {
                "$obj": "o875"
              },
              "id": "increment"
            },
            "as": "o880"
          },
          "bind": "s1762",
          "expect": {
            "$document": {
              "value": 10.0,
              "$id": "increment",
              "$sequence": 1,
              "$createdAt": null,
              "$updatedAt": null,
              "$permissions": []
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o880"
            },
            "method": "getAttribute",
            "args": {
              "name": "value"
            }
          },
          "expect": 10.0
        }
      ]
    },
