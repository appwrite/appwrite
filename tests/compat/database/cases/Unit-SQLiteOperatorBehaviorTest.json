    {
      "name": "SQLiteOperatorBehaviorTest::testInclusiveIncrementBoundAppliesExactMaximum",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Adapter\\SQLite",
            "args": {
              "pdo": {
                "$pdo": {
                  "dsn": "sqlite::memory:"
                }
              }
            },
            "as": "o872"
          },
          "bind": "s1748",
          "expect": {
            "$adapter": "SQLite"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o872"
            },
            "method": "setNamespace",
            "args": {
              "namespace": "namespace"
            }
          },
          "expect": {
            "$adapter": "SQLite"
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Authorization",
            "args": {},
            "as": "o873"
          },
          "bind": "s1750",
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o873"
            },
            "method": "disable",
            "args": {}
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o872"
            },
            "method": "setAuthorization",
            "args": {
              "authorization": {
                "$obj": "o873"
              }
            }
          },
          "expect": {
            "$adapter": "SQLite"
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "value",
                "type": "double"
              }
            },
            "as": "o874"
          },
          "bind": "s1753",
          "expect": {
            "$document": {
              "$id": "value",
              "type": "double"
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "operators",
