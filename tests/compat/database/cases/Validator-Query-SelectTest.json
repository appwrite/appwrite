{
  "source": "vendor/utopia-php/database/tests/unit/Validator/Query/SelectTest.php",
  "cases": [
    {
      "name": "testValueSuccess",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "query_select",
            "attributes": [
              {
                "$document": {
                  "$id": "attr",
                  "key": "attr",
                  "type": "string",
                  "array": false
                }
              },
              {
                "$document": {
                  "$id": "artist",
                  "key": "artist",
                  "type": "relationship",
                  "array": false
                }
              }
            ]
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "$query": {
                "method": "select",
                "attribute": "",
                "values": [
                  "*",
                  "attr"
                ]
              }
            }
          },
          "expect": {
            "valid": true,
            "description": "Invalid query"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "$query": {
                "method": "select",
                "attribute": "",
                "values": [
                  "artist.name"
                ]
              }
            }
          },
          "expect": {
            "valid": true,
            "description": "Invalid query"
          }
        }
      ]
    },
