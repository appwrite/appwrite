          "args": {
            "this": {
              "$obj": "o4351"
            },
            "method": "isValid",
            "args": {
              "value": [
                10,
                -100
              ]
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4351"
            },
            "method": "getDescription",
            "args": {}
          },
          "expect": "Value must be a valid point: Latitude (y) must be between -90 and 90, got -100"
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Spatial",
            "args": {
              "spatialType": "linestring"
            },
            "as": "o4352"
          },
          "bind": "s6868",
          "expect": {
            "$value": "Validator\\Spatial",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4352"
            },
            "method": "isValid",
            "args": {
              "value": [
                [
                  0,
                  0
                ],
                [
                  181,
                  45
                ]
              ]
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4352"
            },
            "method": "getDescription",
            "args": {}
          },
          "expect": "Value must be a valid linestring: Invalid coordinates at point #1: Longitude (x) must be between -180 and 180, got 181"
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Spatial",
            "args": {
              "spatialType": "polygon"
            },
            "as": "o4353"
          },
          "bind": "s6871",
          "expect": {
            "$value": "Validator\\Spatial",
            "fields": {}
          }
        },
