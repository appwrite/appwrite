        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4350"
            },
            "method": "isValid",
            "args": {
              "value": [
                200,
                10
              ]
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4350"
            },
            "method": "getDescription",
            "args": {}
          },
          "expect": "Value must be a valid point: Longitude (x) must be between -180 and 180, got 200"
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Spatial",
            "args": {
              "spatialType": "point"
            },
            "as": "o4351"
          },
          "bind": "s6865",
          "expect": {
            "$value": "Validator\\Spatial",
            "fields": {}
          }
