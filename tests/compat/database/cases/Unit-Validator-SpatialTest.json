  "cases": [
    {
      "name": "SpatialTest::test_valid_point",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Spatial",
            "args": {
              "spatialType": "point"
            },
            "as": "o4347"
          },
          "bind": "s6837",
          "expect": {
            "$value": "Validator\\Spatial",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4347"
            },
            "method": "isValid",
            "args": {
              "value": [
                10,
                20
              ]
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4347"
            },
            "method": "isValid",
            "args": {
              "value": [
                0,
                0
              ]
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4347"
            },
            "method": "isValid",
            "args": {
              "value": [
                -180.0,
                90.0
              ]
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4347"
            },
            "method": "isValid",
            "args": {
              "value": [
                10
              ]
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4347"
            },
            "method": "isValid",
            "args": {
              "value": [
                10,
                "a"
              ]
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o4347"
            },
            "method": "isValid",
            "args": {
              "value": [
                [
                  10,
                  20
                ]
              ]
            }
          },
          "expect": false
        }
      ]
    },
