    {
      "name": "SpatialTest::test_wkt_strings",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "Validator\\Spatial",
            "method": "isWktString",
            "args": {
              "value": "POINT(1 2)"
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "Validator\\Spatial",
            "method": "isWktString",
            "args": {
              "value": "LINESTRING(0 0,1 1)"
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "Validator\\Spatial",
            "method": "isWktString",
            "args": {
              "value": "POLYGON((0 0,1 0,1 1,0 1,0 0))"
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "class": "Validator\\Spatial",
            "method": "isWktString",
            "args": {
              "value": "CIRCLE(0 0,1)"
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "class": "Validator\\Spatial",
            "method": "isWktString",
            "args": {
              "value": "POINT1(1 2)"
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "SpatialTest::test_invalid_coordinate",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Spatial",
            "args": {
              "spatialType": "point"
            },
            "as": "o4350"
          },
          "bind": "s6862",
          "expect": {
            "$value": "Validator\\Spatial",
            "fields": {}
