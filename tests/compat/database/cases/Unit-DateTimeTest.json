{
  "source": [
    "vendor/utopia-php/database/tests/unit/DateTimeTest.php"
  ],
  "cases": [
    {
      "name": "DateTimeTest::testNowAfterAdvancesAtMillisecondPrecision",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "nowAfter",
            "args": {
              "previous": "2999-01-01 00:00:00.123"
            }
          },
          "expect": "2999-01-01 00:00:00.124"
        }
      ]
    },
    {
      "name": "DateTimeTest::testNowAfterUsesCurrentTimeForPriorTimestamp",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "nowAfter",
            "args": {
              "previous": "2000-01-01 00:00:00.000"
            }
          },
          "expect": "<now>"
        }
      ]
    },
    {
      "name": "DateTimeTest::testFormatTzReturnsUnparseableInputUnchanged",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "formatTz",
            "args": {
              "dbFormat": "not a date"
            }
          },
          "expect": "not a date"
        },
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "formatTz",
            "args": {
              "dbFormat": null
            }
          },
          "expect": null
        },
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "formatTz",
            "args": {
              "dbFormat": "2024-05-06 07:08:09.123+02:00"
            }
          },
          "expect": "2024-05-06T07:08:09.123+02:00"
        }
      ]
    },
    {
      "name": "DateTimeTest::testNowAfterRejectsAnUnparseablePreviousTimestamp",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "nowAfter",
            "args": {
              "previous": "not a date"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Failed to parse time string (not a date) at position 0 (n): The timezone could not be found in the database"
            }
          }
        }
      ]
    },
    {
      "name": "DateTimeTest::testSetTimezoneWrapsAnUnparseableValue",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "DateTime",
            "method": "setTimezone",
            "args": {
              "datetime": "not a date"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Failed to parse time string (not a date) at position 0 (n): The timezone could not be found in the database"
            }
          }
        }
      ]
    }
  ]
}
