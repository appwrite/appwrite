    {
      "name": "decoding geometries PostGIS returns",
      "steps": [
        {
          "op": "adapter.open",
          "bind": "a",
          "args": {
            "driver": "mysql"
          },
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.create",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.create_collection",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "name": "g",
            "attributes": [
              {
                "$document": {
                  "$id": "p",
                  "type": "point",
                  "size": 0,
                  "required": false,
                  "signed": true,
                  "array": false
                }
              },
              {
                "$document": {
                  "$id": "l",
                  "type": "linestring",
                  "size": 0,
                  "required": false,
                  "signed": true,
                  "array": false
                }
              },
              {
                "$document": {
                  "$id": "a",
                  "type": "polygon",
                  "size": 0,
                  "required": false,
                  "signed": true,
                  "array": false
                }
              }
            ]
          },
          "expect": true
        },
        {
          "op": "adapter.create_document",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": {
              "$document": {
                "$id": "g",
                "attributes": [
                  {
                    "$document": {
                      "$id": "p",
                      "type": "point",
                      "size": 0,
                      "required": false,
                      "signed": true,
                      "array": false
                    }
                  },
                  {
                    "$document": {
                      "$id": "l",
                      "type": "linestring",
                      "size": 0,
                      "required": false,
                      "signed": true,
                      "array": false
                    }
                  },
                  {
                    "$document": {
                      "$id": "a",
                      "type": "polygon",
                      "size": 0,
                      "required": false,
                      "signed": true,
                      "array": false
                    }
                  }
                ]
              }
            },
            "document": {
              "$document": {
                "$id": "g1",
                "$permissions": [],
                "p": "POINT(1.5 -2.25)",
                "l": "LINESTRING(0 0, 1 2, 3 4)",
                "a": "POLYGON((0 0, 4 0, 4 4, 0 4, 0 0), (1 1, 2 1, 2 2, 1 1))"
              }
            }
          },
          "expect": {
            "$document": {
              "$id": "g1",
              "$permissions": [],
              "p": "POINT(1.5 -2.25)",
              "l": "LINESTRING(0 0, 1 2, 3 4)",
              "a": "POLYGON((0 0, 4 0, 4 4, 0 4, 0 0), (1 1, 2 1, 2 2, 1 1))",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "adapter.set_authorization",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "status": false
          },
          "expect": null
        },
        {
          "op": "adapter.find",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "g"
          },
          "bind": "rows",
          "expect": [
            {
              "$document": {
                "p": {
                  "$bytes": "5hAAAAEBAAAAAAAAAAAA+D8AAAAAAAACwA=="
                },
                "l": {
                  "$bytes": "5hAAAAECAAAAAwAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADwPwAAAAAAAABAAAAAAAAACEAAAAAAAAAQQA=="
                },
                "a": {
                  "$bytes": "5hAAAAEDAAAAAgAAAAUAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEEAAAAAAAAAAAAAAAAAAABBAAAAAAAAAEEAAAAAAAAAAAAAAAAAAABBAAAAAAAAAAAAAAAAAAAAAAAQAAAAAAAAAAADwPwAAAAAAAPA/AAAAAAAAAEAAAAAAAADwPwAAAAAAAABAAAAAAAAAAEAAAAAAAADwPwAAAAAAAPA/"
                },
                "$id": "g1",
                "$sequence": "1",
                "$createdAt": null,
                "$updatedAt": null,
                "$permissions": []
              }
            }
          ]
        },
        {
          "op": "adapter.decode_point",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "wkb": {
              "$ref": "rows",
              "path": "/0/$document/p"
            }
          },
          "expect": [
            1.5,
            -2.25
          ]
        },
        {
          "op": "adapter.decode_linestring",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "wkb": {
              "$ref": "rows",
              "path": "/0/$document/l"
            }
          },
          "expect": [
            [
              0.0,
              0.0
            ],
            [
              1.0,
              2.0
            ],
            [
              3.0,
              4.0
            ]
          ]
        },
        {
          "op": "adapter.decode_polygon",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "wkb": {
              "$ref": "rows",
              "path": "/0/$document/a"
            }
          },
          "expect": [
            [
              [
                0.0,
                0.0
              ],
              [
                4.0,
                0.0
              ],
              [
                4.0,
                4.0
              ],
              [
                0.0,
                4.0
              ],
              [
                0.0,
                0.0
              ]
            ],
            [
              [
                1.0,
                1.0
              ],
              [
                2.0,
                1.0
              ],
              [
                2.0,
                2.0
              ],
              [
                1.0,
                1.0
              ]
            ]
          ]
        },
        {
          "op": "adapter.delete",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        }
      ],
      "state": [
        "mysql@database-mysql"
      ]
    }
  ]
