  "cases": [
    {
      "name": "testPostgresDocumentIdConflictIsDuplicate",
      "steps": [
        {
          "op": "adapter.process_exception",
          "args": {
            "sqlstate": "23505",
            "native": 7,
            "message": "SQLSTATE[23505]: Unique violation: 7 ERROR:  duplicate key value violates unique constraint \"ns_1_movies_uid\"\nDETAIL:  Key (_uid, _tenant)=(movie-1, 1) already exists."
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\Duplicate",
              "message": "Document already exists"
            }
          }
        }
      ]
    },
