                "read(\"any\")"
              ],
              "$collection": "projects"
            }
          }
        },
        {
          "op": "database.with_cache",
          "args": {
            "key": {
              "$ref": "key"
            },
            "hash": "list-hash",
            "callback": {
              "steps": [
                {
                  "op": "db.cache",
                  "args": {
                    "method": "purge",
                    "args": {
                      "key": {
                        "$ref": "key"
                      },
                      "hash": "list-hash"
                    }
                  }
                },
                {
                  "op": "$return",
                  "args": {
                    "value": [
                      {
                        "$ref": "document"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "expect": {
            "result": [
              {
                "$document": {
                  "name": "fresh",
                  "$sequence": "1",
                  "$id": "project",
                  "$createdAt": "<now>",
                  "$updatedAt": "<now>",
                  "$permissions": [
                    "read(\"any\")"
                  ],
                  "$collection": "projects"
                }
              }
            ],
            "calls": {
              "callback": [
                {
                  "args": [],
                  "steps": [
                    false,
                    null
                  ]
                }
              ]
            }
          }
        },
        {
          "op": "db.cache",
          "args": {
            "method": "load",
            "args": {
              "key": {
                "$ref": "key"
              },
              "hash": "list-hash"
            }
          },
          "expect": false
        }
      ]
    },
