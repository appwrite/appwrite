{
  "source": "vendor/utopia-php/database/tests/unit/WithCacheLeaseTest.php",
  "cases": [
    {
      "name": "testDocumentPurgeRemovesAllVariantsAndRejectsStaleWrites",
      "steps": [
        {
          "op": "db.open",
          "args": {
            "cache": "redis-igbinary"
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "database.create_collection",
          "args": {
            "id": "projects"
          },
          "expect": {
            "$document": {
              "$id": "projects",
              "$permissions": [
                "create(\"any\")"
              ],
              "name": "projects",
              "attributes": [],
              "indexes": [],
              "documentSecurity": true,
              "$collection": "_metadata",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "database.create_attribute",
          "args": {
            "collection": "projects",
            "id": "name",
            "type": "string",
            "size": 255,
            "required": false
          },
          "expect": true
        },
        {
          "op": "database.create_document",
          "args": {
            "collection": "projects",
            "document": {
              "$id": "project",
              "$permissions": [
                "read(\"any\")"
              ],
              "name": "fresh"
            }
          },
          "expect": {
            "$document": {
              "$id": "project",
              "$permissions": [
                "read(\"any\")"
              ],
              "name": "fresh",
              "$collection": "projects",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "database.get_query_cache_key",
          "args": {
            "collectionId": "projects"
          },
          "bind": "key",
          "expect": "default-cache-compat-database-postgres:compat::collection:projects:query"
        },
        {
          "op": "database.get_cache_keys",
          "args": {
            "collectionId": "projects",
            "documentId": "project"
          },
          "bind": "first",
          "expect": [
            "default-cache-compat-database-postgres:compat::collection:projects",
            "default-cache-compat-database-postgres:compat::collection:projects:project",
            "default-cache-compat-database-postgres:compat::collection:projects:project:902ba0becfb8b628a5c40d3185600afe"
          ]
        },
        {
          "op": "database.get_cache_keys",
          "args": {
            "collectionId": "projects",
            "documentId": "project",
            "selects": [
              "name"
            ]
          },
          "bind": "second",
          "expect": [
            "default-cache-compat-database-postgres:compat::collection:projects",
            "default-cache-compat-database-postgres:compat::collection:projects:project",
            "default-cache-compat-database-postgres:compat::collection:projects:project:d6cf83f99c53f41e0be272792ad58cc8"
          ]
        },
        {
          "op": "db.cache",
          "args": {
            "method": "save",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/0"
              },
              "data": "legacy",
              "hash": {
                "$ref": "first",
                "path": "/1"
              }
            }
          },
          "expect": true
        },
        {
          "op": "db.cache",
          "args": {
            "method": "save",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/1"
              },
              "data": "first",
              "hash": {
                "$ref": "first",
                "path": "/2"
              }
            }
          },
          "expect": true
        },
        {
          "op": "db.cache",
          "args": {
            "method": "save",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/1"
              },
              "data": "second",
              "hash": {
                "$ref": "second",
                "path": "/2"
              }
            }
          },
          "expect": true
        },
        {
          "op": "db.cache",
          "args": {
            "method": "get_generation",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/1"
              }
            }
          },
          "bind": "lease",
          "expect": "1"
        },
        {
          "op": "database.purge_cached_document",
          "args": {
            "collectionId": "projects",
            "id": "project"
          },
          "expect": true
        },
        {
          "op": "db.cache",
          "args": {
            "method": "load",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/0"
              },
              "hash": {
                "$ref": "first",
                "path": "/1"
              }
            }
          },
          "expect": false
        },
        {
          "op": "db.cache",
          "args": {
            "method": "load",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/1"
              },
              "hash": {
                "$ref": "first",
                "path": "/2"
              }
            }
          },
          "expect": false
        },
        {
          "op": "db.cache",
          "args": {
            "method": "load",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/1"
              },
              "hash": {
                "$ref": "second",
                "path": "/2"
              }
            }
          },
          "expect": false
        },
        {
          "op": "db.cache",
          "args": {
            "method": "save_with_lease",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/1"
              },
              "data": "stale",
              "hash": {
                "$ref": "first",
                "path": "/2"
              },
              "generation": {
                "$ref": "lease"
              }
            }
          },
          "expect": false
        },
        {
          "op": "db.cache",
          "args": {
            "method": "load",
            "args": {
              "key": {
                "$ref": "first",
                "path": "/1"
              },
              "hash": {
                "$ref": "first",
                "path": "/2"
              }
            }
          },
          "expect": false
        },
        {
          "op": "database.get_document",
          "args": {
            "collection": "projects",
            "id": "project"
          },
          "expect": {
            "$document": {
              "name": "fresh",
              "$sequence": "1",
              "$id": "project",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$permissions": [
                "read(\"any\")"
              ],
              "$collection": "projects"
            }
          }
        }
      ]
    },
