              "$collection": "projects",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "database.get_query_cache_key",
          "args": {
            "collectionId": "projects"
          },
          "bind": "key",
          "expect": "default-cache-compat-database-postgres:compat::collection:projects:query"
        },
        {
          "op": "database.get_document",
          "args": {
            "collection": "projects",
            "id": "project"
          },
          "bind": "document",
          "expect": {
            "$document": {
              "name": "fresh",
