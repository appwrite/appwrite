{
  "source": "vendor/utopia-php/database/tests/unit/CreateCollectionRaceTest.php",
  "cases": [
    {
      "name": "testCreateCollectionDoesNotDropUncommittedPeerTable",
      "steps": [
        {
          "op": "db.open",
          "args": {},
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "any"
          },
          "expect": null
        },
        {
          "op": "adapter.open",
          "args": {
            "namespace": "compat"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.create_collection",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "name": "preCommitCreate",
            "attributes": [
              {
                "$id": "name",
                "type": "string",
                "size": 128,
                "required": false
              }
            ]
          },
          "expect": true
        },
        {
          "op": "adapter.create_document",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "preCommitCreate",
            "document": {
              "$id": "written",
              "$permissions": [
                "read(\"any\")"
              ],
              "name": "peer"
            }
          },
          "expect": {
            "$document": {
              "$id": "written",
              "$permissions": [
                "read(\"any\")"
              ],
              "name": "peer",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "database.create_collection",
          "args": {
            "id": "preCommitCreate",
            "attributes": [
              {
                "$document": {
                  "$id": "name",
                  "type": "string",
                  "size": 128,
                  "required": false
                }
              }
            ],
            "permissions": [
              "read(\"any\")",
              "create(\"any\")"
            ]
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\Duplicate",
              "message": "Collection preCommitCreate already exists"
            }
          }
        },
        {
          "op": "db.sql",
          "args": {
            "sql": "SELECT \"_uid\", \"name\" FROM \"${ns}\".\"compat_preCommitCreate\""
          },
          "expect": [
            {
              "_uid": "written",
              "name": "peer"
            }
          ]
        }
      ]
    }
  ]
}
