        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1377"
            },
            "method": "enable",
            "args": {}
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1377"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1379"
              }
            }
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1377"
            },
            "method": "reset",
            "args": {}
          },
          "expect": null
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1377"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1379"
              }
            }
          },
          "expect": true
        }
      ]
