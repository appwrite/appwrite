{
  "source": [
    "vendor/utopia-php/database/tests/unit/Authorization/FluentTest.php"
  ],
  "cases": [
    {
      "name": "FluentTest::testRoleSettersChainOnTheSameInstance",
      "state": [],
      "steps": [
        {
          "op": "db.add_format",
          "args": {
            "name": "updateAttributeIntegerOnly"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "updateAttributeIntegerOnly"
          },
          "expect": true
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Authorization",
            "args": {},
            "as": "o1372"
          },
          "bind": "s4009",
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Role",
            "method": "user",
            "args": {
              "identifier": "123"
            },
            "as": "o1373"
          },
          "bind": "s4010",
          "expect": {
            "$value": "Role",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1373"
            },
            "method": "toString",
            "args": {}
          },
          "expect": "user:123"
        },
        {
          "op": "object.call",
          "args": {
            "class": "Role",
            "method": "team",
            "args": {
              "identifier": "abc"
            },
            "as": "o1374"
          },
          "bind": "s4012",
          "expect": {
            "$value": "Role",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1374"
            },
            "method": "toString",
            "args": {}
          },
          "expect": "team:abc"
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1372"
            },
            "method": "cleanRoles",
            "args": {}
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1372"
            },
            "method": "addRole",
            "args": {
              "role": "user:123"
            }
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1372"
            },
            "method": "addRole",
            "args": {
              "role": "team:abc"
            }
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1372"
            },
            "method": "removeRole",
            "args": {
              "role": "team:abc"
            }
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1372"
            },
            "method": "getRoles",
            "args": {}
          },
          "expect": [
            "user:123"
          ]
        }
      ]
    },
    {
