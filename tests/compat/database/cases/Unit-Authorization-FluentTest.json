    {
      "name": "FluentTest::testADisabledDefaultStatusSkipsChecksUntilEnabled",
      "state": [],
      "steps": [
        {
          "op": "db.add_format",
          "args": {
            "name": "updateAttributeIntegerOnly"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "updateAttributeIntegerOnly"
          },
          "expect": true
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Authorization",
            "args": {
              "defaultStatus": false
            },
            "as": "o1377"
          },
          "bind": "s4031",
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1377"
            },
            "method": "cleanRoles",
            "args": {}
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Role",
            "method": "user",
            "args": {
              "identifier": "123"
            },
            "as": "o1378"
          },
          "bind": "s4033",
          "expect": {
            "$value": "Role",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1378"
