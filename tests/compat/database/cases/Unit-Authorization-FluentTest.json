    {
      "name": "FluentTest::testSkipLiftsTheCheckOnlyInsideTheCallback",
      "state": [],
      "steps": [
        {
          "op": "db.add_format",
          "args": {
            "name": "updateAttributeIntegerOnly"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "updateAttributeIntegerOnly"
          },
          "expect": true
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Authorization",
            "args": {},
            "as": "o1380"
          },
          "bind": "s4042",
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1380"
            },
            "method": "cleanRoles",
            "args": {}
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Role",
            "method": "user",
            "args": {
              "identifier": "123"
            },
            "as": "o1381"
          },
          "bind": "s4044",
          "expect": {
            "$value": "Role",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1381"
            },
            "method": "toString",
            "args": {}
          },
          "expect": "user:123"
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Authorization\\Input",
            "args": {
              "action": {
                "$enum": "PermissionType::Delete"
              },
              "permissions": [
                "user:123"
              ]
            },
            "as": "o1382"
          },
          "bind": "s4046",
          "expect": {
            "$value": "Validator\\Authorization\\Input",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1380"
            },
            "method": "skip",
            "args": {
              "callback": {
                "steps": [
                  {
                    "op": "object.call",
                    "args": {
                      "this": {
                        "$obj": "o1380"
                      },
                      "method": "isValid",
                      "args": {
                        "value": {
                          "$obj": "o1382"
                        }
                      }
                    },
                    "return": true
                  }
                ]
              }
            }
          },
          "expect": {
            "result": true,
            "calls": {
              "callback": [
                {
                  "args": [],
                  "steps": [
                    true
                  ]
                }
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1380"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1382"
              }
            }
          },
          "expect": false
        }
      ]
    },
