            "as": "o1379"
          },
          "bind": "s4035",
          "expect": {
            "$value": "Validator\\Authorization\\Input",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1377"
            },
            "method": "getStatus",
            "args": {}
          },
          "expect": false
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1377"
            },
            "method": "isValid",
            "args": {
              "value": {
                "$obj": "o1379"
              }
            }
          },
          "expect": true
