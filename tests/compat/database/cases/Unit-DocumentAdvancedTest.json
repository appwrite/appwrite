              "$id": "a",
              "val": 99
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o177"
            },
            "method": "getAttribute",
            "args": {
              "name": "items"
            }
          },
          "expect": [
            {
              "$document": {
                "$id": "a",
                "val": 1
              }
            },
            {
              "$document": {
                "$id": "b",
                "val": 2
              }
