    {
      "name": "DocumentAdvancedTest::testDeepCloneWithNestedDocuments",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "inner",
                "value": "original"
              }
            },
            "as": "o170"
          },
          "bind": "s324",
          "expect": {
            "$document": {
              "$id": "inner",
              "value": "original"
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "middle",
                "child": {
                  "$obj": "o170"
                }
              }
            },
            "as": "o171"
          },
          "bind": "s325",
          "expect": {
            "$document": {
              "$id": "middle",
              "child": {
                "$document": {
                  "$id": "inner",
                  "value": "original"
                }
              }
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "outer",
                "child": {
                  "$obj": "o171"
                }
              }
            },
            "as": "o172"
          },
          "expect": {
            "$document": {
              "$id": "outer",
              "child": {
                "$document": {
                  "$id": "middle",
                  "child": {
                    "$document": {
                      "$id": "inner",
                      "value": "original"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$document": {
                "$id": "outer",
                "child": {
                  "$id": "middle",
                  "child": {
                    "$id": "inner",
                    "value": "original"
                  }
                }
              }
            },
            "method": "getAttribute",
            "args": {
              "name": "child"
            },
            "as": "o173"
          },
          "bind": "s327",
          "expect": {
            "$document": {
              "$id": "middle",
              "child": {
                "$document": {
                  "$id": "inner",
                  "value": "original"
                }
              }
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o173"
            },
            "method": "getAttribute",
            "args": {
              "name": "child"
            },
            "as": "o174"
          },
          "bind": "s328",
          "expect": {
            "$document": {
              "$id": "inner",
              "value": "original"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o174"
            },
            "method": "setAttribute",
            "args": {
              "key": "value",
              "value": "modified"
            }
          },
          "expect": {
            "$document": {
              "$id": "inner",
              "value": "modified"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o170"
            },
            "method": "getAttribute",
            "args": {
              "name": "value"
            }
          },
          "expect": "original"
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o174"
            },
            "method": "getAttribute",
            "args": {
              "name": "value"
            }
          },
          "expect": "modified"
        }
      ]
    },
    {
      "name": "DocumentAdvancedTest::testDeepCloneWithArrayOfDocuments",
      "state": [],
