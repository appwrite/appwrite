{
  "source": [
    "vendor/utopia-php/database/tests/unit/Transactions/NoRetryTest.php"
  ],
  "cases": [
    {
      "name": "NoRetryTest::testTheCallbackRunsOnceAndTheFailurePropagates#memory timeout",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Adapter\\Memory",
            "args": {},
            "as": "o735"
          },
          "bind": "s1480",
          "expect": {
            "$adapter": "Memory"
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\Authorization",
            "args": {},
            "as": "o736"
          },
          "bind": "s1481",
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o735"
            },
            "method": "setAuthorization",
            "args": {
              "authorization": {
                "$obj": "o736"
              }
            }
          },
          "expect": {
            "$adapter": "Memory"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o735"
            },
            "method": "withTransaction",
            "args": {
              "callback": {
                "steps": [
                  {
                    "op": "$throw",
                    "args": {
                      "class": "Utopia\\Database\\Exception\\Timeout",
                      "message": "Query timed out"
                    }
                  }
                ]
              }
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\Timeout",
              "message": "Query timed out"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o735"
            },
            "method": "inTransaction",
            "args": {}
          },
          "expect": false
        }
      ]
    },
