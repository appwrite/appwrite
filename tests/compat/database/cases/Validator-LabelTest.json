    {
      "name": "edge: lengths, unicode, internal",
      "steps": [
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": ""
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": "0"
          },
          "expect": {
            "valid": true,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": "é"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": "aé"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": "a\n"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": "ABCxyz019"
          },
          "expect": {
            "valid": true,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": "$id"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "value": " a"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "allowInternal": true,
            "value": "$id"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "allowInternal": true,
            "value": "$createdAt"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "allowInternal": true,
            "value": "appwrite_"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "allowInternal": true,
            "value": "$"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 36 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "maxLength": 3,
            "value": "abc"
          },
          "expect": {
            "valid": true,
            "description": "Value must be a valid string between 1 and 3 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "maxLength": 3,
            "value": "abcd"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 3 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "label",
            "maxLength": 0,
            "value": "a"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 0 chars containing only alphanumeric chars"
          }
        }
      ]
    },
    {
      "name": "edge: description and meta",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "label",
            "maxLength": 12
          },
          "bind": "l",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "l"
            }
          },
          "expect": "Value must be a valid string between 1 and 12 chars containing only alphanumeric chars"
        },
        {
          "op": "validator.meta",
          "args": {
            "validator": {
              "$ref": "l"
            }
          },
          "expect": {
            "type": "string",
            "is_array": false
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "l"
            },
            "value": "a_b"
          },
          "expect": {
            "valid": false,
            "description": "Value must be a valid string between 1 and 12 chars containing only alphanumeric chars"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "l"
            },
            "value": "ab"
          },
          "expect": {
            "valid": true,
            "description": "Value must be a valid string between 1 and 12 chars containing only alphanumeric chars"
          }
        }
      ]
    }
  ]
}
