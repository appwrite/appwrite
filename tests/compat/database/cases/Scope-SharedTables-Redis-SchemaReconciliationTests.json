{
  "source": [
    "vendor/utopia-php/database/tests/e2e/Adapter/Scopes/SchemaReconciliationTests.php",
    "vendor/utopia-php/database/tests/e2e/Adapter/SharedTables/RedisTest.php"
  ],
  "cases": [
    {
      "name": "SchemaReconciliationTests::testEveryAttributeReadsBackAsTheColumnTypeTheAdapterCreates",
      "state": [
        "redis-json@database-redis-adapter"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "redis": true,
            "cache": "none",
            "namespace": "",
            "shared_tables": true,
            "tenant": 999
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "subQueryProbe"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "operator_double_decode"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt",
            "fixture": "encrypt_operator"
          },
          "expect": null
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "supports",
            "args": {
              "capability": {
                "$enum": "Capability::SchemaIntrospection"
              }
            }
          },
          "expect": false
        },
        {
          "op": "database.get_schema_attributes",
          "args": {
            "collection": "reconcileTypes"
          },
          "expect": []
        },
        {
          "op": "database.get_schema_indexes",
          "args": {
            "collection": "reconcileTypes"
          },
          "expect": []
        }
      ]
    },
