{
  "source": "vendor/utopia-php/database/tests/unit/IDTest.php",
  "cases": [
    {
      "name": "testCustomID",
      "op": "id.custom",
      "args": {
        "id": "test"
      },
      "expect": "test"
    },
    {
      "name": "testUniqueID",
      "op": "id.unique",
      "args": {},
      "expect": {
        "id": "<masked>",
        "length": 20,
        "hex": true
      }
    },
    {
      "name": "unique with padding 0",
      "op": "id.unique",
      "args": {
        "padding": 0
      },
      "expect": {
        "id": "<masked>",
        "length": 13,
        "hex": true
      }
    },
    {
      "name": "unique with padding -1",
      "op": "id.unique",
      "args": {
        "padding": -1
      },
      "expect": {
        "id": "<masked>",
        "length": 13,
        "hex": true
      }
    },
    {
      "name": "unique with padding 1",
      "op": "id.unique",
      "args": {
        "padding": 1
      },
      "expect": {
        "id": "<masked>",
        "length": 14,
        "hex": true
      }
    },
    {
      "name": "unique with padding 2",
      "op": "id.unique",
      "args": {
        "padding": 2
      },
      "expect": {
        "id": "<masked>",
        "length": 15,
        "hex": true
      }
    },
    {
      "name": "unique with padding 7",
      "op": "id.unique",
      "args": {
        "padding": 7
      },
      "expect": {
        "id": "<masked>",
        "length": 20,
        "hex": true
      }
    },
    {
      "name": "unique with padding 8",
      "op": "id.unique",
      "args": {
        "padding": 8
      },
      "expect": {
        "id": "<masked>",
        "length": 21,
        "hex": true
      }
    },
    {
      "name": "unique with padding 20",
      "op": "id.unique",
      "args": {
        "padding": 20
      },
      "expect": {
        "id": "<masked>",
        "length": 33,
        "hex": true
      }
    },
    {
      "name": "unique with padding 33",
      "op": "id.unique",
      "args": {
        "padding": 33
      },
      "expect": {
        "id": "<masked>",
        "length": 46,
        "hex": true
      }
    },
    {
      "name": "custom keeps any string",
      "op": "id.custom",
      "args": {
        "id": ""
      },
      "expect": ""
    },
    {
      "name": "custom keeps unicode",
      "op": "id.custom",
      "args": {
        "id": "é😀"
      },
      "expect": "é😀"
    }
  ]
}
