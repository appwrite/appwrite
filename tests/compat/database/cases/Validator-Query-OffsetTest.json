{
  "source": "vendor/utopia-php/database/tests/unit/Validator/Query/OffsetTest.php",
  "cases": [
    {
      "name": "testValueSuccess",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "query_offset",
            "maxOffset": 5000
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "$query": {
                "method": "offset",
                "attribute": "",
                "values": [
                  1
                ]
              }
            }
          },
          "expect": {
            "valid": true,
            "description": "Invalid query"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "$query": {
                "method": "offset",
                "attribute": "",
                "values": [
                  0
                ]
              }
            }
          },
          "expect": {
            "valid": true,
            "description": "Invalid query"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "$query": {
                "method": "offset",
                "attribute": "",
                "values": [
                  5000
                ]
              }
            }
          },
          "expect": {
            "valid": true,
            "description": "Invalid query"
          }
        }
      ]
    },
