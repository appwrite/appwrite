  "cases": [
    {
      "name": "ObjectTest::test_valid_associative_objects",
      "state": [],
      "steps": [
        {
          "op": "db.add_format",
          "args": {
            "name": "testformat"
          },
          "expect": true
        },
        {
          "op": "object.new",
          "args": {
            "class": "Validator\\ObjectValue",
            "args": {},
            "as": "o21467"
          },
          "bind": "s24149",
          "expect": {
            "$value": "Validator\\ObjectValue",
            "fields": {}
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o21467"
            },
            "method": "isValid",
            "args": {
              "value": {
                "key": "value"
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o21467"
            },
            "method": "isValid",
            "args": {
              "value": {
                "a": {
                  "b": {
                    "c": 123
                  }
                }
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o21467"
            },
            "method": "isValid",
            "args": {
              "value": {
                "author": "Arnab",
                "metadata": {
                  "rating": 4.5,
                  "info": {
                    "category": "science"
                  }
                }
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o21467"
            },
            "method": "isValid",
            "args": {
              "value": {
                "key1": null,
                "key2": {
                  "nested": null
                }
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o21467"
            },
            "method": "isValid",
            "args": {
              "value": {
                "meta": {
                  "$object": {
                    "x": 1
                  }
                }
              }
            }
          },
          "expect": true
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o21467"
            },
            "method": "isValid",
            "args": {
              "value": {
                "a": 1,
                "2": "b"
              }
            }
          },
          "expect": true
        }
      ]
    },
