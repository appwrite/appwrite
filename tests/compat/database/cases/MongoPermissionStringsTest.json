{
  "source": "vendor/utopia-php/database/tests/unit/MongoPermissionStringsTest.php",
  "cases": [
    {
      "name": "testPeriodInRoleIsLiteralNotRegexWildcard",
      "state": [],
      "steps": [
        {
          "op": "mongo.permission_strings",
          "args": {
            "roles": [
              "user:alice."
            ],
            "type": "read"
          },
          "expect": [
            "read(\"user:alice.\")"
          ]
        }
      ]
    },
    {
      "name": "testMassReadDotPaddingStaysExact",
      "state": [],
      "steps": [
        {
          "op": "mongo.permission_strings",
          "args": {
            "roles": [
              "user:a..................."
            ],
            "type": "read"
          },
          "expect": [
            "read(\"user:a...................\")"
          ]
        }
      ]
    },
    {
      "name": "testMatchingIsCaseSensitiveAndUsesRequestedType",
      "state": [],
      "steps": [
        {
          "op": "mongo.permission_strings",
          "args": {
            "roles": [
              "user:alice"
            ],
            "type": "update"
          },
          "expect": [
            "update(\"user:alice\")"
          ]
        },
        {
          "op": "mongo.permission_strings",
          "args": {
            "roles": [
              "user:Alice",
              "USER:alice"
            ],
            "type": "delete"
          },
          "expect": [
            "delete(\"user:Alice\")",
            "delete(\"USER:alice\")"
          ]
        }
      ]
    },
    {
      "name": "testMultipleRolesMapToExactPermissionStrings",
      "state": [],
      "steps": [
        {
          "op": "mongo.permission_strings",
          "args": {
            "roles": [
              "user:alice",
              "users"
            ],
            "type": "read"
          },
          "expect": [
            "read(\"user:alice\")",
            "read(\"users\")"
          ]
        }
      ]
    },
    {
      "name": "testEmptyRolesProduceEmptyList",
      "state": [],
      "steps": [
        {
          "op": "mongo.permission_strings",
          "args": {
            "roles": [],
            "type": "read"
          },
          "expect": []
        }
      ]
    },
    {
      "name": "testValuesAreStringsNotRegex",
      "state": [],
      "steps": [
        {
          "op": "mongo.permission_strings",
          "args": {
            "roles": [
              "user:alice.",
              "label:*",
              "team:x/owner",
              "any"
            ],
            "type": "read"
          },
          "expect": [
            "read(\"user:alice.\")",
            "read(\"label:*\")",
            "read(\"team:x/owner\")",
            "read(\"any\")"
          ]
        },
        {
          "op": "mongo.permission_strings",
          "args": {
            "roles": [
              "user:a\"b",
              "user:ünïcode"
            ],
            "type": "write"
          },
          "expect": [
            "write(\"user:a\"b\")",
            "write(\"user:ünïcode\")"
          ]
        }
      ]
    }
  ]
}
