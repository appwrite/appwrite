        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1684"
            },
            "method": "setAuthorization",
            "args": {
              "authorization": {
                "$obj": "o1685"
              }
            }
          },
          "expect": {
            "$database": true
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1684"
            },
            "method": "ping",
            "args": {}
          },
          "expect": true
