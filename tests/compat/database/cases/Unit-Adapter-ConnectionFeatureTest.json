        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1684"
            },
            "method": "reconnect",
            "args": {}
          },
          "expect": null
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1684"
            },
            "method": "getConnectionId",
            "args": {}
          },
          "expect": "<masked>",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "each runtime reaches the server under its own host name, on its own connection"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
