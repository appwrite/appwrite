{
  "source": "vendor/utopia-php/database/tests/unit/Validator/DocumentQueriesTest.php",
  "cases": [
    {
      "name": "testValidQueries",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "queries_document",
            "attributes": [
              {
                "$document": {
                  "$id": "title",
                  "key": "title",
                  "type": "string",
                  "size": 256,
                  "required": true,
                  "signed": true,
                  "array": false,
                  "filters": []
                }
              },
              {
                "$document": {
                  "$id": "price",
                  "key": "price",
                  "type": "double",
                  "size": 5,
                  "required": true,
                  "signed": true,
                  "array": false,
                  "filters": []
                }
              }
            ]
          },
          "bind": "v"
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              {
                "$query": {
                  "method": "select",
                  "attribute": "",
                  "values": [
                    "title"
                  ]
                }
              }
            ]
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              {
                "$query": {
                  "method": "select",
                  "attribute": "",
                  "values": [
                    "title"
                  ]
                }
              },
              {
                "$query": {
                  "method": "select",
                  "attribute": "",
                  "values": [
                    "price.relation"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
