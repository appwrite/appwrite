{
  "source": [
    "vendor/utopia-php/database/tests/e2e/Adapter/Scopes/ObjectAttributeTests.php",
    "vendor/utopia-php/database/tests/e2e/Adapter/MariaDBTest.php"
  ],
  "cases": [
    {
      "name": "ObjectAttributeTests::testObjectAttribute",
      "state": [
        "mysql@database-mariadb"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "driver": "mariadb"
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "database.set_tenant",
          "args": {
            "tenant": 1
          },
          "expect": {
            "$database": true
          }
        },
        {
          "op": "database.set_metadata",
          "args": {
            "key": "compat",
            "value": ""
          },
          "expect": {
            "$database": true
          }
        },
        {
          "op": "database.reset_metadata",
          "args": {},
          "expect": null
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRangeNew"
          },
          "expect": true
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "subQueryProbe"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "operator_double_decode"
          },
          "expect": null
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "getSupportForObject",
            "args": {}
          },
          "expect": false
        }
      ]
    },
