            "fields": {
              "expression": "x = ?",
              "bindings": [
                1
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Adapter\\SQL\\Hook\\Column\\AllowNull",
            "method": "wrap",
            "args": {
