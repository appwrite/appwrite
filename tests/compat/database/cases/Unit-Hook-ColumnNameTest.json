            "args": {
              "expression": "x = ?",
              "bindings": [
                1
              ]
            },
            "as": "o10705"
          },
          "bind": "s62855",
          "expect": {
            "$value": "Query\\Builder\\Condition",
            "fields": {
              "expression": "x = ?",
              "bindings": [
                1
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "class": "Adapter\\SQL\\Hook\\Column\\AllowNull",
            "method": "wrap",
            "args": {
              "condition": {
                "$obj": "o10705"
              },
              "column": "alias._uid"
            },
            "as": "o10706"
          },
          "expect": {
            "$value": "Query\\Builder\\Condition",
            "fields": {
              "expression": "(x = ? OR `alias`.`_uid` IS NULL)",
              "bindings": [
                1
              ]
            }
          }
        }
      ]
    },
