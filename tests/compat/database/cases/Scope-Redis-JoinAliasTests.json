{
  "source": [
    "vendor/utopia-php/database/tests/e2e/Adapter/Scopes/JoinAliasTests.php",
    "vendor/utopia-php/database/tests/e2e/Adapter/RedisTest.php"
  ],
  "cases": [
    {
      "name": "JoinAliasTests::testJoinWithoutAliasIsReadUnderItsTableId",
      "state": [
        "redis-json@database-redis-adapter"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "redis": true,
            "cache": "none",
            "namespace": "${ns}"
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.authorization.clean_roles",
          "args": {},
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "any"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "users"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "user:x"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "subQueryProbe"
          },
          "expect": null
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "counterIntegerRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "counterBigIntegerRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "counterDoubleRange"
          },
          "expect": true
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "supports",
            "args": {
              "capability": {
                "$enum": "Capability::Joins"
              }
            }
          },
          "expect": false
        }
      ]
    },
