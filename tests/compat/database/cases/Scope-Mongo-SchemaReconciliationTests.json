{
  "source": [
    "vendor/utopia-php/database/tests/e2e/Adapter/Scopes/SchemaReconciliationTests.php",
    "vendor/utopia-php/database/tests/e2e/Adapter/MongoDBTest.php"
  ],
  "cases": [
    {
      "name": "SchemaReconciliationTests::testEveryAttributeReadsBackAsTheColumnTypeTheAdapterCreates",
      "state": [
        "mongo@database-mongo"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "engine": "mongo"
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.authorization.clean_roles",
          "args": {},
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "user:alice0"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "any"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRangeNew"
          },
          "expect": true
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "subQueryProbe"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "operator_double_decode"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt",
            "fixture": "encrypt_operator"
          },
          "expect": null
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "supports",
            "args": {
              "capability": {
                "$enum": "Capability::SchemaIntrospection"
              }
            }
          },
          "expect": false
        },
        {
          "op": "database.get_schema_attributes",
          "args": {
            "collection": "reconcileTypes"
          },
          "expect": []
        },
        {
          "op": "database.get_schema_indexes",
          "args": {
            "collection": "reconcileTypes"
          },
          "expect": []
        }
      ]
    },
