    {
      "name": "DatabaseTests::testUpdateIsRefusedUnderSharedTables",
      "state": [
        "mongo@database-mongo"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "engine": "mongo",
            "shared_tables": true,
            "tenant": 999
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRangeNew"
          },
          "expect": true
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "subQueryProbe"
          },
          "expect": null
        },
        {
          "op": "database.has_shared_tables",
          "args": {},
          "expect": true
        },
        {
          "op": "database.get_database",
          "args": {},
          "expect": "${ns}"
        },
        {
          "op": "database.update",
          "args": {
            "database": "${ns}",
            "new": "${ns}_${ns}Renamed"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Cannot rename a database while shared tables are enabled"
            }
          }
        },
        {
          "op": "database.get_database",
          "args": {},
          "expect": "${ns}"
        },
        {
          "op": "database.exists",
          "args": {
            "database": "${ns}_${ns}Renamed"
          },
          "expect": false
        }
      ]
    }
  ]
