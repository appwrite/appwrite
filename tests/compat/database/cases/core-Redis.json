{
  "cases": [
    {
      "name": "a WRONGTYPE id set reads as false, as phpredis gives it",
      "state": [
        "redis-json@database-redis-adapter"
      ],
      "steps": [
        {
          "op": "db.open",
          "args": {
            "redis": true,
            "cache": "none",
            "namespace": "${ns}"
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "database.create_collection",
          "args": {
            "id": "things",
            "permissions": [
              "create(\"any\")",
              "read(\"any\")",
              "update(\"any\")",
              "delete(\"any\")"
            ],
            "documentSecurity": false
          },
          "expect": {
            "$document": {
              "$id": "things",
              "$permissions": [
                "create(\"any\")",
                "read(\"any\")",
                "update(\"any\")",
                "delete(\"any\")"
              ],
              "name": "things",
              "attributes": [],
              "indexes": [],
              "documentSecurity": false,
              "$collection": "_metadata",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "database.create_attribute",
          "args": {
            "collection": "things",
            "id": "name",
            "type": "string",
            "size": 32,
            "required": false
          },
          "expect": true
        },
        {
          "op": "database.create_document",
          "args": {
            "collection": "things",
            "document": {
              "$id": "first",
              "name": "First"
            }
          },
          "expect": {
            "$document": {
              "$id": "first",
              "name": "First",
              "$collection": "things",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$permissions": [],
              "$sequence": "1"
            }
          }
        },
        {
          "op": "db.redis",
          "args": {
            "command": [
              "SET",
              "utopia:${ns}:${ns}:idx:things",
              "not a set"
            ]
          },
          "expect": null
        },
        {
          "op": "database.create_document",
          "args": {
            "collection": "things",
            "document": {
              "$id": "second",
              "name": "Second"
            }
          },
          "expect": {
            "$document": {
              "$id": "second",
              "name": "Second",
              "$collection": "things",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$permissions": [],
              "$sequence": "2"
            }
          }
        },
        {
          "op": "database.get_document",
          "args": {
            "collection": "things",
            "id": "second"
          },
          "expect": {
            "$document": {
              "$id": "second",
              "name": "Second",
              "$collection": "things",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$permissions": [],
              "$sequence": "2"
            }
          }
        },
        {
          "op": "database.find",
          "args": {
            "collection": "things"
          },
          "expect": []
        },
        {
          "op": "database.count",
          "args": {
            "collection": "things"
          },
          "expect": 0
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "startTransaction",
            "args": {}
          },
          "expect": true
        },
        {
          "op": "database.create_document",
          "args": {
            "collection": "things",
            "document": {
              "$id": "third",
              "name": "Third"
            }
          },
          "expect": {
            "$document": {
              "$id": "third",
              "name": "Third",
              "$collection": "things",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$permissions": [],
              "$sequence": "3"
            }
          }
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "rollbackTransaction",
            "args": {}
          },
          "expect": true
        },
        {
          "op": "db.adapter",
          "args": {
            "method": "inTransaction",
            "args": {}
          },
          "expect": false
        },
        {
          "op": "database.get_document",
          "args": {
            "collection": "things",
            "id": "third"
          },
          "expect": {
            "$document": {}
          }
        },
        {
          "op": "database.delete_document",
          "args": {
            "collection": "things",
            "id": "first"
          },
          "expect": true
        },
        {
          "op": "database.get_document",
          "args": {
            "collection": "things",
            "id": "first"
          },
          "expect": {
            "$document": {}
          }
        },
        {
          "op": "db.redis",
          "args": {
            "command": [
              "DEL",
              "utopia:${ns}:${ns}:idx:things"
            ]
          },
          "expect": null
        },
        {
          "op": "db.redis",
          "args": {
            "command": [
              "SADD",
              "utopia:${ns}:${ns}:idx:things",
              "second"
            ]
          },
          "expect": null
        },
        {
          "op": "database.find",
          "args": {
            "collection": "things"
          },
          "expect": [
            {
              "$document": {
                "$id": "second",
                "name": "Second",
                "$collection": "things",
                "$createdAt": "<now>",
                "$updatedAt": "<now>",
                "$permissions": [],
                "$sequence": "2"
              }
            }
          ]
        }
      ]
    }
  ]
}
