    {
      "name": "DocumentTrimTest::testGetArrayCopyConvertsNestedDocumentsRecursively",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "child",
                "name": "Child",
                "secret": "nested"
              }
            },
            "as": "o1034"
          },
          "bind": "s2294",
          "expect": {
            "$document": {
              "$id": "child",
              "name": "Child",
              "secret": "nested"
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "first",
                "secret": "first"
              }
            },
            "as": "o1035"
          },
          "bind": "s2295",
          "expect": {
            "$document": {
              "$id": "first",
              "secret": "first"
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "parent",
                "name": "Parent",
                "secret": "hidden",
                "child": {
                  "$obj": "o1034"
                },
                "children": [
                  {
                    "$obj": "o1035"
                  },
                  "plain"
                ],
                "tags": [
                  "a",
                  "b"
                ]
              }
            },
            "as": "o1036"
          },
          "bind": "s2296",
          "expect": {
            "$document": {
              "$id": "parent",
              "name": "Parent",
              "secret": "hidden",
              "child": {
                "$document": {
                  "$id": "child",
                  "name": "Child",
                  "secret": "nested"
                }
              },
              "children": [
                {
                  "$document": {
                    "$id": "first",
                    "secret": "first"
                  }
                },
                "plain"
              ],
              "tags": [
                "a",
                "b"
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1036"
            },
            "method": "getArrayCopy",
            "args": {}
          },
          "expect": {
            "$id": "parent",
            "name": "Parent",
            "secret": "hidden",
            "child": {
              "$id": "child",
              "name": "Child",
              "secret": "nested"
            },
            "children": [
              {
                "$id": "first",
                "secret": "first"
              },
              "plain"
            ],
            "tags": [
              "a",
              "b"
            ]
          }
        }
      ]
    },
    {
      "name": "DocumentTrimTest::testGetArrayCopyConvertsDocumentsNestedInNestedDocuments",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "grandchild"
              }
            },
            "as": "o1037"
          },
