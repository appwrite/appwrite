          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "grandchildren": [
                  {
                    "$obj": "o1037"
                  }
                ]
              }
            },
            "as": "o1038"
          },
          "bind": "s2299",
          "expect": {
            "$document": {
              "grandchildren": [
                {
                  "$document": {
                    "$id": "grandchild"
                  }
                }
              ]
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "child": {
                  "$obj": "o1038"
                }
              }
            },
            "as": "o1039"
          },
          "bind": "s2300",
          "expect": {
            "$document": {
              "child": {
                "$document": {
                  "grandchildren": [
                    {
                      "$document": {
                        "$id": "grandchild"
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1039"
            },
            "method": "getArrayCopy",
            "args": {}
          },
          "expect": {
            "child": {
              "grandchildren": [
                {
                  "$id": "grandchild"
                }
              ]
            }
          }
        }
      ]
