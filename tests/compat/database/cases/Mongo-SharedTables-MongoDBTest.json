        },
        {
          "op": "db.authorization.add_role",
          "args": {
            "role": "any"
          },
          "expect": {
            "$authorization": true
          }
        },
        {
          "op": "database.set_tenant",
          "args": {
            "tenant": 999
          },
          "expect": {
            "$database": true
          }
        }
      ]
    }
  ]
}
