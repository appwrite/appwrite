          "expect": [
            {
              "$document": {
                "name": "pooledDefinition",
                "attributes": [],
                "indexes": [],
                "documentSecurity": true,
                "$permissions": [
                  "read(\"any\")"
                ],
                "$collection": "_metadata",
                "$createdAt": "<now>",
                "$updatedAt": "<now>",
                "$sequence": "<uuid7>",
                "$id": "pooledDefinition",
                "$tenant": null
              },
              "$class": "Collection"
            }
          ]
        },
        {
          "op": "database.count",
          "args": {
            "collection": "_metadata",
            "queries": [
              {
                "$query": {
                  "method": "equal",
                  "attribute": "$id",
                  "values": [
                    "pooledDefinition",
                    "pooledAdminDefinition",
                    "ownedDefinition"
