{
  "source": "vendor/utopia-php/database/tests/unit/ForUpdateCacheTest.php",
  "cases": [
    {
      "name": "testPurgeMakesTheNextReadReturnFreshData",
      "steps": [
        {
          "op": "db.open",
          "args": {},
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "database.create_collection",
          "args": {
            "id": "projects"
          },
          "expect": {
            "$document": {
              "$id": "projects",
              "$permissions": [
                "create(\"any\")"
              ],
              "name": "projects",
              "attributes": [],
              "indexes": [],
              "documentSecurity": true,
              "$collection": "_metadata",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "database.create_attribute",
          "args": {
            "collection": "projects",
            "id": "name",
            "type": "string",
            "size": 255,
            "required": false
          },
          "expect": true
        },
        {
          "op": "database.create_attribute",
          "args": {
            "collection": "projects",
            "id": "description",
            "type": "string",
            "size": 255,
            "required": false
          },
          "expect": true
        },
        {
          "op": "database.create_document",
          "args": {
            "collection": "projects",
            "document": {
              "$id": "project",
              "$permissions": [
                "read(\"any\")",
                "update(\"any\")"
              ],
              "name": "stale",
              "description": "stale"
            }
          },
          "expect": {
            "$document": {
              "$id": "project",
              "$permissions": [
                "read(\"any\")",
                "update(\"any\")"
              ],
              "name": "stale",
              "description": "stale",
              "$collection": "projects",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$sequence": "1"
            }
          }
        },
        {
          "op": "database.get_document",
          "args": {
            "collection": "projects",
            "id": "project"
          },
          "expect": {
            "$document": {
              "name": "stale",
              "description": "stale",
              "$sequence": "1",
              "$id": "project",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$permissions": [
                "read(\"any\")",
                "update(\"any\")"
              ],
              "$collection": "projects"
            }
          }
        },
        {
          "op": "db.sql",
          "args": {
            "sql": "UPDATE \"${ns}\".\"compat_projects\" SET \"name\" = 'fresh' WHERE _uid = 'project' RETURNING _uid"
          },
          "expect": [
            {
              "_uid": "project"
            }
          ]
        },
        {
          "op": "database.get_document",
          "args": {
            "collection": "projects",
            "id": "project"
          },
          "expect": {
            "$document": {
              "name": "stale",
              "description": "stale",
              "$sequence": "1",
              "$id": "project",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$permissions": [
                "read(\"any\")",
                "update(\"any\")"
              ],
              "$collection": "projects"
            }
          }
        },
        {
          "op": "database.purge_cached_document",
          "args": {
            "collectionId": "projects",
            "id": "project"
          },
          "expect": true
        },
        {
          "op": "database.get_document",
          "args": {
            "collection": "projects",
            "id": "project"
          },
          "expect": {
            "$document": {
              "name": "fresh",
              "description": "stale",
              "$sequence": "1",
              "$id": "project",
              "$createdAt": "<now>",
              "$updatedAt": "<now>",
              "$permissions": [
                "read(\"any\")",
                "update(\"any\")"
              ],
              "$collection": "projects"
            }
          }
        }
      ]
    },
