            }
          },
          "expect": true
        },
        {
          "op": "adapter.create_collection",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "name": "docs"
          },
          "expect": true
        },
        {
          "op": "adapter.open",
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "b"
            }
          },
          "expect": true
