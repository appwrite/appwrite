{
  "source": "vendor/utopia-php/database/tests/unit/SQLGetDocumentTest.php",
  "cases": [
    {
      "name": "testUsesPostgresExecuteHook",
      "steps": [
        {
          "op": "adapter.open",
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.before",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "event": "*",
            "name": "capture"
          },
          "expect": null
        },
        {
          "op": "adapter.create",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.create_collection",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "name": "docs"
          },
          "expect": true
        },
        {
          "op": "adapter.set_timeout",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "milliseconds": 25
          },
          "expect": null
        },
        {
          "op": "adapter.get_document",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "docs",
            "id": "document"
          },
          "expect": {
            "$document": {}
          }
        },
        {
          "op": "adapter.driver_query",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "SHOW statement_timeout"
          },
          "expect": [
            {
              "statement_timeout": "0"
            }
          ]
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.get_document",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "docs",
            "id": "document"
          },
          "expect": {
            "$document": {}
          }
        },
        {
          "op": "adapter.driver_query",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "SHOW statement_timeout"
          },
          "expect": [
            {
              "statement_timeout": "25ms"
            }
          ]
        },
        {
          "op": "adapter.commit_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.driver_query",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "SHOW statement_timeout"
          },
          "expect": [
            {
              "statement_timeout": "0"
            }
          ]
        },
        {
          "op": "adapter.captured",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            [
              "*",
              "CREATE SCHEMA \"${ns}\""
            ],
            [
              "*",
              "\n            CREATE TABLE \"${ns}\".\"ns_docs\" (\n                _id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n                _uid VARCHAR(255) NOT NULL,\n                \n                \"_createdAt\" TIMESTAMP(3) DEFAULT NULL,\n                \"_updatedAt\" TIMESTAMP(3) DEFAULT NULL,\n                \n                _permissions JSONB DEFAULT NULL\n            );\n        \n\t\t\t\tCREATE UNIQUE INDEX \"ns_docs_uid\" ON \"${ns}\".\"ns_docs\" (\"_uid\" COLLATE utf8_ci_ai);\n            \tCREATE INDEX \"ns_docs_created\" ON \"${ns}\".\"ns_docs\" (\"_createdAt\");\n            \tCREATE INDEX \"ns_docs_updated\" ON \"${ns}\".\"ns_docs\" (\"_updatedAt\");\n            \tCREATE INDEX \"ns_docs_permissions\" ON \"${ns}\".\"ns_docs\" USING gin (_permissions);\n\t\t\t"
            ],
            [
              "*",
              "\n            CREATE TABLE \"${ns}\".\"ns_docs_perms\" (\n                _id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n                _tenant INTEGER DEFAULT NULL,\n                _type VARCHAR(12) NOT NULL,\n                _permission VARCHAR(255) NOT NULL,\n                _document VARCHAR(255) NOT NULL\n            );\n        \n                CREATE UNIQUE INDEX \"ns_docs_ukey\" \n                    ON \"${ns}\".\"ns_docs_perms\" USING btree (_document COLLATE utf8_ci_ai,_type,_permission);\n                CREATE INDEX \"ns_docs_permission\" \n                    ON \"${ns}\".\"ns_docs_perms\" USING btree (_permission,_type); \n            "
            ],
            [
              "*",
              "\n\t\t    SELECT \"main\".*\n            FROM \"${ns}\".\"ns_docs\" AS \"main\"\n            WHERE \"main\".\"_uid\" = :_uid \n            \n\t\t "
            ],
            [
              "*",
              "\n\t\t    SELECT \"main\".*\n            FROM \"${ns}\".\"ns_docs\" AS \"main\"\n            WHERE \"main\".\"_uid\" = :_uid \n            \n\t\t "
            ]
          ]
        },
        {
          "op": "adapter.delete",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        }
      ]
    },
    {
