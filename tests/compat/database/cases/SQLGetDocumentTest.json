        {
          "op": "adapter.set_timeout",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "milliseconds": 100
          },
          "expect": null
        },
        {
          "op": "adapter.get_document",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "collection": "docs",
            "id": "document"
          },
          "expect": {
