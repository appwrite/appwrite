              "\n            CREATE TABLE \"${ns}\".\"ns_docs\" (\n                _id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n                _uid VARCHAR(255) NOT NULL,\n                \n                \"_createdAt\" TIMESTAMP(3) DEFAULT NULL,\n                \"_updatedAt\" TIMESTAMP(3) DEFAULT NULL,\n                \n                _permissions JSONB DEFAULT NULL\n            );\n        \n\t\t\t\tCREATE UNIQUE INDEX \"ns_docs_uid\" ON \"${ns}\".\"ns_docs\" (\"_uid\" COLLATE utf8_ci_ai);\n            \tCREATE INDEX \"ns_docs_created\" ON \"${ns}\".\"ns_docs\" (\"_createdAt\");\n            \tCREATE INDEX \"ns_docs_updated\" ON \"${ns}\".\"ns_docs\" (\"_updatedAt\");\n            \tCREATE INDEX \"ns_docs_permissions\" ON \"${ns}\".\"ns_docs\" USING gin (_permissions);\n\t\t\t"
