            "sql": "SHOW statement_timeout"
          },
          "expect": [
            {
              "statement_timeout": "25ms"
            }
          ]
        },
        {
          "op": "adapter.commit_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
