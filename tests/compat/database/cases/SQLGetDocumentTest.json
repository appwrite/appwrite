            ],
            [
              "*",
              "\n\t\t    SELECT \"main\".*\n            FROM \"${ns}\".\"ns_docs\" AS \"main\"\n            WHERE \"main\".\"_uid\" = :_uid \n            \n\t\t "
            ],
            [
              "*",
              "\n\t\t    SELECT \"main\".*\n            FROM \"${ns}\".\"ns_docs\" AS \"main\"\n            WHERE \"main\".\"_uid\" = :_uid \n            \n\t\t "
