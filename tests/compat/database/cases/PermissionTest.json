    {
      "name": "testInvalidFormats",
      "steps": [
        {
          "op": "permission.parse",
          "args": {
            "permission": "read"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Invalid permission string format: \"read\"."
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read((\"any\")"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Invalid permission type: \"read(\"."
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"users/un/verified\")"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Only one dimension can be provided"
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"users/\")"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Dimension must not be empty"
            }
          }
        }
      ]
    },
    {
      "name": "testAggregation",
      "steps": [
        {
          "op": "permission.aggregate",
          "args": {
            "permissions": [
              "write(\"any\")"
            ]
          },
          "expect": [
            "create(\"any\")",
            "update(\"any\")",
            "delete(\"any\")"
          ]
        },
        {
          "op": "permission.aggregate",
          "args": {
            "permissions": [
              "write(\"any\")"
            ],
            "allowed": [
              "update",
              "delete"
            ]
          },
          "expect": [
            "update(\"any\")",
            "delete(\"any\")"
          ]
        },
        {
          "op": "permission.aggregate",
          "args": {
            "permissions": [
              "read(\"any\")",
              "read(\"user:123\")",
              "read(\"user:123\")",
              "write(\"user:123\")",
              "update(\"user:123\")",
              "delete(\"user:123\")"
            ],
            "allowed": [
              "create",
              "read",
              "update",
              "delete"
            ]
          },
          "expect": [
            "read(\"any\")",
            "read(\"user:123\")",
            "create(\"user:123\")",
            "update(\"user:123\")",
            "delete(\"user:123\")"
          ]
        }
      ]
    },
    {
      "name": "edge: parse write and odd strings",
      "steps": [
        {
          "op": "permission.parse",
          "args": {
            "permission": "write(\"any\")"
          },
          "expect": {
            "permission": "write",
            "role": "any",
            "identifier": "",
            "dimension": "",
            "string": "write(\"any\")"
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "write(\"team:1/owner\")"
          },
          "expect": {
            "permission": "write",
            "role": "team",
            "identifier": "1",
            "dimension": "owner",
            "string": "write(\"team:1/owner\")"
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "Read(\"any\")"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Invalid permission type: \"Read\"."
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "(\"any\")"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Invalid permission type: \"\"."
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": ""
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Invalid permission string format: \"\"."
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"\")"
          },
          "expect": {
            "permission": "read",
            "role": "",
            "identifier": "",
            "dimension": "",
            "string": "read(\"\")"
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"any\")x"
          },
          "expect": {
            "permission": "read",
            "role": "anyx",
            "identifier": "",
            "dimension": "",
            "string": "read(\"anyx\")"
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"any"
          },
          "expect": {
            "permission": "read",
            "role": "any",
            "identifier": "",
            "dimension": "",
            "string": "read(\"any\")"
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"a(\"b\")"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Invalid permission string format: \"read(\"a(\"b\")\"."
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"user:1:2\")"
          },
          "expect": {
            "permission": "read",
            "role": "user",
            "identifier": "1",
            "dimension": "",
            "string": "read(\"user:1\")"
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"team:1/2/3\")"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Only one dimension can be provided"
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"team:a/b:c\")"
          },
          "expect": {
            "permission": "read",
            "role": "team",
            "identifier": "a",
            "dimension": "b",
            "string": "read(\"team:a/b\")"
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(any)"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Invalid permission string format: \"read(any)\"."
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": " read(\"any\")"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Invalid permission type: \" read\"."
            }
          }
        },
        {
          "op": "permission.parse",
          "args": {
            "permission": "read(\"any\") "
          },
          "expect": {
            "permission": "read",
            "role": "any ",
            "identifier": "",
            "dimension": "",
            "string": "read(\"any \")"
          }
        },
        {
