  "cases": [
    {
      "name": "AdapterDatabaseRenameTest::testSharedTablesRefuseTheRename#MariaDB",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Adapter\\MariaDB",
            "args": {
              "pdo": {}
            },
            "as": "o1"
          },
          "bind": "s0",
          "expect": {
            "$adapter": "MariaDB"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1"
            },
            "method": "setSharedTables",
            "args": {
              "sharedTables": true
            }
          },
          "expect": {
            "$adapter": "MariaDB"
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1"
            },
            "method": "update",
            "args": {
              "name": "library",
              "new": "archive"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Cannot rename a database while shared tables are enabled"
            }
          }
        }
      ]
    },
