{
  "source": [
    "vendor/utopia-php/database/tests/unit/ObjectFilterTest.php"
  ],
  "cases": [
    {
      "name": "ObjectFilterTest::testObjectFilterPreservesEmptyObjectsAndArrays",
      "state": [],
      "steps": [
        {
          "op": "object.new",
          "args": {
            "class": "Adapter\\Memory",
            "args": {},
            "as": "o98"
          },
          "bind": "s193",
          "expect": {
            "$adapter": "Memory"
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Database",
            "args": {
              "adapter": {
                "$obj": "o98"
              },
              "cache": "none"
            },
            "as": "o99"
          },
          "bind": "s194",
          "expect": {
            "$database": true
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "$id": "meta",
                "type": "object",
                "array": false,
                "filters": [
                  "object"
                ]
              }
            },
            "as": "o100"
          },
          "bind": "s195",
          "expect": {
            "$document": {
              "$id": "meta",
              "type": "object",
              "array": false,
              "filters": [
                "object"
              ]
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "attributes": [
                  {
                    "$obj": "o100"
                  }
                ]
              }
            },
            "as": "o101"
          },
          "bind": "s196",
          "expect": {
            "$document": {
              "attributes": [
                {
                  "$document": {
                    "$id": "meta",
                    "type": "object",
                    "array": false,
                    "filters": [
                      "object"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "op": "object.new",
          "args": {
            "class": "Document",
            "args": {
              "input": {
                "meta": {
                  "emptyObject": {},
                  "emptyArray": [],
                  "nested": [
                    {},
                    {
                      "value": 1
                    }
                  ]
                }
              }
            },
            "as": "o102"
          },
          "bind": "s197",
          "expect": {
            "$document": {
              "meta": {
                "emptyObject": {},
                "emptyArray": [],
                "nested": [
                  {},
                  {
                    "value": 1
                  }
                ]
              }
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o99"
            },
            "method": "encode",
            "args": {
              "collection": {
                "$obj": "o101"
              },
              "document": {
                "$obj": "o102"
              }
            }
          },
          "expect": {
            "$document": {
              "meta": "{\"emptyObject\":{},\"emptyArray\":[],\"nested\":[{},{\"value\":1}]}"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o102"
            },
            "method": "getAttribute",
            "args": {
              "name": "meta"
            }
          },
          "expect": "{\"emptyObject\":{},\"emptyArray\":[],\"nested\":[{},{\"value\":1}]}"
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o99"
            },
            "method": "decode",
            "args": {
              "collection": {
                "$obj": "o101"
              },
              "document": {
                "$obj": "o102"
              }
            }
          },
          "expect": {
            "$document": {
              "meta": {
                "emptyObject": {},
                "emptyArray": [],
                "nested": [
                  {},
                  {
                    "value": 1
                  }
                ]
              },
              "$id": null,
              "$sequence": null,
              "$collection": null,
              "$createdAt": null,
              "$updatedAt": null
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o102"
            },
            "method": "getAttribute",
            "args": {
              "name": "meta"
            }
          },
          "expect": {
            "emptyObject": {},
            "emptyArray": [],
            "nested": [
              {},
              {
                "value": 1
              }
            ]
          }
        }
      ]
    },
