  "cases": [
    {
      "name": "testBaseKeysMatchScopedVariantKeys",
      "steps": [
        {
          "op": "db.open",
          "args": {
            "create": false,
            "database": "cache_key_test",
            "shared_tables": true,
            "tenant": 42
          },
          "bind": "db",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "database.set_global_collections",
          "args": {
            "collections": [
              "global"
            ]
          },
          "expect": {
            "$database": true
          }
        },
        {
          "op": "database.get_cache_keys",
          "args": {
            "collectionId": "col",
            "documentId": "doc",
            "selects": [
              "name"
            ]
          },
          "expect": [
            "default-cache-compat-database-postgres:compat:42:collection:col",
            "default-cache-compat-database-postgres:compat:42:collection:col:doc",
            "default-cache-compat-database-postgres:compat:42:collection:col:doc:d6cf83f99c53f41e0be272792ad58cc8"
          ]
        },
        {
          "op": "database.get_cache_base_keys",
          "args": {
            "collectionId": "col",
            "documentId": "doc"
          },
          "expect": [
            "default-cache-compat-database-postgres:compat:42:collection:col",
            "default-cache-compat-database-postgres:compat:42:collection:col:doc"
          ]
        },
        {
          "op": "database.get_cache_keys",
          "args": {
            "collectionId": "_metadata",
            "documentId": "col",
            "selects": [
              "name"
            ]
          },
          "expect": [
            "default-cache-compat-database-postgres:compat:42:collection:_metadata",
            "default-cache-compat-database-postgres:compat:42:collection:_metadata:col",
            "default-cache-compat-database-postgres:compat:42:collection:_metadata:col:d6cf83f99c53f41e0be272792ad58cc8"
          ]
        },
        {
          "op": "database.get_cache_base_keys",
          "args": {
            "collectionId": "_metadata",
            "documentId": "col"
          },
          "expect": [
            "default-cache-compat-database-postgres:compat:42:collection:_metadata",
            "default-cache-compat-database-postgres:compat:42:collection:_metadata:col"
          ]
        },
        {
          "op": "database.get_cache_keys",
          "args": {
            "collectionId": "_metadata",
            "documentId": "global",
            "selects": [
              "name"
            ]
          },
          "expect": [
            "default-cache-compat-database-postgres:compat::collection:_metadata",
            "default-cache-compat-database-postgres:compat::collection:_metadata:global",
            "default-cache-compat-database-postgres:compat::collection:_metadata:global:d6cf83f99c53f41e0be272792ad58cc8"
          ]
        },
        {
          "op": "database.get_cache_base_keys",
          "args": {
            "collectionId": "_metadata",
            "documentId": "global"
          },
          "expect": [
            "default-cache-compat-database-postgres:compat::collection:_metadata",
            "default-cache-compat-database-postgres:compat::collection:_metadata:global"
          ]
        }
      ]
    },
