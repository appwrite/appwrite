{
  "source": "vendor/utopia-php/database/tests/unit/Validator/Query/LimitTest.php",
  "cases": [
    {
      "name": "testValueSuccess",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "query_limit",
            "maxLimit": 100
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "$query": {
                "method": "limit",
                "attribute": "",
                "values": [
                  1
                ]
              }
            }
          },
          "expect": {
            "valid": true,
            "description": "Invalid query"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "$query": {
                "method": "limit",
                "attribute": "",
                "values": [
                  100
                ]
              }
            }
          },
          "expect": {
            "valid": true,
            "description": "Invalid query"
          }
        }
      ]
    },
