{
  "source": "vendor/utopia-php/database/tests/unit/SQLTransactionTest.php",
  "cases": [
    {
      "name": "testPostgresStartTransactionRecoversFromDesyncedRollback",
      "steps": [
        {
          "op": "adapter.open",
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.before",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "event": "*",
            "name": "capture"
          },
          "expect": null
        },
        {
          "op": "adapter.create",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.driver_exec",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "BEGIN"
          },
          "expect": 0
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.driver_query",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "SELECT now() = statement_timestamp() AS fresh"
          },
          "expect": [
            {
              "fresh": "0"
            }
          ]
        },
        {
          "op": "adapter.commit_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "adapter.captured",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            [
              "*",
              "CREATE SCHEMA \"${ns}\""
            ]
          ]
        },
        {
          "op": "adapter.delete",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        }
      ]
    },
    {
      "name": "testStartTransactionRecoversFromDesyncedRollback (phase 2: MySQL adapter; PostgreSQL without a held transaction)",
      "steps": [
        {
          "op": "adapter.open",
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.before",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "event": "*",
            "name": "capture"
          },
          "expect": null
        },
        {
          "op": "adapter.create",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.rollback_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "adapter.captured",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            [
              "*",
              "CREATE SCHEMA \"${ns}\""
            ]
          ]
        },
        {
          "op": "adapter.delete",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        }
      ]
    },
    {
      "name": "testStartTransactionDoesNotMaskBeginFailureAfterDesyncedRollback (phase 2: MySQL adapter; PostgreSQL's failed BEGIN)",
      "steps": [
        {
          "op": "adapter.open",
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.before",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "event": "*",
            "name": "capture"
          },
          "expect": null
        },
        {
          "op": "adapter.create",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.driver_query",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "SELECT 1/0"
          },
          "expect": {
            "$error": {
              "class": "PDOException",
              "message": "SQLSTATE[22012]: Division by zero: 7 ERROR:  division by zero"
            }
          }
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\Transaction",
              "message": "Failed to start transaction: SQLSTATE[25P02]: In failed sql transaction: 7 ERROR:  current transaction is aborted, commands ignored until end of transaction block"
            }
          }
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.rollback_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.commit_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.captured",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            [
              "*",
              "CREATE SCHEMA \"${ns}\""
            ]
          ]
        },
        {
          "op": "adapter.delete",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        }
      ]
    }
  ]
}
