{
  "source": "vendor/utopia-php/database/tests/unit/SQLTransactionTest.php",
  "cases": [
    {
      "name": "testPostgresStartTransactionRecoversFromDesyncedRollback",
      "steps": [
        {
          "op": "adapter.open",
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.before",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "event": "*",
            "name": "capture"
          },
          "expect": null
        },
        {
          "op": "adapter.create",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.driver_exec",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "BEGIN"
          },
          "expect": 0
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.driver_query",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "SELECT now() = statement_timestamp() AS fresh"
          },
          "expect": [
            {
              "fresh": "0"
            }
          ]
        },
        {
          "op": "adapter.commit_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "adapter.captured",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
            [
              "*",
              "CREATE SCHEMA \"${ns}\""
            ]
          ]
        },
        {
          "op": "adapter.delete",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        }
      ]
    },
