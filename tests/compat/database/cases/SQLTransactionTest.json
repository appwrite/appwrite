          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "adapter.captured",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": [
