    {
      "name": "testStartTransactionDoesNotMaskBeginFailureAfterDesyncedRollback (MariaDB: savepoints and errors after an implicit commit)",
      "state": [
        "mysql@database-mariadb"
      ],
      "steps": [
        {
          "op": "adapter.open",
          "args": {
            "driver": "mariadb"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.create",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.driver_exec",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "CREATE TABLE `${ns}`.`t` (x INT)"
          },
          "expect": 0
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.rollback_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception",
              "message": "Failed to rollback transaction: SQLSTATE[42000]: Syntax error or access violation: 1305 SAVEPOINT transaction1 does not exist"
            }
          }
        },
        {
          "op": "adapter.rollback_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "adapter.start_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.driver_query",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "sql": "SELECT nope FROM `${ns}`.`t`"
          },
          "expect": {
            "$error": {
              "class": "PDOException",
              "message": "SQLSTATE[42S22]: Column not found: 1054 Unknown column 'nope' in 'SELECT'"
            }
          }
        },
        {
          "op": "adapter.in_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.commit_transaction",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.delete",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": true
        }
      ]
    },
