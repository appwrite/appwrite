    {
      "name": "testVectorDescription",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "vector",
            "size": 3
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "a"
            }
          },
          "expect": "Value must be an array of 3 numeric values"
        },
        {
          "op": "validator.new",
          "args": {
            "validator": "vector",
            "size": 256
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "b"
            }
          },
          "expect": "Value must be an array of 256 numeric values"
        }
      ]
    },
    {
      "name": "testVectorType",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "vector",
            "size": 3
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.meta",
          "args": {
            "validator": {
              "$ref": "a"
            }
          },
          "expect": {
            "type": "array",
            "is_array": false
          }
        }
      ]
    },
    {
      "name": "edge: json strings and odd values",
      "steps": [
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": "[1,2,3]"
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": "[1.5,2,3]"
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": "[\"1\",2,3]"
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": "[1,2]"
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": "{\"0\":1,\"1\":2,\"2\":3}"
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": ""
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": "null"
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": "[1,2,3"
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": null
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": 3
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": 1.5
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": {
              "0": 1,
              "1": 2,
              "2": 3
            }
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": {
              "1": 1,
              "0": 2,
              "2": 3
            }
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": [
              [
                1
              ],
              2,
              3
            ]
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 3,
            "value": [
              1e+308,
              -1e+308,
              0.0
            ]
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 3 numeric values"
          }
        }
      ]
    },
    {
      "name": "edge: zero and negative sizes",
      "steps": [
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 0,
            "value": []
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 0 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 0,
            "value": "[]"
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 0 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": 0,
            "value": [
              1
            ]
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 0 numeric values"
          }
        },
        {
          "op": "validator.check",
          "args": {
            "validator": "vector",
            "size": -1,
            "value": []
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of -1 numeric values"
          }
        },
        {
          "op": "validator.new",
          "args": {
            "validator": "vector",
            "size": -1
          },
          "bind": "n",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "n"
            }
          },
          "expect": "Value must be an array of -1 numeric values"
        }
      ]
    }
  ]
}
