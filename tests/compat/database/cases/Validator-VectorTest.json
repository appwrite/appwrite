{
  "source": "vendor/utopia-php/database/tests/unit/Validator/VectorTest.php",
  "cases": [
    {
      "name": "testVector",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "vector",
            "size": 3
          },
          "bind": "v",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              1.0,
              2.0,
              3.0
            ]
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              0,
              0,
              0
            ]
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              -1.5,
              0.0,
              2.5
            ]
          },
          "expect": {
            "valid": true,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              1.0,
              2.0
            ]
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              1.0,
              2.0,
              3.0,
              4.0
            ]
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": "not an array"
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              "1",
              "2",
              "3"
            ]
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              1.0,
              "not numeric",
              3.0
            ]
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              1.0,
              null,
              3.0
            ]
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": []
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "x": 1.0,
              "y": 2.0,
              "z": 3.0
            }
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              1.0,
              true,
              3.0
            ]
          },
          "expect": {
            "valid": false,
            "description": "Value must be an array of 3 numeric values"
          }
        }
      ]
    },
