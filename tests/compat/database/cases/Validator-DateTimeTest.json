{
  "source": "vendor/utopia-php/database/tests/unit/Validator/DateTimeTest.php",
  "cases": [
    {
      "name": "testCreateDatetime",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "datetime",
            "min": "0000-01-01 00:00:00",
            "max": "9999-12-31 23:59:59"
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "2022-12-04"
          },
          "expect": {
            "valid": true,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "2022-1-4 11:31"
          },
          "expect": {
            "valid": true,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "2022-12-04 11:31:52"
          },
          "expect": {
            "valid": true,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "2022-1-4 11:31:52.123456789"
          },
          "expect": {
            "valid": true,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "d"
            }
          },
          "expect": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "2022-07-02 18:31:52.680"
          },
          "expect": {
            "valid": true,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "2022-12-04 11:31:52.680+02:00"
          },
          "expect": {
            "valid": true,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "2022-13-04 11:31:52.680"
          },
          "expect": {
            "valid": false,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "-0001-13-04 00:00:00"
          },
          "expect": {
            "valid": false,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "0000-00-00 00:00:00"
          },
          "expect": {
            "valid": false,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "d"
            },
            "value": "10000-01-01 00:00:00"
          },
          "expect": {
            "valid": false,
            "description": "Value must be valid date between 0000-01-01 00:00:00 and 9999-12-31 23:59:59."
          }
        }
      ]
    },
    {
