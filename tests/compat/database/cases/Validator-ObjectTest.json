{
  "source": "vendor/utopia-php/database/tests/unit/Validator/ObjectTest.php",
  "cases": [
    {
      "name": "testValidAssociativeObjects",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "object"
          },
          "bind": "v"
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "key": "value"
            }
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "a": {
                "b": {
                  "c": 123
                }
              }
            }
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "author": "Arnab",
              "metadata": {
                "rating": 4.5,
                "info": {
                  "category": "science"
                }
              }
            }
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "key1": null,
              "key2": {
                "nested": null
              }
            }
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "meta": {
                "$object": {
                  "x": 1
                }
              }
            }
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {
              "a": 1,
              "2": "b"
            }
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "v"
            }
          }
        }
      ]
    },
    {
      "name": "testInvalidStructures",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "object"
          },
          "bind": "v"
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              "a",
              "b",
              "c"
            ]
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": "not an array"
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": [
              "value"
            ]
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "v"
            }
          }
        }
      ]
    },
    {
      "name": "testEmptyCases",
      "steps": [
        {
          "op": "validator.new",
          "args": {
            "validator": "object"
          },
          "bind": "v"
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": []
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": {}
          }
        },
        {
          "op": "validator.is_valid",
          "args": {
            "validator": {
              "$ref": "v"
            },
            "value": "sldfjsdlfj"
          }
        },
        {
          "op": "validator.description",
          "args": {
            "validator": {
              "$ref": "v"
            }
          }
        }
      ]
    },
    {
