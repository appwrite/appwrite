    {
      "name": "QuerySerializationTest::testParseRejectsANestedQueryWhoseValuesAreNotAList#and with a string",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "parse",
            "args": {
              "query": "{\"method\":\"and\",\"values\":\"x\"}"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Database\\Exception\\Query",
              "message": "Invalid query values. Must be an array, got string"
            }
          }
        }
      ]
    },
