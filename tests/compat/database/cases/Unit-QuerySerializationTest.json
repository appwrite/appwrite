            },
            "as": "o1223"
          },
          "bind": "s5088",
          "expect": {
            "$query": {
              "method": "leftJoin",
              "attribute": "orders",
              "values": [
                {
                  "$query": {
                    "method": "on",
                    "attribute": "",
                    "values": [
                      "$id",
                      "=",
                      "ord.user"
                    ]
                  }
                },
                {
                  "$query": {
                    "method": "equal",
                    "attribute": "ord.status",
                    "values": [
                      "paid"
                    ]
                  }
                }
              ],
              "alias": "ord"
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1223"
            },
            "method": "toArray",
            "args": {}
          },
          "expect": {
            "method": "leftJoin",
            "attribute": "orders",
            "alias": "ord",
