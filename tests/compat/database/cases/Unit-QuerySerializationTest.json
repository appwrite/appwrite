    {
      "name": "QuerySerializationTest::testParseDecodesStringChildrenOfANestedQuery",
      "state": [],
      "steps": [
        {
          "op": "object.call",
          "args": {
            "class": "Query",
            "method": "parse",
            "args": {
              "query": "{\"method\":\"and\",\"values\":[\"{\\\"method\\\":\\\"equal\\\",\\\"attribute\\\":\\\"a\\\",\\\"values\\\":[1]}\",{\"method\":\"equal\",\"attribute\":\"b\",\"values\":[2]}]}"
            },
            "as": "o1212"
          },
          "bind": "s5070",
          "expect": {
            "$query": {
              "method": "and",
              "attribute": "",
              "values": [
                {
                  "$query": {
                    "method": "equal",
                    "attribute": "a",
                    "values": [
                      1
                    ]
                  }
                },
                {
                  "$query": {
                    "method": "equal",
                    "attribute": "b",
                    "values": [
                      2
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$obj": "o1212"
            },
            "method": "getValues",
            "args": {}
          },
          "expect": [
            {
              "$query": {
                "method": "equal",
                "attribute": "a",
                "values": [
                  1
                ]
              }
            },
            {
              "$query": {
                "method": "equal",
                "attribute": "b",
                "values": [
                  2
                ]
              }
            }
          ]
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$query": {
                "method": "equal",
                "attribute": "a",
                "values": [
                  1
                ]
              }
            },
            "method": "getAttribute",
            "args": {}
          },
          "expect": "a"
        },
        {
          "op": "object.call",
          "args": {
            "this": {
              "$query": {
                "method": "equal",
                "attribute": "b",
                "values": [
                  2
                ]
              }
            },
            "method": "getAttribute",
            "args": {}
          },
          "expect": "b"
        }
      ]
    },
