          "args": {
            "tenant": 1
          },
          "expect": {
            "$database": true
          }
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRange"
          },
          "expect": true
        },
        {
          "op": "db.add_format",
          "args": {
            "name": "priceRangeNew"
          },
          "expect": true
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "encrypt"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "subQueryProbe"
          },
          "expect": null
        },
        {
          "op": "database.add_filter",
          "args": {
            "name": "operator_double_decode"
          },
          "expect": null
        },
        {
          "op": "db.adapter",
          "args": {
