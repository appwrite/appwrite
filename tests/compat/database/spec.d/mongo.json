    "mongo.fuzz_find": {
      "doc": "find() on collection `fz` of the session's MongoDB fuzz adapter (database ${ns} of the compat MongoDB, namespace `fz`, seeded as adapter.fuzz_find seeds its schema): the same programs as adapter.fuzz_find",
      "services": [
        "database-mongo"
      ],
      "covers": [
        "Utopia\\Database\\Adapter\\Mongo::find"
      ],
      "fuzz": [
        {
          "name": "filter programs",
          "iterations": 1500,
          "args": {
            "gen": "object",
            "fields": {
              "queries": {
                "gen": "array",
                "items": {
                  "gen": "one_of",
                  "of": [
                    {
                      "gen": "ref",
                      "name": "adapter.query"
                    },
                    {
                      "gen": "ref",
                      "name": "adapter.query"
                    },
                    {
                      "gen": "ref",
                      "name": "adapter.logical"
                    }
                  ]
                },
                "min": 0,
                "max": 4
              },
              "order_attributes": {
                "gen": "array",
                "items": {
                  "gen": "pick",
                  "from": [
                    "title",
                    "year",
                    "rating",
                    "$sequence",
                    "$id",
                    "active",
                    "released"
                  ]
                },
                "min": 0,
                "max": 2
              },
              "order_types": {
                "gen": "array",
                "items": {
                  "gen": "pick",
                  "from": [
                    "ASC",
                    "DESC"
                  ]
                },
                "min": 0,
                "max": 2
              },
              "limit": {
                "gen": "int",
                "min": 0,
                "max": 30
              },
              "offset": {
                "gen": "int",
                "min": 0,
                "max": 6
              },
              "roles": {
                "gen": "array",
                "items": {
                  "gen": "pick",
                  "from": [
                    "any",
                    "user:1",
                    "team:x"
                  ]
                },
                "min": 0,
                "max": 2
              },
              "attribute_types": {
                "gen": "const",
                "value": {
                  "meta": "object",
                  "meta.k": "object",
                  "meta.s": "object"
                }
              },
              "arrays": {
                "gen": "const",
                "value": [
                  "tags"
                ]
              }
            },
            "optional": [
              "order_attributes",
              "order_types",
              "limit",
              "offset",
              "roles"
            ]
          }
        }
      ]
    },
    "mongo.fuzz_roundtrip": {
      "doc": "createDocument() of `value` into collection `rt` of the session's MongoDB fuzz adapter, then getDocument(), find(equal t value) and deleteDocument(), as adapter.fuzz_roundtrip: each result or {error} (UTF-8 strings: BSON holds no other, see the deviation on Mongo::createDocument)",
      "services": [
        "database-mongo"
      ],
      "covers": [
        "Utopia\\Database\\Adapter\\Mongo::createDocument",
        "Utopia\\Database\\Adapter\\Mongo::getDocument"
      ],
      "fuzz": [
        {
          "name": "string literals",
          "iterations": 2500,
          "args": {
            "gen": "object",
            "fields": {
              "value": {
                "gen": "ref",
                "name": "mongo.literal"
              }
            }
          }
        }
      ]
    }
  },
  "generators": {
    "mongo.literal": {
      "gen": "one_of",
      "of": [
        {
          "gen": "string",
          "max": 40,
          "tricky": 0.5
        },
        {
          "gen": "string",
          "max": 20,
          "alphabet": "unicode"
        },
        {
          "gen": "string",
          "max": 20,
          "alphabet": "'\\\"%_:?$-/*\n\t\u0000é"
        }
      ]
    }
  },
  "scrub": [
    {
      "kind": "uuid7",
      "reason": "MongoDB documents get a UUIDv7 _id ($sequence) made from the clock and random bits"
    }
  ],
  "deviations": [
    {
      "symbol": "Utopia\\Database\\Adapter\\Mongo::list",
      "php": "Returns the values of the listDatabases reply as they decode: the list of databases (stdClass objects), totalSize, ok, $clusterTime and operationTime.",
      "reason": "Adapter::list returns documents in Rust (one per value, as the other adapters' lists are documents); Mongo::database_list returns the reply's values as PHP does. The cases mask the listing, which names every database on the shared server."
    },
    {
      "symbol": "Utopia\\Database\\Database::iterate",
      "php": "On MongoDB, the adapter casts the cursor of the next page in place, so the last document of each page already yielded holds MongoDB\\BSON\\UTCDateTime objects in $createdAt and $updatedAt (the cursor is the same Document object).",
      "reason": "Rust documents are values: the cursor is cast on a copy, and the yielded documents keep their datetime strings. The cases mask those two attributes of an iteration on MongoDB."
    },
    {
      "symbol": "Utopia\\Database\\Adapter\\Mongo::createDocument",
      "php": "A string that is not valid UTF-8 reaches PHP's MongoDB extension, which refuses to encode the command: MongoDB\\Driver\\Exception\\UnexpectedValueException \"Detected invalid UTF-8 for field path \\\"documents.0.<field>\\\": <the raw bytes>\" (the last such field of the command).",
      "reason": "BSON strings are UTF-8 and Rust messages are text: the adapter refuses the value while converting it, with Utopia\\Database\\Exception \"Detected invalid UTF-8 for field path\" and the bytes decoded lossily. The fuzz profiles of the MongoDB adapter generate UTF-8 strings."
    }
  ]
}
