    {
      "symbol": "Utopia\\Database\\Query::isMethod",
      "description": "isMethod() lists every TYPE_* but TYPE_REGEX, so Query::parse() rejects the regex query Query::regex() builds (\"Invalid query method: regex\").",
      "case": "values-Query.json#regex is not a parseable method"
    },
    {
      "symbol": "Utopia\\Database\\Query::groupByType",
      "description": "A missing or null offset or cursor value falls back to the limit found so far ($values[0] ?? $limit), and a limit, offset or cursor whose value is null does not count as found.",
      "case": "values-Query.json#groupByType falls back to the limit"
    },
    {
      "symbol": "Utopia\\Database\\Query::toArray",
      "description": "A logical query whose values are not queries throws PHP Error (Call to a member function toArray() on int); an Operator child gives its own array.",
      "case": "values-Query.json#logical values that are not queries"
    },
    {
      "symbol": "Utopia\\Database\\Query::toArray",
      "description": "An attribute \"0\" is empty() to PHP, so toArray() leaves it out (and groupByType() ignores it as an order attribute).",
      "case": "values-Query.json#attribute 0 is empty"
    }
  ],
  "deviations": [
    {
      "symbol": "Utopia\\Database\\Query::parseQuery",
      "php": "A method or attribute that is not valid UTF-8 is kept byte for byte (and quoted raw in \"Invalid query method: ...\" errors).",
      "reason": "Rust methods and attributes are text (str): such bytes are replaced with U+FFFD. JSON input (Query::parse) is always UTF-8; attributes are identifiers the validators restrict to ASCII."
    },
    {
      "symbol": "Utopia\\Database\\Query::equal",
      "php": "The array parameters of the static constructors (equal, contains, select, distance*, ...) keep the keys of a keyed array.",
      "reason": "The Rust constructors take an iterable of values (a list); a query with keyed values is built with Query::from_array."
    },
    {
      "symbol": "Utopia\\Database\\Query::parseQueries",
      "php": "An element that is not a string is coerced (int) or throws TypeError.",
      "reason": "Rust takes a slice of strings."
    },
    {
      "symbol": "Utopia\\Database\\Operator::increment",
      "php": "int|float parameters coerce numeric strings (non-strict mode) or throw TypeError.",
      "reason": "Rust takes a Number (Int or Float)."
    }
  ]
