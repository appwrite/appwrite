    "adapter.fuzz_roundtrip": {
      "doc": "createDocument() of `value` (in a TEXT column, a string array and an object) into collection `rt` of the session's fuzz adapter, then getDocument(), find(equal t value) and deleteDocument(): each result or {error}; `driver` (postgres, mariadb or mysql) picks the adapter; `engine` \"sqlite\": the same on SQLite (file /tmp/compat-fs/${ns}/fuzz.sqlite, no object attributes)",
      "covers": [
        "Utopia\\Database\\Adapter\\Postgres::createDocument",
        "Utopia\\Database\\Adapter\\SQL::getDocument"
      ],
      "services": [
        "database-postgres",
        "database-mariadb",
        "database-mysql"
      ],
      "services_unless": [
        {
          "engine": [
            "sqlite"
          ]
        }
      ],
      "fuzz": [
        {
          "name": "string literals",
          "iterations": 2500,
          "args": {
            "gen": "object",
            "fields": {
              "value": {
                "gen": "ref",
                "name": "adapter.literal"
              }
            }
          }
        },
        {
          "name": "SQLite: string literals",
          "iterations": 2500,
          "args": {
            "gen": "object",
            "fields": {
              "value": {
                "gen": "ref",
                "name": "adapter.literal"
              },
              "engine": {
                "gen": "const",
                "value": "sqlite"
              }
            }
          }
        },
        {
          "name": "string literals (MariaDB)",
          "iterations": 800,
          "args": {
            "gen": "object",
            "fields": {
              "value": {
                "gen": "ref",
                "name": "adapter.literal"
              },
              "driver": {
                "gen": "const",
                "value": "mariadb"
              }
            }
          }
        },
        {
          "name": "string literals (MySQL)",
          "iterations": 800,
          "args": {
            "gen": "object",
            "fields": {
              "value": {
                "gen": "ref",
                "name": "adapter.literal"
              },
              "driver": {
                "gen": "const",
                "value": "mysql"
              }
            }
          }
        }
      ]
    }
