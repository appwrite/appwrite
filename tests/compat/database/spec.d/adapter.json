    "adapter.fuzz_find": {
      "doc": "find() on collection `fz` of the session's fuzz adapter (schema ${ns}, namespace `fz`, 24 seeded documents, created on first use as in ops/adapter.php): queries typed as the Database types them (meta object, tags array), roles (authorization off without), order, limit, offset",
      "covers": [
        "Utopia\\Database\\Adapter\\SQL::find"
      ],
      "services": [
        "database-postgres"
      ],
      "fuzz": [
        {
          "name": "filter programs",
          "iterations": 1500,
          "args": {
            "gen": "object",
            "fields": {
              "queries": {
                "gen": "array",
                "items": {
                  "gen": "one_of",
                  "of": [
                    {
                      "gen": "ref",
                      "name": "adapter.query"
                    },
                    {
                      "gen": "ref",
                      "name": "adapter.query"
                    },
                    {
                      "gen": "ref",
                      "name": "adapter.logical"
                    }
                  ]
                },
                "min": 0,
                "max": 4
              },
              "order_attributes": {
                "gen": "array",
                "items": {
                  "gen": "pick",
                  "from": [
                    "title",
                    "year",
                    "rating",
                    "$sequence",
                    "$id",
                    "active",
                    "released"
                  ]
                },
                "min": 0,
                "max": 2
              },
              "order_types": {
                "gen": "array",
                "items": {
                  "gen": "pick",
                  "from": [
                    "ASC",
                    "DESC"
                  ]
                },
                "min": 0,
                "max": 2
              },
              "limit": {
                "gen": "int",
                "min": 0,
                "max": 30
              },
              "offset": {
                "gen": "int",
                "min": 0,
                "max": 6
              },
              "roles": {
                "gen": "array",
                "items": {
                  "gen": "pick",
                  "from": [
                    "any",
                    "user:1",
                    "team:x"
                  ]
                },
                "min": 0,
                "max": 2
              },
              "attribute_types": {
                "gen": "const",
                "value": {
                  "meta": "object",
                  "meta.k": "object",
                  "meta.s": "object"
                }
              },
              "arrays": {
                "gen": "const",
                "value": [
                  "tags"
                ]
              }
            },
            "optional": [
              "order_attributes",
              "order_types",
              "limit",
              "offset",
              "roles"
            ]
          }
        }
      ]
    },
    "adapter.fuzz_roundtrip": {
