  "generators": {
    "adapter.literal": {
      "gen": "one_of",
      "of": [
        {
          "gen": "string",
          "max": 40,
          "tricky": 0.5
        },
        {
          "gen": "string",
          "max": 20,
          "alphabet": "unicode"
        },
        {
          "gen": "string",
          "max": 20,
          "alphabet": "'\\\"%_:?$-/*\n\t\u0000é"
        },
        {
          "gen": "bytes",
          "max": 12
        }
      ]
    },
    "adapter.logical": {
      "gen": "object",
      "fields": {
        "$query": {
          "gen": "object",
          "fields": {
            "method": {
              "gen": "pick",
              "from": [
                "and",
                "or"
              ]
            },
            "attribute": {
              "gen": "const",
              "value": ""
            },
            "values": {
              "gen": "array",
              "items": {
                "gen": "ref",
                "name": "adapter.query"
              },
              "min": 0,
              "max": 3
            }
          }
        }
      }
    },
    "adapter.query": {
      "gen": "object",
      "fields": {
        "$query": {
          "gen": "object",
          "fields": {
            "method": {
              "gen": "pick",
              "from": [
                "equal",
                "notEqual",
                "lessThan",
                "lessThanEqual",
                "greaterThan",
                "greaterThanEqual",
                "contains",
                "containsAny",
                "containsAll",
                "notContains",
                "search",
                "notSearch",
                "isNull",
                "isNotNull",
                "between",
                "notBetween",
                "startsWith",
                "notStartsWith",
                "endsWith",
                "notEndsWith",
                "regex",
                "select",
                "exists"
              ]
            },
            "attribute": {
              "gen": "pick",
              "from": [
                "title",
                "year",
                "rating",
                "active",
                "tags",
                "meta",
                "released",
                "$id",
                "$sequence",
                "$createdAt",
                "$updatedAt",
                "missing",
                "meta.k",
                "meta.s"
              ]
            },
            "values": {
              "gen": "array",
              "items": {
                "gen": "ref",
                "name": "adapter.qvalue"
              },
              "min": 0,
              "max": 3
            }
          }
        }
      }
    },
    "adapter.qvalue": {
      "gen": "one_of",
      "of": [
        {
          "gen": "int",
          "min": -5,
          "max": 2100
        },
        {
          "gen": "float",
          "min": -10,
          "max": 10
        },
        {
          "gen": "string",
          "max": 12,
          "tricky": 0.3
        },
        {
          "gen": "pick",
          "from": [
            "Alpha 0",
            "beta",
            "a",
            "y",
            "x",
            "%",
            "_",
            "o'b",
            "Ünïcödé",
            "2000-01-05 00:00:00",
            "1990",
            "^b.*",
            "[",
            "\"Gamma 2\"",
            true,
            false,
            null
          ]
        },
        {
          "gen": "object",
          "fields": {
            "k": {
              "gen": "int",
              "min": 0,
              "max": 5
            }
          }
        },
        {
          "gen": "object",
          "fields": {
            "s": {
              "gen": "pick",
              "from": [
                "a",
                "b",
                [
                  "a"
                ]
              ]
            }
          }
        }
      ]
    }
  },
  "waivers": {},
  "quirks": [
    {
      "symbol": "Utopia\\Database\\Adapter\\Postgres::createIndex",
      "description": "createIndex() maps a 42P07 (the index name exists) through processException() as 'Collection already exists', and a unique violation on existing rows as Unique('Unique index violation')",
      "case": "Adapter-Schema.json#indexes"
    },
    {
      "symbol": "Utopia\\Database\\Adapter\\SQL::getDocument",
      "description": "A select of `true` reads as '*' (in_array compares loosely); a null selection reaches filter(string), a TypeError naming SQL.php's line, and an array one strpos(), a TypeError",
      "case": "Adapter-Find.json#comparisons, logic and nulls"
    }
  ],
  "deviations": [
    {
      "symbol": "Utopia\\Database\\Adapter\\SQL::reconnect",
      "php": "Utopia\\Database\\PDO reconnects and retries a statement whose connection was lost outside a transaction (Swoole's DetectsLostConnections)",
      "reason": "The wrapper is PHP runtime plumbing (waived); the Rust adapter reports a lost connection ('server closed the connection unexpectedly') and reconnects only through reconnect()"
    }
  ]
}
