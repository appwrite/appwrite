  "deviations": [
    {
      "symbol": "Utopia\\Database\\Document::findAndReplace",
      "php": "Without a truthy subject attribute (the default subject '' included), PHP binds `&$this[$subject]` and assigns `$this` to it, so the document then holds itself under the subject key (created when it was missing): a cycle whose getArrayCopy() and export recurse without end.",
      "reason": "A Rust Document cannot contain itself; Document::try_find_and_replace leaves the subject attribute as it was and does everything else PHP does (including never matching when `key` is the subject). Cases only observe the document through operations that do not reach the subject key."
    },
    {
      "symbol": "Utopia\\Database\\Document::findAndRemove",
      "php": "As findAndReplace: without a truthy subject attribute the document is stored inside itself under the subject key.",
      "reason": "As findAndReplace: Rust leaves the subject attribute as it was."
    },
    {
      "symbol": "Utopia\\Database\\Document::getId",
      "php": "getId(), getCollection(), getSequence(), getCreatedAt() and getUpdatedAt() declare string (or ?string) returns: a system attribute set to another scalar after construction (setAttribute('$sequence', 5)) is coerced to a string ('5'), an array is a TypeError.",
      "reason": "Document::id/collection return &str and sequence/created_at/updated_at the stored value; the constructor requires a string $id and adapters store these attributes as strings. Cases set them as strings."
    },
    {
      "symbol": "Utopia\\Database\\Document::getTenant",
      "php": "A non-scalar $tenant fails the int|string|null return type with a TypeError.",
      "reason": "Document::tenant returns Option<Value>; a non-scalar tenant is returned as it is. Adapters store tenants as integers or numeric strings."
    },
    {
      "symbol": "Utopia\\Database\\Document::setAttribute",
      "php": "A $type other than the three SET_TYPE_* constants does nothing.",
      "reason": "The set type is the enum SetType; a type it cannot name is unrepresentable (the compat adapter faults on it)."
    },
    {
      "symbol": "Utopia\\Database\\Validator\\Authorization\\Input::__construct",
      "php": "Input takes any array of permissions: keys are kept (getRead() can return [0 => 'a', 2 => 'b'], which isValid's message json_encodes as an object) and values need not be strings.",
      "reason": "Input::permissions is a Vec<String>: a list of strings, as Database builds it from Document::read() and friends. Cases pass lists of strings."
    }
  ],
  "quirks": [
    {
      "symbol": "Utopia\\Database\\Document::getPermissionsByType",
      "description": "Roles are deduplicated with array_unique after normalisation, keeping keys: read(\"a\") and read(a) give [0 => 'a', 2 => ...], a JSON object, not a list.",
      "case": "DocumentTest.json#roles keep their keys after deduplication"
    },
    {
      "symbol": "Utopia\\Database\\Document::getWrite",
      "description": "array_intersect keeps the keys of getCreate(), so the roles granted write are often not a list.",
      "case": "DocumentTest.json#getWrite keeps the keys of getCreate"
    },
    {
      "symbol": "Utopia\\Database\\Document::getArrayCopy",
      "description": "$allow and $disallow are matched with in_array's loose ==: null matches the keys '' and 0, true every other key, '10' the key '1e1'.",
      "case": "DocumentTest.json#getArrayCopy matches keys loosely"
    },
    {
      "symbol": "Utopia\\Database\\Document::find",
      "description": "$value[$key] on a string element is a string offset: find('0', 'x', 'list') matches the string 'xyz'; on a stdClass element it throws Error.",
      "case": "DocumentTest.json#find reads string offsets"
    }
  ]
}
