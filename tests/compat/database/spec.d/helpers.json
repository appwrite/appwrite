{
  "ops": {
    "document.new": {
      "doc": "new Document($input), returned as a value (nested arrays with $id or $collection become documents)",
      "covers": [
        "Utopia\\Database\\Document::__construct"
      ],
      "fuzz": [
        {
          "name": "random",
          "args": {
            "gen": "object",
            "fields": {
              "input": {
                "gen": "ref",
                "name": "helpers_doc_input"
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "any",
          "args": {
            "gen": "object",
            "fields": {
              "input": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "array",
                    "items": {
                      "gen": "any",
                      "depth": 3
                    },
                    "max": 4
                  },
                  {
                    "gen": "object",
                    "fields": {
                      "$id": {
                        "gen": "any",
                        "depth": 1
                      },
                      "$collection": {
                        "gen": "any",
                        "depth": 1
                      },
                      "$permissions": {
                        "gen": "any",
                        "depth": 2
                      },
                      "a": {
                        "gen": "any",
                        "depth": 3
                      },
                      "b": {
                        "gen": "any",
                        "depth": 3
                      }
                    },
                    "optional": [
                      "$id",
                      "$collection",
                      "$permissions",
                      "a",
                      "b"
                    ]
                  }
                ]
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
