        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "successor"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.refresh",
          "args": {
            "lock": {
              "$ref": "refresher"
            }
          },
          "expect": false
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "refresher"
            }
          },
          "expect": null
        },
        {
          "op": "distributed.is_held",
          "args": {
            "lock": {
              "$ref": "successor"
            }
          },
          "expect": true
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "successor"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "an empty token cannot be adopted",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "distributed.adopt",
          "args": {
            "lock": {
              "$ref": "a"
            },
            "token": ""
          },
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Token must not be empty"
            }
          }
        },
        {
          "op": "distributed.has_token",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "distributed.refresh",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "a held lock cannot replace its token",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.token",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "bind": "before",
          "expect": "<masked>"
        },
        {
          "op": "distributed.adopt",
          "args": {
            "lock": {
              "$ref": "a"
            },
            "token": "another-token"
          },
          "expect": {
            "$error": {
              "class": "LogicException",
              "message": "Cannot replace the token of a distributed lock"
            }
          }
        },
        {
          "op": "distributed.token",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "bind": "after",
          "expect": "<masked>"
        },
        {
          "op": "$equal",
          "args": {
            "a": {
              "$ref": "before"
            },
            "b": {
              "$ref": "after"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.is_held",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "the token is the value on the key and is cleared on release",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.token",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "bind": "token",
          "expect": "<masked>"
        },
        {
          "op": "redis.get",
          "args": {
            "key": "${ns}:k"
          },
          "bind": "value",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "the token itself"
          },
          "expect": "<masked>"
        },
        {
          "op": "$equal",
          "args": {
            "a": {
              "$ref": "token"
            },
            "b": {
              "$ref": "value"
            }
          },
          "expect": true
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": null
        },
        {
          "op": "distributed.has_token",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": false
        }
      ]
    },
