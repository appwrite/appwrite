{
  "source": "packages/lock/tests/E2E/DistributedTest.php",
  "cases": [
    {
      "name": "acquire and release",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.is_held",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "b"
            }
          },
          "expect": false
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": null
        },
        {
          "op": "distributed.is_held",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "b"
            }
          },
          "expect": true
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "b"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "acquire respects a fractional timeout",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "holder",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "waiter",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.acquire_elapsed",
          "args": {
            "lock": {
              "$ref": "waiter"
            },
            "timeout": 0.25,
            "at_least": 0.2,
            "below": 1.0
          },
          "expect": {
            "acquired": false,
            "within": true
          }
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "waiters do not retry in lockstep",
      "op": "distributed.retry_spread",
      "args": {
        "key": "${ns}:k",
        "runs": 25
      },
      "state": [],
      "expect": {
        "observed": true,
        "spread": true
      }
    },
    {
      "name": "release does not remove a foreign lock",
      "steps": [
        {
          "op": "redis.set",
          "args": {
            "key": "${ns}:k",
            "value": "other-owner",
            "ex": 30
          },
          "expect": true
        },
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": false
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": null
        },
        {
          "op": "redis.get",
          "args": {
            "key": "${ns}:k"
          },
          "expect": "other-owner"
        }
      ]
    },
    {
      "name": "withLock throws contention on timeout",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "holder",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "waiter",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.with_lock",
          "args": {
            "lock": {
              "$ref": "waiter"
            },
            "timeout": 0.2
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Lock\\Exception\\Contention",
              "message": "Failed to acquire distributed lock: ${ns}:k"
            }
          }
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "withLock runs the callback and releases",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.with_lock",
          "args": {
            "lock": {
              "$ref": "a"
            },
            "timeout": 1.0,
            "result": "done"
          },
          "expect": "done"
        },
        {
          "op": "redis.get",
          "args": {
            "key": "${ns}:k"
          },
          "expect": false
        }
      ]
    },
    {
      "name": "refresh extends the ttl",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 5
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "redis.ttl",
          "args": {
            "key": "${ns}:k"
          },
          "expect": true
        },
        {
          "op": "distributed.refresh",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "a"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "an adopted token refreshes the lease through another connection",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "holder",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.token",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "bind": "token",
          "expect": "<masked>"
        },
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "refresher",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "distributed.adopt",
          "args": {
            "lock": {
              "$ref": "refresher"
            },
            "token": {
              "$ref": "token"
            }
          },
          "expect": null
        },
        {
          "op": "distributed.token",
          "args": {
            "lock": {
              "$ref": "refresher"
            }
          },
          "bind": "adopted",
          "expect": "<masked>"
        },
        {
          "op": "$equal",
          "args": {
            "a": {
              "$ref": "token"
            },
            "b": {
              "$ref": "adopted"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.refresh",
          "args": {
            "lock": {
              "$ref": "refresher"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.is_held",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "expect": true
        },
        {
          "op": "lock.release",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "an adopted stale token cannot refresh or release a successor",
      "steps": [
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "holder",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "lock.try_acquire",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "expect": true
        },
        {
          "op": "distributed.token",
          "args": {
            "lock": {
              "$ref": "holder"
            }
          },
          "bind": "token",
          "expect": "<masked>"
        },
        {
          "op": "distributed.new",
          "args": {
            "key": "${ns}:k",
            "ttl": 30
          },
          "bind": "refresher",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "distributed.adopt",
          "args": {
            "lock": {
              "$ref": "refresher"
            },
            "token": {
              "$ref": "token"
            }
          },
          "expect": null
        },
        {
          "op": "redis.del",
          "args": {
            "key": "${ns}:k"
