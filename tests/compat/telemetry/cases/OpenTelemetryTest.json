{
  "source": "packages/telemetry/tests/Adapter/OpenTelemetryTest.php",
  "cases": [
    {
      "name": "empty observations do not discard the request's metrics",
      "steps": [
        {
          "op": "telemetry.otlp",
          "args": {
            "namespace": "edge",
            "service": "edge-databases",
            "instance": "instance"
          },
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "counter",
            "name": "edge.database.http.request"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "observable_gauge",
            "name": "edge.database.backup.schedule.missed"
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "source.new",
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.observe",
          "args": {
            "instrument": {
              "$ref": "g"
            },
            "source": {
              "$ref": "s"
            }
          },
          "expect": null
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "c"
            },
            "value": 1
          },
          "expect": null
        },
        {
          "op": "telemetry.collect",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": true
        },
        {
          "op": "source.set",
          "args": {
            "source": {
              "$ref": "s"
            },
            "observations": [
              {
                "value": 0
              }
            ]
          },
          "expect": null
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "c"
            },
            "value": 1
          },
          "expect": null
        },
        {
          "op": "telemetry.collect",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": true
        },
        {
          "op": "source.set",
          "args": {
            "source": {
              "$ref": "s"
            },
            "observations": []
          },
          "expect": null
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "c"
            },
            "value": 1
          },
          "expect": null
        },
        {
          "op": "telemetry.collect",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": true
        },
        {
          "op": "source.set",
          "args": {
            "source": {
              "$ref": "s"
            },
            "observations": [
              {
                "value": 2
              }
            ]
          },
          "expect": null
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "c"
            },
            "value": 1
          },
          "expect": null
        },
        {
          "op": "telemetry.collect",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": true
        },
        {
          "op": "otlp.payloads",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": [
            [
              {
                "resource": [
                  [
                    "service.namespace",
                    "edge"
