{
  "source": "backends: None, Test and OpenTelemetry beyond the PHP tests",
  "cases": [
    {
      "name": "None records nothing and collects",
      "steps": [
        {
          "op": "telemetry.none",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "counter",
            "name": "c"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "c"
            },
            "value": 1
          },
          "expect": null
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "up_down_counter",
            "name": "u"
          },
          "bind": "u",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "u"
            },
            "value": -1
          },
          "expect": null
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "histogram",
            "name": "h",
            "boundaries": [
              1,
              2
            ]
          },
          "bind": "h",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "h"
            },
            "value": 1.5
          },
          "expect": null
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "gauge",
            "name": "g"
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "g"
            },
            "value": 3
          },
          "expect": null
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "observable_gauge",
            "name": "o"
          },
          "bind": "o",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "source.new",
          "args": {
            "observations": [
              {
                "value": 1
              }
            ]
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.observe",
          "args": {
            "instrument": {
              "$ref": "o"
            },
            "source": {
              "$ref": "s"
            }
          },
          "expect": null
        },
        {
          "op": "telemetry.collect",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": true
        }
      ]
    },
    {
      "name": "Test: the last instrument of a name to record owns it",
      "steps": [
        {
          "op": "telemetry.memory",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "counter",
            "name": "x"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "counter",
            "name": "x"
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "a"
            },
            "value": 1
          },
          "expect": null
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "b"
            },
            "value": 2.5
          },
          "expect": null
        },
        {
          "op": "memory.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "counters": [
              [
                "x",
                [
                  2.5
                ]
              ]
            ],
            "upDownCounters": [],
            "histograms": [],
            "gauges": [],
            "observableGauges": []
          }
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "a"
            },
            "value": 3
          },
          "expect": null
        },
        {
          "op": "memory.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "counters": [
              [
                "x",
                [
                  1,
                  3
                ]
              ]
            ],
            "upDownCounters": [],
            "histograms": [],
            "gauges": [],
            "observableGauges": []
          }
        },
        {
          "op": "telemetry.collect",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": true
        }
      ]
    },
    {
      "name": "Test: observable gauges of one name accumulate callbacks and appear once observed",
      "steps": [
        {
          "op": "telemetry.memory",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "observable_gauge",
            "name": "pool.count"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "memory.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "counters": [],
            "upDownCounters": [],
            "histograms": [],
            "gauges": [],
            "observableGauges": []
          }
        },
        {
          "op": "memory.observe",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "name": "pool.count"
          },
          "expect": null
        },
        {
          "op": "source.new",
          "args": {
            "observations": [
              {
                "value": 1,
                "attributes": [
                  [
                    "pool",
                    "alpha"
                  ],
                  [
                    "size",
                    5
                  ]
                ]
              }
            ]
          },
          "bind": "s1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.observe",
          "args": {
            "instrument": {
              "$ref": "a"
            },
            "source": {
              "$ref": "s1"
            }
          },
          "expect": null
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "observable_gauge",
            "name": "pool.count"
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "source.new",
          "args": {
            "observations": [
              {
                "value": 2.5,
                "attributes": [
                  [
                    "pool",
                    "beta"
                  ],
                  [
                    "ok",
                    true
                  ]
                ]
              }
            ]
          },
          "bind": "s2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.observe",
          "args": {
            "instrument": {
              "$ref": "b"
            },
            "source": {
              "$ref": "s2"
            }
          },
          "expect": null
        },
        {
          "op": "memory.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "counters": [],
            "upDownCounters": [],
            "histograms": [],
            "gauges": [],
            "observableGauges": [
              [
                "pool.count",
                2
              ]
            ]
          }
        },
        {
          "op": "memory.observe",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "name": "pool.count"
          },
          "expect": [
            [
              1,
              [
                [
                  "pool",
                  "alpha"
                ],
                [
                  "size",
                  5
                ]
              ]
            ],
            [
              2.5,
              [
                [
                  "pool",
                  "beta"
                ],
                [
                  "ok",
                  true
                ]
              ]
            ]
          ]
        }
      ]
    },
