{
  "source": "packages/telemetry/tests/LazyInstrumentTest.php",
  "cases": [
    {
      "name": "lazy counter creates its inner counter on the first add",
      "steps": [
        {
          "op": "telemetry.memory",
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "instrument.new",
          "args": {
            "telemetry": {
              "$ref": "t"
            },
            "kind": "counter",
            "name": "events.total",
            "unit": "{event}",
            "description": "Event count",
            "lazy": true
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "memory.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "counters": [],
            "upDownCounters": [],
            "histograms": [],
            "gauges": [],
            "observableGauges": []
          }
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "c"
            },
            "value": 1,
            "attributes": [
              [
                "event.name",
                "created"
              ]
            ]
          },
          "expect": null
        },
        {
          "op": "memory.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "counters": [
              [
                "events.total",
                [
                  1
                ]
              ]
            ],
            "upDownCounters": [],
            "histograms": [],
            "gauges": [],
            "observableGauges": []
          }
        },
        {
          "op": "instrument.record",
          "args": {
            "instrument": {
              "$ref": "c"
            },
            "value": 2
          },
          "expect": null
        },
        {
          "op": "memory.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "counters": [
              [
                "events.total",
                [
                  1,
                  2
                ]
              ]
            ],
            "upDownCounters": [],
            "histograms": [],
            "gauges": [],
            "observableGauges": []
          }
        }
      ]
    },
