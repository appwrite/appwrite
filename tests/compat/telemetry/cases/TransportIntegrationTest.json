{
  "source": "packages/telemetry/tests/E2E/Adapter/OpenTelemetry/Swoole/TransportIntegrationTest.php",
  "cases": [
    {
      "name": "sends the payload to the collector",
      "op": "transport.exchange",
      "args": {
        "script": [
          {
            "status": 200,
            "body": "OK"
          }
        ],
        "sends": [
          "test-metric-payload-data"
        ]
      },
      "expect": {
        "results": [
          "OK"
        ],
        "requests": [
          {
            "payload": "test-metric-payload-data",
            "headers": [
              [
                "content-length",
                "24"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          }
        ]
      }
    },
    {
      "name": "retries once when the pooled connection is reset mid request",
      "op": "transport.exchange",
      "args": {
        "script": [
          {
            "status": 200,
            "body": "OK"
          },
          {
            "reset": true
          },
          {
            "status": 200,
            "body": "OK"
          }
        ],
        "sends": [
          "first",
          "second"
        ]
      },
      "expect": {
        "results": [
          "OK",
          "OK"
        ],
        "requests": [
          {
            "payload": "first",
            "headers": [
              [
                "content-length",
                "5"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          },
          {
            "payload": "second",
            "headers": [
              [
                "content-length",
                "6"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          },
          {
            "payload": "second",
            "headers": [
              [
                "content-length",
                "6"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          }
        ]
      }
    },
    {
      "name": "does not retry when the collector is too slow to answer",
      "op": "transport.exchange",
      "args": {
        "script": [
          {
            "status": 200,
            "body": "OK"
          },
          {
            "hang_ms": 1000
          }
        ],
        "sends": [
          "first",
          "second"
        ],
        "timeout": 0.3
      },
      "expect": {
        "results": [
          "OK",
          {
            "$error": {
              "class": "Utopia\\Telemetry\\Exception",
              "message": "OTLP connection failed: Operation timed out (code: 110)"
            }
          }
        ],
        "requests": [
          {
            "payload": "first",
            "headers": [
              [
                "content-length",
                "5"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          },
          {
            "payload": "second",
            "headers": [
              [
                "content-length",
                "6"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          }
        ]
      }
    },
    {
      "name": "custom headers",
      "op": "transport.exchange",
      "args": {
        "sends": [
          "payload"
        ],
        "headers": [
          [
            "Authorization",
            "Bearer test-token"
          ],
          [
            "X-Custom-Header",
            "custom-value"
          ]
        ]
      },
      "expect": {
        "results": [
          ""
        ],
        "requests": [
          {
            "payload": "payload",
            "headers": [
              [
                "authorization",
                "Bearer test-token"
              ],
              [
                "content-length",
                "7"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ],
              [
                "x-custom-header",
                "custom-value"
              ]
            ]
          }
        ]
      }
    },
    {
      "name": "server error",
      "op": "transport.exchange",
      "args": {
        "script": [
          {
            "status": 500,
            "body": "Internal Server Error"
          }
        ],
        "sends": [
          "payload"
        ]
      },
      "expect": {
        "results": [
          {
            "$error": {
              "class": "Utopia\\Telemetry\\Exception",
              "message": "OTLP export failed with status 500: Internal Server Error"
            }
          }
        ],
        "requests": [
          {
            "payload": "payload",
            "headers": [
              [
                "content-length",
                "7"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          }
        ]
      }
    },
    {
      "name": "client error keeps the connection",
      "op": "transport.exchange",
      "args": {
        "script": [
          {
            "status": 400,
            "body": "bad"
          },
          {
            "status": 200,
            "body": "OK"
          }
        ],
        "sends": [
          "a",
          "b"
        ]
      },
      "expect": {
        "results": [
          {
            "$error": {
              "class": "Utopia\\Telemetry\\Exception",
              "message": "OTLP export failed with status 400: bad"
            }
          },
          "OK"
        ],
        "requests": [
          {
            "payload": "a",
            "headers": [
              [
                "content-length",
                "1"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          },
          {
            "payload": "b",
            "headers": [
              [
                "content-length",
                "1"
              ],
              [
                "content-type",
                "application/x-protobuf"
              ]
            ]
          }
        ]
      }
    },
