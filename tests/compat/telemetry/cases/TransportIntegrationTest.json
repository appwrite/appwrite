    {
      "name": "connection refused",
      "op": "transport.exchange",
      "args": {
        "endpoint": "http://127.0.0.1:19999/v1/metrics",
        "sends": [
          "payload"
        ],
        "timeout": 0.5
      },
      "mask": {
        "paths": [
          "/results/0/$error/message"
        ],
        "reason": "the message quotes the OS error number, which differs between Linux (111, where PHP runs) and a macOS host (61)"
      },
      "expect": {
        "results": [
          {
            "$error": {
              "class": "Utopia\\Telemetry\\Exception",
              "message": "<masked>"
            }
          }
        ],
        "requests": []
      }
    },
