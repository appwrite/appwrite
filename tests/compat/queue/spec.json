  "waivers": {
    "Utopia\\Queue\\Internal\\*": "@internal: settlement and acknowledgement coalescing, not public API; every broker.commit/reject/release case goes through it",
    "Utopia\\Queue\\Adapter\\Workerman::*": "Workerman process supervisor: PHP runtime plumbing with no Rust counterpart (Rust workers are tokio tasks: adapter::Runtime::Workers)",
    "Utopia\\Queue\\Adapter\\Swoole::start": "Swoole process supervisor (forks and respawns worker processes): PHP runtime plumbing; Rust runs workers as tokio tasks (Server::start with Runtime::Workers)",
    "Utopia\\Queue\\Adapter\\Swoole::stop": "signals the forked worker processes: PHP runtime plumbing; Rust stops through adapter::Stopper, which adapter.consume exercises",
    "Utopia\\Queue\\Adapter\\Swoole::workerStart": "registers a forked-process callback: PHP runtime plumbing; Server::worker_start hooks are covered by server.run",
    "Utopia\\Queue\\Adapter\\Swoole::workerStop": "registers a forked-process callback: PHP runtime plumbing; Server::worker_stop hooks are covered by server.run",
    "Utopia\\Queue\\Broker\\Nats::tick": "reads the socket to answer the server's pings, which async-nats does on its own task; Consumer::maintain (covered) is the sweep"
  },
