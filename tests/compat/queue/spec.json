  "generators": {
    "payload": {
      "gen": "one_of",
      "of": [
        {
          "gen": "array",
          "items": {
            "gen": "any",
            "depth": 4
          },
          "max": 8
        },
        {
          "gen": "array",
          "items": {
            "gen": "string",
            "alphabet": "unicode",
            "max": 4000
          },
          "max": 3
        },
        {
          "gen": "array",
          "items": {
            "gen": "one_of",
            "of": [
              {
                "gen": "string",
                "tricky": 0.6
              },
              {
                "gen": "int"
              },
              {
                "gen": "float"
              },
              {
                "gen": "bool"
              },
              {
                "gen": "null"
              }
            ]
          },
          "max": 6
        },
        {
          "gen": "any",
          "depth": 3
        },
        {
          "gen": "object",
          "fields": {
            "bin": {
              "gen": "bytes",
              "max": 64
            },
            "list": {
              "gen": "array",
              "items": {
                "gen": "bytes",
                "max": 16
              },
              "max": 4
            },
            "text": {
              "gen": "string",
              "tricky": 0.5
            }
          },
          "optional": [
            "list",
            "text"
          ]
        },
        {
          "gen": "object",
          "fields": {
            "blob": {
              "gen": "string",
              "alphabet": "ascii",
              "min": 50000,
              "max": 200000
            },
            "rows": {
              "gen": "array",
              "items": {
                "gen": "any",
                "depth": 2
              },
              "min": 20,
              "max": 200
            }
          }
        }
      ]
    },
    "payload_array": {
      "gen": "one_of",
      "of": [
        {
          "gen": "array",
          "items": {
            "gen": "any",
            "depth": 4
          },
          "max": 8
        },
        {
          "gen": "array",
          "items": {
            "gen": "string",
            "alphabet": "unicode",
            "max": 3000
          },
          "max": 3
        },
        {
          "gen": "array",
          "items": {
            "gen": "one_of",
            "of": [
              {
                "gen": "string",
                "tricky": 0.6
