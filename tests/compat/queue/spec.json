{
  "lib": "queue",
  "description": "utopia-php/queue: messages and codecs, the Redis and NATS JetStream brokers, pooled and background publishers, and the worker server with its hooks.",
  "complete": true,
  "php": {
    "src": [
      "packages/queue/src"
    ],
    "tests": [
      "packages/queue/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/queue"
  },
  "services": [
    "redis"
  ],
  "state": [
    "redis"
  ],
  "ops": {
    "clock.set": {
      "doc": "fixture: move the pinned clock to `time`, keeping its counters"
    },
    "queue.new": {
      "doc": "new Queue(name, namespace?, jobTtl?) → [name, namespace, jobTtl]",
      "covers": [
        "Utopia\\Queue\\Queue::__construct"
      ]
    },
    "message.new": {
      "doc": "new Message(envelope)->asArray()",
      "covers": [
        "Utopia\\Queue\\Message::__construct",
        "Utopia\\Queue\\Message::asArray"
      ],
      "fuzz": [
        {
          "name": "envelopes",
          "args": {
            "gen": "object",
            "fields": {
              "envelope": {
                "gen": "object",
                "fields": {
                  "pid": {
                    "gen": "ref",
                    "name": "scalar"
                  },
                  "queue": {
                    "gen": "ref",
                    "name": "scalar"
                  },
                  "timestamp": {
                    "gen": "ref",
                    "name": "scalar"
                  },
                  "payload": {
                    "gen": "one_of",
                    "of": [
                      {
                        "gen": "ref",
                        "name": "payload_array"
                      },
                      {
                        "gen": "ref",
                        "name": "scalar"
                      }
                    ]
                  },
                  "attempts": {
                    "gen": "ref",
                    "name": "scalar"
                  },
                  "sequence": {
                    "gen": "ref",
                    "name": "scalar"
                  }
                },
                "optional": [
                  "payload",
                  "attempts",
                  "sequence"
                ]
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "message.set": {
      "doc": "every setter given, then every getter",
      "covers": [
        "Utopia\\Queue\\Message::setPid",
        "Utopia\\Queue\\Message::setQueue",
        "Utopia\\Queue\\Message::setTimestamp",
        "Utopia\\Queue\\Message::setPayload",
        "Utopia\\Queue\\Message::setAttempts",
        "Utopia\\Queue\\Message::setSequence",
        "Utopia\\Queue\\Message::setReceipt",
        "Utopia\\Queue\\Message::terminal",
        "Utopia\\Queue\\Message::getPid",
        "Utopia\\Queue\\Message::getQueue",
        "Utopia\\Queue\\Message::getTimestamp",
        "Utopia\\Queue\\Message::getPayload",
        "Utopia\\Queue\\Message::getAttempts",
        "Utopia\\Queue\\Message::getSequence",
        "Utopia\\Queue\\Message::getReceipt",
        "Utopia\\Queue\\Message::isTerminal"
      ]
    },
    "codec.encode": {
      "doc": "$codec->encode(value) (json, igbinary, compat, compat-igbinary)",
      "covers": [
        "Utopia\\Queue\\Codec\\Json::encode",
        "Utopia\\Queue\\Codec\\Igbinary::__construct",
        "Utopia\\Queue\\Codec\\Igbinary::encode",
        "Utopia\\Queue\\Codec\\Compat::__construct",
        "Utopia\\Queue\\Codec\\Compat::encode"
      ]
    },
    "codec.decode": {
      "doc": "$codec->decode(bytes)",
      "covers": [
        "Utopia\\Queue\\Codec\\Json::decode",
        "Utopia\\Queue\\Codec\\Igbinary::decode",
        "Utopia\\Queue\\Codec\\Compat::decode"
      ]
    },
    "codec.content_type": {
      "doc": "$codec->contentType()",
      "covers": [
        "Utopia\\Queue\\Codec\\Json::contentType",
        "Utopia\\Queue\\Codec\\Igbinary::contentType",
        "Utopia\\Queue\\Codec\\Compat::contentType"
      ]
    },
    "codec.round_trip": {
      "doc": "bytes = encode(value), then decode(bytes)",
      "fuzz": [
        {
          "name": "json-payloads",
          "args": {
            "gen": "object",
            "fields": {
              "codec": {
                "gen": "const",
                "value": "json"
              },
              "value": {
                "gen": "ref",
                "name": "payload"
              }
            }
          },
          "iterations": 2000
        },
        {
          "name": "igbinary-payloads",
          "args": {
            "gen": "object",
            "fields": {
              "codec": {
                "gen": "const",
                "value": "igbinary"
              },
              "value": {
                "gen": "ref",
                "name": "payload"
              }
            }
          },
          "iterations": 2000
        },
        {
          "name": "compat-payloads",
          "args": {
            "gen": "object",
            "fields": {
              "codec": {
                "gen": "const",
                "value": "compat-igbinary"
              },
              "value": {
                "gen": "ref",
                "name": "payload"
              }
            }
          },
          "iterations": 1000
        }
      ]
    },
