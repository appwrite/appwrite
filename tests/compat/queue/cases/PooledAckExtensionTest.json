          "args": {
            "time": 1700000000,
            "size": 1
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "broker.extend",
          "args": {
            "broker": {
              "$ref": "p"
            },
            "queue": {
              "name": "pool",
              "namespace": "${ns}"
            },
            "messages": []
          },
          "expect": null
        },
        {
          "op": "broker.extend",
          "args": {
            "broker": {
              "$ref": "p"
            },
            "queue": {
              "name": "pool",
              "namespace": "${ns}"
            },
            "messages": []
          },
          "expect": null
        },
        {
          "op": "broker.publish",
          "args": {
            "broker": {
              "$ref": "p"
            },
            "queue": {
              "name": "pool",
              "namespace": "${ns}"
            },
            "payload": {
              "n": 1
            }
          },
          "expect": true
        },
        {
          "op": "broker.receive",
          "args": {
            "broker": {
              "$ref": "p"
            },
            "queue": {
              "name": "pool",
              "namespace": "${ns}"
            },
            "timeout": 0
          },
          "expect": {
            "handles": [
              {
                "$handle": "*"
              }
            ],
            "messages": [
              {
                "$array": [
                  [
                    "pid",
                    "pid0001"
                  ],
                  [
                    "queue",
                    "pool"
                  ],
                  [
                    "timestamp",
                    1700000000
                  ],
                  [
                    "payload",
                    {
                      "$array": [
                        [
                          "n",
                          1
                        ]
                      ]
                    }
                  ],
                  [
                    "attempts",
                    0
                  ],
                  [
                    "sequence",
                    null
                  ],
                  [
                    "receipt",
                    "30303030303030303030303030303031"
                  ]
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
