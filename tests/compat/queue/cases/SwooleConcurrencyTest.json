                "timestamp": 1700000000,
                "payload": {
                  "n": 1
                }
              },
              {
                "pid": "p09",
                "queue": "work",
                "timestamp": 1700000000,
                "payload": {
                  "n": 1
                }
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.consume",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "queue": {
              "name": "work",
              "namespace": "${ns}"
            },
            "coroutines": 3,
            "stop_after": 9,
            "hold_ms": 50,
            "sort": true
          },
          "expect": {
            "handled": [
              "p01",
              "p02",
              "p03",
              "p04",
              "p05",
              "p06",
              "p07",
              "p08",
