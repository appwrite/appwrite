    {
      "name": "a failed handler is rejected and the loop goes on",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "messages": [
              {
                "pid": "p01",
                "queue": "work",
                "timestamp": 1700000000,
                "payload": {
                  "n": 1
                }
              },
              {
                "pid": "p02",
                "queue": "work",
                "timestamp": 1700000000,
                "payload": {
                  "n": 1
                }
              },
              {
                "pid": "p03",
                "queue": "work",
                "timestamp": 1700000000,
                "payload": {
                  "n": 1
                }
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.consume",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "queue": {
              "name": "work",
              "namespace": "${ns}"
            },
            "coroutines": 1,
            "stop_after": 3,
            "fail": [
              "p02"
            ]
          },
          "expect": {
            "handled": [
              "p01",
              "p02",
              "p03"
            ],
            "succeeded": [
              "p01",
              "p03"
            ],
            "errors": [
              [
                "p02",
                "boom"
              ]
            ],
            "max": 1
          }
        },
        {
          "op": "memory.log",
          "args": {
            "consumer": {
              "$ref": "c"
            }
          },
          "expect": [
            "receive:1",
            "commit:p01",
            "receive:1",
            "reject:p02:retry",
            "receive:1",
            "commit:p03"
          ]
        }
      ]
    }
