{
  "source": "packages/queue/tests/BackgroundTest.php",
  "cases": [
    {
      "name": "publish delegates synchronously",
      "steps": [
        {
          "op": "broker.redis",
          "args": {
            "time": 1700000000
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "background.new",
          "args": {
            "broker": {
              "$ref": "b"
            }
          },
          "bind": "bg",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "background.publish",
          "args": {
            "background": {
              "$ref": "bg"
            },
            "queue": {
              "name": "background",
              "namespace": "${ns}"
            },
            "payload": {
              "n": 1
            }
          },
          "expect": true
        },
        {
          "op": "redis.cmd",
          "args": {
            "args": [
              "LRANGE",
              "${ns}.queue.background",
              0,
              -1
            ]
          },
          "expect": [
            "{\"pid\":\"pid0001\",\"queue\":\"background\",\"timestamp\":1700000000,\"payload\":{\"n\":1}}"
          ]
        }
      ]
    },
