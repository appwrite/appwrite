        },
        {
          "op": "connection.call",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "method": "rightPush",
            "args": [
              "${ns}.auth",
              "payload"
            ]
          },
          "expect": true
        },
        {
          "op": "connection.call",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "method": "rightPop",
            "args": [
              "${ns}.auth",
              1
            ]
          },
          "expect": "payload"
        }
      ]
    },
    {
      "name": "a DSN without credentials is rejected",
      "state": [],
      "steps": [
        {
          "op": "connection.new",
          "args": {
            "service": "queue-redis-auth",
            "kind": "redis-dsn",
            "dsn": "redis://{host}"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "connection.call",
          "args": {
            "connection": {
              "$ref": "c"
            },
            "method": "rightPush",
            "args": [
              "${ns}.auth",
              "payload"
            ]
          },
          "expect": {
            "$error": {
              "class": "RedisException",
              "message": "NOAUTH Authentication required."
            }
          }
        }
      ]
    }
  ]
}
