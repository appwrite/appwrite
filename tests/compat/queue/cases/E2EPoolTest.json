    {
      "name": "every call through the pool",
      "steps": [
        {
          "op": "broker.pool",
          "args": {
            "time": 1700000000,
            "size": 1
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "broker.publish_many",
          "args": {
            "broker": {
              "$ref": "p"
            },
            "queue": {
              "name": "pool",
              "namespace": "${ns}"
            },
            "payloads": [
              {
                "n": 1
              },
              {
                "n": 2
              },
              {
                "n": 3
              }
            ]
          },
          "expect": true
        },
        {
          "op": "broker.receive",
          "args": {
            "broker": {
              "$ref": "p"
            },
            "queue": {
              "name": "pool",
              "namespace": "${ns}"
            },
            "timeout": 0,
            "n": 3
          },
          "bind": "m",
          "expect": {
            "handles": [
              {
                "$handle": "*"
              },
              {
                "$handle": "*"
              },
              {
                "$handle": "*"
              }
            ],
            "messages": [
              {
                "$array": [
                  [
                    "pid",
                    "pid0001"
                  ],
                  [
                    "queue",
                    "pool"
                  ],
                  [
                    "timestamp",
                    1700000000
                  ],
                  [
                    "payload",
                    {
                      "$array": [
                        [
                          "n",
                          1
                        ]
                      ]
                    }
                  ],
                  [
                    "attempts",
                    0
                  ],
                  [
                    "sequence",
                    null
                  ],
                  [
                    "receipt",
                    "30303030303030303030303030303031"
                  ]
                ]
              },
              {
                "$array": [
                  [
                    "pid",
                    "pid0002"
                  ],
                  [
                    "queue",
                    "pool"
                  ],
                  [
                    "timestamp",
                    1700000000
                  ],
                  [
                    "payload",
                    {
                      "$array": [
                        [
                          "n",
                          2
                        ]
                      ]
                    }
                  ],
                  [
                    "attempts",
                    0
                  ],
                  [
                    "sequence",
                    null
                  ],
                  [
                    "receipt",
                    "30303030303030303030303030303031"
                  ]
                ]
              },
              {
                "$array": [
                  [
                    "pid",
                    "pid0003"
                  ],
                  [
                    "queue",
                    "pool"
                  ],
                  [
                    "timestamp",
                    1700000000
                  ],
                  [
                    "payload",
                    {
                      "$array": [
                        [
                          "n",
                          3
                        ]
                      ]
                    }
                  ],
                  [
                    "attempts",
                    0
                  ],
                  [
                    "sequence",
                    null
                  ],
                  [
                    "receipt",
                    "30303030303030303030303030303031"
                  ]
                ]
              }
            ]
          }
        },
        {
          "op": "broker.commit",
          "args": {
            "broker": {
              "$ref": "p"
            },
            "queue": {
              "name": "pool",
              "namespace": "${ns}"
            },
            "message": {
              "$ref": "m",
              "path": "/handles/0"
            }
          },
          "expect": null
        },
        {
          "op": "broker.reject",
          "args": {
            "broker": {
              "$ref": "p"
            },
            "queue": {
