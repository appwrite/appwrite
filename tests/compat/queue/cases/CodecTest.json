{
  "source": "packages/queue/tests/CodecTest.php",
  "cases": [
    {
      "name": "json round trips an envelope",
      "op": "codec.round_trip",
      "args": {
        "codec": "json",
        "value": {
          "pid": "65e2a1b8c9d0e1.23456789",
          "queue": "v1-stats-usage",
          "timestamp": 1758067200,
          "attempts": 2,
          "payload": {
            "string": "utopia",
            "int": 42,
            "float": 1.5,
            "true": true,
            "false": false,
            "null": null,
            "list": [
              1,
              2,
              3
            ],
            "assoc": {
              "nested": {
                "deep": "value"
              }
            },
            "empty": []
          }
        }
      },
      "expect": {
        "bytes": "{\"pid\":\"65e2a1b8c9d0e1.23456789\",\"queue\":\"v1-stats-usage\",\"timestamp\":1758067200,\"attempts\":2,\"payload\":{\"string\":\"utopia\",\"int\":42,\"float\":1.5,\"true\":true,\"false\":false,\"null\":null,\"list\":[1,2,3],\"assoc\":{\"nested\":{\"deep\":\"value\"}},\"empty\":[]}}",
        "value": {
          "$array": [
            [
              "pid",
              "65e2a1b8c9d0e1.23456789"
            ],
            [
              "queue",
              "v1-stats-usage"
            ],
            [
              "timestamp",
              1758067200
            ],
            [
              "attempts",
              2
            ],
            [
              "payload",
              {
                "$array": [
                  [
                    "string",
                    "utopia"
                  ],
                  [
                    "int",
                    42
                  ],
                  [
                    "float",
                    1.5
                  ],
                  [
                    "true",
                    true
                  ],
                  [
                    "false",
                    false
                  ],
                  [
                    "null",
                    null
                  ],
                  [
                    "list",
                    [
                      1,
                      2,
                      3
                    ]
                  ],
                  [
                    "assoc",
                    {
                      "$array": [
                        [
                          "nested",
                          {
                            "$array": [
                              [
                                "deep",
                                "value"
                              ]
                            ]
                          }
                        ]
                      ]
                    }
                  ],
                  [
                    "empty",
                    []
                  ]
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "name": "igbinary round trips an envelope",
      "op": "codec.round_trip",
      "args": {
        "codec": "igbinary",
        "value": {
          "pid": "65e2a1b8c9d0e1.23456789",
          "queue": "v1-stats-usage",
          "timestamp": 1758067200,
          "attempts": 2,
          "payload": {
            "string": "utopia",
            "int": 42,
            "float": 1.5,
            "true": true,
            "false": false,
            "null": null,
            "list": [
              1,
              2,
              3
            ],
            "assoc": {
              "nested": {
                "deep": "value"
              }
            },
            "empty": []
          }
        }
      },
      "expect": {
        "bytes": {
          "$bytes": "AAAAAhQFEQNwaWQRFzY1ZTJhMWI4YzlkMGUxLjIzNDU2Nzg5EQVxdWV1ZREOdjEtc3RhdHMtdXNhZ2URCXRpbWVzdGFtcApoyfoAEQhhdHRlbXB0cwYCEQdwYXlsb2FkFAkRBnN0cmluZxEGdXRvcGlhEQNpbnQGKhEFZmxvYXQMP/gAAAAAAAARBHRydWUFEQVmYWxzZQQRBG51bGwAEQRsaXN0FAMGAAYBBgEGAgYCBgMRBWFzc29jFAERBm5lc3RlZBQBEQRkZWVwEQV2YWx1ZREFZW1wdHkUAA=="
        },
        "value": {
          "$array": [
            [
              "pid",
              "65e2a1b8c9d0e1.23456789"
            ],
            [
              "queue",
              "v1-stats-usage"
            ],
            [
              "timestamp",
              1758067200
            ],
            [
              "attempts",
              2
            ],
            [
              "payload",
              {
                "$array": [
                  [
                    "string",
                    "utopia"
                  ],
                  [
                    "int",
                    42
                  ],
                  [
                    "float",
                    1.5
                  ],
                  [
                    "true",
                    true
                  ],
                  [
                    "false",
                    false
                  ],
                  [
                    "null",
                    null
                  ],
                  [
                    "list",
                    [
                      1,
                      2,
                      3
                    ]
                  ],
                  [
                    "assoc",
                    {
                      "$array": [
                        [
                          "nested",
                          {
                            "$array": [
                              [
                                "deep",
                                "value"
                              ]
                            ]
                          }
                        ]
                      ]
                    }
                  ],
                  [
                    "empty",
                    []
                  ]
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "name": "json refuses foreign bytes",
      "op": "codec.decode",
      "args": {
        "codec": "json",
        "bytes": {
          "$bytes": "H4sgbm90IGEgcGF5bG9hZCB0aGlzIGNvZGVjIHdyb3Rl"
        }
      },
      "expect": {
        "$error": {
          "class": "JsonException",
          "message": "Control character error, possibly incorrectly encoded"
        }
      }
    },
    {
      "name": "igbinary refuses foreign bytes",
      "op": "codec.decode",
      "args": {
        "codec": "igbinary",
        "bytes": {
          "$bytes": "H4sgbm90IGEgcGF5bG9hZCB0aGlzIGNvZGVjIHdyb3Rl"
        }
      },
      "expect": {
        "$error": {
          "class": "RuntimeException",
          "message": "igbinary_unserialize_header: unsupported version: 529211502, should be 1 or 2"
        }
      }
    },
    {
      "name": "json writes the historical wire format",
      "op": "codec.encode",
      "args": {
        "codec": "json",
        "value": {
          "pid": "a",
          "queue": "mail",
          "timestamp": 1,
          "payload": []
        }
      },
      "expect": "{\"pid\":\"a\",\"queue\":\"mail\",\"timestamp\":1,\"payload\":[]}"
    },
    {
      "name": "json escapes slashes and unicode like json_encode",
      "op": "codec.encode",
      "args": {
        "codec": "json",
        "value": {
          "path": "a/b",
          "name": "é 日本 🎉",
          "html": "<b>&'\""
        }
      },
      "expect": "{\"path\":\"a\\/b\",\"name\":\"\\u00e9 \\u65e5\\u672c \\ud83c\\udf89\",\"html\":\"<b>&'\\\"\"}"
    },
    {
      "name": "json cannot encode invalid utf-8",
      "op": "codec.encode",
      "args": {
        "codec": "json",
        "value": {
          "bad": {
            "$bytes": "/w=="
          }
        }
      },
      "expect": {
        "$error": {
          "class": "JsonException",
          "message": "Malformed UTF-8 characters, possibly incorrectly encoded"
        }
      }
    },
    {
      "name": "json decodes objects to arrays",
      "op": "codec.decode",
      "args": {
        "codec": "json",
        "bytes": "{\"a\":{\"b\":[1,2.0,\"x\"]},\"7\":true,\"e\":{}}"
      },
      "expect": {
        "$array": [
          [
            "a",
            {
              "$array": [
                [
                  "b",
                  [
                    1,
                    2.0,
                    "x"
                  ]
                ]
              ]
            }
          ],
          [
            7,
            true
          ],
          [
            "e",
            []
          ]
        ]
      }
    },
    {
      "name": "json decode of nothing",
      "op": "codec.decode",
      "args": {
        "codec": "json",
        "bytes": ""
      },
      "expect": {
        "$error": {
          "class": "JsonException",
          "message": "Syntax error"
        }
      }
    },
    {
      "name": "compat reads json",
      "op": "codec.decode",
      "args": {
        "codec": "compat",
        "bytes": "{\"pid\":\"a\",\"queue\":\"mail\",\"timestamp\":1,\"payload\":{\"to\":\"a@example.com\"}}"
      },
      "expect": {
        "$array": [
          [
            "pid",
            "a"
          ],
          [
            "queue",
            "mail"
          ],
          [
            "timestamp",
            1
          ],
          [
            "payload",
            {
              "$array": [
                [
                  "to",
                  "a@example.com"
                ]
              ]
            }
          ]
        ]
      }
    },
    {
      "name": "compat reads igbinary",
      "steps": [
        {
          "op": "codec.encode",
          "args": {
            "codec": "igbinary",
            "value": {
              "pid": "a",
              "queue": "mail",
              "timestamp": 1,
              "payload": {
                "to": "a@example.com"
              }
            }
          },
          "bind": "bytes",
          "expect": "\u0000\u0000\u0000\u0002\u0014\u0004\u0011\u0003pid\u0011\u0001a\u0011\u0005queue\u0011\u0004mail\u0011\ttimestamp\u0006\u0001\u0011\u0007payload\u0014\u0001\u0011\u0002to\u0011\ra@example.com"
        },
        {
          "op": "codec.decode",
          "args": {
            "codec": "compat",
            "bytes": {
              "$ref": "bytes"
            }
          },
          "expect": {
            "$array": [
              [
                "pid",
                "a"
              ],
              [
                "queue",
                "mail"
              ],
              [
                "timestamp",
                1
              ],
              [
                "payload",
                {
                  "$array": [
                    [
                      "to",
                      "a@example.com"
                    ]
                  ]
                }
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "compat writes its delegate's format",
      "op": "codec.encode",
      "args": {
        "codec": "compat",
        "value": {
          "pid": "a",
          "queue": "mail",
          "timestamp": 1,
          "payload": []
        }
      },
      "expect": "{\"pid\":\"a\",\"queue\":\"mail\",\"timestamp\":1,\"payload\":[]}"
    },
    {
      "name": "compat igbinary writer is read back by a json writer",
      "steps": [
        {
          "op": "codec.encode",
          "args": {
            "codec": "compat-igbinary",
            "value": {
              "pid": "a",
              "queue": "mail",
              "timestamp": 1,
              "payload": []
            }
          },
          "bind": "bytes",
          "expect": "\u0000\u0000\u0000\u0002\u0014\u0004\u0011\u0003pid\u0011\u0001a\u0011\u0005queue\u0011\u0004mail\u0011\ttimestamp\u0006\u0001\u0011\u0007payload\u0014\u0000"
        },
        {
          "op": "codec.decode",
          "args": {
            "codec": "compat",
            "bytes": {
              "$ref": "bytes"
            }
          },
          "expect": {
            "$array": [
              [
                "pid",
                "a"
              ],
              [
                "queue",
                "mail"
              ],
              [
                "timestamp",
                1
              ],
              [
                "payload",
                []
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "compat refuses an unknown binary format",
      "op": "codec.decode",
      "args": {
        "codec": "compat",
        "bytes": {
          "$bytes": "AAAACWFueXRoaW5n"
        }
      },
      "expect": {
        "$error": {
          "class": "RuntimeException",
          "message": "Value carries an unsupported igbinary format version."
        }
      }
    },
    {
      "name": "compat reports a corrupt igbinary payload",
      "op": "codec.decode",
      "args": {
        "codec": "compat",
        "bytes": {
          "$bytes": "AAAAAmdhcmJhZ2U="
        }
      },
      "expect": {
        "$error": {
          "class": "RuntimeException",
          "message": "igbinary_unserialize_zval: unknown type '67', position 5"
        }
      }
    },
    {
      "name": "content types name the format",
      "steps": [
        {
          "op": "codec.content_type",
          "args": {
            "codec": "json"
          },
          "expect": "application/json"
        },
        {
          "op": "codec.content_type",
          "args": {
            "codec": "igbinary"
          },
          "expect": "application/vnd.php.igbinary"
        },
        {
          "op": "codec.content_type",
          "args": {
            "codec": "compat"
          },
          "expect": "application/json"
        },
        {
          "op": "codec.content_type",
          "args": {
            "codec": "compat-igbinary"
          },
          "expect": "application/vnd.php.igbinary"
        }
      ]
    },
    {
      "name": "igbinary rejects empty input",
      "op": "codec.decode",
      "args": {
        "codec": "igbinary",
        "bytes": ""
      },
      "expect": {
        "$error": {
          "class": "RuntimeException",
          "message": "Value is not an igbinary payload."
        }
      }
    },
    {
      "name": "igbinary keeps integer keys and nested lists",
      "op": "codec.round_trip",
      "args": {
        "codec": "igbinary",
        "value": {
          "$array": [
            [
              3,
              "a"
            ],
            [
              "k",
              [
                1,
                [
                  2,
                  [
                    3
                  ]
                ]
              ]
            ],
            [
              -1,
              null
            ]
          ]
        }
      },
      "expect": {
        "bytes": "\u0000\u0000\u0000\u0002\u0014\u0003\u0006\u0003\u0011\u0001a\u0011\u0001k\u0014\u0002\u0006\u0000\u0006\u0001\u0006\u0001\u0014\u0002\u0006\u0000\u0006\u0002\u0006\u0001\u0014\u0001\u0006\u0000\u0006\u0003\u0007\u0001\u0000",
        "value": {
          "$array": [
            [
              3,
              "a"
            ],
            [
              "k",
              [
                1,
                [
                  2,
                  [
                    3
                  ]
                ]
              ]
            ],
            [
              -1,
              null
            ]
          ]
        }
      }
    }
  ]
}
