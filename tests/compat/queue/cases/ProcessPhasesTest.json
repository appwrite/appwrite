{
  "source": "packages/queue/tests/ProcessPhasesTest.php",
  "cases": [
    {
      "name": "a failed handler is rejected",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "messages": [
              {
                "pid": "p1",
                "queue": "work",
                "timestamp": 1700000000,
                "payload": {
                  "n": 1
                }
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "jobs": [
              {
                "queue": "work",
                "inject": [
                  "message"
                ],
                "fail": {
                  "class": "RuntimeException",
                  "message": "boom"
                }
              }
            ],
            "hooks": {
              "error": [
                {
                  "inject": [
                    "error",
                    "message"
                  ]
                }
              ]
            }
          },
          "expect": [
            [
              "job:work",
              [
                "message:p1"
              ]
            ],
            [
              "error0",
              [
                "error:RuntimeException:boom",
                "message:p1"
              ]
            ]
          ]
        },
        {
          "op": "memory.log",
          "args": {
            "consumer": {
              "$ref": "c"
            }
          },
          "expect": [
            "receive:1",
            "reject:p1:retry",
            "close"
          ]
        }
      ]
    },
    {
