    {
      "name": "a worker drains a cluster queue",
      "state": [],
      "steps": [
        {
          "op": "connection.new",
          "args": {
            "kind": "cluster"
          },
          "bind": "rc",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "connection.new",
          "args": {
            "kind": "cluster"
          },
          "bind": "cc",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "broker.redis",
          "args": {
            "time": 1700000000,
            "receive": {
              "$ref": "rc"
            },
            "commands": {
              "$ref": "cc"
            },
            "reap_after": 0
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "broker.publish_many",
          "args": {
            "broker": {
              "$ref": "b"
            },
            "queue": {
              "name": "jobs",
              "namespace": "{${ns}}"
            },
            "payloads": [
              {
                "name": "ada"
              },
              {
                "name": "grace"
              }
            ]
          },
          "expect": true
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "b"
            },
            "namespace": "{${ns}}",
            "jobs": [
              {
                "queue": "jobs",
                "params": [
                  {
                    "key": "name"
                  }
                ],
                "inject": [
                  "message"
                ]
              }
            ]
          },
          "expect": [
            [
              "job:jobs",
              [
                "ada",
                "message:pid0001"
              ]
            ],
            [
              "job:jobs",
              [
                "grace",
                "message:pid0002"
              ]
            ]
          ]
        },
        {
          "op": "broker.queue_size",
          "args": {
            "broker": {
              "$ref": "b"
            },
            "queue": {
              "name": "jobs",
              "namespace": "{${ns}}"
            }
          },
          "expect": 0
        }
      ]
