{
  "source": "packages/queue/tests/RedisQueueSizeTest.php",
  "cases": [
    {
      "name": "pending counts only the work queue",
      "steps": [
        {
          "op": "broker.redis",
          "args": {
            "time": 1700000000
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "redis.cmd",
          "args": {
            "args": [
              "RPUSH",
              "${ns}.queue.audits",
              "x0",
              "x1",
              "x2",
              "x3",
              "x4",
              "x5",
              "x6"
            ]
          },
          "expect": 7
        },
        {
          "op": "redis.cmd",
          "args": {
            "args": [
              "RPUSH",
              "${ns}.failed.audits",
              "x0",
              "x1",
              "x2"
            ]
          },
          "expect": 3
        },
        {
          "op": "redis.cmd",
          "args": {
            "args": [
              "RPUSH",
              "${ns}.dead.audits",
              "x0",
              "x1"
            ]
          },
          "expect": 2
        },
        {
          "op": "redis.cmd",
          "args": {
            "args": [
              "RPUSH",
              "${ns}.poison.audits",
              "x0"
            ]
          },
          "expect": 1
        },
        {
          "op": "broker.queue_size",
          "args": {
            "broker": {
              "$ref": "b"
            },
            "queue": {
              "name": "audits",
              "namespace": "${ns}"
            }
          },
          "expect": 7
        }
      ]
    },
