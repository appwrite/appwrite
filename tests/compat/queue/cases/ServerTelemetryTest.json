{
  "source": "packages/queue/tests/ServerTelemetryTest.php",
  "cases": [
    {
      "name": "job wait time stays non-negative when the publisher's clock runs ahead",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "messages": [
              {
                "pid": "skewed-pid",
                "queue": "emails",
                "timestamp": 9999999999,
                "payload": []
              },
              {
                "pid": "normal-pid",
                "queue": "emails",
                "timestamp": 1,
                "payload": []
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "jobs": [
              {
                "queue": "emails",
                "inject": [
                  "message"
                ]
              }
            ],
            "telemetry": true
          },
          "expect": [
            [
              "job:emails",
              [
                "message:skewed-pid"
              ]
            ],
            [
              "job:emails",
              [
                "message:normal-pid"
              ]
            ],
            [
              "telemetry",
              {
                "messaging.process.wait.duration": {
                  "count": 2,
                  "non_negative": true,
                  "attributes": [
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "utopia-queue"
                    },
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "utopia-queue"
                    }
                  ]
                },
                "messaging.process.duration": {
                  "count": 2,
                  "non_negative": true,
                  "attributes": [
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "utopia-queue"
                    },
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "utopia-queue"
                    }
                  ]
                },
                "messaging.process.message.size": {
                  "values": [],
                  "attributes": []
                },
                "messaging.queue.depth": [],
                "messaging.queue.failed.depth": []
              }
            ]
          ]
        }
      ]
    },
    {
      "name": "each recording names the queue its message came from",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "messages": [
              {
                "pid": "shard-1-pid",
                "queue": "database_shard_1",
                "timestamp": 1700000000,
                "payload": []
              },
              {
                "pid": "shard-2-pid",
                "queue": "database_shard_2",
                "timestamp": 1700000000,
                "payload": []
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "jobs": [
              {
                "queue": "database_shard_1",
                "inject": [
                  "message"
                ]
              },
              {
                "queue": "database_shard_2",
                "inject": [
                  "message"
                ]
              }
            ],
            "shared": false,
            "namespace": "appwrite",
            "telemetry": true
          },
          "expect": [
            [
              "job:database_shard_1",
              [
                "message:shard-1-pid"
              ]
            ],
            [
              "job:database_shard_2",
              [
                "message:shard-2-pid"
              ]
            ],
            [
              "telemetry",
              {
                "messaging.process.wait.duration": {
                  "count": 2,
                  "non_negative": true,
                  "attributes": [
                    {
                      "messaging.destination.name": "database_shard_1",
                      "messaging.destination.namespace": "appwrite"
                    },
                    {
                      "messaging.destination.name": "database_shard_2",
                      "messaging.destination.namespace": "appwrite"
                    }
                  ]
                },
                "messaging.process.duration": {
                  "count": 2,
                  "non_negative": true,
                  "attributes": [
                    {
                      "messaging.destination.name": "database_shard_1",
                      "messaging.destination.namespace": "appwrite"
                    },
                    {
                      "messaging.destination.name": "database_shard_2",
                      "messaging.destination.namespace": "appwrite"
                    }
                  ]
                },
                "messaging.process.message.size": {
                  "values": [],
                  "attributes": []
                },
                "messaging.queue.depth": [],
                "messaging.queue.failed.depth": []
              }
            ]
          ]
        }
      ]
    },
    {
      "name": "queue depth is reported per registered queue",
      "steps": [
        {
          "op": "broker.redis",
          "args": {
            "time": 1700000000
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "broker.publish_many",
          "args": {
            "broker": {
              "$ref": "b"
            },
            "queue": {
              "name": "emails",
              "namespace": "${ns}"
            },
            "payloads": [
              {
                "n": 1
              },
              {
                "n": 2
              }
            ]
          },
          "expect": true
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "b"
            },
            "jobs": [
              {
                "queue": "emails",
                "fail": {
                  "class": "RuntimeException",
                  "message": "boom"
                }
              }
            ],
            "namespace": "${ns}",
            "telemetry": true
          },
          "expect": [
            [
              "job:emails",
              []
            ],
            [
              "job:emails",
              []
            ],
            [
              "telemetry",
              {
                "messaging.process.wait.duration": {
                  "count": 2,
                  "non_negative": true,
                  "attributes": [
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    },
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    }
                  ]
                },
                "messaging.process.duration": {
                  "count": 2,
                  "non_negative": true,
                  "attributes": [
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    },
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    }
                  ]
                },
                "messaging.process.message.size": {
                  "values": [
                    75,
                    75
                  ],
                  "attributes": [
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    },
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    }
                  ]
                },
                "messaging.queue.depth": [
                  [
                    0,
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    }
                  ],
                  [
                    0,
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    }
                  ]
                ],
                "messaging.queue.failed.depth": [
                  [
                    2,
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    }
                  ],
                  [
                    2,
                    {
                      "messaging.destination.name": "emails",
                      "messaging.destination.namespace": "${ns}"
                    }
                  ]
                ]
              }
            ]
          ]
        }
      ]
    },
