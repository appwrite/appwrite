    {
      "name": "resources and context are injected",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "messages": [
              {
                "pid": "test-pid",
                "queue": "emails",
                "timestamp": 1700000000,
                "payload": []
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "jobs": [
              {
                "queue": "emails",
                "inject": [
                  "message",
                  "greeting",
                  "contextValue"
                ]
              }
            ],
            "hooks": {
              "init": [
                {
                  "inject": [
                    "message"
                  ],
                  "context": "contextValue"
                }
              ]
            }
          },
          "expect": [
            [
              "init0",
              [
                "message:test-pid"
              ]
            ],
            [
              "job:emails",
              [
                "message:test-pid",
                "hello",
                "test-pid"
              ]
            ]
          ]
        }
      ]
    },
    {
      "name": "context does not leak between messages",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "messages": [
              {
                "pid": "first-pid",
                "queue": "emails",
                "timestamp": 1700000000,
                "payload": []
              },
              {
                "pid": "second-pid",
                "queue": "emails",
                "timestamp": 1700000000,
                "payload": []
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "jobs": [
              {
                "queue": "emails",
                "has": "contextValue"
              }
            ],
            "hooks": {
              "init": [
                {
                  "inject": [
                    "message"
                  ],
                  "context": "contextValue",
                  "when": "first-pid"
                }
              ]
            }
          },
          "expect": [
            [
              "init0",
              [
                "message:first-pid"
              ]
            ],
            [
              "job:emails",
              [
                "first-pid"
              ]
            ],
            [
              "init0",
              [
                "message:second-pid"
              ]
            ],
            [
              "job:emails",
              [
                null
              ]
            ]
          ]
        }
      ]
    },
