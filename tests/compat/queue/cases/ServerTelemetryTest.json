    {
      "name": "consumed message sizes are recorded from the NATS broker",
      "steps": [
        {
          "op": "nats.broker",
          "args": {
            "time": 1700000000,
            "ack_wait": 2.0,
            "max_deliver": 3
          },
          "bind": "n",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "broker.publish",
          "args": {
            "broker": {
              "$ref": "n"
