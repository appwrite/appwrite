{
  "source": "packages/queue/tests/E2E/RedisCodecTest.php",
  "cases": [
    {
      "name": "publish and receive round trip (json)",
      "steps": [
        {
          "op": "broker.redis",
          "args": {
            "time": 1700000000,
            "codec": "json"
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "broker.publish",
          "args": {
            "broker": {
              "$ref": "b"
            },
            "queue": {
              "name": "codec",
              "namespace": "${ns}"
            },
            "payload": {
              "to": "a@example.com",
              "attempt": 1
            }
          },
          "expect": true
        },
        {
          "op": "broker.receive",
          "args": {
            "broker": {
              "$ref": "b"
            },
            "queue": {
              "name": "codec",
              "namespace": "${ns}"
            },
            "timeout": 0
          },
          "expect": {
            "handles": [
              {
                "$handle": "*"
              }
            ],
            "messages": [
              {
                "$array": [
                  [
                    "pid",
                    "pid0001"
                  ],
                  [
                    "queue",
                    "codec"
                  ],
                  [
                    "timestamp",
                    1700000000
                  ],
                  [
                    "payload",
                    {
                      "$array": [
                        [
                          "to",
                          "a@example.com"
                        ],
                        [
                          "attempt",
                          1
                        ]
                      ]
                    }
                  ],
                  [
                    "attempts",
                    0
                  ],
                  [
                    "sequence",
                    null
                  ],
                  [
                    "receipt",
                    "30303030303030303030303030303031"
                  ],
                  [
                    "size",
                    101
                  ]
                ]
              }
            ]
          }
        }
      ]
    },
