{
  "source": "packages/queue/tests/E2E/Base.php",
  "cases": [
    {
      "name": "events: init, job, shutdown in order with groups",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "messages": [
              {
                "pid": "p1",
                "queue": "work",
                "timestamp": 1700000000,
                "payload": {
                  "name": "ada",
                  "n": 3
                }
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "jobs": [
              {
                "queue": "work",
                "groups": [
                  "mails"
                ],
                "params": [
                  {
                    "key": "name"
                  },
                  {
                    "key": "n",
                    "validator": "integer"
                  }
                ],
                "inject": [
                  "message",
                  "greeting"
                ]
              }
            ],
            "hooks": {
              "init": [
                {
                  "inject": [
                    "message"
                  ]
                },
                {
                  "groups": [
                    "mails"
                  ],
                  "params": [
                    {
                      "key": "name"
                    }
                  ]
                },
                {
                  "groups": [
                    "other"
                  ]
                }
              ],
              "shutdown": [
                {
                  "inject": [
                    "message"
                  ]
                },
                {
                  "groups": [
                    "mails"
                  ]
                }
              ]
            }
          },
          "expect": [
            [
              "init0",
              [
                "message:p1"
              ]
            ],
            [
              "init1",
              [
                "ada"
              ]
            ],
            [
              "job:work",
              [
                "ada",
                3,
                "message:p1",
                "hello"
              ]
            ],
            [
              "shutdown0",
              [
                "message:p1"
              ]
            ],
            [
              "shutdown1",
              []
            ]
          ]
        },
        {
          "op": "memory.log",
          "args": {
            "consumer": {
              "$ref": "c"
            }
          },
          "expect": [
            "receive:1",
            "commit:p1",
            "close"
          ]
        }
      ]
    },
    {
