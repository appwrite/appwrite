    {
      "name": "param aliases and defaults",
      "steps": [
        {
          "op": "memory.new",
          "args": {
            "messages": [
              {
                "pid": "p1",
                "queue": "work",
                "timestamp": 1700000000,
                "payload": {
                  "userName": "ada",
                  "empty": "",
                  "nothing": null
                }
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "server.run",
          "args": {
            "consumer": {
              "$ref": "c"
            },
            "jobs": [
              {
                "queue": "work",
                "params": [
                  {
                    "key": "name",
                    "aliases": [
                      "user",
                      "userName"
                    ]
                  },
                  {
                    "key": "empty",
                    "default": "fallback",
                    "optional": true
                  },
                  {
                    "key": "nothing",
                    "default": 7,
                    "validator": "integer",
                    "optional": true
                  },
                  {
                    "key": "missing",
                    "optional": true
                  }
                ]
              }
            ],
            "hooks": {
              "error": [
                {
                  "inject": [
                    "error",
                    "message"
                  ]
                }
              ]
            }
          },
          "expect": [
            [
              "job:work",
              [
                "ada",
                "fallback",
                7,
                null
              ]
            ]
          ]
        },
        {
          "op": "memory.log",
          "args": {
            "consumer": {
              "$ref": "c"
            }
          },
          "expect": [
            "receive:1",
            "commit:p1",
            "close"
          ]
        }
      ]
    },
