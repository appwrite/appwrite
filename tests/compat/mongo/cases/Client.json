    {
      "name": "credentials",
      "steps": [
        {
          "op": "auth.encode_credentials",
          "args": {
            "username": "root",
            "password": "secret"
          },
          "expect": "secret"
        },
        {
          "op": "auth.new",
          "args": {
            "authcid": "us=er,name",
            "secret": "pencil",
            "authzid": "ad,min"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "auth.create_response",
          "args": {
            "auth": {
              "$ref": "a"
            },
            "challenge": "r=x,s=c2FsdA==,i=1"
          },
          "expect": false
        },
        {
          "op": "auth.get_salted_password",
          "args": {
            "auth": {
              "$ref": "a"
            }
          },
          "expect": {
            "$error": {
              "class": "Error",
              "message": "Typed property Utopia\\Mongo\\Auth::$saltedPassword must not be accessed before initialization"
            }
          }
        },
        {
          "op": "auth.get_auth_message",
          "args": {
            "auth": {
              "$ref": "a"
            }
          },
          "expect": {
            "$error": {
              "class": "Error",
              "message": "Typed property Utopia\\Mongo\\Auth::$authMessage must not be accessed before initialization"
            }
          }
        },
