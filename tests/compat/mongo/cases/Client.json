          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": {
              "level": null
            }
          },
          "expect": []
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": {
              "level": true
            }
          },
          "expect": {
            "level": true
          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": {
              "level": 0
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Invalid read concern level: 0"
            }
          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": {
              "afterClusterTime": {
                "$bson": {
                  "$timestamp": {
                    "t": 1,
                    "i": 2
                  }
                }
              }
            }
          },
          "expect": {
            "afterClusterTime": {
              "$bson": {
                "$timestamp": {
                  "t": 1,
                  "i": 2
                }
              }
            }
          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": 5
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Invalid read concern level: 5"
            }
          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": true
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Invalid read concern level: 1"
            }
          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": false
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Invalid read concern level: "
