          },
          "expect": {
            "level": "linearizable"
          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": "snapshot"
          },
          "expect": {
            "level": "snapshot"
          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": "LOCAL"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Invalid read concern level: LOCAL"
