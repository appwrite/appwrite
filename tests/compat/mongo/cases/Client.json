{
  "cases": [
    {
      "name": "write concerns",
      "steps": [
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": "majority"
          },
          "expect": {
            "w": "majority"
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": 1
          },
          "expect": {
            "w": 1
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": 0
          },
          "expect": {
            "w": 0
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": -1
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Write concern w value must be >= 0"
            }
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": []
          },
          "expect": []
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": {
              "w": -1
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Write concern w value must be >= 0"
            }
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": {
              "w": "majority"
            }
          },
          "expect": {
            "w": "majority"
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": {
              "j": 0
            }
          },
          "expect": {
            "j": false
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": {
              "j": "yes"
            }
          },
          "expect": {
            "j": true
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": {
              "wtimeout": -1
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Write concern wtimeout must be a non-negative integer"
            }
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": {
              "wtimeout": "5"
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Write concern wtimeout must be a non-negative integer"
            }
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": {
              "wtimeout": 1.5
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "Write concern wtimeout must be a non-negative integer"
            }
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": {
              "w": null,
              "j": null
            }
          },
          "expect": []
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": true
          },
          "expect": {
            "w": 1
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": false
          },
          "expect": {
            "w": 0
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": 2.0
          },
          "expect": {
            "w": 2
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": 1.5
          },
          "expect": {
            "w": 1
          }
        },
        {
          "op": "client.create_write_concern",
          "args": {
            "concern": [
              "x"
            ]
          },
          "expect": []
        }
      ],
      "state": []
    },
    {
      "name": "read concerns",
      "steps": [
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": "local"
          },
          "expect": {
            "level": "local"
          }
        },
        {
          "op": "client.create_read_concern",
          "args": {
            "concern": "available"
