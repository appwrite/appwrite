  "cases": [
    {
      "name": "testSessionManagement",
      "steps": [
        {
          "op": "client.new",
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.start_session",
          "args": {
            "client": {
              "$ref": "c"
            },
            "options": {
              "causalConsistency": true,
              "defaultTransactionOptions": {
                "readConcern": {
                  "level": "majority"
                },
                "writeConcern": {
                  "w": 1,
                  "j": true
                }
              }
            }
          },
          "bind": "s",
          "expect": {
            "id": "<masked>",
            "sessionId": "<masked>"
          }
        },
        {
          "op": "client.get_session_state",
          "args": {
            "client": {
              "$ref": "c"
            },
            "session": {
              "$ref": "s"
            }
          },
          "expect": {
            "sessionId": "<masked>",
            "state": "none",
            "txnNumber": 0,
            "lastUse": "<masked>",
            "retryableWriteNumber": 0
          }
        },
        {
          "op": "client.end_sessions",
          "args": {
            "client": {
              "$ref": "c"
            },
            "sessions": [
              {
                "$ref": "s"
              }
            ]
          },
          "expect": {
            "$object": {
              "ok": 1.0,
              "$clusterTime": "<masked>",
              "operationTime": "<masked>"
            }
          }
        },
        {
          "op": "client.get_session_state",
          "args": {
            "client": {
              "$ref": "c"
            },
            "session": {
              "$ref": "s"
            }
          },
          "expect": {
            "error": "Session not found"
          }
        }
      ]
    },
