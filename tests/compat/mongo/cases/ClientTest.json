{
  "source": "vendor/utopia-php/mongo/tests/ClientTest.php",
  "cases": [
    {
      "name": "testDecodedMongoCommandErrorDoesNotCloseTransport",
      "steps": [
        {
          "op": "client.new",
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.query",
          "args": {
            "client": {
              "$ref": "c"
            },
            "command": {
              "nonexistent": 1
            },
            "inspect": true
          },
          "expect": {
            "$exception": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "E59 CommandNotFound: no such command: 'nonexistent'",
              "code": 59,
              "transient": false,
              "network": false,
              "retryable_write": false,
              "duplicate_key": false,
              "write_concern": false,
              "unsent": false,
              "timeout": false,
              "error_labels": [],
              "write_errors": null,
              "write_concern_errors": null,
              "operation_type": null,
              "category": "MongoDB Error"
            }
          }
        },
        {
          "op": "client.get_connection_info",
          "args": {
            "client": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "host": "compat-mongo",
            "port": 27017,
            "database": "${ns}",
            "activeSessions": 0,
            "clusterTimeSet": true,
            "operationTimeSet": true
          }
        },
        {
          "op": "client.query",
          "args": {
            "client": {
              "$ref": "c"
            },
            "command": {
              "ping": 1
            }
          },
          "expect": {
            "$error": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "E72 InvalidOptions: afterClusterTime is not allowed for this command"
            }
          }
        }
      ]
    },
    {
      "name": "testPermanentWriteErrorDoesNotCloseTransport",
      "steps": [
        {
          "op": "client.new",
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.insert",
          "args": {
            "client": {
              "$ref": "c"
            },
            "collection": "c",
            "document": {
              "_id": "dup"
            }
          },
          "expect": {
            "_id": "dup"
          }
        },
        {
          "op": "client.insert",
          "args": {
            "client": {
              "$ref": "c"
            },
            "collection": "c",
            "document": {
              "_id": "dup"
            },
            "inspect": true
          },
          "expect": {
            "$exception": {
              "class": "Utopia\\Mongo\\Exception",
              "message": "E11000 duplicate key error collection: ${ns}.c index: _id_ dup key: { _id: \"dup\" }",
              "code": 11000,
              "transient": false,
              "network": false,
              "retryable_write": false,
              "duplicate_key": true,
              "write_concern": false,
              "unsent": false,
              "timeout": false,
              "error_labels": [],
              "write_errors": null,
              "write_concern_errors": null,
              "operation_type": null,
              "category": "Duplicate Key Error"
            }
          }
        },
        {
          "op": "client.get_connection_info",
          "args": {
            "client": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "host": "compat-mongo",
            "port": 27017,
            "database": "${ns}",
            "activeSessions": 0,
            "clusterTimeSet": true,
            "operationTimeSet": true
          }
        },
        {
          "op": "client.count",
          "args": {
            "client": {
              "$ref": "c"
            },
            "collection": "c"
          },
          "expect": 1
        }
      ]
    },
    {
      "name": "testConnectPassesConfiguredTimeout",
      "steps": [
        {
          "op": "client.new",
          "args": {
            "timeout": 5.0,
            "connect_timeout": 2.5
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.get_connection_info",
          "args": {
            "client": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "host": "compat-mongo",
            "port": 27017,
            "database": "${ns}",
            "activeSessions": 0,
            "clusterTimeSet": true,
            "operationTimeSet": true
          }
        },
        {
          "op": "client.new",
          "args": {
            "timeout": 0,
            "connect": false
          },
          "bind": "z",
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Timeout must be greater than 0"
            }
          }
        },
        {
          "op": "client.new",
          "args": {
            "connect_timeout": -1,
            "connect": false
          },
          "bind": "z",
          "expect": {
            "$error": {
              "class": "InvalidArgumentException",
              "message": "Connect timeout must be greater than 0"
            }
          }
        }
      ]
    },
