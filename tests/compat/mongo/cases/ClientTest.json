    {
      "name": "batches, cursors and deletes",
      "steps": [
        {
          "op": "client.new",
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.insert_many",
          "args": {
            "client": {
              "$ref": "c"
            },
            "collection": "b",
            "documents": [
              {
                "_id": 0,
                "n": 0
              },
              {
                "_id": 1,
                "n": 1
              },
              {
                "_id": 2,
                "n": 2
              },
              {
                "_id": 3,
                "n": 0
              },
              {
                "_id": 4,
                "n": 1
              },
              {
                "_id": 5,
                "n": 2
              },
              {
                "_id": 6,
                "n": 0
              }
            ],
            "options": {
              "batchSize": 3,
              "ordered": false
            }
          },
          "expect": [
            {
              "_id": 0,
              "n": 0
            },
            {
              "_id": 1,
              "n": 1
            },
            {
              "_id": 2,
              "n": 2
            },
            {
              "_id": 3,
              "n": 0
            },
            {
              "_id": 4,
              "n": 1
            },
            {
              "_id": 5,
              "n": 2
            },
            {
              "_id": 6,
              "n": 0
            }
          ]
        },
        {
          "op": "client.insert_many",
          "args": {
            "client": {
              "$ref": "c"
            },
            "collection": "b",
            "documents": []
          },
          "expect": []
        },
        {
          "op": "client.find",
          "args": {
            "client": {
              "$ref": "c"
            },
            "collection": "b",
            "options": {
              "batchSize": 2,
              "sort": {
                "_id": 1
              }
