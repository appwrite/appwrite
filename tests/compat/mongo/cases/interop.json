    {
      "name": "a transaction one runtime commits the other reads after",
      "interop": true,
      "steps": [
        {
          "op": "client.new",
          "bind": "a",
          "side": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.new",
          "bind": "b",
          "side": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "client.create_collection",
