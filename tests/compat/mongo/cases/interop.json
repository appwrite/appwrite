            "id": "<masked>",
            "sessionId": "<masked>"
          }
        },
        {
          "op": "client.start_transaction",
          "args": {
            "client": {
              "$ref": "a"
            },
            "session": {
              "$ref": "s"
            }
          },
          "side": "a",
          "expect": true
        },
        {
          "op": "client.insert",
          "args": {
            "client": {
              "$ref": "a"
            },
            "collection": "tx",
