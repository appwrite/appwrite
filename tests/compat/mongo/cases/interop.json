              "$ref": "s"
            }
          },
          "side": "a",
          "expect": {
            "_id": 1
          }
        },
        {
          "op": "client.count",
          "args": {
            "client": {
              "$ref": "b"
            },
            "collection": "tx"
          },
          "side": "b",
          "expect": 1
