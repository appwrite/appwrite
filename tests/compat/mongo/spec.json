      ]
    },
    "client.find": {
      "doc": "$client->find(collection, filters, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::find"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.aggregate": {
      "doc": "$client->aggregate(collection, pipeline, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::aggregate"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.find_and_modify": {
      "doc": "$client->findAndModify(collection, update, remove, filters, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::findAndModify"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.get_more": {
      "doc": "$client->getMore(cursor_id, collection, batch_size?)",
      "covers": [
        "Utopia\\Mongo\\Client::getMore"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.delete": {
      "doc": "$client->delete(collection, filters, limit (1), delete_options, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::delete"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.count": {
      "doc": "$client->count(collection, filters, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::count"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.start_session": {
      "doc": "$client->startSession(options): {id, sessionId}",
      "covers": [
        "Utopia\\Mongo\\Client::startSession"
      ],
      "mask": {
        "paths": [
          "/id",
          "/sessionId"
        ],
        "reason": "session ids are random UUIDs"
      },
      "services": [
        "mongo"
      ]
    },
    "client.start_transaction": {
      "doc": "$client->startTransaction(session, options)",
      "covers": [
        "Utopia\\Mongo\\Client::startTransaction"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.commit_transaction": {
      "doc": "$client->commitTransaction(session, options)",
      "covers": [
        "Utopia\\Mongo\\Client::commitTransaction"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.abort_transaction": {
      "doc": "$client->abortTransaction(session, options)",
      "covers": [
        "Utopia\\Mongo\\Client::abortTransaction"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.end_sessions": {
      "doc": "$client->endSessions(sessions, options)",
      "covers": [
        "Utopia\\Mongo\\Client::endSessions"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.with_transaction": {
      "doc": "$client->withTransaction(session, callback, options), the callback running `callback.steps` (client operations given its session), then returning `callback.return` or throwing `callback.throw` ({message, code}): {result, calls: [<step results> per call]}",
      "covers": [
        "Utopia\\Mongo\\Client::withTransaction"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.is_replica_set": {
      "doc": "$client->isReplicaSet()",
      "covers": [
        "Utopia\\Mongo\\Client::isReplicaSet"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.close": {
      "doc": "$client->close()",
      "covers": [
        "Utopia\\Mongo\\Client::close"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.is_transient_transaction_error": {
      "doc": "(new Client(...))->isTransientTransactionError(new <class>(message, code, ...))",
      "covers": [
        "Utopia\\Mongo\\Client::isTransientTransactionError"
      ],
      "fuzz": [
        {
          "name": "exceptions",
          "args": {
            "gen": "ref",
            "name": "exception"
          },
          "iterations": 500
        }
      ]
    },
    "client.is_unknown_transaction_commit_result": {
      "doc": "(new Client(...))->isUnknownTransactionCommitResult(new <class>(message, code, ...))",
      "covers": [
        "Utopia\\Mongo\\Client::isUnknownTransactionCommitResult"
      ],
      "fuzz": [
        {
          "name": "exceptions",
          "args": {
            "gen": "ref",
            "name": "exception"
          },
          "iterations": 500
        }
      ]
    },
    "client.get_operation_time": {
      "doc": "$client->getOperationTime()",
      "covers": [
        "Utopia\\Mongo\\Client::getOperationTime"
      ],
      "mask": {
        "paths": [
          "/$bson"
        ],
        "reason": "the server's clock"
      },
      "services": [
        "mongo"
      ]
    },
    "client.get_cluster_time": {
      "doc": "$client->getClusterTime()",
      "covers": [
        "Utopia\\Mongo\\Client::getClusterTime"
      ],
      "mask": {
        "paths": [
          "/$object"
        ],
        "reason": "the server's clock and its signature"
      },
      "services": [
        "mongo"
      ]
    },
    "client.get_session_state": {
      "doc": "$client->getSessionState(session)",
      "covers": [
        "Utopia\\Mongo\\Client::getSessionState"
      ],
      "mask": {
        "paths": [
          "/sessionId",
          "/lastUse"
        ],
        "reason": "the session id is a random UUID, its last use the clock"
      },
      "services": [
        "mongo"
      ]
    },
    "client.create_write_concern": {
      "doc": "(new Client(...))->createWriteConcern(concern)",
      "covers": [
        "Utopia\\Mongo\\Client::createWriteConcern"
      ],
      "fuzz": [
        {
          "name": "concerns",
          "args": {
            "gen": "object",
            "fields": {
              "concern": {
                "gen": "ref",
                "name": "write_concern"
              }
            }
          },
          "iterations": 500
        }
      ]
    },
    "client.create_read_concern": {
      "doc": "(new Client(...))->createReadConcern(concern)",
      "covers": [
        "Utopia\\Mongo\\Client::createReadConcern"
      ],
      "fuzz": [
        {
          "name": "concerns",
          "args": {
            "gen": "object",
            "fields": {
              "concern": {
                "gen": "ref",
                "name": "read_concern"
              }
            }
          },
          "iterations": 500
        }
      ]
    },
    "client.get_connection_info": {
      "doc": "$client->getConnectionInfo()",
      "covers": [
        "Utopia\\Mongo\\Client::getConnectionInfo"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.cleanup_stale_sessions": {
      "doc": "$client->cleanupStaleSessions()",
      "covers": [
        "Utopia\\Mongo\\Client::cleanupStaleSessions"
      ],
      "services": [
        "mongo"
      ]
    },
    "exception.new": {
      "doc": "new <class>(message, code, null, error_labels, write_errors, write_concern_errors, operation_type) (BulkWriteException: (message, result, code)), inspected: class, message, code, every is*Error(), getters, getErrorCategory(), getResult()",
      "covers": [
        "Utopia\\Mongo\\Exception::__construct",
        "Utopia\\Mongo\\Exception::isTransientError",
        "Utopia\\Mongo\\Exception::isNetworkError",
        "Utopia\\Mongo\\Exception::isRetryableWrite",
        "Utopia\\Mongo\\Exception::isDuplicateKeyError",
        "Utopia\\Mongo\\Exception::isWriteConcernError",
        "Utopia\\Mongo\\Exception::isUnsentError",
        "Utopia\\Mongo\\Exception::isTimeoutError",
        "Utopia\\Mongo\\Exception::getErrorLabels",
        "Utopia\\Mongo\\Exception::getWriteErrors",
        "Utopia\\Mongo\\Exception::getWriteConcernErrors",
        "Utopia\\Mongo\\Exception::getOperationType",
        "Utopia\\Mongo\\Exception::getErrorCategory",
        "Utopia\\Mongo\\UnsentException::isUnsentError",
        "Utopia\\Mongo\\BulkWriteException::__construct",
        "Utopia\\Mongo\\BulkWriteException::getResult"
      ],
      "fuzz": [
        {
          "name": "exceptions",
          "args": {
            "gen": "ref",
            "name": "exception"
          },
          "iterations": 1000
        }
      ]
    },
    "exception.from_response": {
      "doc": "Exception::fromResponse(response, operation_type), inspected",
      "covers": [
        "Utopia\\Mongo\\Exception::fromResponse"
      ],
      "fuzz": [
        {
          "name": "responses",
          "args": {
            "gen": "object",
            "fields": {
              "response": {
                "gen": "ref",
                "name": "response"
              },
              "operation_type": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "const",
                    "value": null
                  },
                  {
                    "gen": "const",
                    "value": "insert"
                  }
                ]
              }
            }
          },
          "iterations": 500
        }
      ]
    },
    "auth.new": {
      "doc": "new Auth([authcid, secret, authzid, authSource]) (absent keys left out)",
      "covers": [
        "Utopia\\Mongo\\Auth::__construct"
      ]
    },
    "auth.start": {
      "doc": "$auth->start(): [saslStart command, auth source]",
      "covers": [
        "Utopia\\Mongo\\Auth::start"
      ]
    },
    "auth.continue": {
      "doc": "$auth->continue(data {conversationId, payload (a BSON binary)}): [saslContinue command, auth source]",
      "covers": [
        "Utopia\\Mongo\\Auth::continue"
      ]
    },
    "auth.create_response": {
      "doc": "$auth->createResponse(challenge?): the message, or false",
      "covers": [
        "Utopia\\Mongo\\Auth::createResponse"
      ]
    },
    "auth.verify": {
      "doc": "$auth->verify(data)",
      "covers": [
        "Utopia\\Mongo\\Auth::verify"
      ]
    },
    "auth.get_cnonce": {
      "doc": "$auth->getCnonce()",
      "covers": [
        "Utopia\\Mongo\\Auth::getCnonce"
      ]
    },
    "auth.get_salted_password": {
      "doc": "$auth->getSaltedPassword()",
      "covers": [
        "Utopia\\Mongo\\Auth::getSaltedPassword"
      ]
    },
    "auth.get_auth_message": {
      "doc": "$auth->getAuthMessage()",
      "covers": [
        "Utopia\\Mongo\\Auth::getAuthMessage"
      ]
    },
    "auth.encode_credentials": {
      "doc": "Auth::encodeCredentials(username, password)",
      "covers": [
        "Utopia\\Mongo\\Auth::encodeCredentials"
      ],
      "fuzz": [
        {
          "name": "credentials",
          "args": {
            "gen": "object",
            "fields": {
              "username": {
                "gen": "string"
              },
              "password": {
                "gen": "string"
              }
            }
          },
          "iterations": 200
        }
      ]
    },
    "auth.server_first": {
      "doc": "A fixture server's first message for the conversation's nonce: 'r=' . cnonce . suffix . ',s=' . base64(salt) . ',i=' . iterations (4096)"
    }
  },
  "generators": {
    "code": {
      "gen": "one_of",
      "of": [
        {
          "gen": "pick",
          "from": [
            0,
            6,
            7,
            11,
            48,
            50,
            85,
            89,
            91,
            112,
            189,
            251,
            262,
            9001,
            10107,
            11000,
            11001,
            11600,
            11601,
            11602,
            13435,
            13436,
            28764
          ]
        },
        {
          "gen": "int",
          "min": -5,
          "max": 20000
        }
      ]
    },
    "label": {
      "gen": "pick",
      "from": [
        "TransientTransactionError",
        "UnknownTransactionCommitResult",
        "RetryableWriteError",
        "NoWritesPerformed",
        "other"
      ]
    },
    "message": {
      "gen": "one_of",
      "of": [
        {
          "gen": "pick",
          "from": [
            "",
            "connection reset",
            "a timeout",
            "network down",
            "TransientTransactionError",
            "UnknownTransactionCommitResult",
            "E11000 duplicate key",
            "Connection refused"
          ]
        },
        {
          "gen": "string",
          "max": 24
        }
      ]
    },
    "exception": {
      "gen": "object",
      "fields": {
        "class": {
          "gen": "pick",
          "from": [
            "Exception",
            "UnsentException",
            "ConnectionException",
            "AuthenticationException",
            "TransactionException"
          ]
        },
        "message": {
          "gen": "ref",
          "name": "message"
        },
        "code": {
          "gen": "ref",
          "name": "code"
        },
        "error_labels": {
          "gen": "array",
          "items": {
            "gen": "ref",
            "name": "label"
          },
          "max": 3
        },
        "write_concern_errors": {
          "gen": "one_of",
          "of": [
            {
              "gen": "const",
              "value": null
            },
            {
              "gen": "const",
              "value": []
            },
            {
              "gen": "const",
              "value": [
                {
                  "code": 64,
                  "errmsg": "waiting for replication timed out"
                }
              ]
            }
          ]
        },
        "operation_type": {
          "gen": "one_of",
          "of": [
            {
              "gen": "const",
              "value": null
            },
            {
              "gen": "const",
              "value": "update"
            }
          ]
        }
      }
    },
    "response": {
      "gen": "object",
      "fields": {
        "errmsg": {
          "gen": "ref",
          "name": "message"
        },
        "code": {
          "gen": "ref",
          "name": "code"
        },
        "errorLabels": {
          "gen": "array",
          "items": {
            "gen": "ref",
            "name": "label"
          },
          "max": 3
        }
      }
    },
    "concern_level": {
      "gen": "one_of",
      "of": [
        {
          "gen": "pick",
          "from": [
            "local",
            "available",
            "majority",
            "linearizable",
            "snapshot",
            "LOCAL",
            "",
            "invalid"
          ]
        },
        {
          "gen": "string",
          "max": 12
        }
      ]
    },
    "write_concern": {
      "gen": "one_of",
      "of": [
        {
          "gen": "ref",
          "name": "concern_level"
        },
        {
          "gen": "int",
          "min": -3,
          "max": 5
        },
        {
          "gen": "object",
          "fields": {
            "w": {
              "gen": "one_of",
              "of": [
                {
                  "gen": "int",
                  "min": -2,
                  "max": 3
                },
                {
                  "gen": "const",
                  "value": "majority"
                },
                {
                  "gen": "const",
                  "value": null
                }
              ]
            },
            "j": {
              "gen": "one_of",
              "of": [
                {
                  "gen": "bool"
                },
                {
                  "gen": "int",
                  "min": 0,
                  "max": 2
                },
                {
                  "gen": "const",
                  "value": "yes"
                },
                {
                  "gen": "const",
                  "value": ""
                }
              ]
            },
            "wtimeout": {
              "gen": "one_of",
              "of": [
                {
                  "gen": "int",
                  "min": -5,
                  "max": 10000
                },
                {
                  "gen": "const",
                  "value": "100"
                },
                {
                  "gen": "const",
