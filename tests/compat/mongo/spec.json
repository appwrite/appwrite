      ]
    },
    "client.list_collection_names": {
      "doc": "$client->listCollectionNames(filter, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::listCollectionNames"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.create_indexes": {
      "doc": "$client->createIndexes(collection, indexes, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::createIndexes"
      ],
      "services": [
