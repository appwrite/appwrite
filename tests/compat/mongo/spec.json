{
  "lib": "mongo",
  "description": "utopia-php/mongo 1.5: the MongoDB client (commands, CRUD, indexes, collections, sessions and transactions with causal consistency), its SCRAM-SHA-256 conversation and its exceptions, on the official Rust driver. Values cross as JSON: a document PHP decodes as stdClass (a server reply) is {\"$object\": {...}} ({} when empty), a PHP array a plain object, any other BSON type {\"$bson\": <canonical extended JSON>}. A client operation with `inspect: true` returns a Utopia\\Mongo\\Exception it throws as {\"$exception\": {class, message, code, ...}}, so codes are compared too.",
  "complete": true,
  "php": {
    "src": [
      "vendor/utopia-php/mongo/src"
    ],
    "tests": [
      "vendor/utopia-php/mongo/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/mongo"
  },
  "services": [
    "mongo"
  ],
  "state": [
    "mongo@mongo"
  ],
  "state_mask": {
    "mongo@mongo": {
      "paths": [
        "/*/*/documents/*/_id/$oid"
      ],
      "reason": "the server makes an ObjectId (its clock, a random value and a counter) for a document upserted without an _id"
    }
  },
  "scrub": [
    {
      "kind": "uuid7",
      "reason": "documents inserted without an _id get a UUIDv7 made from the clock and random bits"
    }
  ],
  "ops": {
    "client.new": {
      "doc": "new Client(database (${ns}), host, port, user, password (the `mongo` service), useCoroutine: false, tls, authSource, timeout, connectTimeout), then connect() unless connect is false",
      "covers": [
        "Utopia\\Mongo\\Client::__construct"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.connect": {
      "doc": "$client->connect(): {\"$client\": true}",
      "covers": [
        "Utopia\\Mongo\\Client::connect"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.get_host": {
      "doc": "$client->getHost()",
      "covers": [
        "Utopia\\Mongo\\Client::getHost"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.create_uuid": {
      "doc": "$client->createUuid()",
      "covers": [
        "Utopia\\Mongo\\Client::createUuid"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.select_database": {
      "doc": "$client->selectDatabase()",
      "covers": [
        "Utopia\\Mongo\\Client::selectDatabase"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.create_database": {
      "doc": "$client->createDatabase()",
      "covers": [
        "Utopia\\Mongo\\Client::createDatabase"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.select_collection": {
      "doc": "$client->selectCollection(name)",
      "covers": [
        "Utopia\\Mongo\\Client::selectCollection"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.query": {
      "doc": "$client->query(command (+ session), db)",
      "covers": [
        "Utopia\\Mongo\\Client::query"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.list_database_names": {
      "doc": "$client->listDatabaseNames(), keeping the run's databases (${ns}, ${ns}_*) and admin, config, local",
      "covers": [
        "Utopia\\Mongo\\Client::listDatabaseNames"
      ],
      "mask": {
        "paths": [
          "/$object/$clusterTime",
          "/$object/operationTime"
        ],
        "reason": "a reply carries the server's cluster and operation times"
      },
      "services": [
        "mongo"
      ]
    },
    "client.drop_database": {
      "doc": "$client->dropDatabase(options, db)",
      "covers": [
        "Utopia\\Mongo\\Client::dropDatabase"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.create_collection": {
      "doc": "$client->createCollection(name, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::createCollection"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.drop_collection": {
      "doc": "$client->dropCollection(name, options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::dropCollection"
      ],
      "services": [
