        "Utopia\\Mongo\\Client::update"
      ],
      "services": [
        "mongo"
      ]
    },
    "client.upsert": {
      "doc": "$client->upsert(collection, operations [{filter, update, multi?}], options (+ session))",
      "covers": [
        "Utopia\\Mongo\\Client::upsert"
      ],
      "services": [
