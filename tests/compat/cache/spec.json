  "quirks": [
    {
      "symbol": "Utopia\\Cache\\Cache::save",
      "description": "Cache.php and the Redis-protocol adapters are not strict_types, so a value that is neither string nor array is coerced at the `array|string $data` boundary: integers, floats and booleans are stored as strings (`1` reads back as \"1\", `false` as \"\"), saveMany() field values included.",
      "case": "RedisTest.json#retries, names, folded batch fields, reserved fields and odd values"
    },
    {
      "symbol": "Utopia\\Cache\\Adapter\\Filesystem::flush",
      "description": "flush() deletes the root directory itself, and throws \"Error happened during glob\" when the root (or any subdirectory) is empty, and \"<path> must be a directory\" when it is missing.",
      "case": "FilesystemTest.json#flushing an empty or missing directory fails"
    },
    {
      "symbol": "Utopia\\Cache\\Adapter\\Filesystem::save",
      "description": "An array is written as its items' strings joined (nested arrays as \"Array\"); an object item makes file_put_contents write the rest and then throw Error; data whose string form is empty writes an empty file and reports false.",
      "case": "FilesystemTest.json#paths, nested keys, arrays and edge cases"
    },
    {
      "symbol": "Utopia\\Cache\\Adapter\\Memory::save",
      "description": "The key \"0\" and data that is empty() (including the string \"0\") are never stored.",
      "case": "MemoryTest.json#blank keys and empty data are not stored"
    },
    {
      "symbol": "Utopia\\Cache\\Adapter\\Redis::load",
      "description": "phpredis turns a server error reply into false, so the Redis adapter reads a wrongly typed key as a miss, while the multiplexing adapter raises the reply as RedisException.",
      "case": "MultiplexingTest.json#wrong type replies raise"
    },
    {
      "symbol": "Utopia\\Cache\\Envelope::decode",
      "description": "Stored data that is false or null is a miss (isset() and the false return value cannot tell them apart).",
      "case": "EnvelopeTest.json#false data, overflowing time, unencodable data"
    },
    {
      "symbol": "Utopia\\Cache\\Adapter\\RedisCluster::list",
      "description": "Unlike Redis, the cluster adapter has no leases and does not hide or protect the reserved __utopia_gen__/__utopia_tomb__ fields.",
      "case": "RedisClusterTest.json#names, seeds, retries, batches and field purges"
    }
  ],
