{
  "lib": "cache",
  "description": "utopia-php/cache: the Cache facade over Memory, None, Filesystem, Redis (leases, multiplexing), Redis Cluster, Memcached, Hazelcast, Sharding, Pool and CircuitBreaker adapters; codecs, envelopes and RESP.",
  "complete": true,
  "php": {
    "src": [
      "packages/cache/src"
    ],
    "tests": [
      "packages/cache/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/cache"
  },
  "services": [
    "cache-redis",
    "cache-redis-shared",
    "cache-redis-mux",
    "cache-shard-a",
    "cache-shard-b",
    "cache-shard-c",
    "cache-memcached",
    "cache-hazelcast",
    "cache-cluster"
  ],
  "state": [
    "redis@cache-redis/11,6",
    "files"
  ],
  "ops": {
    "memory.new": {
      "doc": "new Memory()"
    },
    "none.new": {
      "doc": "new None()"
    },
    "filesystem.new": {
      "doc": "new Filesystem(path)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Filesystem::__construct"
      ]
    },
    "filesystem.path": {
      "doc": "new Filesystem(path)->getPath(key)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Filesystem::getPath"
      ]
    },
    "filesystem.stream": {
      "doc": "new Filesystem(path, streaming: true)->load(key, ttl), read to the end (false on a miss)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Filesystem::load"
      ]
    },
    "redis.new": {
      "doc": "new Redis(phpredis on service/db, codec?) with setMaxRetries(retries?), setRetryDelay(delay?), setLeaseGraceWindow(grace?)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Redis::__construct",
        "Utopia\\Cache\\Adapter\\Redis::setMaxRetries",
        "Utopia\\Cache\\Adapter\\Redis::setRetryDelay",
        "Utopia\\Cache\\Adapter\\Redis\\Leasable::__construct",
        "Utopia\\Cache\\Adapter\\Redis\\Leasable::setLeaseGraceWindow"
      ]
    },
    "memcached.new": {
      "doc": "new Memcached(client of service) with setMaxRetries(retries?), setRetryDelay(delay?)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Memcached::__construct",
        "Utopia\\Cache\\Adapter\\Memcached::setMaxRetries",
        "Utopia\\Cache\\Adapter\\Memcached::setRetryDelay"
      ]
    },
    "hazelcast.new": {
      "doc": "new Hazelcast(client of service, codec?) with setMaxRetries(retries?), setRetryDelay(delay?)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Hazelcast::__construct",
        "Utopia\\Cache\\Adapter\\Hazelcast::setMaxRetries",
        "Utopia\\Cache\\Adapter\\Hazelcast::setRetryDelay"
      ]
    },
    "cluster.new": {
      "doc": "new RedisCluster(new \\RedisCluster(seeds of cache-cluster), seeds, name?, codec?) with setMaxRetries(retries?), setRetryDelay(delay?)",
      "covers": [
        "Utopia\\Cache\\Adapter\\RedisCluster::__construct",
        "Utopia\\Cache\\Adapter\\RedisCluster::setMaxRetries",
        "Utopia\\Cache\\Adapter\\RedisCluster::setRetryDelay"
      ]
    },
    "cluster.info": {
      "doc": "{name: getClusterName(), seeds: getSeeds()}",
      "covers": [
        "Utopia\\Cache\\Adapter\\RedisCluster::getClusterName",
        "Utopia\\Cache\\Adapter\\RedisCluster::getSeeds"
      ]
    },
    "sharding.new": {
      "doc": "new Sharding([adapters])",
      "covers": [
        "Utopia\\Cache\\Adapter\\Sharding::__construct"
      ]
    },
    "pool.new": {
      "doc": "new Pool(new UtopiaPool(new Stack(), size, fn => new Filesystem(path)))",
      "covers": [
        "Utopia\\Cache\\Adapter\\Pool::__construct"
      ]
    },
    "circuit_breaker.new": {
      "doc": "new CircuitBreaker(adapter, new UtopiaCircuitBreaker(minimumThroughput?))",
      "covers": [
        "Utopia\\Cache\\Adapter\\CircuitBreaker::__construct"
      ]
    },
    "failing.new": {
      "doc": "fixture: CircuitBreakerTest's FailingAdapter (every operation throws)"
    },
    "counting_failing.new": {
      "doc": "fixture: CircuitBreakerTest's CountingFailingAdapter"
    },
    "counting_failing.loads": {
      "doc": "fixture: loads that reached a CountingFailingAdapter"
    },
    "probe.new": {
      "doc": "fixture: TelemetryTest's Memory adapter recording setTelemetry calls"
    },
    "probe.calls": {
      "doc": "fixture: {calls, same}: setTelemetry calls on a probe and whether it holds `telemetry`"
    },
    "null_load.new": {
      "doc": "fixture: LoadResultsTelemetryTest's Memory adapter whose load returns null"
    },
    "telemetry.new": {
      "doc": "fixture: a Test telemetry adapter recording every data point's attributes"
    },
    "telemetry.dump": {
      "doc": "fixture: recorded data points by \"kind:name\" (histogram values zeroed)"
    },
