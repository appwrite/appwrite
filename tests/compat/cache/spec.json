        "Utopia\\Cache\\Adapter\\Filesystem::getName",
        "Utopia\\Cache\\Adapter\\Redis::getName",
        "Utopia\\Cache\\Adapter\\Hazelcast::getName",
        "Utopia\\Cache\\Adapter\\Memcached::getName",
        "Utopia\\Cache\\Adapter\\Sharding::getName",
