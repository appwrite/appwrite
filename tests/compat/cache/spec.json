        "Utopia\\Cache\\Adapter\\RedisCluster::getName",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::getName"
      ]
    },
    "adapter.retry": {
      "doc": "{max: getMaxRetries(), delay: getRetryDelay()}",
      "covers": [
        "Utopia\\Cache\\Adapter\\Redis::getMaxRetries",
        "Utopia\\Cache\\Adapter\\Redis::getRetryDelay",
        "Utopia\\Cache\\Adapter\\Memcached::getMaxRetries",
        "Utopia\\Cache\\Adapter\\Memcached::getRetryDelay",
        "Utopia\\Cache\\Adapter\\Hazelcast::getMaxRetries",
        "Utopia\\Cache\\Adapter\\Hazelcast::getRetryDelay",
