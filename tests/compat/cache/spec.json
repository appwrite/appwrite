    {
      "symbol": "Utopia\\Cache\\Adapter\\Filesystem::__construct",
      "php": "`$streaming = true` makes load() return an open stream resource instead of the contents.",
      "reason": "A load returns a value; Rust exposes the stream as Filesystem::open(), which the streaming cases use."
    },
    {
      "symbol": "Utopia\\Cache\\Adapter\\Redis\\NoScript::from",
      "php": "The signal keeps the RedisException it was made from as getPrevious().",
      "reason": "utopia_cache::Error::NoScript carries the message only; the signal never leaves the lease dispatch."
    },
    {
      "symbol": "Utopia\\Cache\\Cache::save",
      "php": "A TypeError for null or object data names the calling file and line (\"called in ... on line N\").",
      "reason": "Rust reports the same TypeError class and argument description without a PHP call site."
    },
    {
      "symbol": "Utopia\\Cache\\Cache::load",
      "php": "Keys and hashes are byte strings.",
      "reason": "Rust keys are &str (UTF-8); every key PHP lower-cases stays UTF-8."
    },
    {
      "symbol": "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::__construct",
      "php": "`$idleGrace` bounds how long the reader coroutine stays parked on an idle connection before retiring (a Swoole worker cannot exit while it waits).",
      "reason": "The Rust reader is a parked tokio task that costs nothing idle; it lives as long as the connection. idleGrace is validated the same way."
    }
  ],
