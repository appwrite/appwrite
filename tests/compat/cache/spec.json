      "covers": [
        "Utopia\\Cache\\Cache::setTelemetry"
      ]
    },
    "adapter.set_telemetry": {
      "doc": "$adapter->setTelemetry(telemetry)",
      "covers": [
        "Utopia\\Cache\\Adapter\\CircuitBreaker::setTelemetry"
      ]
    },
