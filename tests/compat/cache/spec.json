      ]
    },
    "multiplexing.run": {
      "doc": "steps (cache methods, sleep, concurrent, load_equals: whether a load == data) on a Cache over a new Multiplexing(host, port, options) in one coroutine scheduler, then disconnect(); each step's result or error",
      "covers": [
        "Utopia\\Cache\\Adapter\\Redis\\Client::__construct",
        "Utopia\\Cache\\Adapter\\Redis\\Client::close",
        "Utopia\\Cache\\Adapter\\Redis\\Client::command",
        "Utopia\\Cache\\Adapter\\Redis\\Client::recv",
        "Utopia\\Cache\\Adapter\\Redis\\Client::send",
        "Utopia\\Cache\\Adapter\\Redis\\Client::takeBuffer",
        "Utopia\\Cache\\Adapter\\Redis\\Client::timedOut",
        "Utopia\\Cache\\Adapter\\Redis\\ConnectionContext::__construct",
        "Utopia\\Cache\\Adapter\\Redis\\ConnectionContext::idleFor",
        "Utopia\\Cache\\Adapter\\Redis\\ConnectionContext::recordProgress",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::__construct",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::disconnect",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::flush",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::getName",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::getSize",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::list",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::load",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::loadMany",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::ping",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::save",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::saveMany",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::setTelemetry",
        "Utopia\\Cache\\Adapter\\Redis\\Multiplexing::touch"
      ]
    },
    "codec.encode": {
      "doc": "$codec->encode(value)",
      "covers": [
        "Utopia\\Cache\\Codec\\Json::encode",
        "Utopia\\Cache\\Codec\\Igbinary::encode",
        "Utopia\\Cache\\Codec\\Igbinary::__construct"
      ],
      "fuzz": [
        {
          "name": "values",
          "iterations": 400,
          "args": {
            "gen": "object",
            "fields": {
              "codec": {
                "gen": "pick",
                "from": [
                  "json",
                  "igbinary"
                ]
              },
              "value": {
                "gen": "ref",
                "name": "value"
              }
            }
          }
        }
      ]
    },
    "codec.decode": {
      "doc": "$codec->decode(bytes)",
      "covers": [
        "Utopia\\Cache\\Codec\\Json::decode",
        "Utopia\\Cache\\Codec\\Igbinary::decode"
      ],
      "fuzz": [
        {
          "name": "json text",
          "iterations": 400,
          "args": {
            "gen": "object",
            "fields": {
              "codec": {
                "gen": "const",
                "value": "json"
              },
              "bytes": {
                "gen": "ref",
                "name": "bytes"
              }
            }
          }
        }
      ]
    },
    "envelope.encode": {
      "doc": "new Envelope(codec)->encode(data, time)",
      "covers": [
        "Utopia\\Cache\\Envelope::__construct",
        "Utopia\\Cache\\Envelope::encode"
      ],
      "fuzz": [
        {
          "name": "values",
          "iterations": 300,
          "args": {
            "gen": "object",
            "fields": {
              "codec": {
                "gen": "pick",
                "from": [
                  "json",
                  "igbinary"
                ]
              },
              "data": {
                "gen": "ref",
                "name": "value"
              },
              "time": {
                "gen": "int",
                "min": -10,
                "max": 2000000000
              }
            }
          }
        }
      ]
    },
    "envelope.decode": {
      "doc": "new Envelope(codec)->decode(value, ttl, now)",
      "covers": [
        "Utopia\\Cache\\Envelope::decode"
      ],
      "fuzz": [
        {
          "name": "stored bytes",
          "iterations": 400,
          "args": {
            "gen": "object",
            "fields": {
              "value": {
                "gen": "ref",
                "name": "bytes"
              },
              "ttl": {
                "gen": "int",
                "min": -5,
                "max": 100
              },
              "now": {
                "gen": "int",
                "min": -5,
                "max": 100
              }
            }
          }
        }
      ]
    },
    "envelope.touch": {
      "doc": "new Envelope(codec)->touch(value, time)",
      "covers": [
        "Utopia\\Cache\\Envelope::touch"
      ]
    },
    "resp.encode": {
      "doc": "Client::encode(args)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Redis\\Client::encode"
      ],
      "fuzz": [
        {
          "name": "commands",
          "iterations": 200,
          "args": {
            "gen": "object",
            "fields": {
              "args": {
                "gen": "array",
                "items": {
                  "gen": "one_of",
                  "of": [
                    {
                      "gen": "ref",
                      "name": "text"
                    },
                    {
                      "gen": "int",
                      "min": -1000,
                      "max": 1000
                    }
                  ]
                },
                "min": 0,
                "max": 6
              }
            }
          }
        }
      ]
    },
    "resp.parse": {
      "doc": "Client::parse(buffer, offset): {value, offset} (INCOMPLETE as {\"$incomplete\": true}, error frames as {\"$redis_error\"})",
      "covers": [
        "Utopia\\Cache\\Adapter\\Redis\\Client::parse",
        "Utopia\\Cache\\Adapter\\Redis\\RedisError::__construct"
      ],
      "fuzz": [
        {
          "name": "frames",
          "iterations": 400,
          "args": {
            "gen": "object",
            "fields": {
              "buffer": {
                "gen": "ref",
                "name": "frame"
              }
            }
          }
        }
      ]
    },
    "resp.unwrap": {
      "doc": "Client::unwrap(value) ({\"$redis_error\"} / {\"$connection_error\"} build RedisError / ConnectionError)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Redis\\Client::unwrap",
        "Utopia\\Cache\\Adapter\\Redis\\ConnectionError::__construct"
      ]
    },
    "noscript.matches": {
      "doc": "NoScript::matches(error)",
      "covers": [
        "Utopia\\Cache\\Adapter\\Redis\\NoScript::matches"
      ],
      "fuzz": [
        {
          "name": "errors",
          "iterations": 200,
          "args": {
            "gen": "object",
            "fields": {
              "error": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "ref",
                    "name": "text"
                  },
                  {
                    "gen": "concat",
                    "parts": [
                      {
                        "gen": "pick",
                        "from": [
                          "NOSCRIPT",
                          "NOSCRIPT ",
                          " NOSCRIPT",
                          "ERR "
                        ]
                      },
                      {
                        "gen": "ref",
                        "name": "text"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "noscript.from": {
      "doc": "NoScript::from(message or new RedisException(message)): {message, previous}",
      "covers": [
        "Utopia\\Cache\\Adapter\\Redis\\NoScript::from"
      ]
    },
