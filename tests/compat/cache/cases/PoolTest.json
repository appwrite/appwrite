    {
      "name": "testLeaseFallbackForNonLeasableAdapter",
      "steps": [
        {
          "op": "pool.new",
          "args": {
            "path": "/tmp/compat-fs/${ns}/pool",
            "size": 10
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.generation",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "lease:fallback"
          },
          "expect": "0"
        },
        {
          "op": "cache.save_with_lease",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "lease:fallback",
            "data": "value",
            "hash": "lease:fallback",
            "generation": "0"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "lease:fallback",
            "ttl": 60,
            "hash": "lease:fallback"
          },
          "expect": "value"
        },
        {
          "op": "cache.load_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "lease:fallback",
            "ttl": 60
          },
          "expect": {}
        },
        {
          "op": "cache.save_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "lease:fallback",
            "data": [
              [
                "a",
                "b"
              ]
            ]
          },
          "expect": false
        },
        {
          "op": "cache.list",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "x"
          },
          "expect": []
        },
        {
          "op": "adapter.name",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": "filesystem"
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "lease:fallback"
          },
          "expect": true
        }
      ],
      "state": [
        "files"
      ]
    }
  ]
