          },
          "expect": "Earth"
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "PLaNEt"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "planet",
            "ttl": 7776000,
            "hash": "planet"
          },
          "expect": false
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "PLANET",
            "ttl": 7776000,
            "hash": "PLANET"
          },
          "expect": false
        }
      ],
      "state": [
        "files"
      ]
    },
    {
      "name": "testCaseSensitivity",
      "requires": [
        "case-sensitive-files"
      ],
      "steps": [
        {
          "op": "pool.new",
          "args": {
            "path": "/tmp/compat-fs/${ns}/pool",
            "size": 10
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.set_case_sensitivity",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "value": true
          },
          "expect": true
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "color",
            "data": "pink",
            "hash": "color"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "color",
            "ttl": 7776000,
            "hash": "color"
          },
          "expect": "pink"
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "COLOR",
            "ttl": 7776000,
            "hash": "COLOR"
          },
          "expect": false
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "color"
          },
          "expect": true
        },
        {
          "op": "cache.set_case_sensitivity",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "value": false
          },
          "expect": false
        },
        {
          "op": "cache.case_sensitive",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": false
        }
      ],
      "state": [
        "files"
      ]
    },
    {
      "name": "testFlush",
      "steps": [
        {
          "op": "pool.new",
          "args": {
            "path": "/tmp/compat-fs/${ns}/pool",
            "size": 10
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "x",
            "data": "x",
            "hash": "x"
          },
          "expect": true
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "y",
            "data": "y",
            "hash": "y"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "x",
            "ttl": 100,
            "hash": "x"
          },
          "expect": "x"
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "y",
            "ttl": 100,
            "hash": "y"
          },
          "expect": "y"
        },
        {
          "op": "cache.flush",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "x",
            "ttl": 100,
            "hash": "x"
          },
          "expect": false
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "y",
            "ttl": 100,
            "hash": "y"
          },
          "expect": false
        }
      ],
      "state": [
        "files"
      ]
    },
