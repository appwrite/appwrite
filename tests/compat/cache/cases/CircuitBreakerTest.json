{
  "source": "packages/cache/tests/CircuitBreakerTest.php",
  "cases": [
    {
      "name": "testPassesThroughHealthyCacheOperations",
      "steps": [
        {
          "op": "memory.new",
          "args": {},
          "bind": "m",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "circuit_breaker.new",
          "args": {
            "adapter": {
              "$ref": "m"
            }
          },
          "bind": "cb",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.save",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "data": "value"
          },
          "expect": true
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "ttl": 60
          },
          "expect": "value"
        },
        {
          "op": "adapter.touch",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key"
          },
          "expect": true
        },
        {
          "op": "adapter.size",
          "args": {
            "adapter": {
              "$ref": "cb"
            }
          },
          "expect": 1
        },
        {
          "op": "adapter.ping",
          "args": {
            "adapter": {
              "$ref": "cb"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.purge",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key"
          },
          "expect": true
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "ttl": 60
          },
          "expect": false
        },
        {
          "op": "adapter.list",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key"
          },
          "expect": []
        },
        {
          "op": "adapter.flush",
          "args": {
            "adapter": {
              "$ref": "cb"
            }
          },
          "expect": true
        },
        {
          "op": "adapter.name",
          "args": {
            "adapter": {
              "$ref": "cb"
            }
          },
          "expect": "memory"
        },
        {
          "op": "adapter.load_many",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "ttl": 60
          },
          "expect": {}
        },
        {
          "op": "adapter.save_many",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "data": [
              [
                "a",
                "b"
              ]
            ]
          },
          "expect": false
        },
        {
          "op": "adapter.generation",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key"
          },
          "expect": "0"
        },
        {
          "op": "adapter.save_with_lease",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "data": "v",
            "hash": "key",
            "generation": "0"
          },
          "expect": true
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "ttl": 60
          },
          "expect": "v"
        }
      ]
    },
    {
      "name": "testReturnsFallbacksWhenCacheOperationsFail",
      "steps": [
        {
          "op": "failing.new",
          "args": {},
          "bind": "f",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "circuit_breaker.new",
          "args": {
            "adapter": {
              "$ref": "f"
            },
            "minimum_throughput": 1
          },
          "bind": "cb",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "ttl": 60
          },
          "expect": false
        }
      ]
    },
