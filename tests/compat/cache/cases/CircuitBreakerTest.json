    {
      "name": "testTelemetryCanBeAttachedAfterConstruction",
      "steps": [
        {
          "op": "memory.new",
          "args": {},
          "bind": "m",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "circuit_breaker.new",
          "args": {
            "adapter": {
              "$ref": "m"
            }
          },
          "bind": "cb",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "telemetry.new",
          "args": {},
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.set_telemetry",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": null
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "missing",
            "ttl": 60
          },
          "expect": false
        },
        {
          "op": "telemetry.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "counter:breaker.calls": [
              {
                "value": 1,
                "attributes": {
                  "circuit_breaker.name": "default",
                  "circuit_breaker.initial_state": "closed",
                  "circuit_breaker.state": "closed",
                  "circuit_breaker.outcome": "success"
                }
              }
            ]
          }
        }
      ]
    },
    {
