        {
          "op": "probe.calls",
          "args": {
            "adapter": {
              "$ref": "p"
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "calls": 1,
            "same": true
          }
        }
      ]
    },
    {
      "name": "testCacheTelemetryDoesNotPropagateThroughSharding",
      "steps": [
        {
          "op": "memory.new",
          "args": {},
          "bind": "m",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "circuit_breaker.new",
          "args": {
            "adapter": {
              "$ref": "m"
            }
          },
          "bind": "cb",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "sharding.new",
          "args": {
            "adapters": [
              {
                "$ref": "cb"
              }
            ]
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "s"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "telemetry.new",
          "args": {},
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.set_telemetry",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": null
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "key",
            "data": "value"
          },
          "expect": true
        },
        {
          "op": "telemetry.dump",
          "args": {
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": {
            "histogram:cache.operation.duration": [
              {
                "value": 0,
                "attributes": {
                  "operation": "save",
                  "adapter": "memory"
                }
              }
            ]
          }
        }
      ]
