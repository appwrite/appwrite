          "args": {},
          "bind": "f",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "circuit_breaker.new",
          "args": {
            "adapter": {
              "$ref": "f"
            },
            "minimum_throughput": 1
          },
          "bind": "cb",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "key": "key",
            "ttl": 60
          },
          "expect": false
