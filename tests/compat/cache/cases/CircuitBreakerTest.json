    {
      "name": "testOpenCircuitRejectsCoordinationWithoutCallingTheBackend (getVersion)",
      "steps": [
        {
          "op": "coordination.new",
          "args": {},
          "bind": "m",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.version",
          "args": {
            "adapter": {
              "$ref": "m"
            },
            "key": "key"
          },
          "bind": "v",
          "mask": {
            "paths": [
              ""
            ],
            "reason": "versions are random identities"
          },
          "expect": "<masked>"
