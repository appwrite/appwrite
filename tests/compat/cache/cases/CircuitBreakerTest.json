      "steps": [
        {
          "op": "probe.new",
          "args": {},
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "circuit_breaker.new",
          "args": {
            "adapter": {
              "$ref": "p"
            }
          },
          "bind": "cb",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "telemetry.new",
          "args": {},
          "bind": "t",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.set_telemetry",
          "args": {
            "adapter": {
              "$ref": "cb"
            },
            "telemetry": {
              "$ref": "t"
            }
          },
          "expect": null
