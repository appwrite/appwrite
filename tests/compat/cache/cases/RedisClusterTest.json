    {
      "name": "names, seeds, retries, batches and field purges",
      "steps": [
        {
          "op": "cluster.new",
          "args": {
            "name": "main",
            "retries": 2,
            "delay": 5
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cluster.info",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "mask": {
            "paths": [
              "/seeds"
            ],
            "reason": "each runtime reaches its own cluster through its own seed addresses"
          },
          "expect": {
            "name": "main",
            "seeds": "<masked>"
          }
        },
        {
          "op": "adapter.retry",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "max": 2,
            "delay": 5
          }
        },
        {
          "op": "adapter.name",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": "redis-cluster"
        },
        {
          "op": "cache.set_case_sensitivity",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "value": true
          },
          "expect": true
        },
        {
          "op": "cache.save_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:m",
            "data": [
              [
                "a",
                1
              ],
              [
                "b",
                {
                  "x": [
                    1,
                    2
                  ]
                }
              ],
              [
                "__utopia_gen__",
                "kept"
              ]
            ],
            "ttl": 60
          },
          "expect": true
        },
        {
          "op": "cache.load_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:m",
            "ttl": 60
          },
          "expect": {
            "a": "1",
            "b": {
              "$array": [
                [
                  "x",
                  [
                    1,
                    2
                  ]
                ]
              ]
            },
            "__utopia_gen__": "kept"
          }
        },
        {
          "op": "cache.load_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
