{
  "source": "packages/cache/tests/NoneTest.php",
  "cases": [
    {
      "name": "testGetSize, testEmptyCacheKey, testCacheSave, testCacheLoad, testNotEmptyCacheKey",
      "steps": [
        {
          "op": "none.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.size",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": 0
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache",
            "ttl": 7776000
          },
          "expect": false
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache",
            "data": "test data string"
          },
          "expect": false
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache",
            "ttl": 7776000
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testCachePurge, testCacheTouch, testPing, testFlush",
      "steps": [
        {
          "op": "none.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache"
          },
          "expect": false
        },
        {
          "op": "cache.ping",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": true
        },
        {
          "op": "cache.flush",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": true
        },
        {
          "op": "cache.list",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "k"
          },
          "expect": []
        },
        {
          "op": "adapter.name",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": "none"
        }
      ]
    }
  ]
}
