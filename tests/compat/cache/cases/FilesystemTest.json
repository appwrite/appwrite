      ]
    },
    {
      "name": "testStreamingLoad, testStreamingLoadMissingKey",
      "steps": [
        {
          "op": "filesystem.new",
          "args": {
            "path": "/tmp/compat-fs/${ns}/data"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "stream-test",
            "data": "stream data"
          },
          "expect": true
        },
        {
          "op": "filesystem.stream",
          "args": {
