      ]
    },
    {
      "name": "paths, nested keys, arrays and edge cases",
      "steps": [
        {
          "op": "filesystem.new",
          "args": {
            "path": "/tmp/compat-fs/${ns}/data"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "filesystem.path",
          "args": {
            "path": "/tmp/compat-fs/${ns}/data",
            "key": "a/b"
          },
          "expect": "/tmp/compat-fs/${ns}/data/a/b"
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "dir/nested/key",
            "data": "nested"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "dir/nested/key",
            "ttl": 60
          },
          "expect": "nested"
        },
        {
          "op": "cache.size",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": 6
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "list",
            "data": [
              "a",
              "b",
              [
                "c"
              ],
              1,
              2.5,
              true,
              null
            ]
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "list",
            "ttl": 60
          },
          "expect": "abArray12.51"
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "blank",
            "data": [
              ""
            ]
          },
          "expect": false
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "blank",
            "ttl": 60
          },
          "expect": ""
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "dir"
          },
          "expect": false
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "missing"
          },
          "expect": false
        },
        {
          "op": "cache.list",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "list"
          },
          "expect": []
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "list",
            "ttl": 0
          },
          "expect": false
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "missing"
          },
          "expect": false
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "list"
          },
          "expect": true
        },
        {
          "op": "adapter.name",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": "filesystem"
        },
        {
          "op": "cache.flush",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": true
        },
        {
          "op": "cache.ping",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": false
        },
        {
          "op": "cache.size",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": 0
        }
      ],
      "state": [
        "files"
      ]
    },
    {
      "name": "flushing an empty or missing directory fails",
      "steps": [
        {
          "op": "filesystem.new",
          "args": {
            "path": "/tmp/compat-fs/${ns}/missing"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.flush",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "/tmp/compat-fs/${ns}/missing must be a directory"
            }
          }
        },
        {
          "op": "cache.ping",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": false
        },
        {
          "op": "cache.size",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": 0
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "k",
            "data": "v"
          },
          "expect": true
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "k"
          },
          "expect": true
        },
        {
          "op": "cache.flush",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": {
            "$error": {
              "class": "Exception",
              "message": "Error happened during glob"
            }
          }
        }
      ],
      "state": [
        "files"
      ]
    }
  ]
}
