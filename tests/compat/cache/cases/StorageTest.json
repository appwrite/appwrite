    {
      "name": "testKeysCannotLeaveTheRoot",
      "steps": [
        {
          "op": "storage.new",
          "args": {
            "root": "/tmp/compat-fs/${ns}/escape/root"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "../outside",
            "ttl": 60
          },
          "expect": false
        },
        {
          "op": "adapter.save",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "../outside",
            "data": "value"
          },
          "expect": true
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "../outside",
            "ttl": 60
          },
          "expect": "value"
        },
        {
          "op": "adapter.touch",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "../outside"
          },
          "expect": true
        },
        {
          "op": "storage.path",
          "args": {
            "root": "/tmp/compat-fs/${ns}/escape/root",
            "key": "../outside"
          },
          "expect": "/tmp/compat-fs/${ns}/escape/root/..%2Foutside"
        },
        {
          "op": "adapter.purge",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "../outside"
          },
          "expect": true
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "..",
            "ttl": 60
          },
          "expect": false
        },
        {
          "op": "adapter.save",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "..",
            "data": "value"
          },
          "expect": true
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "..",
            "ttl": 60
          },
          "expect": "value"
        },
        {
          "op": "adapter.touch",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": ".."
          },
          "expect": true
        },
        {
          "op": "storage.path",
          "args": {
            "root": "/tmp/compat-fs/${ns}/escape/root",
            "key": ".."
          },
          "expect": "/tmp/compat-fs/${ns}/escape/root/%2E%2E"
        },
        {
          "op": "adapter.purge",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": ".."
          },
          "expect": true
        },
        {
          "op": "adapter.load",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": ".",
            "ttl": 60
          },
          "expect": false
        },
        {
          "op": "adapter.save",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": ".",
            "data": "value"
          },
          "expect": true
