    {
      "name": "testCacheTouch",
      "steps": [
        {
          "op": "storage.new",
          "args": {
            "root": "/tmp/compat-fs/${ns}/data"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "touch-key",
            "data": "touch data",
            "hash": "touch-key"
          },
          "expect": true
        },
        {
          "op": "sleep",
          "args": {
            "seconds": 3
          },
          "expect": null
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "touch-key",
            "ttl": 2,
            "hash": "touch-key"
          },
          "expect": false
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "touch-key",
            "hash": "touch-key"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "touch-key",
            "ttl": 2,
            "hash": "touch-key"
          },
          "expect": "touch data"
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "missing-touch-key",
            "hash": "missing-touch-key"
          },
          "expect": false
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "touch-key"
          },
          "expect": true
        }
      ],
      "state": [
        "files"
      ]
    },
