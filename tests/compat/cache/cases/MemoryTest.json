{
  "source": "packages/cache/tests/MemoryTest.php",
  "cases": [
    {
      "name": "testCacheSave, testNotEmptyCacheKey, testCachePurge",
      "steps": [
        {
          "op": "memory.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache",
            "data": [
              "test",
              "data",
              "string"
            ],
            "hash": "test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache",
            "data": "test data string",
            "hash": "test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache",
            "ttl": 7776000,
            "hash": "test-key-for-cache"
          },
          "expect": "test data string"
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "test-key-for-cache",
            "ttl": 7776000,
            "hash": "test-key-for-cache"
          },
          "expect": false
        }
      ]
    },
