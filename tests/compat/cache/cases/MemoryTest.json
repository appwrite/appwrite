              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.load_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "k",
            "ttl": 60,
            "fields": [
              "a"
            ]
          },
          "expect": {}
        },
        {
          "op": "cache.save_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "K",
