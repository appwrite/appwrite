          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "Mixed",
            "ttl": 60
          },
          "expect": {}
        },
        {
          "op": "adapter.save_many",
          "args": {
            "adapter": {
              "$ref": "a"
            },
            "key": "Mixed",
            "data": [
