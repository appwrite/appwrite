        {
          "op": "redis.new",
          "args": {
            "service": "cache-shard-b"
          },
          "bind": "s2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "redis.new",
          "args": {
            "service": "cache-shard-c"
          },
          "bind": "s3",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "sharding.new",
          "args": {
            "adapters": [
              {
                "$ref": "s1"
              },
              {
                "$ref": "s2"
              },
              {
                "$ref": "s3"
              }
            ]
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:touch-key",
            "data": "touch data",
            "hash": "${ns}:touch-key"
          },
          "expect": true
        },
        {
          "op": "sleep",
          "args": {
            "seconds": 3
          },
          "expect": null
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:touch-key",
            "ttl": 2,
            "hash": "${ns}:touch-key"
          },
          "expect": false
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:touch-key",
            "hash": "${ns}:touch-key"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:touch-key",
            "ttl": 2,
            "hash": "${ns}:touch-key"
          },
          "expect": "touch data"
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:missing-touch-key",
            "hash": "${ns}:missing-touch-key"
          },
          "expect": false
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:touch-key"
          },
          "expect": true
        }
      ],
      "state": [
        "redis@cache-redis/12,13,14,7,8,9"
      ]
    },
