{
  "source": "packages/cache/tests/E2E/ShardingTest.php",
  "cases": [
    {
      "name": "testCacheSave, testNotEmptyCacheKey, testCachePurge",
      "steps": [
        {
          "op": "redis.new",
          "args": {
            "service": "cache-shard-a"
          },
          "bind": "s1",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "redis.new",
          "args": {
            "service": "cache-shard-b"
          },
          "bind": "s2",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "redis.new",
          "args": {
            "service": "cache-shard-c"
          },
          "bind": "s3",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "sharding.new",
          "args": {
            "adapters": [
              {
                "$ref": "s1"
              },
              {
                "$ref": "s2"
              },
              {
                "$ref": "s3"
              }
            ]
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache",
            "data": [
              "test",
              "data",
              "string"
            ],
            "hash": "${ns}:test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache",
            "data": "test data string",
            "hash": "${ns}:test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache",
            "ttl": 7776000,
            "hash": "${ns}:test-key-for-cache"
          },
          "expect": "test data string"
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache",
            "ttl": 7776000,
            "hash": "${ns}:test-key-for-cache"
          },
          "expect": false
        }
      ],
      "state": [
        "redis@cache-redis/12,13,14,7,8,9"
      ]
    },
