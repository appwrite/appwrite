          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:empty-object-fidelity",
            "data": {
              "empty": {},
              "nested": {
                "empty": {}
              },
              "list": [
                {},
                {
                  "x": 1
                }
              ],
              "emptyArray": []
            },
            "hash": "${ns}:empty-object-fidelity"
