    {
      "name": "overlapping recordings each record every purge made while they run",
      "steps": [
        {
          "op": "memory.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.record_purges",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "steps": [
              {
                "op": "purge",
                "key": "outer",
                "hash": "1"
              },
              {
                "op": "record",
                "steps": [
                  {
                    "op": "purge",
                    "key": "inner"
                  },
                  {
                    "op": "record",
                    "steps": [
                      {
                        "op": "purge",
                        "key": "innermost"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "purge",
                "key": "outer",
                "hash": "2"
              }
            ]
          },
          "expect": {
            "purges": {
              "$array": [
                [
                  "outer",
                  {
                    "$array": [
                      [
                        1,
                        true
                      ],
                      [
                        2,
                        true
                      ]
                    ]
                  }
                ],
                [
                  "inner",
                  {
                    "$array": [
                      [
                        "",
                        true
                      ]
                    ]
                  }
                ],
                [
                  "innermost",
                  {
                    "$array": [
                      [
                        "",
                        true
                      ]
                    ]
                  }
                ]
              ]
            },
            "results": [
              false,
              {
                "purges": {
                  "$array": [
                    [
                      "inner",
                      {
                        "$array": [
                          [
                            "",
                            true
                          ]
                        ]
                      }
                    ],
                    [
                      "innermost",
                      {
                        "$array": [
                          [
                            "",
                            true
                          ]
                        ]
                      }
                    ]
                  ]
                },
                "results": [
                  false,
                  {
                    "purges": {
                      "$array": [
                        [
                          "innermost",
                          {
                            "$array": [
                              [
                                "",
                                true
                              ]
                            ]
                          }
                        ]
                      ]
                    },
                    "results": [
                      false
                    ]
                  }
                ]
              },
              false
            ]
          }
        }
      ]
    },
