{
  "source": "Utopia\\Cache\\Cache::recordPurges (no PHP test)",
  "cases": [
    {
      "name": "records each purged key and hash, folded, in first-purge order",
      "steps": [
        {
          "op": "memory.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.record_purges",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "steps": [
              {
                "op": "save",
                "key": "Rows",
                "data": "row",
                "hash": "A"
              },
              {
                "op": "purge",
                "key": "Rows",
                "hash": "A"
              },
              {
                "op": "purge",
                "key": "rows"
              },
              {
                "op": "purge",
                "key": "ROWS",
                "hash": "a"
              },
              {
                "op": "load",
                "key": "rows",
                "ttl": 60,
                "hash": "a"
              },
              {
                "op": "purge",
                "key": "Other",
                "hash": "x"
              },
              {
                "op": "purge",
                "key": "rows",
                "hash": "b"
              }
            ]
          },
          "expect": {
            "purges": {
              "$array": [
                [
                  "rows",
                  {
                    "$array": [
                      [
                        "a",
                        true
                      ],
                      [
                        "",
                        true
                      ],
                      [
                        "b",
                        true
                      ]
                    ]
                  }
                ],
                [
                  "other",
                  {
                    "$array": [
                      [
                        "x",
                        true
                      ]
                    ]
                  }
                ]
              ]
            },
            "results": [
              true,
              true,
              false,
              false,
              false,
              false,
              false
            ]
          }
        }
      ]
    },
