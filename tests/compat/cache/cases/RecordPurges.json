    {
      "name": "a purge is recorded before the adapter runs it",
      "steps": [
        {
          "op": "failing.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.record_purges",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "steps": [
              {
                "op": "record",
                "steps": [
                  {
                    "op": "purge",
                    "key": "Failing",
                    "hash": "H"
                  }
                ]
              }
            ]
          },
          "expect": {
            "purges": {
              "$array": [
