    {
      "name": "retries, names, codecs and large values",
      "steps": [
        {
          "op": "hazelcast.new",
          "args": {
            "retries": 2,
            "delay": 5,
            "codec": "igbinary"
          },
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "adapter.retry",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": {
            "max": 2,
            "delay": 5
          }
        },
        {
          "op": "adapter.name",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "expect": "hazelcast"
        },
        {
          "op": "cache.ping",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": true
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:big",
            "data": ""
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:big",
            "ttl": 60
          },
          "expect": ""
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:arr",
            "data": {
              "a": [
                1,
                2.5,
                true,
                null
              ],
              "b": {}
            }
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:arr",
            "ttl": 60
          },
          "expect": {
            "$array": [
              [
                "a",
                [
                  1,
                  2.5,
                  true,
                  null
                ]
              ],
              [
                "b",
                {
                  "$object": []
                }
              ]
            ]
          }
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:arr"
          },
          "expect": true
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:arr"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:arr",
            "ttl": 60
          },
          "expect": false
        },
        {
          "op": "cache.list",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:arr"
          },
          "expect": []
        }
      ]
    }
