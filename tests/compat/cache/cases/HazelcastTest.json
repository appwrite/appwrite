    {
      "name": "testCaseSensitivity",
      "steps": [
        {
          "op": "hazelcast.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.set_case_sensitivity",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "value": true
          },
          "expect": true
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:color",
            "data": "pink",
            "hash": "${ns}:color"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:color",
            "ttl": 7776000,
            "hash": "${ns}:color"
          },
          "expect": "pink"
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:COLOR",
            "ttl": 7776000,
            "hash": "${ns}:COLOR"
          },
          "expect": false
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:color"
          },
          "expect": true
        },
        {
          "op": "cache.set_case_sensitivity",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "value": false
          },
          "expect": false
        },
        {
          "op": "cache.case_sensitive",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": false
        }
      ]
    },
    {
      "name": "testEmptyObjectFidelity",
      "steps": [
        {
          "op": "hazelcast.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:empty-object-fidelity",
            "data": {
              "empty": {},
              "nested": {
                "empty": {}
              },
              "list": [
                {},
                {
                  "x": 1
                }
              ],
              "emptyArray": []
            },
            "hash": "${ns}:empty-object-fidelity"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:empty-object-fidelity",
            "ttl": 60,
            "hash": "${ns}:empty-object-fidelity"
          },
          "expect": {
            "$array": [
              [
                "empty",
                {
                  "$object": []
                }
              ],
              [
                "nested",
                {
                  "$array": [
                    [
                      "empty",
                      {
                        "$object": []
                      }
                    ]
                  ]
                }
              ],
              [
                "list",
                [
                  {
                    "$object": []
                  },
                  {
                    "$array": [
                      [
                        "x",
                        1
                      ]
                    ]
                  }
                ]
              ],
              [
                "emptyArray",
                []
              ]
            ]
          }
        },
        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:empty-object-fidelity",
            "hash": "${ns}:empty-object-fidelity"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:empty-object-fidelity",
            "ttl": 60,
            "hash": "${ns}:empty-object-fidelity"
          },
          "expect": {
            "$array": [
              [
                "empty",
                {
                  "$object": []
                }
              ],
              [
                "nested",
                {
                  "$array": [
                    [
                      "empty",
                      {
                        "$object": []
                      }
                    ]
                  ]
                }
              ],
              [
                "list",
                [
                  {
                    "$object": []
                  },
                  {
                    "$array": [
                      [
                        "x",
                        1
                      ]
                    ]
                  }
                ]
              ],
              [
                "emptyArray",
                []
              ]
            ]
          }
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:empty-object-fidelity"
          },
          "expect": true
        }
      ]
    },
