{
  "source": "packages/cache/tests/E2E/HazelcastTest.php",
  "cases": [
    {
      "name": "testCacheSave, testNotEmptyCacheKey, testCachePurge",
      "steps": [
        {
          "op": "hazelcast.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache",
            "data": [
              "test",
              "data",
              "string"
            ],
            "hash": "${ns}:test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.save",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache",
            "data": "test data string",
            "hash": "${ns}:test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache",
            "ttl": 7776000,
            "hash": "${ns}:test-key-for-cache"
          },
          "expect": "test data string"
        },
        {
          "op": "cache.purge",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache"
          },
          "expect": true
        },
        {
          "op": "cache.load",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "${ns}:test-key-for-cache",
            "ttl": 7776000,
            "hash": "${ns}:test-key-for-cache"
          },
          "expect": false
        }
      ]
    },
