            "cache": {
              "$ref": "c"
            }
          },
          "expect": true
        },
        {
          "op": "cache.size",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": 0
        },
        {
          "op": "cache.ping",
          "args": {
            "cache": {
              "$ref": "c"
            }
          },
          "expect": true
        },
        {
          "op": "cache.load_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "k",
            "ttl": 1
          },
          "expect": {}
        },
        {
          "op": "cache.save_many",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "k",
            "data": [
              [
                "a",
                "b"
              ]
            ]
          },
          "expect": false
        },
        {
          "op": "cache.save_with_lease",
