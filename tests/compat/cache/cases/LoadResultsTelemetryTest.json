        {
          "op": "cache.touch",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "present"
          },
          "expect": true
        },
        {
          "op": "cache.list",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "key": "present"
          },
          "expect": []
