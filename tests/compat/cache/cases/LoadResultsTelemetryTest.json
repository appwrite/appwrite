{
  "source": "packages/cache/tests/LoadResultsTelemetryTest.php",
  "cases": [
    {
      "name": "testLoadEmitsHitAndMissCounts, testHitMissAttributesAreRecorded",
      "steps": [
        {
          "op": "memory.new",
          "args": {},
          "bind": "a",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "adapter": {
              "$ref": "a"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
