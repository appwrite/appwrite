    {
      "name": "the server pull expiry lands before the client deadline",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "allowReconnect": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.fetch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            },
            "batch": 1,
            "timeout": 0.05
          },
          "expect": {
            "count": 0,
            "listed": 0,
            "messages": []
          }
        },
        {
          "op": "fake.written",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": "CONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\nPING\r\nSUB _INBOX.* 1\r\nPUB $JS.API.CONSUMER.MSG.NEXT.STREAM.durable _INBOX.* 30\r\n{\"batch\":1,\"expires\":45000000}\r\nUNSUB 1\r\n"
        }
      ]
    },
    {
      "name": "fetch keeps the pull exception when unsubscribe also fails",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "max_payload": 4
            },
            "rules": [
              {
                "when": {
                  "prefix": "UNSUB "
                },
                "do": [
                  {
                    "throw": {
                      "class": "ConnectionException",
                      "message": "Failed to reconnect to any NATS server"
                    }
                  }
                ]
              }
            ],
            "options": {
              "allowReconnect": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.fetch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            },
            "batch": 1,
            "timeout": 0.02
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\MaxPayloadException",
              "message": "Payload size 30 exceeds server maximum of 4"
            }
          }
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": false,
            "closed": false,
            "reconnecting": false,
            "status": "disconnected",
            "subscriptions": 0
          }
        }
      ]
    },
