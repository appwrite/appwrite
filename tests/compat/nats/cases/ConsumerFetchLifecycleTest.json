    {
      "name": "consumer accessors",
      "steps": [
        {
          "op": "fake.connect",
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.names",
          "args": {
            "consumer": {
              "$ref": "k"
            }
          },
          "expect": [
            "durable",
            "STREAM"
          ]
        },
        {
          "op": "consumer.info",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            }
          },
          "expect": {
            "stream_name": "STREAM",
            "name": "durable",
            "config": {
              "deliver_policy": "all",
              "ack_policy": "explicit",
              "replay_policy": "instant"
            },
            "created": false,
            "num_ack_pending": 0,
            "num_redelivered": 0,
            "num_waiting": 0,
            "num_pending": 0,
            "delivered": {
              "consumer_seq": 0,
              "stream_seq": 0
            },
            "ack_floor": {
              "consumer_seq": 0,
              "stream_seq": 0
            },
            "push_bound": false,
            "cluster": null,
            "metadata": null
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "S",
            "info": {
              "name": "n"
            },
            "prefix": "$JS.hub.API"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.fetch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "p"
            },
            "batch": 1,
            "timeout": 0.01,
            "no_wait": true
          },
          "expect": {
            "count": 0,
            "listed": 0,
            "messages": []
          }
        },
        {
          "op": "fake.written",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": "CONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\nPING\r\nSUB _INBOX.* 1\r\nPUB $JS.hub.API.CONSUMER.MSG.NEXT.S.n _INBOX.* 26\r\n{\"batch\":1,\"no_wait\":true}\r\nUNSUB 1\r\n"
        }
      ]
    },
    {
      "name": "next pulls one message",
      "steps": [
        {
          "op": "fake.connect",
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.push",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "data": "MSG _INBOX.x 1 $JS.ACK.STREAM.durable.1.7.1.1700000000000000000.0 3\r\nabc\r\n"
          },
          "expect": null
        },
        {
          "op": "consumer.next",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            },
            "timeout": 0.5
          },
          "expect": {
            "handle": {
              "$handle": "*"
            },
            "subject": "_INBOX.x",
            "data": "abc",
            "headers": null,
            "reply": true
          }
        },
        {
          "op": "fake.written",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": "CONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\nPING\r\nSUB _INBOX.* 1\r\nPUB $JS.API.CONSUMER.MSG.NEXT.STREAM.durable _INBOX.* 31\r\n{\"batch\":1,\"expires\":450000000}\r\nUNSUB 1\r\n"
        }
      ]
    },
    {
