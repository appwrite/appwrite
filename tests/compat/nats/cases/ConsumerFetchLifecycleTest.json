{
  "source": "packages/nats/tests/ConsumerFetchLifecycleTest.php",
  "cases": [
    {
      "name": "fetch releases its inbox subscription",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "allowReconnect": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "closed": false,
            "reconnecting": false,
            "status": "connected",
            "subscriptions": 0
          }
        },
        {
          "op": "consumer.fetch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            },
            "batch": 1,
            "timeout": 0.02
          },
          "expect": {
            "count": 0,
            "listed": 0,
            "messages": []
          }
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "closed": false,
            "reconnecting": false,
            "status": "connected",
            "subscriptions": 0
          }
        }
      ]
    },
    {
      "name": "fetch releases its inbox subscription when it throws",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "max_payload": 4
            },
            "options": {
              "allowReconnect": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "closed": false,
            "reconnecting": false,
            "status": "connected",
            "subscriptions": 0
          }
        },
        {
          "op": "consumer.fetch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            },
            "batch": 1,
            "timeout": 0.02
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\MaxPayloadException",
              "message": "Payload size 30 exceeds server maximum of 4"
            }
          }
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "closed": false,
            "reconnecting": false,
            "status": "connected",
            "subscriptions": 0
          }
        }
      ]
    },
