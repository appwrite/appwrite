    {
      "name": "info refresh reports API errors",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "rules": [
              {
                "when": {
                  "prefix": "PUB $JS.API.CONSUMER.INFO"
                },
                "do": [
                  {
                    "reply": {
                      "subject": "$JS.API.CONSUMER.INFO.",
                      "payload": "{\"error\":{\"code\":404,\"err_code\":10014,\"description\":\"consumer not found\"}}"
                    }
                  }
                ]
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.info",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            },
            "refresh": true
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\JetStreamException",
              "message": "consumer not found"
            }
          }
        }
      ]
    }
