    {
      "name": "NKey authentication signs the nonce",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "nonce": "abc"
            },
            "options": {
              "nkey": "UEXPLICIT",
              "nkeySeed": "SUAKKTOKDASTBOY5NUJSZXWWEN5S5WI6H5ZB7SYZOELUJFGWJE6J2XGBOY"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.connect_payload",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "verbose": false,
            "pedantic": false,
            "lang": "php",
            "version": "0.1.0",
            "protocol": 1,
            "echo": true,
            "headers": true,
            "no_responders": true,
            "nkey": "UEXPLICIT",
            "sig": "BKDSER2NAFSRDIJ2J2KW4MNW72BB4HXYMCASOIXWVHDMTIYZ3NB7TQWNIAQEM2RM4JWDVAOKGXVSR63F2ZAAXP547PT4N2NP5HOZADA"
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "NKey authentication without a nonce fails to connect",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "nkey": "U",
              "nkeySeed": "SUAKKTOKDASTBOY5NUJSZXWWEN5S5WI6H5ZB7SYZOELUJFGWJE6J2XGBOY"
            }
          },
          "bind": "c",
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\ConnectionException",
              "message": "Failed to connect to any NATS server"
            }
          }
        }
      ]
    },
    {
      "name": "a credentials file",
      "steps": [
        {
          "op": "auth.fields",
          "args": {
            "kind": "credentials",
            "contents": "-----BEGIN NATS USER JWT-----\nthe.jwt\n------END NATS USER JWT------\n-----BEGIN USER NKEY SEED-----\nSUAKKTOKDASTBOY5NUJSZXWWEN5S5WI6H5ZB7SYZOELUJFGWJE6J2XGBOY\n------END USER NKEY SEED------\n",
            "nonce": "n"
          },
          "expect": {
            "fields": {
              "jwt": "the.jwt",
              "nkey": "UAX2HRTQ4H5S6EX3NM6AJIYBJXDCP6P3T3AJTBAMXYJ2Q6H7OPQ53Z6W",
              "sig": "ADIK45EKTUOBVEPZKBKNE6VJZGG65SPZEOAZDQVXFMUHHWRSMCZEH3SDB7YJ3UYDPLGOHHMXBD3RL6AHSP75JV7P5REDV6AOD7AHEDY"
            }
          }
        },
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "nonce": "xyz"
            },
            "options": {
              "credentialsFile": "/tmp/compat-fs/${ns}/user.creds"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.connect_payload",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "verbose": false,
            "pedantic": false,
            "lang": "php",
            "version": "0.1.0",
            "protocol": 1,
            "echo": true,
            "headers": true,
            "no_responders": true,
            "jwt": "the.jwt",
            "nkey": "UAX2HRTQ4H5S6EX3NM6AJIYBJXDCP6P3T3AJTBAMXYJ2Q6H7OPQ53Z6W",
            "sig": "X5763NA34SYPL2OMWX4YAXX2JIBINGOAQAMDAVLL6FXLKUST6IBYJZTQZKZOO6IINM7RIGWEOCKZE5ZMXUSIHUNGL2425LLZJQLBCDA"
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "a missing credentials file fails before connecting",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "credentialsFile": "/tmp/compat-fs/${ns}/missing.creds"
            }
          },
          "bind": "c",
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\AuthenticationException",
              "message": "Credentials file not found: /tmp/compat-fs/${ns}/missing.creds"
            }
          }
        }
      ]
    },
    {
      "name": "a -ERR during the handshake fails the connect",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "rules": [
              {
                "when": {
                  "prefix": "CONNECT"
                },
                "do": [
                  {
                    "push": "-ERR 'Authorization Violation'\r\n"
                  }
                ]
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\ConnectionException",
              "message": "Failed to connect to any NATS server"
            }
          }
        }
      ]
    },
    {
      "name": "a fake transport is never upgraded to TLS",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "tls_required": true
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "connects": 1,
            "tls_upgrades": 0
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "the transport factory gets the scheme",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "servers": "tls://127.0.0.1:4443"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.log",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            [
              "transport",
              "tls"
            ]
          ]
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        },
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "servers": "h:1"
            }
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.log",
          "args": {
            "conn": {
              "$ref": "d"
            }
          },
          "expect": [
            [
              "transport",
              "nats"
            ]
          ]
        },
        {
          "op": "conn.options",
          "args": {
            "conn": {
              "$ref": "d"
            }
          },
          "expect": {
            "servers": [
              "h:1"
            ],
            "name": "",
            "inbox_prefix": "_INBOX"
          }
        }
      ]
    },
    {
      "name": "verbose servers answer +OK before PONG",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "rules": [
              {
                "when": {
                  "prefix": "PUB"
                },
                "do": [
                  {
                    "push": "+OK\r\n"
                  }
                ]
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "s",
            "data": "x"
          },
          "expect": null
        },
        {
          "op": "conn.flush",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "an invalid server URL",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "servers": "nats://:99999"
            }
          },
          "bind": "c",
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\ConnectionException",
              "message": "Failed to connect to any NATS server"
            }
          }
        }
      ]
    }
  ]
}
