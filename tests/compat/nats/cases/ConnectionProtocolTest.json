{
  "source": "packages/nats/tests/ConnectionProtocolTest.php",
  "cases": [
    {
      "name": "connect negotiates headers when supported",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "headers": true
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.connect_payload",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "verbose": false,
            "pedantic": false,
            "lang": "php",
            "version": "0.1.0",
            "protocol": 1,
            "echo": true,
            "headers": true,
            "no_responders": true
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "connect disables headers when not supported",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "headers": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.connect_payload",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "verbose": false,
            "pedantic": false,
            "lang": "php",
            "version": "0.1.0",
            "protocol": 1,
            "echo": true,
            "headers": false,
            "no_responders": false
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "publish with headers uses HPUB",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "headers": true
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "subj",
            "data": "hello",
            "headers": [
              [
                "set",
                "X-Key",
                "value"
              ]
            ]
          },
          "expect": null
        },
        {
          "op": "fake.count",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "needle": "HPUB subj"
          },
          "expect": 1
        },
        {
          "op": "fake.writes",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            "CONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\n",
            "PING\r\n",
            "HPUB subj 26 31\r\nNATS/1.0\r\nX-Key: value\r\n\r\nhello\r\n"
          ]
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "publish with headers is refused when the server lacks support",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "headers": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "subj",
            "data": "hello",
            "headers": [
              [
                "set",
                "X-Key",
                "value"
              ]
            ]
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\ProtocolException",
              "message": "Server does not support message headers"
            }
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "max payload includes header bytes",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "headers": true,
              "max_payload": 40
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "subj",
            "data": "hello",
            "headers": [
              [
                "set",
                "X-Long-Header",
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              ]
            ]
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\MaxPayloadException",
              "message": "Payload size 64 exceeds server maximum of 40"
            }
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "a payload exactly at the maximum passes",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "max_payload": 5
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "s",
            "data": "12345"
          },
          "expect": null
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "s",
            "data": "123456"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\MaxPayloadException",
              "message": "Payload size 6 exceeds server maximum of 5"
            }
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "tls_available is parsed",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "info": {
              "tls_available": true,
              "tls_required": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.server_info",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "server_id": "FAKE",
            "server_name": "fake",
            "version": "2.10.0",
            "proto": 1,
            "host": "127.0.0.1",
            "port": 4222,
            "headers": true,
            "auth_required": false,
            "tls_required": false,
            "tls_available": true,
            "max_payload": 1048576,
            "connect_urls": [],
            "nonce": null,
            "jetstream": true,
            "client_id": null,
            "client_ip": null
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "headers with only a status are sent with PUB",
      "steps": [
        {
          "op": "fake.connect",
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "s",
            "data": "x",
            "headers": [
              [
                "status",
                "503"
              ]
            ]
          },
          "expect": null
        },
        {
          "op": "fake.writes",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            "CONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\n",
            "PING\r\n",
            "PUB s 1\r\nx\r\n"
          ]
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "the CONNECT payload: name, verbose, pedantic and echo",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "name": "billing",
              "verbose": true,
              "pedantic": true,
              "echo": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.connect_payload",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "verbose": true,
            "pedantic": true,
            "lang": "php",
            "version": "0.1.0",
            "protocol": 1,
            "echo": false,
            "headers": true,
            "no_responders": true,
            "name": "billing"
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "credentials from the URL",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "servers": "nats://alice:s%40cret@127.0.0.1:4222"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.connect_payload",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "verbose": false,
            "pedantic": false,
            "lang": "php",
            "version": "0.1.0",
            "protocol": 1,
            "echo": true,
            "headers": true,
            "no_responders": true,
            "user": "alice",
            "pass": "s@cret"
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        },
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "servers": [
                "nats://t0ken@127.0.0.1:4222"
              ]
            }
          },
          "bind": "d",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.connect_payload",
          "args": {
            "conn": {
              "$ref": "d"
            }
          },
          "expect": {
            "verbose": false,
            "pedantic": false,
            "lang": "php",
            "version": "0.1.0",
            "protocol": 1,
            "echo": true,
            "headers": true,
            "no_responders": true,
            "auth_token": "t0ken"
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "d"
            }
          },
          "expect": null
        }
      ]
    },
