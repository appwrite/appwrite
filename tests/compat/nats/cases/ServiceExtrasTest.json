      ]
    },
    {
      "name": "a custom queue group is honoured",
      "steps": [
        {
          "op": "conn.connect",
          "args": {
            "service": "nats"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "name": "svcx_${ns}",
            "version": "1.0.0",
            "description": "Test service",
            "metadata": {}
          },
          "bind": "svc",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.add_group",
          "args": {
            "service": {
              "$ref": "svc"
            },
            "name": "jobs_${ns}",
            "queue": "workers_${ns}"
          },
          "bind": "g",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "group.add_endpoint",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "group": {
              "$ref": "g"
            },
            "name": "run",
            "handler": {
              "kind": "fixed",
              "payload": "done"
            }
          },
          "expect": true
        },
        {
          "op": "service.add_endpoint",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            },
            "name": "direct",
            "subject": "svcx_${ns}.direct",
            "handler": {
              "kind": "fixed",
              "payload": "direct"
            },
            "queue": "workers_${ns}"
          },
          "expect": true
        },
        {
          "op": "service.start",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            }
          },
          "expect": true
        },
        {
          "op": "conn.request",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "$SRV.INFO.svcx_${ns}",
            "timeout": 2.0,
            "json": true
          },
          "mask": {
            "paths": [
              "/json/id"
            ],
            "reason": "a random id"
          },
          "expect": {
            "json": {
              "type": "io.nats.micro.v1.info_response",
              "name": "svcx_${ns}",
              "id": "<masked>",
              "version": "1.0.0",
              "description": "Test service",
              "metadata": [],
              "endpoints": [
                {
                  "name": "run",
                  "subject": "jobs_${ns}.run",
                  "queue_group": "workers_${ns}",
                  "metadata": []
                },
                {
                  "name": "direct",
                  "subject": "svcx_${ns}.direct",
                  "queue_group": "workers_${ns}",
                  "metadata": []
                }
              ]
            },
            "headers": null
          }
        },
        {
          "op": "service.stop",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            }
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "a queue group balances across instances",
      "steps": [
        {
          "op": "conn.connect",
          "args": {
            "service": "nats"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "name": "svcx_${ns}",
            "version": "1.0.0",
            "description": "Test service",
            "metadata": {}
          },
          "bind": "svc",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.add_endpoint",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            },
            "name": "a",
            "subject": "svcx_${ns}.work",
            "handler": {
              "kind": "fixed",
              "payload": "a"
            },
            "queue": "lb_${ns}"
          },
          "expect": true
        },
        {
          "op": "service.add_endpoint",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            },
            "name": "b",
            "subject": "svcx_${ns}.work",
            "handler": {
              "kind": "fixed",
              "payload": "b"
            },
            "queue": "lb_${ns}"
          },
          "expect": true
        },
        {
          "op": "service.start",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            }
          },
          "expect": true
        },
        {
          "op": "conn.request_tally",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "svcx_${ns}.work",
            "count": 30,
            "timeout": 2.0
          },
          "expect": {
            "total": 30,
            "distinct": [
              "a",
              "b"
            ]
          }
        },
        {
          "op": "service.stop",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            }
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    }
  ]
}
