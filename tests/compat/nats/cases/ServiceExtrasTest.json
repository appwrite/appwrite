          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "name": "svcx_${ns}",
            "version": "1.0.0",
            "description": "Extras service",
            "metadata": {
              "owner": "levi",
              "env": "test"
            }
          },
          "bind": "svc",
          "expect": {
            "$handle": "*"
          }
        },
