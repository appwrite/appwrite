            "allowReconnect": true,
            "maxReconnectAttempts": 60,
            "reconnectWait": 2.0,
            "maxReconnectWait": 8.0,
            "reconnectJitter": 0.1,
            "reconnectBufSize": 8388608,
            "subPendingMsgsLimit": 65536,
            "subPendingBytesLimit": 67108864,
