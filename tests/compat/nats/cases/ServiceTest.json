{
  "source": "packages/nats/tests/E2E/ServiceTest.php",
  "cases": [
    {
      "name": "an endpoint handles a request",
      "steps": [
        {
          "op": "conn.connect",
          "args": {
            "service": "nats"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "name": "svc_${ns}",
            "version": "1.2.3",
            "description": "Test service",
            "metadata": {}
          },
          "bind": "svc",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.add_endpoint",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            },
            "name": "echo",
            "subject": "svc_${ns}.echo",
            "handler": {
              "kind": "echo",
              "prefix": "echo:"
            }
          },
          "expect": true
        },
        {
          "op": "service.start",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            }
          },
          "expect": true
        },
        {
          "op": "conn.request",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "svc_${ns}.echo",
            "data": "hello",
            "timeout": 2.0
          },
          "expect": {
            "subject": "_INBOX.*.*",
            "data": "echo:hello",
            "reply": null,
            "headers": null,
            "sid": "11"
          }
        },
        {
          "op": "service.stop",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            }
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "PING returns the service identity",
      "steps": [
        {
          "op": "conn.connect",
          "args": {
            "service": "nats"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "name": "svc_${ns}",
            "version": "1.2.3",
            "description": "Test service",
            "metadata": {}
          },
          "bind": "svc",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "service.start",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            }
          },
          "expect": true
        },
        {
          "op": "conn.request",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "$SRV.PING.svc_${ns}",
            "timeout": 2.0,
            "json": true
          },
          "mask": {
            "paths": [
              "/json/id"
            ],
            "reason": "a random id"
          },
          "expect": {
            "json": {
              "type": "io.nats.micro.v1.ping_response",
              "name": "svc_${ns}",
              "id": "<masked>",
              "version": "1.2.3",
              "metadata": []
            },
            "headers": null
          }
        },
        {
          "op": "service.get",
          "args": {
            "service": {
              "$ref": "svc"
            }
          },
          "expect": {
            "name": "svc_${ns}",
            "id_length": 22,
            "id_hex": true
          }
        },
        {
          "op": "service.stop",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "service": {
              "$ref": "svc"
            }
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
