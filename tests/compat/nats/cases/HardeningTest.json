    {
      "name": "server info parses tls_available",
      "steps": [
        {
          "op": "conn.connect",
          "args": {
            "service": "nats"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.server_info",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "mask": {
            "paths": [
              "/client_id",
              "/client_ip",
              "/nonce",
              "/server_id",
              "/server_name",
              "/version"
            ],
            "reason": "the server numbers each connection, sees the PHP driver and the Rust driver from different addresses, generates its id (its default name) at startup, and the nats:2.11-alpine image moves between patch releases"
          },
          "expect": {
            "server_id": "<masked>",
            "server_name": "<masked>",
            "version": "<masked>",
            "proto": 1,
            "host": "0.0.0.0",
            "port": 4222,
            "headers": true,
            "auth_required": false,
            "tls_required": false,
            "tls_available": false,
            "max_payload": 1048576,
            "connect_urls": [],
            "nonce": "<masked>",
            "jetstream": true,
            "client_id": "<masked>",
            "client_ip": "<masked>"
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "the token provider runs during the connect handshake",
      "steps": [
        {
          "op": "conn.connect",
          "args": {
            "service": "nats",
            "options": {
              "tokenProvider": true
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "closed": false,
            "reconnecting": false,
            "status": "connected",
            "subscriptions": 0
          }
        },
        {
          "op": "conn.log",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            [
              "tokenProvider",
              1
            ]
          ]
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
