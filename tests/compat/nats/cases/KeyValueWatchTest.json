            },
            "config": {
              "bucket": "kvw_${ns}",
              "history": 10
            }
          },
          "bind": "kv",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "kv.watch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "kv": {
              "$ref": "kv"
            },
            "pattern": "greeting"
          },
          "bind": "w",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.flush",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        },
        {
          "op": "kv.put",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "kv": {
              "$ref": "kv"
            },
            "key": "greeting",
            "value": "hello"
          },
          "expect": 1
        },
        {
          "op": "conn.process_message",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "timeout": 0.5,
            "quiet": true
          },
          "mask": {
            "paths": [
              ""
            ],
            "reason": "whether something arrived during the pause depends on timing"
          },
          "expect": "<masked>"
        },
        {
          "op": "conn.unsubscribe",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "sub": {
              "$ref": "w"
            }
          },
          "expect": null
        },
        {
          "op": "conn.log",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            [
              "entry",
              {
                "bucket": "kvw_${ns}",
                "key": "greeting",
                "value": "hello",
                "revision": 1,
                "created": true,
                "operation": "PUT"
              }
            ]
          ]
        },
        {
          "op": "js.delete_key_value",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "js": {
              "$ref": "js"
            },
            "bucket": "kvw_${ns}"
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
