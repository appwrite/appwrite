{
  "source": "packages/nats/tests/ConsumerPullRequestTest.php",
  "cases": [
    {
      "name": "a no_wait pull request carries no expiry",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "allowReconnect": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.fetch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            },
            "batch": 1,
            "timeout": 0.02,
            "no_wait": true
          },
          "expect": {
            "count": 0,
            "listed": 0,
            "messages": []
          }
        },
        {
          "op": "fake.written",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": "CONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\nPING\r\nSUB _INBOX.* 1\r\nPUB $JS.API.CONSUMER.MSG.NEXT.STREAM.durable _INBOX.* 26\r\n{\"batch\":1,\"no_wait\":true}\r\nUNSUB 1\r\n"
        }
      ]
    },
    {
      "name": "a waiting pull request still carries an expiry",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "allowReconnect": false
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.new",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "stream": "STREAM",
            "info": {
              "stream_name": "STREAM",
              "name": "durable"
            }
          },
          "bind": "k",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "consumer.fetch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "consumer": {
              "$ref": "k"
            },
            "batch": 1,
            "timeout": 0.02
          },
          "expect": {
            "count": 0,
            "listed": 0,
            "messages": []
          }
        },
        {
          "op": "fake.written",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": "CONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\nPING\r\nSUB _INBOX.* 1\r\nPUB $JS.API.CONSUMER.MSG.NEXT.STREAM.durable _INBOX.* 30\r\n{\"batch\":1,\"expires\":18000000}\r\nUNSUB 1\r\n"
        }
      ]
    },
    {
      "name": "batch size and max bytes survive the no_wait path",
      "steps": [
        {
          "op": "fake.connect",
