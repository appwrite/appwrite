            "consumer": {
              "$ref": "k"
            },
            "batch": 1,
            "timeout": 0.5,
            "no_wait": true
          },
          "expect": {
            "count": 1,
            "listed": 1,
            "messages": [
              {
                "handle": {
                  "$handle": "*"
                },
                "subject": "_INBOX.scripted",
                "data": "hello",
                "headers": null,
                "reply": false
              }
            ]
          }
        },
        {
          "op": "fake.count",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "needle": "PUB _FC.reply"
          },
          "expect": 1
        }
      ]
    },
