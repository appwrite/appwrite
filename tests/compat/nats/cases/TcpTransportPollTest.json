{
  "source": "packages/nats/tests/Transport/TcpTransportPollTest.php",
  "cases": [
    {
      "name": "tcp: pending data, idle and closed transports as poll() sees them",
      "op": "transport.poll",
      "args": {
        "kind": "tcp",
        "service": "nats"
      },
      "expect": [
        [
          "info_waiting",
          true
        ],
        [
          "info",
          true
        ],
        [
          "idle",
          false
        ],
        [
          "pong_waiting",
          true
        ],
        [
          "pong",
          "PONG\r\n"
        ],
        [
          "idle_again",
          false
        ],
        [
          "closed",
          true
        ]
      ]
    }
  ]
}
