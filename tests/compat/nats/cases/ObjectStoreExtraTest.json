  "cases": [
    {
      "name": "watch fires on put and delete",
      "steps": [
        {
          "op": "conn.connect",
          "args": {
            "service": "nats"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "js.new",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "bind": "js",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "obj.create_or_update",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "js": {
              "$ref": "js"
            },
            "config": {
              "bucket": "objx_${ns}"
            }
          },
          "bind": "o",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "obj.watch",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "obj": {
              "$ref": "o"
            }
          },
          "bind": "w",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.flush",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        },
        {
          "op": "obj.put",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "obj": {
              "$ref": "o"
            },
            "name": "watched.txt",
            "data": "hello"
          },
          "expect": {
            "name": "watched.txt",
            "bucket": "objx_${ns}",
            "nuid": "*",
            "size": 5,
            "chunks": 1,
            "digest": "SHA-256=LPJNul-wow4m6DsqxbninhsWHlwfp0JecwQzYpOLmCQ",
            "mtime": "*"
          }
        },
        {
          "op": "conn.process_message",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "timeout": 0.5,
            "quiet": true
          },
          "mask": {
            "paths": [
              ""
            ],
            "reason": "whether something arrived during the pause depends on timing"
          },
          "expect": "<masked>"
        },
        {
          "op": "obj.delete",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "obj": {
              "$ref": "o"
            },
            "name": "watched.txt"
          },
          "expect": null
        },
        {
          "op": "conn.process_message",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "timeout": 0.5,
            "quiet": true
          },
          "mask": {
            "paths": [
              ""
            ],
            "reason": "whether something arrived during the pause depends on timing"
          },
          "expect": "<masked>"
        },
        {
          "op": "conn.unsubscribe",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "sub": {
              "$ref": "w"
            }
          },
          "expect": null
        },
        {
          "op": "conn.log",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            [
              "meta",
              {
                "name": "watched.txt",
                "bucket": "objx_${ns}",
                "nuid": "*",
                "size": 5,
                "chunks": 1,
                "digest": "SHA-256=LPJNul-wow4m6DsqxbninhsWHlwfp0JecwQzYpOLmCQ",
                "mtime": "*"
              }
            ],
            [
              "meta",
              {
                "name": "watched.txt",
                "bucket": "objx_${ns}",
                "nuid": "",
                "size": 0,
                "chunks": 0,
                "digest": "",
                "mtime": "*",
                "deleted": true
              }
            ]
          ]
        },
        {
          "op": "js.delete_object_store",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "js": {
              "$ref": "js"
            },
            "bucket": "objx_${ns}"
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
