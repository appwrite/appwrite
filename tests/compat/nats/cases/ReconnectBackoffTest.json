      ]
    },
    {
      "name": "buffer accepts until the cap",
      "steps": [
        {
          "op": "connection.reconnect_buffer_accepts",
          "args": {
            "current": 0,
            "incoming": 50,
            "cap": 100
          },
          "expect": true
        },
        {
          "op": "connection.reconnect_buffer_accepts",
          "args": {
            "current": 50,
            "incoming": 50,
            "cap": 100
          },
          "expect": true
        },
        {
          "op": "connection.reconnect_buffer_accepts",
          "args": {
            "current": 50,
            "incoming": 51,
            "cap": 100
          },
          "expect": false
        },
        {
          "op": "connection.reconnect_buffer_accepts",
          "args": {
            "current": 100,
            "incoming": 1,
            "cap": 100
          },
          "expect": false
        }
      ]
    },
    {
      "name": "a cap of zero or less disables buffering",
      "steps": [
        {
          "op": "connection.reconnect_buffer_accepts",
          "args": {
            "current": 0,
            "incoming": 1,
            "cap": 0
          },
          "expect": false
        },
        {
          "op": "connection.reconnect_buffer_accepts",
          "args": {
            "current": 0,
            "incoming": 1,
            "cap": -5
          },
          "expect": false
        }
      ]
