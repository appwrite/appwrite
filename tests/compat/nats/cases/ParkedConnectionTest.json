          }
        },
        {
          "op": "fake.push",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "data": "-ERR 'Permissions Violation for Publish to \"denied\"'\r\n"
          },
          "expect": null
        },
        {
          "op": "conn.request",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "work",
            "data": ""
