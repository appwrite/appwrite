{
  "source": "packages/nats/tests/ParkedConnectionTest.php",
  "cases": [
    {
      "name": "a request after the server closed an idle connection reconnects before writing",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "allowReconnect": true,
              "reconnectWait": 0.0,
              "reconnectJitter": 0.0,
              "requestTimeout": 0.2
            },
            "rules": [
              {
                "when": {
                  "contains": "PUB work "
                },
                "do": [
                  {
                    "reply": {
                      "subject": "work",
                      "payload": "ok"
                    }
                  }
                ]
              }
            ]
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.park",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "data": "INFO {\"server_id\":\"FAKE\",\"ldm\":true}\r\n"
          },
          "expect": null
        },
        {
          "op": "conn.request",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "work",
            "data": ""
          },
          "expect": {
            "subject": "_INBOX.*.*",
            "data": "ok",
            "reply": null,
            "headers": null,
            "sid": "1"
          }
        },
        {
          "op": "fake.count",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "needle": "CONNECT "
          },
          "expect": 2
        },
        {
          "op": "fake.count",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "needle": "PUB work "
          },
          "expect": 1
        },
        {
          "op": "fake.written",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": "CONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\nPING\r\nCONNECT {\"verbose\":false,\"pedantic\":false,\"lang\":\"php\",\"version\":\"0.1.0\",\"protocol\":1,\"echo\":true,\"headers\":true,\"no_responders\":true}\r\nPING\r\nSUB _INBOX.*.* 1\r\nPUB work _INBOX.*.* 0\r\n\r\n"
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
