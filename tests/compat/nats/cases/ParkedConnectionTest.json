            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            [
              "transport",
              "nats"
            ],
            [
              "onError",
              [
                "Utopia\\NATS\\Exception\\NatsException",
                "Permissions Violation for Publish to \"denied"
              ]
            ]
          ]
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "closed": false,
            "reconnecting": false,
            "status": "connected",
            "subscriptions": 1
          }
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
