      "name": "seconds and nanos",
      "steps": [
        {
          "op": "nanos.from_seconds",
          "args": {
            "seconds": 0.0
          },
          "expect": 0
        },
        {
          "op": "nanos.from_seconds",
          "args": {
            "seconds": 0.1
          },
          "expect": 100000000
        },
        {
          "op": "nanos.from_seconds",
          "args": {
            "seconds": 0.3
          },
          "expect": 300000000
        },
        {
          "op": "nanos.from_seconds",
          "args": {
            "seconds": 0.045
          },
          "expect": 45000000
        },
        {
          "op": "nanos.from_seconds",
          "args": {
            "seconds": 2.0
          },
          "expect": 2000000000
        },
        {
          "op": "nanos.from_seconds",
          "args": {
            "seconds": 1e-9
          },
          "expect": 1
        },
        {
          "op": "nanos.from_seconds",
          "args": {
            "seconds": 86400.0
          },
          "expect": 86400000000000
        },
        {
          "op": "nanos.to_seconds",
          "args": {
            "nanos": 0
          },
          "expect": 0.0
        },
        {
          "op": "nanos.to_seconds",
          "args": {
            "nanos": 1
          },
          "expect": 1e-9
        },
        {
          "op": "nanos.to_seconds",
          "args": {
            "nanos": 5000000000
          },
          "expect": 5.0
        },
        {
          "op": "nanos.to_seconds",
          "args": {
            "nanos": 1500000000
          },
          "expect": 1.5
        },
        {
          "op": "nanos.to_seconds",
          "args": {
            "nanos": 300000000
          },
          "expect": 0.3
        },
        {
