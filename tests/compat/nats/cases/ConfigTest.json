{
  "source": "packages/nats/tests/JetStream/ConfigTest.php",
  "cases": [
    {
      "name": "push and flow control fields serialize",
      "steps": [
        {
          "op": "config.new",
          "args": {
            "type": "ConsumerConfig",
            "args": {
              "deliverSubject": "deliver.here",
              "deliverGroup": "group-a",
              "flowControl": true,
              "idleHeartbeat": 2.0
            }
          },
          "expect": {
            "deliver_policy": "all",
            "ack_policy": "explicit",
            "replay_policy": "instant",
            "deliver_subject": "deliver.here",
            "deliver_group": "group-a",
            "flow_control": true,
            "idle_heartbeat": 2000000000
          }
        }
      ]
    },
    {
      "name": "consumer config round trip",
      "steps": [
        {
          "op": "config.from",
          "args": {
            "type": "ConsumerConfig",
            "data": {
              "deliver_subject": "x.y",
              "flow_control": true,
              "idle_heartbeat": 5000000000
            }
          },
          "expect": {
            "array": {
              "deliver_policy": "all",
              "ack_policy": "explicit",
              "replay_policy": "instant",
              "deliver_subject": "x.y",
              "flow_control": true,
              "idle_heartbeat": 5000000000
            },
            "ack_wait": null,
            "inactive_threshold": null,
            "idle_heartbeat": 5.0,
            "backoff": null
          }
        }
      ]
    },
    {
      "name": "consumer info populates sequences",
      "steps": [
        {
          "op": "decode.info",
          "args": {
            "type": "ConsumerInfo",
            "data": {
              "stream_name": "S",
              "name": "C",
              "num_pending": 7,
              "num_ack_pending": 3,
              "delivered": {
                "consumer_seq": 4,
                "stream_seq": 10
              },
              "ack_floor": {
                "consumer_seq": 1,
                "stream_seq": 7
              }
            }
          },
          "expect": {
            "stream_name": "S",
            "name": "C",
            "config": {
              "deliver_policy": "all",
              "ack_policy": "explicit",
              "replay_policy": "instant"
            },
            "created": "",
            "num_ack_pending": 3,
            "num_redelivered": 0,
            "num_waiting": 0,
            "num_pending": 7,
            "delivered": {
              "consumer_seq": 4,
              "stream_seq": 10,
              "last_active": null
            },
            "ack_floor": {
              "consumer_seq": 1,
              "stream_seq": 7,
              "last_active": null
            },
            "push_bound": false,
            "cluster": null,
            "metadata": null
          }
        }
      ]
    },
    {
      "name": "backoff serializes to nanos",
      "steps": [
        {
          "op": "config.new",
          "args": {
            "type": "ConsumerConfig",
            "args": {
              "ackWait": 10.0,
              "maxDeliver": 5,
              "backoff": [
                10.0,
                30.0,
                120.0
              ]
            }
          },
          "expect": {
            "deliver_policy": "all",
            "ack_policy": "explicit",
            "replay_policy": "instant",
            "ack_wait": 10000000000,
            "max_deliver": 5,
            "backoff": [
              10000000000,
              30000000000,
              120000000000
            ]
          }
        }
      ]
    },
    {
      "name": "backoff omitted when unset",
      "steps": [
        {
          "op": "config.new",
          "args": {
            "type": "ConsumerConfig",
            "args": {}
          },
          "expect": {
            "deliver_policy": "all",
            "ack_policy": "explicit",
            "replay_policy": "instant"
          }
        }
      ]
    },
    {
      "name": "backoff round trip",
      "steps": [
        {
          "op": "config.from",
          "args": {
            "type": "ConsumerConfig",
            "data": {
              "backoff": [
                5000000000,
                60000000000
              ]
            }
          },
          "expect": {
            "array": {
              "deliver_policy": "all",
              "ack_policy": "explicit",
              "replay_policy": "instant",
              "backoff": [
                5000000000,
                60000000000
              ]
            },
            "ack_wait": null,
            "inactive_threshold": null,
            "idle_heartbeat": null,
            "backoff": [
              5.0,
              60.0
            ]
          }
        }
      ]
    },
    {
      "name": "stream message decodes its base64 payload",
      "steps": [
        {
          "op": "decode.info",
          "args": {
            "type": "StreamMessage",
            "data": {
              "subject": "foo.bar",
              "seq": 42,
              "data": "dGhlLXBheWxvYWQ="
            }
          },
          "expect": {
            "subject": "foo.bar",
            "seq": 42,
            "data": "the-payload",
            "time": false,
            "headers": null
          }
        }
      ]
    },
