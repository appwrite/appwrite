          "bind": "sub",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "subscription.deliver",
          "args": {
            "sub": {
              "$ref": "sub"
            },
            "data": "x"
          },
          "expect": null
        },
        {
          "op": "subscription.deliver",
