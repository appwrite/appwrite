  "cases": [
    {
      "name": "exceeding the message limit signals and drops",
      "steps": [
        {
          "op": "subscription.new",
          "args": {
            "sid": "1",
            "subject": "foo",
            "msgs_limit": 3,
            "bytes_limit": 1000000,
            "slow": true
