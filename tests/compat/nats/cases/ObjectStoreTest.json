{
  "source": "packages/nats/tests/E2E/ObjectStoreTest.php",
  "cases": [
    {
      "name": "round trip of a multi-chunk payload",
      "steps": [
        {
          "op": "conn.connect",
          "args": {
            "service": "nats"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "js.new",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "bind": "js",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "obj.create_or_update",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "js": {
              "$ref": "js"
            },
            "config": {
              "bucket": "obj_${ns}"
            }
          },
          "bind": "o",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "obj.put",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "obj": {
              "$ref": "o"
            },
            "name": "big.bin",
            "data": "",
            "repeat": 300
          },
          "expect": {
            "name": "big.bin",
            "bucket": "obj_${ns}",
            "nuid": "*",
            "size": 307200,
            "chunks": 3,
            "digest": "SHA-256=30NLwetPRRJUawCGNNm671vCdKkOYZhyO4vFvWDwKwA",
            "mtime": "*"
          }
        },
        {
          "op": "obj.get",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "obj": {
              "$ref": "o"
            },
            "name": "big.bin"
          },
          "expect": {
            "size": 307200,
            "sha256": "df434bc1eb4f4512546b008634d9baef5bc274a90e6198723b8bc5bd60f02b00",
            "data": null
          }
        },
        {
          "op": "obj.get_meta",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "obj": {
              "$ref": "o"
            },
            "name": "big.bin"
          },
          "expect": {
            "name": "big.bin",
            "bucket": "obj_${ns}",
            "nuid": "*",
            "size": 307200,
            "chunks": 3,
            "digest": "SHA-256=30NLwetPRRJUawCGNNm671vCdKkOYZhyO4vFvWDwKwA",
            "mtime": "*"
          }
        },
        {
          "op": "js.delete_object_store",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "js": {
              "$ref": "js"
            },
            "bucket": "obj_${ns}"
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
