{
  "source": "packages/nats/tests/ConnectRetryTest.php",
  "cases": [
    {
      "name": "testRefusedConnectIsRetriedUntilABackendAccepts",
      "op": "fake.connect_passes",
      "args": {
        "options": {
          "servers": "nats://nats.cloud:4222",
          "connectTimeout": 2.0,
          "noRandomize": true,
          "connectAttempts": 3,
          "connectRetryWait": 0.0,
          "connectRetryJitter": 0.0
        },
        "transports": [
          {
            "refuse": {
              "class": "ConnectionException",
              "message": "Failed to connect to tcp://nats.cloud:4222: [111] Connection refused"
            }
          },
          {
            "refuse": {
              "class": "ConnectionException",
              "message": "Failed to connect to tcp://nats.cloud:4222: [111] Connection refused"
            }
          },
          {}
        ],
        "publish": {
          "subject": "jobs",
          "data": "payload"
        }
      },
      "expect": {
        "connected": true,
        "error": null,
        "hosts": [
          "nats.cloud",
          "nats.cloud",
          "nats.cloud"
        ],
        "open": [
          false,
          false,
          true
        ],
        "connects": 3,
        "published": "PUB jobs 7\r\npayload\r\n"
      }
    },
    {
      "name": "testEveryPassWalksTheWholePool",
      "op": "fake.connect_passes",
      "args": {
        "options": {
          "servers": [
            "nats://a.cloud:4222",
            "nats://b.cloud:4222"
          ],
          "connectTimeout": 2.0,
          "noRandomize": true,
          "connectAttempts": 2,
          "connectRetryWait": 0.0,
          "connectRetryJitter": 0.0
        },
        "transports": [
          {
            "refuse": {
              "class": "ConnectionException",
              "message": "Failed to connect to tcp://nats.cloud:4222: [111] Connection refused"
            }
          },
          {
            "refuse": {
              "class": "ConnectionException",
              "message": "Failed to connect to tcp://nats.cloud:4222: [111] Connection refused"
            }
          },
          {}
        ]
      },
      "expect": {
        "connected": true,
        "error": null,
        "hosts": [
          "a.cloud",
          "b.cloud",
          "a.cloud"
        ],
        "open": [
          false,
          false,
          true
        ],
        "connects": 3
      }
    },
    {
      "name": "testExhaustedAttemptsThrowConnectionException (single pass)",
      "op": "fake.connect_passes",
      "args": {
        "options": {
          "servers": "nats://nats.cloud:4222",
          "connectTimeout": 2.0,
          "noRandomize": true,
          "connectAttempts": 1,
          "connectRetryWait": 0.0,
          "connectRetryJitter": 0.0
        },
        "transports": [
          {
            "refuse": {
              "class": "ConnectionException",
              "message": "Failed to connect to tcp://nats.cloud:4222: [111] Connection refused"
            }
          }
        ]
      },
      "expect": {
        "connected": false,
        "error": {
          "class": "Utopia\\NATS\\Exception\\ConnectionException",
          "message": "Failed to connect to any NATS server",
          "previous": {
            "class": "Utopia\\NATS\\Exception\\ConnectionException",
            "message": "Failed to connect to tcp://nats.cloud:4222: [111] Connection refused"
          }
        },
        "hosts": [
          "nats.cloud"
        ],
        "open": [
          false
        ],
        "connects": 1
      }
    },
