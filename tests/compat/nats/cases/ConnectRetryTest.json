    {
      "name": "testServerRejectionIsNotRetried (authorization violation)",
      "op": "fake.connect_passes",
      "args": {
        "options": {
          "servers": "nats://nats.cloud:4222",
          "connectTimeout": 2.0,
          "noRandomize": true,
          "connectAttempts": 3,
          "connectRetryWait": 0.0,
          "connectRetryJitter": 0.0
        },
        "transports": [
          {
            "answer_pings": false,
            "rules": [
              {
                "when": {
                  "prefix": "CONNECT "
                },
                "do": [
                  {
                    "push": "-ERR 'Authorization Violation'\r\n"
                  }
                ]
              }
            ]
          }
        ]
      },
      "expect": {
        "connected": false,
        "error": {
          "class": "Utopia\\NATS\\Exception\\ConnectionException",
          "message": "Failed to connect to any NATS server",
          "previous": {
            "class": "Utopia\\NATS\\Exception\\AuthenticationException",
            "message": "Server error: Authorization Violation"
          }
        },
        "hosts": [
          "nats.cloud"
        ],
        "open": [
          false
        ],
        "connects": 1
      }
    },
