    {
      "name": "testNoPassStartsOnceConnectTimeoutHasElapsed",
      "op": "fake.connect_passes",
      "args": {
        "options": {
          "servers": "nats://nats.cloud:4222",
          "connectTimeout": 0.1,
          "noRandomize": true,
          "connectAttempts": 1000,
          "connectRetryWait": 0.0,
          "connectRetryJitter": 0.0
        },
        "transports": [
          {
            "refuse": {
              "class": "TimeoutException",
              "message": "Failed to connect to tcp://nats.cloud:4222: [110] Connection timed out"
            }
          }
        ],
        "factory_sleep_ms": 20,
        "connects_between": [
          2,
          20
        ],
        "within": 0.5
      },
      "expect": {
        "connected": false,
        "error": {
          "class": "Utopia\\NATS\\Exception\\ConnectionException",
          "message": "Failed to connect to any NATS server",
          "previous": {
            "class": "Utopia\\NATS\\Exception\\TimeoutException",
            "message": "Failed to connect to tcp://nats.cloud:4222: [110] Connection timed out"
          }
        },
        "connects_between": true,
        "starts_within": true,
        "returned_within": true
      }
    }
