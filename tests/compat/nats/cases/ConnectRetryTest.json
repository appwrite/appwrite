      "args": {
        "options": {
          "servers": "nats://nats.cloud:4222",
          "connectTimeout": 0.1,
          "noRandomize": true,
          "connectAttempts": 1000,
          "connectRetryWait": 1.0,
          "connectRetryJitter": 0.0
        },
        "transports": [
          {
            "refuse": {
              "class": "ConnectionException",
              "message": "Failed to connect to tcp://nats.cloud:4222: [111] Connection refused"
            }
          }
        ],
        "within": 0.1
      },
      "expect": {
        "connected": false,
        "error": {
          "class": "Utopia\\NATS\\Exception\\ConnectionException",
          "message": "Failed to connect to any NATS server",
          "previous": {
            "class": "Utopia\\NATS\\Exception\\ConnectionException",
            "message": "Failed to connect to tcp://nats.cloud:4222: [111] Connection refused"
          }
        },
        "hosts": [
          "nats.cloud"
        ],
        "open": [
          false
        ],
        "connects": 1,
        "starts_within": true,
        "returned_within": true
      }
    },
