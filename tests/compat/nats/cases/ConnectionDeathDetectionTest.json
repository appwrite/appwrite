{
  "source": "packages/nats/tests/ConnectionDeathDetectionTest.php",
  "cases": [
    {
      "name": "closesConnection classifies server errors",
      "steps": [
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Stale Connection"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "stale connection"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Slow Consumer"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Maximum Payload Exceeded"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Invalid Client Protocol"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Authorization Violation"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Authentication Expired"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Secure Connection - TLS Required"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Maximum Connections Exceeded"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Unknown Protocol Operation"
          },
          "expect": true
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Permissions Violation for Publish to 'foo'"
          },
          "expect": false
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Maximum Subscriptions Exceeded"
          },
          "expect": false
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": "Invalid Subject"
          },
          "expect": false
        },
        {
          "op": "connection.closes_connection",
          "args": {
            "message": ""
          },
          "expect": false
        }
      ]
    },
