          },
          "expect": false
        },
        {
          "op": "connection.reconnects_after",
          "args": {
            "message": "Authentication Expired"
          },
          "expect": false
        },
        {
          "op": "connection.reconnects_after",
          "args": {
            "message": "Secure Connection - TLS Required"
          },
          "expect": false
        },
        {
          "op": "connection.reconnects_after",
          "args": {
            "message": "Maximum Connections Exceeded"
          },
          "expect": false
        },
        {
          "op": "connection.reconnects_after",
          "args": {
            "message": "Unknown Protocol Operation"
          },
          "expect": false
        }
      ]
    },
    {
      "name": "a connection-closing -ERR triggers a reconnect",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "hooks": {
                "onReconnect": true
              },
              "reconnectWait": 0.0,
              "reconnectJitter": 0.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.push",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "data": "-ERR 'Stale Connection'\r\n"
          },
          "expect": null
        },
        {
          "op": "conn.process_message",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "timeout": 1.0
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\ProtocolException",
              "message": "Server error: Stale Connection"
            }
          }
        },
        {
          "op": "conn.log",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            [
              "transport",
              "nats"
            ],
            [
              "transport",
              "nats"
            ],
            [
              "onReconnect"
            ]
          ]
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": true,
            "closed": false,
            "reconnecting": false,
            "status": "connected",
            "subscriptions": 0
          }
        },
        {
          "op": "fake.count",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "needle": "CONNECT "
          },
          "expect": 2
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
    {
      "name": "a connection-closing -ERR without reconnect marks the connection dead",
      "steps": [
        {
          "op": "fake.connect",
          "args": {
            "options": {
              "allowReconnect": false,
              "reconnectWait": 0.0,
              "reconnectJitter": 0.0
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "fake.push",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "data": "-ERR 'Stale Connection'\r\n"
          },
          "expect": null
        },
        {
          "op": "conn.process_message",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "timeout": 1.0
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\ProtocolException",
              "message": "Server error: Stale Connection"
            }
          }
        },
        {
          "op": "conn.state",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": {
            "connected": false,
            "closed": false,
            "reconnecting": false,
            "status": "disconnected",
            "subscriptions": 0
          }
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "foo",
            "data": "bar"
          },
          "expect": {
            "$error": {
              "class": "Utopia\\NATS\\Exception\\ConnectionException",
              "message": "Not connected (status: disconnected)"
            }
          }
        }
      ]
    },
