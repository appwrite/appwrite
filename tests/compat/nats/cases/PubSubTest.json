            "service": "nats"
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.subscribe",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "test.pubsub.${ns}",
            "mode": "record"
          },
          "bind": "sub",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "conn.publish",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "subject": "test.pubsub.${ns}",
            "data": "hello"
          },
          "expect": null
        },
        {
          "op": "conn.process_message",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "timeout": 1.0
          },
          "expect": {
            "subject": "test.pubsub.${ns}",
            "data": "hello",
            "reply": null,
            "headers": null,
            "sid": "1"
          }
        },
        {
          "op": "conn.log",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": [
            [
              "msg",
              {
                "subject": "test.pubsub.${ns}",
                "data": "hello",
                "reply": null,
                "headers": null,
                "sid": "1"
              }
            ]
          ]
        },
        {
          "op": "conn.unsubscribe",
          "args": {
            "conn": {
              "$ref": "c"
            },
            "sub": {
              "$ref": "sub"
            },
            "via": true
          },
          "expect": null
        },
        {
          "op": "conn.close",
          "args": {
            "conn": {
              "$ref": "c"
            }
          },
          "expect": null
        }
      ]
    },
