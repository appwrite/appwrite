{
  "source": "packages/console/tests/ConsoleTest.php",
  "cases": [
    {
      "name": "testLogs log",
      "op": "console.log",
      "args": {
        "method": "log",
        "message": "log"
      },
      "expect": {
        "result": 4,
        "stdout": "log\n",
        "stderr": "",
        "status": 0
      }
    },
    {
      "name": "testLogs success",
      "op": "console.log",
      "args": {
        "method": "success",
        "message": "success"
      },
      "expect": {
        "result": 17,
        "stdout": "\u001b[32msuccess\u001b[0m\n",
        "stderr": "",
        "status": 0
      }
    },
    {
      "name": "testLogs info",
      "op": "console.log",
      "args": {
        "method": "info",
        "message": "info"
      },
      "expect": {
        "result": 14,
        "stdout": "\u001b[34minfo\u001b[0m\n",
        "stderr": "",
        "status": 0
      }
    },
    {
      "name": "testLogs warning",
      "op": "console.log",
      "args": {
        "method": "warning",
        "message": "warning"
      },
      "expect": {
        "result": 19,
        "stdout": "",
        "stderr": "\u001b[1;33mwarning\u001b[0m\n",
        "status": 0
      }
    },
    {
      "name": "testLogs error",
      "op": "console.log",
      "args": {
        "method": "error",
        "message": "error"
      },
      "expect": {
        "result": 15,
        "stdout": "",
        "stderr": "\u001b[31merror\u001b[0m\n",
        "status": 0
      }
    },
    {
      "name": "testConfirm",
      "op": "console.confirm",
      "args": {
        "question": "this is a question",
        "input": "this is an answer\n"
      },
      "expect": {
        "result": "this is an answer",
        "stdout": "this is a question\n",
        "stderr": "",
        "status": 0
      }
    },
    {
      "name": "testExecuteBasic",
      "op": "console.execute",
      "args": {
        "program": {
          "command": {
            "plain": {
              "executable": "sh",
              "steps": [
                {
                  "option": {
                    "key": "-c",
                    "value": "printf 'hello world'"
                  }
                }
              ]
            }
          }
        },
        "timeout": 10
      },
      "expect": {
        "status": 0,
        "stdout": "hello world",
        "stderr": "",
        "progress": ""
      }
    },
    {
      "name": "testCommandToArray",
      "op": "command.run",
      "args": {
        "expr": {
          "plain": {
            "executable": "tar",
            "steps": [
              {
                "flag": "-cz"
              },
              {
                "option": {
                  "key": "-f",
                  "value": "archive.tar.gz"
                }
              },
              {
                "option": {
                  "key": "-C",
                  "value": "/tmp/project"
                }
              },
              {
                "argument": {
                  "value": "."
                }
              }
            ]
          }
        }
      },
      "expect": {
        "plain": true,
        "array": [
          "tar",
          "-cz",
          "-f",
          "archive.tar.gz",
          "-C",
          "/tmp/project",
          "."
        ],
        "string": "'tar' '-cz' '-f' 'archive.tar.gz' '-C' '/tmp/project' '.'",
        "cast": "'tar' '-cz' '-f' 'archive.tar.gz' '-C' '/tmp/project' '.'"
      }
    },
    {
      "name": "testCommandToStringEscapesArguments",
      "op": "command.run",
      "args": {
        "expr": {
          "plain": {
            "executable": "php",
            "steps": [
              {
                "option": {
                  "key": "-r",
                  "value": "echo 'hello'; rm -rf /"
                }
              }
            ]
          }
        }
      },
      "expect": {
        "plain": true,
        "array": [
          "php",
          "-r",
          "echo 'hello'; rm -rf /"
        ],
        "string": "'php' '-r' 'echo '\\''hello'\\''; rm -rf /'",
        "cast": "'php' '-r' 'echo '\\''hello'\\''; rm -rf /'"
      }
    },
    {
      "name": "testCommandDefaultValidatorRejectsEmptyArgument",
      "op": "command.run",
      "args": {
        "expr": {
          "plain": {
            "executable": "git",
            "steps": [
              {
                "argument": {
                  "value": ""
                }
              }
            ]
          }
        }
      },
      "expect": {
        "error": {
          "$error": {
            "class": "InvalidArgumentException",
            "message": "Command argument cannot be empty"
          }
        }
      }
    },
    {
      "name": "testCommandValidatorSuccess",
      "op": "command.run",
      "args": {
        "expr": {
          "plain": {
            "executable": "git",
            "steps": [
              {
                "argument": {
                  "value": "checkout"
                }
              },
              {
                "argument": {
                  "value": "develop",
                  "check": {
                    "in": [
                      "main",
                      "develop",
                      "staging"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "plain": true,
        "array": [
          "git",
          "checkout",
          "develop"
        ],
        "string": "'git' 'checkout' 'develop'",
        "cast": "'git' 'checkout' 'develop'"
      }
    },
    {
      "name": "testCommandValidatorFailure",
      "op": "command.run",
      "args": {
        "expr": {
          "plain": {
            "executable": "git",
            "steps": [
              {
                "argument": {
                  "value": "checkout"
                }
              },
              {
                "argument": {
                  "value": "feature/test; rm -rf /",
                  "check": {
                    "in": [
                      "main",
                      "develop"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "error": {
          "$error": {
            "class": "InvalidArgumentException",
            "message": "Invalid command argument: feature/test; rm -rf /"
          }
        }
      }
    },
