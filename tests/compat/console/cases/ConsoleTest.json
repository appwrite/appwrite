    {
      "name": "testCommandCompositionToString",
      "op": "command.run",
      "args": {
        "expr": {
          "and": [
            {
              "group": {
                "or": [
                  {
                    "plain": {
                      "executable": "build"
                    }
                  },
                  {
                    "plain": {
                      "executable": "build:fallback"
                    }
                  }
                ]
              }
            },
            {
              "plain": {
                "executable": "publish"
              }
            }
          ]
        }
      },
      "expect": {
        "plain": false,
        "array": {
          "$error": {
            "class": "InvalidArgumentException",
            "message": "Only plain commands can be converted to an array"
          }
        },
        "string": "( 'build' || 'build:fallback' ) && 'publish'",
        "cast": "( 'build' || 'build:fallback' ) && 'publish'"
      }
    },
    {
      "name": "testCommandPipeToString",
      "op": "command.run",
      "args": {
        "expr": {
          "pipe": [
            {
              "plain": {
                "executable": "ps",
                "steps": [
                  {
                    "flag": "-ef"
                  }
                ]
              }
            },
            {
              "plain": {
                "executable": "grep",
                "steps": [
                  {
                    "argument": {
                      "value": "php-fpm"
                    }
                  }
                ]
              }
            },
            {
              "plain": {
                "executable": "wc",
                "steps": [
                  {
                    "flag": "-l"
                  }
                ]
              }
            }
          ]
        }
      },
      "expect": {
        "plain": false,
        "array": {
          "$error": {
            "class": "InvalidArgumentException",
            "message": "Only plain commands can be converted to an array"
          }
        },
        "string": "'ps' '-ef' | 'grep' 'php-fpm' | 'wc' '-l'",
        "cast": "'ps' '-ef' | 'grep' 'php-fpm' | 'wc' '-l'"
      }
    },
