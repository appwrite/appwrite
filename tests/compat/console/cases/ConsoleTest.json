    {
      "name": "testExecuteAndStopsOnFailure",
      "op": "console.execute",
      "args": {
        "program": {
          "command": {
            "and": [
              {
                "plain": {
                  "executable": "sh",
                  "steps": [
                    {
                      "option": {
                        "key": "-c",
                        "value": "printf start; exit 1"
                      }
