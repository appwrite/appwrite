  "waivers": {},
  "tests_waived": {
    "packages/console/tests/CompatTest.php": "Checks that the pre-namespace class names Utopia\\Console and Utopia\\Command (class_alias in src/compat.php) resolve to the moved classes: PHP autoloading plumbing. Rust has one path per item; Console::log and new Command('echo'), which it also calls, are covered by ConsoleTest.json."
  },
  "quirks": [
    {
      "symbol": "Utopia\\Console\\Console::execute",
      "description": "A piece of output or error output read in one go that is exactly \"0\" is dropped: `stream_get_contents(...) ?: ''` treats it as falsy, so it is neither collected nor passed to the progress callback.",
      "case": "edge.json#a piece of output that is exactly 0 is dropped"
    },
    {
      "symbol": "Utopia\\Console\\Command::flag",
      "description": "Flag and option keys are matched with `$` without the D modifier, so a key ending in one newline (\"-v\\n\") is accepted, newline included.",
      "case": "edge.json#a flag may end in one newline"
    }
  ],
  "deviations": [
    {
      "symbol": "Utopia\\Console\\Console::title",
      "php": "cli_set_process_title() rewrites the process's arguments on Linux and macOS, and returns true.",
      "reason": "Rust has no safe way to rewrite argv: on Linux it sets the process name (comm, 15 bytes); elsewhere it returns false. The result is masked: the Rust driver runs on the host OS."
    },
    {
      "symbol": "Utopia\\Console\\Console::execute",
      "php": "The timeout is checked with time(), in whole seconds, so a command is killed between `timeout` and `timeout + 1` seconds after it started; stdin is written in one non-blocking fwrite(), which truncates an input larger than the pipe buffer (64 KiB).",
      "reason": "Rust kills the command as soon as it has run longer than the timeout, and writes the whole input from a task. Both agree for every case that does not race the second boundary or exceed the pipe buffer."
    },
    {
      "symbol": "Utopia\\Console\\Console::loop",
      "php": "The callback's \\Error (engine errors such as TypeError) skips $onError and ends the loop; only \\Exception reaches $onError.",
      "reason": "A Rust callback returns Result: every Err goes to on_error, and Rust has no engine errors to tell apart (a panic propagates)."
    },
    {
      "symbol": "Utopia\\Console\\Command::option",
      "php": "Values may be Stringable objects, cast with (string).",
      "reason": "Arg is built from strings and numbers; a Rust caller converts its type to a String first."
    }
  ]
}
