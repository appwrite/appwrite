{
  "lib": "console",
  "description": "utopia-php/console: log lines, prompts, process titles, shell-safe commands (plain commands, pipelines, &&/|| lists, groups, redirections), running commands with input, output, progress and a timeout, and repeating work.",
  "complete": true,
  "php": {
    "src": [
      "packages/console/src"
    ],
    "tests": [
      "packages/console/tests"
    ]
  },
  "rust": {
    "crate": "crates/utopia/console"
  },
  "services": [],
  "state": [],
  "ops": {
    "command.run": {
      "doc": "Builds a command from `expr`: {plain: {executable, steps}}, {pipe|and|or: [exprs]}, {group: expr}, {redirect_stdout|append_stdout|redirect_input: {command, path}}, {then: {command, steps}}; steps are {flag: key}, {option: {key, value, check}}, {argument: {value, check}} where check is null (Text(0)), {validator: spec} or {in: [values]} (a closure). Returns isPlain(), toArray(), toString() and (string), or the error building it raised",
      "covers": [
        "Utopia\\Console\\Command::__construct",
        "Utopia\\Console\\Command::flag",
        "Utopia\\Console\\Command::option",
        "Utopia\\Console\\Command::argument",
        "Utopia\\Console\\Command::pipe",
        "Utopia\\Console\\Command::and",
        "Utopia\\Console\\Command::or",
        "Utopia\\Console\\Command::group",
        "Utopia\\Console\\Command::redirectStdout",
        "Utopia\\Console\\Command::appendStdout",
        "Utopia\\Console\\Command::redirectInput",
        "Utopia\\Console\\Command::isPlain",
        "Utopia\\Console\\Command::toArray",
        "Utopia\\Console\\Command::toString",
        "Utopia\\Console\\Command::__toString"
      ],
      "fuzz": [
        {
          "name": "plain",
          "args": {
            "gen": "object",
            "fields": {
              "expr": {
                "gen": "ref",
                "name": "plain"
              }
            }
          },
          "iterations": 3000
        },
        {
          "name": "composed",
          "args": {
            "gen": "object",
            "fields": {
              "expr": {
                "gen": "ref",
                "name": "expr"
              }
            }
          },
          "iterations": 2000
        }
      ]
    },
    "console.log": {
      "doc": "Console::log|success|error|info|warning(message) (`method`) in a child process: what it returned, wrote to stdout and to stderr",
      "covers": [
        "Utopia\\Console\\Console::log",
        "Utopia\\Console\\Console::success",
        "Utopia\\Console\\Console::error",
        "Utopia\\Console\\Console::info",
        "Utopia\\Console\\Console::warning"
      ],
      "fuzz": [
        {
          "name": "messages",
          "args": {
            "gen": "object",
            "fields": {
              "method": {
                "gen": "pick",
                "from": [
                  "log",
                  "success",
                  "error",
                  "info",
                  "warning"
                ]
              },
              "message": {
                "gen": "string",
                "max": 24,
                "tricky": 0.4
              }
            }
          },
          "iterations": 60
        }
      ]
    },
    "console.confirm": {
      "doc": "Console::confirm(question) in a child process reading `input`: its answer, and what it wrote",
      "covers": [
        "Utopia\\Console\\Console::confirm"
      ],
      "fuzz": [
        {
          "name": "answers",
          "args": {
            "gen": "object",
            "fields": {
              "question": {
                "gen": "string",
                "max": 12
              },
              "input": {
                "gen": "string",
                "alphabet": "ab \t\n\r\u000b",
                "max": 12
              }
            }
          },
          "iterations": 40
        }
      ]
    },
    "console.exit": {
      "doc": "Console::exit(status) in a child process: the process's exit status",
      "covers": [
        "Utopia\\Console\\Console::exit"
      ]
    },
    "console.title": {
      "doc": "Console::title(title): whether the process title was set",
      "covers": [
        "Utopia\\Console\\Console::title"
      ],
      "mask": {
        "paths": [
          ""
        ],
        "reason": "whether a process can retitle itself depends on the OS the driver runs on (PHP: Linux, in a container; Rust: the host) and on how it does (see deviations)"
      }
    },
    "console.interactive": {
      "doc": "Console::isInteractive()",
      "covers": [
        "Utopia\\Console\\Console::isInteractive"
      ]
    },
    "console.execute": {
      "doc": "Console::execute() of `program` ({command: expr} as command.run, {argv: [...]} or {shell: string}) with `stdin` and `timeout` (seconds; none when absent or not positive): the status, stdout, stderr, and, with `progress`, what the progress callback received",
      "covers": [
        "Utopia\\Console\\Console::execute"
      ],
      "fuzz": [
        {
          "name": "echo",
          "args": {
            "gen": "object",
            "fields": {
              "program": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "object",
                    "fields": {
                      "argv": {
                        "gen": "const",
                        "value": [
                          "cat"
                        ]
                      }
                    }
                  },
                  {
                    "gen": "object",
                    "fields": {
                      "command": {
                        "gen": "object",
                        "fields": {
                          "pipe": {
                            "gen": "const",
                            "value": [
                              {
                                "plain": {
                                  "executable": "cat"
                                }
                              },
                              {
                                "plain": {
                                  "executable": "cat"
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "stdin": {
                "gen": "string",
                "max": 40,
                "tricky": 0.5
              },
              "progress": {
                "gen": "bool"
              }
            }
          },
          "iterations": 100
        },
        {
          "name": "arguments",
          "args": {
            "gen": "object",
            "fields": {
              "program": {
                "gen": "object",
                "fields": {
                  "command": {
                    "gen": "object",
                    "fields": {
                      "and": {
                        "gen": "array",
                        "items": {
                          "gen": "object",
                          "fields": {
                            "plain": {
                              "gen": "object",
                              "fields": {
                                "executable": {
                                  "gen": "const",
                                  "value": "printf"
                                },
                                "steps": {
                                  "gen": "array",
                                  "items": {
                                    "gen": "object",
                                    "fields": {
                                      "argument": {
                                        "gen": "object",
                                        "fields": {
                                          "value": {
                                            "gen": "string",
                                            "alphabet": "abc '\"$`;|&()<>*?~#",
                                            "min": 1,
                                            "max": 10
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "min": 1,
                                  "max": 1
                                }
                              }
                            }
                          }
                        },
                        "min": 2,
                        "max": 3
                      }
                    }
                  }
                }
              }
            }
          },
          "iterations": 100
        }
      ]
    },
    "console.loop": {
      "doc": "Console::loop() with `sleep` and `delay` (seconds) of a callback that throws Exception('fail <n>') on the calls listed in `fail`; with `on_error`, an error handler that records each message and rethrows the `rethrow`-th. Returns the calls made, the errors handled and the message the loop ended with",
      "covers": [
        "Utopia\\Console\\Console::loop"
      ],
      "fuzz": [
        {
          "name": "failures",
          "args": {
            "gen": "one_of",
            "of": [
              {
                "gen": "object",
                "fields": {
                  "fail": {
                    "gen": "array",
                    "items": {
                      "gen": "int",
                      "min": 1,
                      "max": 8
                    },
                    "min": 1,
                    "max": 5
