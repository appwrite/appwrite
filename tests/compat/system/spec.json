  "waivers": {},
  "tests_waived": {},
  "quirks": [
    {
      "symbol": "Utopia\\System\\System::getCPUUsage",
      "description": "the aggregate `cpu` line of /proc/stat never matches /^cpu[0-999]/, so the total is always the sum of the cpuN lines; fields are split on single spaces, so a double space shifts them",
      "case": "SystemTest.json#cpu usage sums cpuN lines"
    },
    {
      "symbol": "Utopia\\System\\System::getCPUUsage",
      "description": "two identical samples (duration 0) divide by zero: DivisionByZeroError",
      "case": "SystemTest.json#cpu usage without elapsed time"
    },
    {
      "symbol": "Utopia\\System\\System::getIOUsage",
      "description": "/proc/diskstats lines are split on single spaces after trim, so real (space-aligned) lines are keyed by an empty third field and overwrite each other; read/write are integers when the MiB division is exact, floats otherwise",
      "case": "SystemTest.json#io usage on space aligned diskstats"
    },
    {
      "symbol": "Utopia\\System\\System::getNetworkUsage",
      "description": "interfaces are skipped when their name contains any of veth, docker, lo, tun, vboxnet, '.', bonding_masters (so wlo1 and eth0.100 are skipped); the duration is slept once per interface",
      "case": "SystemTest.json#network usage filters and sleeps per interface"
    },
    {
      "symbol": "Utopia\\System\\System::getCPU",
      "description": "a negative cgroup v2 quota gives a negative CPU count",
      "case": "SystemTest.json#negative cgroup quota"
    },
    {
      "symbol": "Utopia\\System\\System::getCPU",
      "description": "a cpuset list counting more CPUs than PHP_INT_MAX overflows to a float, which countCpuList()'s int return type refuses with a TypeError",
      "case": "SystemTest.json#cpuset count overflow is a TypeError"
    }
  ],
  "deviations": [
    {
      "symbol": "Utopia\\System\\System::getCPUUsage",
      "php": "a negative $duration raises ValueError from sleep() after the first sample",
      "reason": "durations are u64 seconds in Rust; the adapters only pass non-negative ones"
    },
    {
      "symbol": "Utopia\\System\\System::getDiskTotal",
      "php": "$directory defaults to the library's own source directory (__DIR__)",
      "reason": "System::disk_total takes the directory explicitly: the PHP default names a path inside the PHP package"
    },
    {
      "symbol": "Utopia\\System\\System::getDiskFree",
      "php": "$directory defaults to the library's own source directory (__DIR__)",
      "reason": "System::disk_free takes the directory explicitly"
    }
  ]
}
