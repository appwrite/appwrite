            "0",
            "MemTotal: 1024 kB",
            "MemTotal:1024",
            "MemTotal:\n\t2048 kB",
            "XMemTotal: 3072\nMemTotal: 4096",
            "MemTotal: x\nMemTotal: 5120",
            "MemFree: 1\nMemAvailable: 1023",
            "MemTotal: 99999999999999999999999",
            "MemTotal: 1023",
