        {
          "side": "b",
          "op": "store.load",
          "args": {
            "store": {
              "$ref": "wb"
            }
          },
          "expect": {
            "token": "b",
            "expiresAt": 1787022630.0,
            "coveredUntil": 1787022390.0,
            "syncedUntil": 1787022030.0
          }
        },
        {
          "side": "a",
          "op": "scheduler.tick",
          "args": {
            "scheduler": {
              "$ref": "a"
            }
          },
          "expect": []
        }
      ]
    }
  ]
}
