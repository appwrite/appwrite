              "key": "fn@1787022060.000000"
            }
          ]
        },
        {
          "side": "a",
          "op": "scheduler.commit",
          "args": {
            "scheduler": {
              "$ref": "a"
            }
          },
          "expect": true
        },
        {
          "side": "a",
          "op": "clock.advance",
          "args": {
            "clock": {
              "$ref": "ca"
            },
            "seconds": 300.0
          },
          "expect": null
        },
        {
          "side": "b",
          "op": "clock.advance",
          "args": {
            "clock": {
              "$ref": "cb"
            },
            "seconds": 300.0
          },
          "expect": null
        },
        {
          "side": "b",
          "op": "scheduler.tick",
          "args": {
            "scheduler": {
              "$ref": "b"
            }
          },
          "expect": [
            {
              "id": "fn",
