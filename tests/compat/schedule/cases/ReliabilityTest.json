          "args": {
            "rows": [
              {
                "prefix": "s0-",
                "count": 2000,
                "version": "v1",
                "data": {
                  "interval": 60
                }
              },
              {
                "prefix": "s1-",
                "count": 2000,
                "version": "v1",
                "data": {
                  "interval": 120
                }
              },
              {
                "prefix": "s2-",
                "count": 2000,
                "version": "v1",
                "data": {
                  "interval": 300
                }
              },
