          },
          "bind": "source",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "scheduler.new",
          "args": {
            "source": {
              "$ref": "source"
            },
            "clock": {
              "$ref": "clock"
            },
            "tick": 60,
            "lease": 600,
            "token": "t"
          },
          "bind": "s",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "scheduler.reconcile",
