                "03",
                "12",
                "23"
              ]
            },
            {
              "gen": "const",
              "value": ":"
            },
            {
              "gen": "pick",
              "from": [
                "00",
                "15",
                "29",
                "30",
                "59"
              ]
            },
            {
              "gen": "const",
              "value": ":"
            },
            {
              "gen": "pick",
              "from": [
                "00",
                "01",
                "30",
                "59"
              ]
            },
