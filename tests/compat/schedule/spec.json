      "from": [
        "UTC",
        "America/New_York",
        "Europe/London",
        "Australia/Lord_Howe",
        "Asia/Kolkata",
        "+05:30",
        "-03:00",
        "Pacific/Chatham",
        "America/Sao_Paulo"
      ]
    },
    "window": {
      "gen": "pick",
      "from": [
        "+1 minute",
        "+59 seconds",
        "+90 seconds",
        "+1 hour",
        "+6 hours",
        "+1 day",
        "+3 days",
        "+35 days",
        "-1 hour"
      ]
