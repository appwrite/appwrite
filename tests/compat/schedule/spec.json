            "*/",
            "0#1",
            "#2",
            "l-0",
            "0w",
            "99999999999999999999",
            "L-99999999999999999999",
            "1-2-3",
            "*/2/3"
          ]
        },
        {
          "gen": "string",
          "alphabet": "0123456789*/-,LW#?",
          "min": 1,
          "max": 6
        }
      ]
    },
    "cron": {
      "gen": "one_of",
      "of": [
        {
          "gen": "concat",
          "parts": [
            {
              "gen": "ref",
              "name": "cron_field"
            },
            {
              "gen": "const",
              "value": " "
            },
            {
              "gen": "ref",
              "name": "cron_field"
            },
            {
              "gen": "const",
              "value": " "
            },
            {
              "gen": "ref",
              "name": "cron_field"
            },
            {
              "gen": "const",
              "value": " "
            },
            {
              "gen": "ref",
              "name": "cron_field"
            },
            {
              "gen": "const",
              "value": " "
            },
            {
              "gen": "ref",
              "name": "cron_field"
            }
          ]
        },
        {
          "gen": "pick",
          "from": [
            "@yearly",
            "@annually",
            "@monthly",
            "@weekly",
            "@daily",
            "@midnight",
            "@hourly",
            " @HOURLY ",
            "@reboot",
            "* * * *",
            "* * * * * *",
            "  *\t*\n* * *  ",
            "\f* * * * *",
            "* * * * *\u000b",
            "0 0 31 2 *",
            "0 0 30 2 *",
            "0 12 29 2 *",
            "0 0 L 2 *",
            "0 0 ? * 7L",
            "0 0 13 * 5",
            "30 9 * AUG mon-Fri",
            "not a cron"
          ]
        },
        {
          "gen": "repeat",
          "part": {
            "gen": "ref",
            "name": "cron_field"
          },
          "sep": " ",
          "min": 3,
          "max": 7
        }
      ]
