    "window_short": {
      "gen": "pick",
      "from": [
        "+1 minute",
        "+59 seconds",
        "+90 seconds",
        "+1 hour",
        "+6 hours",
        "-1 hour"
      ]
    },
    "window_medium": {
      "gen": "pick",
      "from": [
        "+1 minute",
        "+90 seconds",
        "+1 hour",
        "+6 hours",
        "+1 day",
        "+3 days",
        "-1 hour"
      ]
    }
  },
  "waivers": {
    "Utopia\\Schedule\\Clock\\System::*": "the wall clock and a real sleep: cases must not depend on the time they run (the Rust SystemClock reads and sleeps on the same clock)"
  },
  "tests_waived": {},
  "quirks": [],
  "deviations": []
}
