    {
      "name": "get with fields",
      "op": "api.call",
      "args": {
        "key": "key",
        "secret": "secret",
        "method": "GET",
        "path": "/json",
        "params": {
          "a": 1,
          "b": [
            "x",
            "y"
          ],
          "c": {
            "d": "e f"
          }
        }
      },
      "expect": {
        "method": "GET",
        "path": "/json",
        "query": "a=1&b%5B0%5D=x&b%5B1%5D=y&c%5Bd%5D=e+f",
        "headers": {
          "authorization": "sso-key key:secret",
          "accept": "application/json",
          "content-type": "application/json"
        },
        "body": "",
        "fields": []
      }
    },
