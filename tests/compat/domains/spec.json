  "deviations": [
    {
      "symbol": "Utopia\\Domains\\Registrar::getPrice",
      "php": "`$regType` is any string: Mock prices an unknown type like a new registration, NameCom raises PriceNotFoundException, OpenSRS sends it to the API, which refuses it.",
      "reason": "utopia_domains::registrar::RegType has the four REG_TYPE_* values only."
    },
    {
      "symbol": "Utopia\\Domains\\Registrar::suggest",
      "php": "`$filterType` is any string: OpenSRS throws `Invalid filter type`, Mock returns no suggestion, NameCom ignores it.",
      "reason": "the filter is an Option<SuggestionKind> (premium or suggestion)."
    },
    {
      "symbol": "Utopia\\Domains\\Registrar::purchase",
      "php": "`$contacts` may hold values that are not Contact objects: Mock and NameCom throw InvalidContactException, OpenSRS fails with an Error on `toArray()`.",
      "reason": "Contacts holds Contact values only."
    },
    {
      "symbol": "Utopia\\Domains\\Registrar::__construct",
      "php": "the default nameservers, cache and timeouts are set on the adapter, so two Registrars sharing one adapter share the settings of the last one built.",
      "reason": "the settings are a Config owned by each Registrar and passed to the adapter on every call; one adapter serves registrars with different settings."
    },
    {
      "symbol": "Utopia\\Domains\\Registrar\\Adapter\\NameCom::available",
      "php": "available() and suggest() (`available`, `purchaseType`) return the answer's values as they are, even when the API sends something other than a boolean or a string.",
      "reason": "Availability and Suggestion::available are bool (other values are read by PHP truthiness) and Suggestion::purchase_type a string (other values in their PHP string form)."
    },
    {
      "symbol": "Utopia\\Domains\\Cache::save",
      "php": "returns what the Utopia cache adapter returns: the data when stored, false otherwise.",
      "reason": "Cache::save returns whether the data was stored (the data is the caller's own)."
    }
  ],
