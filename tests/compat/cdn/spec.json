  "waivers": {},
  "tests_waived": {},
  "deviations": [
    {
      "symbol": "Utopia\\Cdn\\Domain::validatePaths",
      "php": "an entry that is not a string fails with InvalidArgumentException (`Every cache path must be a string beginning with \"/\".`).",
      "reason": "utopia_cdn::domain::validate_paths takes a slice of strings, so a non-string path cannot be passed."
    },
    {
      "symbol": "Utopia\\Cdn\\Cache\\Adapter\\Cloudflare::purgeKeys",
      "php": "keys that are not strings (integers) are sent as JSON numbers in `tags` (Fastly: in `surrogate_keys`); keys or paths that are not valid UTF-8 fail json_encode with JsonException.",
      "reason": "cache::Adapter::purge_keys and purge_paths take Rust Strings, which are always valid UTF-8 text."
    },
    {
      "symbol": "Utopia\\Cdn\\Cache\\Adapter\\Fastly::purgePaths",
      "php": "a path that is not valid UTF-8 makes the /u pattern of encodePath() fail, so the purge URL loses its path (`/purge/<domain>`).",
      "reason": "paths are Rust Strings, always valid UTF-8."
    },
    {
      "symbol": "Utopia\\Cdn\\Extend\\CdnOption::getAdapter",
      "php": "state overwritten through setState() with a value of the wrong type fails getAdapter()/getProvider() with Exception\\Configuration (CdnOptionTest::testRejectsStateOverwrittenWithTheWrongType).",
      "reason": "CdnOption keeps its adapter, provider and edge flag in typed fields with no generic state setter, so state of the wrong type cannot be set."
    },
    {
      "symbol": "Utopia\\Cdn\\Cache\\Adapter\\Balancer::purgeDomain",
      "php": "a balancer option that is not a CdnOption fails every purge with Exception\\Configuration (`Cache options must be instances of Utopia\\Cdn\\Extend\\CdnOption.`, BalancerTest::testRejectsOptionsThatCarryNoAdapter).",
      "reason": "cache::Balancer wraps a utopia_balancer::Balancer<CdnOption, _>, which holds CdnOptions only."
    },
    {
      "symbol": "Utopia\\Cdn\\Certificates\\Provider\\Proxy::getCertificateStatus",
      "php": "a provider may report any string as a status, and Proxy (and Certificates) return it unchanged.",
      "reason": "certificates::Provider::certificate_status returns certificates::Status, the seven Status constants."
    },
    {
      "symbol": "Utopia\\Cdn\\Exception\\Certificate::__construct",
      "php": "`$status` is any string; isBlocked() is true only for `blocked`.",
      "reason": "Blocked::status is a certificates::Status."
    }
  ],
  "quirks": [
    {
      "symbol": "Utopia\\Cdn\\Certificates\\Provider\\FastlyTls::issueCertificate",
      "description": "FastlyTls.php has no strict_types, so a subscription ID or state of the wrong type is coerced to a string (an integer ID retries `/tls/subscriptions/7`); an array, or a missing ID, raises TypeError. PHP's message names the source file and line; Rust's ends `called in FastlyTls.php on line <n>`, so the message is masked.",
      "case": "FastlyTlsTest.json#retry of a subscription without an id"
    },
    {
      "symbol": "Utopia\\Cdn\\Certificates\\Provider\\FastlyTls::issueCertificate",
      "description": "an expiry date strtotime() cannot read sorts below every readable one, and new DateTimeImmutable() of it raises DateMalformedStringException when it is the only date",
      "case": "FastlyTlsTest.json#renew dates"
    },
    {
      "symbol": "Utopia\\Cdn\\Cache\\Adapter\\Cloudflare::purgeZone",
      "description": "a 2xx response is a success unless its body is a JSON object with a `success` key that is not exactly true (`{\"success\":1}` and `{\"success\":null}` fail, `[true]` succeeds)",
      "case": "CacheCloudflareTest.json#envelope edge cases"
    }
  ]
}
