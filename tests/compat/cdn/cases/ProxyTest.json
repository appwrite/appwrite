            "renew": false
          },
          "bind": "app",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.new",
          "args": {
            "type": "proxy",
            "app_domain": "https://app.example.com",
            "app": {
              "$ref": "app"
