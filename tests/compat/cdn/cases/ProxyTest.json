{
  "source": "packages/cdn/tests/Certificates/Provider/ProxyTest.php",
  "cases": [
    {
      "name": "routes and aggregates providers",
      "steps": [
        {
          "op": "log.new",
          "args": {},
          "bind": "calls",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.new",
          "args": {
            "type": "recorder",
            "name": "app",
            "log": {
              "$ref": "calls"
            },
            "status": "issued",
            "instant": false,
            "renew": false
          },
          "bind": "app",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.new",
          "args": {
            "type": "recorder",
            "name": "network",
            "log": {
              "$ref": "calls"
            },
            "status": "pending",
            "instant": false,
            "renew": true
          },
          "bind": "network",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.new",
          "args": {
            "type": "recorder",
            "name": "cloudflare",
            "log": {
              "$ref": "calls"
            },
            "status": "unknown",
            "instant": true,
            "renew": false
          },
          "bind": "instant",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.new",
          "args": {
            "type": "recorder",
            "name": "fastly",
            "log": {
              "$ref": "calls"
            },
            "status": "issued",
            "instant": false,
            "renew": false,
            "date": "2027-01-01"
          },
          "bind": "fastly",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.new",
          "args": {
            "type": "proxy",
            "app_domain": "app.example.com",
            "app": {
              "$ref": "app"
            },
            "network": {
              "$ref": "network"
            },
            "custom": [
              {
                "$ref": "instant"
              },
              {
                "$ref": "fastly"
              }
            ]
          },
          "bind": "proxy",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "proxy"
            },
            "method": "issueCertificate",
            "domain": "custom.example.com",
            "cert_name": "cert"
          },
          "expect": {
            "result": "2027-01-01"
          }
        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "proxy"
            },
            "method": "isInstantGeneration",
            "domain": "custom.example.com"
          },
          "expect": {
            "result": false
          }
        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "proxy"
            },
            "method": "getCertificateStatus",
            "domain": "custom.example.com"
          },
          "expect": {
            "result": "issued"
          }
        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "proxy"
            },
            "method": "isRenewRequired",
            "domain": "site.example.com",
            "domain_type": "site"
          },
          "expect": {
            "result": true
          }
        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "proxy"
            },
            "method": "deleteCertificate",
            "domain": "app.example.com"
          },
          "expect": {
            "result": null
          }
        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "proxy"
            },
            "method": "deleteCertificate",
            "domain": "site.example.com",
            "domain_type": "site"
          },
          "expect": {
            "result": null
          }
        },
        {
          "op": "log.take",
          "args": {
            "log": {
              "$ref": "calls"
            }
          },
          "expect": [
            "cloudflare:issue:custom.example.com",
            "fastly:issue:custom.example.com",
            "app:delete:app.example.com",
            "network:delete:site.example.com"
          ]
        }
      ]
    },
