    {
      "name": "rejects missing custom providers",
      "steps": [
        {
          "op": "log.new",
          "args": {},
          "bind": "calls",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.new",
          "args": {
            "type": "recorder",
            "name": "app",
            "log": {
              "$ref": "calls"
            },
            "status": "issued",
            "instant": false,
            "renew": false
          },
          "bind": "app",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.new",
          "args": {
            "type": "proxy",
            "app_domain": "app.example.com",
            "app": {
              "$ref": "app"
            },
            "network": {
              "$ref": "app"
            },
            "custom": []
          },
          "bind": "proxy",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "proxy"
            },
            "method": "issueCertificate",
            "domain": "custom.example.com",
            "cert_name": "cert"
          },
          "expect": {
            "error": {
              "class": "Utopia\\Cdn\\Exception\\Configuration",
              "message": "No certificate providers are configured for custom domains."
            }
          }
