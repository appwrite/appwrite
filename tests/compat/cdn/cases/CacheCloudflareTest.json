  "cases": [
    {
      "name": "purges paths and domain",
      "steps": [
        {
          "op": "cache.new",
          "args": {
            "type": "cloudflare",
            "zone": "zone-id",
            "token": "token"
          },
          "bind": "cf",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.call",
          "args": {
            "cache": {
              "$ref": "cf"
            },
            "method": "purgePaths",
            "domain": "example.com",
            "paths": [
              "/a",
              "/b?x=1"
            ],
            "responses": [
              {
                "status": 200,
                "body": "{\"success\":true}"
              }
            ]
          },
          "expect": {
            "result": null,
            "requests": [
              {
                "method": "POST",
                "url": "https://api.cloudflare.com/client/v4/zones/zone-id/purge_cache",
                "headers": {
                  "accept": "application/json",
                  "authorization": "Bearer token",
                  "content-type": "application/json",
                  "user-agent": "Utopia CDN Cloudflare Adapter"
                },
                "body": "{\"files\":[\"https:\\/\\/example.com\\/a\",\"https:\\/\\/example.com\\/b?x=1\"]}"
              }
            ]
          }
        },
        {
          "op": "cache.call",
          "args": {
            "cache": {
              "$ref": "cf"
            },
            "method": "purgeDomain",
            "domain": "example.com",
            "responses": [
              {
                "status": 200,
                "body": "{\"success\":true}"
              }
            ]
          },
          "expect": {
            "result": null,
            "requests": [
              {
                "method": "POST",
                "url": "https://api.cloudflare.com/client/v4/zones/zone-id/purge_cache",
                "headers": {
                  "accept": "application/json",
                  "authorization": "Bearer token",
                  "content-type": "application/json",
                  "user-agent": "Utopia CDN Cloudflare Adapter"
                },
                "body": "{\"hosts\":[\"example.com\"]}"
              }
            ]
          }
        }
      ]
    },
