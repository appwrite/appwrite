{
  "source": "packages/cdn/tests/Cache/Adapter/FastlyTest.php",
  "cases": [
    {
      "name": "purges paths and keys",
      "steps": [
        {
          "op": "cache.new",
          "args": {
            "type": "fastly",
            "token": "token",
            "prefix": "domain-",
            "service": "service-id",
            "soft": true
          },
          "bind": "f",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.call",
          "args": {
            "cache": {
              "$ref": "f"
            },
            "method": "purgePaths",
            "domain": "example.com",
            "paths": [
              "/hello world?x=1"
            ],
            "responses": [
              {
                "status": 200,
                "body": "{\"status\":\"ok\"}"
              }
            ]
          },
          "expect": {
            "result": null,
            "requests": [
              {
                "method": "POST",
                "url": "https://api.fastly.com/purge/example.com/hello%20world?x=1",
                "headers": {
                  "accept": "application/json",
                  "fastly-key": "token",
                  "fastly-soft-purge": "1",
                  "user-agent": "Utopia CDN Fastly Adapter"
                },
                "body": ""
              }
            ]
          }
        },
        {
          "op": "cache.call",
          "args": {
            "cache": {
              "$ref": "f"
            },
            "method": "purgeKeys",
            "keys": [
              "key"
            ],
            "responses": [
              {
                "status": 200,
                "body": "{\"status\":\"ok\"}"
              }
            ]
          },
          "expect": {
            "result": null,
            "requests": [
              {
                "method": "POST",
                "url": "https://api.fastly.com/service/service-id/purge",
                "headers": {
                  "accept": "application/json",
                  "content-type": "application/json",
                  "fastly-key": "token",
                  "fastly-soft-purge": "1",
                  "user-agent": "Utopia CDN Fastly Adapter"
                },
                "body": "{\"surrogate_keys\":[\"key\"]}"
              }
            ]
          }
        }
      ]
    },
