{
  "source": "packages/cdn/tests/Certificates/Provider/CloudflareTest.php",
  "cases": [
    {
      "name": "creates custom hostname",
      "steps": [
        {
          "op": "certificates.new",
          "args": {
            "type": "cloudflare",
            "zone": "zone",
            "token": "token"
          },
          "bind": "p",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "p"
            },
            "method": "issueCertificate",
            "domain": "example.com",
            "cert_name": "ignored",
            "responses": [
              {
                "status": 201,
                "body": "{\"success\":true,\"result\":{\"id\":\"host_1\"}}"
              }
            ]
          },
          "expect": {
            "result": null,
            "requests": [
              {
                "method": "POST",
                "url": "https://api.cloudflare.com/client/v4/zones/zone/custom_hostnames",
                "headers": {
                  "accept": "application/json",
                  "authorization": "Bearer token",
                  "content-type": "application/json",
                  "user-agent": "Utopia CDN Cloudflare Certificates Provider"
                },
                "body": "{\"hostname\":\"example.com\",\"ssl\":{\"method\":\"http\",\"type\":\"dv\",\"wildcard\":false}}"
              }
            ]
          }
        }
      ]
    },
