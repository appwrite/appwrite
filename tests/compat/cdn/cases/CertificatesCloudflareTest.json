            },
            "method": "deleteCertificate",
            "domain": "example.com",
            "responses": [
              {
                "status": 200,
                "body": "{\"success\":true,\"result\":[{\"id\":\"a/b c\",\"hostname\":\"example.com\"}]}"
              },
              {
                "status": 200,
                "body": "{\"success\":false,\"errors\":[{\"message\":\"locked\"}]}"
              }
            ]
          },
          "expect": {
