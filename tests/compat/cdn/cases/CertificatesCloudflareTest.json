        },
        {
          "op": "certificates.call",
          "args": {
            "provider": {
              "$ref": "p"
            },
            "method": "deleteCertificate",
            "domain": "example.com",
            "responses": [
              {
                "status": 200,
                "body": "{\"success\":true,\"result\":[{\"hostname\":\"example.com\"}]}"
              }
