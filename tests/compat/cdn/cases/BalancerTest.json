    {
      "name": "one failing provider still purges the others",
      "steps": [
        {
          "op": "log.new",
          "args": {},
          "bind": "calls",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "type": "recorder",
            "name": "fastly",
            "log": {
              "$ref": "calls"
            },
            "fails": true
          },
          "bind": "f",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "option.new",
          "args": {
            "adapter": {
              "$ref": "f"
            },
            "provider": "fastly"
          },
          "bind": "of",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "type": "recorder",
            "name": "cloudflare",
            "log": {
              "$ref": "calls"
            }
          },
          "bind": "cf",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "option.new",
          "args": {
            "adapter": {
              "$ref": "cf"
            },
            "provider": "cloudflare"
          },
          "bind": "ocf",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "type": "balancer",
            "options": [
              {
                "$ref": "of"
              },
              {
                "$ref": "ocf"
              }
            ]
          },
          "bind": "b",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.new",
          "args": {
            "type": "facade",
            "adapter": {
              "$ref": "b"
            }
          },
          "bind": "c",
          "expect": {
            "$handle": "*"
          }
        },
        {
          "op": "cache.call",
          "args": {
            "cache": {
              "$ref": "c"
            },
            "method": "purgeKeys",
            "keys": [
              "domain-example.com"
            ]
          },
          "expect": {
            "error": {
              "class": "Utopia\\Cdn\\Exception\\Purge",
              "message": "Cache cache key purging failed for fastly.",
              "errors": [
                {
                  "class": "RuntimeException",
                  "message": "fastly purge failed."
                }
              ],
              "previous": {
                "class": "RuntimeException",
                "message": "fastly purge failed."
              }
            }
          }
        },
        {
          "op": "log.take",
          "args": {
            "log": {
              "$ref": "calls"
            }
          },
          "expect": [
            {
              "call": "fastly:keys",
              "args": [
                [
                  "domain-example.com"
                ]
              ]
            },
            {
              "call": "cloudflare:keys",
              "args": [
                [
                  "domain-example.com"
                ]
              ]
            }
          ]
        }
      ]
    },
