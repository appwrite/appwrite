          {
            "set_resource": {
              "name": "first",
              "value": "first",
              "dependencies": [
                "second"
              ]
            }
          },
          {
            "set_resource": {
              "name": "second",
              "value": "second"
            }
          },
          {
            "resource": "second"
          },
          {
            "resource": "first"
          },
          {
            "resource": "rand"
          },
          {
            "resource": "rand"
          },
          {
            "resource": "rand"
          },
          {
            "resource": "rand"
          }
        ]
      },
      "expect": [
        null,
        null,
        null,
        "second",
        [
          "first",
          "second"
        ],
        1,
        1,
        1,
        1
      ]
    },
