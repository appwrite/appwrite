{
  "cases": [
    {
      "name": "missing command",
      "op": "cli.run",
      "args": {
        "argv": [
          "test.php"
        ],
        "steps": []
      },
      "expect": [
        {
          "$error": {
            "class": "Exception",
            "message": "Missing command",
            "code": 0
          }
        }
      ]
    },
    {
      "name": "empty argv: PHP reads $_SERVER['argv'] (the driver's), Rust none: both have no command",
      "op": "cli.run",
      "args": {
        "argv": [],
        "steps": []
      },
      "expect": [
        {
          "$error": {
            "class": "Exception",
            "message": "Missing command",
            "code": 0
          }
        }
      ]
    },
    {
      "name": "parse: -- prefix, repeated keys, keys without values, values with =",
      "op": "cli.run",
      "args": {
        "argv": [
          "app",
          "build",
          "--a=1",
          "--a=2",
          "--a=3",
          "b=x=y",
          "--flag",
          "--",
          "---c=d",
          ""
        ],
        "steps": [
          {
            "args": true
          },
          {
            "match": true
          },
          {
            "parse": [
              "x",
              "deploy",
              "--z=1"
            ]
          },
          {
            "match": true
          },
          {
            "args": true
          }
        ]
      },
      "expect": [
        {
          "a": [
            "1",
            "2",
            "3"
          ],
          "b": "x=y",
          "flag": null,
          "": [
            null,
            null
          ],
          "-c": "d"
        },
        null,
        {
          "z": "1"
        },
        null,
        {
          "a": [
            "1",
            "2",
            "3"
          ],
          "b": "x=y",
          "flag": null,
          "": [
            null,
            null
          ],
          "-c": "d"
        }
      ]
    },
    {
      "name": "parse without a command",
      "op": "cli.run",
      "args": {
        "argv": [
          "app",
          "build"
        ],
        "steps": [
          {
            "parse": [
              "only"
            ]
          },
          {
            "match": true
          }
        ]
      },
      "expect": [
        {
          "$error": {
            "class": "Exception",
            "message": "Missing command",
            "code": 0
          }
        },
        null
      ]
    },
    {
      "name": "no command found goes to the error hooks",
      "op": "cli.run",
      "args": {
        "argv": [
          "app",
          "missing"
        ],
        "steps": [
          {
            "task": {
              "name": "build",
              "id": "build"
            }
          },
          {
            "error": {
              "id": "e1",
              "inject": [
                "error"
              ]
            }
          },
          {
            "error": {
              "id": "e2"
            }
          },
          {
            "run": true
          }
        ]
      },
      "expect": [
        true,
        true,
        true,
        {
          "calls": [
            [
              "e1",
              {
                "error": {
                  "$exception": {
                    "class": "Exception",
                    "message": "No command found",
                    "code": 0
                  }
                }
              }
            ],
            [
              "e2",
              []
            ]
          ],
          "error": null
        }
      ]
    },
    {
      "name": "no command found without error hooks is silent",
      "op": "cli.run",
      "args": {
        "argv": [
          "app",
          "missing"
        ],
        "steps": [
          {
            "run": true
          }
        ]
      },
      "expect": [
        {
          "calls": [],
          "error": null
        }
      ]
    },
    {
      "name": "a failing task skips shutdown and reaches every error hook",
      "op": "cli.run",
      "args": {
        "argv": [
          "app",
          "build"
        ],
        "steps": [
          {
            "init": {
              "id": "init"
            }
          },
          {
            "shutdown": {
              "id": "shutdown"
            }
          },
          {
            "task": {
              "name": "build",
              "id": "build",
              "fail": {
                "message": "boom",
                "code": 42
              }
            }
          },
          {
            "error": {
              "id": "e1",
              "inject": [
                "error"
              ]
            }
          },
          {
            "error": {
              "id": "e2",
              "inject": [
                "error"
              ]
            }
          },
          {
            "run": true
          }
        ]
      },
      "expect": [
        true,
        true,
        true,
        true,
        true,
        {
          "calls": [
            [
              "init",
              []
            ],
            [
              "build",
              []
            ],
            [
              "e1",
              {
                "error": {
                  "$exception": {
                    "class": "Exception",
                    "message": "boom",
                    "code": 42
                  }
                }
              }
            ],
            [
              "e2",
              {
                "error": {
                  "$exception": {
                    "class": "Exception",
                    "message": "boom",
                    "code": 42
                  }
                }
              }
            ]
          ],
          "error": null
        }
      ]
    },
