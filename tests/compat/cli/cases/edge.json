    {
      "name": "setContainer replaces the parent; reset keeps it",
      "op": "cli.run",
      "args": {
        "argv": [
          "app",
          "build"
        ],
        "steps": [
          {
            "set_resource": {
              "name": "own",
              "value": "o"
            }
          },
          {
            "set_container": {
              "base": "new-base"
            }
          },
          {
            "has": "own"
          },
          {
            "has": "base"
          },
          {
            "resource": "base"
          },
          {
            "set_resource": {
              "name": "own",
              "value": "o2"
            }
          },
          {
            "reset": true
          },
          {
            "has": "own"
          },
          {
            "resource": "base"
          }
        ],
        "container": {
          "base": "old-base"
        }
      },
      "expect": [
        null,
        true,
        false,
        true,
        "new-base",
        null,
        null,
        false,
        "new-base"
      ]
    },
