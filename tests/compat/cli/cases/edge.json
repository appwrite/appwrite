          "--e=first"
        ],
        "steps": [
          {
            "task": {
              "name": "build",
              "id": "build",
              "params": [
                {
                  "key": "email",
                  "default": null,
                  "validator": {
                    "text": [
                      0
                    ]
                  },
                  "description": "Valid email address",
                  "aliases": [
                    "e",
                    "em"
                  ]
                }
              ]
            }
          },
          {
            "task": {
              "name": "build",
              "id": "build",
              "params": [
                {
                  "key": "email",
                  "default": null,
                  "validator": {
                    "text": [
                      0
                    ]
                  },
                  "description": "Valid email address",
                  "aliases": [
                    "em",
                    "e"
                  ]
