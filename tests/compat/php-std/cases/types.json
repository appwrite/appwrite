{
  "source": "php-std",
  "cases": [
    {
      "name": "value: key types, order and normalisation",
      "op": "types.value",
      "args": {
        "v": {
          "$array": [
            [
              1,
              "a"
            ],
            [
              "x",
              [
                [],
                [],
                {}
              ]
            ],
            [
              "1",
              "overwrites 1 in place"
            ],
            [
              "01",
              1
            ],
            [
              "-0",
              2
            ],
            [
              -5,
              3
            ],
            [
              "9223372036854775808",
              4
            ],
            [
              "9223372036854775807",
              5
            ]
          ]
        }
      },
      "expect": {
        "$array": [
          [
            1,
            "overwrites 1 in place"
          ],
          [
            "x",
            [
              [],
              [],
              {
                "$object": []
              }
            ]
          ],
          [
            "01",
            1
          ],
          [
            "-0",
            2
          ],
          [
            -5,
            3
          ],
          [
            "9223372036854775808",
            4
          ],
          [
            9223372036854775807,
            5
          ]
        ]
      }
    },
    {
      "name": "value: stdClass keeps numeric property names",
      "op": "types.value",
      "args": {
        "v": {
          "$object": [
            [
              "1",
              2
            ],
            [
              3,
              4
            ],
            [
              "",
              -0.0
            ],
            [
              "a",
              {
                "$object": []
              }
            ]
          ]
        }
      },
      "expect": {
        "$object": [
          [
            "1",
            2
          ],
          [
            "3",
            4
          ],
          [
            "",
            {
              "$float": "-0"
            }
          ],
          [
            "a",
            {
              "$object": []
            }
          ]
        ]
      }
    },
    {
      "name": "value: binary strings and keys",
      "op": "types.value",
      "args": {
        "v": {
          "$array": [
            [
              {
                "$bytes": "/w=="
              },
              {
                "$bytes": "AP8="
              }
            ],
            [
              "k",
              {
                "$bytes": "gA=="
              }
            ]
          ]
        }
      },
      "expect": {
        "$array": [
          [
            {
              "$bytes": "/w=="
            },
            {
              "$bytes": "AP8="
            }
          ],
          [
            "k",
            {
              "$bytes": "gA=="
            }
          ]
        ]
      }
    },
    {
      "name": "value: floats",
      "op": "types.value",
      "args": {
        "v": [
          1.0,
          -0.0,
          0.1,
          1e+25,
          {
            "$float": "INF"
          },
          {
            "$float": "-INF"
          },
          {
            "$float": "NAN"
          },
          5e-324
        ]
      },
      "expect": [
        1.0,
        {
          "$float": "-0"
        },
        0.1,
        1e+25,
        {
          "$float": "INF"
        },
        {
          "$float": "-INF"
        },
        {
          "$float": "NAN"
        },
        5e-324
      ]
    },
    {
      "name": "from_json: request decoding",
      "op": "types.from_json",
      "args": {
        "v": {
          "0": "a",
          "1": {
            "x": [],
            "y": {}
          },
          "k": {},
          "-1": 1.0,
          "01": 9223372036854775807
        }
      },
      "expect": {
        "$array": [
          [
            0,
            "a"
          ],
          [
            1,
            {
              "$array": [
                [
                  "x",
                  []
                ],
                [
                  "y",
                  {
                    "$object": []
                  }
                ]
              ]
            }
          ],
          [
            "k",
            {
              "$object": []
            }
          ],
          [
            -1,
            1.0
          ],
          [
            "01",
            9223372036854775807
          ]
        ]
      }
    },
    {
      "name": "from_json: a list-shaped object is a list",
      "op": "types.from_json",
      "args": {
        "v": {
          "0": 1,
          "1": 2
        }
      },
      "expect": [
        1,
        2
      ]
    },
    {
      "name": "from_json: integers beyond i64 are floats",
      "op": "types.from_json",
      "args": {
        "v": [
          18446744073709551615,
          -9223372036854775808,
          1.5
        ]
      },
      "expect": [
        1.8446744073709552e+19,
        -9223372036854775808,
        1.5
      ]
    },
    {
      "name": "json.decode_typed: stdClass keeps property names",
      "op": "json.decode_typed",
      "args": {
        "s": "{\"1\":{\"0\":[]},\"\":{},\"a\":[1.0,-0.0]}",
        "assoc": false
      },
      "expect": {
        "value": {
          "$object": [
            [
              "1",
              {
                "$object": [
                  [
                    "0",
                    []
                  ]
                ]
              }
            ],
            [
              "",
              {
                "$object": []
              }
            ],
            [
              "a",
              [
                1.0,
                {
                  "$float": "-0"
                }
              ]
            ]
          ]
        },
        "error": 0
      }
    },
    {
      "name": "json.decode_typed: assoc normalises keys",
      "op": "json.decode_typed",
      "args": {
        "s": "{\"1\":{\"0\":[]},\"\":{},\"a\":[1.0,-0.0],\"1\":2}",
        "assoc": true
      },
      "expect": {
        "value": {
          "$array": [
            [
              1,
              2
            ],
            [
              "",
              []
            ],
            [
              "a",
              [
                1.0,
                {
                  "$float": "-0"
                }
              ]
            ]
          ]
        },
        "error": 0
      }
    },
    {
      "name": "json.decode_typed: duplicate keys keep their position",
      "op": "json.decode_typed",
      "args": {
        "s": "{\"a\":1,\"b\":2,\"a\":3}"
      },
      "expect": {
        "value": {
          "$object": [
            [
              "a",
              3
            ],
            [
              "b",
              2
            ]
          ]
        },
        "error": 0
      }
    },
    {
      "name": "json.decode_typed: invalid",
      "op": "json.decode_typed",
      "args": {
        "s": "{\"a\":"
      },
      "expect": {
        "value": null,
        "error": 4
      }
    },
    {
      "name": "to_json: lists, maps, objects",
      "op": "types.to_json",
      "args": {
        "v": {
          "$array": [
            [
              0,
              [
                1,
                2.0
              ]
            ],
            [
              "a",
              {
                "$object": [
                  [
                    "1",
                    null
                  ]
                ]
              }
            ],
            [
              5,
              {}
            ]
          ]
        }
      },
      "expect": {
        "0": [
          1,
          2.0
        ],
        "a": {
          "1": null
        },
        "5": {}
      }
    },
