{
  "source": "php-std",
  "cases": [
    { "name": "parse_url full", "op": "url.parse_url", "args": { "url": "https://u:p@example.com:8080/a/b?x=1#frag" } },
    { "name": "parse_url empty string is an empty path", "op": "url.parse_url", "args": { "url": "" } },
    { "name": "parse_url host:port without scheme", "op": "url.parse_url", "args": { "url": "a.com:80" } },
    { "name": "parse_url host:port/path without scheme", "op": "url.parse_url", "args": { "url": "a.com:80/x" } },
    { "name": "parse_url mailto", "op": "url.parse_url", "args": { "url": "mailto:a@b.c" } },
    { "name": "parse_url scheme only", "op": "url.parse_url", "args": { "url": "http:" } },
    { "name": "parse_url scheme-relative", "op": "url.parse_url", "args": { "url": "//example.com/x" } },
    { "name": "parse_url empty host fails", "op": "url.parse_url", "args": { "url": "http://" } },
    { "name": "parse_url port out of range fails", "op": "url.parse_url", "args": { "url": "http://a:65536" } },
    { "name": "parse_url six-digit port fails", "op": "url.parse_url", "args": { "url": "http://a:123456/" } },
    { "name": "parse_url port prefix digits", "op": "url.parse_url", "args": { "url": "http://a:8a" } },
    { "name": "parse_url port with sign", "op": "url.parse_url", "args": { "url": "http://a:+80" } },
    { "name": "parse_url port zero", "op": "url.parse_url", "args": { "url": "http://a:0/" } },
    { "name": "parse_url empty port", "op": "url.parse_url", "args": { "url": "http://a:/" } },
    { "name": "parse_url colon only fails", "op": "url.parse_url", "args": { "url": ":" } },
    { "name": "parse_url leading colon port", "op": "url.parse_url", "args": { "url": ":80" } },
    { "name": "parse_url ipv6 host", "op": "url.parse_url", "args": { "url": "http://[::1]:80/a" } },
    { "name": "parse_url ipv6 without port", "op": "url.parse_url", "args": { "url": "http://[::1]/a" } },
    { "name": "parse_url last @ separates userinfo", "op": "url.parse_url", "args": { "url": "http://a@b@c/" } },
    { "name": "parse_url control characters become underscores", "op": "url.parse_url", "args": { "url": "http://h\u0001st/p\u007fa?q\u0000#f\u001f" } },
    { "name": "parse_url windows drive", "op": "url.parse_url", "args": { "url": "file:///c:/dir/file.txt" } },
    { "name": "parse_url file triple slash", "op": "url.parse_url", "args": { "url": "file:///etc/passwd" } },
    { "name": "parse_url empty query and fragment", "op": "url.parse_url", "args": { "url": "x?#" } },
    { "name": "parse_url invalid scheme chars become path", "op": "url.parse_url", "args": { "url": "a b:c" } },
    { "name": "parse_url invalid utf-8", "op": "url.parse_url", "args": { "url": { "$bytes": "aHR0cDovL2V4YW1wbGUuY29tL/8=" } } },
    { "name": "component scheme", "op": "url.parse_url_component", "args": { "url": "HTTPS://x", "component": 0 } },
    { "name": "component host", "op": "url.parse_url_component", "args": { "url": "https://Example.com:1/p", "component": 1 } },
    { "name": "component port", "op": "url.parse_url_component", "args": { "url": "https://h:443/p", "component": 2 } },
    { "name": "component port absent", "op": "url.parse_url_component", "args": { "url": "https://h/p", "component": 2 } },
    { "name": "component user", "op": "url.parse_url_component", "args": { "url": "https://u:p@h", "component": 3 } },
    { "name": "component pass", "op": "url.parse_url_component", "args": { "url": "https://u:p@h", "component": 4 } },
    { "name": "component path", "op": "url.parse_url_component", "args": { "url": "/a/b?c", "component": 5 } },
    { "name": "component query", "op": "url.parse_url_component", "args": { "url": "/a?b=c#d", "component": 6 } },
    { "name": "component fragment", "op": "url.parse_url_component", "args": { "url": "/a#", "component": 7 } },
    { "name": "component on malformed url", "op": "url.parse_url_component", "args": { "url": "http://", "component": 1 } },
    { "name": "rfc3986 normalization", "op": "url.rfc3986_parse", "args": { "uri": "HTTP://User:P%41ss@EXAMPLE.com:0080/A/./b/../%7e%2f?Q%41#F%61" } },
    { "name": "rfc3986 ipv6 recomposes expanded", "op": "url.rfc3986_parse", "args": { "uri": "http://[::1]:80/a" } },
    { "name": "rfc3986 ipv4 in ipv6", "op": "url.rfc3986_parse", "args": { "uri": "http://[::FFFF:1.2.3.4]/" } },
    { "name": "rfc3986 ipvfuture lowercased", "op": "url.rfc3986_parse", "args": { "uri": "x://[v1.ABC]/" } },
    { "name": "rfc3986 empty", "op": "url.rfc3986_parse", "args": { "uri": "" } },
    { "name": "rfc3986 scheme only", "op": "url.rfc3986_parse", "args": { "uri": "a:" } },
    { "name": "rfc3986 empty authority", "op": "url.rfc3986_parse", "args": { "uri": "//" } },
    { "name": "rfc3986 empty host with port", "op": "url.rfc3986_parse", "args": { "uri": "//:80" } },
    { "name": "rfc3986 empty host with userinfo", "op": "url.rfc3986_parse", "args": { "uri": "//u@" } },
    { "name": "rfc3986 private-use scheme without host", "op": "url.rfc3986_parse", "args": { "uri": "com.example.app:/oauth" } },
    { "name": "rfc3986 relative dot segments kept", "op": "url.rfc3986_parse", "args": { "uri": "a/../.." } },
    { "name": "rfc3986 colon in first relative segment keeps dot", "op": "url.rfc3986_parse", "args": { "uri": "./a:b" } },
    { "name": "rfc3986 encoded dots are removed", "op": "url.rfc3986_parse", "args": { "uri": "http://h/a/%2E%2e/b" } },
    { "name": "rfc3986 host lowercasing stops near a trailing percent", "op": "url.rfc3986_parse", "args": { "uri": "http://AB%2C/" } },
    { "name": "rfc3986 double at is invalid", "op": "url.rfc3986_parse", "args": { "uri": "http://a@b@c" } },
    { "name": "rfc3986 port above PHP_INT_MAX", "op": "url.rfc3986_parse", "args": { "uri": "http://h:9223372036854775808" } },
    { "name": "rfc3986 port at PHP_INT_MAX", "op": "url.rfc3986_parse", "args": { "uri": "http://h:9223372036854775807" } },
    { "name": "rfc3986 space is invalid", "op": "url.rfc3986_parse", "args": { "uri": "http://h/a b" } },
    { "name": "rfc3986 colon in first relative segment is invalid", "op": "url.rfc3986_parse", "args": { "uri": "1a:b" } },
    { "name": "rfc3986 bad percent encoding", "op": "url.rfc3986_parse", "args": { "uri": "http://h/%zz" } },
    { "name": "rfc3986 bad ipv6", "op": "url.rfc3986_parse", "args": { "uri": "http://[1:::2]/" } }
  ]
}
