{
  "source": "php-std",
  "cases": [
    {
      "name": "basename of a file",
      "op": "path.basename",
      "args": {
        "path": "/srv/app/index.html"
      },
      "expect": "index.html"
    },
    {
      "name": "basename with trailing slashes",
      "op": "path.basename",
      "args": {
        "path": "/srv/app//"
      },
      "expect": "app"
    },
    {
      "name": "basename of slashes only",
      "op": "path.basename",
      "args": {
        "path": "///"
      },
      "expect": ""
    },
    {
      "name": "basename of an empty path",
      "op": "path.basename",
      "args": {
        "path": ""
      },
      "expect": ""
    },
    {
      "name": "basename keeps backslashes",
      "op": "path.basename",
      "args": {
        "path": "C:\\dir\\file.txt"
      },
      "expect": "C:\\dir\\file.txt"
    },
    {
      "name": "extension of a nested file",
      "op": "path.pathinfo_extension",
      "args": {
        "path": "server/pages/index.html"
      },
      "expect": "html"
    },
    {
      "name": "extension is after the last dot",
      "op": "path.pathinfo_extension",
      "args": {
        "path": "archive.tar.gz"
      },
      "expect": "gz"
    },
    {
      "name": "no extension",
      "op": "path.pathinfo_extension",
      "args": {
        "path": "Dockerfile"
      },
      "expect": ""
    },
    {
      "name": "dotfile",
      "op": "path.pathinfo_extension",
      "args": {
        "path": ".env"
      },
      "expect": "env"
    },
    {
      "name": "trailing dot",
      "op": "path.pathinfo_extension",
      "args": {
        "path": "name."
      },
      "expect": ""
    },
    {
      "name": "dot in a directory only",
      "op": "path.pathinfo_extension",
      "args": {
        "path": "v1.2/README"
      },
      "expect": ""
    },
    {
      "name": "trailing slash",
      "op": "path.pathinfo_extension",
      "args": {
        "path": "server/pages/"
      },
      "expect": ""
    },
    {
      "name": "dot directory with slash",
      "op": "path.pathinfo_extension",
      "args": {
        "path": ".next/"
      },
      "expect": "next"
    },
    {
      "name": "fnmatch: star crosses slashes",
      "op": "path.fnmatch",
      "args": {
        "pattern": "release/*",
        "filename": "release/v1/rc"
      },
      "expect": true
    },
    {
      "name": "fnmatch: question mark",
      "op": "path.fnmatch",
      "args": {
        "pattern": "v1.?",
        "filename": "v1.2"
      },
      "expect": true
    },
    {
      "name": "fnmatch: bracket range",
      "op": "path.fnmatch",
      "args": {
        "pattern": "v[0-9].*",
        "filename": "v3.1"
      },
      "expect": true
    },
    {
      "name": "fnmatch: negated bracket",
      "op": "path.fnmatch",
      "args": {
        "pattern": "v[!0-9]",
        "filename": "vx"
      },
      "expect": true
    },
    {
      "name": "fnmatch: escaped star",
      "op": "path.fnmatch",
      "args": {
        "pattern": "a\\*",
        "filename": "a*"
      },
      "expect": true
    },
    {
      "name": "fnmatch: unterminated bracket is literal",
      "op": "path.fnmatch",
      "args": {
        "pattern": "[ab",
        "filename": "[ab"
      },
      "expect": true
    },
    {
      "name": "fnmatch: a character class",
      "op": "path.fnmatch",
      "args": {
        "pattern": "[[:digit:]]*",
        "filename": "9lives"
      },
      "expect": true
    },
    {
      "name": "fnmatch: a UTF-8 character is one ?",
      "op": "path.fnmatch",
      "args": {
        "pattern": "caf?",
        "filename": "café"
      },
      "expect": true
    },
    {
      "name": "fnmatch: no match",
      "op": "path.fnmatch",
      "args": {
        "pattern": "0.1.*",
        "filename": "0.2.0"
      },
      "expect": false
    },
    {
      "name": "fnmatch: a NUL byte throws",
      "op": "path.fnmatch",
      "args": {
        "pattern": "a\u0000",
        "filename": "a"
      },
      "expect": {
        "$error": {
          "class": "ValueError",
          "message": "fnmatch(): Argument #1 ($pattern) must not contain any null bytes"
        }
      }
    }
  ]
}
