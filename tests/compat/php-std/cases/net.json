{
  "source": "php-std",
  "cases": [
    {
      "name": "ip2long dotted quad",
      "op": "net.ip2long",
      "args": {
        "ip": "192.168.1.1"
      },
      "expect": 3232235777
    },
    {
      "name": "ip2long all ones",
      "op": "net.ip2long",
      "args": {
        "ip": "255.255.255.255"
      },
      "expect": 4294967295
    },
    {
      "name": "ip2long zero",
      "op": "net.ip2long",
      "args": {
        "ip": "0.0.0.0"
      },
      "expect": 0
    },
    {
      "name": "ip2long leading zero is rejected",
      "op": "net.ip2long",
      "args": {
        "ip": "01.2.3.4"
      },
      "expect": false
    },
    {
      "name": "ip2long three parts",
      "op": "net.ip2long",
      "args": {
        "ip": "1.2.3"
      },
      "expect": false
    },
    {
      "name": "ip2long octet over 255",
      "op": "net.ip2long",
      "args": {
        "ip": "1.2.3.256"
      },
      "expect": false
    },
    {
      "name": "ip2long empty",
      "op": "net.ip2long",
      "args": {
        "ip": ""
      },
      "expect": false
    },
    {
      "name": "ip2long trailing space",
      "op": "net.ip2long",
      "args": {
        "ip": "1.2.3.4 "
      },
      "expect": false
    },
    {
      "name": "ip2long hex is not accepted",
      "op": "net.ip2long",
      "args": {
        "ip": "0x7f.0.0.1"
      },
      "expect": false
    },
    {
      "name": "ip2long NUL byte",
      "op": "net.ip2long",
      "args": {
        "ip": {
          "$bytes": "MS4yLjMuNAA="
        }
      },
      "expect": {
        "$error": {
          "class": "ValueError",
          "message": "ip2long(): Argument #1 ($ip) must not contain any null bytes"
        }
      }
    },
    {
      "name": "long2ip zero",
      "op": "net.long2ip",
      "args": {
        "ip": 0
      },
      "expect": "0.0.0.0"
    },
    {
      "name": "long2ip -1 wraps",
      "op": "net.long2ip",
      "args": {
        "ip": -1
      },
      "expect": "255.255.255.255"
    },
    {
      "name": "long2ip 2^32 keeps the low bits",
      "op": "net.long2ip",
      "args": {
        "ip": 4294967296
      },
      "expect": "0.0.0.0"
    },
    {
      "name": "long2ip private address",
      "op": "net.long2ip",
      "args": {
        "ip": 3232235777
      },
      "expect": "192.168.1.1"
    },
    {
      "name": "long2ip PHP_INT_MAX",
      "op": "net.long2ip",
      "args": {
        "ip": 9223372036854775807
      },
      "expect": "255.255.255.255"
    },
    {
      "name": "long2ip PHP_INT_MIN",
      "op": "net.long2ip",
      "args": {
        "ip": -9223372036854775808
      },
      "expect": "0.0.0.0"
    },
    {
      "name": "inet_pton IPv4",
      "op": "net.inet_pton",
      "args": {
        "ip": "127.0.0.1"
      },
      "expect": "\u0000\u0000\u0001"
    },
    {
      "name": "inet_pton loopback IPv6",
      "op": "net.inet_pton",
      "args": {
        "ip": "::1"
      },
      "expect": "\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001"
    },
    {
      "name": "inet_pton IPv4-mapped",
      "op": "net.inet_pton",
      "args": {
        "ip": "::ffff:192.0.2.1"
      },
      "expect": {
        "$bytes": "AAAAAAAAAAAAAP//wAACAQ=="
      }
    },
    {
      "name": "inet_pton full IPv6",
      "op": "net.inet_pton",
      "args": {
        "ip": "2001:db8:85a3:0:0:8a2e:370:7334"
      },
      "expect": {
        "$bytes": "IAENuIWjAAAAAIouA3BzNA=="
      }
    },
    {
      "name": "inet_pton two double colons",
      "op": "net.inet_pton",
      "args": {
        "ip": "1::2::3"
      },
      "expect": false
    },
    {
      "name": "inet_pton nine groups",
      "op": "net.inet_pton",
      "args": {
        "ip": "1:2:3:4:5:6:7:8:9"
      },
      "expect": false
    },
    {
      "name": "inet_pton zone index",
      "op": "net.inet_pton",
      "args": {
        "ip": "fe80::1%eth0"
      },
      "expect": false
    },
    {
      "name": "inet_pton neither dot nor colon",
      "op": "net.inet_pton",
      "args": {
        "ip": "localhost"
      },
      "expect": false
    },
    {
      "name": "inet_pton empty",
      "op": "net.inet_pton",
      "args": {
        "ip": ""
      },
      "expect": false
    },
    {
      "name": "inet_pton NUL byte",
      "op": "net.inet_pton",
      "args": {
        "ip": {
          "$bytes": "OjoxAA=="
        }
      },
      "expect": {
        "$error": {
          "class": "ValueError",
          "message": "inet_pton(): Argument #1 ($ip) must not contain any null bytes"
        }
      }
    },
    {
      "name": "inet_ntop IPv4",
      "op": "net.inet_ntop",
      "args": {
        "packed": {
          "$bytes": "fwAAAQ=="
        }
      },
      "expect": "127.0.0.1"
    },
    {
      "name": "inet_ntop loopback IPv6",
      "op": "net.inet_ntop",
      "args": {
        "packed": {
          "$bytes": "AAAAAAAAAAAAAAAAAAAAAQ=="
        }
      },
      "expect": "::1"
    },
    {
      "name": "inet_ntop all zeros",
      "op": "net.inet_ntop",
      "args": {
        "packed": {
          "$bytes": "AAAAAAAAAAAAAAAAAAAAAA=="
        }
      },
      "expect": "::"
    },
    {
      "name": "inet_ntop IPv4-mapped",
      "op": "net.inet_ntop",
      "args": {
        "packed": {
          "$bytes": "AAAAAAAAAAAAAP//AQIDBA=="
        }
      },
      "expect": "::ffff:1.2.3.4"
    },
    {
      "name": "inet_ntop two zero runs: the first wins",
      "op": "net.inet_ntop",
      "args": {
        "packed": {
          "$bytes": "AAAAAAABAAAAAAABAAAAAA=="
        }
      },
      "expect": "::1:0:0:1:0:0"
    },
    {
      "name": "inet_ntop longer second zero run",
      "op": "net.inet_ntop",
      "args": {
        "packed": {
          "$bytes": "AAEAAAACAAAAAAAAAAMABA=="
        }
      },
      "expect": "1:0:2::3:4"
    },
    {
      "name": "inet_ntop single zero group is not compressed",
      "op": "net.inet_ntop",
      "args": {
        "packed": {
          "$bytes": "AAEAAAACAAMABAAFAAYABw=="
        }
      },
      "expect": "1:0:2:3:4:5:6:7"
    },
    {
      "name": "inet_ntop wrong length",
      "op": "net.inet_ntop",
      "args": {
        "packed": {
          "$bytes": "AAAAAAA="
        }
      },
      "expect": false
    },
    {
      "name": "inet_ntop empty",
      "op": "net.inet_ntop",
      "args": {
        "packed": ""
      },
      "expect": false
    },
    {
      "name": "idn_to_ascii umlaut",
      "op": "net.idn_to_ascii",
      "args": {
        "domain": "bücher.de"
      },
      "expect": {
        "result": "xn--bcher-kva.de",
        "info": {
          "result": "xn--bcher-kva.de",
          "isTransitionalDifferent": false,
          "errors": 0
        }
      }
    },
    {
      "name": "idn_to_ascii uppercase is mapped",
      "op": "net.idn_to_ascii",
      "args": {
        "domain": "Bücher.DE"
      },
      "expect": {
        "result": "xn--bcher-kva.de",
        "info": {
          "result": "xn--bcher-kva.de",
          "isTransitionalDifferent": false,
          "errors": 0
        }
      }
    },
    {
      "name": "idn_to_ascii default flags are nontransitional",
      "op": "net.idn_to_ascii",
      "args": {
        "domain": "faß.de"
      },
      "expect": {
        "result": "xn--fa-hia.de",
        "info": {
          "result": "xn--fa-hia.de",
          "isTransitionalDifferent": true,
          "errors": 0
        }
      }
    },
    {
      "name": "idn_to_ascii transitional maps sharp s",
