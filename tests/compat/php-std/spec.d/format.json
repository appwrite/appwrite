  "quirks": [
    {
      "symbol": "sprintf() %e %f %g of NAN and INF",
      "description": "the width is ignored, and with '+' and '0' padding PHP writes the sign and drops the first character: '%+05f' of NAN is '+aN', of INF '+NF'",
      "case": "format.json#sprintf NaN and INF with sign and zero padding (quirk)"
    },
    {
      "symbol": "round() with |precision| > 22",
      "description": "PHP uses C pow(10, n); the PHP image links musl, whose pow is one ULP high for n = 23, 126 and 210, which changes results such as round(4.5e-23, 23) = 5.0E-23",
      "case": "format.json#round with musl pow(10, 23) (quirk)"
    },
    {
      "symbol": "(int) / intval() of strings",
      "description": "for 19 digits followed by 'e+' or 'e-' without exponent digits, PHP compares the digits one position late against PHP_INT_MIN's and returns the wrapped integer: (int) '9223372036854775808e+' is PHP_INT_MIN",
      "case": "format.json#intval 19 digits and an empty signed exponent (quirk)"
