  "generators": {},
  "deviations": [
    {
      "symbol": "SORT_LOCALE_STRING",
      "php": "Compares with strcoll() under the current LC_COLLATE.",
      "reason": "SortFlags::Locale compares the bytes up to the first NUL, which is strcoll() in the C locale; Appwrite never calls setlocale()."
    }
  ],
  "quirks": [
    {
      "symbol": "sort",
      "description": "PHP 8 comparisons are not transitive across types (null == 0 and null == \"\", but 0 > \"\"), so the order of mixed arrays depends on zend_sort's exact comparison sequence; php_std::sort::zend_sort reproduces it.",
      "case": "sort.json#sort: non-transitive values, quicksort path"
    }
  ]
