  "deviations": [
    {
      "symbol": "mb_* $encoding",
      "php": "every mbstring encoding",
      "reason": "php_std::mb works on UTF-8 (PHP's default internal encoding, the only one the libraries use); mb_strlen also takes Encoding::EightBit"
    },
    {
      "symbol": "mb_check_encoding() / mb_convert_encoding() of arrays",
      "php": "arrays are checked or converted recursively (keys and string values)",
      "reason": "php_std::mb takes strings; callers walk their arrays (JSON-decoded strings are always valid UTF-8)"
    },
    {
      "symbol": "mb_strpos() positive $offset",
      "php": "PHP 8.5.10's offset walk can step past the end of a haystack ending in a truncated UTF-8 sequence and then reads out of bounds (undefined behaviour, later fixed by clamping)",
      "reason": "not reproducible; Rust clamps to the end like later PHP releases. The fuzz profiles end invalid haystacks with ASCII so the walk stays in bounds"
    }
  ],
  "quirks": [
    {
      "symbol": "mb_strtolower() final sigma",
      "description": "the look-behind for a cased letter before a capital sigma stops at PHP's 64-codepoint conversion chunks (it only rescans what is left of the previous chunk's output), so a long run of case-ignorable characters hides the cased letter and the sigma is not final",
      "case": "mb.json#strtolower sigma look-behind across PHP's 64-codepoint chunks"
    }
  ]
}
