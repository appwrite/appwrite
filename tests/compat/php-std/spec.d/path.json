{
  "ops": {
    "path.basename": {
      "doc": "basename($path)",
      "covers": [
        "basename()"
      ],
      "fuzz": [
        {
          "name": "paths",
          "args": {
            "gen": "object",
            "fields": {
              "path": {
                "gen": "ref",
                "name": "path_path"
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "path.pathinfo_extension": {
      "doc": "pathinfo($path, PATHINFO_EXTENSION)",
      "covers": [
        "pathinfo()"
      ],
      "fuzz": [
        {
          "name": "paths",
          "args": {
            "gen": "object",
            "fields": {
              "path": {
                "gen": "ref",
                "name": "path_path"
              }
            }
          },
          "iterations": 3000
        }
      ]
    },
    "path.fnmatch": {
      "doc": "fnmatch($pattern, $filename) without flags, as the dev image's musl libc matches it (C.UTF-8: one character per UTF-8 sequence)",
      "covers": [
        "fnmatch()"
      ],
      "fuzz": [
        {
          "name": "globs",
          "args": {
            "gen": "object",
            "fields": {
              "pattern": {
                "gen": "ref",
                "name": "glob_pattern"
              },
              "filename": {
                "gen": "ref",
                "name": "glob_name"
              }
            }
          },
          "iterations": 4000
        },
        {
          "name": "bytes",
          "args": {
            "gen": "object",
            "fields": {
              "pattern": {
                "gen": "string",
                "alphabet": "unicode",
                "min": 0,
                "max": 10,
                "tricky": 0.3
              },
              "filename": {
                "gen": "string",
                "alphabet": "unicode",
                "min": 0,
                "max": 10,
                "tricky": 0.3
              }
            }
          },
          "iterations": 2000
        },
        {
          "name": "raw",
          "args": {
            "gen": "object",
            "fields": {
              "pattern": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "bytes",
                    "min": 0,
                    "max": 6
                  },
                  {
                    "gen": "ref",
                    "name": "glob_pattern"
                  }
                ]
              },
              "filename": {
                "gen": "one_of",
                "of": [
                  {
                    "gen": "bytes",
                    "min": 0,
                    "max": 6
                  },
                  {
                    "gen": "ref",
                    "name": "glob_name"
                  }
                ]
              }
            }
          },
          "iterations": 3000
        }
      ]
    }
  },
  "generators": {
    "path_path": {
      "gen": "one_of",
      "of": [
        {
          "gen": "string",
          "min": 0,
          "max": 24,
          "alphabet": "ab./ \\:-_",
          "tricky": 0.2
        },
        {
          "gen": "repeat",
          "part": {
            "gen": "pick",
            "from": [
              "",
              ".",
              "..",
              "a",
              "a.b",
              ".env",
              "index.html",
              "x.tar.gz",
              "dir/",
              "/"
            ]
          },
          "min": 1,
          "max": 5,
          "sep": "/"
        },
        {
          "gen": "bytes",
          "min": 0,
          "max": 12
        }
      ]
    },
    "glob_pattern": {
      "gen": "one_of",
      "of": [
        {
          "gen": "string",
          "alphabet": "ab*?[]!^-\\/.",
          "min": 0,
          "max": 12,
          "tricky": 0.1
        },
        {
          "gen": "repeat",
          "part": {
            "gen": "pick",
            "from": [
              "*",
              "?",
              "a",
              "b",
              "[ab]",
              "[!a]",
              "[^b]",
              "[a-c]",
              "[]a]",
              "[",
              "]",
              "\\*",
              "\\",
              "é",
              "[é]",
              "[[:alpha:]]",
              "[[:digit:]]",
              "[[:x:]]",
              "/",
              ".",
              "v1."
            ]
          },
          "min": 0,
          "max": 6
        }
      ]
    },
    "glob_name": {
      "gen": "one_of",
      "of": [
        {
          "gen": "string",
          "alphabet": "ab*?[]!^-\\/.1",
          "min": 0,
          "max": 12,
          "tricky": 0.1
        },
        {
          "gen": "repeat",
          "part": {
            "gen": "pick",
            "from": [
              "a",
              "b",
              "c",
              "1",
              ".",
              "/",
              "é",
              "*",
              "[",
              "]",
              "\\",
              "v1.2",
              "release/"
            ]
          },
          "min": 0,
          "max": 6
        }
      ]
    }
  }
}
