  "deviations": [
    {
      "symbol": "filter_var()",
      "php": "\"uri_parser_class\" => Uri\\WhatWg\\Url (FILTER_VALIDATE_URL with the WHATWG URL parser)",
      "reason": "Not ported: php_std::filter::filter_var() returns an Unsupported error for it"
    },
    {
      "symbol": "filter_var()",
      "php": "FILTER_SANITIZE_FULL_SPECIAL_CHARS encodes for the charset of the default_charset (or internal_encoding) ini setting",
      "reason": "php_std fixes it at PHP's default, UTF-8; the other charsets of htmlentities() are not ported"
    },
    {
      "symbol": "filter_var()",
      "php": "FILTER_CALLBACK calls any PHP callable",
      "reason": "php_std::filter::filter_var_with() takes a Callables implementation that stands for the callables; the compat adapter provides only the recording closure '$callback' of ops/filter.php"
    }
  ],
  "quirks": [
    {
      "symbol": "filter_var()",
      "description": "FILTER_VALIDATE_FLOAT with FILTER_FLAG_ALLOW_THOUSAND treats a NUL byte as a thousand separator: strchr() finds the terminator of the separator list",
      "case": "filter.json#float NUL is a thousand separator"
    },
    {
      "symbol": "filter_var()",
      "description": "A float min_range that does not fit an int is cast with a warning, and the cast value is the range",
      "case": "filter.json#int min_range from a float option"
    },
    {
      "symbol": "filter_var()",
      "description": "An unregistered filter ID inside the filter ranges (0x0100-0x0115, 0x0200-0x020b) runs FILTER_DEFAULT; any other unknown ID warns and returns false",
      "case": "filter.json#unregistered filter ID in range runs FILTER_DEFAULT"
    },
    {
      "symbol": "filter_var()",
      "description": "FILTER_CALLBACK with an \"options\" entry resets the flags to 0, so an array value is filtered element by element without FILTER_REQUIRE_ARRAY",
      "case": "filter.json#callback filters each element of an array"
    },
    {
      "symbol": "filter_var()",
      "description": "Filtering an array goes on after an element throws; the exception reported is the last one thrown, while failed validations stop throwing",
      "case": "filter.json#array exceptions: the last thrown wins"
    },
    {
      "symbol": "filter_var()",
      "description": "FILTER_SANITIZE_FULL_SPECIAL_CHARS returns an empty string for invalid UTF-8",
      "case": "filter.json#full_special_chars invalid UTF-8 gives an empty string"
    },
    {
      "symbol": "filter_var()",
      "description": "FILTER_SANITIZE_FULL_SPECIAL_CHARS keeps &#x0x1F; as an entity: strtol() skips a 0x prefix after the x",
      "case": "filter.json#full_special_chars keeps a hex entity with a 0x prefix"
    },
    {
      "symbol": "filter_var()",
      "description": "FILTER_SANITIZE_STRING encodes quotes before stripping tags, so a quoted > ends a tag",
      "case": "filter.json#string a quoted > ends the tag"
    }
  ]
}
