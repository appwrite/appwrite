  "quirks": [],
  "deviations": [
    {
      "symbol": "===",
      "php": "Objects are identical only to the same instance: $o === $o is true, two separately created stdClass objects with the same properties are not.",
      "reason": "php_std::Value has no identity (values, not handles). Value::strict_eq treats object values as distinct instances, which is what decoding produces (every decoded object is a new instance); in_array/array_search strict follow it."
    },
    {
      "symbol": "nNextFreeElement",
      "php": "A packed array that appends an integer key sets the next free index to one past it, which lowers it after trailing elements were unset; whether an array is packed, and its table size, depends on how it was built.",
      "reason": "php_std::Array tracks the engine's packed state (nNumUsed, nTableSize) for arrays built by assignment and pushes, and assumes the table size max(8, 2^k >= n) an array of n elements is created with (array_init_size, json_decode, unserialize, literals). An array PHP built differently (array_map over a hash, which is how Utopia\\Http\\Request decodes {\"0\": .., \"1\": ..}) is a hash in PHP and packed here; the difference only shows through $a[] after trailing elements were unset and a key was assigned beyond them."
    },
    {
      "symbol": "Value::to_json",
      "php": "json_encode fails (or substitutes) on invalid UTF-8 and non-finite floats.",
      "reason": "Value::to_json is a lossy convenience (invalid UTF-8 becomes U+FFFD per the maximal-subpart rule, non-finite floats null); json::encode is the exact json_encode. types.to_json is fuzzed with UTF-8 strings and finite floats only."
    }
  ]
