parameters:
  level: 4
  tmpDir: .phpstan-cache
  paths:
    - src
    - app
    - bin
    - tests
  bootstrapFiles:
    - app/init/constants.php
  scanDirectories:
    - vendor/swoole/ide-helper
  scanFiles:
    # Classes the compat database recorder generates with eval()
    - tests/compat/database/recorder/Classes.stub
  excludePaths:
    - tests/resources
  ignoreErrors:
    # The E2E harness talks to the stack under test, not to a destination a user chose
    -
      identifier: function.disallowedCurl
      path: tests/*
services:
  -
    class: Utopia\Client\PHPStan\DisallowRawCurlExtension
    tags:
      - phpstan.restrictedFunctionUsageExtension
