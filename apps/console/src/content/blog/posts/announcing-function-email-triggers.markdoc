```rust
use appwrite::services::tables_db::TablesDB;
use appwrite::Client;
use openruntimes::{Context, Response};
use serde_json::{json, Value};
use std::env;

pub fn main(mut context: Context) -> Response {
    if context.req.headers.get("x-appwrite-trigger").map(String::as_str) != Some("email") {
        return context.res.text("Not an email", Some(400), None);
    }

    let email: Value = context.req.body_json().unwrap_or(Value::Null);
    let email_id = email["id"].as_str().unwrap_or_default().to_string();

    let client = Client::new()
        .set_endpoint(env::var("APPWRITE_FUNCTION_API_ENDPOINT").unwrap_or_default())
        .set_project(env::var("APPWRITE_FUNCTION_PROJECT_ID").unwrap_or_default())
        .set_key(
            context
                .req
                .headers
                .get("x-appwrite-key")
                .cloned()
                .unwrap_or_default(),
        );

    let tables_db = TablesDB::new(&client);

    let runtime = tokio::runtime::Builder::new_current_thread()
        .enable_all()
        .build()
        .unwrap();

    let row_id = email_id.clone();
    let result = runtime.block_on(async move {
        tables_db
            .create_row(
                "<DATABASE_ID>",
                "<TABLE_ID>",
                &row_id,
                json!({
                    "from": email["from"],
                    "subject": email["subject"],
                    "text": email["text"]
                }),
                None,
                None,
            )
            .await
    });

    match result {
        Ok(_) => {
            context.log(format!("Saved email {}", email_id));
            context.res.empty()
        }
        Err(e) if e.status_code() == 409 => {
            context.log(format!("Email {} is already saved", email_id));
            context.res.empty()
        }
        Err(e) => {
            context.error(format!("Failed to save email: {}", e));
            context.res.text("Failed to save email", Some(500), None)
        }
    }
}
```
{% /multicode %}

# Duplicate emails and attachments

Plan for two behaviors when you write an email function:

- **Duplicates are possible.** The same email can reach your function more than one time. A second execution for the same delivery has the same `id`, but an email that the sender sends again has a new `id`, so check both `id` and `messageId` to skip duplicates.
- **Download URLs expire.** The attachment URLs and the URL of the original email expire 15 minutes after Appwrite creates them, and only your function's runtime can reach them. Download the files at the start of the function, and upload them to [Storage](/docs/products/storage) if you need them later.

Appwrite accepts an email before your function executes. A failed execution does not send a bounce message to the sender, so check the execution logs of the function for errors. If the function cannot start, for example because the project reached a plan limit, no execution appears and Appwrite does not try again.

# Use cases

- **Support inbox.** Save each email to a table, and reply to the customer with [Messaging](/docs/products/messaging).
- **Invoice processing.** Read PDF attachments from vendors and store the extracted totals.
- **Alerts from other services.** Parse the alerts that monitoring services send by email and open an incident.
- **Reply by email.** Give each conversation its own address, such as `ticket-1042+<FUNCTION_ID>@<PROJECT_ID>.appwrite.email` or `ticket-1042@mail.example.com` on a custom domain, and read the address from `envelope.to` to find the conversation.

# Get started

Email triggers are available for Appwrite Functions on Appwrite Cloud. The [email triggers documentation](/docs/products/functions/email) has the full request format, the DNS setup for custom domains, and the limits.

