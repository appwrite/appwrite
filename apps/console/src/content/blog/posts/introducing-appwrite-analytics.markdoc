```server-go
package main

import (
    "fmt"
    "log"

    "github.com/appwrite/sdk-for-go/v7/appwrite"
)

func main() {
    client := appwrite.NewClient(
        appwrite.WithEndpoint("https://<REGION>.cloud.appwrite.io/v1"),
        appwrite.WithProject("<PROJECT_ID>"),
        appwrite.WithKey("<API_KEY>"),
    )

    analytics := appwrite.NewAnalytics(client)

    countries, err := analytics.ListMetrics(
        "<PROPERTY_ID>",
        analytics.WithListMetricsDimensions([]string{"country"}),
        analytics.WithListMetricsDateRange("7d"),
        analytics.WithListMetricsLimit(5),
    )
    if err != nil {
        log.Fatal(err)
    }

    for _, row := range countries.Metrics {
        fmt.Println(*row.Value, row.Visitors)
    }
}
```
```server-rust
use appwrite::Client;
use appwrite::enums::AnalyticsDimension;
use appwrite::services::Analytics;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1");
    client.set_project("<PROJECT_ID>");
    client.set_key("<API_KEY>");

    let analytics = Analytics::new(&client);

    let countries = analytics.list_metrics(
        "<PROPERTY_ID>",
        None, // queries
        None, // interval
        Some(vec![AnalyticsDimension::Country]),
        Some("7d"),
        None, // start_at
        None, // end_at
        Some(5),
        None, // total
    ).await?;

    for row in countries.metrics {
        println!("{} {}", row.value.unwrap_or_default(), row.visitors);
    }

    Ok(())
}
```
```bash
appwrite client \
    --endpoint https://<REGION>.cloud.appwrite.io/v1 \
    --project-id '<PROJECT_ID>' \
    --key '<API_KEY>'

appwrite analytics list-metrics \
    --property-id '<PROPERTY_ID>' \
    --dimensions country \
    --date-range 7d \
    --limit 5
```
```curl
curl -G 'https://<REGION>.cloud.appwrite.io/v1/analytics/properties/<PROPERTY_ID>/metrics' \
    -H 'X-Appwrite-Project: <PROJECT_ID>' \
    -H 'X-Appwrite-Key: <API_KEY>' \
    --data-urlencode 'dimensions[]=country' \
    --data-urlencode 'dateRange=7d' \
    --data-urlencode 'limit=5'
```
