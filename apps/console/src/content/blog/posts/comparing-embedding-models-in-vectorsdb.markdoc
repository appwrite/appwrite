```server-rust
use appwrite::Client;
use appwrite::services::Embeddings;
use appwrite::enums::EmbeddingModel;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1"); // Your API Endpoint
    client.set_project("<YOUR_PROJECT_ID>"); // Your project ID
    client.set_key("<YOUR_API_KEY>"); // Your secret API key

    let embeddings = Embeddings::new(&client);

    let result = embeddings.create_text_embeddings(
        vec!["Appwrite Functions run your code in response to events"],
        Some(EmbeddingModel::EmbeddingGemma), // store these in a collection with dimension 768
    ).await?;

    println!("{:?}", result);
    Ok(())
}
```
```bash
appwrite embeddings create-text-embeddings \
    --texts 'Appwrite Functions run your code in response to events' \
    --model 'embedding-gemma'
```
{% /multicode %}

The response holds one entry per input text, in the order you passed them, and each entry reports the `model` and `dimension` it came from.

```json
{
    "total": 1,
    "embeddings": [
        {
            "model": "embedding-gemma",
            "dimension": 768,
            "embedding": [-0.012246467, 0.02621112, -0.15247375, ...],
            "error": ""
        }
    ]
}
```

Use the same model for the documents you store and for the queries you search with.

Pick a model, create a collection with the matching dimension, and generate your first embeddings from the Console or an SDK.

