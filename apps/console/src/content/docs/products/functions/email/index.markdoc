```rust
use appwrite::services::tables_db::TablesDB;
use appwrite::Client;
use openruntimes::{Context, Response};
use serde_json::{json, Value};
use std::env;

pub fn main(mut context: Context) -> Response {
    if context.req.headers.get("x-appwrite-trigger").map(String::as_str) != Some("email") {
        return context.res.text("Not an email", Some(400), None);
    }

    let email: Value = context.req.body_json().unwrap_or(Value::Null);
    let email_id = email["id"].as_str().unwrap_or_default().to_string();

    let client = Client::new()
        .set_endpoint(env::var("APPWRITE_FUNCTION_API_ENDPOINT").unwrap_or_default())
        .set_project(env::var("APPWRITE_FUNCTION_PROJECT_ID").unwrap_or_default())
        .set_key(
            context
                .req
                .headers
                .get("x-appwrite-key")
                .cloned()
                .unwrap_or_default(),
        );

    let tables_db = TablesDB::new(&client);

    let runtime = tokio::runtime::Builder::new_current_thread()
        .enable_all()
        .build()
        .unwrap();

    let row_id = email_id.clone();
    let result = runtime.block_on(async move {
        tables_db
            .create_row(
                "<DATABASE_ID>",
                "<TABLE_ID>",
                &row_id,
                json!({
                    "from": email["from"],
                    "subject": email["subject"],
                    "text": email["text"]
                }),
                None,
                None,
            )
            .await
    });

    match result {
        Ok(_) => {
            context.log(format!("Saved email {}", email_id));
            context.res.empty()
        }
        Err(e) if e.status_code() == 409 => {
            context.log(format!("Email {} is already saved", email_id));
            context.res.empty()
        }
        Err(e) => {
            context.error(format!("Failed to save email: {}", e));
            context.res.text("Failed to save email", Some(500), None)
        }
    }
}
```
{% /multicode %}

# Request body {% #request-body %}

The request body of an email execution has this format:

```json
{
  "id": "5f0c2a9e3b7d4e1f8a6c0b2d4e6f8a1c",
  "envelope": {
    "from": "walter@example.net",
    "to": ["support+6a51290fe3d0727e293a@6a5128c4001f2d3e8a7b.appwrite.email"]
  },
  "from": "Walter O'Brien <walter@example.net>",
  "to": "support+6a51290fe3d0727e293a@6a5128c4001f2d3e8a7b.appwrite.email",
  "cc": "",
  "replyTo": "",
  "subject": "Order 1042 did not arrive",
  "messageId": "<CAF3x9k2@mail.example.net>",
  "date": "Wed, 23 Sep 2026 09:14:02 +0000",
  "text": "Hi, my order 1042 did not arrive yet.",
  "html": "<p>Hi, my order 1042 did not arrive yet.</p>",
  "headers": {
    "message-id": ["<CAF3x9k2@mail.example.net>"],
    "date": ["Wed, 23 Sep 2026 09:14:02 +0000"],
    "from": ["Walter O'Brien <walter@example.net>"],
    "to": ["support+6a51290fe3d0727e293a@6a5128c4001f2d3e8a7b.appwrite.email"],
    "subject": ["Order 1042 did not arrive"]
  },
  "attachments": [
    {
      "id": "attachment-0",
      "name": "receipt.pdf",
      "contentType": "application/pdf",
      "contentId": "",
      "disposition": "attachment",
      "size": 48213,
      "url": "http://edge.edge.svc.cluster.local/v1/smtp/deliveries/5f0c2a9e3b7d4e1f8a6c0b2d4e6f8a1c/files/attachment-0?token=<TOKEN>"
    }
  ],
  "raw": {
    "size": 67402,
    "contentType": "message/rfc822",
    "url": "http://edge.edge.svc.cluster.local/v1/smtp/deliveries/5f0c2a9e3b7d4e1f8a6c0b2d4e6f8a1c/files/raw?token=<TOKEN>"
  },
  "transport": {
    "remoteIp": "203.0.113.10",
    "helo": "mail.example.net",
    "tls": false
  },
  "receivedAt": "2026-09-23T09:14:03.482913571Z"
}
```

- `id`: the ID of the email delivery. It is the same value as the `x-appwrite-email-id` header.
- `envelope.from`: the sender address that the sending mail server reported. It is empty for bounce messages and other automatic replies.
- `envelope.to`: the addresses of your function that received the email.
- `from`, `to`, `cc`, and `replyTo`: the values of these headers in the email.
- `subject`, `messageId`, and `date`: the values of these headers in the email.
- `text` and `html`: the plain text and HTML versions of the email body. A value is empty when the email does not have that version.
- `headers`: these email headers, when the email has them: `message-id`, `date`, `from`, `to`, `cc`, `reply-to`, `subject`, `in-reply-to`, and `references`. The keys are lowercase, and each value is a list of the raw header values. A header that the email does not have is not in the object.
- `attachments`: the attached files and the inline parts of the email, such as embedded images. An inline part has a `contentId`. Each attachment has a download `url`.
- `raw`: the original email as an `.eml` file, with a download `url`.
- `transport`: details of the SMTP connection: the IP address that connected, the name that the sending server gave in its `HELO` greeting, and whether the connection used TLS.
- `receivedAt`: the time when Appwrite received the email, as an RFC 3339 timestamp in UTC that can include fractions of a second.

The values of `envelope.to` and `to` can be different.
For example, an email that you receive as a BCC recipient or as a forwarded email shows your address only in `envelope.to`.

# Attachments and the original email {% #attachments %}

Each attachment has a `url` that downloads the file. The `raw.url` value downloads the original email as an `.eml` file.
Request these URLs from your function as they are. They point to an internal Appwrite address that only your function's runtime can reach.

The URLs expire **15 minutes** after Appwrite creates them, right before the execution starts.
Download the files at the start of your function.
To keep a file for a longer time, upload it to [Storage](/docs/products/storage).

# Duplicate emails {% #duplicate-emails %}

Your function can receive the same email more than one time.

If Appwrite executes the function again for the same delivery, for example after an internal failure, both executions have the same `id`.
The [example function](#handle-an-email) uses the `id` as the row ID, so Appwrite rejects a second row for the same delivery with a `409` error.

If the sending mail server sends the email again, for example because its connection closed before Appwrite confirmed the email, Appwrite treats it as a new delivery with a new `id`.
To detect these duplicates too, also compare the `messageId` value when the email has one.

# Limits {% #limits %}

- Maximum size of an email, including attachments: 25 MB.
- Maximum size of the email body after decoding: 8 MB.
- Maximum number of recipients for each email: 50.
- Maximum number of MIME parts for each email: 200, nested at most 5 levels deep.
- Addresses with non-ASCII characters are not supported.
- Duration of an email execution: plan for the function to finish within 60 seconds. Appwrite can stop an email execution after 60 seconds, even when the timeout of your function is longer.
