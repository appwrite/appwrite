```rust
use appwrite::services::tables_db::TablesDB;
use appwrite::Client;
use openruntimes::{Context, Response};
use serde_json::{json, Value};
use std::env;

pub fn main(context: Context) -> Response {
    if context.req.headers.get("x-appwrite-trigger").map(String::as_str) != Some("email") {
        return context.res.text("Not an email", Some(400), None);
    }

    let email: Value = context.req.body_json().unwrap_or(Value::Null);
    let email_id = email["id"].as_str().unwrap_or_default().to_string();

    let client = Client::new()
        .set_endpoint(env::var("APPWRITE_FUNCTION_API_ENDPOINT").unwrap_or_default())
        .set_project(env::var("APPWRITE_FUNCTION_PROJECT_ID").unwrap_or_default())
        .set_key(
            context
                .req
                .headers
                .get("x-appwrite-key")
                .cloned()
                .unwrap_or_default(),
        );

    let tables_db = TablesDB::new(&client);

    let runtime = tokio::runtime::Builder::new_current_thread()
        .enable_all()
        .build()
        .unwrap();

    let row_id = email_id.clone();
    let result = runtime.block_on(async move {
        tables_db
            .create_row(
                "<DATABASE_ID>",
                "<TABLE_ID>",
                &row_id,
                json!({
                    "from": email["from"],
                    "subject": email["subject"],
                    "text": email["text"]
                }),
                None,
                None,
            )
            .await
    });

    match result {
        Ok(_) => {
            context.log(format!("Saved email {}", email_id));
            context.res.empty()
        }
        Err(e) if e.status_code() == 409 => {
            context.log(format!("Email {} is already saved", email_id));
            context.res.empty()
        }
        Err(e) => {
            context.error(format!("Failed to save email: {}", e));
            context.res.text("Failed to save email", Some(500), None)
        }
    }
}
```
{% /multicode %}

# Request body {% #request-body %}

The request body of an email execution has this format:

```json
{
  "id": "5f0c2a9e3b7d4e1f8a6c0b2d4e6f8a1c",
  "envelope": {
    "from": "walter@example.net",
    "to": ["support@6a51290fe3d0727e293a.appwrite.email"]
  },
  "from": "Walter O'Brien <walter@example.net>",
  "to": "support@6a51290fe3d0727e293a.appwrite.email",
  "cc": "",
  "replyTo": "",
  "subject": "Order 1042 did not arrive",
  "messageId": "<CAF3x9k2@mail.example.net>",
  "date": "Wed, 23 Sep 2026 09:14:02 +0000",
  "text": "Hi, my order 1042 did not arrive yet.",
  "html": "<p>Hi, my order 1042 did not arrive yet.</p>",
  "headers": {
    "subject": ["Order 1042 did not arrive"],
    "in-reply-to": [],
    "references": []
  },
  "attachments": [
    {
      "id": "attachment-0",
      "name": "receipt.pdf",
      "contentType": "application/pdf",
      "contentId": "",
      "disposition": "attachment",
      "size": 48213,
      "url": "https://<REGION>.cloud.appwrite.io/v1/smtp/deliveries/5f0c2a9e3b7d4e1f8a6c0b2d4e6f8a1c/files/attachment-0?token=<TOKEN>"
    }
  ],
  "raw": {
    "size": 67402,
    "contentType": "message/rfc822",
    "url": "https://<REGION>.cloud.appwrite.io/v1/smtp/deliveries/5f0c2a9e3b7d4e1f8a6c0b2d4e6f8a1c/files/raw?token=<TOKEN>"
  },
  "transport": {
    "remoteIp": "203.0.113.10",
    "helo": "mail.example.net",
    "tls": true
  },
  "receivedAt": "2026-09-23T09:14:03Z"
}
```

{% info title="SMTP-DOCS-TODO: Verify download URL host" %}
**SMTP-DOCS-TODO verify:download-url-host.** The `url` host in this example is a guess. Replace it with the host that Appwrite Cloud returns, then remove this block.
{% /info %}

- `id`: the unique ID of the email. It is the same value as the `x-appwrite-email-id` header.
- `envelope.from`: the sender address that the sending mail server reported.
- `envelope.to`: the addresses of your function that received the email.
- `from`, `to`, `cc`, and `replyTo`: the values of these headers in the email.
- `subject`, `messageId`, and `date`: the values of these headers in the email.
- `text` and `html`: the plain text and HTML versions of the email body. A value is empty when the email does not have that version.
- `headers`: a selection of email headers. The keys are lowercase, and each value is a list: `message-id`, `date`, `from`, `to`, `cc`, `reply-to`, `subject`, `in-reply-to`, and `references`.
- `attachments`: the files that are attached to the email. Each attachment has a download `url`.
- `raw`: the original email as an `.eml` file, with a download `url`.
- `transport`: the IP address of the sending mail server, the name that it gave, and whether the connection used TLS.
- `receivedAt`: the time when Appwrite received the email.

The values of `envelope.to` and `to` can be different.
For example, an email that you receive as a BCC recipient or as a forwarded email shows your address only in `envelope.to`.

# Attachments and the original email {% #attachments %}

Each attachment has a `url` that downloads the file. The `raw.url` value downloads the original email as an `.eml` file.

These URLs expire **5 minutes** after the execution starts.
Download the files at the start of your function.
To keep a file for a longer time, upload it to [Storage](/docs/products/storage).

# Duplicate emails {% #duplicate-emails %}

Appwrite can deliver the same email to your function more than one time.
For example, the sending mail server can send the email again when its connection fails.

Use the email `id` to detect a duplicate.
The [example function](#handle-an-email) uses the `id` as the row ID, so Appwrite rejects a second row for the same email with a `409` error.

# Limits {% #limits %}

{% info title="SMTP-DOCS-TODO: Verify limits" %}
**SMTP-DOCS-TODO verify:limits.** These values come from the current implementation and can change for each plan. Confirm them before release, then remove this block.
{% /info %}

- Maximum size of an email, including attachments: 25 MB.
- Maximum size of the email body after decoding: 8 MB.
- Maximum number of recipients for each email: 50.
- Maximum number of MIME parts for each email: 200.
- Maximum duration of an email execution: 60 seconds. This limit applies even when the timeout of your function is longer.
