require 'appwrite'

include Appwrite

def main(context)
  if context.req.headers['x-appwrite-trigger'] != 'email'
    return context.res.text('Not an email', 400)
  end

  email = context.req.body_json

  client = Client.new
    .set_endpoint(ENV['APPWRITE_FUNCTION_API_ENDPOINT'])
    .set_project(ENV['APPWRITE_FUNCTION_PROJECT_ID'])
    .set_key(context.req.headers['x-appwrite-key'])

  tables_db = TablesDB.new(client)

  begin
    tables_db.create_row(
      database_id: '<DATABASE_ID>',
      table_id: '<TABLE_ID>',
      row_id: email['id'],
      data: {
        from: email['from'],
        subject: email['subject'],
        text: email['text']
      }
    )
  rescue Appwrite::Exception => e
    if e.code.to_i == 409
      context.log("Email #{email['id']} is already saved")
      return context.res.empty
    end
    context.error("Failed to save email: #{e.message}")
    raise
  end

  context.log("Saved email #{email['id']}")
  context.res.empty
end
