```server-rust
use appwrite::Client;
use appwrite::services::messaging::Messaging;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new()
        .set_endpoint("https://<REGION>.cloud.appwrite.io/v1")
        .set_project("<PROJECT_ID>")
        .set_key("<YOUR_API_KEY>");

    let messaging = Messaging::new(&client);

    let provider = messaging.update_bird_sms_provider(
        "<PROVIDER_ID>",          // providerId
        Some("<NAME>"),           // name (optional)
        Some(false),              // enabled (optional)
        Some("<BIRD_API_KEY>"),   // apiKey (optional)
        Some("+12065550100"),     // from (optional)
    ).await?;

    println!("{:?}", provider);
    Ok(())
}
```
```http
PATCH /v1/messaging/providers/bird-sms/<PROVIDER_ID> HTTP/1.1
Content-Type: application/json
X-Appwrite-Project: <PROJECT_ID>
X-Appwrite-Key: <API_KEY>

{
  "name": "<NAME>",
  "enabled": false,
  "apiKey": "<BIRD_API_KEY>",
  "from": "+12065550100"
}
```
