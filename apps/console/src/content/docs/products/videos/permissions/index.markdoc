```server-dotnet
using Appwrite;
using Appwrite.Models;
using Appwrite.Services;

Client client = new Client()
    .SetEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .SetProject("<PROJECT_ID>")
    .SetKey("<API_KEY>");

Videos videos = new Videos(client);

Video video = await videos.Create(
    bucketId: "<BUCKET_ID>",
    fileId: "<FILE_ID>",
