```server-deno
import { Client, Videos, Permission, Role } from "npm:node-appwrite";

const client = new Client()
    .setEndpoint('https://<REGION>.cloud.appwrite.io/v1')
    .setProject('<PROJECT_ID>')
    .setKey('<API_KEY>');

const videos = new Videos(client);

const video = await videos.create({
    bucketId: '<BUCKET_ID>',
    fileId: '<FILE_ID>',
    permissions: [Permission.read(Role.team('<TEAM_ID>'))] // optional
});
```

```server-go
package main

import (
	"fmt"

	"github.com/appwrite/sdk-for-go/v7/appwrite"
	"github.com/appwrite/sdk-for-go/v7/permission"
	"github.com/appwrite/sdk-for-go/v7/role"
	"github.com/appwrite/sdk-for-go/v7/videos"
)

func main() {
	client := appwrite.NewClient(
		appwrite.WithEndpoint("https://<REGION>.cloud.appwrite.io/v1"),
		appwrite.WithProject("<PROJECT_ID>"),
		appwrite.WithKey("<API_KEY>"),
	)

	service := videos.New(client)

	video, err := service.Create(
		"<BUCKET_ID>",
		"<FILE_ID>",
		service.WithCreatePermissions([]string{permission.Read(role.Team("<TEAM_ID>", ""))}),
	)
	if err != nil {
		panic(err)
	}

	fmt.Println(video)
}
```

```server-swift
