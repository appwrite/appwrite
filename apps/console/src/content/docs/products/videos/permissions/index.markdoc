    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
    .setKey("<API_KEY>")

let videos = Videos(client)

let video = try await videos.create(
    bucketId: "<BUCKET_ID>",
    fileId: "<FILE_ID>",
    permissions: [Permission.read(Role.team("<TEAM_ID>"))] // optional
)
```

```server-kotlin
