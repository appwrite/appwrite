```server-java
import io.appwrite.Client;
import io.appwrite.coroutines.CoroutineCallback;
import io.appwrite.exceptions.AppwriteException;
import io.appwrite.Permission;
import io.appwrite.Role;
import io.appwrite.services.Videos;
import java.util.List;

Client client = new Client()
    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
    .setKey("<API_KEY>");

Videos videos = new Videos(client);

try {
    videos.create(
        "<BUCKET_ID>", // bucketId
        "<FILE_ID>", // fileId
        null, // name (optional)
        List.of(Permission.read(Role.team("<TEAM_ID>"))), // permissions (optional)
        new CoroutineCallback<>((result, error) -> {
            if (error != null) {
                error.printStackTrace();
                return;
            }

            System.out.println(result);
        })
    );
} catch (AppwriteException e) {
    e.printStackTrace();
}
```

```server-rust
use appwrite::Client;
use appwrite::permission::Permission;
use appwrite::role::Role;
use appwrite::services::Videos;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1");
    client.set_project("<PROJECT_ID>");
    client.set_key("<API_KEY>");

    let videos = Videos::new(&client);

    let video = videos.create(
        "<BUCKET_ID>",
        "<FILE_ID>",
        None, // name
        Some(vec![Permission::read(Role::team("<TEAM_ID>", None)).to_string()]) // permissions
    ).await?;

    println!("{:?}", video);

    Ok(())
}
```
{% /multicode %}

Signed-in users can also create videos from a client SDK, from files they can read. They can only grant permissions to roles they belong to.

## Change access later {% #change-access-later %}

In the Console, open the video, select **Settings**, and use the **Access** card:

- **Public playback** grants or removes **Read** for **Any** as soon as you flip it.
- **Permissions** edits read, update, and delete for any role. Click **Update** to save.

{% only_dark %}
![Access settings of a video with Public playback turned on and Read granted to Any](/images/docs/videos/dark/settings-access.avif)
{% /only_dark %}
{% only_light %}
![Access settings of a video with Public playback turned on and Read granted to Any](/images/docs/videos/settings-access.avif)
{% /only_light %}

While a video has no Read for Any, every tab of the video shows a **This video is private** notice with a link to these settings.

With a server SDK, update the video's permissions with `videos.update()`. The new list replaces the old one, and `name` is required, so pass the current name to keep it:

{% multicode %}
```server-nodejs
const sdk = require('node-appwrite');

const client = new sdk.Client()
    .setEndpoint('https://<REGION>.cloud.appwrite.io/v1')
    .setProject('<PROJECT_ID>')
    .setKey('<API_KEY>');

const videos = new sdk.Videos(client);

const video = await videos.update({
    videoId: '<VIDEO_ID>',
    name: '<VIDEO_NAME>',
    permissions: [sdk.Permission.read(sdk.Role.users())] // optional
});
```

```server-python
