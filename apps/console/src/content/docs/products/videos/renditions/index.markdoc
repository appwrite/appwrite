```server-java
import io.appwrite.Client;
import io.appwrite.coroutines.CoroutineCallback;
import io.appwrite.exceptions.AppwriteException;
import io.appwrite.enums.VideoOutput;
import io.appwrite.services.Videos;

Client client = new Client()
    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
    .setKey("<API_KEY>");

Videos videos = new Videos(client);

try {
    videos.deleteRendition(
        "<VIDEO_ID>", // videoId
        "<RENDITION_ID>", // renditionId
        new CoroutineCallback<>((deleted, error) -> {
            if (error != null) {
                error.printStackTrace();
                return;
            }

            try {
                videos.createRendition(
                    "<VIDEO_ID>", // videoId
                    "<PROFILE_ID>", // profileId
                    VideoOutput.CMAF, // output
                    new CoroutineCallback<>((result, createError) -> {
                        if (createError != null) {
                            createError.printStackTrace();
                            return;
                        }

                        System.out.println(result);
                    })
                );
            } catch (AppwriteException e) {
                e.printStackTrace();
            }
        })
    );
} catch (AppwriteException e) {
    e.printStackTrace();
}
```

```server-rust
use appwrite::Client;
use appwrite::enums::VideoOutput;
use appwrite::services::Videos;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1");
    client.set_project("<PROJECT_ID>");
    client.set_key("<API_KEY>");

    let videos = Videos::new(&client);

    videos.delete_rendition(
        "<VIDEO_ID>",
        "<RENDITION_ID>"
    ).await?;

    let rendition = videos.create_rendition(
        "<VIDEO_ID>",
        "<PROFILE_ID>",
        VideoOutput::Cmaf
    ).await?;

    println!("{:?}", rendition);

    Ok(())
}
```
{% /multicode %}

If the same profile fails again, read the rendition's `error`, then check the source. A file that is truncated, or uses a codec the encoder cannot read, fails every rendition. Playing the source file from Storage on your own machine is a quick way to rule this out.

# Delete a rendition {% #delete-a-rendition %}

Deleting a rendition removes its segments and drops it from the master manifest. Players stop offering that quality on their next manifest load. Other renditions of the video keep streaming.

You cannot delete a rendition while it is encoding or storing segments, which is the `started` and `ended` statuses. The request returns `video_rendition_in_progress`, so wait for the job to finish. A queued rendition can be deleted at any time. A rendition that makes no progress for 12 hours is marked `aborted`, and can be deleted then.
