```server-java
import io.appwrite.Client;
import io.appwrite.coroutines.CoroutineCallback;
import io.appwrite.exceptions.AppwriteException;
import io.appwrite.Query;
import io.appwrite.services.Videos;
import java.util.List;

Client client = new Client()
    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
    .setKey("<API_KEY>");

Videos videos = new Videos(client);

try {
    videos.listRenditions(
        "<VIDEO_ID>", // videoId
        List.of(Query.equal("output", List.of("cmaf")), Query.equal("status", List.of("ready"))), // queries (optional)
        new CoroutineCallback<>((result, error) -> {
            if (error != null) {
                error.printStackTrace();
                return;
            }

            System.out.println(result);
        })
    );
} catch (AppwriteException e) {
    e.printStackTrace();
}
```

```server-rust
use appwrite::Client;
use appwrite::query::Query;
use appwrite::services::Videos;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1");
    client.set_project("<PROJECT_ID>");
    client.set_key("<API_KEY>");

    let videos = Videos::new(&client);

    let renditions = videos.list_renditions(
        "<VIDEO_ID>",
        Some(vec![Query::equal("output", vec!["cmaf"]).to_string(), Query::equal("status", vec!["ready"]).to_string()]) // queries
    ).await?;

    println!("{:?}", renditions);

    Ok(())
}
```
{% /multicode %}

You can also filter and sort renditions on `profileId`, `name`, `codec`, `width`, `height`, `videoBitRate`, `audioBitRate`, `startedAt`, and `endedAt`.

A common pattern is to mark the video as published in your own database once `total` is greater than 0, and to show a "processing" state until then. Poll every few seconds rather than in a tight loop, since encoding takes seconds to minutes.

To tell when *every* rendition has finished, list them with `Query.equal('status', ['pending', 'started', 'ended'])` instead, and check that `total` is 0.

# Retry a failed rendition {% #retry-a-failed-rendition %}

A failed or aborted rendition is not retried in place. In the Console, click **Retry** on the rendition in the **Renditions** tab, or select several and retry them together. Retry deletes each rendition and creates it again. With an SDK, do the same yourself:

{% multicode %}
```server-nodejs
const sdk = require('node-appwrite');

const client = new sdk.Client()
    .setEndpoint('https://<REGION>.cloud.appwrite.io/v1')
    .setProject('<PROJECT_ID>')
    .setKey('<API_KEY>');

const videos = new sdk.Videos(client);

await videos.deleteRendition({
    videoId: '<VIDEO_ID>',
    renditionId: '<RENDITION_ID>'
});

const rendition = await videos.createRendition({
    videoId: '<VIDEO_ID>',
    profileId: '<PROFILE_ID>',
    output: sdk.VideoOutput.Cmaf
});
```

```server-python
