```server-java
import io.appwrite.Client;
import io.appwrite.coroutines.CoroutineCallback;
import io.appwrite.exceptions.AppwriteException;
import io.appwrite.services.Monitors;
import java.util.List;

Client client = new Client()
    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
    .setKey("<API_KEY>");

Monitors monitors = new Monitors(client);

try {
    monitors.createHttpMonitor(
        "api-health", // monitorId
        "API health", // name
        "https://api.example.com/health", // url
        null, // method (optional)
        null, // headers (optional)
        null, // body (optional)
        List.of(200), // statusCodes (optional)
        14, // certificateDays (optional)
        60, // interval (optional)
        10, // timeout (optional)
        new CoroutineCallback<>((result, error) -> {
            if (error != null) {
                error.printStackTrace();
                return;
            }

            System.out.println(result);
        })
    );
} catch (AppwriteException e) {
    e.printStackTrace();
}
```

```server-rust
use appwrite::Client;
use appwrite::services::Monitors;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1");
    client.set_project("<PROJECT_ID>");
    client.set_key("<API_KEY>");

    let monitors = Monitors::new(&client);

    let monitor = monitors.create_http_monitor(
        "api-health",
        "API health",
        "https://api.example.com/health",
        None, // method
        None, // headers
        None, // body
        Some(vec![200]), // statusCodes
        Some(14), // certificateDays
        Some(60), // interval
        Some(10), // timeout
        None, // cooldown
        None, // enabled
        None, // notify
        None // severity
    ).await?;

    println!("{:?}", monitor);

    Ok(())
}
```

```http
POST /v1/monitors/http HTTP/1.1
Content-Type: application/json
X-Appwrite-Project: <PROJECT_ID>
X-Appwrite-Key: <API_KEY>

{
  "monitorId": "api-health",
  "name": "API health",
  "url": "https://api.example.com/health",
  "statusCodes": [200],
  "certificateDays": 14,
  "interval": 60,
  "timeout": 10
}
```
{% /multicode %}

The other types take their own target parameters in place of `url`:

| Method | Target parameters |
| --- | --- |
| `createHttpMonitor` | `url`, plus optional `method` (defaults to `GET`), `headers`, `body`, `statusCodes`, and `certificateDays` (1 to 398, or `0` to only check that the certificate is valid) |
| `createDnsMonitor` | `domain`, plus optional `record`, `resolver` (an IP address with an optional port, such as `1.1.1.1`), and `answer` |
| `createTcpMonitor` | `host` and `port` |
| `createSmtpMonitor` | `host` and `port`, plus optional `tlsMode`: `none`, `starttls`, or `implicit`. Leave it out to choose from the port. |

All four also take `interval` and `timeout` in seconds, and the `cooldown`, `enabled`, `notify`, and `severity` parameters that [usage monitors](/docs/products/monitors/usage#create-with-a-server-sdk) use. Each type has a matching update method, such as `updateHttpMonitor`.

