```server-go
package main

import (
	"fmt"

	"github.com/appwrite/sdk-for-go/v7/appwrite"
	"github.com/appwrite/sdk-for-go/v7/monitors"
)

func main() {
	client := appwrite.NewClient(
		appwrite.WithEndpoint("https://<REGION>.cloud.appwrite.io/v1"),
		appwrite.WithProject("<PROJECT_ID>"),
		appwrite.WithKey("<API_KEY>"),
	)

	service := monitors.New(client)

	monitor, err := service.CreateHttpMonitor(
		"api-health",
		"API health",
		"https://api.example.com/health",
		service.WithCreateHttpMonitorStatusCodes([]int{200}),
		service.WithCreateHttpMonitorCertificateDays(14),
		service.WithCreateHttpMonitorInterval(60),
		service.WithCreateHttpMonitorTimeout(10),
	)
	if err != nil {
		panic(err)
	}

	fmt.Println(monitor)
}
```

