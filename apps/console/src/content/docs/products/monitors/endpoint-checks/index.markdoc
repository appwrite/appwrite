```server-dotnet
using Appwrite;
using Appwrite.Enums;
using Appwrite.Models;
using Appwrite.Services;

Client client = new Client()
    .SetEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .SetProject("<PROJECT_ID>")
    .SetKey("<API_KEY>");

Monitors monitors = new Monitors(client);

// Fully qualified, since System.Threading also has a Monitor class.
Appwrite.Models.Monitor monitor = await monitors.CreateHttpMonitor(
    monitorId: "api-health",
    name: "API health",
    url: "https://api.example.com/health",
    rules: new List<string> {
        Query.Or(new List<string> {
            Query.NotBetween("statusCode", 200, 299),
            Query.GreaterThan("latency", 2000)
        })
    }, // optional
    interval: 60, // optional
    timeout: 10, // optional
    severity: MonitorSeverity.Critical // optional
);
```

