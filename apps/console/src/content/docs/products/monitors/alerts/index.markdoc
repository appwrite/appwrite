    .setKey("<API_KEY>")

let alerts = Alerts(client)

let alert = try await alerts.update(
    alertId: "<ALERT_ID>",
    acknowledged: true
)
```

```server-kotlin
import io.appwrite.Client
import io.appwrite.services.Alerts

val client = Client()
    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
