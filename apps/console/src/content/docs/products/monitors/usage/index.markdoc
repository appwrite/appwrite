```server-java
import io.appwrite.Client;
import io.appwrite.coroutines.CoroutineCallback;
import io.appwrite.exceptions.AppwriteException;
import io.appwrite.Query;
import io.appwrite.enums.MonitorSeverity;
import io.appwrite.services.Monitors;
import java.util.List;

Client client = new Client()
    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
    .setKey("<API_KEY>");

Monitors monitors = new Monitors(client);

try {
    monitors.createUsageMonitor(
        "outbound-bandwidth", // monitorId
        "Outbound bandwidth spike", // name
        List.of(Query.greaterThan("network.outbound", 1000000000)), // rules
        3600, // window (optional)
        1800, // cooldown (optional)
        null, // enabled (optional)
        List.of("owner", "developer"), // notify (optional)
        MonitorSeverity.ERROR, // severity (optional)
        new CoroutineCallback<>((result, error) -> {
            if (error != null) {
                error.printStackTrace();
                return;
            }

            System.out.println(result);
        })
    );
} catch (AppwriteException e) {
    e.printStackTrace();
}
```

```server-rust
use appwrite::Client;
use appwrite::enums::MonitorSeverity;
use appwrite::query::Query;
use appwrite::services::Monitors;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1");
    client.set_project("<PROJECT_ID>");
    client.set_key("<API_KEY>");

    let monitors = Monitors::new(&client);

    let monitor = monitors.create_usage_monitor(
        "outbound-bandwidth",
        "Outbound bandwidth spike",
        vec![Query::greater_than("network.outbound", 1000000000).to_string()],
        Some(3600), // window
        Some(1800), // cooldown
        None, // enabled
        Some(vec!["owner".to_string(), "developer".to_string()]), // notify
        Some(MonitorSeverity::Error), // severity
        None // escalationId
    ).await?;

    println!("{:?}", monitor);

    Ok(())
}
```

```http
POST /v1/monitors/usage HTTP/1.1
Content-Type: application/json
X-Appwrite-Project: <PROJECT_ID>
X-Appwrite-Key: <API_KEY>

{
  "monitorId": "outbound-bandwidth",
  "name": "Outbound bandwidth spike",
  "rules": ["{\"method\":\"greaterThan\",\"attribute\":\"network.outbound\",\"values\":[1000000000]}"],
  "window": 3600,
  "cooldown": 1800,
  "notify": ["owner", "developer"],
  "severity": "error"
}
```
{% /multicode %}

Each monitor ID must be unique in the project. Pass `ID.unique()` to have Appwrite generate one.

| Parameter | Purpose |
| --- | --- |
| `rules` | One comparison query on a usage metric, named as the usage API names it, such as `network.outbound` or `databases.operations.reads`. To watch one resource instead of the whole project, add `equal` queries on `resourceType` and `resourceId`. Thresholds use the metric's API unit: bytes for bandwidth and storage, MB-seconds for GB-hours, and a count otherwise. |
| `window` | Seconds a counter is summed over, from 60 to 2,592,000. Defaults to 3,600. Gauges ignore it. |
| `cooldown` | Minimum seconds between two team notifications from this monitor, from 300 to 2,592,000. Defaults to 3,600. |
| `enabled` | Set to `false` to create the monitor paused. Defaults to `true`. |
| `notify` | Organization roles to notify: `owner`, `developer`, or both. Defaults to `["owner"]`. Pass an empty list to rely on [project events](/docs/products/monitors/alerts#use-project-events) alone. |
| `severity` | `info`, `warning`, `error`, or `critical`. Defaults to `warning`. |
| `escalationId` | An organization [escalation](/docs/products/monitors/alerts#escalate-an-alert) to notify instead of `notify`. |

To read monitors back, call `list` with [queries](/docs/products/databases/tablesdb/queries) or `get` with a monitor ID. Both need the `monitors.read` scope. `updateUsageMonitor` changes any of the parameters above, including `enabled` to pause or resume a monitor, and `delete` removes one. Both need `monitors.write`.

# Organization budget monitors {% #organization-budget-monitors %}

On Appwrite Cloud, your organization can also have monitors for additional usage charges. Open the organization's **Billing** page to configure the **Budget cap** and **Billing alerts**. Those settings determine the thresholds and recipients for the organization. The **Budget monitors** section shows the latest reading and when each threshold notification was last sent.

