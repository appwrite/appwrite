```server-java
import io.appwrite.Client;
import io.appwrite.coroutines.CoroutineCallback;
import io.appwrite.exceptions.AppwriteException;
import io.appwrite.Query;
import io.appwrite.enums.MonitorSeverity;
import io.appwrite.services.Monitors;
import java.util.List;

Client client = new Client()
    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
    .setKey("<API_KEY>");

Monitors monitors = new Monitors(client);

try {
    monitors.createUsageMonitor(
        "outbound-bandwidth", // monitorId
        "Outbound bandwidth spike", // name
        List.of(Query.greaterThan("network.outbound", 1000000000)), // rules
        3600L, // window (optional)
        1800L, // cooldown (optional)
        null, // enabled (optional)
        List.of("owner", "developer"), // notify (optional)
        MonitorSeverity.ERROR, // severity (optional)
        new CoroutineCallback<>((result, error) -> {
            if (error != null) {
                error.printStackTrace();
                return;
            }

            System.out.println(result);
        })
    );
} catch (AppwriteException e) {
    e.printStackTrace();
}
```

```server-rust
use appwrite::Client;
use appwrite::enums::MonitorSeverity;
use appwrite::query::Query;
use appwrite::services::Monitors;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1");
    client.set_project("<PROJECT_ID>");
    client.set_key("<API_KEY>");

    let monitors = Monitors::new(&client);

    let monitor = monitors.create_usage_monitor(
        "outbound-bandwidth",
        "Outbound bandwidth spike",
        vec![Query::greater_than("network.outbound", 1000000000).to_string()],
        Some(3600), // window
        Some(1800), // cooldown
        None, // enabled
        Some(vec!["owner".to_string(), "developer".to_string()]), // notify
        Some(MonitorSeverity::Error), // severity
        None // escalationId
    ).await?;

    println!("{:?}", monitor);

    Ok(())
}
```

```http
POST /v1/monitors/usage HTTP/1.1
Content-Type: application/json
X-Appwrite-Project: <PROJECT_ID>
X-Appwrite-Key: <API_KEY>

{
  "monitorId": "outbound-bandwidth",
  "name": "Outbound bandwidth spike",
  "rules": ["{\"method\":\"greaterThan\",\"attribute\":\"network.outbound\",\"values\":[1000000000]}"],
  "window": 3600,
  "cooldown": 1800,
  "notify": ["owner", "developer"],
  "severity": "error"
}
```
{% /multicode %}

Each monitor ID must be unique in the project, and up to 36 characters long. Pass `ID.unique()` to have Appwrite generate one.

| Parameter | Purpose |
| --- | --- |
| `rules` | One `greaterThan`, `greaterThanEqual`, `lessThan`, or `lessThanEqual` query on a metric's [API name](#choose-a-metric-and-scope). To watch one resource instead of the whole project, add `equal` queries on `resourceType` and `resourceId`. `resourceType` takes `database`, `bucket`, `function`, `site`, or `dedicatedDatabase`. Thresholds use the metric's API unit: bytes for bandwidth and storage, MB-seconds for GB-hours, a percentage for dedicated database CPU and memory, and a count otherwise. |
| `window` | Seconds a counter is summed over, from 60 to 2,592,000. Defaults to 3,600. Gauges ignore it. |
| `cooldown` | Minimum seconds between notifications for two alerts from this monitor, from 300 to 2,592,000. Defaults to 3,600. |
| `enabled` | Set to `false` to create the monitor paused. Defaults to `true`. |
| `notify` | Organization roles to notify, such as `owner` or `developer`. On Appwrite Cloud, `editor`, `analyst`, and `billing` also work. Defaults to `["owner"]`. Pass an empty list to rely on [project events](/docs/products/monitors/alerts#use-project-events) alone. |
| `severity` | `info`, `warning`, `error`, or `critical`. Defaults to `warning`. |
| `escalationId` | An organization [escalation](/docs/products/monitors/alerts#escalate-an-alert) to notify instead of `notify`. Pass an empty string on update to go back to `notify`. |

To read monitors back, call `list` with [queries](/docs/products/databases/tablesdb/queries) or `get` with a monitor ID. Both need the `monitors.read` scope. `updateUsageMonitor` changes only the parameters you pass, including `enabled` to pause or resume a monitor, and `delete` removes one. Both need `monitors.write`. Deleting a monitor resolves its open alert and keeps its alert history.

