```server-dotnet
using Appwrite;
using Appwrite.Enums;
using Appwrite.Models;
using Appwrite.Services;

Client client = new Client()
    .SetEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .SetProject("<PROJECT_ID>")
    .SetKey("<API_KEY>");

Monitors monitors = new Monitors(client);

// Fully qualified, since System.Threading also has a Monitor class.
Appwrite.Models.Monitor monitor = await monitors.CreateUsageMonitor(
    monitorId: "outbound-bandwidth",
    name: "Outbound bandwidth spike",
    rules: new List<string> { Query.GreaterThan("network.outbound", 1000000000) },
    window: 3600, // optional
    cooldown: 1800, // optional
    notify: new List<string> { "owner", "developer" }, // optional
    severity: MonitorSeverity.Error // optional
);
```

