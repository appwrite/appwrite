```server-go
package main

import (
    "fmt"
    "log"

    "github.com/appwrite/sdk-for-go/v7/appwrite"
    "github.com/appwrite/sdk-for-go/v7/query"
)

func main() {
    client := appwrite.NewClient(
        appwrite.WithEndpoint("https://<REGION>.cloud.appwrite.io/v1"),
        appwrite.WithProject("<PROJECT_ID>"),
        appwrite.WithKey("<API_KEY>"),
    )

    analytics := appwrite.NewAnalytics(client)

    days, err := analytics.ListMetrics(
        "<PROPERTY_ID>",
        analytics.WithListMetricsInterval("1d"),
        analytics.WithListMetricsDateRange("14d"),
        analytics.WithListMetricsQueries([]string{
            query.Equal("channel", "search"),
        }),
    )
    if err != nil {
        log.Fatal(err)
    }

    for _, row := range days.Metrics {
        fmt.Println(*row.Date, row.Visitors)
    }
}
```
```server-rust
use appwrite::Client;
use appwrite::enums::AnalyticsInterval;
use appwrite::query::Query;
use appwrite::services::Analytics;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = Client::new();
    client.set_endpoint("https://<REGION>.cloud.appwrite.io/v1");
    client.set_project("<PROJECT_ID>");
    client.set_key("<API_KEY>");

    let analytics = Analytics::new(&client);

    let days = analytics.list_metrics(
        "<PROPERTY_ID>",
        Some(vec![Query::equal("channel", "search").to_string()]),
        Some(AnalyticsInterval::OneDay),
        None, // dimensions
        Some("14d"),
        None, // start_at
        None, // end_at
        None, // limit
        None, // total
    ).await?;

    for row in days.metrics {
        println!("{} {}", row.date.unwrap_or_default(), row.visitors);
    }

    Ok(())
}
```
