```server-swift
import Appwrite
import AppwriteEnums

let client = Client()
    .setEndpoint("https://<REGION>.cloud.appwrite.io/v1")
    .setProject("<PROJECT_ID>")
    .setKey("<API_KEY>")

let analytics = Analytics(client)

let countries = try await analytics.listMetrics(
    propertyId: "<PROPERTY_ID>",
