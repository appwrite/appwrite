}
```
```server-php
<?php

require 'vendor/autoload.php';

use Appwrite\Client;
use Appwrite\Enums\AnalyticsDimension;
use Appwrite\Services\Analytics;

$client = (new Client())
    ->setEndpoint('https://<REGION>.cloud.appwrite.io/v1')
    ->setProject('<PROJECT_ID>')
    ->setKey('<API_KEY>');

$analytics = new Analytics($client);

$countries = $analytics->listMetrics(
    propertyId: '<PROPERTY_ID>',
    dimensions: [AnalyticsDimension::COUNTRY()],
    dateRange: '7d',
    limit: 5,
);

foreach ($countries->metrics as $row) {
    echo $row->value, ' ', $row->visitors, PHP_EOL;
}
```
