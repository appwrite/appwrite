{
  "name": "vibes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run generate:routes && bun run generate:github-stars && bun run generate:specs && bun run generate:cover-manifest && bun run generate:blog-manifest && vite build && bun run prune:removed-blog-assets && bun run scripts/check-prerender-styles.ts && bun run generate:specs --copy && bun run generate:sitemap && bun run generate:docs-exports",
    "build:node": "bun run generate:routes && bun run generate:github-stars && bun run generate:specs && bun run generate:cover-manifest && bun run generate:blog-manifest && rm -rf dist && FOR_SITES=true vite build && bun run prune:removed-blog-assets && bun run scripts/check-prerender-styles.ts && bun run generate:specs --copy && bun run generate:sitemap && bun run generate:docs-exports",
    "check": "tsc --noEmit",
    "clean": "rm -rf .output dist node_modules/.vite .nitro .tanstack",
    "dev": "tsr generate && vite dev --port 3000",
    "e2e": "playwright test",
    "e2e:mysql": "playwright test --project=console-mysql",
    "e2e:postgres": "playwright test --project=console-postgres",
    "e2e:tablesdb": "playwright test --project=console-tablesdb",
    "e2e:documentsdb": "playwright test --project=console-documentsdb",
    "e2e:vectorsdb": "playwright test --project=console-vectorsdb",
    "e2e:databases": "playwright test --project=console-mysql --project=console-postgres --project=console-tablesdb --project=console-documentsdb --project=console-vectorsdb",
    "e2e:cleanup-projects": "bun run e2e/cleanup-projects.ts",
    "e2e:usage": "playwright test --project=console-usage && bun run e2e:usage-self-hosted",
    "e2e:usage-self-hosted": "VITE_CONSOLE_PROFILE=self-hosted VITE_CONSOLE_WEBSITE_ACCESS=false playwright test --project=self-hosted-usage",
    "e2e:organizations-self-hosted": "VITE_CONSOLE_PROFILE=self-hosted playwright test --project=self-hosted-organizations",
    "e2e:usage-live": "playwright test --project=console-usage-live",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install-browsers": "playwright install --with-deps chromium",
    "lint": "eslint && bun run lint:snippets && bun run lint:content && bun run lint:removed-blog-links && bun run lint:native-dialogs",
    "lint:snippets": "editorconfig-checker 'src/components/pages/projects/$projectId/shared/connect-snippets'",
    "lint:content": "bun run scripts/lint-hidden-chars.ts",
    "lint:native-dialogs": "bun run scripts/lint-native-dialogs.ts",
    "lint:removed-blog-links": "bun run scripts/lint-removed-blog-links.ts",
    "lint:sdk-pins": "bun run scripts/lint-sdk-pins.ts",
    "lint:types": "bun run scripts/lint-types.ts",
    "prune:removed-blog-assets": "bun run scripts/prune-removed-blog-assets.ts",
    "release:self-hosted": "bun run scripts/release-self-hosted.ts",
    "sdk:preview": "bun run scripts/sdk-preview.ts",
    "serve": "vite preview",
    "start": "bun --preload ./src/lib/sentry/init-server.ts ./server.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "bun test tests/unit",
    "generate:blog-images": "bun run scripts/generate-blog-images.ts",
    "generate:blog-manifest": "bun run scripts/generate-blog-manifest.ts",
    "generate:content-covers": "bun run scripts/generate-content-covers.ts",
    "generate:content-images": "bun run scripts/generate-content-images.ts",
    "encode:firewall-promo-video": "bash scripts/encode-firewall-promo-video.sh",
    "generate:cover-manifest": "bun run scripts/generate-cover-manifest.ts",
    "generate:docs": "bun run scripts/generate-docs.ts",
    "generate:docs-exports": "bun run scripts/generate-docs-exports.ts",
    "generate:github-stars": "bun run scripts/generate-github-stars.ts",
    "generate:public-icon-manifest": "bun run scripts/generate-public-icon-manifest.ts",
    "generate:routes": "tsr generate",
    "generate:sitemap": "bun run scripts/generate-sitemap.ts",
    "generate:specs": "bun run scripts/generate-specs.ts",
    "i18n:audit:he": "bun run scripts/i18n-audit-he.ts",
    "i18n:audit:ja": "bun run scripts/i18n-audit-ja.ts",
    "agent-recommendation-qa": "bun run scripts/agent-recommendation-qa.ts",
    "benchmark:init-server-memory": "bun run scripts/benchmark-init-server-memory.ts",
    "benchmark:init-memory": "bun run scripts/benchmark-init-memory.ts"
  },
