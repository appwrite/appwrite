<?php 

$vars = $this->getParam('vars');

foreach ($vars as $key => $value) {
    if ($value === null || $value === '') {
        echo $key . "=\n";
    } else {
        // Escape newlines and special chars so multiline secrets (e.g. GitHub App
        // private keys) survive install/upgrade rewrites as a single .env line.
        echo $key . '="' . \Appwrite\Docker\Env::encodeValue((string) $value) . '"' . "\n";
    }
}
?>