{
    "name": "utopia-php/agents",
    "description": "Provider-neutral LLM toolkit for PHP: agents with tools, structured output, streaming and embeddings",
    "type": "library",
    "keywords": [
        "php",
        "ai",
        "agents",
        "llm",
        "openai",
        "anthropic",
        "gemini",
        "tools",
        "embeddings"
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Utopia PHP",
            "email": "team@appwrite.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Utopia\\Agents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Agents\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "ext-curl": "HTTP transport outside Swoole coroutines",
        "ext-swoole": "Pooled coroutine HTTP transport inside Swoole"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --testsuite unit"
    },
    "require": {
        "php": ">=8.5",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "utopia-php/client": "^0.6",
        "utopia-php/console": "^0.2",
        "utopia-php/pools": "^2.0",
        "utopia-php/psr7": "^0.2.1"
    }
}
