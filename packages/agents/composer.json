{
    "name": "utopia-php/agents",
    "description": "A simple PHP AI agents library",
    "type": "library",
    "keywords": [
        "php",
        "ai",
        "agents",
        "automation",
        "machine-learning"
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Utopia PHP",
            "email": "team@appwrite.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Utopia\\Agents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Agents\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --testsuite unit"
    },
    "require": {
        "php": ">=8.3",
        "utopia-php/fetch": "^1.1.0"
    }
}
