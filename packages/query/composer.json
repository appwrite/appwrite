{
    "name": "utopia-php/query",
    "description": "A simple library providing a query abstraction for filtering, ordering, and pagination",
    "type": "library",
    "keywords": [
        "php",
        "framework",
        "upf",
        "utopia",
        "query"
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Utopia\\Query\\": "src/Query"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Query\\": "tests/Query",
            "Tests\\Integration\\": "tests/Integration"
        }
    },
    "scripts": {
        "test": "vendor/bin/paratest --testsuite Query --processes=auto --exclude-group=performance",
        "test:coverage": "vendor/bin/paratest --testsuite Query --processes=auto --exclude-group=performance --coverage-php coverage/unit.cov",
        "test:performance": "phpunit --testsuite Query --group=performance",
        "test:integration": "phpunit --testsuite Integration",
        "test:integration:coverage": "phpunit --testsuite Integration --coverage-php coverage/integration.cov"
    },
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "mongodb/mongodb": "^2.0",
        "brianium/paratest": "*",
        "phpunit/phpcov": "*"
    }
}
