{
    "name": "utopia-php/console",
    "description": "Console helpers for logging, prompting, and executing commands",
    "type": "library",
    "keywords": [
        "php",
        "utopia",
        "console",
        "cli",
        "terminal"
    ],
    "license": "MIT",
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --testsuite unit"
    },
    "autoload": {
        "psr-4": {
            "Utopia\\Console\\": "src/"
        },
        "files": [
            "src/compat.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Console\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "utopia-php/validators": "^2.0"
    },
    "minimum-stability": "dev",
    "extra": {
        "utopia": {
            "category": "runtime"
        }
    }
}
