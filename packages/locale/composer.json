{
    "name": "utopia-php/locale",
    "description": "A simple locale library to manage application translations",
    "type": "library",
    "keywords": [
        "php",
        "framework",
        "upf",
        "utopia",
        "locale"
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Utopia\\Locale\\": "src/Locale"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "vimeo/psalm": "4.0.1"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
