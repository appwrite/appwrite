{
    "name": "utopia-php/validators",
    "description": "A lightweight collection of reusable validators for Utopia projects",
    "type": "library",
    "keywords": [
        "php",
        "validation",
        "validator",
        "utopia"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Utopia\\Validator\\": "src/"
        },
        "files": [
            "src/compat.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Validator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --testsuite unit"
    },
    "require": {
        "php": ">=8.5"
    }
}
