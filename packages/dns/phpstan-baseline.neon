			count: 1
			path: src/Adapter/Swoole/Http.php

		-
			message: '#^Cannot access offset ''dns'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Adapter/Swoole/Http.php

		-
			message: '#^Cannot access offset ''remote_addr'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Adapter/Swoole/Http.php

		-
			message: '#^Cannot access offset ''remote_port'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Adapter/Swoole/Http.php

		-
