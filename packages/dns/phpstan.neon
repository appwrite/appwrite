includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    # Utopia\Domains\Domain is registered by the utopia PHP extension; its stub lives in the
    # domains package of this repository.
    scanFiles:
        - ../domains/stubs/Domain.php
    scanDirectories:
        - vendor/swoole/ide-helper
    excludePaths:
        - tests/resources
        - tests/bench
        - vendor
