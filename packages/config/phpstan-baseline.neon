parameters:
	ignoreErrors:
		-
			message: '#^Instanceof between mixed and mixed results in an error\.$#'
			identifier: instanceof.invalidExprType
			count: 1
			path: src/Config.php

		-
			message: '#^Method Utopia\\Config\\Config\:\:missing\(\) should return object but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Config.php

		-
			message: '#^Parameter \#1 \$data of static method Utopia\\Config\\Config\:\:resolveValueRecursive\(\) expects array\<string, mixed\>, array\<mixed, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Config.php

		-
			message: '#^Part \$expectedClass \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: src/Config.php

		-
			message: '#^Method Utopia\\Config\\Parser\:\:requireMap\(\) should return array\<string, mixed\> but returns array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: src/Parser.php

		-
			message: '#^Parameter \#2 \$type of method Utopia\\Config\\Parser\\Dotenv\:\:convertValue\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Parser/Dotenv.php

		-
			message: '#^Method Utopia\\Config\\Parser\\None\:\:parse\(\) should return array\<string, mixed\> but returns array\<mixed, mixed\>\.$#'
			identifier: return.type
			count: 1
			path: src/Parser/None.php

