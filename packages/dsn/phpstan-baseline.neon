parameters:
	ignoreErrors:
		-
			message: '#^Method Utopia\\DSN\\DSN\:\:getParam\(\) should return string but returns array\<mixed\>\|string\.$#'
			identifier: return.type
			count: 1
			path: src/DSN.php

		-
			message: '#^Method Utopia\\DSN\\DSN\:\:getParam\(\) should return string but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/DSN.php

		-
			message: '#^Property Utopia\\DSN\\DSN\:\:\$params type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/DSN.php

		-
			message: '#^Property Utopia\\DSN\\DSN\:\:\$port \(string\|null\) does not accept int\<0, 65535\>\|null\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/DSN.php
