{
    "name": "utopia-php/audit",
    "description": "A simple audit library to manage application users logs",
    "type": "library",
    "keywords": [
        "php",
        "framework",
        "upf",
        "utopia",
        "audit"
    ],
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:e2e": "phpunit --testsuite e2e"
    },
    "autoload": {
        "psr-4": {
            "Utopia\\Audit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Audit\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "utopia-php/client": "^0.6",
        "utopia-php/database": "^8.0",
        "utopia-php/psr7": "^0.2.1",
        "utopia-php/query": "^0.7",
        "utopia-php/validators": "^1.0"
    },
    "require-dev": {
        "ext-pdo_mysql": "*",
        "ext-swoole": "*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
