includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # Its transport doubles narrow the parameters of Swoole's client
        # methods, which the stubs type as mixed; PHPStan reports that as
        # non-ignorable, so it cannot sit in the baseline until the burn-down.
        - tests/ClientTest.php
