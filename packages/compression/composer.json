{
    "name": "utopia-php/compression",
    "description": "A simple Compression library to handle file compression",
    "type": "library",
    "keywords": [
        "php",
        "framework",
        "upf",
        "utopia",
        "compression"
    ],
    "license": "MIT",
    "authors": [],
    "autoload": {
        "psr-4": {
            "Utopia\\Compression\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Compression\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-utopia": "*"
    },
    "minimum-stability": "dev",
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "suggest": {
        "ext-xz": "Required for the XZ algorithm, which calls xzencode() and xzdecode()"
    }
}
