for i, text in enumerate(texts):
    vectors_db.create_document(
        database_id = '<DATABASE_ID>',
        collection_id = '<COLLECTION_ID>',
        document_id = ID.unique(),
        data = {
            "embeddings": generated["embeddings"][i]["embedding"],
            "metadata": { "text": text }
