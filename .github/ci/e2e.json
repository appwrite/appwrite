{
  "paths": {
    "all": [
      ".github/workflows/ci.yml",
      ".github/actions/",
      ".github/ci/",
      ".github/scripts/changes.mjs",
      ".github/scripts/check-native-crashes.sh",
      ".github/gcrunner.yml"
