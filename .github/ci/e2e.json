  "groups": [
    {
      "label": "Abuse",
      "group": "abuseEnabled",
      "path": "/usr/src/code/tests/e2e",
      "options_abuse": "enabled",
      "storage_antivirus": "disabled",
      "compose_profiles": "",
      "wait": "",
      "services": ["Account"]
    },
    {
      "label": "Screenshots",
      "group": "screenshots",
      "path": "/usr/src/code/tests/e2e/Services/Sites",
      "options_abuse": "disabled",
      "storage_antivirus": "disabled",
      "compose_profiles": "",
      "wait": "executor",
      "services": ["Sites"]
    },
    {
      "label": "Antivirus",
      "group": "antivirus",
      "path": "/usr/src/code/tests/e2e/Services/Storage",
      "options_abuse": "disabled",
      "storage_antivirus": "enabled",
      "compose_profiles": "antivirus",
      "wait": "clamav",
      "services": ["Storage"]
    },
    {
      "label": "S3 Storage",
      "group": "s3",
      "path": "/usr/src/code/tests/e2e/Services",
      "options_abuse": "disabled",
      "storage_antivirus": "disabled",
      "compose_profiles": "s3",
      "wait": "executor",
      "storage_device": "s3",
      "services": ["Functions", "Storage"]
    },
    {
      "label": "Queue Retry",
      "group": "queueRetry",
      "path": "/usr/src/code/tests/e2e/Services",
      "options_abuse": "disabled",
      "storage_antivirus": "disabled",
      "compose_profiles": "",
      "wait": "executor",
      "services": ["Functions", "Webhooks"]
    }
  ]
