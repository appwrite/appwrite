#!/usr/bin/env php
<?php

/**
 * Self-hosted release tooling. Runs on the host, not in the container.
 *
 * Automates the mechanical steps of docs/releases.md: the version bump, the
 * console pin, the migration mapping, the release notes draft, the metadata
 * check, and publishing the GitHub Release on the tested commit. Writing the
 * notes and deciding whether a release is ready stay with a person.
 */

final class Release
{
    private const string REPOSITORY = 'appwrite/appwrite';
    private const string CONSOLE_REPOSITORY = 'appwrite/vibes';
    private const string CONSOLE_IMAGE = 'appwrite/new';
    private const string CONSOLE_SUFFIX = '-self-hosted';
    private const string IMAGE = 'appwrite/appwrite';
    private const string CONSTANTS = 'app/init/constants.php';
    private const string COMPOSE = 'docker-compose.yml';
    private const string MIGRATION = 'src/Appwrite/Migration/Migration.php';
    private const array READMES = ['README.md', 'README-CN.md'];
    private const string VARIABLES = 'app/config/variables.php';

    /**
     * Compose variables that are deliberately not user-configurable, so they have
     * no definition in app/config/variables.php.
     */
    private const array INTERNAL = [
        '_APP_MQTT_WS_PORT', // broker's internal listener; Traefik routes to it by number
    ];

    /**
     * @param string[] $argv
     */
    public function run(array $argv): void
    {
        chdir(dirname(__DIR__));

        $arguments = array_slice($argv, 1);
        $command = array_shift($arguments) ?? 'help';
        $options = [];
        $arguments = array_values(array_filter($arguments, function (string $argument) use (&$options): bool {
            if (!str_starts_with($argument, '--')) {
                return true;
            }
            [$key, $value] = array_pad(explode('=', substr($argument, 2), 2), 2, true);
            $options[$key] = $value;

            return false;
        }));

        match ($command) {
            'prepare' => $this->prepare($arguments, $options),
            'push' => $this->push($arguments, $options),
            'check' => $this->check($arguments, $options),
            'publish' => $this->publish($arguments, $options),
            default => $this->help(),
        };
    }

    /**
     * @param string[] $arguments
     * @param array<string, string|true> $options
     */
    private function prepare(array $arguments, array $options): void
    {
        $version = $arguments[0] ?? $this->fail('usage: release prepare <version>');
        [, , $patch] = $this->parse($version);
        $branch = $this->branch($version);
        $work = $this->work($version);

        if ($this->sh('git status --porcelain') !== '') {
            $this->fail('working tree is dirty; commit or stash first');
        }
        if ($this->succeeds('git rev-parse --verify --quiet ' . escapeshellarg("refs/heads/{$work}"))) {
            $this->fail("{$work} already exists; push it with `bin/release push {$version}`, or delete it to start over");
        }
        $this->sh('git fetch --quiet --tags origin');
        if ($this->sh('git tag --list ' . escapeshellarg($version)) !== '') {
            $this->fail("tag {$version} already exists");
        }

        // The work branch starts from the remote ref directly, so a checked-out
        // local X.Y.x is never touched. A minor's X.Y.x is created on push, at
        // the parent of the prepare commit.
        $previous = $this->previous($version);
        $exists = $this->succeeds('git ls-remote --exit-code --heads origin ' . escapeshellarg($branch));
        if (!$exists && $patch > 0) {
            $this->fail("{$branch} does not exist on origin; a patch is released from its minor's branch");
        }
        $base = $exists ? "origin/{$branch}" : 'origin/main';
        $this->sh('git fetch --quiet origin ' . escapeshellarg($exists ? $branch : 'main'));
        $this->sh('git checkout --quiet -b ' . escapeshellarg($work) . ' ' . escapeshellarg($base));
        $this->out("{$work} from {$base}" . ($exists ? '' : "; {$branch} is created at the same commit on push"));

        $current = $this->stable();
        $this->replace(self::CONSTANTS, "const APP_VERSION_STABLE = '{$current}';", "const APP_VERSION_STABLE = '{$version}';");
        $this->out("APP_VERSION_STABLE {$current} → {$version}");

        foreach (self::READMES as $readme) {
            $count = $this->replace($readme, self::IMAGE . ":{$current}", self::IMAGE . ":{$version}");
            $this->out("{$readme}: {$count} install snippets → {$version}");
        }

        $previousConsole = $this->pinned();
        $console = $this->latestConsole();
        $this->replace(self::COMPOSE, self::CONSOLE_IMAGE . ":{$previousConsole}" . self::CONSOLE_SUFFIX, self::CONSOLE_IMAGE . ":{$console}" . self::CONSOLE_SUFFIX);
        $this->out("console {$previousConsole} → {$console}");

        $class = $this->migration($version);
        if ($class === null) {
            $class = $this->map($version, $previous);
            $this->out("Migration: {$version} => {$class} (same class as {$previous})");
        } else {
            $this->out("Migration: {$version} => {$class} (already mapped)");
        }
        $changed = $this->sh('git diff --stat ' . escapeshellarg($previous) . ' HEAD -- src/Appwrite/Migration');
        if ($changed !== '') {
            $this->warn("migrations changed since {$previous}; confirm {$class} is idempotent for installs that already ran it:\n{$changed}");
        }

        $problems = $this->problems($version);
        if ($problems !== []) {
            $this->fail("prepared tree still fails the check:\n  " . implode("\n  ", $problems));
        }
        // Definitions are written by hand in the prep PR, so they only block push.
        foreach ($this->variables($version) as $problem) {
            $this->warn($problem);
        }

        $this->sh('git add ' . implode(' ', array_map(escapeshellarg(...), [self::CONSTANTS, self::COMPOSE, self::MIGRATION, ...self::READMES])));
        $this->sh('git commit --quiet -m ' . escapeshellarg($this->title($version)));

        $draft = $this->draft($version);
        file_put_contents($draft, $this->notes($version, $previous, $exists ? $branch : 'main', $console, $previousConsole));
        $this->out("committed on {$work}; notes draft: {$draft}");
        $this->out("next: review and amend the commit and the draft, then `bin/release push {$version}`");
    }

    /**
     * @param string[] $arguments
     * @param array<string, string|true> $options
     */
    private function push(array $arguments, array $options): void
    {
        $version = $arguments[0] ?? $this->fail('usage: release push <version>');
        $this->parse($version);
        $branch = $this->branch($version);
        $work = $this->work($version);
        $draft = $this->draft($version);

        $this->succeeds('git rev-parse --verify --quiet ' . escapeshellarg("refs/heads/{$work}"))
            || $this->fail("{$work} does not exist; run `bin/release prepare {$version}` first");
        is_file($draft) || $this->fail("notes draft {$draft} not found");
        $problems = [...$this->problems($version, $work), ...$this->variables($version, $work)];
        if ($problems !== []) {
            $this->fail("{$work} fails the check:\n  " . implode("\n  ", $problems));
        }

        // Pushes exactly what was prepared and reviewed: the branch as it is
        // and the draft as edited. Nothing is regenerated.
        $this->sh('git fetch --quiet origin main');
        if (!$this->succeeds('git ls-remote --exit-code --heads origin ' . escapeshellarg($branch))) {
            $base = $this->sh('git rev-parse ' . escapeshellarg("{$work}^"));
            $this->succeeds('git merge-base --is-ancestor ' . escapeshellarg($base) . ' origin/main')
                || $this->fail("the parent of {$work} ({$base}) is not on origin/main");
            $this->sh('git push --quiet origin ' . escapeshellarg("{$base}:refs/heads/{$branch}"));
            $this->out("pushed {$branch} at {$base}");
        }
        $this->sh('git push --quiet -u origin ' . escapeshellarg($work));
        $this->out($this->sh('gh pr create -R ' . self::REPOSITORY . ' --base ' . escapeshellarg($branch) . ' --head ' . escapeshellarg($work)
            . ' --title ' . escapeshellarg($this->title($version)) . ' --body-file ' . escapeshellarg($draft)));

        $open = $this->sh('gh pr list -R ' . self::REPOSITORY . ' --base main --head ' . escapeshellarg($branch) . " --json number --jq '.[0].number // empty'");
        if ($open === '') {
            $this->out($this->sh('gh pr create -R ' . self::REPOSITORY . ' --base main --head ' . escapeshellarg($branch)
                . ' --title ' . escapeshellarg("chore: merge {$branch} into main after {$version}")
                . ' --body ' . escapeshellarg("Release test record for {$version}. Gate results and the tested SHA go here; merge after the release is published. See docs/releases.md.")));
        }
    }

    /**
     * @param string[] $arguments
     * @param array<string, string|true> $options
     */
    private function check(array $arguments, array $options): void
    {
        $version = $arguments[0] ?? $this->fail('usage: release check <version> [--ref=<commit>]');
        $this->parse($version);
        $this->sh('git fetch --quiet --tags origin');
        $reference = is_string($options['ref'] ?? null) ? $options['ref'] : null;
        $problems = [...$this->problems($version, $reference), ...$this->variables($version, $reference)];
        if ($problems !== []) {
            $this->fail("{$version} is not ready:\n  " . implode("\n  ", $problems));
        }
        // Advisory only: a newer console release, or a failed lookup, never
        // makes a consistent release fail the check.
        $console = $this->pinned($reference);
        exec('gh release list -R ' . self::CONSOLE_REPOSITORY . " --exclude-drafts --exclude-pre-releases --limit 1 --json tagName --jq '.[0].tagName' 2> /dev/null", $latest, $code);
        $latest = trim(implode('', $latest));
        if ($code === 0 && $latest !== '' && $latest !== $console) {
            $this->warn("console pin {$console} is behind the newest release {$latest}");
        }
        $this->out("{$version} metadata is consistent");
    }

    /**
     * @param string[] $arguments
     * @param array<string, string|true> $options
     */
    private function publish(array $arguments, array $options): void
    {
        $usage = 'usage: release publish <version> --sha=<tested-sha> --notes=<file>';
        $version = $arguments[0] ?? $this->fail($usage);
        $this->parse($version);
        $sha = is_string($options['sha'] ?? null) ? $options['sha'] : $this->fail($usage);
        $file = is_string($options['notes'] ?? null) ? $options['notes'] : $this->fail($usage);
        is_file($file) || $this->fail("notes file {$file} not found");
        $branch = $this->branch($version);

        $this->succeeds('git ls-remote --exit-code --heads origin ' . escapeshellarg($branch))
            || $this->fail("{$branch} does not exist on origin; releases are published from their X.Y.x branch");
        $this->sh('git fetch --quiet --tags origin ' . escapeshellarg($branch));
        $sha = $this->sh('git rev-parse --verify ' . escapeshellarg("{$sha}^{commit}"));
        $this->succeeds('git merge-base --is-ancestor ' . escapeshellarg($sha) . ' ' . escapeshellarg("origin/{$branch}"))
            || $this->fail("{$sha} is not on origin/{$branch}");
        $tip = $this->sh('git rev-parse ' . escapeshellarg("origin/{$branch}"));
        if ($tip !== $sha) {
            $this->warn("origin/{$branch} has moved past the tested commit ({$tip}); those commits are not in this release");
        }

        $problems = [...$this->problems($version, $sha), ...$this->variables($version, $sha)];
        if ($problems !== []) {
            $this->fail("{$version} is not ready at {$sha}:\n  " . implode("\n  ", $problems));
        }

        $tagged = $this->sh('git ls-remote origin ' . escapeshellarg("refs/tags/{$version}"));
        if ($tagged !== '' && !str_starts_with($tagged, $sha)) {
            $this->fail("tag {$version} already points at " . substr($tagged, 0, 40) . ", not {$sha}");
        }
        if ($this->published(self::IMAGE, $version)) {
            $this->fail(self::IMAGE . ":{$version} is already on Docker Hub; published versions are immutable, ship the next patch");
        }

        $this->confirm("Publish {$version} on {$sha} as the latest release?", $version);
        $this->out($this->sh('gh release create ' . escapeshellarg($version) . ' -R ' . self::REPOSITORY
            . ' --target ' . escapeshellarg($sha)
            . ' --title ' . escapeshellarg($version)
            . ' --notes-file ' . escapeshellarg($file)
            . ' --latest'));
        $this->out('published; watch it with: gh run list -R ' . self::REPOSITORY . ' --workflow=release.yml --limit 1');
    }

    private function help(): void
    {
        $this->out(<<<'HELP'
    usage: bin/release <command>

      prepare <version>                   branch release/<version> off X.Y.x (off main for a minor),
                                          bump the version, READMEs, console pin and migration
                                          mapping, commit, and draft the notes
      push <version>                      push release/<version> as prepared (and X.Y.x for a minor),
                                          open the prep PR with the draft and the X.Y.x → main PR
      check <version> [--ref=<commit>]    fail unless the release metadata is consistent
      publish <version> --sha=<tested-sha> --notes=<file>
                                          verify the tested commit and publish the GitHub Release
                                          on it, after typing the version to confirm
    HELP);
    }

    private function out(string $message): void
    {
        fwrite(STDOUT, $message . PHP_EOL);
    }

    private function warn(string $message): void
    {
        fwrite(STDERR, 'warning: ' . $message . PHP_EOL);
    }

    private function fail(string $message): never
    {
        fwrite(STDERR, 'error: ' . $message . PHP_EOL);
        exit(1);
    }

    /**
     * Run a command, return its stdout. Stderr streams through to the terminal.
     */
    private function sh(string $command): string
    {
        exec($command, $output, $code);
        if ($code !== 0) {
            $this->fail("command failed ({$code}): {$command}");
        }

        return trim(implode(PHP_EOL, $output));
    }

    private function succeeds(string $command): bool
    {
        exec($command . ' > /dev/null 2>&1', $_, $code);

        return $code === 0;
    }

    /**
     * @return int[] major, minor, patch
     */
    private function parse(string $version): array
    {
        $parts = explode('.', $version);
        if (count($parts) !== 3) {
            $this->fail("version must be X.Y.Z, got \"{$version}\"");
        }
        foreach ($parts as $part) {
            if (!ctype_digit($part)) {
                $this->fail("version must be X.Y.Z, got \"{$version}\"");
            }
        }

        return array_map(intval(...), $parts);
    }

    private function work(string $version): string
    {
        return "release/{$version}";
    }

    private function title(string $version): string
    {
        return "chore: prepare {$version} release";
    }

    /**
     * The notes draft lives in the git directory: untracked, and kept until push.
     */
    private function draft(string $version): string
    {
        return $this->sh('git rev-parse --absolute-git-dir') . "/appwrite-{$version}-notes.md";
    }

    private function line(string $version): string
    {
        [$major, $minor] = $this->parse($version);

        return "{$major}.{$minor}";
    }

    private function branch(string $version): string
    {
        return $this->line($version) . '.x';
    }

    /**
     * Highest stable tag lower than the given version.
     */
    private function previous(string $version): string
    {
        foreach (explode(PHP_EOL, $this->sh('git tag --list --sort=-v:refname')) as $tag) {
            $parts = explode('.', $tag);
            if (count($parts) !== 3 || !ctype_digit(implode('', $parts))) {
                continue;
            }
            if (version_compare($tag, $version, '<')) {
                return $tag;
            }
        }
        $this->fail("no stable tag lower than {$version}");
    }

    /**
     * Read a file from the working tree, or from a commit when one is given.
     */
    private function read(string $path, ?string $commit = null): string
    {
        if ($commit !== null) {
            return $this->sh('git show ' . escapeshellarg("{$commit}:{$path}"));
        }

        return file_get_contents($path) ?: $this->fail("cannot read {$path}");
    }

    /**
     * The value between the first quote pair that follows $marker.
     */
    private function quoted(string $content, string $marker): ?string
    {
        $start = strpos($content, $marker);
        if ($start === false) {
            return null;
        }
        $open = strpos($content, "'", $start + strlen($marker));
        $close = $open === false ? false : strpos($content, "'", $open + 1);
        if ($open === false || $close === false) {
            return null;
        }

        return substr($content, $open + 1, $close - $open - 1);
    }

    private function stable(?string $commit = null): string
    {
        return $this->quoted($this->read(self::CONSTANTS, $commit), 'const APP_VERSION_STABLE') ?? $this->fail('APP_VERSION_STABLE not found in ' . self::CONSTANTS);
    }

    /**
     * The console tag pinned in docker-compose.yml, without the self-hosted suffix.
     */
    private function pinned(?string $commit = null): string
    {
        $marker = 'image: ' . self::CONSOLE_IMAGE . ':';
        foreach (explode("\n", $this->read(self::COMPOSE, $commit)) as $row) {
            $row = trim($row);
            if (str_starts_with($row, $marker) && str_ends_with($row, self::CONSOLE_SUFFIX)) {
                return substr($row, strlen($marker), -strlen(self::CONSOLE_SUFFIX));
            }
        }
        $this->fail('console image ' . self::CONSOLE_IMAGE . ' not found in ' . self::COMPOSE);
    }

    /**
     * The newest console release whose self-hosted image is on Docker Hub. The
     * image trails the GitHub release by a few minutes, so an older one may win.
     */
    private function latestConsole(): string
    {
        $tags = $this->sh('gh release list -R ' . self::CONSOLE_REPOSITORY . " --exclude-drafts --exclude-pre-releases --limit 10 --json tagName --jq '.[].tagName'");
        foreach (explode("\n", $tags) as $tag) {
            if ($tag !== '' && $this->published(self::CONSOLE_IMAGE, $tag . self::CONSOLE_SUFFIX)) {
                return $tag;
            }
        }
        $this->fail('none of the last 10 ' . self::CONSOLE_REPOSITORY . ' releases has a ' . self::CONSOLE_IMAGE . ' image with the ' . self::CONSOLE_SUFFIX . ' suffix');
    }

    private function published(string $image, string $tag): bool
    {
        $url = "https://hub.docker.com/v2/repositories/{$image}/tags/{$tag}";
        $status = $this->sh('curl --silent --output /dev/null --write-out "%{http_code}" --retry 3 --max-time 30 ' . escapeshellarg($url));

        return match ($status) {
            '200' => true,
            '404' => false,
            default => $this->fail("unexpected status {$status} from Docker Hub for {$image}:{$tag}"),
        };
    }

    /**
     * The migration class a version maps to in Migration::$versions, or null.
     */
    private function migration(string $version, ?string $commit = null): ?string
    {
        return $this->quoted($this->read(self::MIGRATION, $commit), "'{$version}' =>");
    }

    /**
     * Add $version to Migration::$versions, mapped to the same class as $previous.
     */
    private function map(string $version, string $previous): string
    {
        $class = $this->migration($previous) ?? $this->fail("{$previous} is not in Migration::\$versions");
        $content = $this->read(self::MIGRATION);
        $entry = "'{$previous}' => '{$class}',";
        $position = strpos($content, $entry) ?: $this->fail("cannot find the {$previous} entry in " . self::MIGRATION);
        $start = strrpos(substr($content, 0, $position), "\n") + 1;
        $end = strpos($content, "\n", $position);
        $indent = substr($content, $start, $position - $start);
        file_put_contents(self::MIGRATION, substr($content, 0, $end + 1) . "{$indent}'{$version}' => '{$class}',\n" . substr($content, $end + 1));

        return $class;
    }

    /**
     * Every `_APP_*` name that appears in the content.
     *
     * @return string[]
     */
    private function names(string $content): array
    {
        $names = [];
        $position = 0;
        while (($position = strpos($content, '_APP_', $position)) !== false) {
            $end = $position + strlen('_APP_');
            while ($end < strlen($content) && (ctype_upper($content[$end]) || ctype_digit($content[$end]) || $content[$end] === '_')) {
                $end++;
            }
            $names[substr($content, $position, $end - $position)] = true;
            $position = $end;
        }

        return array_keys($names);
    }

    /**
     * Variables defined in app/config/variables.php, mapped to their introduction.
     *
     * @return array<string, string>
     */
    private function definitions(?string $commit = null): array
    {
        $content = $this->read(self::VARIABLES, $commit);
        $definitions = [];
        $position = 0;
        while (($position = strpos($content, "'name' => '", $position)) !== false) {
            // Bound each lookup to this definition, so a missing introduction is
            // not read from the next variable.
            $next = strpos($content, "'name' => '", $position + 1);
            $definition = $next === false ? substr($content, $position) : substr($content, $position, $next - $position);
            $name = $this->quoted($definition, "'name' =>");
            $definitions[$name] = $this->quoted($definition, "'introduction' =>") ?? '';
            $position += strlen("'name' => '");
        }

        return $definitions;
    }

    /**
     * Variable definitions out of sync with docker-compose.yml since the previous
     * release: new compose variables without a definition, and new definitions
     * whose introduction is not this version.
     *
     * @return string[]
     */
    private function variables(string $version, ?string $commit = null): array
    {
        $previous = $this->previous($version);
        $definitions = $this->definitions($commit);
        $before = $this->definitions($previous);
        $problems = [];

        $added = array_diff($this->names($this->read(self::COMPOSE, $commit)), $this->names($this->read(self::COMPOSE, $previous)), self::INTERNAL);
        foreach ($added as $name) {
            if (!isset($definitions[$name])) {
                $problems[] = "{$name} was added to " . self::COMPOSE . " since {$previous} but has no definition in " . self::VARIABLES;
            }
        }

        foreach (array_diff_key($definitions, $before) as $name => $introduction) {
            if ($introduction !== $version) {
                $problems[] = "{$name} is new since {$previous}; set its introduction to {$version}, not '{$introduction}'";
            }
        }

        return $problems;
    }

    private function replace(string $path, string $search, string $replacement): int
    {
        $content = $this->read($path);
        $count = substr_count($content, $search);
        if ($count > 0) {
            file_put_contents($path, str_replace($search, $replacement, $content));
        }

        return $count;
    }

    /**
     * Every problem that stops $version from being released from $commit.
     *
     * @return string[]
     */
    private function problems(string $version, ?string $commit = null): array
    {
        $problems = [];

        if ($this->stable($commit) !== $version) {
            $problems[] = 'APP_VERSION_STABLE is ' . $this->stable($commit) . ", expected {$version}";
        }

        foreach (self::READMES as $readme) {
            $content = $this->read($readme, $commit);
            $total = substr_count($content, self::IMAGE . ':');
            $current = substr_count($content, self::IMAGE . ":{$version}");
            if ($current === 0 || $current !== $total) {
                $problems[] = "{$readme}: {$current} of {$total} install snippets use " . self::IMAGE . ":{$version}";
            }
        }

        if ($this->migration($version, $commit) === null) {
            $problems[] = "{$version} is not in Migration::\$versions";
        }

        [, , $patch] = $this->parse($version);
        if ($patch > 0) {
            $previous = $this->previous($version);
            $class = $this->migration($version, $commit);
            if ($class !== null && $class !== $this->migration($previous, $commit)) {
                $problems[] = "{$version} maps to {$class} but {$previous} maps to " . $this->migration($previous, $commit) . '; a patch never adds a migration';
            }
        }

        $console = $this->pinned($commit);
        if (!$this->published(self::CONSOLE_IMAGE, $console . self::CONSOLE_SUFFIX)) {
            $problems[] = 'console image ' . self::CONSOLE_IMAGE . ":{$console}" . self::CONSOLE_SUFFIX . ' is not on Docker Hub';
        }

        return $problems;
    }

    /**
     * GitHub handles credited in the generated notes (`* title by @handle in url`).
     *
     * @return string[]
     */
    private function contributors(string $generated): array
    {
        $handles = [];
        foreach (explode("\n", $generated) as $row) {
            $start = strpos($row, ' by @');
            $end = $start === false ? false : strpos($row, ' in ', $start);
            if ($start === false || $end === false) {
                continue;
            }
            // Co-authored rows read `by @one with @two`; credit the author.
            $handle = explode(' ', substr($row, $start + 4, $end - $start - 4))[0];
            if (!str_ends_with($handle, '[bot]')) {
                $handles[$handle] = true;
            }
        }

        return array_keys($handles);
    }

    /**
     * Release notes draft in the shape of the published 2.2.0 release, with
     * GitHub's generated PR list underneath. A person rewrites it before publishing.
     */
    private function notes(string $version, string $previous, string $target, string $console, string $previousConsole): string
    {
        $generated = $this->sh('gh api repos/' . self::REPOSITORY . '/releases/generate-notes'
            . ' -f tag_name=' . escapeshellarg($version)
            . ' -f target_commitish=' . escapeshellarg($target)
            . ' -f previous_tag_name=' . escapeshellarg($previous)
            . " --jq '.body'");
        $credits = implode(' ', $this->contributors($generated));
        $image = self::IMAGE;

        return <<<MARKDOWN
        <!-- Draft from bin/release. Rewrite into the sections below, then delete the Generated list. -->

        Appwrite {$version} … It ships with the {$console} self-hosted Console (was {$previousConsole}). Upgrading from {$previous} …

        ### Highlights

        ### Fixes

        ### Under the hood

        ### Removed

        ### Install

        ```bash
        docker run -it --rm \\
            --volume /var/run/docker.sock:/var/run/docker.sock \\
            --volume "$(pwd)"/appwrite:/usr/src/code/appwrite:rw \\
            --entrypoint="install" \\
            {$image}:{$version}
        ```

        ### Upgrade

        Upgrading from {$previous} uses the same command with `--entrypoint="upgrade"`, then run the migration:

        ```bash
        cd appwrite
        docker compose exec appwrite migrate
        ```

        **Back up your data first.**

        ### Contributors

        Thank you to everyone who contributed to {$version}:

        {$credits}

        ## Generated

        {$generated}

        MARKDOWN;
    }

    private function confirm(string $question, string $expected): void
    {
        fwrite(STDOUT, "{$question} Type \"{$expected}\" to continue: ");
        if (trim((string) fgets(STDIN)) !== $expected) {
            $this->fail('aborted');
        }
    }
}

(new Release())->run($argv);
