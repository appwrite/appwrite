#!/usr/bin/env php
<?php

/**
 * Package tooling for the Utopia libraries in packages/<name> and the Rust
 * crates in crates/utopia/<name> (plus crates/support/php-std).
 *
 * PHP packages are loaded through the root composer.json autoload and
 * distributed (read-only) to github.com/utopia-php/<name>. Rust crates are
 * workspace members here and distributed (read-only) to
 * github.com/utopia-rs/<name>. Releases are made by tagging this repository
 * `<name>/<version>` (PHP) or `rs/<name>/<version>` (Rust), which pushes
 * `<version>` to the mirror. See rfc/monorepo.md and rfc/rust.md.
 */

chdir(dirname(__DIR__));

const ORG = 'utopia-php';
const CRATES_ORG = 'utopia-rs';
const REPOSITORY = 'appwrite/appwrite';
const SPLIT_APP_ID = 4016286; // GitHub App that pushes PHP splits to utopia-php
const CRATES_SPLIT_APP_ID = 5319328; // GitHub App that pushes crate splits to utopia-rs
const HOISTED = ['laravel/pint', 'phpstan/phpstan', 'rector/rector', 'phpunit/phpunit'];
const BANNED = ['pint.json', 'psalm.xml', 'phpcs.xml', '.travis.yml', '.gitpod.yml', '.coderabbit.yaml'];

/**
 * Packages that still declare the bare `Utopia\` prefix because a class lives
 * at its root, mapped to the namespace segment the rest of their classes and
 * their tests use. Step B (rfc/monorepo.md, phase 6) renames those classes and
 * removes the package from this list; `validators` and `console` have, so it
 * is empty and `validate` rejects the bare prefix for every package.
 */
const BARE = [];

/**
 * Packages whose namespace segment does not spell the package name: namespaces
 * are singular (`Utopia\Validator\Text`) where a package name may be plural.
 */
const SEGMENTS = ['validators' => 'Validator'];

/**
 * Dockerfiles a package's docker-compose.yml builds from. Those belong to the
 * e2e tier and stay; every other Dockerfile is CI tooling the root replaces.
 */
function compose_dockerfiles(string $directory): array
{
    $compose = "{$directory}/docker-compose.yml";
    if (!is_file($compose)) {
        return [];
    }
    $files = [];
    foreach (file($compose) as $line) {
        $line = trim($line);
        foreach (['dockerfile:', 'build:'] as $key) {
            if (!str_starts_with($line, $key)) {
                continue;
            }
            $value = trim(substr($line, strlen($key)), " \t\"'");
            if ($value !== '' && $value !== '.' && !str_contains($value, '/')) {
                $files[] = $value;
            }
        }
    }
    return $files;
}

function out(string $message): void
{
    fwrite(STDOUT, $message . PHP_EOL);
}

function fail(string $message): never
{
    fwrite(STDERR, 'error: ' . $message . PHP_EOL);
    exit(1);
}

/**
 * Run a command, return its stdout. Stderr streams through to the terminal.
 */
function sh(string $command): string
{
    exec($command, $output, $code);
    if ($code !== 0) {
        fail("command failed ({$code}): {$command}");
    }

    return trim(implode(PHP_EOL, $output));
}

function rm(string $path): void
{
    if (is_file($path) || is_link($path)) {
        unlink($path);

        return;
    }

    foreach (array_diff(scandir($path) ?: [], ['.', '..']) as $entry) {
        rm("{$path}/{$entry}");
    }
    rmdir($path);
}

/**
 * @return string[]
 */
function packages(): array
{
    // A directory is a package only if it carries a manifest: ignored leftovers
    // (a vendor/ from another branch's test run) must not count.
    return array_map(fn (string $manifest) => basename(dirname($manifest)), glob('packages/*/composer.json'));
}

/**
 * Distribution remote for a package. CI overrides the base with an
 * authenticated HTTPS URL via SPLIT_REMOTE_BASE.
 */
function remote(string $package): string
{
    $base = getenv('SPLIT_REMOTE_BASE') ?: 'git@github.com:' . ORG;

    return $base . '/' . $package . '.git';
}

function import_package(string $package, ?string $url, ?string $branch): void
{
    $url ??= 'https://github.com/' . ORG . "/{$package}.git";
    if (is_dir("packages/{$package}")) {
        fail("packages/{$package} already exists");
    }

    if ($branch === null) {
        preg_match('#refs/heads/(\S+)#', sh("git ls-remote --symref {$url} HEAD | head -n 1"), $match)
            || fail("cannot detect default branch of {$url}");
        $branch = $match[1];
    }

    out("importing {$package} from {$url} ({$branch})...");
    sh("git subtree add --prefix=packages/{$package} {$url} {$branch}");
    out("imported {$package}");
}

function mirror_workflow(string $package): string
{
    $yaml = <<<'YAML'
    name: Mirror

    on:
      pull_request_target:
        types: [opened]
      issues:
        types: [opened]

    permissions:
      issues: write
      pull-requests: write

    jobs:
      redirect:
        uses: {repository}/.github/workflows/mirror-redirect.yml@main
        with:
          package: {package}
    YAML;

    return str_replace(['{repository}', '{package}'], [REPOSITORY, $package], $yaml) . "\n";
}

/**
 * Ensure the root toolchain (pint, phpstan, rector, phpunit) is installed and
 * on PATH, so package scripts resolve `phpunit` to the root version.
 */
function toolchain(): void
{
    if (!is_file('vendor/bin/phpunit')) {
        passthru('composer install --no-interaction --prefer-dist --no-progress --ignore-platform-reqs', $code);
        $code === 0 || fail('failed to install the root toolchain');
    }
    putenv('PATH=' . getcwd() . '/vendor/bin:' . getenv('PATH'));
}

/**
 * Release notes for a package version: every commit that touched the package
 * since its previous release tag, plus a compare link.
 */
function release_notes(string $package, string $version, string $to): string
{
    $previous = null;
    $tags = sh("git -c versionsort.suffix=- tag --list '{$package}/*' --sort=-v:refname");
    foreach (explode("\n", $tags) as $tag) {
        $candidate = substr($tag, strlen($package) + 1);
        if ($candidate !== '' && version_compare($candidate, $version, '<')) {
            $previous = $tag;
            break;
        }
    }

    $home = 'https://github.com/' . REPOSITORY;
    if ($previous === null) {
        return "First release cut from [`packages/{$package}`]({$home}/tree/main/packages/{$package}) in " . REPOSITORY . '.';
    }

    $log = sh("git log {$previous}..{$to} --pretty='- %s' -- packages/{$package}");

    return ($log !== '' ? $log : '- No changes to this package since ' . $previous . '.')
        . "\n\n**Changes**: {$home}/compare/{$previous}...{$package}/{$version}";
}

/**
 * Compute a prefix's split head: starting from the latest subtree annotation
 * (an import or rejoin merge), or from the repository root when there is none,
 * re-synthesize one commit per mainline commit that changed the prefix,
 * copying tree, author, committer and raw message. Deterministic, and
 * byte-identical to `git subtree split` output when $transform is null —
 * without its fatal cache collision when a package is re-imported.
 *
 * $transform($commit, $prefix, $tree) may rewrite the tree (Rust crates expand
 * workspace inheritance so the mirror builds standalone).
 */
function split_tree(string $prefix, ?callable $transform = null): string
{
    // With an annotation present, resume from it; without one — a hand-created
    // package, or one whose import merge a squash-merge flattened — synthesize
    // from the repository root, the first commit landing parentless.
    $join = sh('git log --format=%H --grep=' . escapeshellarg("^git-subtree-dir: {$prefix}\$") . ' -1 HEAD');
    $tip = null;
    $range = 'HEAD';
    if ($join !== '') {
        $body = sh("git log --format=%B -1 {$join}");
        preg_match('/^git-subtree-mainline: (\w+)$/m', $body, $mainline) || fail("no git-subtree-mainline in {$join}");
        preg_match('/^git-subtree-split: (\w+)$/m', $body, $split) || fail("no git-subtree-split in {$join}");
        $tip = $split[1];
        $range = "{$mainline[1]}..HEAD";
    }

    $commits = sh("git log --reverse --first-parent --format=%H {$range} -- {$prefix}");
    foreach (array_filter(explode("\n", $commits)) as $commit) {
        unset($tree);
        exec("git rev-parse -q --verify {$commit}:{$prefix} 2>/dev/null", $tree, $missing);
        if ($missing !== 0) {
            continue;
        }
        $treeSha = $transform === null ? $tree[0] : $transform($commit, $prefix, $tree[0]);
        if ($tip !== null && $treeSha === sh("git rev-parse {$tip}^{tree}")) {
            continue;
        }
        $identity = explode("\x1f", sh("git log -1 --format=%an%x1f%ae%x1f%aD%x1f%cn%x1f%ce%x1f%cD {$commit}"));
        $environment = '';
        foreach (['GIT_AUTHOR_NAME', 'GIT_AUTHOR_EMAIL', 'GIT_AUTHOR_DATE', 'GIT_COMMITTER_NAME', 'GIT_COMMITTER_EMAIL', 'GIT_COMMITTER_DATE'] as $index => $variable) {
            $environment .= $variable . '=' . escapeshellarg($identity[$index]) . ' ';
        }
        $parent = $tip === null ? '' : "-p {$tip}";
        $tip = sh("git log -1 --pretty=format:%B {$commit} | {$environment}git commit-tree {$treeSha} {$parent}");
    }

    $tip !== null || fail("{$prefix} has no commits to split");

    return $tip;
}

function split_package(string $package): string
{
    return split_tree("packages/{$package}");
}

function manifest(string $package): ?array
{
    $path = 'packages/' . $package . '/composer.json';
    if (!is_file($path)) {
        return null;
    }
    $manifest = json_decode(file_get_contents($path), true);

    return is_array($manifest) ? $manifest : null;
}

/**
 * The namespace segment a package's manifest declares (`Utopia\<Ns>\` => src),
 * or null when the main autoload does not have the standard shape. A package
 * in BARE declares `Utopia\` instead and takes its segment from that list.
 */
function namespace_of(?array $manifest): ?string
{
    $psr4 = $manifest['autoload']['psr-4'] ?? null;
    if (!is_array($psr4) || count($psr4) !== 1) {
        return null;
    }
    $prefix = array_key_first($psr4);
    if ($prefix === 'Utopia\\') {
        return BARE[substr($manifest['name'] ?? '', strlen(ORG) + 1)] ?? null;
    }
    $segments = explode('\\', $prefix);
    if (count($segments) !== 3 || $segments[0] !== 'Utopia' || $segments[1] === '' || $segments[2] !== '') {
        return null;
    }

    return $segments[1];
}

/**
 * Classes under packages/ that more than one PSR-4 directory can load, mapped
 * to every file that declares them. Composer probes a shared prefix's
 * directories in order and stops at the first hit, so a duplicate silently
 * shadows the other copy. Checked against the root map and, once installed,
 * every vendored package (which is where the bare `Utopia\` prefix is shared).
 */
function duplicate_classes(array $root): array
{
    $mappings = [];
    foreach (['autoload', 'autoload-dev'] as $section) {
        foreach ($root[$section]['psr-4'] ?? [] as $prefix => $paths) {
            foreach ((array) $paths as $path) {
                $mappings[] = [$prefix, rtrim($path, '/')];
            }
        }
    }
    $installed = is_file('vendor/composer/installed.json') ? json_decode(file_get_contents('vendor/composer/installed.json'), true) : [];
    foreach ($installed['packages'] ?? [] as $dependency) {
        // install-path is relative to vendor/composer/
        $path = $dependency['install-path'] ?? '../' . $dependency['name'];
        $base = str_starts_with($path, '../') ? 'vendor/' . substr($path, 3) : "vendor/composer/{$path}";
        foreach ($dependency['autoload']['psr-4'] ?? [] as $prefix => $paths) {
            foreach ((array) $paths as $path) {
                $mappings[] = [$prefix, rtrim("{$base}/{$path}", '/')];
            }
        }
    }

    $duplicates = [];
    foreach ($mappings as [$prefix, $path]) {
        if (!str_starts_with($path, 'packages/') || !is_dir($path)) {
            continue;
        }
        $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS));
        foreach ($files as $file) {
            if ($file->getExtension() !== 'php') {
                continue;
            }
            $class = $prefix . str_replace('/', '\\', substr($file->getPathname(), strlen($path) + 1, -4));
            $locations = [];
            foreach ($mappings as [$other, $directory]) {
                $candidate = $directory . '/' . str_replace('\\', '/', substr($class, strlen($other))) . '.php';
                if (str_starts_with($class, $other) && is_file($candidate)) {
                    $locations[] = $candidate;
                }
            }
            if (count($locations) > 1) {
                $duplicates[$class] = $locations;
            }
        }
    }

    return $duplicates;
}

/**
 * The root composer.json with one autoload line per package, regenerated
 * from the package manifests. Decoded as objects so an unchanged file
 * round-trips byte for byte (`"platform": {}` stays an object).
 */
function root_manifest(): string
{
    $root = json_decode(file_get_contents('composer.json'));
    foreach ([['autoload', 'src', ''], ['autoload-dev', 'tests', 'Tests\\']] as [$section, $directory, $suffix]) {
        $map = $root->{$section}->{'psr-4'};
        $entries = [];
        foreach ($map as $prefix => $path) {
            $kept = array_values(array_filter((array) $path, fn (string $entry) => !str_starts_with($entry, 'packages/')));
            if ($kept !== []) {
                $entries[$prefix] = is_array($path) ? $kept : $kept[0];
            }
        }
        foreach (packages() as $package) {
            $manifest = manifest($package);
            $namespace = namespace_of($manifest);
            if ($namespace === null) {
                continue;
            }
            $prefix = $suffix === '' ? array_key_first($manifest['autoload']['psr-4']) : "Utopia\\{$namespace}\\{$suffix}";
            if ($prefix === 'Utopia\\') {
                // several packages share the bare prefix, so it maps to a list
                $entries[$prefix] = [...(array) ($entries[$prefix] ?? []), "packages/{$package}/{$directory}"];
            } else {
                $entries[$prefix] = "packages/{$package}/{$directory}";
            }
        }
        // the shared bare prefix probes its directory list last
        if (isset($entries['Utopia\\'])) {
            $entries['Utopia\\'] = array_splice($entries, array_search('Utopia\\', array_keys($entries), true), 1)['Utopia\\'];
        }
        $root->{$section}->{'psr-4'} = (object) $entries;
    }

    // Packages here are not installed by Composer, so a package's `files`
    // (such as a class_alias shim for renamed classes) load only through the
    // root autoload.
    $files = array_values(array_filter((array) ($root->autoload->files ?? []), fn (string $file) => !str_starts_with($file, 'packages/')));
    foreach (packages() as $package) {
        foreach (manifest($package)['autoload']['files'] ?? [] as $file) {
            $files[] = "packages/{$package}/{$file}";
        }
    }
    if ($files !== []) {
        $root->autoload->files = $files;
    } else {
        unset($root->autoload->files);
    }

    // Composer must not install a package this repository provides, even when
    // another vendored package requires it: `replace` tells the solver the
    // root satisfies that requirement and the vendored copy is skipped.
    $replace = [];
    foreach ((array) ($root->replace ?? []) as $name => $constraint) {
        if (!str_starts_with($name, ORG . '/') || !in_array(substr($name, strlen(ORG) + 1), packages(), true)) {
            $replace[$name] = $constraint;
        }
    }
    foreach (packages() as $package) {
        $replace[ORG . "/{$package}"] = '*';
    }
    $root->replace = (object) $replace;

    return json_encode($root, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
}

/**
 * Local siblings in a package's dependency graph, mapped to a version that
 * satisfies the requiring constraint (e.g. "^0.20" → "0.20.999"), so a path
 * repository can stand in for Packagist during linked test runs.
 *
 * @return array<string, string>
 */
function linked_versions(string $package): array
{
    $versions = [];
    $pending = [$package];
    $seen = [$package => true];
    while ($pending !== []) {
        $current = array_shift($pending);
        $manifest = manifest($current);
        // composer installs the root package's dev dependencies too, and the
        // path repository shadows them on Packagist
        $requirements = ($manifest['require'] ?? [])
            + ($current === $package ? $manifest['require-dev'] ?? [] : []);
        foreach ($requirements as $dependency => $constraint) {
            if (!str_starts_with($dependency, ORG . '/')) {
                continue;
            }
            $sibling = substr($dependency, strlen(ORG) + 1);
            if (!is_dir("packages/{$sibling}")) {
                continue;
            }

            // A cycle back to the package under test is satisfied by telling
            // Composer which release line the root checkout represents.
            if ($sibling === $package) {
                $versions[$dependency] ??= linked_version($constraint);

                continue;
            }

            if (isset($seen[$sibling])) {
                continue;
            }

            $seen[$sibling] = true;
            $versions[$dependency] = linked_version($constraint);
            $pending[] = $sibling;
        }
    }

    return $versions;
}

/**
 * Composer environment for installing a package on its own. When a sibling
 * requires the package back (span and client require each other), the
 * checkout has to claim a release line or the solver rejects the cycle.
 */
/**
 * Resolve a package's dependencies in its own directory and return the
 * environment prefix later commands in that directory need. With $linked,
 * siblings come from the local checkout instead of Packagist, via a generated
 * manifest (COMPOSER env) with a path repository claiming constraint-
 * satisfying versions, so a package can depend on a sibling's unreleased
 * change. --ignore-platform-reqs: CI installs each package's declared
 * extensions, and exotic transitive ones (e.g. ext-opentelemetry) must not
 * block resolution.
 *
 * @return array{int, string} the composer exit code and the environment prefix
 */
function install(string $package, bool $linked): array
{
    $directory = "packages/{$package}";
    $environment = root_environment($package);
    if ($linked) {
        $versions = linked_versions($package);
        $rootVersion = $versions[ORG . "/{$package}"] ?? null;
        unset($versions[ORG . "/{$package}"]);
        if ($versions === []) {
            out('no local siblings to link; running registry-resolved');
        } else {
            $manifest = manifest($package);
            $manifest['repositories'] = array_merge([[
                'type' => 'path',
                'url' => '../*',
                'only' => array_keys($versions),
                'options' => ['symlink' => false, 'versions' => $versions],
            ]], $manifest['repositories'] ?? []);
            file_put_contents("{$directory}/composer.linked.json", json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
            // A path package's reference is the checkout's commit, so Composer
            // keeps an installed copy through uncommitted edits. Drop the lock
            // and the copies so every linked run installs the working tree.
            @unlink("{$directory}/composer.linked.lock");
            foreach (array_keys($versions) as $sibling) {
                if (is_dir("{$directory}/vendor/{$sibling}")) {
                    rm("{$directory}/vendor/{$sibling}");
                }
            }
            $environment = ($rootVersion === null ? '' : "COMPOSER_ROOT_VERSION={$rootVersion} ")
                . 'COMPOSER=composer.linked.json ';
            out('linked: ' . implode(', ', array_keys($versions)));
        }
    }

    passthru("cd {$directory} && {$environment}composer update --no-interaction --prefer-dist --no-progress --ignore-platform-reqs", $code);

    // A registry dependency can require another release line of a linked
    // sibling (utopia-php/database 8 from Packagist wants validators ^1 while
    // the checkout is 2.x): no linked combination installs, so the package
    // is checked as a release would install it, registry-resolved.
    if ($code !== 0 && $linked && str_contains($environment, 'COMPOSER=composer.linked.json')) {
        out('the linked siblings cannot install together with the registry packages; running registry-resolved');
        $environment = root_environment($package);
        passthru("cd {$directory} && {$environment}composer update --no-interaction --prefer-dist --no-progress --ignore-platform-reqs", $code);
    }

    return [$code, $environment];
}

function root_environment(string $package): string
{
    $version = linked_versions($package)[ORG . "/{$package}"] ?? null;

    return $version === null ? '' : "COMPOSER_ROOT_VERSION={$version} ";
}

/**
 * Pick the newest release line named by a constraint and reserve its .999
 * patch for the linked checkout (e.g. "^0.1 || ^0.3" → "0.3.999").
 */
function linked_version(string $constraint): string
{
    preg_match_all('/\d+(?:\.\d+)*/', $constraint, $matches);
    $candidates = $matches[0];
    $candidates !== [] || fail("cannot infer a linked version from constraint: {$constraint}");
    usort($candidates, 'version_compare');
    $parts = explode('.', end($candidates));

    return $parts[0] . '.' . ($parts[1] ?? '0') . '.999';
}

/**
 * Rust crates mirrored to github.com/utopia-rs/<name>: every crates/utopia/*
 * member, plus php-std (crates/support/php-std). Appwrite and tool crates stay
 * in this repository only.
 *
 * @return string[]
 */
function crates(): array
{
    static $names;
    if (is_array($names)) {
        return $names;
    }
    $names = array_map(fn (string $manifest) => basename(dirname($manifest)), glob('crates/utopia/*/Cargo.toml') ?: []);
    if (is_file('crates/support/php-std/Cargo.toml')) {
        $names[] = 'php-std';
    }
    sort($names);

    return $names;
}

function crate_prefix(string $package): string
{
    return $package === 'php-std' ? 'crates/support/php-std' : "crates/utopia/{$package}";
}

function crate_package_name(string $package): string
{
    return $package === 'php-std' ? 'php-std' : "utopia-{$package}";
}

function crate_repo_of_dep(string $name): ?string
{
    if ($name === 'php-std') {
        return 'php-std';
    }
    if (str_starts_with($name, 'utopia-')) {
        $package = substr($name, strlen('utopia-'));

        return in_array($package, crates(), true) ? $package : null;
    }

    return null;
}

function crate_remote(string $package): string
{
    $base = getenv('SPLIT_CRATES_REMOTE_BASE') ?: 'git@github.com:' . CRATES_ORG;

    return $base . '/' . $package . '.git';
}

function crate_title(string $package): string
{
    if ($package === 'openapi') {
        return 'Utopia OpenAPI';
    }
    if ($package === 'psr7') {
        return 'Utopia PSR-7';
    }
    if ($package === 'php-std') {
        return 'PHP standard library';
    }
    $upper = ['http', 'dns', 'dsn', 'cdn', 'cli', 'smtp', 'mqtt', 'nats', 'vcs', 'di'];
    if (in_array($package, $upper, true)) {
        return 'Utopia ' . strtoupper($package);
    }

    return 'Utopia ' . ucwords(str_replace('-', ' ', $package));
}

function crate_mirror_workflow(string $package): string
{
    $yaml = <<<'YAML'
    name: Mirror

    on:
      pull_request_target:
        types: [opened]
      issues:
        types: [opened]

    permissions:
      issues: write
      pull-requests: write

    jobs:
      redirect:
        uses: {repository}/.github/workflows/mirror-redirect.yml@main
        with:
          package: {package}
          path: {path}
    YAML;

    return str_replace(
        ['{repository}', '{package}', '{path}'],
        [REPOSITORY, $package, crate_prefix($package)],
        $yaml
    ) . "\n";
}

function crate_readme(string $package, string $description): string
{
    $title = crate_title($package);
    $home = 'https://github.com/' . REPOSITORY;
    $prefix = crate_prefix($package);
    $crate = crate_package_name($package);
    $org = CRATES_ORG;
    $repo = REPOSITORY;
    $dep = $crate . ' = { git = "https://github.com/' . $org . '/' . $package . '" }';
    $guidePath = "{$prefix}/guide.md";
    $guide = is_file($guidePath) ? crate_guide_for_readme(file_get_contents($guidePath)) : '';

    $parts = [
        "# {$title}",
        '',
        '> [!IMPORTANT]',
        "> This repository is a read-only mirror of [`{$prefix}`]({$home}/tree/main/{$prefix}) in [{$repo}]({$home}). Development happens there — please open issues and pull requests against {$repo}.",
        '',
        '[![Discord](https://img.shields.io/discord/564160730845151244?label=discord)](https://discord.gg/GSeTUeA)',
        '',
        $description,
        '',
        'This library is maintained by the [Appwrite team](https://appwrite.io).',
        '',
        '## Getting started',
        '',
        '```toml',
        '[dependencies]',
        $dep,
        '```',
    ];
    if ($guide !== '') {
        $parts[] = '';
        $parts[] = $guide;
    }
    $parts[] = '';
    $parts[] = '## License';
    $parts[] = '';
    $parts[] = 'BSD-3-Clause. See [LICENSE](LICENSE).';

    return implode("\n", $parts);
}

/**
 * The crate's getting-started guide as it reads on GitHub: Rust examples only,
 * rustdoc hidden lines stripped, PHP twin blocks and PHP-named sections left out
 * (the same view `apps/crates` shows outside migration mode).
 */
function crate_guide_for_readme(string $guide): string
{
    $guide = str_replace(["\r\n", "\r"], "\n", $guide);
    $out = [];
    $fence = null;
    $skipLevel = 0;
    $skipPhpPara = false;
    $paragraphStart = true;
    foreach (explode("\n", $guide) as $line) {
        $trim = ltrim($line);
        if ($fence !== null) {
            if (str_starts_with($trim, '```')) {
                if ($fence !== 'php' && $skipLevel === 0) {
                    $out[] = '```';
                }
                $fence = null;
                $paragraphStart = true;
                continue;
            }
            if ($skipLevel !== 0 || $fence === 'php') {
                continue;
            }
            if ($fence === 'rust') {
                $shown = crate_rustdoc_shown_line($line);
                if ($shown !== null) {
                    $out[] = $shown;
                }
                continue;
            }
            $out[] = $line;
            continue;
        }
        if (str_starts_with($trim, '```')) {
            $kind = crate_fence_kind(trim(substr($trim, 3)));
            $fence = $kind;
            if ($skipLevel === 0 && $kind !== 'php') {
                $out[] = $kind === 'rust' ? '```rust' : $line;
            }
            continue;
        }
        $level = crate_heading_level($line);
        if ($level > 0) {
            if ($skipLevel !== 0 && $level <= $skipLevel) {
                $skipLevel = 0;
            }
            if ($skipLevel === 0 && str_contains($line, 'PHP')) {
                $skipLevel = $level;
            }
        }
        if ($skipLevel !== 0) {
            continue;
        }
        if ($skipPhpPara) {
            if (trim($line) === '') {
                $skipPhpPara = false;
                $paragraphStart = true;
                $out[] = '';
            }
            continue;
        }
        if ($paragraphStart && str_starts_with($trim, 'PHP:')) {
            $skipPhpPara = true;
            continue;
        }
        if (trim($line) === '') {
            $paragraphStart = true;
            $out[] = '';
            continue;
        }
        $paragraphStart = false;
        $out[] = crate_rustdoc_links($line);
    }

    return crate_squeeze_blanks(implode("\n", $out));
}

function crate_heading_level(string $line): int
{
    $n = 0;
    $length = strlen($line);
    while ($n < $length && $line[$n] === '#') {
        $n++;
    }
    if ($n === 0 || $n === $length || $line[$n] !== ' ') {
        return 0;
    }

    return $n;
}

function crate_fence_kind(string $tag): string
{
    $attrs = [];
    foreach (explode(',', $tag) as $part) {
        $part = trim($part);
        if ($part !== '') {
            $attrs[] = $part;
        }
    }
    foreach ($attrs as $attr) {
        if ($attr === 'php') {
            return 'php';
        }
    }
    foreach ($attrs as $attr) {
        if ($attr === 'ignore' || $attr === 'compile_fail' || $attr === 'text') {
            return 'other';
        }
    }
    $rustdoc = ['rust', 'no_run', 'should_panic', 'edition2018', 'edition2021', 'edition2024'];
    foreach ($attrs as $attr) {
        if (!in_array($attr, $rustdoc, true)) {
            return 'other';
        }
    }

    return 'rust';
}

function crate_rustdoc_shown_line(string $line): ?string
{
    $trim = ltrim($line);
    $indent = substr($line, 0, strlen($line) - strlen($trim));
    if ($trim === '#') {
        return null;
    }
    if (str_starts_with($trim, '# ')) {
        return null;
    }
    if (str_starts_with($trim, '##')) {
        return $indent . '#' . substr($trim, 1);
    }

    return $line;
}

function crate_rustdoc_links(string $line): string
{
    $out = '';
    $rest = $line;
    while (true) {
        $start = strpos($rest, '[`');
        if ($start === false) {
            return $out . $rest;
        }
        $out .= substr($rest, 0, $start);
        $rest = substr($rest, $start);
        $end = strpos($rest, '`]');
        if ($end === false) {
            return $out . $rest;
        }
        $inner = substr($rest, 2, $end - 2);
        $after = substr($rest, $end + 2);
        if (str_starts_with($after, '(')) {
            $out .= '[`' . $inner . '`]';
            $rest = $after;
            continue;
        }
        $out .= '`' . $inner . '`';
        $rest = $after;
    }
}

function crate_squeeze_blanks(string $text): string
{
    $out = [];
    $blank = 0;
    foreach (explode("\n", trim($text)) as $line) {
        if (trim($line) === '') {
            $blank++;
            if ($blank === 1) {
                $out[] = '';
            }
            continue;
        }
        $blank = 0;
        $out[] = $line;
    }

    return implode("\n", $out);
}

function crate_description(string $package): string
{
    $toml = file_get_contents(crate_prefix($package) . '/Cargo.toml') ?: '';
    if (preg_match('/^description\s*=\s*"(.*)"/m', $toml, $match) !== 1) {
        return crate_title($package) . ' library.';
    }

    return str_replace('\\"', '"', $match[1]);
}

/**
 * Comma-split that ignores commas inside quotes and brackets.
 *
 * @return string[]
 */
function toml_split_commas(string $value): array
{
    $parts = [];
    $current = '';
    $depth = 0;
    $quote = false;
    $length = strlen($value);
    for ($i = 0; $i < $length; $i++) {
        $char = $value[$i];
        if ($char === '"' && ($i === 0 || $value[$i - 1] !== '\\')) {
            $quote = !$quote;
        } elseif (!$quote) {
            if ($char === '[') {
                $depth++;
            } elseif ($char === ']' && $depth > 0) {
                $depth--;
            } elseif ($char === ',' && $depth === 0) {
                $parts[] = $current;
                $current = '';
                continue;
            }
        }
        $current .= $char;
    }
    if ($current !== '') {
        $parts[] = $current;
    }

    return $parts;
}

function parse_toml_value(string $value): mixed
{
    $value = trim($value);
    if ($value === 'true') {
        return true;
    }
    if ($value === 'false') {
        return false;
    }
    if ($value !== '' && $value[0] === '"') {
        return stripcslashes(substr($value, 1, -1));
    }
    if ($value !== '' && $value[0] === '[') {
        $inner = trim(substr($value, 1, -1));
        if ($inner === '') {
            return [];
        }

        return array_map('parse_toml_value', toml_split_commas($inner));
    }
    if ($value !== '' && $value[0] === '{') {
        return parse_inline_table($value);
    }

    return $value;
}

function parse_inline_table(string $value): array
{
    $value = trim($value);
    $inner = trim(substr($value, 1, -1));
    $result = [];
    foreach (toml_split_commas($inner) as $pair) {
        $pair = trim($pair);
        if ($pair === '') {
            continue;
        }
        [$key, $raw] = array_map('trim', explode('=', $pair, 2));
        $result[$key] = parse_toml_value($raw);
    }

    return $result;
}

function format_toml_value(mixed $value): string
{
    if (is_bool($value)) {
        return $value ? 'true' : 'false';
    }
    if (is_array($value)) {
        if (array_is_list($value)) {
            return '[' . implode(', ', array_map('format_toml_value', $value)) . ']';
        }

        return format_inline_table($value);
    }

    return '"' . str_replace(['\\', '"'], ['\\\\', '\\"'], (string) $value) . '"';
}

function format_inline_table(array $table): string
{
    $order = ['version', 'git', 'optional', 'default-features', 'features'];
    $keys = array_merge(array_intersect($order, array_keys($table)), array_diff(array_keys($table), $order));
    $parts = [];
    foreach ($keys as $key) {
        $parts[] = $key . ' = ' . format_toml_value($table[$key]);
    }

    return '{ ' . implode(', ', $parts) . ' }';
}

/**
 * @return array{package: array<string, string>, dependencies: array<string, mixed>}
 */
function parse_workspace_toml(string $toml): array
{
    $package = [];
    $dependencies = [];
    $section = null;
    foreach (explode("\n", $toml) as $line) {
        $trimmed = trim($line);
        if ($trimmed === '' || str_starts_with($trimmed, '#')) {
            continue;
        }
        if (str_starts_with($trimmed, '[')) {
            $section = trim($trimmed, '[]');
            continue;
        }
        if (!str_contains($trimmed, '=')) {
            continue;
        }
        [$key, $raw] = array_map('trim', explode('=', $trimmed, 2));
        if ($section === 'workspace.package' && in_array($key, ['version', 'edition', 'rust-version', 'license'], true)) {
            $package[$key] = parse_toml_value($raw);
        } elseif ($section === 'workspace.metadata.utopia' && $key === 'mirror-license') {
            $package['mirror-license'] = parse_toml_value($raw);
        } elseif ($section === 'workspace.dependencies') {
            $dependencies[$key] = parse_toml_value($raw);
        }
    }

    return ['package' => $package, 'dependencies' => $dependencies];
}

function expand_workspace_dep(string $name, array $overrides, array $workspace, string $crateVersion): string
{
    unset($overrides['workspace']);
    if (!array_key_exists($name, $workspace['dependencies'])) {
        fail("workspace.dependencies has no {$name}");
    }
    $base = $workspace['dependencies'][$name];
    $repo = crate_repo_of_dep($name);
    if ($repo !== null) {
        $merged = ['version' => $crateVersion, 'git' => 'https://github.com/' . CRATES_ORG . '/' . $repo];
        if (is_array($base) && !array_is_list($base)) {
            foreach ($base as $key => $value) {
                if ($key !== 'path') {
                    $merged[$key] = $value;
                }
            }
        }
        if (isset($overrides['features'], $merged['features']) && is_array($overrides['features']) && is_array($merged['features'])) {
            $merged['features'] = array_values(array_unique([...$merged['features'], ...$overrides['features']]));
            unset($overrides['features']);
        }
        $merged = array_merge($merged, $overrides);

        return format_inline_table($merged);
    }

    if (is_string($base)) {
        if ($overrides === []) {
            return format_toml_value($base);
        }

        return format_inline_table(array_merge(['version' => $base], $overrides));
    }

    $merged = $base;
    unset($merged['path']);
    if (isset($overrides['features'], $merged['features']) && is_array($overrides['features']) && is_array($merged['features'])) {
        $merged['features'] = array_values(array_unique([...$merged['features'], ...$overrides['features']]));
        unset($overrides['features']);
    }
    $merged = array_merge($merged, $overrides);

    return count($merged) === 1 && isset($merged['version'])
        ? format_toml_value($merged['version'])
        : format_inline_table($merged);
}

/**
 * Expand workspace inheritance in a crate Cargo.toml so the mirror builds
 * without this repository's workspace. Sibling Utopia crates become git
 * dependencies on github.com/utopia-rs/<name>.
 */
function materialize_cargo_toml(string $toml, string $workspaceToml, string $package, ?string $expected = null): string
{
    $workspace = parse_workspace_toml($workspaceToml);
    $crateVersion = $workspace['package']['version'] ?? '0.1.0';
    $expected ??= crate_package_name($package);
    $lines = explode("\n", $toml);
    $out = [];
    $dotted = null;
    foreach ($lines as $line) {
        $trimmed = trim($line);
        if ($dotted !== null) {
            if ($trimmed === '' || str_starts_with($trimmed, '[') || str_starts_with($trimmed, '#')) {
                $dotted = null;
            } elseif (preg_match('/^workspace\s*=\s*true\s*$/', $trimmed) === 1) {
                $indent = substr($line, 0, strlen($line) - strlen(ltrim($line)));
                $expanded = expand_workspace_dep($dotted, [], $workspace, $crateVersion);
                if (str_starts_with($expanded, '{')) {
                    $table = parse_inline_table($expanded);
                    foreach ($table as $key => $value) {
                        $out[] = $indent . $key . ' = ' . format_toml_value($value);
                    }
                } else {
                    $out[] = $indent . 'version = ' . $expanded;
                }
                continue;
            }
        }
        if (preg_match('/^\[(?:dev-|build-)?dependencies\.([A-Za-z0-9_-]+)\]$/', $trimmed, $match) === 1) {
            $dotted = $match[1];
            $out[] = $line;
            continue;
        }
        if (preg_match('/^(\s*)version\.workspace\s*=\s*true\s*$/', $line, $match) === 1) {
            $out[] = $match[1] . 'version = ' . format_toml_value($crateVersion);
            continue;
        }
        if (preg_match('/^(\s*)edition\.workspace\s*=\s*true\s*$/', $line, $match) === 1) {
            $out[] = $match[1] . 'edition = ' . format_toml_value($workspace['package']['edition'] ?? '2024');
            continue;
        }
        if (preg_match('/^(\s*)rust-version\.workspace\s*=\s*true\s*$/', $line, $match) === 1) {
            $out[] = $match[1] . 'rust-version = ' . format_toml_value($workspace['package']['rust-version'] ?? '1.88');
            continue;
        }
        if (preg_match('/^(\s*)license\.workspace\s*=\s*true\s*$/', $line, $match) === 1) {
            // The mirror's license: the workspace's `mirror-license` when it has one, else the workspace's own.
            $license = $workspace['package']['mirror-license'] ?? $workspace['package']['license'] ?? 'BSD-3-Clause';
            $out[] = $match[1] . 'license = ' . format_toml_value($license);
            continue;
        }
        if (preg_match('/^(\s*)publish\.workspace\s*=\s*true\s*$/', $line, $match) === 1) {
            continue;
        }
        if (preg_match('/^(\s*)([A-Za-z0-9_-]+)\.workspace\s*=\s*true\s*$/', $line, $match) === 1) {
            $out[] = $match[1] . $match[2] . ' = ' . expand_workspace_dep($match[2], [], $workspace, $crateVersion);
            continue;
        }
        if (preg_match('/^(\s*)([A-Za-z0-9_-]+)\s*=\s*\{(.*)\}\s*$/', $line, $match) === 1 && str_contains($match[3], 'workspace')) {
            $overrides = parse_inline_table('{' . $match[3] . '}');
            if (($overrides['workspace'] ?? null) === true) {
                $out[] = $match[1] . $match[2] . ' = ' . expand_workspace_dep($match[2], $overrides, $workspace, $crateVersion);
                continue;
            }
        }
        $out[] = $line;
    }

    $materialized = implode("\n", $out);
    if (!str_contains($materialized, "name = \"{$expected}\"")) {
        fail("{$package}: materialized Cargo.toml name is not {$expected}");
    }
    if (str_contains($materialized, '.workspace = true') || str_contains($materialized, 'workspace = true')) {
        fail("{$package}: materialized Cargo.toml still has workspace inheritance");
    }

    return $materialized;
}

function replace_tree_file(string $tree, string $name, string $blob): string
{
    $entries = array_filter(explode("\n", sh("git ls-tree {$tree}")), fn (string $line) => $line !== '');
    $out = [];
    $replaced = false;
    foreach ($entries as $entry) {
        if (preg_match('/^(\S+) (\S+) (\S+)\t(.*)$/', $entry, $match) !== 1) {
            fail("unreadable tree entry: {$entry}");
        }
        if ($match[4] === $name) {
            $out[] = "{$match[1]} {$match[2]} {$blob}\t{$name}";
            $replaced = true;
        } else {
            $out[] = $entry;
        }
    }
    if (!$replaced) {
        $out[] = "100644 blob {$blob}\t{$name}";
    }

    return sh('printf %s ' . escapeshellarg(implode("\n", $out) . "\n") . ' | git mktree');
}

function materialize_crate_tree(string $commit, string $prefix, string $tree): string
{
    exec("git cat-file -e {$commit}:Cargo.toml 2>/dev/null", $_, $missing);
    if ($missing !== 0) {
        return $tree;
    }
    $package = str_starts_with($prefix, 'crates/utopia/')
        ? substr($prefix, strlen('crates/utopia/'))
        : 'php-std';
    $toml = sh("git show {$commit}:{$prefix}/Cargo.toml");
    $workspace = sh("git show {$commit}:Cargo.toml");
    $materialized = materialize_cargo_toml($toml, $workspace, $package);
    $blob = sh('printf %s ' . escapeshellarg($materialized) . ' | git hash-object -w --stdin');
    $tree = replace_tree_file($tree, 'Cargo.toml', $blob);

    // A crate's own proc-macro crate (`macros/`, a path dependency of the
    // crate) inherits the workspace too, and ships in the same mirror.
    exec("git cat-file -e {$commit}:{$prefix}/macros/Cargo.toml 2>/dev/null", $_, $noMacros);
    if ($noMacros === 0) {
        $nested = sh("git show {$commit}:{$prefix}/macros/Cargo.toml");
        preg_match('/^name\s*=\s*"([^"]+)"/m', $nested, $name) === 1 || fail("{$prefix}/macros/Cargo.toml has no name");
        $nestedBlob = sh('printf %s ' . escapeshellarg(materialize_cargo_toml($nested, $workspace, $package, $name[1])) . ' | git hash-object -w --stdin');
        $macros = sh("git rev-parse {$commit}:{$prefix}/macros");
        $tree = replace_tree_file($tree, 'macros', replace_tree_file($macros, 'Cargo.toml', $nestedBlob));
    }

    // The source here keeps the repository's license; a mirror is published under the workspace's
    // `mirror-license` when the commit has one: its LICENSE and its README's License section with it.
    // Commits from before the setting keep their trees, so the mirrors' history is unchanged.
    $mirror = parse_workspace_toml($workspace)['package']['mirror-license'] ?? null;
    if (!is_string($mirror)) {
        return $tree;
    }
    $license = sh('printf %s ' . escapeshellarg(mirror_license_text($mirror)) . ' | git hash-object -w --stdin');
    $tree = replace_tree_file($tree, 'LICENSE', $license);
    exec("git cat-file -e {$commit}:{$prefix}/README.md 2>/dev/null", $_, $noReadme);
    if ($noReadme === 0) {
        $readme = sh("git show {$commit}:{$prefix}/README.md") . "\n";
        $readme = str_replace("\n## License\n\nBSD-3-Clause. See [LICENSE](LICENSE).", "\n## License\n\n{$mirror}. See [LICENSE](LICENSE).", $readme);
        $tree = replace_tree_file($tree, 'README.md', sh('printf %s ' . escapeshellarg($readme) . ' | git hash-object -w --stdin'));
    }

    return $tree;
}

/** The text of a license a mirror can be published under, by its SPDX identifier. */
function mirror_license_text(string $spdx): string
{
    return match ($spdx) {
        'MIT' => <<<'TEXT'
            MIT License

            Copyright (c) 2019 Appwrite (https://appwrite.io) and individual contributors.

            Permission is hereby granted, free of charge, to any person obtaining a copy
            of this software and associated documentation files (the "Software"), to deal
            in the Software without restriction, including without limitation the rights
            to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
            copies of the Software, and to permit persons to whom the Software is
            furnished to do so, subject to the following conditions:

            The above copyright notice and this permission notice shall be included in all
            copies or substantial portions of the Software.

            THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
            IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
            FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
            AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
            LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
            OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
            SOFTWARE.

            TEXT,
        default => fail("no license text for mirror-license \"{$spdx}\""),
    };
}

function split_crate(string $package): string
{
    return split_tree(crate_prefix($package), 'materialize_crate_tree');
}

function crate_release_notes(string $package, string $version, string $to): string
{
    $previous = null;
    $tags = sh("git -c versionsort.suffix=- tag --list 'rs/{$package}/*' --sort=-v:refname");
    foreach (explode("\n", $tags) as $tag) {
        $candidate = substr($tag, strlen("rs/{$package}/"));
        if ($candidate !== '' && version_compare($candidate, $version, '<')) {
            $previous = $tag;
            break;
        }
    }

    $home = 'https://github.com/' . REPOSITORY;
    $prefix = crate_prefix($package);
    if ($previous === null) {
        return "First release cut from [`{$prefix}`]({$home}/tree/main/{$prefix}) in " . REPOSITORY . '.';
    }

    $log = sh("git log {$previous}..{$to} --pretty='- %s' -- {$prefix}");

    return ($log !== '' ? $log : '- No changes to this crate since ' . $previous . '.')
        . "\n\n**Changes**: {$home}/compare/{$previous}...rs/{$package}/{$version}";
}

function crate_lockdown(string $package): void
{
    exec('gh --version 2>/dev/null', $_, $missing);
    if ($missing !== 0) {
        out('gh not found — create the mirror ruleset manually (see rfc/rust.md)');

        return;
    }
    $payload = json_encode([
        'name' => 'main',
        'target' => 'branch',
        'enforcement' => 'active',
        'conditions' => ['ref_name' => ['include' => ['~DEFAULT_BRANCH'], 'exclude' => []]],
        'rules' => [
            ['type' => 'deletion'],
            ['type' => 'non_fast_forward'],
            ['type' => 'pull_request', 'parameters' => [
                'required_approving_review_count' => 0,
                'dismiss_stale_reviews_on_push' => false,
                'require_code_owner_review' => false,
                'require_last_push_approval' => false,
                'required_review_thread_resolution' => false,
                'allowed_merge_methods' => ['merge', 'squash', 'rebase'],
            ]],
        ],
        'bypass_actors' => [['actor_id' => CRATES_SPLIT_APP_ID, 'actor_type' => 'Integration', 'bypass_mode' => 'always']],
    ]);
    exec('gh api ' . escapeshellarg('repos/' . CRATES_ORG . "/{$package}/rulesets") . ' 2>/dev/null', $listing, $listed);
    $id = null;
    foreach (($listed === 0 ? json_decode(implode('', $listing), true) : []) ?: [] as $rule) {
        if (($rule['target'] ?? '') === 'branch') {
            $id = $rule['id'];
            break;
        }
    }
    $endpoint = 'repos/' . CRATES_ORG . "/{$package}/rulesets" . ($id === null ? '' : "/{$id}");
    exec('printf %s ' . escapeshellarg($payload) . ' | gh api -X ' . ($id === null ? 'POST' : 'PUT')
        . " {$endpoint} --input - 2>&1", $response, $code);
    out($code === 0
        ? ($id === null ? 'mirror ruleset created' : 'mirror ruleset updated (split app can bypass)')
        : 'could not set mirror ruleset (configure manually, see rfc/rust.md): ' . implode("\n", $response));
}

/**
 * Write the files a crate's mirror needs: README from guide.md, LICENSE,
 * gitignore, repository URL, and the PR/issue redirect workflow.
 */
function absorb_crate(string $package, bool $skipRuleset): void
{
    $directory = crate_prefix($package);
    is_file("{$directory}/Cargo.toml") || fail("unknown crate: {$package}");

    $toml = file_get_contents("{$directory}/Cargo.toml");
    $expected = crate_package_name($package);
    if (preg_match('/^name\s*=\s*"' . preg_quote($expected, '/') . '"/m', $toml) !== 1) {
        fail("{$directory}/Cargo.toml name must be \"{$expected}\"");
    }
    $repository = 'https://github.com/' . CRATES_ORG . '/' . $package;
    if (preg_match('/^repository\s*=/m', $toml) !== 1) {
        $toml = preg_replace(
            '/^(license\.workspace\s*=\s*true)$/m',
            "$1\nrepository = \"{$repository}\"",
            $toml,
            1,
            $count
        );
        $count === 1 || fail("{$directory}/Cargo.toml has no license.workspace line to attach repository to");
        file_put_contents("{$directory}/Cargo.toml", $toml);
        out("added repository = \"{$repository}\" to Cargo.toml");
    }

    $readme = "{$directory}/README.md";
    $generated = crate_readme($package, crate_description($package)) . "\n";
    if (!is_file($readme) || file_get_contents($readme) !== $generated) {
        file_put_contents($readme, $generated);
        out('wrote README.md from guide.md');
    }

    $license = "{$directory}/LICENSE";
    if (!is_file($license)) {
        is_file('LICENSE') || fail('root LICENSE is missing');
        copy('LICENSE', $license);
        out('copied LICENSE from the repository root');
    }

    $ignore = "{$directory}/.gitignore";
    $ignored = is_file($ignore) ? file_get_contents($ignore) : '';
    $needed = ['/target', 'Cargo.lock'];
    $append = [];
    foreach ($needed as $entry) {
        if (preg_match('#^' . preg_quote($entry, '#') . '$#m', $ignored) !== 1) {
            $append[] = $entry;
        }
    }
    if ($append !== []) {
        file_put_contents($ignore, rtrim($ignored) . ($ignored === '' ? '' : "\n") . implode("\n", $append) . "\n");
        out('updated .gitignore');
    }

    $workflows = "{$directory}/.github/workflows";
    if (!is_dir($workflows)) {
        mkdir($workflows, 0755, true);
    }
    foreach (glob("{$workflows}/*.{yml,yaml}", GLOB_BRACE) ?: [] as $file) {
        unlink($file);
    }
    file_put_contents("{$workflows}/mirror.yml", crate_mirror_workflow($package));
    out('wrote .github/workflows/mirror.yml (closes mirror PRs and issues with a redirect)');

    if ($skipRuleset) {
        out('skipped the mirror ruleset (--skip-ruleset)');
    } else {
        crate_lockdown($package);
    }
}

function push_crate_split(string $package, array $options): int
{
    out("splitting {$package}...");
    $sha = split_crate($package);
    if (isset($options['dry-run'])) {
        out("{$package} -> {$sha} (dry run)");

        return 0;
    }

    $remote = is_string($options['remote'] ?? null) ? $options['remote'] : crate_remote($package);
    $force = isset($options['force']) ? ' --force' : '';
    $ref = is_string($options['tag'] ?? null)
        ? 'refs/tags/' . $options['tag']
        : 'refs/heads/' . (is_string($options['branch'] ?? null) ? $options['branch'] : 'main');

    passthru("git push{$force} {$remote} {$sha}:{$ref}", $code);
    if ($code !== 0) {
        return $code;
    }
    out("{$package} -> {$ref} ({$sha})");

    if (!is_string($options['tag'] ?? null)) {
        return 0;
    }

    $version = $options['tag'];
    $tag = "rs/{$package}/{$version}";
    exec("git rev-parse -q --verify refs/tags/{$tag} > /dev/null 2>&1", $_, $missing);
    $payload = json_encode([
        'tag_name' => $version,
        'name' => $version,
        'body' => crate_release_notes($package, $version, $missing === 0 ? $tag : 'HEAD'),
        'prerelease' => str_contains($version, '-'),
    ]);
    $token = getenv('GH_TOKEN') ?: sh('gh auth token');
    $authorization = escapeshellarg('Authorization: Bearer ' . $token);
    foreach ([1, 2] as $attempt) {
        $response = [];
        exec('printf %s ' . escapeshellarg($payload)
            . ' | curl -sS --fail-with-body -X POST -H ' . $authorization
            . ' -H "Accept: application/vnd.github+json" --data-binary @- '
            . 'https://api.github.com/repos/' . CRATES_ORG . "/{$package}/releases 2>&1", $response, $code);
        if ($code === 0 || $attempt === 2) {
            break;
        }
        sleep(2);
    }
    if ($code === 0) {
        out("{$package} -> release {$version} published");

        return 0;
    }
    if (stripos($message = implode("\n", $response), 'already_exists') !== false) {
        out("release {$version} already exists");

        return 0;
    }
    out("could not publish release: {$message}");

    return 1;
}

function validate_crates(): int
{
    $failures = 0;
    foreach (crates() as $package) {
        $problems = [];
        $directory = crate_prefix($package);
        $toml = is_file("{$directory}/Cargo.toml") ? file_get_contents("{$directory}/Cargo.toml") : null;
        if ($toml === null) {
            $problems[] = 'missing Cargo.toml';
        } else {
            $expected = crate_package_name($package);
            if (preg_match('/^name\s*=\s*"' . preg_quote($expected, '/') . '"/m', $toml) !== 1) {
                $problems[] = "name must be \"{$expected}\"";
            }
            if (preg_match('/^license(?:\.workspace)?\s*=/m', $toml) !== 1) {
                $problems[] = 'missing license';
            }
            $repository = 'https://github.com/' . CRATES_ORG . '/' . $package;
            if (preg_match('/^repository\s*=\s*"' . preg_quote($repository, '/') . '"/m', $toml) !== 1) {
                $problems[] = "repository must be \"{$repository}\", run `bin/monorepo crates absorb {$package} --skip-ruleset`";
            }
        }
        if (!is_file("{$directory}/README.md")) {
            $problems[] = 'missing README.md, run `bin/monorepo crates absorb ' . $package . ' --skip-ruleset`';
        } elseif (!str_contains(file_get_contents("{$directory}/README.md"), 'read-only mirror')) {
            $problems[] = 'README.md must carry the read-only mirror banner';
        }
        if (!is_file("{$directory}/LICENSE")) {
            $problems[] = 'missing LICENSE, run `bin/monorepo crates absorb ' . $package . ' --skip-ruleset`';
        }
        if (!is_file("{$directory}/.github/workflows/mirror.yml")) {
            $problems[] = 'missing .github/workflows/mirror.yml, run `bin/monorepo crates absorb ' . $package . ' --skip-ruleset`';
        }
        $ignored = is_file("{$directory}/.gitignore") ? file_get_contents("{$directory}/.gitignore") : '';
        if (preg_match('#^/?target$#m', $ignored) !== 1) {
            $problems[] = '.gitignore must list /target';
        }
        if (preg_match('#^/?Cargo\.lock$#m', $ignored) !== 1) {
            $problems[] = '.gitignore must list Cargo.lock';
        }
        foreach ($problems as $problem) {
            out("{$directory}: {$problem}");
            $failures++;
        }
    }

    return $failures + validate_engine();
}

/**
 * Every crate reaches the async engine through utopia-async
 * (crates/utopia/async), the one crate that may depend on tokio, so the
 * engine can be switched there: no other manifest lists `tokio`, and no
 * other source names `tokio::`. Drivers that bring tokio themselves
 * (redis, mongodb, tokio-postgres, ...) and I/O-trait crates (tokio-rustls,
 * tokio-tungstenite) are not tokio.
 */
function validate_engine(): int
{
    $failures = 0;
    $engine = 'crates/utopia/async';
    foreach (glob('crates/*/*/Cargo.toml') ?: [] as $manifest) {
        $directory = dirname($manifest);
        if ($directory === $engine) {
            continue;
        }
        foreach (explode("\n", file_get_contents($manifest)) as $line) {
            $line = trim($line);
            if (str_starts_with($line, 'tokio =') || str_starts_with($line, 'tokio.workspace')) {
                out("{$manifest}: depends on tokio; use utopia-async");
                $failures++;
            }
        }
        $sources = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($directory, FilesystemIterator::SKIP_DOTS));
        foreach ($sources as $source) {
            if ($source->getExtension() !== 'rs' || str_contains($source->getPathname(), '/target/')) {
                continue;
            }
            $text = file_get_contents($source->getPathname());
            if (str_contains($text, 'tokio::')) {
                out("{$source->getPathname()}: names tokio::; use utopia_async");
                $failures++;
            }
        }
    }

    return $failures;
}

$arguments = array_slice($argv, 1);
$command = array_shift($arguments) ?? 'help';
$options = [];
$arguments = array_values(array_filter($arguments, function (string $argument) use (&$options): bool {
    if (!str_starts_with($argument, '--')) {
        return true;
    }
    [$key, $value] = array_pad(explode('=', substr($argument, 2), 2), 2, true);
    $options[$key] = $value;

    return false;
}));

switch ($command) {
    case 'list':
        foreach (packages() as $package) {
            $latest = sh("git tag --list '{$package}/*' --sort=-v:refname | head -n 1");
            out(str_pad($package, 24) . ($latest !== '' ? $latest : '(unreleased)'));
        }
        break;

    case 'absorb':
        $package = $arguments[0] ?? fail('usage: monorepo absorb <name> [url] [branch] [--skip-ruleset]');
        $directory = "packages/{$package}";

        if (!is_dir($directory)) {
            import_package($package, $arguments[1] ?? null, $arguments[2] ?? null);
        }

        // Strip QA tooling the root hoists (see `check` and `validate`).
        $path = "{$directory}/composer.json";
        $manifest = json_decode(file_get_contents($path), true);
        $original = $manifest;
        foreach ([...HOISTED, 'squizlabs/php_codesniffer'] as $dependency) {
            unset($manifest['require-dev'][$dependency]);
        }
        foreach (['format', 'format:check', 'format:fix', 'lint', 'check', 'analyse', 'analyze', 'refactor', 'refactor:check'] as $script) {
            unset($manifest['scripts'][$script]);
        }
        foreach ($manifest['scripts'] ?? [] as $name => $script) {
            if (is_string($script)) {
                // phpunit comes from the root toolchain, resolved via PATH
                $manifest['scripts'][$name] = preg_replace('#(\./)?vendor/bin/phpunit#', 'phpunit', $script);
            }
        }
        if (($manifest['scripts'] ?? null) === []) {
            unset($manifest['scripts']);
        }
        if (($manifest['require-dev'] ?? null) === []) {
            unset($manifest['require-dev']);
        }
        $keep = compose_dockerfiles($directory);
        foreach ([...BANNED, ...array_diff(array_map('basename', glob("{$directory}/Dockerfile*")), $keep)] as $file) {
            if (is_file("{$directory}/{$file}")) {
                unlink("{$directory}/{$file}");
                out("removed {$file} (root tooling is canonical)");
            }
        }
        if ($manifest !== $original) {
            file_put_contents($path, json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
            out('stripped hoisted QA tooling from composer.json');
        }

        // Packages carry no composer.lock: a library's lock never reaches
        // its consumers, and every test run resolves dependencies afresh
        // (`bin/monorepo test` always runs `composer update`), so a committed
        // lock is pure churn. Drop it and make sure the mirror ignores it.
        if (is_file("{$directory}/composer.lock")) {
            unlink("{$directory}/composer.lock");
            out('removed composer.lock (packages are not locked)');
        }
        $ignore = "{$directory}/.gitignore";
        $ignored = is_file($ignore) ? file_get_contents($ignore) : '';
        if (preg_match('#^/?composer\.lock$#m', $ignored) !== 1) {
            file_put_contents($ignore, rtrim($ignored) . ($ignored === '' ? '' : "\n") . "composer.lock\n");
            out('added composer.lock to .gitignore');
        }

        // This repository owns CI and issue tracking, so the mirror needs no
        // test, QA, or issue-template files - only the redirect workflow.
        $workflows = "{$directory}/.github/workflows";
        @mkdir($workflows, 0755, true);
        array_map('unlink', glob("{$workflows}/*.{yml,yaml}", GLOB_BRACE) ?: []);
        file_put_contents("{$workflows}/mirror.yml", mirror_workflow($package));
        out('wrote .github/workflows/mirror.yml (closes mirror PRs and issues with a redirect)');
        foreach (["{$directory}/.github/ISSUE_TEMPLATE", "{$directory}/ISSUE_TEMPLATE"] as $templates) {
            if (is_dir($templates)) {
                rm($templates);
                out("removed " . str_replace("{$directory}/", '', $templates) . ' (issue tracking here is canonical)');
            }
        }

        // Point readers here.
        $readme = "{$directory}/README.md";
        if (is_file($readme)) {
            $content = file_get_contents($readme);
            $home = 'https://github.com/' . REPOSITORY;
            $line = "> This repository is a read-only mirror of [`packages/{$package}`]({$home}/tree/main/packages/{$package}) in [" . REPOSITORY . "]({$home}). "
                . "Development happens there — please open issues and pull requests against " . REPOSITORY . ".";
            $lines = explode("\n", $content);
            $existing = array_search(true, array_map(fn (string $l) => str_starts_with($l, '> This repository is a read-only mirror'), $lines), true);
            if ($existing !== false && $lines[$existing] !== $line) {
                // A banner from a previous home (the utopia-php monorepo): point it here.
                $lines[$existing] = $line;
                file_put_contents($readme, implode("\n", $lines));
                out('updated mirror banner in README.md');
            } elseif ($existing === false) {
                $banner = "> [!IMPORTANT]\n{$line}\n";
                $updated = preg_replace('/^(# .+\R)/', "\$1\n{$banner}", $content, 1, $count);
                file_put_contents($readme, $count === 1 ? $updated : $banner . "\n" . $content);
                out('added mirror banner to README.md');
            }
        }

        // Lock the mirror down (PR-only, no force-push) and let the split app
        // bypass it. Idempotent: normalise whatever branch ruleset already
        // exists to the canonical config — a pre-existing, differently-named
        // ruleset is what left auth's mirror without the bypass and blocked its
        // split, so we update in place rather than skip on a name clash.
        exec('gh --version 2>/dev/null', $_, $missing);
        if (isset($options['skip-ruleset'])) {
            out('skipped the mirror ruleset (--skip-ruleset)');
        } elseif ($missing !== 0) {
            out('gh not found — create the mirror ruleset manually (see rfc/monorepo.md)');
        } else {
            $payload = json_encode([
                'name' => 'main',
                'target' => 'branch',
                'enforcement' => 'active',
                'conditions' => ['ref_name' => ['include' => ['~DEFAULT_BRANCH'], 'exclude' => []]],
                'rules' => [
                    ['type' => 'deletion'],
                    ['type' => 'non_fast_forward'],
                    ['type' => 'pull_request', 'parameters' => [
                        'required_approving_review_count' => 0,
                        'dismiss_stale_reviews_on_push' => false,
                        'require_code_owner_review' => false,
                        'require_last_push_approval' => false,
                        'required_review_thread_resolution' => false,
                        'allowed_merge_methods' => ['merge', 'squash', 'rebase'],
                    ]],
                ],
                'bypass_actors' => [['actor_id' => SPLIT_APP_ID, 'actor_type' => 'Integration', 'bypass_mode' => 'always']],
            ]);
            exec('gh api ' . escapeshellarg('repos/' . ORG . "/{$package}/rulesets") . ' 2>/dev/null', $listing, $listed);
            $id = null;
            foreach (($listed === 0 ? json_decode(implode('', $listing), true) : []) ?: [] as $rule) {
                if (($rule['target'] ?? '') === 'branch') {
                    $id = $rule['id'];
                    break;
                }
            }
            $endpoint = 'repos/' . ORG . "/{$package}/rulesets" . ($id === null ? '' : "/{$id}");
            exec('printf %s ' . escapeshellarg($payload) . ' | gh api -X ' . ($id === null ? 'POST' : 'PUT')
                . " {$endpoint} --input - 2>&1", $response, $code);
            out($code === 0
                ? ($id === null ? 'mirror ruleset created' : 'mirror ruleset updated (split app can bypass)')
                : 'could not set mirror ruleset (configure manually, see rfc/monorepo.md): ' . implode("\n", $response));
        }

        out("absorbed {$package} — next: bin/monorepo autoload, bin/monorepo check {$package} --fix, bin/monorepo test {$package}, then commit");
        break;

    case 'split':
        $targets = $arguments !== [] ? $arguments : packages();
        $failed = [];
        foreach ($targets as $package) {
            is_dir("packages/{$package}") || fail("unknown package: {$package}");

            out("splitting {$package}...");
            $sha = split_package($package);

            if (isset($options['dry-run'])) {
                out("{$package} -> {$sha} (dry run)");
                continue;
            }

            $remote = is_string($options['remote'] ?? null) ? $options['remote'] : remote($package);
            $force = isset($options['force']) ? ' --force' : '';
            $ref = is_string($options['tag'] ?? null)
                ? 'refs/tags/' . $options['tag']
                : 'refs/heads/' . (is_string($options['branch'] ?? null) ? $options['branch'] : 'main');

            passthru("git push{$force} {$remote} {$sha}:{$ref}", $code);
            if ($code !== 0) {
                $failed[] = $package;
                continue;
            }
            out("{$package} -> {$ref} ({$sha})");

            // A pushed tag gets a GitHub release on the mirror, with notes
            // derived from this repository's log.
            if (is_string($options['tag'] ?? null)) {
                $version = $options['tag'];
                $tag = "{$package}/{$version}";
                exec("git rev-parse -q --verify refs/tags/{$tag} > /dev/null 2>&1", $_, $missing);
                $payload = json_encode([
                    'tag_name' => $version,
                    'name' => $version,
                    'body' => release_notes($package, $version, $missing === 0 ? $tag : 'HEAD'),
                    'prerelease' => str_contains($version, '-'),
                ]);
                // curl with an explicit token: gh's own auth resolution 401s
                // intermittently (seen with both CI app tokens and the local
                // keyring), while the same token works fine over plain HTTP.
                $token = getenv('GH_TOKEN') ?: sh('gh auth token');
                $authorization = escapeshellarg('Authorization: Bearer ' . $token);
                foreach ([1, 2] as $attempt) {
                    $response = [];
                    exec('printf %s ' . escapeshellarg($payload)
                        . ' | curl -sS --fail-with-body -X POST -H ' . $authorization
                        . ' -H "Accept: application/vnd.github+json" --data-binary @- '
                        . 'https://api.github.com/repos/' . ORG . "/{$package}/releases 2>&1", $response, $code);
                    if ($code === 0 || $attempt === 2) {
                        break;
                    }
                    sleep(2);
                }
                if ($code === 0) {
                    out("{$package} -> release {$version} published");
                } elseif (stripos($message = implode("\n", $response), 'already_exists') !== false) {
                    out("release {$version} already exists");
                } else {
                    out("could not publish release: {$message}");
                    $failed[] = "{$package} (release)";
                }
            }
        }
        if ($failed !== []) {
            fail('failed to push: ' . implode(', ', $failed));
        }
        break;

    case 'release':
        $package = $arguments[0] ?? fail('usage: monorepo release <package> <version> [--dry-run]');
        $version = $arguments[1] ?? fail('usage: monorepo release <package> <version> [--dry-run]');
        is_dir("packages/{$package}") || fail("unknown package: {$package}");
        preg_match('/^\d+\.\d+\.\d+(-[0-9A-Za-z.]+)?$/', $version)
            || fail("version must be semver (e.g. 2.1.0 or 2.1.0-rc1), got \"{$version}\"");

        $tag = "{$package}/{$version}";
        if (sh('git tag --list ' . escapeshellarg($tag)) !== '') {
            fail("tag {$tag} already exists");
        }

        out("release notes for {$tag}:\n");
        out(release_notes($package, $version, 'HEAD') . "\n");

        if (isset($options['dry-run'])) {
            out('(dry run — nothing tagged)');
            break;
        }

        if (sh('git status --porcelain') !== '') {
            fail('working tree is dirty — commit or stash before releasing');
        }
        exec('git merge-base --is-ancestor HEAD origin/main', $_, $unmerged);
        if ($unmerged !== 0) {
            out('warning: HEAD is not on origin/main — you are releasing unmerged commits');
        }

        sh("git tag {$tag}");
        sh("git push origin {$tag}");
        out("pushed {$tag} — CI will mirror the tag, publish to Packagist, and create the GitHub release");
        break;

    case 'validate':
        $failures = 0;
        $root = json_decode(file_get_contents('composer.json'), true);
        foreach (packages() as $package) {
            $problems = [];
            $manifest = manifest($package);

            if ($manifest === null) {
                $problems[] = 'missing or invalid composer.json';
            } else {
                $expected = ORG . "/{$package}";
                if (($manifest['name'] ?? null) !== $expected) {
                    $problems[] = "name must be \"{$expected}\", got \"" . ($manifest['name'] ?? '') . '"';
                }
                if (empty($manifest['license'])) {
                    $problems[] = 'missing license';
                }
                if (isset($manifest['version'])) {
                    $problems[] = 'must not declare "version" (versions come from tags)';
                }

                // One prefix per package, Utopia\<Ns>\ => src/, with <Ns>
                // spelling the package name (CircuitBreaker <-> circuit-breaker)
                // or the segment SEGMENTS names.
                // A package in BARE declares Utopia\ => src/ until step B,
                // and its tests use the segment BARE names.
                $namespace = namespace_of($manifest);
                $bare = $namespace !== null && array_key_first($manifest['autoload']['psr-4']) === 'Utopia\\';
                if ($namespace === null || (!$bare && strtolower($namespace) !== strtolower(SEGMENTS[$package] ?? str_replace('-', '', $package)))) {
                    $problems[] = 'autoload must declare exactly one PSR-4 prefix, Utopia\<Ns>\ with <Ns> spelling the package name';
                } else {
                    $prefix = "Utopia\\{$namespace}\\";
                    $main = $bare ? 'Utopia\\' : $prefix;
                    if (rtrim($manifest['autoload']['psr-4'][$main], '/') !== 'src') {
                        $problems[] = "autoload must map {$main} to src/";
                    }
                    $dev = $manifest['autoload-dev']['psr-4'] ?? [];
                    if (array_keys($dev) !== ["{$prefix}Tests\\"] || rtrim($dev["{$prefix}Tests\\"], '/') !== 'tests') {
                        $problems[] = "autoload-dev must declare exactly {$prefix}Tests\\ mapped to tests/";
                    }
                    $registered = $bare
                        ? in_array("packages/{$package}/src", (array) ($root['autoload']['psr-4'][$main] ?? []), true)
                        : ($root['autoload']['psr-4'][$main] ?? null) === "packages/{$package}/src";
                    if (!$registered
                        || ($root['autoload-dev']['psr-4']["{$prefix}Tests\\"] ?? null) !== "packages/{$package}/tests") {
                        $problems[] = 'root composer.json autoload is stale, run `bin/monorepo autoload`';
                    }
                }

                foreach (HOISTED as $dependency) {
                    if (isset($manifest['require-dev'][$dependency])) {
                        $problems[] = "{$dependency} must not be in require-dev (the root toolchain provides it)";
                    }
                }
                foreach ($manifest['repositories'] ?? [] as $repository) {
                    if (($repository['type'] ?? '') === 'path') {
                        $problems[] = 'siblings must be Packagist constraints, not path repositories (the mirror installs standalone)';
                    }
                }
                foreach (['require', 'require-dev'] as $section) {
                    if (isset($root[$section][$expected])) {
                        $problems[] = "root composer.json must not require {$expected} (the package is autoloaded directly)";
                    }
                }
                // `replace` hides the package's own require block from the
                // solver, so its third-party dependencies resolve only if the
                // root declares them too.
                foreach ($manifest['require'] ?? [] as $dependency => $constraint) {
                    if ($dependency === 'php' || str_starts_with($dependency, 'ext-') || isset($root['require'][$dependency])) {
                        continue;
                    }
                    // A sibling is satisfied by its own packages/ directory; anything else must be hoisted.
                    if (str_starts_with($dependency, ORG . '/') && in_array(substr($dependency, strlen(ORG) + 1), packages(), true)) {
                        continue;
                    }
                    $problems[] = "{$dependency} is required by packages/{$package} but not by the root; hoist it, replace hides the package's requirements from Composer";
                }
            }

            // Locks are never committed for packages; check the index rather
            // than the disk, since a local `composer update` legitimately
            // writes one.
            $tracked = explode("\n", sh('git ls-files ' . escapeshellarg("packages/{$package}")));
            if (in_array("packages/{$package}/composer.lock", $tracked, true)) {
                $problems[] = 'composer.lock must not be committed (packages are not locked)';
            }
            $ignored = is_file("packages/{$package}/.gitignore") ? file_get_contents("packages/{$package}/.gitignore") : '';
            if (preg_match('#^/?composer\.lock$#m', $ignored) !== 1) {
                $problems[] = '.gitignore must list composer.lock';
            }
            foreach ($tracked as $file) {
                $name = basename($file);
                $fixture = str_starts_with($file, "packages/{$package}/tests/E2E/");
                if (in_array($name, BANNED, true) || (str_starts_with($name, 'Dockerfile') && !$fixture && !in_array($name, compose_dockerfiles("packages/{$package}"), true))) {
                    $problems[] = substr($file, strlen("packages/{$package}/")) . ' must not exist (root tooling is canonical)';
                }
            }
            if (!is_file("packages/{$package}/phpstan.neon")) {
                $problems[] = 'missing phpstan.neon (packages are analysed under their own level)';
            } elseif (str_contains(file_get_contents("packages/{$package}/phpstan.neon"), '../')) {
                $problems[] = 'phpstan.neon must not include or reference paths outside the package (the root config is not a package floor)';
            }
            if (!is_file("packages/{$package}/.github/workflows/mirror.yml")) {
                $problems[] = 'missing .github/workflows/mirror.yml, run `bin/monorepo absorb ' . $package . ' --skip-ruleset`';
            }

            foreach ($problems as $problem) {
                out("packages/{$package}: {$problem}");
                $failures++;
            }
        }
        foreach (duplicate_classes($root) as $class => $locations) {
            out("{$class}: loadable from more than one directory (" . implode(', ', $locations) . ')');
            $failures++;
        }
        if (file_get_contents('composer.json') !== root_manifest()) {
            out('composer.json: package autoload entries are stale, run `bin/monorepo autoload`');
            $failures++;
        }
        $failures += validate_crates();
        out($failures === 0 ? 'all packages and crates valid' : "{$failures} problem(s) found");
        exit($failures === 0 ? 0 : 1);

    case 'autoload':
        file_put_contents('composer.json', root_manifest());
        out('composer.json package autoload entries regenerated');
        break;

    case 'check':
        $targets = $arguments !== [] ? $arguments : packages();
        toolchain();
        $failed = [];
        foreach ($targets as $package) {
            is_dir("packages/{$package}") || fail("unknown package: {$package}");

            out("==> {$package}");
            $directory = "packages/{$package}";
            is_file("{$directory}/phpstan.neon") || fail("{$directory}/phpstan.neon is missing (see bin/monorepo validate)");

            // A package's own dependencies (stubs such as swoole/ide-helper
            // above all) are what its phpstan.neon scans, so resolve them the
            // way `test` does before analysing a fresh checkout. --linked
            // always resolves, since an existing vendor/ may hold registry
            // copies of the siblings it is meant to replace.
            $linked = isset($options['linked']);
            if ($linked || !is_dir("{$directory}/vendor")) {
                [$code] = install($package, $linked);
                if ($code !== 0) {
                    $failed[] = "{$package} (composer)";
                    continue;
                }
            }

            // Style comes from the root pint.json; analysis runs at the
            // package's own level, against the root autoloader.
            $fix = isset($options['fix']);
            $checks = [];
            if (is_file("{$directory}/rector.php")) {
                // first, so --fix leaves rector's output formatted
                $checks['rector'] = '../../vendor/bin/rector process' . ($fix ? '' : ' --dry-run');
            }
            $checks['pint'] = '../../vendor/bin/pint --config ../../pint.json' . ($fix ? '' : ' --test');
            $checks['phpstan'] = '../../vendor/bin/phpstan analyse --memory-limit=1G';

            foreach ($checks as $tool => $command) {
                passthru("cd {$directory} && {$command}", $code);
                if ($code !== 0) {
                    $failed[] = "{$package} ({$tool})";
                }
            }
        }
        if ($failed !== []) {
            fail('checks failed: ' . implode(', ', $failed));
        }
        out('all checks passed');
        break;

    case 'dependents':
        $targets = $arguments !== [] ? $arguments : fail('usage: monorepo dependents <name...>');

        $dependents = [];
        foreach (packages() as $candidate) {
            $manifest = manifest($candidate);
            // require-dev counts: a dev-only sibling (e.g. queue's optional NATS
            // broker) still makes the registry combination unbuildable while the
            // sibling's change is unreleased, so its dependents must run linked.
            foreach (array_merge($manifest['require'] ?? [], $manifest['require-dev'] ?? []) as $dependency => $constraint) {
                if (str_starts_with($dependency, ORG . '/')) {
                    $dependents[substr($dependency, strlen(ORG) + 1)][] = $candidate;
                }
            }
        }

        $found = [];
        $pending = $targets;
        while ($pending !== []) {
            foreach ($dependents[array_shift($pending)] ?? [] as $dependent) {
                if (!isset($found[$dependent])) {
                    $found[$dependent] = true;
                    $pending[] = $dependent;
                }
            }
        }
        foreach (array_keys($found) as $dependent) {
            out($dependent);
        }
        break;

    case 'test':
        $targets = $arguments !== [] ? $arguments : packages();
        toolchain();
        $failed = [];
        foreach ($targets as $package) {
            is_dir("packages/{$package}") || fail("unknown package: {$package}");

            out("==> {$package}");
            $directory = "packages/{$package}";

            [$code, $environment] = install($package, isset($options['linked']));

            // The test contract: `composer test` is the unit tier and runs on
            // a bare host; `composer test:e2e` runs on the host against the
            // package's compose services.
            if ($code === 0) {
                $runner = isset(manifest($package)['scripts']['test']) ? 'composer test' : 'phpunit';
                passthru("cd {$directory} && {$environment}{$runner}", $code);
            }

            if ($code === 0 && isset(manifest($package)['scripts']['test:e2e'])) {
                $compose = is_file("{$directory}/docker-compose.yml");
                if ($compose) {
                    passthru("cd {$directory} && COMPOSE_FILE=docker-compose.yml docker compose up -d --build --wait", $code);
                }
                if ($code === 0) {
                    passthru("cd {$directory} && {$environment}composer test:e2e", $code);
                }
                if ($compose) {
                    passthru("cd {$directory} && COMPOSE_FILE=docker-compose.yml docker compose down -v --remove-orphans > /dev/null 2>&1");
                }
            }

            if ($code !== 0) {
                $failed[] = $package;
            }
        }
        if ($failed !== []) {
            fail('tests failed: ' . implode(', ', $failed));
        }
        out('all tests passed');
        break;

    case 'crates':
        $subcommand = array_shift($arguments) ?? 'help';
        switch ($subcommand) {
            case 'list':
                foreach (crates() as $package) {
                    $latest = sh("git tag --list 'rs/{$package}/*' --sort=-v:refname | head -n 1");
                    out(str_pad($package, 24) . ($latest !== '' ? $latest : '(unreleased)'));
                }
                break;

            case 'absorb':
                $targets = $arguments !== [] ? $arguments : crates();
                foreach ($targets as $package) {
                    in_array($package, crates(), true) || fail("unknown crate: {$package}");
                    out("==> {$package}");
                    absorb_crate($package, isset($options['skip-ruleset']));
                }
                break;

            case 'split':
                $targets = $arguments !== [] ? $arguments : crates();
                $failed = [];
                foreach ($targets as $package) {
                    in_array($package, crates(), true) || fail("unknown crate: {$package}");
                    if (push_crate_split($package, $options) !== 0) {
                        $failed[] = $package;
                    }
                }
                if ($failed !== []) {
                    fail('failed to push: ' . implode(', ', $failed));
                }
                break;

            case 'release':
                $package = $arguments[0] ?? fail('usage: monorepo crates release <name> <version> [--dry-run]');
                $version = $arguments[1] ?? fail('usage: monorepo crates release <name> <version> [--dry-run]');
                in_array($package, crates(), true) || fail("unknown crate: {$package}");
                preg_match('/^\d+\.\d+\.\d+(-[0-9A-Za-z.]+)?$/', $version)
                    || fail("version must be semver (e.g. 0.1.0 or 0.1.0-rc1), got \"{$version}\"");

                $tag = "rs/{$package}/{$version}";
                if (sh('git tag --list ' . escapeshellarg($tag)) !== '') {
                    fail("tag {$tag} already exists");
                }

                out("release notes for {$tag}:\n");
                out(crate_release_notes($package, $version, 'HEAD') . "\n");

                if (isset($options['dry-run'])) {
                    out('(dry run — nothing tagged)');
                    break;
                }

                if (sh('git status --porcelain') !== '') {
                    fail('working tree is dirty — commit or stash before releasing');
                }
                exec('git merge-base --is-ancestor HEAD origin/main', $_, $unmerged);
                if ($unmerged !== 0) {
                    out('warning: HEAD is not on origin/main — you are releasing unmerged commits');
                }

                sh("git tag {$tag}");
                sh("git push origin {$tag}");
                out("pushed {$tag} — CI will mirror the tag and create the GitHub release");
                break;

            case 'validate':
                $failures = validate_crates();
                out($failures === 0 ? 'all crates valid' : "{$failures} problem(s) found");
                exit($failures === 0 ? 0 : 1);

            case 'materialize':
                $package = $arguments[0] ?? fail('usage: monorepo crates materialize <name>');
                in_array($package, crates(), true) || fail("unknown crate: {$package}");
                echo materialize_cargo_toml(
                    file_get_contents(crate_prefix($package) . '/Cargo.toml'),
                    file_get_contents('Cargo.toml'),
                    $package
                );
                break;

            case 'create-mirrors':
                exec('gh --version 2>/dev/null', $_, $missing);
                $missing === 0 || fail('gh is required to create mirror repositories');
                $targets = $arguments !== [] ? $arguments : crates();
                $failed = [];
                foreach ($targets as $package) {
                    in_array($package, crates(), true) || fail("unknown crate: {$package}");
                    $description = crate_description($package);
                    if (strlen($description) > 350) {
                        $description = substr($description, 0, 347) . '...';
                    }
                    $cmd = 'gh repo create ' . escapeshellarg(CRATES_ORG . '/' . $package)
                        . ' --public --description ' . escapeshellarg($description)
                        . ' --homepage ' . escapeshellarg('https://github.com/' . REPOSITORY . '/tree/main/' . crate_prefix($package));
                    if (isset($options['dry-run'])) {
                        out($cmd);
                        continue;
                    }
                    passthru($cmd, $code);
                    if ($code !== 0) {
                        $failed[] = $package;
                    }
                }
                if ($failed !== []) {
                    fail('failed to create: ' . implode(', ', $failed));
                }
                break;

            default:
                out(<<<'HELP'
                usage: bin/monorepo crates <command>

                  list                                show crates and their latest rs/<name>/<version> tag
                  absorb [name...] [--skip-ruleset]   write README from guide.md, LICENSE, gitignore, repository URL, mirror.yml
                  split [name...] [--tag=v] [--branch=main] [--remote=url] [--force] [--dry-run]
                                                      push crate histories to github.com/utopia-rs/<name>
                  release <name> <version> [--dry-run]
                                                      preview notes, tag rs/<name>/<version> and push it
                  validate                            check the crate mirror shape
                  materialize <name>                  print the standalone Cargo.toml the mirror would get
                  create-mirrors [name...] [--dry-run]
                                                      create empty public repos on utopia-rs
                HELP);
                break;
        }
        break;

    default:
        out(<<<'HELP'
        usage: bin/monorepo <command>

          list                                show packages and their latest release tag
          absorb <name> [url] [branch] [--skip-ruleset]
                                              import (preserving history) + strip hoisted QA + mirror PR redirect + lockdown
          split [name...] [--tag=v] [--branch=main] [--remote=url] [--force] [--dry-run]
                                              push package histories to their mirrors
          release <name> <version> [--dry-run]
                                              preview notes, tag <name>/<version> and push it (CI does the rest)
          validate                            check the package shape, crate mirrors, and the root autoload wiring
          autoload                            regenerate the root composer.json autoload entries for packages/
          check [name...] [--fix] [--linked]  run pint, phpstan and rector against packages
                                              (--linked resolves siblings from the local checkout)
          test [name...] [--linked]           install dependencies and run package test suites
                                              (--linked resolves siblings from the local checkout)
          dependents <name...>                list packages that depend on the given ones (transitively)
          crates <command>                    Rust crate mirrors on github.com/utopia-rs (see `crates help`)
        HELP);
        break;
}
