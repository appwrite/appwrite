# Build context for Dockerfile.rust: only the Rust workspace and the static
# data files the Rust API shares with PHP.
*
!Cargo.toml
!Cargo.lock
!rustfmt.toml
!.cargo/config.toml
!crates
!app/config/locale/translations
!app/config/locale/templates
!app/assets/security/10k-common-passwords
**/target
